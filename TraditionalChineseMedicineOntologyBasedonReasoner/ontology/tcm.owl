		        </owl:Restriction>
		    </rdfs:subClassOf>
		</owl:Class>
		
		<!-- 麻黄附子细辛汤证：决定性主症：发热、恶寒、无汗、但欲寐、脉沉；或然症：微细脉、手足厥冷等 -->
		<owl:Class rdf:about="#MahuangFuziXixinTangZheng">
		    <rdfs:subClassOf rdf:resource="#Fangzheng"/>
		    <owl:equivalentClass>
		        <owl:Class>
		            <owl:intersectionOf rdf:parseType="Collection">
		                <owl:Class rdf:about="#Shaoyinbing"/>
		                <owl:Class rdf:about="#Biao"/>
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#Fare"/>
		                </owl:Restriction>
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#Ehan"/>
		                </owl:Restriction>
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#Wuhan"/>
		                </owl:Restriction>
		                <owl:Restriction>
