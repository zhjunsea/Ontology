		        </owl:Restriction>
		    </rdfs:subClassOf>
		</owl:Class>
		
		<!-- 理中汤证：决定性主症：腹满、呕吐、食不下、下利、时腹自痛、不渴、脉沉弱；或然症：手足厥冷等 -->
		<owl:Class rdf:about="#LizhongTangZheng">
