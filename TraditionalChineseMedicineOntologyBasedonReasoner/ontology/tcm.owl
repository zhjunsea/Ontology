		                                        <owl:Class rdf:about="#Chenshimai"/>
		                                    </owl:unionOf>
		                                </owl:Class>
		                            </owl:someValuesFrom>
		                        </owl:Restriction>
		                    </owl:intersectionOf>
		                </owl:Class>
		
		                <!-- 分支二：阳明腑证（里实） -->
		                <owl:Class>
		                    <owl:intersectionOf rdf:parseType="Collection">
		                        <owl:Class rdf:about="#Li"/>
		                        <owl:Class rdf:about="#Shi"/>
