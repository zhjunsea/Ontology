		                    <owl:onProperty rdf:resource="#you_maixiang"/>
		                    <owl:someValuesFrom rdf:resource="#Weiximai"/>
		                </owl:Restriction>
		            </owl:intersectionOf>
		        </owl:Class>
		    </owl:equivalentClass>
		    <possibleSymptom rdf:resource="#Ehan"/>
		    <possibleSymptom rdf:resource="#DanYuMei"/>
		    <rdfs:subClassOf>
		        <owl:Restriction>
		            <owl:onProperty rdf:resource="#you_chufang"/>
		            <owl:hasValue rdf:resource="#ZhenwuTang"/>
		        </owl:Restriction>
		    </rdfs:subClassOf>
		</owl:Class>
		
		<!-- 乌梅丸证：决定性主症：消渴、气上撞心、心中疼热、饥而不欲食、食则吐蛔、手足厥冷；或然症：口苦、脉微细等 -->
		<owl:Class rdf:about="#WumeiWanZheng">
		    <rdfs:subClassOf rdf:resource="#Fangzheng"/>
		    <owl:equivalentClass>
		        <owl:Class>
		            <owl:intersectionOf rdf:parseType="Collection">
		                <owl:Class rdf:about="#Jueyinbing"/>
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#Xiaoke"/>
		                </owl:Restriction>
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#QiShangZhuangXin"/>
		                </owl:Restriction>
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#XinzhongTengre"/>
		                </owl:Restriction>
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#JiErBuyuShi"/>
		                </owl:Restriction>
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#ShiZeTuHui"/>
		                </owl:Restriction>
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#ShouzuJueleng"/>
		                </owl:Restriction>
		            </owl:intersectionOf>
		        </owl:Class>
		    </owl:equivalentClass>
		    <possibleSymptom rdf:resource="#Kouku"/>
		    <possibleSymptom rdf:resource="#Weiximai"/>
		    <rdfs:subClassOf>
		        <owl:Restriction>
		            <owl:onProperty rdf:resource="#you_chufang"/>
		            <owl:hasValue rdf:resource="#WumeiWan"/>
		        </owl:Restriction>
		    </rdfs:subClassOf>
		</owl:Class>
		
		<!-- 柴胡桂枝干姜汤证：决定性主症：往来寒热、胸胁满微结、小便不利、渴而不呕、但头汗出、心烦；或然症：手足厥冷、脉微细等 -->
		<owl:Class rdf:about="#ChaihuGuizhiGanjiangTangZheng">
		    <rdfs:subClassOf rdf:resource="#Fangzheng"/>
		    <owl:equivalentClass>
		        <owl:Class>
		            <owl:intersectionOf rdf:parseType="Collection">
		                <owl:Class rdf:about="#Jueyinbing"/>
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#WanglaiHanre"/>
		                </owl:Restriction>
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#XiongxieManWeijie"/>
		                </owl:Restriction>
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#XiaobianBuli"/>
		                </owl:Restriction>
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#KeErBuOu"/>
		                </owl:Restriction>
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#DanTouHanchu"/>
		                </owl:Restriction>
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#Xinfan"/>
		                </owl:Restriction>
		            </owl:intersectionOf>
		        </owl:Class>
		    </owl:equivalentClass>
		    <possibleSymptom rdf:resource="#ShouzuJueleng"/>
		    <possibleSymptom rdf:resource="#Weiximai"/>
		    <rdfs:subClassOf>
		        <owl:Restriction>
		            <owl:onProperty rdf:resource="#you_chufang"/>
		            <owl:hasValue rdf:resource="#ChaihuGuizhiGanjiangTang"/>
		        </owl:Restriction>
		    </rdfs:subClassOf>
		</owl:Class>
		
		<!-- 三阳合病之治，若自汗出者，主以白虎汤清阳明独盛之热。若少阳证显，则合柴胡，即柴胡白虎汤。
		故三阳合病方证（柴胡白虎汤证）的主症，不应是三经症状的简单叠加，
		而应突出阳明热盛与少阳枢机不利的关键表现，太阳之表证仅居其次，且多为或然。 -->
		<owl:Class rdf:about="#ChaihuBaihuTangZheng">
		    <rdfs:subClassOf rdf:resource="#Fangzheng"/>
		    <owl:equivalentClass>
		        <owl:Class>
		            <owl:intersectionOf rdf:parseType="Collection">
		                <!-- 三阳经病必须同时存在 -->
		                <owl:Class rdf:about="#Taiyangbing"/>
		                <owl:Class rdf:about="#Yangmingbing"/>
		                <owl:Class rdf:about="#Shaoyangbing"/>
		                <!-- 条文主症：腹满、身重、难以转侧、口不仁、面垢、谵语、遗尿、自汗出、但欲眠睡、目合则汗 -->
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#Fuman"/>
		                </owl:Restriction>
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#Shenzhong"/>
		                </owl:Restriction>
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#Nanyizhuance"/>
		                </owl:Restriction>
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#Kouburen"/>
		                </owl:Restriction>
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#Miangou"/>
		                </owl:Restriction>
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#Zhanwang"/>
		                </owl:Restriction>
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#Yiniao"/>
		                </owl:Restriction>
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#DaHan"/> <!--三阳合病之自汗出，是阳明里热炽盛，迫津外泄所致，属于热盛之汗，非表虚之汗。因此，在本体中应当用“大汗”（DaHan）来表示，而非桂枝汤证的“汗出”（Hanchu），因后者常提示表虚。-->
		                </owl:Restriction>
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#DanYuMei"/> <!-- 但欲眠睡 -->
		                </owl:Restriction>
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#MuHeZeHan"/>
		                </owl:Restriction>
		                <!-- 脉浮大上关上：浮脉（太阳）、洪大脉（阳明） -->
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_maixiang"/>
		                    <owl:someValuesFrom rdf:resource="#Fumai"/>
		                </owl:Restriction>
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_maixiang"/>
		                    <owl:someValuesFrom rdf:resource="#Hongdamai"/>
		                </owl:Restriction>
		            </owl:intersectionOf>
		        </owl:Class>
		    </owl:equivalentClass>
		    <possibleSymptom rdf:resource="#Fare"/>
		    <possibleSymptom rdf:resource="#Ehan"/>
		    <possibleSymptom rdf:resource="#Wuhan"/>
		    <possibleSymptom rdf:resource="#Kouke"/>
		    <possibleSymptom rdf:resource="#DaRe"/>
		    <possibleSymptom rdf:resource="#DaKe"/>
		    <possibleSymptom rdf:resource="#DanreBuhan"/>
		    <possibleSymptom rdf:resource="#WanglaiHanre"/>
		    <possibleSymptom rdf:resource="#XiongxieKuman"/>
		    <possibleSymptom rdf:resource="#Kouku"/>
		    <rdfs:subClassOf>
		        <owl:Restriction>
		            <owl:onProperty rdf:resource="#you_chufang"/>
		            <owl:hasValue rdf:resource="#ChaihuBaihuTang"/>
		        </owl:Restriction>
		    </rdfs:subClassOf>
		</owl:Class>
    
