    <!-- 舌象原子类 + 个体      -->
    <!-- ======================== -->
    <owl:Class rdf:about="#HuangzaoQiciTai"><rdfs:subClassOf rdf:resource="#Shexiang"/><rdfs:label xml:lang="zh">黄燥起刺苔</rdfs:label></owl:Class>
    <owl:NamedIndividual rdf:about="#HuangzaoQiciTai_instance"><rdf:type rdf:resource="#HuangzaoQiciTai"/></owl:NamedIndividual>

    <!-- ======================== -->
    <!-- 腹证原子类 + 个体      -->
    <!-- ======================== -->
    <owl:Class rdf:about="#XinxiaAnzhiMantong"><rdfs:subClassOf rdf:resource="#Fuzheng"/><rdfs:label xml:lang="zh">心下按之满痛</rdfs:label></owl:Class>
    <owl:NamedIndividual rdf:about="#XinxiaAnzhiMantong_instance"><rdf:type rdf:resource="#XinxiaAnzhiMantong"/></owl:NamedIndividual>

    <owl:Class rdf:about="#FumanYingtong"><rdfs:subClassOf rdf:resource="#Fuzheng"/><rdfs:label xml:lang="zh">腹满硬痛</rdfs:label></owl:Class>
    <owl:NamedIndividual rdf:about="#FumanYingtong_instance"><rdf:type rdf:resource="#FumanYingtong"/></owl:NamedIndividual>

    <!-- ======================== -->
    <!-- 八纲原子类定义（依据胡希恕理论） -->
    <!-- ======================== -->
    <owl:Class rdf:about="#Biao">
		    <rdfs:subClassOf rdf:resource="#Bagang"/>
		    <owl:equivalentClass>
		        <owl:Restriction>
		            <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		            <owl:someValuesFrom>
		                <owl:Class>
		                    <owl:unionOf rdf:parseType="Collection">
		                        <owl:Class rdf:about="#Ehan"/>
		                        <owl:Class rdf:about="#Efeng"/>
		                    </owl:unionOf>
		                </owl:Class>
		            </owl:someValuesFrom>
		        </owl:Restriction>
		    </owl:equivalentClass>
		</owl:Class>

    <owl:Class rdf:about="#Li">
        <rdfs:subClassOf rdf:resource="#Bagang"/>
        <owl:equivalentClass>
        	<owl:Restriction>
        	    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
        	    <owl:someValuesFrom>
        	        <owl:Class>
        	            <owl:unionOf rdf:parseType="Collection">
        	                <owl:Class rdf:about="#Fuman"/>
        	                <owl:Class rdf:about="#Bianmi"/>
        	                <owl:Class rdf:about="#Xiali"/>
        	                <owl:Class rdf:about="#Outu"/>
        	                <owl:Class rdf:about="#Kouke"/>
        	            </owl:unionOf>
        	        </owl:Class>
        	    </owl:someValuesFrom>
        	</owl:Restriction>
        </owl:equivalentClass>
    </owl:Class>

    <owl:Class rdf:about="#Han">
		    <rdfs:subClassOf rdf:resource="#Bagang"/>
		    <owl:equivalentClass>
		        <owl:Class>
		            <owl:unionOf rdf:parseType="Collection">
		                <!-- 恶寒 + 无汗 -->
		                <owl:Class>
		                    <owl:intersectionOf rdf:parseType="Collection">
		                        <owl:Restriction>
		                            <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                            <owl:someValuesFrom rdf:resource="#Ehan"/>
		                        </owl:Restriction>
		                        <owl:Restriction>
		                            <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                            <owl:someValuesFrom rdf:resource="#Wuhan"/>
		                        </owl:Restriction>
		                    </owl:intersectionOf>
		                </owl:Class>
		                <!-- 下利清谷 -->
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#XialiQinggu"/>
		                </owl:Restriction>
		                <!-- 手足厥冷 + 微细脉 -->
		                <owl:Class>
		                    <owl:intersectionOf rdf:parseType="Collection">
		                        <owl:Restriction>
		                            <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                            <owl:someValuesFrom rdf:resource="#ShouzuJueleng"/>
		                        </owl:Restriction>
		                        <owl:Restriction>
		                            <owl:onProperty rdf:resource="#you_maixiang"/>
		                            <owl:someValuesFrom rdf:resource="#Weiximai"/>
		                        </owl:Restriction>
		                    </owl:intersectionOf>
		                </owl:Class>
		                <!-- 恶寒 + 迟脉 -->
		                <owl:Class>
		                    <owl:intersectionOf rdf:parseType="Collection">
		                        <owl:Restriction>
		                            <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                            <owl:someValuesFrom rdf:resource="#Ehan"/>
		                        </owl:Restriction>
		                        <owl:Restriction>
		                            <owl:onProperty rdf:resource="#you_maixiang"/>
		                            <owl:someValuesFrom rdf:resource="#Chimai"/>
		                        </owl:Restriction>
		                    </owl:intersectionOf>
		                </owl:Class>
		                <!-- 自利 + 不渴 （太阴寒证） -->
		                <owl:Class>
		                    <owl:intersectionOf rdf:parseType="Collection">
		                        <owl:Restriction>
		                            <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                            <owl:someValuesFrom rdf:resource="#Xiali"/>
		                        </owl:Restriction>
		                        <owl:Restriction>
		                            <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                            <owl:someValuesFrom rdf:resource="#BuKe"/>
		                        </owl:Restriction>
		                    </owl:intersectionOf>
		                </owl:Class>
		            </owl:unionOf>
		        </owl:Class>
		    </owl:equivalentClass>
		</owl:Class>

    <owl:Class rdf:about="#Re">
        <rdfs:subClassOf rdf:resource="#Bagang"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                        <owl:someValuesFrom rdf:resource="#DanreBuhan"/>
                    </owl:Restriction>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                                <owl:someValuesFrom rdf:resource="#Kouke"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                                <owl:someValuesFrom rdf:resource="#Fanzao"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                                <owl:someValuesFrom rdf:resource="#Kouke"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="#you_maixiang"/>
                                <owl:someValuesFrom rdf:resource="#Shumai"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                                <owl:someValuesFrom rdf:resource="#Fanzao"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="#you_maixiang"/>
                                <owl:someValuesFrom rdf:resource="#Shumai"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <owl:Class rdf:about="#Xu">
        <rdfs:subClassOf rdf:resource="#Bagang"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                        <owl:someValuesFrom rdf:resource="#Hanchu"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                        <owl:someValuesFrom rdf:resource="#Xiali"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_maixiang"/>
                        <owl:someValuesFrom rdf:resource="#Weiximai"/>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <owl:Class rdf:about="#Shi">
		    <rdfs:subClassOf rdf:resource="#Bagang"/>
		    <owl:equivalentClass>
		        <owl:Class>
		            <owl:unionOf rdf:parseType="Collection">
		                <!-- 表实：无汗 + 脉浮紧 -->
		                <owl:Class>
		                    <owl:intersectionOf rdf:parseType="Collection">
		                        <owl:Restriction>
		                            <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                            <owl:someValuesFrom rdf:resource="#Wuhan"/>
		                        </owl:Restriction>
		                        <owl:Restriction>
		                            <owl:onProperty rdf:resource="#you_maixiang"/>
		                            <owl:someValuesFrom rdf:resource="#Jinmai"/>
		                        </owl:Restriction>
		                    </owl:intersectionOf>
		                </owl:Class>
		                <!-- 里实：便秘 -->
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#Bianmi"/>
		                </owl:Restriction>
		                <!-- 里实：腹满硬痛 -->
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_fuzheng"/>
		                    <owl:someValuesFrom rdf:resource="#FumanYingtong"/>
		                </owl:Restriction>
		                <!-- 里实：沉实脉 -->
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_maixiang"/>
		                    <owl:someValuesFrom rdf:resource="#Chenshimai"/>
		                </owl:Restriction>
		            </owl:unionOf>
		        </owl:Class>
		    </owl:equivalentClass>
		</owl:Class>

    <owl:Class rdf:about="#Yin">
		    <rdfs:subClassOf rdf:resource="#Bagang"/>
		    <owl:equivalentClass>
		        <owl:Class>
		            <owl:unionOf rdf:parseType="Collection">
		                <!-- 表虚寒 -->
		                <owl:Class>
		                    <owl:intersectionOf rdf:parseType="Collection">
		                        <owl:Class rdf:about="#Biao"/>
		                        <owl:Class rdf:about="#Han"/>
		                        <owl:Class rdf:about="#Xu"/>
		                    </owl:intersectionOf>
		                </owl:Class>
		                <!-- 里虚寒 -->
		                <owl:Class>
		                    <owl:intersectionOf rdf:parseType="Collection">
		                        <owl:Class rdf:about="#Li"/>
		                        <owl:Class rdf:about="#Han"/>
		                        <owl:Class rdf:about="#Xu"/>
		                    </owl:intersectionOf>
		                </owl:Class>
		                <!-- 半表半里虚寒 -->
		                <owl:Class>
		                    <owl:intersectionOf rdf:parseType="Collection">
		                        <owl:Class rdf:about="#BanbiaoBanli"/>
		                        <owl:Class rdf:about="#Han"/>
		                        <owl:Class rdf:about="#Xu"/>
		                    </owl:intersectionOf>
		                </owl:Class>
		            </owl:unionOf>
		        </owl:Class>
		    </owl:equivalentClass>
		</owl:Class>
		
		<owl:Class rdf:about="#Yang">
		    <rdfs:subClassOf rdf:resource="#Bagang"/>
		    <owl:equivalentClass>
		        <owl:Class>
		            <owl:unionOf rdf:parseType="Collection">
		                <!-- 表阳证：表证 + 浮脉 -->
		                <owl:Class>
		                    <owl:intersectionOf rdf:parseType="Collection">
		                        <owl:Class rdf:about="#Biao"/>
		                        <owl:Restriction>
		                            <owl:onProperty rdf:resource="#you_maixiang"/>
		                            <owl:someValuesFrom rdf:resource="#Fumai"/>
		                        </owl:Restriction>
		                    </owl:intersectionOf>
		                </owl:Class>
		                <!-- 里阳证：里证 + (热证或实证) -->
		                <owl:Class>
		                    <owl:intersectionOf rdf:parseType="Collection">
		                        <owl:Class rdf:about="#Li"/>
		                        <owl:Class>
		                            <owl:unionOf rdf:parseType="Collection">
		                                <owl:Class rdf:about="#Re"/>
		                                <owl:Class rdf:about="#Shi"/>
		                            </owl:unionOf>
		                        </owl:Class>
		                    </owl:intersectionOf>
		                </owl:Class>
		                <!-- 半表半里阳证：半表半里 + 弦脉 -->
		                <owl:Class>
		                    <owl:intersectionOf rdf:parseType="Collection">
		                        <owl:Class rdf:about="#BanbiaoBanli"/>
		                        <owl:Restriction>
		                            <owl:onProperty rdf:resource="#you_maixiang"/>
		                            <owl:someValuesFrom rdf:resource="#Xianmai"/>
		                        </owl:Restriction>
		                    </owl:intersectionOf>
		                </owl:Class>
		            </owl:unionOf>
		        </owl:Class>
		    </owl:equivalentClass>
		</owl:Class>

    <owl:AllDisjointClasses>
        <owl:members rdf:parseType="Collection">
            <owl:Class rdf:about="#Yin"/>
            <owl:Class rdf:about="#Yang"/>
        </owl:members>
    </owl:AllDisjointClasses>

