		        </owl:Restriction>
		    </rdfs:subClassOf>
		</owl:Class>
		
		<!-- 白虎汤证：决定性主症：大热、大汗、大渴、脉洪大；或然症：但热不寒、口渴、烦躁等 -->
		<owl:Class rdf:about="#BaihuTangZheng">
