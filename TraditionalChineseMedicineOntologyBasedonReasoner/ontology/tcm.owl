		        </owl:Restriction>
		    </rdfs:subClassOf>
		</owl:Class>
		
		<!-- 小柴胡汤证：决定性主症：往来寒热、胸胁苦满、口苦、脉弦；或然症：嘿嘿不欲饮食、心烦喜呕、咽干、目眩等 -->
		<owl:Class rdf:about="#XiaoChaihuTangZheng">
		    <rdfs:subClassOf rdf:resource="#Fangzheng"/>
