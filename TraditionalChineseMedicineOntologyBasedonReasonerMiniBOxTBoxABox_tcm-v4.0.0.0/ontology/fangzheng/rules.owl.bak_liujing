<?xml version='1.0' encoding='UTF-8'?>
<rdf:RDF xmlns="http://www.tcm-classics.org/jingfang#" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xml:base="http://www.tcm-classics.org/jingfang#">

    <owl:Ontology rdf:about="http://www.tcm-classics.org/jingfang/rules">
        <rdfs:label xml:lang="zh">规则层：属性声明与方证级加减规则</rdfs:label>
        <rdfs:comment xml:lang="zh">本模块含规则属性声明、全局注解属性声明、规则出处属性，以及方证级加减规则。层级原则（v2.6 确立）：加减药规则的唯一合法载体是方证层——张仲景加减法全部写在具体方剂的方后注，且多数已固化为具名方（桂枝加葛根汤等），落地形式是方证而非在母方上动态加药；胡希恕「方证是辨证的尖端」，类方仅用于理解方剂谱系与药证规律。故家族层与方根层只承担分类/管理职能，不再挂载任何加减规则。方根级规则原在 fanggen.owl；合方规则在 hebing.owl；兼夹证加减规则在 jianjia.owl（兼夹证本身即一个「证」，属叠加语义，与方证加减正交）。方证级 clinicalPriority 与 bagangAttr 已回归各系统文件。v2.3：家族级、方证级加减规则自旧版 HerbChanges.owl 迁入。v2.4：依《伤寒论》《金匮要略》原文逐条订正 13 处。v2.5：依原文补入 8 个方证级方后注加减法（共 20 条）。v2.6：层级归正——原家族级 7 类与原方根级（fanggen.owl 6 类）的加减规则全部下沉至对应具名方证，新增 34 个方证级规则块；家族层与方根层不再承载加减规则。</rdfs:comment>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/core"/>
        <owl:versionInfo>2.6</owl:versionInfo>
    </owl:Ontology>

    <!-- ============ 规则属性声明 ============ -->
    <owl:AnnotationProperty rdf:about="#addHerbRule">
        <rdfs:label xml:lang="zh">加药规则</rdfs:label>
        <rdfs:comment xml:lang="zh">格式：IF 条件 THEN 加药物X（剂量Y）。由应用层解析执行。</rdfs:comment>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="#removeHerbRule">
        <rdfs:label xml:lang="zh">减药规则</rdfs:label>
        <rdfs:comment xml:lang="zh">格式：IF 条件 THEN 去药物X。由应用层解析执行。</rdfs:comment>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="#replaceHerbRule">
        <rdfs:label xml:lang="zh">换药规则</rdfs:label>
        <rdfs:comment xml:lang="zh">格式：IF 条件 THEN 以药物A替换药物B。由应用层解析执行。</rdfs:comment>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="#dosageChangeRule">
        <rdfs:label xml:lang="zh">剂量调整规则</rdfs:label>
        <rdfs:comment xml:lang="zh">格式：IF 条件 THEN 药物X加量/减量。由应用层解析执行。</rdfs:comment>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="#ruleSource">
        <rdfs:label xml:lang="zh">规则出处</rdfs:label>
        <rdfs:comment xml:lang="zh">规则所依据的原文条文或医家论述。</rdfs:comment>
    </owl:AnnotationProperty>

    <!-- ============ 全局注解属性声明（若 core 未定义，则保留于此） ============ -->
    <owl:AnnotationProperty rdf:about="#clinicalPriority">
        <rdfs:label xml:lang="zh">临床优先级</rdfs:label>
        <rdfs:comment xml:lang="zh">数字越小越优先。1=急证；2=重证；3=常证；4=变证；5=缓证。依据《伤寒论》91条“急当救里”，252条“急下存阴”，胡希恕“六经八纲”学术思想。不参与逻辑推理，只作应用层方证排序依据。</rdfs:comment>
        <rdfs:domain rdf:resource="#Fangzheng"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="#bagangAttr">
        <rdfs:label xml:lang="zh">八纲属性</rdfs:label>
        <rdfs:comment xml:lang="zh">方证的八纲归属：表/里、半表半里、阴/阳、虚/实、寒/热。不参与逻辑推理，只作应用层读取。</rdfs:comment>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="#addHerb">
        <rdfs:label xml:lang="zh">加药</rdfs:label>
        <rdfs:comment xml:lang="zh">兼夹证或方证需要追加的药物资源。与 addHerbRule 字面量规则并存。声明为注解属性，供应用层以注解断言读取（与 addHerbRule/clinicalPriority/bagangAttr 一致）。</rdfs:comment>
    </owl:AnnotationProperty>

    <!-- ============================================================ -->
    <!-- 方证级加减规则（v2.6 自家族级 7 类与方根级 6 类下沉）          -->
    <!-- 说明：以下类本体已在各系统文件中定义，此处仅补充加减规则注解。  -->
    <!-- 每条规则的目标方证均为本体内已存在的具名方证。                  -->
    <!-- ============================================================ -->

    <!-- === 桂枝汤类方衍生的具名方证 === -->

    <!-- 桂枝加葛根汤证（14条） -->
    <owl:Class rdf:about="#Guizhijiagegentangzheng">
        <addHerbRule rdf:parseType="Literal">IF Xiangqiang THEN add Gegen (葛根四两)</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》14条：“太阳病，项背强几几，反汗出恶风者，桂枝加葛根汤主之。”桂枝加葛根汤即桂枝汤加葛根四两。项背强几几为葛根药证。</ruleSource>
    </owl:Class>

    <!-- 桂枝加厚朴杏子汤证（18、43条） -->
    <owl:Class rdf:about="#Guizhijiahoupoxingzitangzheng">
        <addHerbRule rdf:parseType="Literal">IF Chuan THEN add Houpo (厚朴二两) + Xingren (杏仁五十个)</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》18条：“喘家作，桂枝汤加厚朴杏子佳。”43条：“太阳病下之微喘者，桂枝加厚朴杏子汤主之。”喘为厚朴、杏仁药证。</ruleSource>
    </owl:Class>

    <!-- 桂枝加附子汤证（20条） -->
    <owl:Class rdf:about="#Guizhijiafuzitangzheng">
        <addHerbRule rdf:parseType="Literal">IF Hanloubuzhi AND Xiaobiannan THEN add Fuzi (附子一枚，炮)</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》20条：“太阳病，发汗，遂漏不止，其人恶风，小便难，四支微急，难以屈伸者，桂枝加附子汤主之。”</ruleSource>
    </owl:Class>

    <!-- 桂枝去芍药汤证（21条） -->
    <owl:Class rdf:about="#Guizhiqushaoyaotangzheng">
        <removeHerbRule rdf:parseType="Literal">IF Xinxiaoman THEN remove Shaoyao</removeHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》21条：“太阳病下之后，脉促胸满者，桂枝去芍药汤主之。”</ruleSource>
    </owl:Class>

    <!-- 桂枝去芍药加附子汤证（22条） -->
    <owl:Class rdf:about="#Guizhiqushaoyaojiafuzitangzheng">
        <addHerbRule rdf:parseType="Literal">IF Xinxiaoman AND Ehan THEN add Fuzi (附子一枚，炮)</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》22条：“若微恶寒者，桂枝去芍药加附子汤主之。”</ruleSource>
    </owl:Class>

    <!-- 桂枝加桂汤证（117条） -->
    <owl:Class rdf:about="#Guizhijiaguitangzheng">
        <addHerbRule rdf:parseType="Literal">IF Qicongshaofushangchongxin THEN add Guizhi (桂枝加量至五两)</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》117条：“气从少腹上冲心者，与桂枝加桂汤。”即桂枝汤更加桂二两。</ruleSource>
    </owl:Class>

    <!-- 桂枝加芍药汤证（279条） -->
    <owl:Class rdf:about="#Guizhijiashaoyaotangzheng">
        <addHerbRule rdf:parseType="Literal">IF Fuman AND Futong THEN add Shaoyao (芍药加量至六两)</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》279条：“本太阳病，医反下之，因尔腹满时痛者，属太阴也，桂枝加芍药汤主之。”即桂枝汤倍芍药。</ruleSource>
    </owl:Class>

    <!-- 桂枝加大黄汤证（279条） -->
    <owl:Class rdf:about="#Guizhijiadahuangtangzheng">
        <addHerbRule rdf:parseType="Literal">IF Futong AND Juan THEN add Dahuang (大黄二两)</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》279条：“大实痛者，桂枝加大黄汤主之。”即桂枝加芍药汤再加大黄二两。</ruleSource>
    </owl:Class>

    <!-- 桂枝去芍药加蜀漆牡蛎龙骨救逆汤证（112条） -->
    <owl:Class rdf:about="#Guizhiqushaoyaojiashuqimulilonggujiunitangzheng">
        <addHerbRule rdf:parseType="Literal">IF Jingkuang AND Woqibuan THEN add Shuqi (蜀漆三两) + Muli (牡蛎五两) + Longgu (龙骨四两)</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》112条：“亡阳必惊狂，卧起不安者，桂枝去芍药加蜀漆牡蛎龙骨救逆汤主之。”</ruleSource>
    </owl:Class>

    <!-- 桂枝去桂加茯苓白术汤证（28条） -->
    <owl:Class rdf:about="#Guizhiquguijiafulingbaizhutangzheng">
        <addHerbRule rdf:parseType="Literal">IF Xinxiaoman AND Xiaobianbuli THEN add Fuling (茯苓三两) + Baizhu (白术三两)</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》28条：“心下满微痛，小便不利者，桂枝去桂加茯苓白术汤主之。”</ruleSource>
    </owl:Class>

    <!-- 桂枝加芍药生姜各一两人参三两新加汤证（62条） -->
    <owl:Class rdf:about="#Guizhixinjiatangzheng">
        <addHerbRule rdf:parseType="Literal">IF Shentengfan AND Chenchimai THEN add Renshen (人参三两) + Shengjiang (加至四两) + Shaoyao (加至四两)</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》62条：“发汗后，身疼痛，脉沉迟者，桂枝加芍药生姜各一两人参三两新加汤主之。”</ruleSource>
    </owl:Class>

    <!-- 桂枝甘草龙骨牡蛎汤证（118条） -->
    <owl:Class rdf:about="#Guizhigancaolonggumulitangzheng">
        <addHerbRule rdf:parseType="Literal">IF Fanzao AND Xinxiajidong THEN add Longgu (龙骨三两) + Muli (牡蛎三两)</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》118条：“火逆下之，因烧针烦躁者，桂枝甘草龙骨牡蛎汤主之。”</ruleSource>
    </owl:Class>

    <!-- 桂枝加黄芪汤证（金匮·水气病） -->
    <owl:Class rdf:about="#Guizhijiahuangqitangzheng">
        <addHerbRule rdf:parseType="Literal">IF Huanghan AND Liangjingzileng THEN add Huangqi (黄芪五两)</addHerbRule>
        <ruleSource xml:lang="zh">《金匮要略·水气病》：“黄汗之病，两胫自冷……桂枝加黄芪汤主之。”</ruleSource>
    </owl:Class>

    <!-- 桂枝加龙骨牡蛎汤证（金匮·血痹虚劳病） -->
    <owl:Class rdf:about="#Guizhijialonggumulitangzheng">
        <addHerbRule rdf:parseType="Literal">IF Shijingjia AND Shaofuxianji AND Muxuan AND Faluo THEN add Longgu + Muli</addHerbRule>
        <ruleSource xml:lang="zh">《金匮要略·血痹虚劳病》：“夫失精家，少腹弦急，阴头寒，目眩，发落……桂枝加龙骨牡蛎汤主之。”</ruleSource>
    </owl:Class>

    <!-- 小建中汤证（100条） -->
    <owl:Class rdf:about="#Xiaojianzhongtangzheng">
        <addHerbRule rdf:parseType="Literal">IF Fuzhongjitong THEN add Yitang (饴糖一升) + Shaoyao (芍药加量至六两)</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》100条：“伤寒，阳脉涩，阴脉弦，法当腹中急痛，先与小建中汤。”小建中汤即桂枝汤倍芍药加饴糖。</ruleSource>
    </owl:Class>

    <!-- 黄芪建中汤证（金匮·血痹虚劳病） -->
    <owl:Class rdf:about="#Huangqijianzhongtangzheng">
        <addHerbRule rdf:parseType="Literal">IF Xulao AND Liji AND Zhubuzu THEN add Huangqi (黄芪一两半) + Yitang (饴糖一升) + Shaoyao (芍药加量至六两)</addHerbRule>
        <ruleSource xml:lang="zh">《金匮要略·血痹虚劳病》：“虚劳里急，诸不足，黄芪建中汤主之。”黄芪建中汤即小建中汤加黄芪，故亦倍芍药、加饴糖。</ruleSource>
    </owl:Class>

    <!-- === 柴胡汤类方衍生的具名方证 === -->

    <!-- 柴胡加芒硝汤证（104条） -->
    <owl:Class rdf:about="#Chaihujiamangxiaotangzheng">
        <addHerbRule rdf:parseType="Literal">IF Ou AND Chaore THEN add Mangxiao (芒硝二两)</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》104条：“伤寒十三日不解，胸胁满而呕，日晡所发潮热，已而微利……先宜服小柴胡汤以解外，后以柴胡加芒硝汤主之。”柴胡加芒硝汤方：芒硝二两。</ruleSource>
    </owl:Class>

    <!-- 柴胡加龙骨牡蛎汤证（107条） -->
    <owl:Class rdf:about="#Chaihujialonggumulitangzheng">
        <addHerbRule rdf:parseType="Literal">IF Xiongman AND Fanzao AND Xiaobianbuli AND Zhanyu THEN remove Gancao + add Longgu (龙骨一两半) + Muli (牡蛎一两半) + Guizhi (桂枝一两半) + Fuling (茯苓一两半) + Dahuang (大黄二两) + Qiandan (铅丹一两半)</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》107条：“伤寒八九日，下之，胸满烦惊，小便不利，谵语，一身尽重，不可转侧者，柴胡加龙骨牡蛎汤主之。”本方即小柴胡汤去甘草，加龙骨、牡蛎、铅丹、桂枝、茯苓、大黄。</ruleSource>
    </owl:Class>

    <!-- 大柴胡汤证（103、165条） -->
    <owl:Class rdf:about="#Dachaihutangzheng">
        <addHerbRule rdf:parseType="Literal">IF Xinxiaji AND Yuyuweifan AND (Dabianying OR Xiali) THEN remove Renshen + remove Gancao + add Dahuang (大黄二两) + Zhishi (枳实四枚) + Shaoyao (芍药三两)</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》103、165条。心下急、郁郁微烦为胡希恕辨大柴胡汤证之眼目。大柴胡汤即小柴胡汤去人参、甘草，加芍药、枳实、大黄。</ruleSource>
    </owl:Class>

    <!-- === 四逆汤类方衍生的具名方证 === -->

    <!-- 白通汤证（314、315条） -->
    <owl:Class rdf:about="#Baitongtangzheng">
        <addHerbRule rdf:parseType="Literal">IF Xiali AND Weimai THEN remove Gancao + add Congbai (葱白四茎)</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》314条：“少阴病，下利，白通汤主之。”315条：“少阴病，下利脉微者，与白通汤。”白通汤即四逆汤去甘草，加葱白四茎（干姜减为一两）。</ruleSource>
    </owl:Class>

    <!-- 白通加猪胆汁汤证（315条） -->
    <owl:Class rdf:about="#Baitongjiazhudanzhitangzheng">
        <addHerbRule rdf:parseType="Literal">IF Ganou AND Jueni THEN add Zhudanzhi (猪胆汁一合) + Renniao (人尿五合)</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》315条：“利不止，厥逆无脉，干呕烦者，白通加猪胆汁汤主之。”即白通汤加人尿五合、猪胆汁一合。</ruleSource>
    </owl:Class>

    <!-- 四逆加人参汤证（385条） -->
    <owl:Class rdf:about="#Sinijiarenshentangzheng">
        <addHerbRule rdf:parseType="Literal">IF Lizhi AND Wangxue THEN add Renshen</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》385条：“恶寒脉微而复利，利止亡血也，四逆加人参汤主之。”即四逆汤加人参一两。</ruleSource>
    </owl:Class>

    <!-- 茯苓四逆汤证（69条） -->
    <owl:Class rdf:about="#Fulingsinitangzheng">
        <addHerbRule rdf:parseType="Literal">IF Fanzao THEN add Fuling + Renshen</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》69条：“发汗，若下之，病仍不解，烦躁者，茯苓四逆汤主之。”即四逆汤加茯苓、人参。</ruleSource>
    </owl:Class>

    <!-- === 麻黄汤类方衍生的具名方证 === -->

    <!-- 大青龙汤证（38条） -->
    <owl:Class rdf:about="#Daqinglongtangzheng">
        <addHerbRule rdf:parseType="Literal">IF Fanzao THEN add Shigao (石膏如鸡子大) + Shengjiang (生姜三两) + Dazao (大枣十枚)</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》38条：“太阳中风，脉浮紧，发热恶寒，身疼痛，不汗出而烦躁者，大青龙汤主之。”大青龙汤即麻黄汤加石膏、生姜、大枣。</ruleSource>
    </owl:Class>

    <!-- 小青龙加石膏汤证（金匮·肺痿肺痈咳嗽上气病） -->
    <owl:Class rdf:about="#Xiaoqinglongjiashigaotangzheng">
        <addHerbRule rdf:parseType="Literal">IF Fanzao AND Kesou AND Chuan THEN add Shigao (石膏二两)</addHerbRule>
        <ruleSource xml:lang="zh">《金匮要略·肺痿肺痈咳嗽上气病》：“肺胀，咳而上气，烦躁而喘，脉浮者，心下有水，小青龙加石膏汤主之。”</ruleSource>
    </owl:Class>

    <!-- === 理中汤类方衍生的具名方证 === -->

    <!-- 桂枝人参汤证（163条） -->
    <owl:Class rdf:about="#Guizhirenshentangzheng">
        <addHerbRule rdf:parseType="Literal">IF Xiongzhipiying AND Xialibuzhi AND Fare AND Ehan THEN add Guizhi (桂枝四两)</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》163条：“太阳病，外证未除，而数下之，遂协热而利，利下不止，心下痞硬，表里不解者，桂枝人参汤主之。”即理中汤加桂枝四两（甘草加至四两）。</ruleSource>
    </owl:Class>

    <!-- === 五苓散类方衍生的具名方证 === -->

    <!-- 茵陈五苓散证（金匮·黄疸病） -->
    <owl:Class rdf:about="#Yinchenwulingsanzheng">
        <addHerbRule rdf:parseType="Literal">IF Huangdan THEN add Yinchenhao (茵陈蒿末十分，五苓散五分，比例二比一)</addHerbRule>
        <ruleSource xml:lang="zh">《金匮要略·黄疸病》：“黄疸病，茵陈五苓散主之。”方：茵陈蒿末十分，五苓散五分，二物和，先食饮方寸匕，日三服。</ruleSource>
    </owl:Class>

    <!-- === 真武汤证（316条方后注四法） === -->

    <!-- 真武汤证（316条） -->
    <owl:Class rdf:about="#Zhenwutangzheng">
        <addHerbRule rdf:parseType="Literal">IF Kesou THEN add Wuweizi (五味子半升) + Xixin (细辛一两) + Ganjiang (干姜一两)</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》316条方后注：“若咳者，加五味子半升，细辛一两，干姜一两。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">IF Xiaobianbuli THEN retain Fuling (茯苓三两)</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》316条方后注：“若小便利者，去茯苓。”真武汤本有茯苓三两，故小便不利者保留茯苓，非另加。</ruleSource>

        <addHerbRule rdf:parseType="Literal">IF Xiali THEN remove Shaoyao (芍药) + add Ganjiang (干姜二两)</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》316条方后注：“若下利者，去芍药，加干姜二两。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">IF Ou THEN remove Fuzi (附子) + add Shengjiang (生姜半斤)</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》316条方后注：“若呕者，去附子，加生姜，足前为半斤。”</ruleSource>
    </owl:Class>

    <!-- === 栀子豉类方衍生的具名方证 === -->

    <!-- 栀子甘草豉汤证（76条） -->
    <owl:Class rdf:about="#Zhizigancaochitangzheng">
        <addHerbRule rdf:parseType="Literal">IF Shaoqi THEN add Gancao</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》76条：“若少气者，栀子甘草豉汤主之。”即栀子豉汤加甘草二两。</ruleSource>
    </owl:Class>

    <!-- 栀子生姜豉汤证（76条） -->
    <owl:Class rdf:about="#Zhizishengjiangchitangzheng">
        <addHerbRule rdf:parseType="Literal">IF Ou THEN add Shengjiang</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》76条：“若呕者，栀子生姜豉汤主之。”即栀子豉汤加生姜五两。</ruleSource>
    </owl:Class>

    <!-- 栀子厚朴汤证（79条） -->
    <owl:Class rdf:about="#Zhizihoupotangzheng">
        <addHerbRule rdf:parseType="Literal">IF Xinfan AND Fuman AND Woqibuan THEN add Houpo + Zhishi</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》79条：“伤寒下后，心烦腹满，卧起不安者，栀子厚朴汤主之。”即栀子豉汤去香豉，加厚朴、枳实。</ruleSource>
    </owl:Class>

    <!-- 栀子干姜汤证（80条） -->
    <owl:Class rdf:about="#Zhiziganjiangtangzheng">
        <addHerbRule rdf:parseType="Literal">IF Shenrebuqu AND Weifan THEN add Ganjiang</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》80条：“伤寒，医以丸药大下之，身热不去，微烦者，栀子干姜汤主之。”即栀子豉汤去香豉，加干姜二两。</ruleSource>
    </owl:Class>

    <!-- === 其他具名方证 === -->

    <!-- 小半夏加茯苓汤证（金匮·痰饮咳嗽病） -->
    <owl:Class rdf:about="#Xiaobanxiajiafulingtangzheng">
        <addHerbRule rdf:parseType="Literal">IF Xinxiapi AND Gexianyoushui AND Xuanji THEN add Fuling</addHerbRule>
        <ruleSource xml:lang="zh">《金匮要略·痰饮咳嗽病》：“卒呕吐，心下痞，膈间有水，眩悸者，小半夏加茯苓汤主之。”即小半夏汤加茯苓四两。</ruleSource>
    </owl:Class>

    <!-- 芍药甘草附子汤证（68条） -->
    <owl:Class rdf:about="#Shaoyaogancaofuzitangzheng">
        <addHerbRule rdf:parseType="Literal">IF Ehan THEN add Fuzi</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》68条：“发汗病不解，反恶寒者，虚故也，芍药甘草附子汤主之。”即芍药甘草汤加附子一枚。</ruleSource>
    </owl:Class>

    <!-- ============================================================ -->
    <!-- 方证级方后注加减规则（v2.3 迁入 / v2.4 订正 / v2.5 补入）      -->
    <!-- 说明：以下为张仲景方后注中未固化为具名方的动态加减法。          -->
    <!-- ============================================================ -->

    <!-- 小柴胡汤证（96条方后注完整加减法） -->
    <owl:Class rdf:about="#Xiaochaihutangzheng">
        <addHerbRule rdf:parseType="Literal">
            IF Xiongzhongfan AND Buou THEN remove Banxia + remove Renshen + add Gualoushi (栝楼实一枚)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》96条方后注：“若胸中烦而不呕，去半夏、人参，加栝蒌实一枚。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Kouke THEN remove Banxia + add Renshen (加至四两半) + add Gualougen (栝蒌根四两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》96条方后注：“若渴，去半夏，加人参合前成四两半，栝蒌根四两。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Futong THEN remove Huangqin + add Shaoyao (芍药三两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》96条方后注：“若腹中痛者，去黄芩，加芍药三两。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Xiexiapiying THEN remove Dazao + add Muli (牡蛎四两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》96条方后注：“若胁下痞硬，去大枣，加牡蛎四两。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Xinxiajidong AND Xiaobianbuli THEN remove Huangqin + add Fuling (茯苓四两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》96条方后注：“若心下悸，小便不利者，去黄芩，加茯苓四两。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Buke AND Shenyouweire THEN remove Renshen + add Guizhi (桂枝三两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》96条方后注：“若不渴，外有微热者，去人参，加桂枝三两，温覆微汗愈。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Kesou THEN remove Renshen + remove Dazao + remove Shengjiang + add Wuweizi (五味子半升) + add Ganjiang (干姜二两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》96条方后注：“若咳者，去人参、大枣、生姜，加五味子半升，干姜二两。”</ruleSource>
    </owl:Class>

    <!-- 四逆散证（318条方后注） -->
    <owl:Class rdf:about="#Sinisanzheng">
        <addHerbRule rdf:parseType="Literal">
            IF Kesou THEN add Wuweizi (五味子五分) + Ganjiang (干姜五分)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》318条方后注：“咳者，加五味子、干姜各五分，并主下利。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Xinxiajidong THEN add Guizhi (桂枝五分)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》318条方后注：“悸者，加桂枝五分。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Xiaobianbuli THEN add Fuling (茯苓五分)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》318条方后注：“小便不利者，加茯苓五分。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Futong THEN add Fuzi (附子一枚，炮令坼)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》318条方后注：“腹中痛者，加附子一枚，炮令坼。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Xielixiazhong THEN add Xiebai (薤白三升)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》318条方后注：“泄利下重者，先以水五升，煮薤白三升，煮取三升，去滓，以散三方寸匕，内汤中，煮取一升半，分温再服。”</ruleSource>
    </owl:Class>

    <!-- 理中汤证（386条方后注） -->
    <owl:Class rdf:about="#Lizhongtangzheng">
        <addHerbRule rdf:parseType="Literal">
            IF Qidongzhe THEN remove Baizhu + add Guizhi (桂枝四两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》386条方后注：“若脐上筑者，肾气动也，去术加桂四两。”脐上筑属冲气上逆，加桂取桂枝平冲降逆之义（参117条桂枝加桂汤）。</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Outu AND Duoyu THEN remove Baizhu + add Shengjiang (生姜三两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》386条方后注：“吐多者，去术加生姜三两。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Xialiduo THEN retain Baizhu (术)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》386条方后注：“下多者还用术。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Ji AND Xinxiajidong THEN add Fuling (茯苓二两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》386条方后注：“悸者加茯苓二两。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Kouke THEN add Baizhu (术，加至四两半)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》386条方后注：“渴欲得水者，加术，足前成四两半。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Futong THEN add Renshen (人参，加至四两半)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》386条方后注：“腹中痛者，加人参，足前成四两半。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Han THEN add Ganjiang (干姜，加至四两半)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》386条方后注：“寒者，加干姜，足前成四两半。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Fuman THEN remove Baizhu + add Fuzi (附子一枚，炮)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》386条方后注：“腹满者，去术，加附子一枚。服汤后，如食顷，饮热粥一升许，微自温，勿发揭衣被。”</ruleSource>
    </owl:Class>

    <!-- 通脉四逆汤证（317条方后注 + 方剂构成） -->
    <owl:Class rdf:about="#Tongmaisinitangzheng">
        <addHerbRule rdf:parseType="Literal">
            IF Miansechi AND Shenfanbuehan THEN add Gancao + Ganjiang (加至三两) + Fuzi (大者一枚)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》317条：“少阴病，下利清谷，里寒外热，手足厥逆，脉微欲绝，身反不恶寒，其人面色赤……通脉四逆汤主之。”通脉四逆汤即四逆汤重用干姜、附子（大者一枚）。</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Miansechi THEN add Congbai (葱白九茎)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》317条方后注：“面色赤者，加葱九茎。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Futong THEN remove Congbai + add Shaoyao (芍药二两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》317条方后注：“腹中痛者，去葱，加芍药二两。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Outu THEN add Shengjiang (生姜二两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》317条方后注：“呕者，加生姜二两。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Yanhoubuli THEN remove Shaoyao + add Jiegeng (桔梗一两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》317条方后注：“咽痛者，去芍药，加桔梗一两。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Lizhi AND Maibuchuzhe THEN remove Jiegeng + add Renshen (人参二两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》317条方后注：“利止脉不出者，去桔梗，加人参二两。”</ruleSource>
    </owl:Class>

    <!-- 小青龙汤证（40条方后注五法 + 方剂构成） -->
    <owl:Class rdf:about="#Xiaoqinglongtangzheng">
        <addHerbRule rdf:parseType="Literal">
            IF Kesou AND Tanduo AND Buke THEN remove Xingren + add Banxia (半夏半升) + Wuweizi (五味子半升) + Xixin (细辛三两) + Ganjiang (干姜三两) + Shaoyao (芍药三两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》40条：“伤寒表不解，心下有水气，干呕发热而咳……小青龙汤主之。”小青龙汤即麻黄汤去杏仁，加芍药、细辛、干姜、五味子、半夏。</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Kouke THEN remove Banxia + add Gualougen (栝蒌根三两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》40条方后注：“若渴，去半夏，加栝蒌根三两。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Weili THEN remove Mahuang + add Raohua (荛花如鸡子大，熬令赤色)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》40条方后注：“若微利，去麻黄，加荛花，如一鸡子，熬令赤色。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Ye THEN remove Mahuang + add Fuzi (附子一枚，炮)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》40条方后注：“若噎者，去麻黄，加附子一枚，炮。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Xiaobianbuli AND Shaofuman THEN remove Mahuang + add Fuling (茯苓四两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》40条方后注：“若小便不利，少腹满者，去麻黄，加茯苓四两。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Chuan THEN remove Mahuang + add Xingren (杏仁半升，去皮尖)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》40条方后注：“若喘，去麻黄，加杏仁半升，去皮尖。”</ruleSource>
    </owl:Class>

    <!-- 防己黄芪汤证（金匮·痉湿暍病脉证治 方后注四法） -->
    <owl:Class rdf:about="#Fangjihuangqitangzheng">
        <addHerbRule rdf:parseType="Literal">
            IF Chuan THEN add Mahuang (麻黄半两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《金匮要略·痉湿暍病脉证治》：“喘者加麻黄半两。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Weizhongbuhe THEN add Shaoyao (芍药三分)
        </addHerbRule>
        <ruleSource xml:lang="zh">《金匮要略·痉湿暍病脉证治》：“胃中不和者加芍药三分。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Qishangchong THEN add Guizhi (桂枝三分)
        </addHerbRule>
        <ruleSource xml:lang="zh">《金匮要略·痉湿暍病脉证治》：“气上冲者加桂枝三分。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Xiayouchenhan THEN add Xixin (细辛三分)
        </addHerbRule>
        <ruleSource xml:lang="zh">《金匮要略·痉湿暍病脉证治》：“下有陈寒者加细辛三分。”</ruleSource>
    </owl:Class>

    <!-- 厚朴七物汤证（金匮·腹满寒疝宿食病 方后注三法） -->
    <owl:Class rdf:about="#Houpoqiwutangzheng">
        <addHerbRule rdf:parseType="Literal">
            IF Ou THEN add Banxia (半夏五合)
        </addHerbRule>
        <ruleSource xml:lang="zh">《金匮要略·腹满寒疝宿食病》：“呕者加半夏五合。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Xiali THEN remove Dahuang (大黄)
        </addHerbRule>
        <ruleSource xml:lang="zh">《金匮要略·腹满寒疝宿食病》：“下利去大黄。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Handuo THEN add Shengjiang (生姜加至半斤)
        </addHerbRule>
        <ruleSource xml:lang="zh">《金匮要略·腹满寒疝宿食病》：“寒多者加生姜至半斤。”</ruleSource>
    </owl:Class>

    <!-- 当归生姜羊肉汤证（金匮·腹满寒疝宿食病 方后注二法） -->
    <owl:Class rdf:about="#Dangguishengjiangyangroutangzheng">
        <addHerbRule rdf:parseType="Literal">
            IF Handuo THEN add Shengjiang (生姜加至一斤)
        </addHerbRule>
        <ruleSource xml:lang="zh">《金匮要略·腹满寒疝宿食病》：“若寒多者，加生姜成一斤。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Tongduoerou THEN add Chenpi (橘皮二两) + Baizhu (白术一两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《金匮要略·腹满寒疝宿食病》：“痛多而呕者，加橘皮二两、白术一两。”橘皮即陈皮，本体以 Chenpi 收录。</ruleSource>
    </owl:Class>

    <!-- 枳实栀子豉汤证（393条方后注） -->
    <owl:Class rdf:about="#Zhishizhizichitangzheng">
        <addHerbRule rdf:parseType="Literal">
            IF Sushi THEN add Dahuang (大黄如博棋子五六枚)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》393条方后注：“若有宿食者，内大黄如博棋子五六枚，服之愈。”</ruleSource>
    </owl:Class>

    <!-- 竹叶汤证（金匮·妇人产后病 方后注） -->
    <owl:Class rdf:about="#Zhuyetangzheng">
        <addHerbRule rdf:parseType="Literal">
            IF Ou THEN add Banxia (半夏半升，洗)
        </addHerbRule>
        <ruleSource xml:lang="zh">《金匮要略·妇人产后病脉证治》：“呕者，加半夏半升洗。”</ruleSource>
    </owl:Class>

    <!-- 白术散证（金匮·妇人妊娠病 方后注三法） -->
    <owl:Class rdf:about="#Baizhusanzheng">
        <addHerbRule rdf:parseType="Literal">
            IF Kutong THEN add Shaoyao (芍药)
        </addHerbRule>
        <ruleSource xml:lang="zh">《金匮要略·妇人妊娠病脉证治》白术散方后注：“但苦痛，加芍药。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Xinxiaodutong THEN add Chuanxiong (川芎倍量)
        </addHerbRule>
        <ruleSource xml:lang="zh">《金匮要略·妇人妊娠病脉证治》白术散方后注：“心下毒痛，倍加川芎。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Xinfantutongbunengshiyin THEN add Xixin (细辛一两) + Banxia (半夏大者二十枚)
        </addHerbRule>
        <ruleSource xml:lang="zh">《金匮要略·妇人妊娠病脉证治》白术散方后注：“心烦吐痛，不能食饮，加细辛一两、半夏大者二十枚。”</ruleSource>
    </owl:Class>

    <!-- 越婢汤证（金匮·水气病 方后注） -->
    <owl:Class rdf:about="#Yuebitangzheng">
        <addHerbRule rdf:parseType="Literal">
            IF Efeng THEN add Fuzi (附子一枚，炮)
        </addHerbRule>
        <ruleSource xml:lang="zh">《金匮要略·水气病脉证并治》：“恶风者加附子一枚炮。风水加术四两。”</ruleSource>
    </owl:Class>

</rdf:RDF>
