<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_JingFang_v27" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.48.0" xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL https://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd">
  <bpmn:error id="Error_NoCandidate" name="NO_CANDIDATE" errorCode="NO_CANDIDATE" />
  <bpmn:process id="JingFangDiagnosis_v27" name="经方辨证论治 v27.0" isExecutable="true">
    <!-- Start -->
    <bpmn:startEvent id="Start_PatientVisit" name="患者就诊">
      <bpmn:outgoing>Flow_To_Step1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_To_Step1" sourceRef="Start_PatientVisit" targetRef="Task_Step1_BaGang" />

    <!-- Step 1 -->
    <bpmn:businessRuleTask id="Task_Step1_BaGang" name="Step 1: 八纲综合判定">
      <bpmn:documentation>证据链驱动，无权重。输出含置信度分数</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="step1-bagang" />
        <zeebe:ioMapping>
          <zeebe:input source="=symptomIris" target="symptomIris" />
          <zeebe:input source="=pulseIris" target="pulseIris" />
          <zeebe:input source="=tongueIris" target="tongueIris" />
          <zeebe:output source="=bagangResult" target="bagangResult" />
          <zeebe:output source="=jianjiaMarkers" target="jianjiaMarkers" />
          <zeebe:output source="=evidenceChain" target="evidenceChain" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_Step1</bpmn:incoming>
      <bpmn:incoming>Flow_BackFrom_Inquiry</bpmn:incoming>
      <bpmn:incoming>Flow_BackTo_Step1_FromNoCandidate</bpmn:incoming>
      <bpmn:outgoing>Flow_To_EvidenceCheck</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_To_EvidenceCheck" sourceRef="Task_Step1_BaGang" targetRef="Gateway_EvidenceCheck" />

    <!-- Gateway -->
    <bpmn:exclusiveGateway id="Gateway_EvidenceCheck" name="证据链完整？">
      <bpmn:incoming>Flow_To_EvidenceCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_Evidence_Complete</bpmn:outgoing>
      <bpmn:outgoing>Flow_Evidence_Incomplete</bpmn:outgoing>
      <bpmn:outgoing>Flow_Evidence_Severe</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Evidence_Complete" name="完整" sourceRef="Gateway_EvidenceCheck" targetRef="Task_Step2_Primary">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=bagangResult.complete = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Evidence_Incomplete" name="部分不完整" sourceRef="Gateway_EvidenceCheck" targetRef="Task_IterativeInquiry">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=bagangResult.incompleteCount = 1</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Evidence_Severe" name="严重不足" sourceRef="Gateway_EvidenceCheck" targetRef="Task_LowConfidence">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=bagangResult.incompleteCount &gt;= 2</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Inquiry & LowConf -->
    <bpmn:serviceTask id="Task_IterativeInquiry" name="迭代补充问诊">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="iterative-inquiry" />
        <zeebe:ioMapping>
          <zeebe:input source="=bagangResult" target="bagangResult" />
          <zeebe:output source="=supplementSymptoms" target="supplementSymptoms" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Evidence_Incomplete</bpmn:incoming>
      <bpmn:outgoing>Flow_BackFrom_Inquiry</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_BackFrom_Inquiry" sourceRef="Task_IterativeInquiry" targetRef="Task_Step1_BaGang" />

    <bpmn:serviceTask id="Task_LowConfidence" name="参考方输出（需确认）">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="low-confidence-output" />
        <zeebe:ioMapping>
          <zeebe:input source="=bagangResult" target="bagangResult" />
          <zeebe:output source="=finalFormula" target="finalFormula" />
          <zeebe:output source="=safetyLevel" target="safetyLevel" />
          <zeebe:output source="=contraindicationWarnings" target="contraindicationWarnings" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Evidence_Severe</bpmn:incoming>
      <bpmn:outgoing>Flow_LowConf_To_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_LowConf_To_End" sourceRef="Task_LowConfidence" targetRef="End_Output" />

    <!-- Step 2 -->
    <bpmn:businessRuleTask id="Task_Step2_Primary" name="Step 2: 主病判定 + 急症识别">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="step2-primary" />
        <zeebe:ioMapping>
          <zeebe:input source="=bagangResult" target="bagangResult" />
          <zeebe:input source="=symptomIris" target="symptomIris" />
          <zeebe:input source="=pulseIris" target="pulseIris" />
          <zeebe:input source="=tongueIris" target="tongueIris" />
          <zeebe:output source="=isEmergency" target="isEmergency" />
          <zeebe:output source="=emergencyFormula" target="emergencyFormula" />
          <zeebe:output source="=emergencyLabel" target="emergencyLabel" />
          <zeebe:output source="=emergencyRationale" target="emergencyRationale" />
          <zeebe:output source="=primaryDisease" target="primaryDisease" />
          <zeebe:output source="=combinedDiseaseMark" target="combinedDiseaseMark" />
          <zeebe:output source="=treatmentPriority" target="treatmentPriority" />
          <zeebe:output source="=isChuZhong" target="isChuZhong" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Evidence_Complete</bpmn:incoming>
      <bpmn:outgoing>Flow_To_EmergencyCheck</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_To_EmergencyCheck" sourceRef="Task_Step2_Primary" targetRef="Gateway_EmergencyCheck" />

    <!-- Emergency Gateway -->
    <bpmn:exclusiveGateway id="Gateway_EmergencyCheck" name="是否为急症？">
      <bpmn:incoming>Flow_To_EmergencyCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_IsEmergency</bpmn:outgoing>
      <bpmn:outgoing>Flow_NotEmergency</bpmn:outgoing>
      <bpmn:outgoing>Flow_IsChuZhong</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_IsEmergency" name="是急症（非除中）" sourceRef="Gateway_EmergencyCheck" targetRef="UserTask_PhysicianConfirm">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=isEmergency = true and isChuZhong = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_IsChuZhong" name="除中危候" sourceRef="Gateway_EmergencyCheck" targetRef="End_ChuZhong">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=isChuZhong = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotEmergency" name="非急症" sourceRef="Gateway_EmergencyCheck" targetRef="Task_Step3_LiuJing">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=isEmergency = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Physician Confirm -->
    <bpmn:userTask id="UserTask_PhysicianConfirm" name="医师确认（急症）">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="user-task" />
        <zeebe:ioMapping>
          <zeebe:input source="=emergencyFormula" target="emergencyFormula" />
          <zeebe:input source="=emergencyLabel" target="emergencyLabel" />
          <zeebe:input source="=emergencyRationale" target="emergencyRationale" />
          <zeebe:output source="=physicianConfirmed" target="physicianConfirmed" />
          <zeebe:output source="=physicianNote" target="physicianNote" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_IsEmergency</bpmn:incoming>
      <bpmn:outgoing>Flow_Confirmed_To_Step5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_Confirmed_To_Step5" sourceRef="UserTask_PhysicianConfirm" targetRef="Task_Step5_Output" />
    <bpmn:endEvent id="End_ChuZhong" name="除中危候·需紧急评估">
      <bpmn:incoming>Flow_IsChuZhong</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Step 3 -->
    <bpmn:businessRuleTask id="Task_Step3_LiuJing" name="Step 3: 六经归属 + 策略判断">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="step3-liujing" />
        <zeebe:ioMapping>
          <zeebe:input source="=bagangResult" target="bagangResult" />
          <zeebe:input source="=combinedDiseaseMark" target="combinedDiseaseMark" />
          <zeebe:input source="=jianjiaMarkers" target="jianjiaMarkers" />
          <zeebe:output source="=sixChannel" target="sixChannel" />
          <zeebe:output source="=jingDuration" target="jingDuration" />
          <zeebe:output source="=isCombinedChannel" target="isCombinedChannel" />
          <zeebe:output source="=treatmentStrategy" target="treatmentStrategy" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NotEmergency</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Step4</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_To_Step4" sourceRef="Task_Step3_LiuJing" targetRef="Task_Step4_FangZheng" />

    <!-- ★★★ Step 4：普通任务（非子流程） ★★★ -->
    <bpmn:businessRuleTask id="Task_Step4_FangZheng" name="Step 4: 方证匹配">
      <bpmn:documentation>
        ①候选池筛选 ②硬性排除 ③核心病机匹配 ④否决症状淘汰
        ⑤特异性加减 ⑥双重一致性校验 ⑦合病+兼夹 ⑧证据链排序 ⑨条文锚定
      </bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="step4-fangzheng-match" />
        <zeebe:ioMapping>
          <zeebe:input source="=symptomIris" target="symptomIris" />
          <zeebe:input source="=pulseIris" target="pulseIris" />
          <zeebe:input source="=tongueIris" target="tongueIris" />
          <zeebe:input source="=sixChannel" target="sixChannel" />
          <zeebe:input source="=combinedDiseaseMark" target="combinedDiseaseMark" />
          <zeebe:input source="=jianjiaMarkers" target="jianjiaMarkers" />
          <zeebe:input source="=treatmentStrategy" target="treatmentStrategy" />
          <zeebe:output source="=candidateFormulas" target="candidateFormulas" />
          <zeebe:output source="=top1Formula" target="top1Formula" />
          <zeebe:output source="=modificationSuggestion" target="modificationSuggestion" />
          <zeebe:output source="=heFangSuggestion" target="heFangSuggestion" />
          <zeebe:output source="=rejectionRecord" target="rejectionRecord" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_Step4</bpmn:incoming>
      <bpmn:outgoing>Flow_Step4_To_Step5</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <!-- ★★★ 错误边界事件直接贴在 Step 4 任务上 ★★★ -->
    <bpmn:boundaryEvent id="BoundaryEvent_NoCandidate" attachedToRef="Task_Step4_FangZheng" cancelActivity="true">
      <bpmn:outgoing>Flow_BackTo_Step1_FromNoCandidate</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_NoCandidate" errorRef="Error_NoCandidate" />
    </bpmn:boundaryEvent>

    <bpmn:sequenceFlow id="Flow_BackTo_Step1_FromNoCandidate" sourceRef="BoundaryEvent_NoCandidate" targetRef="Task_Step1_BaGang" />
    <bpmn:sequenceFlow id="Flow_Step4_To_Step5" sourceRef="Task_Step4_FangZheng" targetRef="Task_Step5_Output" />

    <!-- Step 5 -->
    <bpmn:businessRuleTask id="Task_Step5_Output" name="Step 5: 禁忌校验 + 处方输出">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="step5-contraindication" />
        <zeebe:ioMapping>
          <zeebe:input source="=candidateFormulas" target="candidateFormulas" />
          <zeebe:input source="=top1Formula" target="top1Formula" />
          <zeebe:input source="=sixChannel" target="sixChannel" />
          <zeebe:input source="=jingDuration" target="jingDuration" />
          <zeebe:input source="=emergencyFormula" target="emergencyFormula" />
          <zeebe:input source="=physicianConfirmed" target="physicianConfirmed" />
          <zeebe:input source="=symptomIris" target="symptomIris" />
          <zeebe:input source="=pulseIris" target="pulseIris" />
          <zeebe:input source="=tongueIris" target="tongueIris" />
          <zeebe:output source="=finalFormula" target="finalFormula" />
          <zeebe:output source="=safetyLevel" target="safetyLevel" />
          <zeebe:output source="=contraindicationWarnings" target="contraindicationWarnings" />
          <zeebe:output source="=transmissionWarnings" target="transmissionWarnings" />
          <zeebe:output source="=decoctionMethod" target="decoctionMethod" />
          <zeebe:output source="=administrationMethod" target="administrationMethod" />
          <zeebe:output source="=stopCondition" target="stopCondition" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Step4_To_Step5</bpmn:incoming>
      <bpmn:incoming>Flow_Confirmed_To_Step5</bpmn:incoming>
      <bpmn:outgoing>Flow_To_End</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_To_End" sourceRef="Task_Step5_Output" targetRef="End_Output" />

    <!-- End -->
    <bpmn:endEvent id="End_Output" name="出方完成">
      <bpmn:incoming>Flow_To_End</bpmn:incoming>
      <bpmn:incoming>Flow_LowConf_To_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>

  <!-- BPMNDiagram 图形坐标（已简化，去掉子流程内部元素） -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_v27">
    <bpmndi:BPMNPlane id="BPMNPlane_v27" bpmnElement="JingFangDiagnosis_v27">
      <bpmndi:BPMNShape id="Start_PatientVisit_di" bpmnElement="Start_PatientVisit">
        <dc:Bounds x="160" y="230" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Step1_BaGang_di" bpmnElement="Task_Step1_BaGang">
        <dc:Bounds x="260" y="210" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_EvidenceCheck_di" bpmnElement="Gateway_EvidenceCheck" isMarkerVisible="true">
        <dc:Bounds x="460" y="225" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Step2_Primary_di" bpmnElement="Task_Step2_Primary">
        <dc:Bounds x="580" y="210" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_EmergencyCheck_di" bpmnElement="Gateway_EmergencyCheck" isMarkerVisible="true">
        <dc:Bounds x="800" y="225" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Step3_LiuJing_di" bpmnElement="Task_Step3_LiuJing">
        <dc:Bounds x="920" y="210" width="160" height="80" />
      </bpmndi:BPMNShape>
      <!-- ★ Step 4 普通任务图形 -->
      <bpmndi:BPMNShape id="Task_Step4_FangZheng_di" bpmnElement="Task_Step4_FangZheng">
        <dc:Bounds x="1140" y="210" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Step5_Output_di" bpmnElement="Task_Step5_Output">
        <dc:Bounds x="1320" y="210" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Output_di" bpmnElement="End_Output">
        <dc:Bounds x="1530" y="230" width="36" height="36" />
      </bpmndi:BPMNShape>
      
      <!-- 其他形状（Inquiry, LowConf, PhysicianConfirm, ChuZhong, BoundaryEvent） -->
      <bpmndi:BPMNShape id="Task_IterativeInquiry_di" bpmnElement="Task_IterativeInquiry">
        <dc:Bounds x="260" y="80" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_LowConfidence_di" bpmnElement="Task_LowConfidence">
        <dc:Bounds x="415" y="420" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_PhysicianConfirm_di" bpmnElement="UserTask_PhysicianConfirm">
        <dc:Bounds x="920" y="320" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_ChuZhong_di" bpmnElement="End_ChuZhong">
        <dc:Bounds x="1032" y="412" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BoundaryEvent_NoCandidate_di" bpmnElement="BoundaryEvent_NoCandidate">
        <dc:Bounds x="1230" y="275" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- 连线 (略去具体坐标细节，保持大致走向) -->
      <bpmndi:BPMNEdge id="Flow_To_Step1_di" bpmnElement="Flow_To_Step1">
        <di:waypoint x="196" y="248" />
        <di:waypoint x="260" y="248" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_EvidenceCheck_di" bpmnElement="Flow_To_EvidenceCheck">
        <di:waypoint x="400" y="250" />
        <di:waypoint x="460" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Evidence_Complete_di" bpmnElement="Flow_Evidence_Complete">
        <di:waypoint x="510" y="250" />
        <di:waypoint x="580" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Evidence_Incomplete_di" bpmnElement="Flow_Evidence_Incomplete">
        <di:waypoint x="485" y="225" />
        <di:waypoint x="485" y="110" />
        <di:waypoint x="400" y="110" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Evidence_Severe_di" bpmnElement="Flow_Evidence_Severe">
        <di:waypoint x="485" y="275" />
        <di:waypoint x="485" y="420" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BackFrom_Inquiry_di" bpmnElement="Flow_BackFrom_Inquiry">
        <di:waypoint x="330" y="160" />
        <di:waypoint x="330" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_LowConf_To_End_di" bpmnElement="Flow_LowConf_To_End">
        <di:waypoint x="555" y="460" />
        <di:waypoint x="1548" y="460" />
        <di:waypoint x="1548" y="266" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_EmergencyCheck_di" bpmnElement="Flow_To_EmergencyCheck">
        <di:waypoint x="740" y="250" />
        <di:waypoint x="800" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_IsEmergency_di" bpmnElement="Flow_IsEmergency">
        <di:waypoint x="825" y="275" />
        <di:waypoint x="825" y="360" />
        <di:waypoint x="920" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_IsChuZhong_di" bpmnElement="Flow_IsChuZhong">
        <di:waypoint x="825" y="275" />
        <di:waypoint x="825" y="430" />
        <di:waypoint x="1032" y="430" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_NotEmergency_di" bpmnElement="Flow_NotEmergency">
        <di:waypoint x="850" y="250" />
        <di:waypoint x="920" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Confirmed_To_Step5_di" bpmnElement="Flow_Confirmed_To_Step5">
        <di:waypoint x="1060" y="360" />
        <di:waypoint x="1395" y="360" />
        <di:waypoint x="1395" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_Step4_di" bpmnElement="Flow_To_Step4">
        <di:waypoint x="1080" y="250" />
        <di:waypoint x="1140" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Step4_To_Step5_di" bpmnElement="Flow_Step4_To_Step5">
        <di:waypoint x="1260" y="250" />
        <di:waypoint x="1320" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_End_di" bpmnElement="Flow_To_End">
        <di:waypoint x="1470" y="250" />
        <di:waypoint x="1530" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BackTo_Step1_FromNoCandidate_di" bpmnElement="Flow_BackTo_Step1_FromNoCandidate">
        <di:waypoint x="1248" y="311" />
        <di:waypoint x="1248" y="380" />
        <di:waypoint x="330" y="380" />
        <di:waypoint x="330" y="290" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>