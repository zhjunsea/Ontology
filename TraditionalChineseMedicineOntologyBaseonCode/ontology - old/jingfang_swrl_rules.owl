    <swrl:Imp rdf:about="http://www.tcm-classics.org/swrl/rules#RuleD_EightPrincipleAddition">
        <swrl:body>
            <swrl:AtomList>
                <rdf:first>
                    <swrl:ClassAtom>
                        <swrl:classPredicate rdf:resource="http://www.tcm-classics.org/tcm#ClinicalCase"/>
