    <!-- ============================================================ -->
    <!-- 规则E：兼夹合方策略提示                                            -->
    <!-- ============================================================ -->
    <swrl:Imp rdf:about="http://www.tcm-classics.org/swrl/rules#RuleE_CombinationStrategyAlert">
        <rdfs:label xml:lang="zh">兼夹合方策略提示</rdfs:label>
        <rdfs:comment xml:lang="zh">逻辑：若化裁规则的策略为合方（FormulaCombination），
则除推出目标方证外，额外触发合方提示。
临床意义：提示医师此处非简单加药或转方，乃两方合用，
需注意两方药物之重叠与剂量调整。</rdfs:comment>
        <swrl:body>
            <swrl:AtomList>
                <rdf:first>
                    <swrl:ClassAtom>
                        <swrl:classPredicate rdf:resource="http://www.tcm-classics.org/tcm#ClinicalCase"/>
                        <swrl:argument1 rdf:resource="http://www.tcm-classics.org/swrl/rules#p"/>
                    </swrl:ClassAtom>
                </rdf:first>
                <rdf:rest>
                    <swrl:AtomList>
                        <rdf:first>
                            <swrl:IndividualPropertyAtom>
                                <swrl:propertyPredicate rdf:resource="http://www.tcm-classics.org/tcm#hasConfirmedPattern"/>
                                <swrl:argument1 rdf:resource="http://www.tcm-classics.org/swrl/rules#p"/>
                                <swrl:argument2 rdf:resource="http://www.tcm-classics.org/swrl/rules#main"/>
                            </swrl:IndividualPropertyAtom>
                        </rdf:first>
                        <rdf:rest>
                            <swrl:AtomList>
                                <rdf:first>
                                    <swrl:IndividualPropertyAtom>
                                        <swrl:propertyPredicate rdf:resource="http://www.tcm-classics.org/tcm#hasConcomitantPathology"/>
                                        <swrl:argument1 rdf:resource="http://www.tcm-classics.org/swrl/rules#p"/>
                                        <swrl:argument2 rdf:resource="http://www.tcm-classics.org/swrl/rules#conc"/>
                                    </swrl:IndividualPropertyAtom>
                                </rdf:first>
                                <rdf:rest>
                                    <swrl:AtomList>
                                        <rdf:first>
                                            <swrl:ClassAtom>
                                                <swrl:classPredicate rdf:resource="http://www.tcm-classics.org/jianjia#ModificationRule"/>
                                                <swrl:argument1 rdf:resource="http://www.tcm-classics.org/swrl/rules#r"/>
                                            </swrl:ClassAtom>
                                        </rdf:first>
                                        <rdf:rest>
                                            <swrl:AtomList>
                                                <rdf:first>
                                                    <swrl:IndividualPropertyAtom>
                                                        <swrl:propertyPredicate rdf:resource="http://www.tcm-classics.org/jianjia#appliesToPathology"/>
                                                        <swrl:argument1 rdf:resource="http://www.tcm-classics.org/swrl/rules#r"/>
                                                        <swrl:argument2 rdf:resource="http://www.tcm-classics.org/swrl/rules#conc"/>
                                                    </swrl:IndividualPropertyAtom>
                                                </rdf:first>
                                                <rdf:rest>
                                                    <swrl:AtomList>
                                                        <rdf:first>
                                                            <swrl:IndividualPropertyAtom>
                                                                <swrl:propertyPredicate rdf:resource="http://www.tcm-classics.org/jianjia#primaryFormulaPattern"/>
                                                                <swrl:argument1 rdf:resource="http://www.tcm-classics.org/swrl/rules#r"/>
                                                                <swrl:argument2 rdf:resource="http://www.tcm-classics.org/swrl/rules#main"/>
                                                            </swrl:IndividualPropertyAtom>
                                                        </rdf:first>
                                                        <rdf:rest>
                                                            <swrl:AtomList>
                                                                <rdf:first>
                                                                    <swrl:IndividualPropertyAtom>
                                                                        <swrl:propertyPredicate rdf:resource="http://www.tcm-classics.org/jianjia#usesStrategy"/>
                                                                        <swrl:argument1 rdf:resource="http://www.tcm-classics.org/swrl/rules#r"/>
                                                                        <swrl:argument2 rdf:resource="http://www.tcm-classics.org/jianjia#FormulaCombination_Instance"/>
                                                                    </swrl:IndividualPropertyAtom>
                                                                </rdf:first>
                                                                <rdf:rest>
                                                                    <swrl:AtomList>
                                                                        <rdf:first>
                                                                            <swrl:IndividualPropertyAtom>
                                                                                <swrl:propertyPredicate rdf:resource="http://www.tcm-classics.org/jianjia#targetFormulaPattern"/>
                                                                                <swrl:argument1 rdf:resource="http://www.tcm-classics.org/swrl/rules#r"/>
                                                                                <swrl:argument2 rdf:resource="http://www.tcm-classics.org/swrl/rules#target"/>
                                                                            </swrl:IndividualPropertyAtom>
                                                                        </rdf:first>
                                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                                    </swrl:AtomList>
                                                                </rdf:rest>
                                                            </swrl:AtomList>
                                                        </rdf:rest>
                                                    </swrl:AtomList>
                                                </rdf:rest>
                                            </swrl:AtomList>
                                        </rdf:rest>
                                    </swrl:AtomList>
                                </rdf:rest>
                            </swrl:AtomList>
                        </rdf:rest>
                    </swrl:AtomList>
                </rdf:rest>
            </swrl:AtomList>
        </swrl:body>
        <swrl:head>
            <swrl:AtomList>
                <rdf:first>
                    <swrl:IndividualPropertyAtom>
                        <swrl:propertyPredicate rdf:resource="http://www.tcm-classics.org/tcm#suggestedFormulaPattern"/>
                        <swrl:argument1 rdf:resource="http://www.tcm-classics.org/swrl/rules#p"/>
                        <swrl:argument2 rdf:resource="http://www.tcm-classics.org/swrl/rules#target"/>
                    </swrl:IndividualPropertyAtom>
                </rdf:first>
                <rdf:rest>
                    <swrl:AtomList>
                        <rdf:first>
                            <swrl:IndividualPropertyAtom>
                                <swrl:propertyPredicate rdf:resource="http://www.tcm-classics.org/tcm#hasCombinationAlert"/>
                                <swrl:argument1 rdf:resource="http://www.tcm-classics.org/swrl/rules#p"/>
                                <swrl:argument2 rdf:resource="http://www.tcm-classics.org/swrl/rules#target"/>
                            </swrl:IndividualPropertyAtom>
                        </rdf:first>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                    </swrl:AtomList>
                </rdf:rest>
            </swrl:AtomList>
        </swrl:head>
    </swrl:Imp>

</rdf:RDF>