term:Yang
    a skos:Concept ;
    skos:prefLabel "阳"@zh ;
    skos:prefLabel "Yang"@en ;
    skos:broader term:YinYang ;
    skos:exactMatch core:Yang .

term:Yin
    a skos:Concept ;
    skos:prefLabel "阴"@zh ;
    skos:prefLabel "Yin"@en ;
    skos:broader term:YinYang ;
    skos:exactMatch core:Yin .

