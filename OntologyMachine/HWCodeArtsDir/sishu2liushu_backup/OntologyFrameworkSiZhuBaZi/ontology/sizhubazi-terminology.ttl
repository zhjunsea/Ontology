    skos:prefLabel "命宫"@zh ;
    skos:prefLabel "Life Palace (Minggong)"@en ;
    skos:broader term:ChartDomain ;
    skos:exactMatch chart:MingGong .

term:MonthPillar
    a skos:Concept ;
    skos:prefLabel "月柱"@zh ;
    skos:prefLabel "Month Pillar"@en ;
    skos:broader term:Pillar ;
    skos:exactMatch chart:MonthPillar .

term:Pillar
    a skos:Concept ;
    skos:prefLabel "柱"@zh ;
    skos:prefLabel "Pillar"@en ;
    skos:broader term:ChartDomain ;
    skos:exactMatch chart:Pillar .

term:SmallFortune
    a skos:Concept ;
    skos:prefLabel "小运"@zh ;
    skos:prefLabel "Small Fortune"@en ;
    skos:broader term:ChartDomain ;
    skos:exactMatch chart:SmallFortune .

term:TaiYuan
    a skos:Concept ;
    skos:prefLabel "胎元"@zh ;
    skos:prefLabel "Conception Palace (Taiyuan)"@en ;
    skos:broader term:ChartDomain ;
    skos:exactMatch chart:TaiYuan .

term:YearPillar
    a skos:Concept ;
    skos:prefLabel "年柱"@zh ;
    skos:prefLabel "Year Pillar"@en ;
    skos:broader term:Pillar ;
    skos:exactMatch chart:YearPillar .


# ---- relations ----
term:Bondage
    a skos:Concept ;
    skos:prefLabel "合绊（羁绊）"@zh ;
    skos:prefLabel "Bondage"@en ;
    skos:altLabel "合绊"@zh ;   # 源: 本应用设计文档·干支作用域
    skos:altLabel "绊"@zh ;   # 源: 本应用设计文档·干支作用域
    skos:broader term:RelationDomain ;
    skos:exactMatch relations:Bondage .

term:BranchRelation
    a skos:Concept ;
    skos:prefLabel "地支关系"@zh ;
    skos:prefLabel "Branch Relation"@en ;
    skos:broader term:RelationDomain ;
    skos:exactMatch relations:BranchRelation .

term:Clash
    a skos:Concept ;
    skos:prefLabel "相冲"@zh ;
    skos:prefLabel "Clash"@en ;
    skos:altLabel "冲"@zh ;   # 源: 三命通会卷二·论冲
    skos:altLabel "六冲"@zh ;   # 源: 三命通会卷二·论冲
    skos:broader term:BranchRelation ;
    skos:exactMatch relations:Clash .

term:Harm
    a skos:Concept ;
    skos:prefLabel "相穿（六害）"@zh ;
    skos:prefLabel "Harm"@en ;
    skos:altLabel "六害"@zh ;   # 源: 三命通会卷二·论六害
    skos:altLabel "相害"@zh ;   # 源: 三命通会卷二·论六害
    skos:altLabel "穿"@zh ;   # 源: 三命通会卷二·论六害
    skos:broader term:BranchRelation ;
    skos:exactMatch relations:Harm .

term:HiddenRelation
    a skos:Concept ;
    skos:prefLabel "暗合暗拱遥冲遥克"@zh ;
    skos:prefLabel "Hidden Relation"@en ;
    skos:altLabel "暗合"@zh ;   # 源: 三命通会卷二·论暗合
    skos:altLabel "遥冲"@zh ;   # 源: 三命通会卷二·论遥冲
    skos:broader term:RelationDomain ;
    skos:exactMatch relations:HiddenRelation .

term:PhaseRelation
    a skos:Concept ;
    skos:prefLabel "干支五行生克"@zh ;
    skos:prefLabel "Phase Relation"@en ;
    skos:broader term:RelationDomain ;
    skos:exactMatch relations:PhaseRelation .

term:Punishment
    a skos:Concept ;
    skos:prefLabel "三刑"@zh ;
    skos:prefLabel "Punishment"@en ;
    skos:altLabel "刑"@zh ;   # 源: 三命通会卷二·论三刑
    skos:broader term:BranchRelation ;
    skos:exactMatch relations:Punishment .

term:RelationDomain
    a skos:Concept ;
    skos:prefLabel "干支作用域"@zh ;
    skos:prefLabel "Relation Domain"@en ;
    skos:broader term:SiZhuBaZiEntity ;
    skos:exactMatch relations:RelationDomain .

term:SixCombination
    a skos:Concept ;
    skos:prefLabel "六合"@zh ;
    skos:prefLabel "Six Combination"@en ;
    skos:altLabel "地支六合"@zh ;   # 源: 三命通会卷二·论六合
    skos:broader term:BranchRelation ;
    skos:exactMatch relations:SixCombination .

term:StemCombination
    a skos:Concept ;
    skos:prefLabel "天干五合"@zh ;
    skos:prefLabel "Stem Combination"@en ;
    skos:altLabel "五合"@zh ;   # 源: 三命通会卷二·论天干合
    skos:altLabel "天干相合"@zh ;   # 源: 三命通会卷二·论天干合
    skos:broader term:RelationDomain ;
    skos:exactMatch relations:StemCombination .

term:TombRelation
    a skos:Concept ;
    skos:prefLabel "墓库刑冲"@zh ;
    skos:prefLabel "Tomb Relation"@en ;
    skos:altLabel "墓库"@zh ;   # 源: 三命通会卷二·论墓库
    skos:altLabel "入墓"@zh ;   # 源: 三命通会卷二·论墓库
    skos:broader term:BranchRelation ;
    skos:exactMatch relations:TombRelation .

term:TripleCombination
    a skos:Concept ;
    skos:prefLabel "三合（半合）"@zh ;
    skos:prefLabel "Triple Combination"@en ;
    skos:altLabel "三合"@zh ;   # 源: 三命通会卷二·论三合
    skos:altLabel "半合"@zh ;   # 源: 三命通会卷二·论三合
    skos:altLabel "三合局"@zh ;   # 源: 三命通会卷二·论三合
    skos:broader term:BranchRelation ;
    skos:exactMatch relations:TripleCombination .


# ---- tengod ----
term:BiJian
    a skos:Concept ;
    skos:prefLabel "比肩"@zh ;
    skos:prefLabel "Bi Jian (Companion)"@en ;
    skos:broader term:TenGod ;
    skos:exactMatch tengod:BiJian .

term:FoodHurtsKill
    a skos:Concept ;
    skos:prefLabel "食伤制杀"@zh ;
    skos:prefLabel "Food Hurts Kill"@en ;
    skos:altLabel "食伤制煞"@zh ;   # 源: 子平真诠·论食伤制煞
    skos:broader term:TenGodRelation ;
    skos:exactMatch tengod:FoodHurtsKill .

term:JieCai
    a skos:Concept ;
    skos:prefLabel "劫财"@zh ;
    skos:prefLabel "Jie Cai (Rob Wealth)"@en ;
    skos:altLabel "败财"@zh ;   # 源: 三命通会卷二·论劫财
    skos:broader term:TenGod ;
    skos:exactMatch tengod:JieCai .

term:Kinship
    a skos:Concept ;
    skos:prefLabel "六亲"@zh ;
