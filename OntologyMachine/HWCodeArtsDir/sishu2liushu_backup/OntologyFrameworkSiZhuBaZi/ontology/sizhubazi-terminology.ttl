term:Stem_Geng
    a skos:Concept ;
    skos:prefLabel "庚"@zh ;
    skos:prefLabel "Geng Stem"@en ;
    skos:broader term:HeavenlyStem ;
    skos:exactMatch core:Stem_Geng .

term:Stem_Gui
    a skos:Concept ;
    skos:prefLabel "癸"@zh ;
    skos:prefLabel "Gui Stem"@en ;
    skos:broader term:HeavenlyStem ;
    skos:exactMatch core:Stem_Gui .

term:Stem_Ji
    a skos:Concept ;
    skos:prefLabel "己"@zh ;
    skos:prefLabel "Ji Stem"@en ;
    skos:broader term:HeavenlyStem ;
    skos:exactMatch core:Stem_Ji .

term:Stem_Jia
    a skos:Concept ;
    skos:prefLabel "甲"@zh ;
    skos:prefLabel "Jia Stem"@en ;
    skos:broader term:HeavenlyStem ;
    skos:exactMatch core:Stem_Jia .

term:Stem_Ren
    a skos:Concept ;
    skos:prefLabel "壬"@zh ;
    skos:prefLabel "Ren Stem"@en ;
    skos:broader term:HeavenlyStem ;
    skos:exactMatch core:Stem_Ren .

term:Stem_Wu
    a skos:Concept ;
    skos:prefLabel "戊"@zh ;
    skos:prefLabel "Wu Stem"@en ;
    skos:broader term:HeavenlyStem ;
    skos:exactMatch core:Stem_Wu .

term:Stem_Xin
    a skos:Concept ;
    skos:prefLabel "辛"@zh ;
    skos:prefLabel "Xin Stem"@en ;
    skos:broader term:HeavenlyStem ;
