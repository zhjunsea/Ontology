    skos:broader term:GanzhiDomain ;
    skos:exactMatch core:YinYang .


# ---- calendar ----
term:CalendarBoundary
    a skos:Concept ;
    skos:prefLabel "历法边界"@zh ;
    skos:prefLabel "Calendar Boundary"@en ;
    skos:broader term:CalendarDomain ;
    skos:exactMatch calendar:CalendarBoundary .

term:CalendarDomain
    a skos:Concept ;
    skos:prefLabel "历法域"@zh ;
    skos:prefLabel "Calendar Domain"@en ;
    skos:broader term:SiZhuBaZiEntity ;
    skos:exactMatch calendar:CalendarDomain .

term:MonthOrder
    a skos:Concept ;
    skos:prefLabel "月建（月令）"@zh ;
    skos:prefLabel "Month Order"@en ;
    skos:altLabel "月令"@zh ;   # 源: 三命通会卷二·论遁月时
    skos:altLabel "月建"@zh ;   # 源: 三命通会卷二·论遁月时
    skos:broader term:CalendarDomain ;
    skos:exactMatch calendar:MonthOrder .

term:SolarTerm
    a skos:Concept ;
    skos:prefLabel "二十四节气"@zh ;
    skos:prefLabel "Solar Term"@en ;
    skos:altLabel "节气"@zh ;   # 源: 渊海子平卷之一·论节候歌
    skos:broader term:CalendarDomain ;
    skos:exactMatch calendar:SolarTerm .

term:SolarTermInstant
    a skos:Concept ;
    skos:prefLabel "节气时刻（年度实例）"@zh ;
    skos:prefLabel "Solar Term Instant"@en ;
    skos:broader term:CalendarDomain ;
    skos:exactMatch calendar:SolarTermInstant .

term:TrueSolarTime
    a skos:Concept ;
    skos:prefLabel "真太阳时"@zh ;
    skos:prefLabel "True Solar Time"@en ;
    skos:broader term:CalendarDomain ;
    skos:exactMatch calendar:TrueSolarTime .


# ---- chart ----
term:BirthInput
    a skos:Concept ;
    skos:prefLabel "生辰输入"@zh ;
    skos:prefLabel "Birth Input"@en ;
    skos:broader term:ChartDomain ;
    skos:exactMatch chart:BirthInput .

term:ChartDomain
    a skos:Concept ;
    skos:prefLabel "排盘域"@zh ;
    skos:prefLabel "Chart Domain"@en ;
    skos:broader term:SiZhuBaZiEntity ;
    skos:exactMatch chart:ChartDomain .

term:DayPillar
    a skos:Concept ;
    skos:prefLabel "日柱"@zh ;
    skos:prefLabel "Day Pillar"@en ;
    skos:broader term:Pillar ;
