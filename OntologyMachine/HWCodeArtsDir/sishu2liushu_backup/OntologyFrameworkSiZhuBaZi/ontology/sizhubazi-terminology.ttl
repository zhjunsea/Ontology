@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix term: <http://example.org/sizhubazi/term/> .
@prefix core:       <http://example.org/sizhubazi/core/> .
@prefix calendar:   <http://example.org/sizhubazi/calendar/> .
@prefix chart:      <http://example.org/sizhubazi/chart/> .
@prefix relations:  <http://example.org/sizhubazi/relations/> .
@prefix tengod:     <http://example.org/sizhubazi/tengod/> .
@prefix deity:      <http://example.org/sizhubazi/deity/> .
@prefix pattern:    <http://example.org/sizhubazi/pattern/> .
@prefix yongshen:   <http://example.org/sizhubazi/yongshen/> .
@prefix fortune:    <http://example.org/sizhubazi/fortune/> .
@prefix reading:    <http://example.org/sizhubazi/reading/> .
@prefix diagnosis:  <http://example.org/sizhubazi/diagnosis/> .
@prefix rules:      <http://example.org/sizhubazi/rules/> .

<http://example.org/sizhubazi/term>
    a owl:Ontology ;
    a skos:ConceptScheme ;
    skos:prefLabel "四柱命理业务术语体系"@zh ;
    skos:prefLabel "SiZhuBaZi (Four Pillars) Business Terminology"@en ;
    dct:created "2026-10-29"^^<http://www.w3.org/2001/XMLSchema#date> ;
    dct:description "四柱命理领域核心业务术语的标准化词汇表，术语全部来源于本体 (owl:Class / owl:ObjectProperty / owl:DatatypeProperty 的 rdfs:label)，用于统一 OWL 本体及其他系统中的词义，实现同名同义、同义同名。同义词/别名逐条标注四书或设计文档出处，无出处者标【待考】。"@zh .

# ========================
# 类（业务概念）（158）
# ========================

# ---- core ----
term:Branch_Chen
    a skos:Concept ;
    skos:prefLabel "辰"@zh ;
    skos:prefLabel "Chen Branch"@en ;
    skos:broader term:EarthlyBranch ;
    skos:exactMatch core:Branch_Chen .

term:Branch_Chou
    a skos:Concept ;
    skos:prefLabel "丑"@zh ;
    skos:prefLabel "Chou Branch"@en ;
    skos:broader term:EarthlyBranch ;
    skos:exactMatch core:Branch_Chou .

term:Branch_Hai
    a skos:Concept ;
    skos:prefLabel "亥"@zh ;
    skos:prefLabel "Hai Branch"@en ;
    skos:broader term:EarthlyBranch ;
    skos:exactMatch core:Branch_Hai .

term:Branch_Mao
    a skos:Concept ;
    skos:prefLabel "卯"@zh ;
    skos:prefLabel "Mao Branch"@en ;
    skos:broader term:EarthlyBranch ;
    skos:exactMatch core:Branch_Mao .

term:Branch_Shen
    a skos:Concept ;
    skos:prefLabel "申"@zh ;
    skos:prefLabel "Shen Branch"@en ;
    skos:broader term:EarthlyBranch ;
    skos:exactMatch core:Branch_Shen .

term:Branch_Si
    a skos:Concept ;
    skos:prefLabel "巳"@zh ;
    skos:prefLabel "Si Branch"@en ;
    skos:broader term:EarthlyBranch ;
    skos:exactMatch core:Branch_Si .

term:Branch_Wei
    a skos:Concept ;
    skos:prefLabel "未"@zh ;
    skos:prefLabel "Wei Branch"@en ;
    skos:broader term:EarthlyBranch ;
    skos:exactMatch core:Branch_Wei .

term:Branch_Wu
    a skos:Concept ;
    skos:prefLabel "午"@zh ;
    skos:prefLabel "Wu Branch"@en ;
    skos:broader term:EarthlyBranch ;
    skos:exactMatch core:Branch_Wu .

term:Branch_Xu
    a skos:Concept ;
    skos:prefLabel "戌"@zh ;
    skos:prefLabel "Xu Branch"@en ;
    skos:broader term:EarthlyBranch ;
    skos:exactMatch core:Branch_Xu .

term:Branch_Yin
    a skos:Concept ;
    skos:prefLabel "寅"@zh ;
    skos:prefLabel "Yin Branch"@en ;
    skos:broader term:EarthlyBranch ;
    skos:exactMatch core:Branch_Yin .

term:Branch_You
    a skos:Concept ;
    skos:prefLabel "酉"@zh ;
    skos:prefLabel "You Branch"@en ;
    skos:broader term:EarthlyBranch ;
    skos:exactMatch core:Branch_You .

term:Branch_Zi
    a skos:Concept ;
    skos:prefLabel "子"@zh ;
    skos:prefLabel "Zi Branch"@en ;
    skos:broader term:EarthlyBranch ;
    skos:exactMatch core:Branch_Zi .

term:EarthlyBranch
    a skos:Concept ;
    skos:prefLabel "十二地支"@zh ;
    skos:prefLabel "Earthly Branch"@en ;
    skos:altLabel "十二支"@zh ;   # 源: 渊海子平卷之一·论天干地支
    skos:broader term:GanzhiDomain ;
    skos:exactMatch core:EarthlyBranch .

term:FivePhase
    a skos:Concept ;
    skos:prefLabel "五行"@zh ;
    skos:prefLabel "Five Phase"@en ;
    skos:altLabel "五行之气"@zh ;   # 源: 三命通会卷一·论五行生克
    skos:broader term:GanzhiDomain ;
    skos:exactMatch core:FivePhase .

term:GanzhiDomain
    a skos:Concept ;
    skos:prefLabel "干支基础域"@zh ;
    skos:prefLabel "Ganzhi Domain"@en ;
    skos:broader term:SiZhuBaZiEntity ;
    skos:exactMatch core:GanzhiDomain .

term:GanzhiEntity
    a skos:Concept ;
    skos:prefLabel "干支实体"@zh ;
    skos:prefLabel "Ganzhi Entity"@en ;
    skos:definition "承载阴阳/五行的干支实体基类（hasYinYang/hasFivePhase 定义域，§2）"@zh ;
    skos:broader term:SiZhuBaZiEntity ;
    skos:exactMatch core:GanzhiEntity .

term:HeavenlyStem
    a skos:Concept ;
    skos:prefLabel "十天干"@zh ;
    skos:prefLabel "Heavenly Stem"@en ;
    skos:altLabel "十干"@zh ;   # 源: 渊海子平卷之一·论天干地支
    skos:broader term:GanzhiDomain ;
    skos:exactMatch core:HeavenlyStem .

term:HiddenStem
    a skos:Concept ;
    skos:prefLabel "藏干（人元司事）"@zh ;
    skos:prefLabel "Hidden Stem"@en ;
    skos:altLabel "人元"@zh ;   # 源: 三命通会卷一·论人元司事
    skos:altLabel "支藏人元"@zh ;   # 源: 渊海子平卷之一·又地支藏遁歌
    skos:broader term:GanzhiDomain ;
    skos:exactMatch core:HiddenStem .

term:Huo
    a skos:Concept ;
    skos:prefLabel "火"@zh ;
    skos:prefLabel "Fire"@en ;
    skos:broader term:FivePhase ;
    skos:exactMatch core:Huo .

term:Jin
    a skos:Concept ;
    skos:prefLabel "金"@zh ;
    skos:prefLabel "Metal"@en ;
    skos:broader term:FivePhase ;
    skos:exactMatch core:Jin .

term:LifeStage
    a skos:Concept ;
    skos:prefLabel "长生十二宫"@zh ;
    skos:prefLabel "Life Stage"@en ;
    skos:altLabel "长生"@zh ;   # 源: 三命通会卷二·论长生
    skos:altLabel "十二长生"@zh ;   # 源: 三命通会卷二·论长生
    skos:broader term:GanzhiDomain ;
    skos:exactMatch core:LifeStage .

term:Mu
    a skos:Concept ;
    skos:prefLabel "木"@zh ;
    skos:prefLabel "Wood"@en ;
    skos:broader term:FivePhase ;
    skos:exactMatch core:Mu .

term:NaYin
    a skos:Concept ;
    skos:prefLabel "纳音"@zh ;
    skos:prefLabel "Nayin"@en ;
    skos:altLabel "纳音五行"@zh ;   # 源: 三命通会卷一·论纳音取象
    skos:broader term:GanzhiDomain ;
    skos:exactMatch core:NaYin .

term:SexagenaryCycle
    a skos:Concept ;
    skos:prefLabel "六十甲子"@zh ;
    skos:prefLabel "Sexagenary Cycle"@en ;
    skos:altLabel "六十花甲子"@zh ;   # 源: 渊海子平卷之一·论六十花甲子纳音并注解
    skos:altLabel "花甲子"@zh ;   # 源: 三命通会卷一·论纳音取象
    skos:broader term:GanzhiDomain ;
    skos:exactMatch core:SexagenaryCycle .

term:Shui
    a skos:Concept ;
    skos:prefLabel "水"@zh ;
    skos:prefLabel "Water"@en ;
    skos:broader term:FivePhase ;
    skos:exactMatch core:Shui .

term:SiZhuBaZiEntity
    a skos:Concept ;
    skos:prefLabel "本体事物根"@zh ;
    skos:prefLabel "SiZhuBaZi Entity"@en ;
    skos:definition "四柱命理本体根类（所有分支之根）"@zh ;
    skos:exactMatch core:SiZhuBaZiEntity .

term:Stem_Bing
    a skos:Concept ;
    skos:prefLabel "丙"@zh ;
    skos:prefLabel "Bing Stem"@en ;
    skos:broader term:HeavenlyStem ;
