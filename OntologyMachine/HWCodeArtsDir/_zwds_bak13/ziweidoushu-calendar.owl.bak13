<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/ziweidoushu/calendar"
     xml:base="http://example.org/ziweidoushu/calendar"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:core="http://example.org/ziweidoushu/core#"
     xmlns:calendar="http://example.org/ziweidoushu/calendar#"
     xmlns:chart="http://example.org/ziweidoushu/chart#"
     xmlns:star="http://example.org/ziweidoushu/star#"
     xmlns:layout="http://example.org/ziweidoushu/layout#"
     xmlns:state="http://example.org/ziweidoushu/state#"
     xmlns:palace="http://example.org/ziweidoushu/palace#"
     xmlns:pattern="http://example.org/ziweidoushu/pattern#"
     xmlns:fortune="http://example.org/ziweidoushu/fortune#"
     xmlns:reading="http://example.org/ziweidoushu/reading#"
     xmlns:diagnosis="http://example.org/ziweidoushu/diagnosis#"
     xmlns:rules="http://example.org/ziweidoushu/rules#">

    <owl:Ontology rdf:about="http://example.org/ziweidoushu/calendar">
        <owl:imports rdf:resource="http://example.org/ziweidoushu/core"/>
        <rdfs:label xml:lang="zh">紫微斗数本体 TBox 子本体 · calendar（历法时辰（真太阳时/闰月/时辰交界/昼夜/历法边界））</rdfs:label>
        <rdfs:comment xml:lang="zh">第 10 步产出：TBox 按业务域拆分。命名空间 http://example.org/ziweidoushu/calendar 不变；由 ziweidoushu-tbox.owl 聚合入口统一 imports；imports 单向无环（§4.2）。依据《紫微斗數全書》（[宋]陈抟（陈希夷）撰）。属性值一律使用完整绝对 IRI。</rdfs:comment>
    </owl:Ontology>

<owl:Class rdf:about="http://example.org/ziweidoushu/calendar#TrueSolarTime"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/core#CalendarDomain"/><rdfs:label xml:lang="zh">真太阳时（经度校正）</rdfs:label></owl:Class>

<owl:Class rdf:about="http://example.org/ziweidoushu/calendar#LeapMonth"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/core#CalendarDomain"/><rdfs:label xml:lang="zh">闰月归属</rdfs:label></owl:Class>

<owl:Class rdf:about="http://example.org/ziweidoushu/calendar#CalendarBoundary"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/core#CalendarDomain"/><rdfs:label xml:lang="zh">历法边界（时辰交界/昼夜/时区）</rdfs:label></owl:Class>

<owl:ObjectProperty rdf:about="http://example.org/ziweidoushu/calendar#hasTrueSolarTime"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/><owl:inverseOf rdf:resource="http://example.org/ziweidoushu/calendar#isTrueSolarTimeOf"/><rdfs:domain rdf:resource="http://example.org/ziweidoushu/chart#BirthInput"/><rdfs:range rdf:resource="http://example.org/ziweidoushu/calendar#TrueSolarTime"/><rdfs:label xml:lang="zh">真太阳时校正</rdfs:label></owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://example.org/ziweidoushu/calendar#isTrueSolarTimeOf"><owl:inverseOf rdf:resource="http://example.org/ziweidoushu/calendar#hasTrueSolarTime"/><rdfs:domain rdf:resource="http://example.org/ziweidoushu/calendar#TrueSolarTime"/><rdfs:range rdf:resource="http://example.org/ziweidoushu/chart#BirthInput"/></owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://example.org/ziweidoushu/calendar#hasLeapMonth"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/><owl:inverseOf rdf:resource="http://example.org/ziweidoushu/calendar#isLeapMonthOf"/><rdfs:domain rdf:resource="http://example.org/ziweidoushu/chart#BirthInput"/><rdfs:range rdf:resource="http://example.org/ziweidoushu/calendar#LeapMonth"/><rdfs:label xml:lang="zh">闰月归属</rdfs:label></owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://example.org/ziweidoushu/calendar#isLeapMonthOf"><owl:inverseOf rdf:resource="http://example.org/ziweidoushu/calendar#hasLeapMonth"/><rdfs:domain rdf:resource="http://example.org/ziweidoushu/calendar#LeapMonth"/><rdfs:range rdf:resource="http://example.org/ziweidoushu/chart#BirthInput"/></owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://example.org/ziweidoushu/calendar#hasBoundary"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/><owl:inverseOf rdf:resource="http://example.org/ziweidoushu/calendar#isBoundaryOf"/><rdfs:domain rdf:resource="http://example.org/ziweidoushu/chart#BirthInput"/><rdfs:range rdf:resource="http://example.org/ziweidoushu/calendar#CalendarBoundary"/><rdfs:label xml:lang="zh">历法边界</rdfs:label></owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://example.org/ziweidoushu/calendar#isBoundaryOf"><owl:inverseOf rdf:resource="http://example.org/ziweidoushu/calendar#hasBoundary"/><rdfs:domain rdf:resource="http://example.org/ziweidoushu/calendar#CalendarBoundary"/><rdfs:range rdf:resource="http://example.org/ziweidoushu/chart#BirthInput"/></owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="http://example.org/ziweidoushu/calendar#longitude"><rdfs:domain rdf:resource="http://example.org/ziweidoushu/calendar#TrueSolarTime"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/><rdfs:label xml:lang="zh">出生地经度</rdfs:label></owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://example.org/ziweidoushu/calendar#leapMonthRule"><rdfs:domain rdf:resource="http://example.org/ziweidoushu/calendar#LeapMonth"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">闰月归属（按下月）</rdfs:label></owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://example.org/ziweidoushu/calendar#boundaryType"><rdfs:domain rdf:resource="http://example.org/ziweidoushu/calendar#CalendarBoundary"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">历法边界类型（时辰交界/昼夜/时区/夏令时）</rdfs:label></owl:DatatypeProperty>

</rdf:RDF>
