<owl:ObjectProperty rdf:about="http://example.org/ziweidoushu/core#stemFivePhase"><rdfs:domain rdf:resource="http://example.org/ziweidoushu/core#HeavenlyStem"/><rdfs:range rdf:resource="http://example.org/ziweidoushu/core#FivePhase"/><rdfs:label xml:lang="zh">天干五行（映射·SWRL R1 取用）</rdfs:label></owl:ObjectProperty>

