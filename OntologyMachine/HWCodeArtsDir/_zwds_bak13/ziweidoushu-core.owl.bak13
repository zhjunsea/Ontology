<owl:DatatypeProperty rdf:about="http://example.org/ziweidoushu/core#branchName"><rdfs:domain rdf:resource="http://example.org/ziweidoushu/core#EarthlyBranch"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">地支名（子…亥）</rdfs:label></owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://example.org/ziweidoushu/core#branchAnimal"><rdfs:domain rdf:resource="http://example.org/ziweidoushu/core#EarthlyBranch"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">地支生肖（鼠…猪）</rdfs:label></owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://example.org/ziweidoushu/core#branchOrder"><rdfs:domain rdf:resource="http://example.org/ziweidoushu/core#EarthlyBranch"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/><rdfs:label xml:lang="zh">地支序（子=1…亥=12）</rdfs:label></owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://example.org/ziweidoushu/core#naYinName"><rdfs:domain rdf:resource="http://example.org/ziweidoushu/core#NaYin"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">纳音名（海中金…大海水）</rdfs:label></owl:DatatypeProperty>

