<owl:DatatypeProperty rdf:about="http://example.org/ziweidoushu/core#bureauNumber"><rdfs:domain rdf:resource="http://example.org/ziweidoushu/core#FivePhaseBureau"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/><rdfs:label xml:lang="zh">局数（2/3/4/5/6）</rdfs:label></owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://example.org/ziweidoushu/core#stageName"><rdfs:domain rdf:resource="http://example.org/ziweidoushu/core#TwelveStage"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">长生名（长生…养）</rdfs:label></owl:DatatypeProperty>

