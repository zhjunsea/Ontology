<owl:DatatypeProperty rdf:about="http://example.org/ziweidoushu/core#phaseName"><rdfs:domain rdf:resource="http://example.org/ziweidoushu/core#FivePhase"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">五行名（金/木/水/火/土）</rdfs:label></owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://example.org/ziweidoushu/core#stemName"><rdfs:domain rdf:resource="http://example.org/ziweidoushu/core#HeavenlyStem"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">天干名（甲…癸）</rdfs:label></owl:DatatypeProperty>

