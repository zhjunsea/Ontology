[PrefixDeclaration]
core:    http://example.org/sizhubazi/core/
rdfs:    http://www.w3.org/2000/01/rdf-schema#
xsd:     http://www.w3.org/2001/XMLSchema#

[MappingDeclaration] @collection [[
mappingId    ganzhi_stem
target       <core:{name}> a <core:HeavenlyStem> ;
                rdfs:label "{label}"^^xsd:string ;
                <core:stemName> "{stem_name}"^^xsd:string .
source       SELECT name, COALESCE(stem_name,'') AS stem_name, COALESCE(label,'') AS label FROM ganzhi_stem WHERE name IS NOT NULL
]]
