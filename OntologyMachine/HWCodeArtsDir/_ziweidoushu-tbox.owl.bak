    <owl:Class rdf:about="http://example.org/ziweidoushu/layout#Transformation"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/layout#LayoutDomain"/><rdfs:label xml:lang="zh">四化·动态（化禄/权/科/忌；生年干/宫干引动含落宫）</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/layout#TwelveStagePlacement"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/layout#LayoutDomain"/><rdfs:label xml:lang="zh">十二长生落宫</rdfs:label></owl:Class>

    <owl:Class rdf:about="http://example.org/ziweidoushu/state#StateDomain"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/core#ZiWeiDouShuEntity"/><rdfs:label xml:lang="zh">星曜状态域</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/state#Brightness"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/state#StateDomain"/><rdfs:label xml:lang="zh">庙旺利陷</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/state#Bright_Miao"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/state#Brightness"/><rdfs:label xml:lang="zh">庙</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/state#Bright_Wang"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/state#Brightness"/><rdfs:label xml:lang="zh">旺</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/state#Bright_DeDi"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/state#Brightness"/><rdfs:label xml:lang="zh">得地</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/state#Bright_LiYi"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/state#Brightness"/><rdfs:label xml:lang="zh">利益</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/state#Bright_PingHe"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/state#Brightness"/><rdfs:label xml:lang="zh">平和</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/state#Bright_BuDeDi"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/state#Brightness"/><rdfs:label xml:lang="zh">不得地</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/state#Bright_Xian"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/state#Brightness"/><rdfs:label xml:lang="zh">陷</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/state#PhaseRelation"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/state#StateDomain"/><rdfs:label xml:lang="zh">星辰五行生克制化</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/state#PalaceStrength"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/state#StateDomain"/><rdfs:label xml:lang="zh">十二宫弱强/星辰落闲宫</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/state#StarCharacter"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/state#StateDomain"/><rdfs:label xml:lang="zh">星曜化气·静态（尊/善/贵/财/福/囚/令/富/桃花/暗/印/荫/权/耗）</rdfs:label></owl:Class>

    <owl:Class rdf:about="http://example.org/ziweidoushu/palace#PalaceDomain"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/core#ZiWeiDouShuEntity"/><rdfs:label xml:lang="zh">宫位体系域</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/palace#PalaceMeaning"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/palace#PalaceDomain"/><rdfs:label xml:lang="zh">十二宫义</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/palace#SanFangSiZheng"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/palace#PalaceDomain"/><rdfs:label xml:lang="zh">三方四正（本宫+对宫+三合二宫+冲照）</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/palace#Adjoining"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/palace#PalaceDomain"/><rdfs:label xml:lang="zh">夹宫（邻宫相夹）</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/palace#EmptyPalace"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/palace#PalaceDomain"/><rdfs:label xml:lang="zh">空宫借星/借光规则/空宫特殊格局</rdfs:label></owl:Class>
    <!-- ============================ 1. 类体系 · pattern:/fortune:/reading:/diagnosis:/rules: ============================ -->
    <owl:Class rdf:about="http://example.org/ziweidoushu/pattern#PatternDomain"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/core#ZiWeiDouShuEntity"/><rdfs:label xml:lang="zh">格局与星情域</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/pattern#ClassicText"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/pattern#PatternDomain"/><rdfs:label xml:lang="zh">赋论总纲（羅序/太微赋/形性赋/星垣论/斗数准绳/斗数发微论/重补斗数彀率/增补太微赋/骨髓赋/女命骨髓赋）</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/pattern#StarPattern"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/pattern#PatternDomain"/><rdfs:label xml:lang="zh">星曜格局（卷一诸格论：对面朝斗格/科权禄主格/左右朝垣格/兼文武格/文星朝命格/石中隐玉格/贪狼遇火名火贵格 等 + 断人十二目；卷三诸格断语：紫府朝垣/府相朝垣/君臣庆会/七杀朝斗/巨机居卯/明禄暗禄 等；夹宫诸格：紫府夹命/日月夹命/昌曲夹命/羊陀夹忌/火铃夹命/魁钺夹命/左右夹命/劫空夹命；夹身：三夹凶·六夹吉）</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/pattern#SpecialStructure"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/pattern#PatternDomain"/><rdfs:label xml:lang="zh">定局（卷一）：富局6格（财荫夹印/日月夹财/财禄夹马/荫印拱身/日月照璧/金灿光辉）；贵局27格（日月夹命/日出扶桑/月落亥宫·月朗天门/月生沧海/辅弼拱主/君臣庆会/财印夹禄/禄马佩印/坐贵向贵/马头带剑/七杀朝斗/日月并明/明珠出海/日月同临/刑囚夹印/科权禄拱/贪火相逢/武曲守垣/府相朝垣/紫府朝垣/文星暗拱/权禄生逢/羊刃入庙/巨机居卯/明禄暗禄/科明暗禄/金舆扶驾）；贫贱局8格（生不逢时/禄逢两杀/马落空亡/日月藏辉/财与囚仇/一生孤贫/君子在野/两重华盖）；杂局8格（风云际会/锦上添花/禄衰马困/衣锦还乡/步数无依/水上驾星/吉凶相伴/枯木逢春）</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/pattern#PalaceStarQualification"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/pattern#PatternDomain"/><rdfs:label xml:lang="zh">十二宫诸星得地合格/失陷破格/得地富贵/失陷贫贱</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/pattern#PatternGrade"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/pattern#PatternDomain"/><rdfs:label xml:lang="zh">命格高低（论人命入格/论格星数高下；定富贵贫贱十等论：福寿/聪明/威勇/文职/武职/刑名/富贵/贫贱/疾殀/僧道）</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/pattern#StarCombination"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/pattern#PatternDomain"/><rdfs:label xml:lang="zh">星曜组合断法（双星/三星同宫、三方四正复合象义）</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/pattern#StarMeaning"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/pattern#PatternDomain"/><rdfs:label xml:lang="zh">诸星所主/星情（星情格语）</rdfs:label></owl:Class>

    <owl:Class rdf:about="http://example.org/ziweidoushu/fortune#FortuneDomain"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/core#ZiWeiDouShuEntity"/><rdfs:label xml:lang="zh">运限域</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/fortune#GreatLimit"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/fortune#FortuneDomain"/><rdfs:label xml:lang="zh">大限（起限/顺逆/童限）</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/fortune#SmallLimit"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/fortune#FortuneDomain"/><rdfs:label xml:lang="zh">小限</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/fortune#AnnualFortune"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/fortune#FortuneDomain"/><rdfs:label xml:lang="zh">流年/太岁</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/fortune#RecalculatedDeity"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/fortune#FortuneDomain"/><rdfs:label xml:lang="zh">流年重算流曜（流禄/流羊/流陀/流年十二神/斗君）</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/fortune#OverlayReading"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/fortune#FortuneDomain"/><rdfs:label xml:lang="zh">叠宫断法/三盘叠加（本命↔大限↔流年）</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/fortune#TriggeredPattern"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/fortune#FortuneDomain"/><rdfs:label xml:lang="zh">凶格引动（羊陀迭并/七杀重逢）</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/fortune#LimitSong"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/fortune#FortuneDomain"/><rdfs:label xml:lang="zh">行限宫歌（分南北斗；太岁并小限到十二宫入庙化吉/不入庙化凶）</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/fortune#LimitTaboo"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/fortune#FortuneDomain"/><rdfs:label xml:lang="zh">大小限星辰过十二宫遇十二支所忌</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/fortune#FlyingTransformation"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/fortune#FortuneDomain"/><rdfs:label xml:lang="zh">宫干飞化/化入化出·飞星轨</rdfs:label></owl:Class>

    <owl:Class rdf:about="http://example.org/ziweidoushu/reading#ReadingDomain"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/core#ZiWeiDouShuEntity"/><rdfs:label xml:lang="zh">断语域</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/reading#ReadingItem"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/reading#ReadingDomain"/><rdfs:label xml:lang="zh">断语条目（分类断总类）</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/reading#Temperament"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/reading#ReadingItem"/><rdfs:label xml:lang="zh">性情形貌</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/reading#Kinship"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/reading#ReadingItem"/><rdfs:label xml:lang="zh">六亲（父母/兄弟/夫妻/子女）</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/reading#Marriage"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/reading#ReadingItem"/><rdfs:label xml:lang="zh">婚姻</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/reading#Career"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/reading#ReadingItem"/><rdfs:label xml:lang="zh">事业官禄（含官阶分类：公卿/两官府/文官/武官/曹吏）</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/reading#Wealth"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/reading#ReadingItem"/><rdfs:label xml:lang="zh">财帛（含贫富先后）</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/reading#Disease"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/reading#ReadingItem"/><rdfs:label xml:lang="zh">疾病疾厄</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/reading#Longevity"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/reading#ReadingItem"/><rdfs:label xml:lang="zh">寿夭孤克残疾（含定人残疾/破相/聪明/富足/贫贱/作盗贼/一身驳杂/僧道/商贾/艺术）</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/reading#GenderDifference"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/reading#ReadingItem"/><rdfs:label xml:lang="zh">男女命同异</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/reading#LadyFortune"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/reading#ReadingItem"/><rdfs:label xml:lang="zh">女命专论</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/reading#ChildFortune"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/reading#ReadingItem"/><rdfs:label xml:lang="zh">小儿命/关煞/童限</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/reading#Admonition"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/reading#ReadingItem"/><rdfs:label xml:lang="zh">阴骘延寿劝诫</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/reading#ReadingConclusion"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/reading#ReadingDomain"/><rdfs:label xml:lang="zh">综合结论/命书</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/reading#StructuredOutput"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/reading#ReadingDomain"/><rdfs:label xml:lang="zh">结构化批断（JSON Schema）</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/reading#ChartGraphic"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/reading#ReadingDomain"/><rdfs:label xml:lang="zh">命盘图形化规范（十二宫方形布局与图示约定）</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/reading#CaseRecord"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/reading#ReadingDomain"/><rdfs:label xml:lang="zh">命例记录/隐私存档（脱敏）</rdfs:label></owl:Class>

    <owl:Class rdf:about="http://example.org/ziweidoushu/diagnosis#DiagnosisDomain"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/core#ZiWeiDouShuEntity"/><rdfs:label xml:lang="zh">出处与流派标注域</rdfs:label></owl:Class>
