    <owl:DatatypeProperty rdf:about="http://example.org/ziweidoushu/state#phaseRelationType"><rdfs:domain rdf:resource="http://example.org/ziweidoushu/state#PhaseRelation"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">五行关系类型（生/克/制/化）</rdfs:label></owl:DatatypeProperty>
