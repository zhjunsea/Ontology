        <swrl:head><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://example.org/ziweidoushu/fortune#limitDirection"/><swrl:argument1 rdf:resource="http://example.org/ziweidoushu/rules#r8b_gl"/><swrl:argument2>逆</swrl:argument2></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></swrl:head>
