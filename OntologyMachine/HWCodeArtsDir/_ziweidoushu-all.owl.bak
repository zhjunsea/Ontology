    <!-- ============================ 5. SWRL 规则（§5） ============================ -->
    <!-- 已序列化 R1/R8/R8b/R21（良构、谓词均在 §2/§3 定义）。其余规则依《本体核心设计》§5 标注
         「由程序实现 / 查表（OBDA）/ 待考」，不在 SWRL 中序列化（避免空头或非良构规则），留痕如下：
           R2/R3  五行生/克传递闭包            → 由 core:generates/overcomes 的 owl:TransitiveProperty 承载
           R4     安星落宫赋值                → 由程序/OBDA 查 star_layout 表（安星表庞大）
           R5     五行局→紫微起宫（定位表）    → 由程序/OBDA 查表（紫微定位棋盘图）
           R6     庙陷判定                    → 由程序/OBDA 查 brightness_map；冲突按 I·63 来源优先级并列
           R7     四化落宫（生年干）          → 由程序/OBDA 查 sihua_map
           R9     三方四正取宫                → 取宫算法由程序（宫序变换），SWRL 承接断言
           R10    夹宫判定                    → 两邻宫星曜组合命中由程序判定（多条件）
           R11    空宫借星                    → 含闭世界否定（对宫有主星），由程序；采通行规则，待考·中
           R12    成格判定·分类              → 简单分类可 SWRL，组合成格综合由程序
           R13    命格高低·等第              → 综合评级（多因子）由程序计算
           R14    十二长生顺逆                → 布列由程序（男顺女逆）
           R15    流年流曜重算                → 由程序/OBDA 查 deity_rule 表（不得沿用出生年流曜）
           R16    叠宫断法·三盘叠加          → 叠合编排由程序；待考·中
           R17    凶格引动·羊陀迭并/七杀重逢  → 限内叠合命中由程序判定
           R18    告警·大凶                  → 综合判据（多因子）由程序编排，SWRL 只落最终标志
           R19    告警·寿元关                → 综合判据（倒限/寿星受制）由程序编排
           R20    告警·重大疾病              → 疾厄宫恶曜凑合综合由程序；命中落 hasAlertFlag
           R22    出处绑定                  → 由程序在生成期绑定（非推理）
           R23    定富局/定贵局成格          → 简单成格分类可 SWRL，多格综合由程序
           R24    大小限过十二支所忌          → 所忌表查取由程序/OBDA
           R25    行限到宫入庙/不入庙        → 庙陷查表由程序
    -->
    <rdf:Description rdf:about="http://example.org/ziweidoushu/rules#r1_s"><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/></rdf:Description>
    <rdf:Description rdf:about="http://example.org/ziweidoushu/rules#r1_p"><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/></rdf:Description>
    <rdf:Description rdf:about="http://example.org/ziweidoushu/rules#r8_f"><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/></rdf:Description>
    <rdf:Description rdf:about="http://example.org/ziweidoushu/rules#r8_i"><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/></rdf:Description>
    <rdf:Description rdf:about="http://example.org/ziweidoushu/rules#r8_gl"><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/></rdf:Description>
    <rdf:Description rdf:about="http://example.org/ziweidoushu/rules#r8b_f"><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/></rdf:Description>
    <rdf:Description rdf:about="http://example.org/ziweidoushu/rules#r8b_i"><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/></rdf:Description>
    <rdf:Description rdf:about="http://example.org/ziweidoushu/rules#r8b_gl"><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/></rdf:Description>
    <rdf:Description rdf:about="http://example.org/ziweidoushu/rules#r21_f"><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/></rdf:Description>
    <rdf:Description rdf:about="http://example.org/ziweidoushu/rules#r21_a"><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/></rdf:Description>
    <!-- R1 干支→五行传导：HeavenlyStem(?s) ∧ stemFivePhase(?s,?p) → hasFivePhase(?s,?p)（卷二·星辰屬性诸条） -->
    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/><swrl:classPredicate rdf:resource="http://example.org/ziweidoushu/core#HeavenlyStem"/><swrl:argument1 rdf:resource="http://example.org/ziweidoushu/rules#r1_s"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://example.org/ziweidoushu/core#stemFivePhase"/><swrl:argument1 rdf:resource="http://example.org/ziweidoushu/rules#r1_s"/><swrl:argument2 rdf:resource="http://example.org/ziweidoushu/rules#r1_p"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></swrl:body>
        <swrl:head><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://example.org/ziweidoushu/core#hasFivePhase"/><swrl:argument1 rdf:resource="http://example.org/ziweidoushu/rules#r1_s"/><swrl:argument2 rdf:resource="http://example.org/ziweidoushu/rules#r1_p"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></swrl:head>
    </rdf:Description>
    <!-- R8 大限起限顺逆（阳男顺行）：NatalChart(?f) ∧ hasBirthInput(?f,?i) ∧ gender(?i,"男") ∧ yearStemYinYang(?f,"阳") ∧ hasGreatLimit(?f,?gl) → limitDirection(?gl,"顺")（卷二·安大限訣） -->
    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/><swrl:classPredicate rdf:resource="http://example.org/ziweidoushu/chart#NatalChart"/><swrl:argument1 rdf:resource="http://example.org/ziweidoushu/rules#r8_f"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://example.org/ziweidoushu/chart#hasBirthInput"/><swrl:argument1 rdf:resource="http://example.org/ziweidoushu/rules#r8_f"/><swrl:argument2 rdf:resource="http://example.org/ziweidoushu/rules#r8_i"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://example.org/ziweidoushu/chart#gender"/><swrl:argument1 rdf:resource="http://example.org/ziweidoushu/rules#r8_i"/><swrl:argument2>男</swrl:argument2></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://example.org/ziweidoushu/chart#yearStemYinYang"/><swrl:argument1 rdf:resource="http://example.org/ziweidoushu/rules#r8_f"/><swrl:argument2>阳</swrl:argument2></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="http://example.org/ziweidoushu/fortune#hasGreatLimit"/><swrl:argument1 rdf:resource="http://example.org/ziweidoushu/rules#r8_f"/><swrl:argument2 rdf:resource="http://example.org/ziweidoushu/rules#r8_gl"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></swrl:body>
