    <owl:Class rdf:about="http://example.org/ziweidoushu/star#StarDomain"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/core#ZiWeiDouShuEntity"/><rdfs:label xml:lang="zh">星曜域</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/star#Star"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/star#StarDomain"/><rdfs:label xml:lang="zh">星曜根</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/star#FourteenMainStar"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/star#Star"/><rdfs:label xml:lang="zh">十四主星</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/star#BeiDouStar"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/star#FourteenMainStar"/><rdfs:label xml:lang="zh">北斗主星（紫微/天机/太阳/武曲/天同/廉贞）</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/star#NanDouStar"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/star#FourteenMainStar"/><rdfs:label xml:lang="zh">南斗主星（天府/太阴/贪狼/巨门/天相/天梁/七杀/破军）</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/star#AuxiliaryStar"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/star#Star"/><rdfs:label xml:lang="zh">辅佐星（左辅/右弼/文昌/文曲/天魁/天钺/天马/禄存）</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/star#MaleficStar"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/star#Star"/><rdfs:label xml:lang="zh">煞忌星（擎羊/陀罗/火星/铃星/天空/地劫/天伤/天使）</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/star#MiscStar"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/star#Star"/><rdfs:label xml:lang="zh">杂曜（三台/八座/龙池/凤阁/台辅/封诰/天刑/天姚/天哭/天虚/红鸾/天喜/天德/月德/解神/截路空亡/旬中空亡）</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/star#YearlyDeity"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/star#StarDomain"/><rdfs:label xml:lang="zh">太岁诸神/流曜（十二神+流禄流羊流陀+斗君+太岁杀禄+四飞星+飞天三杀）</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/star#FourFlyingStar"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/star#YearlyDeity"/><rdfs:label xml:lang="zh">四飞星（丧门/白虎/吊客/官府）</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/ziweidoushu/star#FlyingTriSha"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/star#YearlyDeity"/><rdfs:label xml:lang="zh">飞天三杀（奏书/将军/直符）</rdfs:label></owl:Class>
