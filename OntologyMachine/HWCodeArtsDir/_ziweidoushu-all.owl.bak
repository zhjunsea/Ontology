    <owl:Class rdf:about="http://example.org/ziweidoushu/layout#LayoutDomain"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/core#ZiWeiDouShuEntity"/><rdfs:label xml:lang="zh">安星落宫域</rdfs:label></owl:Class>
