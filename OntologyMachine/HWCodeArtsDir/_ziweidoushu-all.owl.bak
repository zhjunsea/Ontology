    <owl:DatatypeProperty rdf:about="http://example.org/ziweidoushu/reading#caseBirthData"><rdfs:domain rdf:resource="http://example.org/ziweidoushu/reading#CaseRecord"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">命例生辰（脱敏）</rdfs:label></owl:DatatypeProperty>
