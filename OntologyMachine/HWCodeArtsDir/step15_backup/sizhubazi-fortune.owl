<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns="http://example.org/sizhubazi/"
         xml:base="http://example.org/sizhubazi/"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:swrl="http://www.w3.org/2003/11/swrl#"
         xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
         xmlns:skos="http://www.w3.org/2004/02/skos/core#"
         xmlns:core="http://example.org/sizhubazi/core/"
         xmlns:calendar="http://example.org/sizhubazi/calendar/"
         xmlns:chart="http://example.org/sizhubazi/chart/"
         xmlns:relations="http://example.org/sizhubazi/relations/"
         xmlns:tengod="http://example.org/sizhubazi/tengod/"
         xmlns:deity="http://example.org/sizhubazi/deity/"
         xmlns:pattern="http://example.org/sizhubazi/pattern/"
         xmlns:yongshen="http://example.org/sizhubazi/yongshen/"
         xmlns:fortune="http://example.org/sizhubazi/fortune/"
         xmlns:reading="http://example.org/sizhubazi/reading/"
         xmlns:diagnosis="http://example.org/sizhubazi/diagnosis/"
         xmlns:rules="http://example.org/sizhubazi/rules/">

    <owl:Ontology rdf:about="http://example.org/sizhubazi/fortune">
        <owl:imports rdf:resource="http://example.org/sizhubazi/core"/>
        <owl:imports rdf:resource="http://example.org/sizhubazi/chart"/>
        <owl:imports rdf:resource="http://example.org/sizhubazi/yongshen"/>
        <owl:imports rdf:resource="http://example.org/sizhubazi/pattern"/>
        <rdfs:label xml:lang="zh">四柱命理本体 TBox 子本体 · fortune（岁运：大运流年 / 流月日时 / 应期 / 运限 / 特殊岁运格局 / 运化气 / 综合辩证）</rdfs:label>
        <rdfs:comment xml:lang="zh">第 10 步产出：TBox 按业务域拆分。命名空间 http://example.org/sizhubazi/fortune 不变；由 sizhubazi-tbox.owl 聚合入口统一 imports；依赖方向单向无环。</rdfs:comment>
    </owl:Ontology>

    <!-- ============================================================ -->
    <!-- 对象属性 fortune（岁运域） -->
    <!-- ============================================================ -->
    <owl:ObjectProperty rdf:about="fortune/hasGreatFortuneCycle"><owl:inverseOf rdf:resource="fortune/isGreatFortuneCycleOf"/><rdfs:domain rdf:resource="chart/FourPillars"/><rdfs:range rdf:resource="fortune/GreatFortuneCycle"/><rdfs:label xml:lang="zh">有大运周期</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="fortune/isGreatFortuneCycleOf"><owl:inverseOf rdf:resource="fortune/hasGreatFortuneCycle"/><rdfs:domain rdf:resource="fortune/GreatFortuneCycle"/><rdfs:range rdf:resource="chart/FourPillars"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="fortune/hasAnnualFortune"><owl:inverseOf rdf:resource="fortune/isAnnualFortuneOf"/><rdfs:domain rdf:resource="chart/FourPillars"/><rdfs:range rdf:resource="fortune/AnnualFortune"/><rdfs:label xml:lang="zh">有流年</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="fortune/isAnnualFortuneOf"><owl:inverseOf rdf:resource="fortune/hasAnnualFortune"/><rdfs:domain rdf:resource="fortune/AnnualFortune"/><rdfs:range rdf:resource="chart/FourPillars"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="fortune/hasSubAnnualFortune"><owl:inverseOf rdf:resource="fortune/isSubAnnualFortuneOf"/><rdfs:domain rdf:resource="fortune/AnnualFortune"/><rdfs:range rdf:resource="fortune/SubAnnualFortune"/><rdfs:label xml:lang="zh">有流月流日流时</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="fortune/isSubAnnualFortuneOf"><owl:inverseOf rdf:resource="fortune/hasSubAnnualFortune"/><rdfs:domain rdf:resource="fortune/SubAnnualFortune"/><rdfs:range rdf:resource="fortune/AnnualFortune"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="fortune/hasSpecialPattern"><owl:inverseOf rdf:resource="fortune/isSpecialPatternOf"/><rdfs:domain rdf:resource="fortune/AnnualFortune"/><rdfs:range rdf:resource="fortune/SpecialFortunePattern"/><rdfs:label xml:lang="zh">有特殊岁运格局</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="fortune/isSpecialPatternOf"><owl:inverseOf rdf:resource="fortune/hasSpecialPattern"/><rdfs:domain rdf:resource="fortune/SpecialFortunePattern"/><rdfs:range rdf:resource="fortune/AnnualFortune"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="fortune/hasYunHuaQi"><owl:inverseOf rdf:resource="fortune/isYunHuaQiOf"/><rdfs:domain rdf:resource="fortune/GreatFortuneCycle"/><rdfs:range rdf:resource="fortune/YunHuaQi"/><rdfs:label xml:lang="zh">有运化气</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="fortune/isYunHuaQiOf"><owl:inverseOf rdf:resource="fortune/hasYunHuaQi"/><rdfs:domain rdf:resource="fortune/YunHuaQi"/><rdfs:range rdf:resource="fortune/GreatFortuneCycle"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="fortune/hasResponsePeriod"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/><owl:inverseOf rdf:resource="fortune/isResponsePeriodOf"/><rdfs:domain rdf:resource="chart/FourPillars"/><rdfs:range rdf:resource="fortune/ResponsePeriod"/><rdfs:label xml:lang="zh">有应期</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="fortune/isResponsePeriodOf"><owl:inverseOf rdf:resource="fortune/hasResponsePeriod"/><rdfs:domain rdf:resource="fortune/ResponsePeriod"/><rdfs:range rdf:resource="chart/FourPillars"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="fortune/hasLifeStageLimit"><owl:inverseOf rdf:resource="fortune/isLifeStageLimitOf"/><rdfs:domain rdf:resource="chart/FourPillars"/><rdfs:range rdf:resource="fortune/LifeStageLimit"/><rdfs:label xml:lang="zh">有运限</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="fortune/isLifeStageLimitOf"><owl:inverseOf rdf:resource="fortune/hasLifeStageLimit"/><rdfs:domain rdf:resource="fortune/LifeStageLimit"/><rdfs:range rdf:resource="chart/FourPillars"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="fortune/hasFortuneSynthesis"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/><owl:inverseOf rdf:resource="fortune/isFortuneSynthesisOf"/><rdfs:domain rdf:resource="chart/FourPillars"/><rdfs:range rdf:resource="fortune/FortuneSynthesis"/><rdfs:label xml:lang="zh">有岁运综合辩证</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="fortune/isFortuneSynthesisOf"><owl:inverseOf rdf:resource="fortune/hasFortuneSynthesis"/><rdfs:domain rdf:resource="fortune/FortuneSynthesis"/><rdfs:range rdf:resource="chart/FourPillars"/></owl:ObjectProperty>
    <owl:DatatypeProperty rdf:about="fortune/fortuneGanzhi"><rdfs:domain rdf:resource="fortune/GreatFortuneCycle"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">岁运干支</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="fortune/fortuneAgeRange"><rdfs:domain rdf:resource="fortune/GreatFortuneCycle"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">所辖年龄区间</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="fortune/specialPatternName"><rdfs:domain rdf:resource="fortune/SpecialFortunePattern"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">特殊岁运格局名</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="fortune/responseValue"><rdfs:domain rdf:resource="fortune/ResponsePeriod"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/><rdfs:label xml:lang="zh">应期值</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="fortune/responseUnit"><rdfs:domain rdf:resource="fortune/ResponsePeriod"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">应期单位</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="fortune/lifeStageSegment"><rdfs:domain rdf:resource="fortune/LifeStageLimit"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">运限阶段（少年/青年/中年/老年）</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="fortune/synthesisPriority"><rdfs:domain rdf:resource="fortune/FortuneSynthesis"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/><rdfs:label xml:lang="zh">岁运优先级</rdfs:label></owl:DatatypeProperty>
    <!-- ============================================================ -->
    <!-- 类体系 · fortune（岁运域） -->
    <!-- ============================================================ -->
    <owl:Class rdf:about="fortune/FortuneDomain"><rdfs:subClassOf rdf:resource="core/SiZhuBaZiEntity"/><rdfs:label xml:lang="zh">岁运域</rdfs:label></owl:Class>
    <owl:Class rdf:about="fortune/GreatFortuneCycle"><rdfs:subClassOf rdf:resource="fortune/FortuneDomain"/><rdfs:label xml:lang="zh">大运（小运/交运）</rdfs:label></owl:Class>
    <owl:Class rdf:about="fortune/AnnualFortune"><rdfs:subClassOf rdf:resource="fortune/FortuneDomain"/><rdfs:label xml:lang="zh">流年（太岁）</rdfs:label></owl:Class>
    <owl:Class rdf:about="fortune/SubAnnualFortune"><rdfs:subClassOf rdf:resource="fortune/FortuneDomain"/><rdfs:label xml:lang="zh">流月流日流时</rdfs:label></owl:Class>
    <owl:Class rdf:about="fortune/SpecialFortunePattern"><rdfs:subClassOf rdf:resource="fortune/FortuneDomain"/><rdfs:label xml:lang="zh">特殊岁运格局</rdfs:label></owl:Class>
    <owl:Class rdf:about="fortune/YunHuaQi"><rdfs:subClassOf rdf:resource="fortune/FortuneDomain"/><rdfs:label xml:lang="zh">运化气（化气十段锦）</rdfs:label></owl:Class>
    <owl:Class rdf:about="fortune/ResponsePeriod"><rdfs:subClassOf rdf:resource="fortune/FortuneDomain"/><rdfs:label xml:lang="zh">应期</rdfs:label></owl:Class>
    <owl:Class rdf:about="fortune/LifeStageLimit"><rdfs:subClassOf rdf:resource="fortune/FortuneDomain"/><rdfs:label xml:lang="zh">运限法</rdfs:label></owl:Class>
    <owl:Class rdf:about="fortune/FortuneSynthesis"><rdfs:subClassOf rdf:resource="fortune/FortuneDomain"/><rdfs:label xml:lang="zh">岁运综合辩证</rdfs:label></owl:Class>
    <owl:Class rdf:about="chart/FourPillars"><rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="fortune/hasFortuneSynthesis"/><owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality><owl:onClass rdf:resource="fortune/FortuneSynthesis"/></owl:Restriction></rdfs:subClassOf></owl:Class>

</rdf:RDF>
