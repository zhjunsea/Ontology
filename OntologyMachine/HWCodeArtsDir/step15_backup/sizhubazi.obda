[PrefixDeclaration]
:        http://example.org/sizhubazi/
core:    http://example.org/sizhubazi/core/
calendar: http://example.org/sizhubazi/calendar/
deity:   http://example.org/sizhubazi/deity/
tengod:  http://example.org/sizhubazi/tengod/
reading: http://example.org/sizhubazi/reading/
rules:   http://example.org/sizhubazi/rules/
rdf:     http://www.w3.org/1999/02/22-rdf-syntax-ns#
rdfs:    http://www.w3.org/2000/01/rdf-schema#
owl:     http://www.w3.org/2002/07/owl#
xsd:     http://www.w3.org/2001/XMLSchema#

[MappingDeclaration] @collection [[

mappingId    ganzhi_stem
target       core:{name} a core:HeavenlyStem ;
                 rdfs:label "{label}"@zh ;
                 core:stemName "{stem_name}"^^xsd:string ;
                 core:stemYinYang "{stem_yinyang}"^^xsd:string ;
                 core:hasYinYang core:{yinyang} ;
                 core:hasFivePhase core:{five_phase} .
source       SELECT name,
                 COALESCE(stem_name, '') AS stem_name,
                 COALESCE(stem_yinyang, '') AS stem_yinyang,
                 COALESCE(yinyang, '') AS yinyang,
                 COALESCE(five_phase, '') AS five_phase,
                 COALESCE(label, '') AS label
             FROM ganzhi_stem
             WHERE name IS NOT NULL
               AND yinyang IS NOT NULL AND yinyang <> ''
               AND five_phase IS NOT NULL AND five_phase <> ''

mappingId    ganzhi_branch
target       core:{name} a core:EarthlyBranch ;
                 rdfs:label "{label}"@zh ;
                 core:branchName "{branch_name}"^^xsd:string ;
                 core:branchAnimal "{branch_animal}"^^xsd:string ;
                 core:branchOrder "{branch_order}"^^xsd:integer ;
                 core:hasFivePhase core:{five_phase} .
source       SELECT name,
                 COALESCE(branch_name, '') AS branch_name,
                 COALESCE(branch_animal, '') AS branch_animal,
                 COALESCE(branch_order, 0) AS branch_order,
                 COALESCE(five_phase, '') AS five_phase,
                 COALESCE(label, '') AS label
             FROM ganzhi_branch
             WHERE name IS NOT NULL
               AND five_phase IS NOT NULL AND five_phase <> ''

mappingId    sexagenary_cycle
target       core:{name} a core:SexagenaryCycle ;
                 rdfs:label "{ganzhi}"@zh ;
                 core:hasStem core:{stem_local} ;
                 core:hasBranch core:{branch_local} ;
                 core:hasNaYin core:{nayin_local} .
source       SELECT name,
                 COALESCE(ganzhi, '') AS ganzhi,
                 COALESCE(stem_local, '') AS stem_local,
                 COALESCE(branch_local, '') AS branch_local,
                 COALESCE(nayin_local, '') AS nayin_local
             FROM sexagenary_cycle
             WHERE name IS NOT NULL
               AND stem_local IS NOT NULL AND stem_local <> ''
               AND branch_local IS NOT NULL AND branch_local <> ''
               AND nayin_local IS NOT NULL AND nayin_local <> ''

mappingId    nayin
target       core:{name} a core:NaYin ;
                 rdfs:label "{label}"@zh ;
                 core:naYinName "{nayin_name}"^^xsd:string ;
                 core:naYinNature "{nayin_nature}"^^xsd:string ;
                 core:hasFivePhase core:{five_phase} .
source       SELECT name,
                 COALESCE(nayin_name, '') AS nayin_name,
                 COALESCE(nayin_nature, '') AS nayin_nature,
                 COALESCE(five_phase, '') AS five_phase,
                 COALESCE(label, '') AS label
             FROM nayin
             WHERE name IS NOT NULL
               AND five_phase IS NOT NULL AND five_phase <> ''

mappingId    hidden_stem
target       core:{name} a core:HiddenStem ;
                 rdfs:label "{label}"@zh ;
                 core:hiddenStemRole "{role}"^^xsd:string .
source       SELECT name,
                 COALESCE(role, '') AS role,
                 COALESCE(label, '') AS label
             FROM hidden_stem
             WHERE name IS NOT NULL

mappingId    hidden_stem_of_branch
target       core:{branch_local} core:hasHiddenStem core:{name} .
source       SELECT branch_local,
                 name
             FROM hidden_stem
             WHERE name IS NOT NULL
               AND branch_local IS NOT NULL AND branch_local <> ''

mappingId    solar_term
target       calendar:{name} a calendar:SolarTerm ;
                 rdfs:label "{label}"@zh ;
                 calendar:solarTermName "{solar_term_name}"^^xsd:string .
source       SELECT name,
                 COALESCE(solar_term_name, '') AS solar_term_name,
                 COALESCE(label, '') AS label
             FROM solar_term
             WHERE name IS NOT NULL

mappingId    month_order
target       calendar:{name} a calendar:MonthOrder ;
                 rdfs:label "{label}"@zh ;
                 calendar:monthOrderName "{month_order_name}"^^xsd:string .
source       SELECT name,
                 COALESCE(month_order_name, '') AS month_order_name,
                 COALESCE(label, '') AS label
             FROM month_order
             WHERE name IS NOT NULL

mappingId    case_record
target       reading:CaseRecord_{case_id} a reading:CaseRecord ;
                 reading:caseBirthData "{birth_data}"^^xsd:string ;
                 reading:caseResult "{reading_text}"^^xsd:string .
source       SELECT case_id,
                 COALESCE(birth_data, '') AS birth_data,
                 COALESCE(reading, '') AS reading_text
             FROM case_record
             WHERE case_id IS NOT NULL

mappingId    alert_flag
target       rules:AlertRecord_{flag_id} a rules:AlertFlag ;
                 rules:alertType "{alert_type}"^^xsd:string ;
                 rules:alertTriggered "{alert_triggered}"^^xsd:boolean .
source       SELECT flag_id,
                 COALESCE(alert_type, '') AS alert_type,
                 COALESCE(alert_triggered, 0) AS alert_triggered
             FROM alert_flag
             WHERE flag_id IS NOT NULL

]]
