    <owl:Ontology rdf:about="http://example.org/sizhubazi/core">
        <rdfs:label xml:lang="zh">四柱命理本体 TBox 子本体 · core（干支基础：阴阳 / 五行 / 天干 / 地支 / 六十甲子 / 纳音 / 藏干 / 长生）</rdfs:label>
        <rdfs:comment xml:lang="zh">第 10 步产出：TBox 按业务域拆分。命名空间 http://example.org/sizhubazi/core 不变；由 sizhubazi-tbox.owl 聚合入口统一 imports；依赖方向单向无环。</rdfs:comment>
    </owl:Ontology>

    <!-- ============================================================ -->
    <!-- 对象属性 core（干支基础域） -->
    <!-- ============================================================ -->
    <owl:ObjectProperty rdf:about="core/hasYinYang"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/><owl:inverseOf rdf:resource="core/isYinYangOf"/><rdfs:domain rdf:resource="core/GanzhiEntity"/><rdfs:range rdf:resource="core/YinYang"/><rdfs:label xml:lang="zh">有阴阳</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="core/isYinYangOf"><owl:inverseOf rdf:resource="core/hasYinYang"/><rdfs:domain rdf:resource="core/YinYang"/><rdfs:range rdf:resource="core/GanzhiEntity"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="core/hasFivePhase"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/><owl:inverseOf rdf:resource="core/isFivePhaseOf"/><rdfs:domain rdf:resource="core/GanzhiEntity"/><rdfs:range rdf:resource="core/FivePhase"/><rdfs:label xml:lang="zh">有五行</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="core/isFivePhaseOf"><owl:inverseOf rdf:resource="core/hasFivePhase"/><rdfs:domain rdf:resource="core/FivePhase"/><rdfs:range rdf:resource="core/GanzhiEntity"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="core/generates"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/><owl:inverseOf rdf:resource="core/generatedBy"/><rdfs:domain rdf:resource="core/FivePhase"/><rdfs:range rdf:resource="core/FivePhase"/><rdfs:label xml:lang="zh">生</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="core/generatedBy"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/><owl:inverseOf rdf:resource="core/generates"/><rdfs:domain rdf:resource="core/FivePhase"/><rdfs:range rdf:resource="core/FivePhase"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="core/overcomes"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/><owl:inverseOf rdf:resource="core/overcomeBy"/><rdfs:domain rdf:resource="core/FivePhase"/><rdfs:range rdf:resource="core/FivePhase"/><rdfs:label xml:lang="zh">克</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="core/overcomeBy"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/><owl:inverseOf rdf:resource="core/overcomes"/><rdfs:domain rdf:resource="core/FivePhase"/><rdfs:range rdf:resource="core/FivePhase"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="core/hasStem"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/><owl:inverseOf rdf:resource="core/isStemOf"/><rdfs:domain rdf:resource="core/SexagenaryCycle"/><rdfs:range rdf:resource="core/HeavenlyStem"/><rdfs:label xml:lang="zh">有天干</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="core/isStemOf"><owl:inverseOf rdf:resource="core/hasStem"/><rdfs:domain rdf:resource="core/HeavenlyStem"/><rdfs:range rdf:resource="core/SexagenaryCycle"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="core/hasBranch"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/><owl:inverseOf rdf:resource="core/isBranchOf"/><rdfs:domain rdf:resource="core/SexagenaryCycle"/><rdfs:range rdf:resource="core/EarthlyBranch"/><rdfs:label xml:lang="zh">有地支</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="core/isBranchOf"><owl:inverseOf rdf:resource="core/hasBranch"/><rdfs:domain rdf:resource="core/EarthlyBranch"/><rdfs:range rdf:resource="core/SexagenaryCycle"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="core/hasNaYin"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/><owl:inverseOf rdf:resource="core/isNaYinOf"/><rdfs:domain rdf:resource="core/SexagenaryCycle"/><rdfs:range rdf:resource="core/NaYin"/><rdfs:label xml:lang="zh">有纳音</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="core/isNaYinOf"><owl:inverseOf rdf:resource="core/hasNaYin"/><rdfs:domain rdf:resource="core/NaYin"/><rdfs:range rdf:resource="core/SexagenaryCycle"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="core/hasHiddenStem"><owl:inverseOf rdf:resource="core/isHiddenStemOf"/><rdfs:domain rdf:resource="core/EarthlyBranch"/><rdfs:range rdf:resource="core/HiddenStem"/><rdfs:label xml:lang="zh">有藏干</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="core/isHiddenStemOf"><owl:inverseOf rdf:resource="core/hasHiddenStem"/><rdfs:domain rdf:resource="core/HiddenStem"/><rdfs:range rdf:resource="core/EarthlyBranch"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="core/hasLifeStage"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/><owl:inverseOf rdf:resource="core/isLifeStageOf"/><rdfs:domain rdf:resource="core/HeavenlyStem"/><rdfs:range rdf:resource="core/LifeStage"/><rdfs:label xml:lang="zh">有长生十二宫</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="core/isLifeStageOf"><owl:inverseOf rdf:resource="core/hasLifeStage"/><rdfs:domain rdf:resource="core/LifeStage"/><rdfs:range rdf:resource="core/HeavenlyStem"/></owl:ObjectProperty>
