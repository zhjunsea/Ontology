    <owl:DatatypeProperty rdf:about="core/naYinName"><rdfs:domain rdf:resource="core/NaYin"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">纳音名</rdfs:label></owl:DatatypeProperty>
