    <owl:Ontology rdf:about="all">
        <rdfs:label xml:lang="zh">四柱命理本体（单文件：TBox + 典型 ABox）</rdfs:label>
        <rdfs:comment xml:lang="zh">第 6 步产出：单文件本体，含 TBox（12 子本体）与典型 ABox；第 9/10 步再拆分为 sizhubazi-tbox.owl / 子本体 / sizhubazi-abox.owl。依据《SiZhuBaZi应用-本体核心设计》（v1 定稿）。推理器 Openllet；查表型数据经 Ontop OBDA 访问 MySQL。</rdfs:comment>
    </owl:Ontology>

    <!-- ============================================================ -->
    <!-- 对象属性 core（干支基础域） -->
    <!-- ============================================================ -->
    <owl:ObjectProperty rdf:about="core/hasYinYang"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/><owl:inverseOf rdf:resource="core/isYinYangOf"/><rdfs:domain rdf:resource="core/GanzhiEntity"/><rdfs:range rdf:resource="core/YinYang"/><rdfs:label xml:lang="zh">有阴阳</rdfs:label></owl:ObjectProperty>
