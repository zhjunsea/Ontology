    <!-- 辅助数据属性：岁干阴阳（供 R5/R6 起运顺逆；§5 R5/R6 所引谓词） -->
    <owl:DatatypeProperty rdf:about="chart/yearStemYinYang"><rdfs:domain rdf:resource="chart/FourPillars"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">年干阴阳（阳/阴）</rdfs:label></owl:DatatypeProperty>

    <!-- ============================================================ -->
    <!-- SWRL 规则（§5）· 已序列化 R1/R5/R6/R19/R21/R22（良构、谓词均在 §2/§3 定义） -->
    <!-- 其余规则依《本体核心设计》§5 标注「由程序实现 / 查表 / 待考」，不在 SWRL 中序列化，留痕如下： -->
    <!--   R2/R3  五行生克传递闭包  → 由 core:generates/overcomes 的 owl:TransitiveProperty 承载（不写空头规则） -->
    <!--   R4     柱→干支赋值        → 由程序/OBDA 提供配对（内置表） -->
    <!--   R7     十神判定          → 由程序实现（10×10 查表，避免百条冗余） -->
    <!--   R8     官杀混杂          → 由程序编排（含否定/比较，非 SWRL 合适场景） -->
    <!--   R9/R12 旺衰/层次综合      → 由程序计算（多因子权重，客户裁定 ⑰ 不设数值权重） -->
    <!--   R10/R11 格局成败/用神主取 → 分类与多法冲突编排由程序；主取落 hasYongShen，余挂 SchoolVariant -->
    <!--   R13/R14 空亡/神煞起例     → 查表型，由程序/OBDA（MySQL） -->
    <!--   R15    合冲刑穿成立        → 由程序判定（含进交退伏等条件） -->
    <!--   R16/R17/R18 岁运/运化气/运限 → 细化【待考】，由程序 -->
    <!--   R20    寿元关            → 综合判据由程序编排 -->
    <!--   R23    合婚互补正理        → 由程序（《神峰通考》正理；节点 M1） -->
    <!--   R24    出处绑定          → 由程序在生成期绑定（非推理） -->
    <!-- ============================================================ -->

    <rdf:Description rdf:about="rules/r1_s"><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/></rdf:Description>
    <rdf:Description rdf:about="rules/r1_p"><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/></rdf:Description>
    <rdf:Description rdf:about="rules/r5_f"><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/></rdf:Description>
    <rdf:Description rdf:about="rules/r5_i"><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/></rdf:Description>
    <rdf:Description rdf:about="rules/r5_gf"><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/></rdf:Description>
    <rdf:Description rdf:about="rules/r6_f"><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/></rdf:Description>
    <rdf:Description rdf:about="rules/r6_i"><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/></rdf:Description>
    <rdf:Description rdf:about="rules/r6_gf"><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/></rdf:Description>
    <rdf:Description rdf:about="rules/r19_f"><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/></rdf:Description>
    <rdf:Description rdf:about="rules/r21_f"><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/></rdf:Description>
    <rdf:Description rdf:about="rules/r21_d"><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/></rdf:Description>
    <rdf:Description rdf:about="rules/r22_f"><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/></rdf:Description>
    <rdf:Description rdf:about="rules/r22_a"><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/></rdf:Description>

    <!-- R1 干支→五行传导：HeavenlyStem(?s) ∧ stemFivePhase(?s,?p) → hasFivePhase(?s,?p)（三命通会卷一·论五行生成） -->
    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/><swrl:classPredicate rdf:resource="core/HeavenlyStem"/><swrl:argument1 rdf:resource="rules/r1_s"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="core/stemFivePhase"/><swrl:argument1 rdf:resource="rules/r1_s"/><swrl:argument2 rdf:resource="rules/r1_p"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></swrl:body>
        <swrl:head><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="core/hasFivePhase"/><swrl:argument1 rdf:resource="rules/r1_s"/><swrl:argument2 rdf:resource="rules/r1_p"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></swrl:head>
    </rdf:Description>
    <!-- R5 起运顺逆（阳男顺行）（渊海子平卷之一·论起大运法） -->
    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/><swrl:classPredicate rdf:resource="chart/FourPillars"/><swrl:argument1 rdf:resource="rules/r5_f"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="chart/hasBirthInput"/><swrl:argument1 rdf:resource="rules/r5_f"/><swrl:argument2 rdf:resource="rules/r5_i"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/><swrl:propertyPredicate rdf:resource="chart/gender"/><swrl:argument1 rdf:resource="rules/r5_i"/><swrl:argument2>男</swrl:argument2></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/><swrl:propertyPredicate rdf:resource="chart/yearStemYinYang"/><swrl:argument1 rdf:resource="rules/r5_f"/><swrl:argument2>阳</swrl:argument2></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="chart/hasGreatFortune"/><swrl:argument1 rdf:resource="rules/r5_f"/><swrl:argument2 rdf:resource="rules/r5_gf"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></swrl:body>
        <swrl:head><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/><swrl:propertyPredicate rdf:resource="chart/direction"/><swrl:argument1 rdf:resource="rules/r5_gf"/><swrl:argument2>顺</swrl:argument2></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></swrl:head>
    </rdf:Description>
    <!-- R6 起运顺逆（阴男逆行）（渊海子平卷之一·论起大运法） -->
    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/><swrl:classPredicate rdf:resource="chart/FourPillars"/><swrl:argument1 rdf:resource="rules/r6_f"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="chart/hasBirthInput"/><swrl:argument1 rdf:resource="rules/r6_f"/><swrl:argument2 rdf:resource="rules/r6_i"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/><swrl:propertyPredicate rdf:resource="chart/gender"/><swrl:argument1 rdf:resource="rules/r6_i"/><swrl:argument2>男</swrl:argument2></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/><swrl:propertyPredicate rdf:resource="chart/yearStemYinYang"/><swrl:argument1 rdf:resource="rules/r6_f"/><swrl:argument2>阴</swrl:argument2></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="chart/hasGreatFortune"/><swrl:argument1 rdf:resource="rules/r6_f"/><swrl:argument2 rdf:resource="rules/r6_gf"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></swrl:body>
        <swrl:head><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/><swrl:propertyPredicate rdf:resource="chart/direction"/><swrl:argument1 rdf:resource="rules/r6_gf"/><swrl:argument2>逆</swrl:argument2></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></swrl:head>
    </rdf:Description>
    <!-- R19 告警·大凶：格局破 ∧ 无用神 → hasAlertFlag(大凶)（顶层设计 I·46；客户裁定 ㉒；综合判据由程序编排） -->
    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/><swrl:classPredicate rdf:resource="chart/FourPillars"/><swrl:argument1 rdf:resource="rules/r19_f"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/><swrl:propertyPredicate rdf:resource="pattern/isBroken"/><swrl:argument1 rdf:resource="rules/r19_f"/><swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrl:argument2></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/><swrl:propertyPredicate rdf:resource="yongshen/noYongShen"/><swrl:argument1 rdf:resource="rules/r19_f"/><swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrl:argument2></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></swrl:body>
        <swrl:head><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="rules/hasAlertFlag"/><swrl:argument1 rdf:resource="rules/r19_f"/><swrl:argument2 rdf:resource="rules/AlertDaXiong"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></swrl:head>
    </rdf:Description>
    <!-- R21 告警·重大疾病：有重疾 → hasAlertFlag(重大疾病)（三命通会卷九·论疾病先知五脏六腑所属干支；客户裁定 ㉒） -->
    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/><swrl:classPredicate rdf:resource="chart/FourPillars"/><swrl:argument1 rdf:resource="rules/r21_f"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="reading/hasDisease"/><swrl:argument1 rdf:resource="rules/r21_f"/><swrl:argument2 rdf:resource="rules/r21_d"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/><swrl:propertyPredicate rdf:resource="reading/diseaseSevere"/><swrl:argument1 rdf:resource="rules/r21_d"/><swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrl:argument2></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></rdf:rest></rdf:Description></swrl:body>
        <swrl:head><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="rules/hasAlertFlag"/><swrl:argument1 rdf:resource="rules/r21_f"/><swrl:argument2 rdf:resource="rules/AlertJiBing"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></swrl:head>
    </rdf:Description>
    <!-- R22 告警·命中即外发：hasAlertFlag(?a) → alertTriggered(?a,true)（流程节点 A；供 SwrlRuleTriggerListener 检测 → RabbitMQ） -->
    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/><swrl:classPredicate rdf:resource="chart/FourPillars"/><swrl:argument1 rdf:resource="rules/r22_f"/></rdf:Description></rdf:first><rdf:rest><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/><swrl:propertyPredicate rdf:resource="rules/hasAlertFlag"/><swrl:argument1 rdf:resource="rules/r22_f"/><swrl:argument2 rdf:resource="rules/r22_a"/></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></rdf:rest></rdf:Description></swrl:body>
        <swrl:head><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/><rdf:first><rdf:Description><rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/><swrl:propertyPredicate rdf:resource="rules/alertTriggered"/><swrl:argument1 rdf:resource="rules/r22_a"/><swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrl:argument2></rdf:Description></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></rdf:Description></swrl:head>
    </rdf:Description>

</rdf:RDF>
