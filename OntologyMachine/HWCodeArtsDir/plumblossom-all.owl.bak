    <owl:NamedIndividual rdf:about="yijing:LineDictum_Qian_1">
        <rdf:type rdf:resource="yijing:LineDictum"/>
        <rdfs:label xml:lang="zh">乾为天爻辞1</rdfs:label>
        <yijing:lineDictumText xml:lang="zh">初九：潜龙勿用。</yijing:lineDictumText>
        <yijing:lineDictumPosition rdf:datatype="xsd:integer">1</yijing:lineDictumPosition>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="yijing:LineDictum_Qian_2">
        <rdf:type rdf:resource="yijing:LineDictum"/>
        <rdfs:label xml:lang="zh">乾为天爻辞2</rdfs:label>
        <yijing:lineDictumText xml:lang="zh">九二：见龙在田，利见大人。</yijing:lineDictumText>
        <yijing:lineDictumPosition rdf:datatype="xsd:integer">2</yijing:lineDictumPosition>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="yijing:LineDictum_Qian_3">
        <rdf:type rdf:resource="yijing:LineDictum"/>
        <rdfs:label xml:lang="zh">乾为天爻辞3</rdfs:label>
        <yijing:lineDictumText xml:lang="zh">九三：君子终日乾乾，夕惕若厉，无咎。</yijing:lineDictumText>
        <yijing:lineDictumPosition rdf:datatype="xsd:integer">3</yijing:lineDictumPosition>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="yijing:LineDictum_Qian_4">
        <rdf:type rdf:resource="yijing:LineDictum"/>
        <rdfs:label xml:lang="zh">乾为天爻辞4</rdfs:label>
        <yijing:lineDictumText xml:lang="zh">九四：或跃在渊，无咎。</yijing:lineDictumText>
        <yijing:lineDictumPosition rdf:datatype="xsd:integer">4</yijing:lineDictumPosition>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="yijing:LineDictum_Qian_5">
        <rdf:type rdf:resource="yijing:LineDictum"/>
        <rdfs:label xml:lang="zh">乾为天爻辞5</rdfs:label>
        <yijing:lineDictumText xml:lang="zh">九五：飞龙在天，利见大人。</yijing:lineDictumText>
        <yijing:lineDictumPosition rdf:datatype="xsd:integer">5</yijing:lineDictumPosition>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="yijing:LineDictum_Qian_6">
        <rdf:type rdf:resource="yijing:LineDictum"/>
        <rdfs:label xml:lang="zh">乾为天爻辞6</rdfs:label>
        <yijing:lineDictumText xml:lang="zh">上九：亢龙有悔。</yijing:lineDictumText>
        <yijing:lineDictumPosition rdf:datatype="xsd:integer">6</yijing:lineDictumPosition>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="yijing:Dictum_Qian">
        <rdf:type rdf:resource="yijing:HexagramDictum"/>
        <rdfs:label xml:lang="zh">乾为天卦辞</rdfs:label>
        <yijing:hexagramDictumText xml:lang="zh">元亨利贞。</yijing:hexagramDictumText>
    </owl:NamedIndividual>

