<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns="http://example.org/plumblossom/all"
         xml:base="http://example.org/plumblossom/all"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:swrl="http://www.w3.org/2003/11/swrl#"
         xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
         xmlns:core="http://example.org/plumblossom/core/"
         xmlns:div="http://example.org/plumblossom/divination/"
         xmlns:yijing="http://example.org/plumblossom/yijing/"
         xmlns:rel="http://example.org/plumblossom/relations/"
         xmlns:sym="http://example.org/plumblossom/symbols/"
         xmlns:ome="http://example.org/plumblossom/omens/"
         xmlns:jud="http://example.org/plumblossom/judgement/"
         xmlns:cal="http://example.org/plumblossom/calendars/"
         xmlns:rules="http://example.org/plumblossom/rules#">

    <owl:Ontology rdf:about="http://example.org/plumblossom/all">
        <rdfs:label xml:lang="zh">梅花易数本体总入口（单文件：TBox + 典型 ABox）</rdfs:label>
        <rdfs:comment xml:lang="zh">第 6 步产出。依据《PlumBlossom应用-本体顶层设计》v3 与《PlumBlossom应用-本体核心设计》v3.1。命名空间：core/div/yijing/rel/sym/ome/jud/cal。TBox 全量，ABox 为代表性典型个体（六十四卦全名录、卦辞爻辞全集留待第 12 步扩全集）。</rdfs:comment>
    </owl:Ontology>

    <!-- ==================== 类层级 ==================== -->
    <owl:Class rdf:about="core:PlumBlossomEntity">
        <rdfs:label xml:lang="zh">本体事物根</rdfs:label>
        <rdfs:comment xml:lang="zh">梅花易数本体根类</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="div:DivinationInput">
        <rdfs:label xml:lang="zh">起卦域</rdfs:label>
        <rdfs:subClassOf rdf:resource="core:PlumBlossomEntity"/>
    </owl:Class>

    <owl:Class rdf:about="div:DivinationMethod">
        <rdfs:label xml:lang="zh">起卦法类别</rdfs:label>
        <rdfs:comment xml:lang="zh">共 17 子类（卷之一十六类 + 附录一撮金）</rdfs:comment>
        <rdfs:subClassOf rdf:resource="div:DivinationInput"/>
    </owl:Class>

    <owl:Class rdf:about="div:NumberBasedMethod">
        <rdfs:label xml:lang="zh">先天·以数起卦</rdfs:label>
        <rdfs:subClassOf rdf:resource="div:DivinationMethod"/>
    </owl:Class>

    <owl:Class rdf:about="div:ImageBasedMethod">
        <rdfs:label xml:lang="zh">后天·端法·以象起卦</rdfs:label>
        <rdfs:subClassOf rdf:resource="div:DivinationMethod"/>
    </owl:Class>

    <owl:Class rdf:about="div:YearMonthDayHourMethod">
        <rdfs:label xml:lang="zh">年月日时起例</rdfs:label>
        <rdfs:subClassOf rdf:resource="div:NumberBasedMethod"/>
    </owl:Class>

    <owl:Class rdf:about="div:ObjectCountMethod">
        <rdfs:label xml:lang="zh">物占数</rdfs:label>
        <rdfs:subClassOf rdf:resource="div:NumberBasedMethod"/>
    </owl:Class>

    <owl:Class rdf:about="div:SoundCountMethod">
        <rdfs:label xml:lang="zh">声音占</rdfs:label>
        <rdfs:subClassOf rdf:resource="div:NumberBasedMethod"/>
    </owl:Class>

    <owl:Class rdf:about="div:CharacterMethod">
        <rdfs:label xml:lang="zh">字占</rdfs:label>
        <rdfs:subClassOf rdf:resource="div:NumberBasedMethod"/>
    </owl:Class>

    <owl:Class rdf:about="div:ZhangChiMethod">
        <rdfs:label xml:lang="zh">丈尺占</rdfs:label>
        <rdfs:subClassOf rdf:resource="div:NumberBasedMethod"/>
    </owl:Class>

    <owl:Class rdf:about="div:ChiCunMethod">
        <rdfs:label xml:lang="zh">尺寸物占</rdfs:label>
        <rdfs:subClassOf rdf:resource="div:NumberBasedMethod"/>
    </owl:Class>

    <owl:Class rdf:about="div:YicuoJinMethod">
        <rdfs:label xml:lang="zh">一撮金法</rdfs:label>
        <rdfs:subClassOf rdf:resource="div:NumberBasedMethod"/>
    </owl:Class>

    <owl:Class rdf:about="div:PersonObserveMethod">
        <rdfs:label xml:lang="zh">为人占</rdfs:label>
        <rdfs:subClassOf rdf:resource="div:ImageBasedMethod"/>
    </owl:Class>

    <owl:Class rdf:about="div:SelfObserveMethod">
        <rdfs:label xml:lang="zh">自己占</rdfs:label>
        <rdfs:subClassOf rdf:resource="div:ImageBasedMethod"/>
    </owl:Class>

    <owl:Class rdf:about="div:MovingThingMethod">
        <rdfs:label xml:lang="zh">占动物</rdfs:label>
        <rdfs:subClassOf rdf:resource="div:ImageBasedMethod"/>
    </owl:Class>

    <owl:Class rdf:about="div:StillThingMethod">
        <rdfs:label xml:lang="zh">占静物</rdfs:label>
        <rdfs:subClassOf rdf:resource="div:ImageBasedMethod"/>
    </owl:Class>

    <owl:Class rdf:about="div:ThingHexagramMethod">
        <rdfs:label xml:lang="zh">物卦起例</rdfs:label>
        <rdfs:subClassOf rdf:resource="div:ImageBasedMethod"/>
    </owl:Class>

    <owl:Class rdf:about="div:WindMethod">
        <rdfs:label xml:lang="zh">风觉占</rdfs:label>
        <rdfs:subClassOf rdf:resource="div:ImageBasedMethod"/>
    </owl:Class>

    <owl:Class rdf:about="div:BirdMethod">
        <rdfs:label xml:lang="zh">鸟占</rdfs:label>
        <rdfs:subClassOf rdf:resource="div:ImageBasedMethod"/>
    </owl:Class>

    <owl:Class rdf:about="div:HeardSoundMethod">
        <rdfs:label xml:lang="zh">听声音占</rdfs:label>
        <rdfs:subClassOf rdf:resource="div:ImageBasedMethod"/>
    </owl:Class>

    <owl:Class rdf:about="div:ShapeMethod">
        <rdfs:label xml:lang="zh">形物占</rdfs:label>
        <rdfs:subClassOf rdf:resource="div:ImageBasedMethod"/>
    </owl:Class>

    <owl:Class rdf:about="div:ColorMethod">
        <rdfs:label xml:lang="zh">验色占</rdfs:label>
        <rdfs:subClassOf rdf:resource="div:ImageBasedMethod"/>
    </owl:Class>

    <owl:Class rdf:about="div:Precept">
        <rdfs:label xml:lang="zh">心法戒律·四不占</rdfs:label>
        <rdfs:comment xml:lang="zh">四不占戒律（卷之一·观梅占；附录·一撮金）</rdfs:comment>
        <rdfs:subClassOf rdf:resource="div:DivinationInput"/>
    </owl:Class>

    <owl:Class rdf:about="div:InputDatum">
        <rdfs:label xml:lang="zh">起卦输入数据</rdfs:label>
        <rdfs:subClassOf rdf:resource="div:DivinationInput"/>
    </owl:Class>

    <owl:Class rdf:about="div:DivinationSubject">
        <rdfs:label xml:lang="zh">占断事项域</rdfs:label>
        <rdfs:subClassOf rdf:resource="core:PlumBlossomEntity"/>
    </owl:Class>

    <owl:Class rdf:about="jud:SubjectCategory">
        <rdfs:label xml:lang="zh">事项类别</rdfs:label>
        <rdfs:comment xml:lang="zh">18 子类（卷之二十八章占例）</rdfs:comment>
        <rdfs:subClassOf rdf:resource="div:DivinationSubject"/>
    </owl:Class>

    <owl:Class rdf:about="core:HexagramDomain">
        <rdfs:label xml:lang="zh">卦象域</rdfs:label>
        <rdfs:subClassOf rdf:resource="core:PlumBlossomEntity"/>
    </owl:Class>

    <owl:Class rdf:about="core:Trigram">
        <rdfs:label xml:lang="zh">八卦</rdfs:label>
        <rdfs:subClassOf rdf:resource="core:HexagramDomain"/>
    </owl:Class>

    <owl:Class rdf:about="core:Direction">
        <rdfs:label xml:lang="zh">八方</rdfs:label>
        <rdfs:subClassOf rdf:resource="core:HexagramDomain"/>
    </owl:Class>

    <owl:Class rdf:about="core:Line">
        <rdfs:label xml:lang="zh">爻</rdfs:label>
        <rdfs:subClassOf rdf:resource="core:HexagramDomain"/>
    </owl:Class>

    <owl:Class rdf:about="core:YinLine">
        <rdfs:label xml:lang="zh">阴爻</rdfs:label>
        <rdfs:subClassOf rdf:resource="core:Line"/>
    </owl:Class>

    <owl:Class rdf:about="core:YangLine">
        <rdfs:label xml:lang="zh">阳爻</rdfs:label>
        <rdfs:subClassOf rdf:resource="core:Line"/>
    </owl:Class>

    <owl:Class rdf:about="core:MovingLine">
        <rdfs:label xml:lang="zh">动爻</rdfs:label>
        <rdfs:comment xml:lang="zh">一卦一爻动</rdfs:comment>
        <rdfs:subClassOf rdf:resource="core:Line"/>
    </owl:Class>

    <owl:Class rdf:about="core:Hexagram">
        <rdfs:label xml:lang="zh">重卦</rdfs:label>
        <rdfs:comment xml:lang="zh">由上下卦组成</rdfs:comment>
        <rdfs:subClassOf rdf:resource="core:HexagramDomain"/>
    </owl:Class>

    <owl:Class rdf:about="core:OriginalHexagram">
        <rdfs:label xml:lang="zh">本卦</rdfs:label>
        <rdfs:subClassOf rdf:resource="core:Hexagram"/>
    </owl:Class>

    <owl:Class rdf:about="core:MutualHexagram">
        <rdfs:label xml:lang="zh">互卦</rdfs:label>
        <rdfs:subClassOf rdf:resource="core:Hexagram"/>
    </owl:Class>

    <owl:Class rdf:about="core:ChangedHexagram">
        <rdfs:label xml:lang="zh">变卦</rdfs:label>
        <rdfs:subClassOf rdf:resource="core:Hexagram"/>
    </owl:Class>

    <owl:Class rdf:about="core:SixBitHexagram">
        <rdfs:label xml:lang="zh">六十四卦名录</rdfs:label>
        <rdfs:comment xml:lang="zh">术语型</rdfs:comment>
        <rdfs:subClassOf rdf:resource="core:Hexagram"/>
    </owl:Class>

    <owl:Class rdf:about="yijing:YijingDomain">
        <rdfs:label xml:lang="zh">周易经传域</rdfs:label>
        <rdfs:subClassOf rdf:resource="core:PlumBlossomEntity"/>
    </owl:Class>

    <owl:Class rdf:about="yijing:HexagramDictum">
        <rdfs:label xml:lang="zh">周易卦辞</rdfs:label>
        <rdfs:comment xml:lang="zh">六十四卦各一</rdfs:comment>
        <rdfs:subClassOf rdf:resource="yijing:YijingDomain"/>
    </owl:Class>

    <owl:Class rdf:about="yijing:LineDictum">
        <rdfs:label xml:lang="zh">周易爻辞</rdfs:label>
        <rdfs:comment xml:lang="zh">三百八十四爻各一</rdfs:comment>
        <rdfs:subClassOf rdf:resource="yijing:YijingDomain"/>
    </owl:Class>

    <owl:Class rdf:about="yijing:HexagramSequence">
        <rdfs:label xml:lang="zh">卦序</rdfs:label>
        <rdfs:comment xml:lang="zh">六十四卦次第 1~64</rdfs:comment>
        <rdfs:subClassOf rdf:resource="yijing:YijingDomain"/>
    </owl:Class>

    <owl:Class rdf:about="yijing:OppositeNature">
        <rdfs:label xml:lang="zh">诸卦反对性情</rdfs:label>
        <rdfs:comment xml:lang="zh">杂卦两两反对之卦义</rdfs:comment>
        <rdfs:subClassOf rdf:resource="yijing:YijingDomain"/>
    </owl:Class>

    <owl:Class rdf:about="rel:YiliDomain">
        <rdfs:label xml:lang="zh">易理域</rdfs:label>
        <rdfs:subClassOf rdf:resource="core:PlumBlossomEntity"/>
    </owl:Class>

    <owl:Class rdf:about="rel:FivePhase">
        <rdfs:label xml:lang="zh">五行</rdfs:label>
        <rdfs:subClassOf rdf:resource="rel:YiliDomain"/>
    </owl:Class>

    <owl:Class rdf:about="rel:ShengKeRelation">
        <rdfs:label xml:lang="zh">五行生克关系</rdfs:label>
        <rdfs:subClassOf rdf:resource="rel:YiliDomain"/>
    </owl:Class>

    <owl:Class rdf:about="rel:Sheng">
        <rdfs:label xml:lang="zh">生</rdfs:label>
        <rdfs:subClassOf rdf:resource="rel:ShengKeRelation"/>
    </owl:Class>

    <owl:Class rdf:about="rel:Ke">
        <rdfs:label xml:lang="zh">克</rdfs:label>
        <rdfs:subClassOf rdf:resource="rel:ShengKeRelation"/>
    </owl:Class>

    <owl:Class rdf:about="rel:BodyUseRelation">
        <rdfs:label xml:lang="zh">体用关系</rdfs:label>
        <rdfs:subClassOf rdf:resource="rel:YiliDomain"/>
    </owl:Class>

    <owl:Class rdf:about="rel:VitalityState">
        <rdfs:label xml:lang="zh">卦气旺衰</rdfs:label>
        <rdfs:subClassOf rdf:resource="rel:YiliDomain"/>
    </owl:Class>

    <owl:Class rdf:about="rel:TrigramNature">
        <rdfs:label xml:lang="zh">八卦性情</rdfs:label>
        <rdfs:subClassOf rdf:resource="rel:YiliDomain"/>
    </owl:Class>

    <owl:Class rdf:about="rel:TrigramOrder">
        <rdfs:label xml:lang="zh">八卦定阴阳次序</rdfs:label>
        <rdfs:subClassOf rdf:resource="rel:YiliDomain"/>
    </owl:Class>

    <owl:Class rdf:about="sym:ImageSymbol">
        <rdfs:label xml:lang="zh">万物类象</rdfs:label>
        <rdfs:subClassOf rdf:resource="rel:YiliDomain"/>
    </owl:Class>

    <owl:Class rdf:about="sym:SymbolDimension">
        <rdfs:label xml:lang="zh">类象维度</rdfs:label>
        <rdfs:comment xml:lang="zh">28 分栏维度</rdfs:comment>
        <rdfs:subClassOf rdf:resource="rel:YiliDomain"/>
    </owl:Class>

    <owl:Class rdf:about="sym:ModernEntity">
        <rdfs:label xml:lang="zh">现代事物（映射扩展层）</rdfs:label>
        <rdfs:comment xml:lang="zh">默认关闭</rdfs:comment>
        <rdfs:subClassOf rdf:resource="rel:YiliDomain"/>
    </owl:Class>

    <owl:Class rdf:about="ome:OmenDomain">
        <rdfs:label xml:lang="zh">外应域</rdfs:label>
        <rdfs:subClassOf rdf:resource="core:PlumBlossomEntity"/>
    </owl:Class>

    <owl:Class rdf:about="ome:ThreeEssentials">
        <rdfs:label xml:lang="zh">三要</rdfs:label>
        <rdfs:comment xml:lang="zh">耳/目/心</rdfs:comment>
        <rdfs:subClassOf rdf:resource="ome:OmenDomain"/>
    </owl:Class>

    <owl:Class rdf:about="ome:TenResponses">
        <rdfs:label xml:lang="zh">十应</rdfs:label>
        <rdfs:subClassOf rdf:resource="ome:OmenDomain"/>
    </owl:Class>

    <owl:Class rdf:about="cal:CalendarDomain">
        <rdfs:label xml:lang="zh">历法域</rdfs:label>
        <rdfs:subClassOf rdf:resource="core:PlumBlossomEntity"/>
    </owl:Class>

    <owl:Class rdf:about="cal:HeavenlyStem">
        <rdfs:label xml:lang="zh">十天干</rdfs:label>
        <rdfs:subClassOf rdf:resource="cal:CalendarDomain"/>
    </owl:Class>

    <owl:Class rdf:about="cal:EarthlyBranch">
        <rdfs:label xml:lang="zh">十二地支</rdfs:label>
        <rdfs:subClassOf rdf:resource="cal:CalendarDomain"/>
    </owl:Class>

    <owl:Class rdf:about="cal:SexagenaryCycle">
        <rdfs:label xml:lang="zh">六十甲子</rdfs:label>
        <rdfs:subClassOf rdf:resource="cal:CalendarDomain"/>
    </owl:Class>

    <owl:Class rdf:about="cal:NaYin">
        <rdfs:label xml:lang="zh">纳音</rdfs:label>
        <rdfs:subClassOf rdf:resource="cal:CalendarDomain"/>
    </owl:Class>

    <owl:Class rdf:about="cal:LifeStage">
        <rdfs:label xml:lang="zh">五行长生</rdfs:label>
        <rdfs:subClassOf rdf:resource="cal:CalendarDomain"/>
    </owl:Class>

    <owl:Class rdf:about="cal:CalendarDatum">
        <rdfs:label xml:lang="zh">历法数据</rdfs:label>
        <rdfs:subClassOf rdf:resource="cal:CalendarDomain"/>
    </owl:Class>

    <owl:Class rdf:about="jud:JudgementDomain">
        <rdfs:label xml:lang="zh">断验域</rdfs:label>
        <rdfs:subClassOf rdf:resource="core:PlumBlossomEntity"/>
    </owl:Class>

    <owl:Class rdf:about="jud:Auspiciousness">
        <rdfs:label xml:lang="zh">吉凶等级</rdfs:label>
        <rdfs:comment xml:lang="zh">大吉/吉/平/凶/大凶</rdfs:comment>
        <rdfs:subClassOf rdf:resource="jud:JudgementDomain"/>
    </owl:Class>

    <owl:Class rdf:about="jud:YicuoJinAdmonition">
        <rdfs:label xml:lang="zh">一撮金爻诀断辞</rdfs:label>
        <rdfs:comment xml:lang="zh">附录·一撮金</rdfs:comment>
        <rdfs:subClassOf rdf:resource="jud:JudgementDomain"/>
    </owl:Class>

    <owl:Class rdf:about="jud:YicuoJinGrade">
        <rdfs:label xml:lang="zh">一撮金吉凶六等</rdfs:label>
        <rdfs:comment xml:lang="zh">上上…下下</rdfs:comment>
        <rdfs:subClassOf rdf:resource="jud:JudgementDomain"/>
    </owl:Class>

    <owl:Class rdf:about="jud:ResponsePeriod">
        <rdfs:label xml:lang="zh">应期</rdfs:label>
        <rdfs:subClassOf rdf:resource="jud:JudgementDomain"/>
    </owl:Class>

    <owl:Class rdf:about="jud:SelfCultivationAdvice">
        <rdfs:label xml:lang="zh">修身建议</rdfs:label>
        <rdfs:subClassOf rdf:resource="jud:JudgementDomain"/>
    </owl:Class>

    <!-- ==================== 对象属性 ==================== -->
    <owl:ObjectProperty rdf:about="core:hasUpperTrigram">
        <rdfs:label xml:lang="zh">有上卦</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="core:Hexagram"/>
        <rdfs:range rdf:resource="core:Trigram"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="core:isUpperTrigramOf">
        <rdfs:domain rdf:resource="core:Trigram"/>
        <rdfs:range rdf:resource="core:Hexagram"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="core:hasLowerTrigram">
        <rdfs:label xml:lang="zh">有下卦</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="core:Hexagram"/>
        <rdfs:range rdf:resource="core:Trigram"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="core:isLowerTrigramOf">
        <rdfs:domain rdf:resource="core:Trigram"/>
        <rdfs:range rdf:resource="core:Hexagram"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="core:hasLine">
        <rdfs:label xml:lang="zh">有爻</rdfs:label>
        <rdfs:domain rdf:resource="core:Hexagram"/>
        <rdfs:range rdf:resource="core:Line"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="core:isLineOf">
        <rdfs:domain rdf:resource="core:Line"/>
        <rdfs:range rdf:resource="core:Hexagram"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="core:hasMovingLine">
        <rdfs:label xml:lang="zh">有动爻</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="core:Hexagram"/>
        <rdfs:range rdf:resource="core:MovingLine"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="core:isMovingLineOf">
        <rdfs:domain rdf:resource="core:MovingLine"/>
        <rdfs:range rdf:resource="core:Hexagram"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="core:mutualOf">
        <rdfs:label xml:lang="zh">为…之互卦</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="core:MutualHexagram"/>
        <rdfs:range rdf:resource="core:OriginalHexagram"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="core:hasMutualHexagram">
        <rdfs:domain rdf:resource="core:OriginalHexagram"/>
        <rdfs:range rdf:resource="core:MutualHexagram"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="core:changedFrom">
        <rdfs:label xml:lang="zh">由…变来</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="core:ChangedHexagram"/>
        <rdfs:range rdf:resource="core:OriginalHexagram"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="core:hasChangedHexagram">
        <rdfs:domain rdf:resource="core:OriginalHexagram"/>
        <rdfs:range rdf:resource="core:ChangedHexagram"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="core:hasDirection">
        <rdfs:label xml:lang="zh">有方位</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="core:Trigram"/>
        <rdfs:range rdf:resource="core:Direction"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="core:isDirectionOf">
        <rdfs:domain rdf:resource="core:Direction"/>
        <rdfs:range rdf:resource="core:Trigram"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="core:hasTrigramNature">
        <rdfs:label xml:lang="zh">有性情</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="core:Trigram"/>
        <rdfs:range rdf:resource="rel:TrigramNature"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="core:isTrigramNatureOf">
        <rdfs:domain rdf:resource="rel:TrigramNature"/>
        <rdfs:range rdf:resource="core:Trigram"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="core:hasTrigramOrder">
        <rdfs:label xml:lang="zh">有阴阳次序</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="core:Trigram"/>
        <rdfs:range rdf:resource="rel:TrigramOrder"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="core:isTrigramOrderOf">
        <rdfs:domain rdf:resource="rel:TrigramOrder"/>
        <rdfs:range rdf:resource="core:Trigram"/>
    </owl:ObjectProperty>

