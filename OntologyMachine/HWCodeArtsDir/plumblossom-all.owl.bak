    <owl:NamedIndividual rdf:about="yijing:LineDictum_Kun_1">
        <rdf:type rdf:resource="yijing:LineDictum"/>
        <rdfs:label xml:lang="zh">坤为地爻辞1</rdfs:label>
        <yijing:lineDictumText xml:lang="zh">初六：履霜，坚冰至。</yijing:lineDictumText>
        <yijing:lineDictumPosition rdf:datatype="xsd:integer">1</yijing:lineDictumPosition>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="yijing:LineDictum_Kun_2">
        <rdf:type rdf:resource="yijing:LineDictum"/>
        <rdfs:label xml:lang="zh">坤为地爻辞2</rdfs:label>
        <yijing:lineDictumText xml:lang="zh">六二：直方大，不习无不利。</yijing:lineDictumText>
        <yijing:lineDictumPosition rdf:datatype="xsd:integer">2</yijing:lineDictumPosition>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="yijing:LineDictum_Kun_3">
        <rdf:type rdf:resource="yijing:LineDictum"/>
        <rdfs:label xml:lang="zh">坤为地爻辞3</rdfs:label>
        <yijing:lineDictumText xml:lang="zh">六三：含章可贞。或从王事，无成有终。</yijing:lineDictumText>
        <yijing:lineDictumPosition rdf:datatype="xsd:integer">3</yijing:lineDictumPosition>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="yijing:LineDictum_Kun_4">
        <rdf:type rdf:resource="yijing:LineDictum"/>
        <rdfs:label xml:lang="zh">坤为地爻辞4</rdfs:label>
        <yijing:lineDictumText xml:lang="zh">六四：括囊，无咎无誉。</yijing:lineDictumText>
        <yijing:lineDictumPosition rdf:datatype="xsd:integer">4</yijing:lineDictumPosition>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="yijing:LineDictum_Kun_5">
        <rdf:type rdf:resource="yijing:LineDictum"/>
        <rdfs:label xml:lang="zh">坤为地爻辞5</rdfs:label>
        <yijing:lineDictumText xml:lang="zh">六五：黄裳元吉。</yijing:lineDictumText>
        <yijing:lineDictumPosition rdf:datatype="xsd:integer">5</yijing:lineDictumPosition>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="yijing:LineDictum_Kun_6">
        <rdf:type rdf:resource="yijing:LineDictum"/>
        <rdfs:label xml:lang="zh">坤为地爻辞6</rdfs:label>
        <yijing:lineDictumText xml:lang="zh">上六：龙战于野，其血玄黄。</yijing:lineDictumText>
        <yijing:lineDictumPosition rdf:datatype="xsd:integer">6</yijing:lineDictumPosition>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="yijing:Dictum_Kun">
        <rdf:type rdf:resource="yijing:HexagramDictum"/>
        <rdfs:label xml:lang="zh">坤为地卦辞</rdfs:label>
        <yijing:hexagramDictumText xml:lang="zh">元亨，利牝马之贞。君子有攸往，先迷后得主利。西南得朋，东北丧朋。安贞吉。</yijing:hexagramDictumText>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="core:KunHexagram">
        <rdf:type rdf:resource="core:SixBitHexagram"/>
        <rdfs:label xml:lang="zh">坤为地</rdfs:label>
        <rdfs:comment xml:lang="zh">六十四卦名录（代表性）</rdfs:comment>
        <core:hexagramName xml:lang="zh">坤为地</core:hexagramName>
        <core:hasUpperTrigram rdf:resource="core:KunTrigram"/>
        <core:hasLowerTrigram rdf:resource="core:KunTrigram"/>
        <yijing:hasHexagramDictum rdf:resource="yijing:Dictum_Kun"/>
        <core:hasLine rdf:resource="core:KunLine1"/>
        <yijing:hasLineDictum rdf:resource="yijing:LineDictum_Kun_1"/>
        <core:hasLine rdf:resource="core:KunLine2"/>
        <yijing:hasLineDictum rdf:resource="yijing:LineDictum_Kun_2"/>
        <core:hasLine rdf:resource="core:KunLine3"/>
        <yijing:hasLineDictum rdf:resource="yijing:LineDictum_Kun_3"/>
        <core:hasLine rdf:resource="core:KunLine4"/>
        <yijing:hasLineDictum rdf:resource="yijing:LineDictum_Kun_4"/>
        <core:hasLine rdf:resource="core:KunLine5"/>
        <yijing:hasLineDictum rdf:resource="yijing:LineDictum_Kun_5"/>
        <core:hasLine rdf:resource="core:KunLine6"/>
        <yijing:hasLineDictum rdf:resource="yijing:LineDictum_Kun_6"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="yijing:Opposite_QianKun">
        <rdf:type rdf:resource="yijing:OppositeNature"/>
        <rdfs:label xml:lang="zh">乾刚坤柔</rdfs:label>
        <yijing:oppositeNatureText xml:lang="zh">乾刚坤柔</yijing:oppositeNatureText>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="core:QianHexagram">
        <yijing:oppositeOf rdf:resource="core:KunHexagram"/>
        <yijing:oppositeNatureText xml:lang="zh">乾刚坤柔</yijing:oppositeNatureText>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="core:KunHexagram">
        <yijing:oppositeOf rdf:resource="core:QianHexagram"/>
        <yijing:oppositeNatureText xml:lang="zh">乾刚坤柔</yijing:oppositeNatureText>
    </owl:NamedIndividual>

