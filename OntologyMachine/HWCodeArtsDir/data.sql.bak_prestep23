-- 9h. 断语条文库·滴天髓通神论/六亲论诸篇（26；第 17 步 I3）
--   经 OBDA 暴露为 pattern:ImagePattern/DirectionPattern/ZhenDuiPattern/KanLiPattern/AssimilationPattern/
--     SequencePattern/SovereignPattern、yongshen:IdleGod、reading:IlluminatingChapter、fortune:ZhenYuan。
--   出处：滴天髓·通神论/六亲论（形象/方局/震兑/坎离/何知章/闲神/从象化象/顺反战合/君臣母子/贞元）。★8/9/10。
-- ============================================================================
INSERT INTO `dts_clause` (clause_id, clause_group, subject, clause_text, source_note) VALUES
('DC_ImagePattern', '形象', '形象', '两气合而成象，象不可破也；五气聚而成形，形不可害也。独象喜行化地，而化神要昌；全象喜行财地，而财神要旺。形全者宜损其有余，形缺者宜补其不足。', '滴天髓·通神论·十、形象'),
('DC_DirectionPattern', '方局', '方局', '方是方兮局是局，要得方，莫混局；局混方兮有纯疵，行运喜南或喜北。若然方局一齐来，须是干头无反复。成方干透一元神，生地库地皆非福；成局干透一官星，左边右边空碌碌。', '滴天髓·通神论·十一、方局'),
('DC_ZhenDuiPattern', '震兑', '震兑', '震兑主仁义之真机，势不两立，而有相成者存。震在内、兑在外，或兑在内、震在外，以水为客相间。若木忌金而金强者不可战，惟囚金而木茂，木终不能为金之害，反以成金之义；春木而金盛，金实足以制木之性，反以全木之仁。', '滴天髓·通神论·三十三、震兑'),
('DC_KanLiPattern', '坎离', '坎离', '坎离宰天地之中气，成不独成，而有相持者在。天干透壬癸、地支属离者乃为既济，要天气下降；天干透丙丁、地支属坎者乃为未济，要地气上升。天干皆水地支皆火为交媾（身强则富贵）；天干皆火地支皆水为交战（身弱岂能富贵）。水火相见于天干以火为主，坎离相见于地支喜坎而坎旺者昌。', '滴天髓·通神论·三十四、坎离'),
('DC_IlluminatingFu', '何知章', '何知章·富', '何知其人富？财气通门户。', '滴天髓·六亲论·五、何知章'),
('DC_IlluminatingGui', '何知章', '何知章·贵', '何知其人贵？官星有理会。', '滴天髓·六亲论·五、何知章'),
('DC_IlluminatingPin', '何知章', '何知章·贫', '何知其人贫？财神反不真。', '滴天髓·六亲论·五、何知章'),
('DC_IlluminatingJian', '何知章', '何知章·贱', '何知其人贱？官星还不见。', '滴天髓·六亲论·五、何知章'),
('DC_IlluminatingJi', '何知章', '何知章·吉', '何知其人吉？喜神为辅弼。', '滴天髓·六亲论·五、何知章'),
('DC_IlluminatingXiong', '何知章', '何知章·凶', '何知其人凶？忌神辗转攻。', '滴天髓·六亲论·五、何知章'),
('DC_IlluminatingShou', '何知章', '何知章·寿', '何知其人寿？性定元神厚。', '滴天髓·六亲论·五、何知章'),
('DC_IlluminatingYao', '何知章', '何知章·夭', '何知其人夭？气浊神枯了。', '滴天髓·六亲论·五、何知章'),
('DC_IdleGod', '闲神', '闲神', '一二闲神用去么，不用何妨莫动它；半局闲神任闲著，要紧之场作自豪。自喜忌之外，不足以为喜、不足以为忌，皆闲神也。虽有闲神，只不去动他，但要紧之地，自结营寨。', '滴天髓·六亲论·十一、闲神'),
('DC_Assimilation_Cong', '从象化象假从假化', '从象', '日主孤立无气，无地人元，绝无一毫生扶之意，财官强甚，乃为真从也。既从矣，当论所从之神。如从财，只以财为主。', '滴天髓·六亲论·十二、从象'),
('DC_Assimilation_Hua', '从象化象假从假化', '化象', '化得真者只论化，化神还有几般话。如甲日主生于四季，单遇一位己土，在月时上合遇壬癸甲乙戊而有一辰字，乃为化得真。既化矣，又论化神。', '滴天髓·六亲论·十三、化象'),
('DC_Assimilation_JiaCong', '从象化象假从假化', '假从', '真从之象有几人，假从亦可发其身。日主弱矣，财官强矣，不能不从；中有比劫暗生，从之不真。至于岁运财官得地，虽是假从，亦可取富贵，但其人不能免祸。', '滴天髓·六亲论·十四、假从'),
('DC_Assimilation_JiaHua', '从象化象假从假化', '假化', '假化之人亦多贵，孤儿异姓能出类。日主孤弱而遇合神真，不能不化，但暗扶日主、合神又虚弱，则不真化；岁运扶起合神，虽为假化，亦可取富贵。', '滴天髓·六亲论·十五、假化'),
('DC_Sequence_Shun', '顺反战合局', '顺局', '一出门来只见儿，吾儿成气构门闾；从儿不管身强弱，只要吾儿又得儿。此与成象、从象、伤官不同，只取我生者为儿。', '滴天髓·六亲论·十六、顺局'),
('DC_Sequence_Fan', '顺反战合局', '反局', '君赖臣生理最微，儿能救母泄天机，母慈灭子关因异，夫健何为又怕妻。木君也、土臣也，水泛木浮，土止水则生木，皆君赖臣生也；木为母、火为子，木被金伤，火克金则生木，皆儿能生母之意。', '滴天髓·六亲论·十七、反局'),
('DC_Sequence_Zhan', '顺反战合局', '战局', '天战犹自可，地战急如火。干头遇庚乙辛谓之天战，而得地支顺者无害；地支寅申卯酉谓之地战，则天干不能为力，其势速凶。', '滴天髓·六亲论·十八、战局'),
('DC_Sequence_He', '顺反战合局', '合局', '合有宜不宜，合多不为奇。喜神有能合而助之者，凶神有能合而去之者，动局有能合而静者；大率多合则不流通、不奋发，虽有秀气亦不为奇矣。', '滴天髓·六亲论·十九、合局'),
('DC_Sovereign_Jun', '君象臣象母象子象', '君象', '君不可抗也，贵乎损上以益下。日主为君，防神为臣。如甲乙日主满局皆木、内有一二土气，是君盛臣，其势要多方以助臣。', '滴天髓·六亲论·二十、君象'),
('DC_Sovereign_Chen', '君象臣象母象子象', '臣象', '臣不可过也，贵乎损下而益上。日主为臣，官星为君。如甲乙日主满盘皆木、内有一二金气，是臣盛君衰，其势要多方以助金。', '滴天髓·六亲论·二十一、臣象'),
('DC_Sovereign_Mu', '君象臣象母象子象', '母象', '知慈母恤孤之道，始有瓜瓞无疆之庆。日主为母，日之所生者为子。如甲乙日主满柱皆木、中有一二火气，是母旺子孤，其势要多方以生子孙。', '滴天髓·六亲论·二十二、母象'),
('DC_Sovereign_Zi', '君象臣象母象子象', '子象', '知孝子奏亲之方，始克谐成大顺之风。日主为子，生日者为母。如甲乙满局皆木、中有一二水气，为子众母衰，其势要多方以安母，用金以生水、用土以生金，则成母子之情。', '滴天髓·六亲论·二十三、子象'),
('DC_ZhenYuan', '贞元', '贞元', '造化起于元，亦止于贞。再肇贞元之会，胚胎嗣续之机。以年为元、月为亨、日为利、时为贞；元亨运吉者前半世吉，利贞运吉者后半世吉，皆贞元之道。', '滴天髓·六亲论·二十九、贞元');

