INSERT INTO `day_hour_clause` (clause_id, day_pillar, hour_pillar, day_stem, day_branch, hour_branch, clause_text, source_note) VALUES
('DHC_甲子_甲子', '甲子', '甲子', '甲', '子', '子', '甲子日甲子时，子遥巳格，年月无庚辛申酉，丑绊午冲，离祖自立，贵。若年月俱寅，逢申酉运，大富后退财。子亥卯未年月，行西运，贵。甲辰月亦贵。酉月，只以正官格论，大贵。巳午戌月，平常。午月，甲死子冲，尤不吉。乙卯、乙巳月，主法死。以上具以日时为主，而以人命年月附之，其官御不同者，此前代命也。下同。', '三命通会卷八·六甲日子时断'),
('DHC_甲子_乙丑', '甲子', '乙丑', '甲', '子', '丑', '甲子日乙丑时，连珠得合妻贤子贵。春月身旺，财帛破散。夏月甲衰，金神有制，贵。秋生，近侍之贵。丑月最吉，亥、子多凶。', '三命通会卷八·六甲日丑时断'),
('DHC_甲子_丙寅', '甲子', '丙寅', '甲', '子', '寅', '甲子日丙寅时，日禄居时，青云得路，年月无庚辛金，贵；通木火气极贵。午月行东北方运，五六品贵。申月，归禄逢煞，主大权贵；水局平常。若年月与日时同，大贵。', '三命通会卷八·六甲日寅时断'),
('DHC_甲子_丁卯', '甲子', '丁卯', '甲', '子', '卯', '甲子日丁卯时，克剥悭吝，作事进退，不免刑伤妻子，或死他乡。生辰戌丑未月，贵。卯月凶，柱有官煞制亦吉。', '三命通会卷八·六甲日卯时断'),
('DHC_甲子_戊辰', '甲子', '戊辰', '甲', '子', '辰', '甲子日戊辰时，主移根换叶，改姓易宗，妻贤子孝，作高命论。未月，行北方运，贵。酉月，北方运，大贵。', '三命通会卷八·六甲日辰时断'),
('DHC_甲子_己巳', '甲子', '己巳', '甲', '子', '巳', '甲子日己巳时，先贫后富，祖业轻微，妻勤子拗。生寅未巳丑年月，虽贵防疾。申子辰戌，大贵。', '三命通会卷八·六甲日巳时断'),
('DHC_甲子_庚午', '甲子', '庚午', '甲', '子', '午', '甲子日庚午时，时日相冲，忧伤妻子，平常。若子午年月及寅戌月生，行西北方运，金紫风宪。', '三命通会卷八·六甲日午时断'),
('DHC_甲子_辛未', '甲子', '辛未', '甲', '子', '未', '甲子日辛未时，辰戌丑未及己酉月，土金地方，文贵显达。', '三命通会卷八·六甲日未时断'),
('DHC_甲子_壬申', '甲子', '壬申', '甲', '子', '申', '甲子日壬申时，申子辰亥月，水泛木漂，移根换叶，玉堂金马之贵。水土运，凶。', '三命通会卷八·六甲日申时断'),
('DHC_甲子_癸酉', '甲子', '癸酉', '甲', '子', '酉', '甲子日癸酉时，春生木旺；酉月官纯，贵。若混之以煞，或煞多，柱中全无火气，凶。', '三命通会卷八·六甲日酉时断'),
('DHC_甲子_甲戌', '甲子', '甲戌', '甲', '子', '戌', '甲子日甲戌时，春寿，夏暴，秋贵，冬，移根换叶，柱见纯亥夹角，虽贵终凶。辰戌丑未，杂气财官，亦吉。', '三命通会卷八·六甲日戌时断'),
('DHC_甲子_乙亥', '甲子', '乙亥', '甲', '子', '亥', '甲子日乙亥时，成趋乾格，贵。如生申月，煞旺合刃，权贵。酉月正官，柱稍得土助，大贵。辰巳丑未戌月俱吉。年月纯卯，刃旺则凶。', '三命通会卷八·六甲日亥时断'),
('DHC_乙丑_丙子', '乙丑', '丙子', '乙', '丑', '子', '乙丑日丙子时，身弱平常，无午穿冲，贤德温厚。申酉年月，风宪。寅子，贵显。忌丙寅、己未、甲戌、己丑等月，主凶刑恶死。', '三命通会卷八·六乙日子时断'),
('DHC_乙丑_丁丑', '乙丑', '丁丑', '乙', '丑', '丑', '乙丑日丁丑时，秋生有权；主带疾；夏吉，冬平；春旺，贵寿。', '三命通会卷八·六乙日丑时断'),
('DHC_乙丑_戊寅', '乙丑', '戊寅', '乙', '丑', '寅', '乙丑日戊寅时高，生子年戌月者，富贵。辰戌，行木火运，威权。', '三命通会卷八·六乙日寅时断'),
('DHC_乙丑_己卯', '乙丑', '己卯', '乙', '丑', '卯', '乙丑日己卯时高，中年大福。春生，身太旺，孤。夏贫。秋有疾。冬温厚。柱不见辛金，吉。若辰戌丑未月，金紫贵。', '三命通会卷八·六乙日卯时断'),
('DHC_乙丑_庚辰', '乙丑', '庚辰', '乙', '丑', '辰', '乙丑日庚辰时，破祖克父，身弱忌疾，通月气者，贵。子申年月，天干透甲戊，合三奇，大贵。', '三命通会卷八·六乙日辰时断'),
('DHC_乙丑_辛巳', '乙丑', '辛巳', '乙', '丑', '巳', '乙丑日辛巳时，先杂后纯，生寅午丙丁年月，偏官有制，作高命看。巳申酉丑月，官煞重叠，多带疾从煞，亦吉。惟身强主兵权，有名誉。', '三命通会卷八·六乙日巳时断'),
('DHC_乙丑_壬午', '乙丑', '壬午', '乙', '丑', '午', '乙丑日壬午时，春夏多富贵。秋冬官印，或纯煞透干，尤吉。', '三命通会卷八·六乙日午时断'),
('DHC_乙丑_癸未', '乙丑', '癸未', '乙', '丑', '未', '乙丑日癸未时，凶刑孤独，年月通土气，吉。', '三命通会卷八·六乙日未时断'),
('DHC_乙丑_甲申', '乙丑', '甲申', '乙', '丑', '申', '乙丑日甲申时高，纯子辰年月，行东南运，大贵。巳酉丑，贵；中防凶。午未纯，吉。亥卯亦吉。余月平平。', '三命通会卷八·六乙日申时断'),
('DHC_乙丑_乙酉', '乙丑', '乙酉', '乙', '丑', '酉', '乙丑日乙酉时高，生巳酉丑月，合金局，更行西运，大贵。寅午戌月，贫下。亥卯未月，吉。纯子年月，行南运，一二品贵。寅月火金，七品贵。申月水木，金紫贵。', '三命通会卷八·六乙日酉时断'),
('DHC_乙丑_丙戌', '乙丑', '丙戌', '乙', '丑', '戌', '乙丑日丙戌时，春身旺，吉。夏，伤官太重。秋，劳力辛苦。冬亥子，印绶带伤官，极贵。戌月，木火运，七品贵。纯戌年月，天干透庚丙者，大贵。寅午合火者夭。', '三命通会卷八·六乙日戌时断'),
('DHC_乙丑_丁亥', '乙丑', '丁亥', '乙', '丑', '亥', '乙丑日丁亥时秀，生壬子申未卯月，干透财印者，才德兼全，职在风宪。年月干支纯金，身衰煞旺，主凶死。', '三命通会卷八·六乙日亥时断'),
('DHC_丙寅_戊子', '丙寅', '戊子', '丙', '寅', '子', '丙寅日戊子时，生卯丑月，清贵。寅戌，平常。夏月身旺，柱有水金方吉。子月正官，大贵。忌癸巳月，刑；癸亥月，恶死；己酉月，大败。', '三命通会卷八·六丙日子时断'),
('DHC_丙寅_己丑', '丙寅', '己丑', '丙', '寅', '丑', '丙寅日己丑时，平常，生乙酉月，正财格，有乙庚健旺者贵。巳丑年月，干透官印者贵。', '三命通会卷八·六丙日丑时断'),
('DHC_丙寅_庚寅', '丙寅', '庚寅', '丙', '寅', '寅', '丙寅日庚寅时，贵不久。生酉申年月，世裔冷职。子丑寅未，贵显。纯寅尤吉。', '三命通会卷八·六丙日寅时断'),
('DHC_丙寅_辛卯', '丙寅', '辛卯', '丙', '寅', '卯', '丙寅日辛卯时，无祖自立，有肢体疾。寅卯未子月，贵。余月平，岁运同。', '三命通会卷八·六丙日卯时断'),
('DHC_丙寅_壬辰', '丙寅', '壬辰', '丙', '寅', '辰', '丙寅日壬辰时，身煞两旺，寅卯辰丑未年月，大贵。巳午戌年月亦贵。', '三命通会卷八·六丙日辰时断'),
('DHC_丙寅_癸巳', '丙寅', '癸巳', '丙', '寅', '巳', '丙寅日癸巳时，春月，干支无水，文进绣衣，荣妻荫子。卯戌申酉年月，二三品贵。', '三命通会卷八·六丙日巳时断'),
('DHC_丙寅_甲午', '丙寅', '甲午', '丙', '寅', '午', '丙寅日甲午时，生辰戌丑未月，上伏火气，造化得中贵。午月，火太旺，凶。', '三命通会卷八·六丙日午时断'),
('DHC_丙寅_乙未', '丙寅', '乙未', '丙', '寅', '未', '丙寅日乙未时，生卯未月，印绶格，智慧丰厚，难为妻子。寅巳子辰年月，贵。', '三命通会卷八·六丙日未时断'),
('DHC_丙寅_丙申', '丙寅', '丙申', '丙', '寅', '申', '丙寅日丙申时，时日对冲，忧伤妻子，通火气月，行身旺运，吉，亥月，手艺。', '三命通会卷八·六丙日申时断'),
('DHC_丙寅_丁酉', '丙寅', '丁酉', '丙', '寅', '酉', '丙寅日丁酉时，卯亥未年月，干透官煞者贵。余月有艺，平常。', '三命通会卷八·六丙日酉时断'),
('DHC_丙寅_戊戌', '丙寅', '戊戌', '丙', '寅', '戌', '丙寅日戊戌时，庙堂食神，丙以戊为食神寿星，戌上丙火入库，戊土专位，若通火气月及东南运，福厚有寿；不通，平常。', '三命通会卷八·六丙日戌时断'),
('DHC_丙寅_己亥', '丙寅', '己亥', '丙', '寅', '亥', '丙寅日己亥时，夏生，化鬼为官，妻贤子孝，不贵则富。寅卯辰巳申丑年月，或午戌会局，天干更透丙戌字，主大权贵。', '三命通会卷八·六丙日亥时断'),
('DHC_丁卯_庚子', '丁卯', '庚子', '丁', '卯', '子', '丁卯日庚子时贫，辰戌丑未，偏官有制，午月干强，春身旺，俱吉。秋冬平常。忌癸巳月，破祖凶；己未月，刑伤；甲申月，刺面血光死。', '三命通会卷八·六丁日子时断'),
('DHC_丁卯_辛丑', '丁卯', '辛丑', '丁', '卯', '丑', '丁卯日辛丑时，辰巳未年月，富贵，妻子迟。寅卯印助，戌库身旺，刑。丑丁，得倚托，大贵。', '三命通会卷八·六丁日丑时断'),
('DHC_丁卯_壬寅', '丁卯', '壬寅', '丁', '卯', '寅', '丁卯日壬寅时，贵化吉。寅卯年月，行金水运，大贵。亥子月，行西运，贵。', '三命通会卷八·六丁日寅时断'),
('DHC_丁卯_癸卯', '丁卯', '癸卯', '丁', '卯', '卯', '丁卯日癸卯时，寅卯月生，印绶带煞，不为凶论；行官运，贵显。', '三命通会卷八·六丁日卯时断'),
('DHC_丁卯_甲辰', '丁卯', '甲辰', '丁', '卯', '辰', '丁卯日甲辰时，辰戌丑未月，孤克，运通发财。丑月，南方运，贵。卯月，金水运，近侍权贵，不利建白。', '三命通会卷八·六丁日辰时断'),
('DHC_丁卯_乙巳', '丁卯', '乙巳', '丁', '卯', '巳', '丁卯日乙巳时，春印，夏旺，秋财，冬官，看取用何如？俱可论吉。午未年月，文章贵显，行官禄运，吉。', '三命通会卷八·六丁日巳时断'),
('DHC_丁卯_丙午', '丁卯', '丙午', '丁', '卯', '午', '丁卯日丙午时，旺中有灾，卯字刑破白丁。巳月。西北运，贵；东南，极品有权。寅亥，武职二品。若全子酉，大贵。', '三命通会卷八·六丁日午时断'),
('DHC_丁卯_丁未', '丁卯', '丁未', '丁', '卯', '未', '丁卯日丁未时，刑中发。寅卯月，印绶，发财敦厚。辰戌申午，俱吉。', '三命通会卷八·六丁日未时断'),
('DHC_丁卯_戊申', '丁卯', '戊申', '丁', '卯', '申', '丁卯日戊申时，春，伤官用印；秋，伤官用财，俱吉。夏，比肩；冬，伤官见官，平常。四季月，吉。', '三命通会卷八·六丁日申时断'),
('DHC_丁卯_己酉', '丁卯', '己酉', '丁', '卯', '酉', '丁卯日己酉时，时日并冲，忧伤妻子，通火气吉。忌乙卯字。年月有亥未、巳丑，但一字两合，不以冲论。', '三命通会卷八·六丁日酉时断'),
('DHC_丁卯_庚戌', '丁卯', '庚戌', '丁', '卯', '戌', '丁卯日庚戌时，生亥未年月，三合会印，贵。子月，煞印，吉。年月建禄，僧道，主贵。柱无救助，见癸旺，多患目疾，酉月无贵；纯酉戌年月，天干透己甲者贵，中带凶。', '三命通会卷八·六丁日戌时断'),
('DHC_丁卯_辛亥', '丁卯', '辛亥', '丁', '卯', '亥', '丁卯日辛亥时，时上财官印三奇，再得年月印助财生，皆主大贵。纯子，行木火运，官可六品，巳酉丑月，辛财得局，方有倚旺，富贵双全。', '三命通会卷八·六丁日亥时断'),
('DHC_戊辰_壬子', '戊辰', '壬子', '戊', '辰', '子', '戊辰日壬子时，春，财官旺、贵。夏乖。秋少顺。冬财旺，行西南运，五六品贵。忌庚辰月，自刑凶；辛巳月，截路凶刑；乙丑月，破败凶。', '三命通会卷八·六戊日子时断'),
('DHC_戊辰_癸丑', '戊辰', '癸丑', '戊', '辰', '丑', '戊辰日癸丑时，寅巳午未戌月，化火得地，申子辰财局亦吉。年月干支纯土，得四库全者贵。', '三命通会卷八·六戊日丑时断'),
('DHC_戊辰_甲寅', '戊辰', '甲寅', '戊', '辰', '寅', '戊辰日甲寅时，时上偏官，印绶带煞，柱有庚辛制伏者，贵。辰戌丑未，身旺亦贵。', '三命通会卷八·六戊日寅时断'),
('DHC_戊辰_乙卯', '戊辰', '乙卯', '戊', '辰', '卯', '戊辰日乙卯时，身孤，贵。巳卯年月，身强官旺，荣身显祖，子孝妻贤。', '三命通会卷八·六戊日卯时断'),
('DHC_戊辰_丙辰', '戊辰', '丙辰', '戊', '辰', '辰', '戊辰日丙辰时，克父大发，通身旺月，行东北运富；水木月，行身旺运，贵。', '三命通会卷八·六戊日辰时断'),
('DHC_戊辰_丁巳', '戊辰', '丁巳', '戊', '辰', '巳', '戊辰日丁巳时，巳酉丑月，性格风流，威权重大。年月支干不见财官，青云得路。亥戌，行南运，五六品贵。申，行北运，贵。', '三命通会卷八·六戊日巳时断'),
('DHC_戊辰_戊午', '戊辰', '戊午', '戊', '辰', '午', '戊辰日戊午时，拱禄格，年月无寅巳甲乙字，贵。卯申，武职。酉丑亥，行南运，贵。', '三命通会卷八·六戊日午时断'),
('DHC_戊辰_己未', '戊辰', '己未', '戊', '辰', '未', '戊辰日己未时，春冬，行北运，富贵。', '三命通会卷八·六戊日未时断'),
('DHC_戊辰_庚申', '戊辰', '庚申', '戊', '辰', '申', '戊辰日庚申时，专食合禄，纯寅年月，二寅不怕一申冲，亦贵。', '三命通会卷八·六戊日申时断'),
('DHC_戊辰_辛酉', '戊辰', '辛酉', '戊', '辰', '酉', '戊辰日辛酉时，丑未年月，干透财，主贵。若癸巳月，词馆学堂居提纲，主文学高科，寅申巳亥年，则时犯狼藉煞，晚无结果。', '三命通会卷八·六戊日酉时断'),
('DHC_戊辰_壬戌', '戊辰', '壬戌', '戊', '辰', '戌', '戊辰日壬戌时，时日并冲，忧伤妻子，如土厚地方，大贵。卯月，火金运，中贵。寅申戌丑，行西南运，极贵。', '三命通会卷八·六戊日戌时断'),
('DHC_戊辰_癸亥', '戊辰', '癸亥', '戊', '辰', '亥', '戊辰日癸亥时，秀。亥子月，财官格，不贵则富。寅卯年月，贵显。夏生，教职。', '三命通会卷八·六戊日亥时断'),
('DHC_己巳_甲子', '己巳', '甲子', '己', '巳', '子', '己巳日甲子时，辰戌丑未月，风宪三品，要行水木运，西运无成，南运财官无气，虚名薄利，贵而不显。子寅年月，东南运，贵显；《神白经》说：“化土生福，但不显。”忌壬寅月，受刑。乙未月，刑伤。癸酉月，夭。', '三命通会卷八·六己日子时断'),
('DHC_己巳_乙丑', '己巳', '乙丑', '己', '巳', '丑', '己巳日乙丑时，寅卯月，偏官格。无酉戌字，文进贵命。', '三命通会卷八·六己日丑时断'),
('DHC_己巳_丙寅', '己巳', '丙寅', '己', '巳', '寅', '己巳日丙寅时，先刑后旺。寅月，正官格，文章显贵。亥子水，水运，贵。纯戌，武职三品。年月申亥四生局全，大贵，或不善终。', '三命通会卷八·六己日寅时断'),
('DHC_己巳_丁卯', '己巳', '丁卯', '己', '巳', '卯', '己巳日丁卯时，无冲破，富贵；寅午辰年月，刑伤不利。亥月，木火运，贵。若春生透甲乙者，官煞太旺，有制化，亦贵；否则凶夭。', '三命通会卷八·六己日卯时断'),
('DHC_己巳_戊辰', '己巳', '戊辰', '己', '巳', '辰', '己巳日戊辰时，身孤后发。春官贵；夏平稳；秋凶暴；冬财旺。岁运同。', '三命通会卷八·六己日辰时断'),
('DHC_己巳_己巳', '己巳', '己巳', '己', '巳', '巳', '己巳日己巳时，午年月，权威赫赫，名誉昭昭。春月，子孝妻贤。秋冬平常，贵而不显。辰戌，财印官食；申，伤官生财，俱作吉推。', '三命通会卷八·六己日巳时断'),
('DHC_己巳_庚午', '己巳', '庚午', '己', '巳', '午', '己巳日庚午时，贵。寅午戌月，金神入火乡，作印绶论，贵显，辰戌丑未年月，侯伯。若逢合煞运，必不善终。酉月、东南运，贵。', '三命通会卷八·六己日午时断'),
('DHC_己巳_辛未', '己巳', '辛未', '己', '巳', '未', '己巳日辛未时，金神日。寅午戌月生，贵；亥卯辰午，行金火水木运，大贵。', '三命通会卷八·六己日未时断'),
('DHC_己巳_壬申', '己巳', '壬申', '己', '巳', '申', '己巳日壬申时，大凶，刑。己酉丑月，伤官，行财运，吉。寅午戌月，金神入火乡，运西南，贵。申子辰月，木火运，贵。', '三命通会卷八·六己日申时断'),
('DHC_己巳_癸酉', '己巳', '癸酉', '己', '巳', '酉', '己巳日癸酉时，巳酉丑月，伤官伤尽，居武职、风宪。卯戌月，金神入火乡，贵而能言，伤贵，收心早退，以水土败在酉故也。', '三命通会卷八·六己日酉时断'),
('DHC_己巳_甲戌', '己巳', '甲戌', '己', '巳', '戌', '己巳日甲戌时，寅午戌月，金神入火乡，贵显。亥戌年月，官居守令，极有声名。子月、木火运，极品。', '三命通会卷八·六己日戌时断'),
('DHC_己巳_乙亥', '己巳', '乙亥', '己', '巳', '亥', '己巳日乙亥时，寅午戌月，金神入火乡，贵。巳月、西北运，官至公卿。卯午，风宪。纯子亥年月，以财党煞，作弃看，主大兵权。', '三命通会卷八·六己日亥时断'),
('DHC_庚午_丙子', '庚午', '丙子', '庚', '午', '子', '庚午日丙子时，贵。时日相冲，忧伤妻子，运喜西南，通火木月气，风宪三四品。秋生，丙火无气，难为子息。忌己巳月，破祖，凶。己亥月，被劫盗，凶。癸丑月，孤。', '三命通会卷八·六庚日子时断'),
('DHC_庚午_丁丑', '庚午', '丁丑', '庚', '午', '丑', '庚午日丁丑时，通土月气，贵；不，亦富，有名声。', '三命通会卷八·六庚日丑时断'),
('DHC_庚午_戊寅', '庚午', '戊寅', '庚', '午', '寅', '庚午日戊寅时，寅午戌月，金衰火旺，当带残疾。纯寅，反主极贵。秋，金旺，多贵，但忌时遇亡劫，克身则凶。', '三命通会卷八·六庚日寅时断'),
('DHC_庚午_己卯', '庚午', '己卯', '庚', '午', '卯', '庚午日己卯时，刑破。申子辰己酉丑，俱行东南运，贵。寅午戌亥卯未，须得西北运为佳。', '三命通会卷八·六庚日卯时断'),
('DHC_庚午_庚辰', '庚午', '庚辰', '庚', '午', '辰', '庚午日庚辰时，自刑，金神入火乡。申月，行火木运，官可六品。', '三命通会卷八·六庚日辰时断'),
('DHC_庚午_辛巳', '庚午', '辛巳', '庚', '午', '巳', '庚午日辛巳时，巳午卯年月，进士风宪。巳申酉戌，行土木运，侯伯。', '三命通会卷八·六庚日巳时断'),
('DHC_庚午_壬午', '庚午', '壬午', '庚', '午', '午', '庚午日壬午时，寅午戌月、金柔火旺，畏缩残疾。亥子午月、行木火运，贵。', '三命通会卷八·六庚日午时断'),
('DHC_庚午_癸未', '庚午', '癸未', '庚', '午', '未', '庚午日癸未时，贵。酉申巳亥年月，总领兵戎，官至二品。先虚后实。', '三命通会卷八·六庚日未时断'),
('DHC_庚午_甲申', '庚午', '甲申', '庚', '午', '申', '庚午日甲申时，贵。通身旺月，无丙巳寅午丁，伤破，贵。', '三命通会卷八·六庚日申时断'),
('DHC_庚午_乙酉', '庚午', '乙酉', '庚', '午', '酉', '庚午日乙酉时，刑，中贵。寅午戌亥卯未二局，贵。已，亦吉。', '三命通会卷八·六庚日酉时断'),
('DHC_庚午_丙戌', '庚午', '丙戌', '庚', '午', '戌', '庚午日丙戌时，申酉亥丑、富，贵三品。已午未申，透出壬字，艮坎乾方运，卿相有寿。', '三命通会卷八·六庚日戌时断'),
('DHC_庚午_丁亥', '庚午', '丁亥', '庚', '午', '亥', '庚午日丁亥时，贵。辰戌丑未月，土能生金，荣显。申亥酉月，行木火运，极品。', '三命通会卷八·六庚日亥时断'),
('DHC_辛未_戊子', '辛未', '戊子', '辛', '未', '子', '辛未日戊子时，贵。寅已午酉年月，火木运，贵。亥子，翰苑。辰戌丑未，杂气财官印，俱吉。忌庚申月，尸不全死。壬子月，孤凶。癸丑月，凶刑死。', '三命通会卷八·六辛日子时断'),
('DHC_辛未_己丑', '辛未', '己丑', '辛', '未', '丑', '辛未日己丑时，寅卯未月，财星格。已午，官显。', '三命通会卷八·六辛日丑时断'),
('DHC_辛未_庚寅', '辛未', '庚寅', '辛', '未', '寅', '辛未日庚寅时，已未丑月，名标金标，妻贤子孝，晚年风疾。寅卯午戌，俱吉。', '三命通会卷八·六辛日寅时断'),
('DHC_辛未_辛卯', '辛未', '辛卯', '辛', '未', '卯', '辛未日辛卯时，纯未、丁年月，虽大权贵，不善终。寅巳亥，纯吉。', '三命通会卷八·六辛日卯时断'),
('DHC_辛未_壬辰', '辛未', '壬辰', '辛', '未', '辰', '辛未日壬辰时、身孤。春生，财星格，吉。夏，劳碌。秋，贵。冬，伤官伤尽，为奇。', '三命通会卷八·六辛日辰时断'),
('DHC_辛未_癸巳', '辛未', '癸巳', '辛', '未', '巳', '辛未日癸巳时，寅午戌月，高命。巳酉丑，身旺平稳。申子辰，白丁。亥卯未，清贵。', '三命通会卷八·六辛日巳时断'),
('DHC_辛未_甲午', '辛未', '甲午', '辛', '未', '午', '辛未日甲午时，申子辰，偏官有制，吉。丑戌，方面。未月。贵。', '三命通会卷八·六辛日午时断'),
('DHC_辛未_乙未', '辛未', '乙未', '辛', '未', '未', '辛未日乙未时，寅卯未年月，财旺生官，名高禄重。通火气，行西运；通金气，行南，俱吉。', '三命通会卷八·六辛日未时断'),
('DHC_辛未_丙申', '辛未', '丙申', '辛', '未', '申', '辛未日丙申时，因贵人门下得富。春，清贵。夏，平常。秋，富。冬，大贵寿促。《神白经》云：金水乖合，又化水，主贵。', '三命通会卷八·六辛日申时断'),
('DHC_辛未_丁酉', '辛未', '丁酉', '辛', '未', '酉', '辛未日丁酉时，不贵则富。月通金气，无丙丁字，行南运，贵。', '三命通会卷八·六辛日酉时断'),
('DHC_辛未_戊戌', '辛未', '戊戌', '辛', '未', '戌', '辛未日戊戌时，凶恶狠暴，忧伤妻子。寅巳午戌丑月，贵。申子辰亥，金水氵亟秀，尤贵。一云克父母，身旺，中年富。', '三命通会卷八·六辛日戌时断'),
('DHC_辛未_己亥', '辛未', '己亥', '辛', '未', '亥', '辛未日己亥时，贵。亥卯未寅月，金能克木，为财盛生官，名利贵显，巳午年月，富贵。秋生，透丙，亦吉。', '三命通会卷八·六辛日亥时断'),
('DHC_壬申_庚子', '壬申', '庚子', '壬', '申', '子', '壬申日庚子时，贫、刑。未月，杂气财官，行财旺运贵显，先难后易。辰，会水太旺，须行火土运，吉。丑、戌，财官印绶，俱吉。春冬平常，秋夏吉庆。忌乙巳月受刑，夭；丁酉，夭；乙亥月孤，自刑。', '三命通会卷八·六壬日子时断'),
('DHC_壬申_辛丑', '壬申', '辛丑', '壬', '申', '丑', '壬申日辛丑时，寅卯亥未年月，进士风宪，官至二品，终有起倒。辰戌，富足。申酉，享用自然，行北运亦贵。', '三命通会卷八·六壬日丑时断'),
('DHC_壬申_壬寅', '壬申', '壬寅', '壬', '申', '寅', '壬申日壬寅时，巳酉丑月，武职三品。辛卯、戌月，亦贵。子寅，大贵。一云贫而发，亦不久。', '三命通会卷八·六壬日寅时断'),
('DHC_壬申_癸卯', '壬申', '癸卯', '壬', '申', '卯', '壬申日癸卯时，亥卯未寅月，伤官伤尽，妻贤子孝，土厚贵命。纯辰，医卜。子月水木，贵。', '三命通会卷八·六壬日卯时断'),
('DHC_壬申_甲辰', '壬申', '甲辰', '壬', '申', '辰', '壬申日甲辰时，水火灾，丑寅年月，文行武权。纯子，金火运，方面。', '三命通会卷八·六壬日辰时断'),
('DHC_壬申_乙巳', '壬申', '乙巳', '壬', '申', '巳', '壬申日乙巳时，身坐长生学堂，财帛进退，名利驱驰。木月，行北运，贵。辰戌丑，俱吉。', '三命通会卷八·六壬日巳时断'),
('DHC_壬申_丙午', '壬申', '丙午', '壬', '申', '午', '壬申日丙午时，通金水月气，贵；不通，弃命就财，主富，不然，极贫下。', '三命通会卷八·六壬日午时断'),
('DHC_壬申_丁未', '壬申', '丁未', '壬', '申', '未', '壬申日丁未时，大富。巳午年月，或透戊己，富贵双全。', '三命通会卷八·六壬日未时断'),
('DHC_壬申_戊申', '壬申', '戊申', '壬', '申', '申', '壬申日戊申时，壬水长生，居申，煞旺身强，更生亥卯未月，偏官有制，吉。', '三命通会卷八·六壬日申时断'),
('DHC_壬申_己酉', '壬申', '己酉', '壬', '申', '酉', '壬申日己酉时，官印临门，局中无冲破，禄马双全，不贵即富。戌月生，东南方运，腰金衣紫。', '三命通会卷八·六壬日酉时断'),
('DHC_壬申_庚戌', '壬申', '庚戌', '壬', '申', '戌', '壬申日庚戌时，通火木月气，富贵；不通，行通运，亦好。丑戌年月，大贵。', '三命通会卷八·六壬日戌时断'),
('DHC_壬申_辛亥', '壬申', '辛亥', '壬', '申', '亥', '壬申日辛亥时，贵。辰戌丑未，杂气财官，吉。年月干无己土，入日禄格，酉月申卯年，行东北运，显贵。', '三命通会卷八·六壬日亥时断'),
('DHC_癸酉_壬子', '癸酉', '壬子', '癸', '酉', '子', '癸酉日壬子时，行藏进退，少子难为妻家。忌丙寅月，不全尸死；乙巳月，大破凶死；丁酉月，自缢死。', '三命通会卷八·六癸日子时断'),
('DHC_癸酉_癸丑', '癸酉', '癸丑', '癸', '酉', '丑', '癸酉日癸丑时，福德秀气格，学问渊源，行藏进退，难为妻家。', '三命通会卷八·六癸日丑时断'),
('DHC_癸酉_甲寅', '癸酉', '甲寅', '癸', '酉', '寅', '癸酉日甲寅时，金神格。寅午戌月，结火局，贵显特达，官至二三品。忌丑年，不贵。巳未亥子年月，富寿。辰丑，干透甲丁者，凶。', '三命通会卷八·六癸日寅时断'),
('DHC_癸酉_乙卯', '癸酉', '乙卯', '癸', '酉', '卯', '癸酉日乙卯时，申子辰月，贵。寅午戌，中。亥卯未，平。巳酉丑，富。', '三命通会卷八·六癸日卯时断'),
('DHC_癸酉_丙辰', '癸酉', '丙辰', '癸', '酉', '辰', '癸酉日丙辰时，孤，贵。巳酉丑月，贵。寅卯，不吉。子午，富。戌月，大贵。', '三命通会卷八·六癸日辰时断'),
('DHC_癸酉_丁巳', '癸酉', '丁巳', '癸', '酉', '巳', '癸酉日丁巳时，先贫后富。巳酉月，官印俱旺。亥卯未，食伤生财，贵显。午戌，财旺，亦吉。', '三命通会卷八·六癸日巳时断'),
('DHC_癸酉_戊午', '癸酉', '戊午', '癸', '酉', '午', '癸酉日戊午时，主伤妻家财，有始无终，子年子贵而无禄，行南运，好。', '三命通会卷八·六癸日午时断'),
('DHC_癸酉_己未', '癸酉', '己未', '癸', '酉', '未', '癸酉日己未时，寅巳申酉丑戌年月，贵。', '三命通会卷八·六癸日未时断'),
