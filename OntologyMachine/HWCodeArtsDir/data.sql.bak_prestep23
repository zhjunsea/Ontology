('DHC_壬寅_己酉', '壬寅', '己酉', '壬', '寅', '酉', '壬寅日己酉时，大富贵，喜通水气，行官运，贵。但好花酒，风流人物。', '三命通会卷八·六壬日酉时断'),
('DHC_壬寅_庚戌', '壬寅', '庚戌', '壬', '寅', '戌', '壬寅日庚戌时，刑妻克子。若春生，平，夏、冬，吉。辰丑未月，贵。', '三命通会卷八·六壬日戌时断'),
('DHC_壬寅_辛亥', '壬寅', '辛亥', '壬', '寅', '亥', '壬寅日辛亥时，艰难中发。未月，杂气财官，敦厚，中年贵，五十后终。亥月，东南运，方面。', '三命通会卷八·六壬日亥时断'),
('DHC_癸卯_壬子', '癸卯', '壬子', '癸', '卯', '子', '癸卯日壬子时，时日相刑，伤妻克子，近贵；无己土，威权。若亥巳俱全，进士乌府。年月纯寅，伤官生财，非大贵即大富。忌甲辰月凶刑孤，丙申月凶恶死，己丑月刑。', '三命通会卷八·六癸日子时断'),
('DHC_癸卯_癸丑', '癸卯', '癸丑', '癸', '卯', '丑', '癸卯日癸丑时，日贵格，身孤克，主贵。丑寅辰年月，干支无戊己巳午卯字，极品。', '三命通会卷八·六癸日丑时断'),
('DHC_癸卯_甲寅', '癸卯', '甲寅', '癸', '卯', '寅', '癸卯日甲寅时，亥卯未月，至贵。寅卯年月，刑合格，侯伯。寅亥，四品。寅月，西运，金紫。丑戌辰巳，亦贵。', '三命通会卷八·六癸日寅时断'),
('DHC_癸卯_乙卯', '癸卯', '乙卯', '癸', '卯', '卯', '癸卯日乙卯时，艰难。生寅卯月，伤官格，难言富贵。未戌年月，技艺近贵。辰丑，吉。己丑、丙子，凶。', '三命通会卷八·六癸日卯时断'),
('DHC_癸卯_丙辰', '癸卯', '丙辰', '癸', '卯', '辰', '癸卯日丙辰时，孤独难为椿萱，有财帛，贵，人钦敬。卯亥年月，日贵格。午戌，九品至五品。寅月，行南运，风宪。', '三命通会卷八·六癸日辰时断'),
('DHC_癸卯_丁巳', '癸卯', '丁巳', '癸', '卯', '巳', '癸卯日丁巳时，若子月，身旺财旺，贵显。', '三命通会卷八·六癸日巳时断'),
('DHC_癸卯_戊午', '癸卯', '戊午', '癸', '卯', '午', '癸卯日戊午时，申子辰亥月，身旺不化，平常。卯戌月，贵。', '三命通会卷八·六癸日午时断'),
('DHC_癸卯_己未', '癸卯', '己未', '癸', '卯', '未', '癸卯日己未时，子巳未年月，二品。巳寅字，刑六亲。', '三命通会卷八·六癸日未时断'),
('DHC_癸卯_庚申', '癸卯', '庚申', '癸', '卯', '申', '癸卯日庚申时，卯月作合禄格，西北运，贵，金紫。申月，东北运，风宪。庚辰、庚戌年月，正官格，贵。辰月，金水运，七品贵。', '三命通会卷八·六癸日申时断'),
('DHC_癸卯_辛酉', '癸卯', '辛酉', '癸', '卯', '酉', '癸卯日辛酉时，日贵格，辰戌丑未月，贵。子卯年月，大贵。巳午，亦贵。又云不利妻子。', '三命通会卷八·六癸日酉时断'),
('DHC_癸卯_壬戌', '癸卯', '壬戌', '癸', '卯', '戌', '癸卯日壬戌时，日贵格，寅巳年月，干透戊丁财官而旺，大贵有权。卯辰丑午子等年月，文贵。酉戌，金土运，五六品。', '三命通会卷八·六癸日戌时断'),
('DHC_癸卯_癸亥', '癸卯', '癸亥', '癸', '卯', '亥', '癸卯日癸亥时，平，日贵格。寅卯月，伤官论，行金水运，风宪。辰戌丑未月，官旺。纯卯，三品贵。辰戌与卯刑，主孤贫。', '三命通会卷八·六癸日亥时断'),
('DHC_甲辰_甲子', '甲辰', '甲子', '甲', '辰', '子', '甲辰日甲子时，若水位年月，水泛木浮，主移根换叶；申月，煞星会印，俱贵。子月，行水木运，亦贵。酉月正官，大贵。寅午戌月，俱吉。乙卯月，刑折。癸巳月，水火中死。癸亥月，凶死。', '三命通会卷八·六甲日子时断'),
('DHC_甲辰_乙丑', '甲辰', '乙丑', '甲', '辰', '丑', '甲辰日乙丑时，主富厚有财，通火气年月，贵。', '三命通会卷八·六甲日丑时断'),
('DHC_甲辰_丙寅', '甲辰', '丙寅', '甲', '辰', '寅', '甲辰日丙寅时，龙虎拱门，又龙吟虎啸，主贵，或一生近贵，财源或得或失，名利既济未济。未、寅年月，官至六卿；戌月风宪；酉月三品；子、亥、丑月四五品，行西方运，大贵；卯、巳年月平常。', '三命通会卷八·六甲日寅时断'),
('DHC_甲辰_丁卯', '甲辰', '丁卯', '甲', '辰', '卯', '甲辰日丁卯时，财帛满目，生计盈余，妻贤子孝，高命论之。春生太旺无制，贫贱残疾。丑、酉月贵。', '三命通会卷八·六甲日卯时断'),
('DHC_甲辰_戊辰', '甲辰', '戊辰', '甲', '辰', '辰', '甲辰日戊辰时，刑冲发财，妻重子晚，双亲有克。酉月三四品贵。丑月亦贵。地支纯辰，大贵。', '三命通会卷八·六甲日辰时断'),
('DHC_甲辰_己巳', '甲辰', '己巳', '甲', '辰', '巳', '甲辰日己巳时，丰姿敦厚，一生平安，财帛有成。巳酉丑年月，行火金运，贵。', '三命通会卷八·六甲日巳时断'),
('DHC_甲辰_庚午', '甲辰', '庚午', '甲', '辰', '午', '甲辰日庚午时，田园乐赏。寅月，行金运，风宪。', '三命通会卷八·六甲日午时断'),
('DHC_甲辰_辛未', '甲辰', '辛未', '甲', '辰', '未', '甲辰日辛未时，辰戌丑未月富。巳酉丑子年月贵。', '三命通会卷八·六甲日未时断'),
('DHC_甲辰_壬申', '甲辰', '壬申', '甲', '辰', '申', '甲辰日壬申时，寅辰年月，文章显贵。透丙戊尤美。', '三命通会卷八·六甲日申时断'),
('DHC_甲辰_癸酉', '甲辰', '癸酉', '甲', '辰', '酉', '甲辰日癸酉时，子戌年月，有财有官，贵。', '三命通会卷八·六甲日酉时断'),
('DHC_甲辰_甲戌', '甲辰', '甲戌', '甲', '辰', '戌', '甲辰日甲戌时，财源稳厚，多凶。春月金火运，官至六品。', '三命通会卷八·六甲日戌时断'),
('DHC_甲辰_乙亥', '甲辰', '乙亥', '甲', '辰', '亥', '甲辰日乙亥时，酉月正官，最贵。辰戌丑未及寅亥年月，俱吉。', '三命通会卷八·六甲日亥时断'),
('DHC_乙巳_丙子', '乙巳', '丙子', '乙', '巳', '子', '乙巳日丙子时，吉。若巳午年月，寿促，不然，身孤劳碌，纯土，财旺生官，行西运；子辰，行水火运，俱二三品贵。申月正官，酉月偏官，卯月建禄，俱吉。忌甲寅月，刑夭。乙酉月下贱。', '三命通会卷八·六乙日子时断'),
('DHC_乙巳_丁丑', '乙巳', '丁丑', '乙', '巳', '丑', '乙巳日丁丑时生，亥卯未寅月，贵。通金气月有倚托者，福重。', '三命通会卷八·六乙日丑时断'),
('DHC_乙巳_戊寅', '乙巳', '戊寅', '乙', '巳', '寅', '乙巳日戊寅时，孤克平常。若年月申庚，正官；丑辛，七煞，俱贵。辰月，北方运，吉。', '三命通会卷八·六乙日寅时断'),
('DHC_乙巳_己卯', '乙巳', '己卯', '乙', '巳', '卯', '乙巳日己卯时，春孤贫，夏平，秋带疾，冬贵。午辰年月、地支一路相连，尤吉。', '三命通会卷八·六乙日卯时断'),
('DHC_乙巳_庚辰', '乙巳', '庚辰', '乙', '巳', '辰', '乙巳日庚辰时，作事成败，僧道富贵带疾。常人刑克妻子。申子辰卯巳年月，贵。', '三命通会卷八·六乙日辰时断'),
('DHC_乙巳_辛巳', '乙巳', '辛巳', '乙', '巳', '巳', '乙巳日辛巳时，克妻，妻子俱晚。若巳酉丑月，木柔金重，主带疾。不然寿促。甲巳子巳年月，入偏官格，西运，风宪。春月身旺，更吉。', '三命通会卷八·六乙日巳时断'),
('DHC_乙巳_壬午', '乙巳', '壬午', '乙', '巳', '午', '乙巳日壬午时吉，春夏富贵。秋冬平常。', '三命通会卷八·六乙日午时断'),
('DHC_乙巳_癸未', '乙巳', '癸未', '乙', '巳', '未', '乙巳日癸未时，不贵则富，先难后易。纯午、三品贵。辰戌丑月，俱吉。', '三命通会卷八·六乙日未时断'),
('DHC_乙巳_甲申', '乙巳', '甲申', '乙', '巳', '申', '乙巳日甲申时，身强官旺。春，聪明显达，官至四品。夏，身心劳碌。秋冬眼疾。午年月，行财运，贵。', '三命通会卷八·六乙日申时断'),
('DHC_乙巳_乙酉', '乙巳', '乙酉', '乙', '巳', '酉', '乙巳日乙酉时，春吉。夏，伤官有制，好。秋，木弱金重，夭，不然有疾。冬，福厚亦夭。', '三命通会卷八·六乙日酉时断'),
('DHC_乙巳_丙戌', '乙巳', '丙戌', '乙', '巳', '戌', '乙巳日丙戌时，吉。丑戌未年月，风宪六卿。亥月，行东运，翰院清贵。', '三命通会卷八·六乙日戌时断'),
('DHC_乙巳_丁亥', '乙巳', '丁亥', '乙', '巳', '亥', '【待考】源本未载，待校', '三命通会卷八·六乙日亥时断'),
('DHC_丙午_戊子', '丙午', '戊子', '丙', '午', '子', '丙午日戊子时，丙午为日刃格，要官煞制合。生辰戌丑未月，大富。亥卯未寅年月，大贵，申巳，文贵三品，武贵不永。纯子，为子午双包贵格。忌丁巳月，恶死；丁亥月，自刑恶死；辛丑月，孤独。', '三命通会卷八·六丙日子时断'),
('DHC_丙午_己丑', '丙午', '己丑', '丙', '午', '丑', '丙午日己丑时，春月，行火金运，官至极品。夏平，秋富，冬贵，难为妻子，午酉年月，五六品，此月禄生财之验。', '三命通会卷八·六丙日丑时断'),
('DHC_丙午_庚寅', '丙午', '庚寅', '丙', '午', '寅', '丙午日庚寅时，年月无壬癸子未巳字，飞天禄马，贵。巳酉丑申，主文学，不贵即富。未月，伤官。辰月，先贫后富。亥月，行西运，贵显。', '三命通会卷八·六丙日寅时断'),
('DHC_丙午_辛卯', '丙午', '辛卯', '丙', '午', '卯', '丙午日辛卯时，年月中得癸水官星去刃则吉。子月，伤克妻子，寅酉，性格刚强，不受击触，三四品贵。午戌，行东南运；卯月，行西北运，俱贵。', '三命通会卷八·六丙日卯时断'),
('DHC_丙午_壬辰', '丙午', '壬辰', '丙', '午', '辰', '丙午日壬辰时贵，身旺煞浅，若辰戌丑未月，偏官有制，贵；无制，平常。', '三命通会卷八·六丙日辰时断'),
('DHC_丙午_癸巳', '丙午', '癸巳', '丙', '午', '巳', '丙午日癸巳时，丑辰月，杂气财官，贵显。寅月，丙长生；已月，丙建禄，天干透财印者大贵，宜戒酒。子，官旺；酉，财旺，俱吉。', '三命通会卷八·六丙日巳时断'),
('DHC_丙午_甲午', '丙午', '甲午', '丙', '午', '午', '丙午日甲午时，寅午戌月，作倒冲论，二三品贵。子月，南运，八九品贵。寅月，南运，金紫贵。午月，东方运，近侍贵。', '三命通会卷八·六丙日午时断'),
('DHC_丙午_乙未', '丙午', '乙未', '丙', '午', '未', '丙午日乙未时，不贵则富。午戌年月，职居风宪。申子辰，官星制刃；亥印未，印绶化刃，俱吉。', '三命通会卷八·六丙日未时断'),
('DHC_丙午_丙申', '丙午', '丙申', '丙', '午', '申', '丙午日丙申时，主血火厄，后大发。若巳月生，庚辛透露，财星格，武贵。', '三命通会卷八·六丙日申时断'),
('DHC_丙午_丁酉', '丙午', '丁酉', '丙', '午', '酉', '丙午日丁酉时，生巳午戌月，僧道命好；酉月贵；亥子丑寅卯辰官印年月，大贵。', '三命通会卷八·六丙日酉时断'),
('DHC_丙午_戊戌', '丙午', '戊戌', '丙', '午', '戌', '丙午日戊戌时，羊刃食神健旺，名利骤发，亥未辰戌年月，西方运，风宪。', '三命通会卷八·六丙日戌时断'),
('DHC_丙午_己亥', '丙午', '己亥', '丙', '午', '亥', '丙午日己亥时，武贵。寅巳午月生，妻重子晚，不贵即富。秋冬，名利进退，酉午戌，大贵。', '三命通会卷八·六丙日亥时断'),
('DHC_丁未_庚子', '丁未', '庚子', '丁', '未', '子', '丁未日庚子时，辰戌丑未月，偏官有制。午月干强，贵。余月有制伏，吉；戊子，文章显秀。忌戊申月，夭；丙戌月，刑；辛丑月，刑凶。', '三命通会卷八·六丁日子时断'),
('DHC_丁未_辛丑', '丁未', '辛丑', '丁', '未', '丑', '丁未日辛丑时，时日并冲，忧伤妻子。酉月，通水气，吉。岁运同。', '三命通会卷八·六丁日丑时断'),
('DHC_丁未_壬寅', '丁未', '壬寅', '丁', '未', '寅', '丁未日壬寅时，恶死。春生印吉，夏，木火运，发福。秋富，冬贵。酉戌年月，官至三品。亥卯寅戌，文贵，纯卯行金水运，金紫。', '三命通会卷八·六丁日寅时断'),
('DHC_丁未_癸卯', '丁未', '癸卯', '丁', '未', '卯', '丁未日癸卯时，偏官生印。春吉，夏平，秋富，冬贫。', '三命通会卷八·六丁日卯时断'),
('DHC_丁未_甲辰', '丁未', '甲辰', '丁', '未', '辰', '丁未日甲辰时，丑亥卯未月，印绶，官贵。夏平。辰戌，贵厚。酉午，金水运，大贵。', '三命通会卷八·六丁日辰时断'),
('DHC_丁未_乙巳', '丁未', '乙巳', '丁', '未', '巳', '丁未日乙巳时，若人倒冲格，无冲破，贵。巳亥年月，三四品贵。酉丑合财局，富。', '三命通会卷八·六丁日巳时断'),
('DHC_丁未_丙午', '丁未', '丙午', '丁', '未', '午', '丁未日丙午时贵，破祖而成。年月忌壬癸字。甲申月，财官印三奇；辰月，官库；亥月，官印，俱大贵。', '三命通会卷八·六丁日午时断'),
('DHC_丁未_丁未', '丁未', '丁未', '丁', '未', '未', '丁未日丁未时，八专太旺，早克父母妻子，衣禄平常，为僧道吉。柱通金水木并金水运，衣禄安稳，大贵。', '三命通会卷八·六丁日未时断'),
('DHC_丁未_戊申', '丁未', '戊申', '丁', '未', '申', '丁未日戊申时；生巳午未戌，身旺贵显。若亥卯会未，子辰会申，俱以贵论。', '三命通会卷八·六丁日申时断'),
('DHC_丁未_己酉', '丁未', '己酉', '丁', '未', '酉', '丁未日己酉时，通火气，贵。见卯乙癸字不贵。', '三命通会卷八·六丁日酉时断'),
('DHC_丁未_庚戌', '丁未', '庚戌', '丁', '未', '戌', '丁未日庚戌时，主刑。亥卯会印，申子辰会官，俱主文贵。午月，建禄，有子冲，凶。若年月用土生财，主富；用财生官，富贵双全。', '三命通会卷八·六丁日戌时断'),
('DHC_丁未_辛亥', '丁未', '辛亥', '丁', '未', '亥', '丁未日辛亥时，亥卯未寅辰午年月，干透正印、正官者，聪明贵显；行西运，极品。巳丑月，风宪。', '三命通会卷八·六丁日亥时断'),
('DHC_戊申_壬子', '戊申', '壬子', '戊', '申', '子', '戊申日壬子时高，先滞后旺。子酉年月，时上偏官，贵。巳午未戌，身有制化，用财亦专，皆以吉论。申酉，食伤生财，天干透甲乙者，富贵双全。忌己巳月刑害，壬午月夭伤，癸亥月孤贫。', '三命通会卷八·六戊日子时断'),
('DHC_戊申_癸丑', '戊申', '癸丑', '戊', '申', '丑', '戊申日癸丑时，辰戌丑未午月生，富贵爱酒色。夏，东方运，贵。秋冬，财旺生官，若身衰，不夭即贫。', '三命通会卷八·六戊日丑时断'),
('DHC_戊申_甲寅', '戊申', '甲寅', '戊', '申', '寅', '戊申日甲寅时，申酉，伤官带煞，土厚地方，贵。丑卯年月，去煞留官，大贵；要行金火运，位极人臣。', '三命通会卷八·六戊日寅时断'),
('DHC_戊申_乙卯', '戊申', '乙卯', '戊', '申', '卯', '戊申日乙卯时，中年破祖。春贵。夏近贵。秋孤苦。冬富贵双全。巳月，木火运，五品上贵。', '三命通会卷八·六戊日卯时断'),
('DHC_戊申_丙辰', '戊申', '丙辰', '戊', '申', '辰', '戊申日丙辰时，辰戌丑未月，贵；不通土气，行土运亦贵。', '三命通会卷八·六戊日辰时断'),
('DHC_戊申_丁巳', '戊申', '丁巳', '戊', '申', '巳', '戊申日丁巳时，春夏平，秋成败，冬富贵。行木金运，吉。', '三命通会卷八·六戊日巳时断'),
('DHC_戊申_戊午', '戊申', '戊午', '戊', '申', '午', '戊申日戊午时，拱贵格，年月逢寅，行南运，风宪；逢午，贵寿；戌文贵。有未填实、巳建禄相连一片者，大贵。', '三命通会卷八·六戊日午时断'),
('DHC_戊申_己未', '戊申', '己未', '戊', '申', '未', '戊申日己未时贵，行财官运，发福。嫌寅冲煞有凶。', '三命通会卷八·六戊日未时断'),
('DHC_戊申_庚申', '戊申', '庚申', '戊', '申', '申', '戊申日庚申时，身禄同窠，富贵两全，子辰未酉年月，行西运，入合禄格，近上三品。年月丑戌，吉：辰戌伤克，平常。亥巳年月，行东北运，一二品贵。', '三命通会卷八·六戊日申时断'),
('DHC_戊申_辛酉', '戊申', '辛酉', '戊', '申', '酉', '戊申日辛酉时，戌亥丑子年月，权贵。', '三命通会卷八·六戊日酉时断'),
('DHC_戊申_壬戌', '戊申', '壬戌', '戊', '申', '戌', '戊申日壬戌时，春贵，夏平，秋富贵，冬平常。', '三命通会卷八·六戊日戌时断'),
('DHC_戊申_癸亥', '戊申', '癸亥', '戊', '申', '亥', '戊申日癸亥时，子未年月，无祖业，因妻致富，不然移根换叶，贫而且贱。', '三命通会卷八·六戊日亥时断'),
('DHC_己酉_甲子', '己酉', '甲子', '己', '酉', '子', '己酉日甲子时，寅申午未丑年月，文贵风宪。午月，东北运，极品。忌庚寅年，破败恶死。己巳月，凶恶。戊戌月，孤单血死。', '三命通会卷八·六己日子时断'),
('DHC_己酉_乙丑', '己酉', '乙丑', '己', '酉', '丑', '己酉日乙丑时，卯月，偏官。辰月，财煞，贵。申酉，伤官伤尽。巳午，印绶，俱贵。丑戌，亦贵。', '三命通会卷八·六己日丑时断'),
('DHC_己酉_丙寅', '己酉', '丙寅', '己', '酉', '寅', '己酉日丙寅时，月通木火局，贵；木火运，亦荣达。', '三命通会卷八·六己日寅时断'),
('DHC_己酉_丁卯', '己酉', '丁卯', '己', '酉', '卯', '己酉日丁卯时，九成十破，未年旺。年月通身生旺，干头有辛癸制伏丁乙者，吉。', '三命通会卷八·六己日卯时断'),
('DHC_己酉_戊辰', '己酉', '戊辰', '己', '酉', '辰', '己酉日戊辰时，春官旺，夏平吉，秋暴狠，冬财旺。', '三命通会卷八·六己日辰时断'),
('DHC_己酉_己巳', '己酉', '己巳', '己', '酉', '巳', '己酉日己巳时，夏生，金神入火乡，贵显，岁运同前。', '三命通会卷八·六己日巳时断'),
('DHC_己酉_庚午', '己酉', '庚午', '己', '酉', '午', '【待考】源本未载，待校', '三命通会卷八·六己日午时断'),
('DHC_己酉_辛未', '己酉', '辛未', '己', '酉', '未', '己酉日辛未时，春反复；夏吉；秋寿促；冬财帛丰厚。卯月金水运，五品以上贵。丑月西南运，郎官。辰戌，财印库地俱吉。一云凶刑后旺。', '三命通会卷八·六己日未时断'),
('DHC_己酉_壬申', '己酉', '壬申', '己', '酉', '申', '己酉日壬申时，巳酉丑月，伤官伤尽，吉。寅月，凶暴。卯未，武职。子未公侯。一云主心狂贤病，大贵。', '三命通会卷八·六己日申时断'),
('DHC_己酉_癸酉', '己酉', '癸酉', '己', '酉', '酉', '己酉日癸酉时，偏财遇食，主峥嵘。丑未子午俱吉。酉月、内戚。如年月己酉全，犯破碎煞，主一生破败，游走无结果。', '三命通会卷八·六己日酉时断'),
('DHC_己酉_甲戌', '己酉', '甲戌', '己', '酉', '戌', '己酉日甲戌时，辰丑刑冲，财源益进。酉戌相害，名利中平。子月，己贵。寅月，官印，行印运，贵。纯乙酉年月，顽暴。一云孤独离乡。', '三命通会卷八·六己日戌时断'),
('DHC_己酉_乙亥', '己酉', '乙亥', '己', '酉', '亥', '己酉日乙亥时，春夏，显达；秋，制伏太过，贫儒；冬，财旺。午巳戌年月，六、七品，贵。寅月，行金火运，四、五品，贵。', '三命通会卷八·六己日亥时断'),
('DHC_庚戌_丙子', '庚戌', '丙子', '庚', '戌', '子', '庚戌日丙子时，春夏生。西南运；秋月、木火运，俱贵。忌乙巳月，凶、破。乙亥月，官灾多，凶刑。己丑月，破败，凶。戊戌月，恶死。庚日相逢丙子时，伤官合局不为奇；双亲祖业难成就，燕寝鸾栖别立基。庚日时逢丙子，刑官背禄安身。双亲克陷早难辛，雁侣不能和顺。废学经商发福，田庄后懒先勤。家居财帛晚才成，先暗后明之命。', '三命通会卷八·六庚日子时断'),
('DHC_庚戌_丁丑', '庚戌', '丁丑', '庚', '戌', '丑', '庚戌日丁丑时，春财旺；夏官旺；秋平淡；冬无力。庚丁相合丑时全，好象明蟾耀碧天；不遇刑克真稀奇，财官兴旺更长年。庚日时逢丁丑，正官、财库相随。午未戌月福优余，庚取时逢金柜。金逢火而成器，必然荫子封妻。从来歌酒不相离，定主清闲乐意。', '三命通会卷八·六庚日丑时断'),
('DHC_庚戌_戊寅', '庚戌', '戊寅', '庚', '戌', '寅', '庚戌日戊寅时，贵。戌月，杂气财官印绶，贵。庚辰年，己卯月者，侯伯。庚日寅时甚可夸，无刑克破显忧华；运来自有高人助，时至如添锦上华。庚日戊寅时秀，编印倒食难收。少年未遇莫心忧，此命或贫或富。时至发财发福，运来顺水行舟。月中金水更相投，无破功名成就。', '三命通会卷八·六庚日寅时断'),
('DHC_庚戌_己卯', '庚戌', '己卯', '庚', '戌', '卯', '庚戌日己卯时，少孤母贱，中年贵。卯酉辰丑月，官至公卿。天元庚己卯时连，禄见文书富贵全；四柱无刑冲克破，贵人接引上青天。庚日时逢己卯，财官运气亨通。若无刑冲定褒封，有破中年不顺。雁行六亲难靠，自成家计无穷。时来发达显功名，自有高人引用。', '三命通会卷八·六庚日卯时断'),
('DHC_庚戌_庚辰', '庚戌', '庚辰', '庚', '戌', '辰', '庚戌日庚辰时，魁罡，土厚地方，官高禄重。子月、西南运，贵。寅辰年月，平常。六康时辰仔细推，辰中印库钥匙开；四柱若有冲刑字，安然福禄自天来。庚日庚辰时正，地支三合为魁。就中卯戌库门开，无破紫袍金带。巳午丙丁减副，谋为财去财来。妻重子晚命中该，富贵清闲自在。', '三命通会卷八·六庚日辰时断'),
('DHC_庚戌_辛巳', '庚戌', '辛巳', '庚', '戌', '巳', '庚戌日辛巳时，年月遇财，吉。午未，行东南运，文职操权，恐无好终。寅申、翰林宰辅；若行火运，亦难善终。庚日相逢时已生，为人福禄依稀平；刑冲破害柱如有，自立自成免祸惊。庚日时临辛巳，败财暗鬼偷寻。财去财来小人侵，祖父家基难荫。外合重行发福，兄弟雁行无音。妻迟子晚喜开心，先苦后荣之命。', '三命通会卷八·六庚日巳时断'),
('DHC_庚戌_壬午', '庚戌', '壬午', '庚', '戌', '午', '庚戌日壬午时，卯月，正财，吉。未月，杂气财官，贵。辰丑月同。壬庚会合临午，无破无冲福自来；从此名利皆有望，贵人举荐上天阶。庚日时临壬午，支中官印俱藏。贵人禄马更同乡，祸患潜消福长。克破刑冲不吉，柱中更忌空亡。将星天乙主荣昌，中暮家业兴旺。', '三命通会卷八·六庚日午时断'),
('DHC_庚戌_癸未', '庚戌', '癸未', '庚', '戌', '未', '庚戌日癸未时，戌月、东方运，贵。辰月卯年，大贵。秋生最吉。夏，须行西北运。方吉。庚日未时库有财，钥匙开处独为魁；运至财旺生官地，富贵荣华不用猜。庚日时逢癸未，喜逢丑戌荣财。伤官背禄库难开，祖业盈全有碍。父母夭孤空克，妻要迟子晚和谐。运行吉地免生灾，官旺财乡通泰。', '三命通会卷八·六庚日未时断'),
('DHC_庚戌_甲申', '庚戌', '甲申', '庚', '戌', '申', '庚戌日甲申时，寅巳午戌月，妻贤子孝，贵。《神白经》运：金水带印，主清闲之福。日禄居时喜遇申，柱中嫌巳丙和寅；时来若遇高人荐，柳红桃红万里春。庚日申时为主，是名财禄相扶。生长清闲好诗书，禀性无嗔无怒。运拙农商工贾，时来职位迁除。高人见喜小人扶，无破青云有路。', '三命通会卷八·六庚日申时断'),
('DHC_庚戌_乙酉', '庚戌', '乙酉', '庚', '戌', '酉', '庚戌日乙酉时，刑后发。寅午戌，官星明朗，贵。亥卯未，富或五、六品贵。已酉丑刃旺持权，主发迹于疆场，武臣最宜，文臣亦主掌兵权，究竟受羊刃之祸。天元化合酉时生，生月之中见土亨；荣遇财官皆显达，功名利禄沐恩荣。庚日时逢乙酉，就中合化真金。财官运步福源生，文秀聪明为甚。不遇亥子克妻；贵贱举失胸襟。凡事后吉先多凶，人品显达之命。', '三命通会卷八·六庚日酉时断'),
('DHC_庚戌_丙戌', '庚戌', '丙戌', '庚', '戌', '戌', '庚戌日丙戌时，辰戌丑未、印绶生助，吉。申子辰，偏官有制，贵。月通金气，不透壬字，行北运，贵。戌时官库最为魁，丑戌相刑库自开；初主中年无显达，没年晚景称心怀。庚日时逢丙戌，偏官仓库埋藏。就中鬼贼不相当，身弱钱财虚荡。运旺身强发福，雁行骨肉参商。妻重子晚免刑伤，老景封侯拜相。', '三命通会卷八·六庚日戌时断'),
('DHC_庚戌_丁亥', '庚戌', '丁亥', '庚', '戌', '亥', '庚戌日丁亥时，辰已午月，官煞虽混，亦主武贵。丑月，西运，郎官。辰月，西北运，方面。丁亥时逢庚日排，重重喜色照朱扉；桃红烂漫日时绽，一阵春风自显威。庚日时逢丁亥，柱中暗合三奇。要知子旺并三妻，父母雁行可美。癸已戊辛不遇，文章博览多知，无冲无破贵人提，终末亨通吉利。', '三命通会卷八·六庚日亥时断'),
('DHC_辛亥_戊子', '辛亥', '戊子', '辛', '亥', '子', '辛亥日戊子时，不贵则富。亥月，无官，伤官伤尽，发福子少。春夏，亥子丑，木火运局，金紫风宪。天元六辛子时生，春天花开灿烂明。丙已午丁如破坏，功名难望晚方成。辛日时逢戊子，六阴会合朝阳。金神印绶显威光，相助一身荣旺。已午逢之减福，丙离雁侣尊堂。妻子勤助旺家庄、无破寒门将相。', '三命通会卷八·六辛日子时断'),
('DHC_辛亥_己丑', '辛亥', '己丑', '辛', '亥', '丑', '辛亥日己丑时，寅已午月，官星明朗，立计成象。卯未，财局，富贵。未戌，冲，吉。申、子、辰月月，金水氵亟秀，佳。酉建禄、行木火运、吉。纯亥，金水氵亟秀，贵。己丑时逢辛日险，财官埋没未为奇；六亲骨肉多刑害，年月冲开富贵推。辛日时临己丑，总由倒食淹留。就中金柜紧监收，午未戌开成就。甲丙卯寅发福，癸壬亥子漂流。少年谋望事难周，中未前程自有。', '三命通会卷八·六辛日丑时断'),
('DHC_辛亥_庚寅', '辛亥', '庚寅', '辛', '亥', '寅', '辛亥日庚寅时，贵，主有暗疾。干透丙，发。午酉寅亥年月，南方运，贵。六辛之日遇寅时，财旺生官互换推；运拙利名应蹇滞，若行财禄更无虞。辛日庚寅时遇，弟兄骨肉生疏。双亲祖业靠难成，鸳侣中年违镜。亥癸坎壬减福，丙丁巳午驰名。春生冬产贵人钦，中末荣华之命。', '三命通会卷八·六辛日寅时断'),
('DHC_辛亥_辛卯', '辛亥', '辛卯', '辛', '亥', '卯', '辛亥日辛卯时，春夏，财官双美，贵显。秋冬，背禄逐马、劳碌反复。纯亥，金水氵亟秀，多发高科。辰戌，吉。丑未，尤吉。六辛遇卯禄分明，比劫逢财事不成；春夏人生财禄旺，秋冬刑害命中平。辛日时逢辛卯，二辛分夺妻财。雁行鸳侣少合谐，独立自成无碍。年月财星生旺，忻然禄自天来。运行比劫事沉埋，木火运中通泰。', '三命通会卷八·六辛日卯时断'),
('DHC_辛亥_壬辰', '辛亥', '壬辰', '辛', '亥', '辰', '辛亥日壬辰时，贵。春，财旺扶身。夏吉。秋身旺，好。冬，伤官伤尽，自立自成。卯未年月，贵。六辛日干时壬辰，锁闭财官事未能；不通钥匙兼压伏，自古难发少年人。辛日壬辰时遇，伤官伤尽为奇。祖业父母早难为，雁行分飞无意。春夏财官生旺，东南方运施为。自谋自立作家资，不得亲人之力。', '三命通会卷八·六辛日辰时断'),
('DHC_辛亥_癸巳', '辛亥', '癸巳', '辛', '亥', '巳', '辛亥日癸巳时，时日并冲，忧伤妻子。春财旺。夏，吉。秋，平。冬，凶暴。酉午年月，木火运，风宪、都堂。癸巳时逢辛日干，柱中独喜显财官；运行禄马无刑地，金榜题名步御銮。辛日时临癸巳，春生财旺基。丙丁午年最为奇，破克刑冲不利。壬癸庚申无破，功名富贵为的。妻贤子孝两相宜，刑破巳时不利。', '三命通会卷八·六辛日巳时断'),
('DHC_辛亥_甲午', '辛亥', '甲午', '辛', '亥', '午', '辛亥日甲午时，亥子年月，金水氵亟秀，文学堪夸。辰戌丑未、杂气财官，贵显。六辛日干时甲午，财神无气不相当；春生木旺财官运，一路滔滔姓字香。辛日时临甲午，妻财无气身衰。干强火旺为鬼胎，火重金柔炼坏。最忌用神伤损，金沉海底生灾。无刑无破称心怀，贵重光明广大。', '三命通会卷八·六辛日午时断'),
('DHC_辛亥_乙未', '辛亥', '乙未', '辛', '亥', '未', '辛亥日乙未时，亥卯未月，财星格。吉。秋冬，孤独。辰、丑，近侍三品。未时辛日库门开，卓立家成自发财；金木运中身旺吉，几经险遇福重来。辛日时逢乙未，库中透出偏财。运行木金忌身衰，丑戌之运通泰。经历初年发福，鸳帏抵敌无灾。荣华富贵命中排，无破为官清泰。', '三命通会卷八·六辛日未时断'),
('DHC_辛亥_丙申', '辛亥', '丙申', '辛', '亥', '申', '辛亥日丙申时，发福，防孤克带疾。通金气，主人秀丽福厚。通水气，大贵。辛日良时遇丙申，天元化合得其真；冬生若也无刑破。贵显当登要路津。辛日丙申时遇，长生禄马希奇。天元化合显光辉，职重名高威势。君子文章上立，常人荣旺家基。生时真定却无亏，运喜西南东地。', '三命通会卷八·六辛日申时断'),
('DHC_辛亥_丁酉', '辛亥', '丁酉', '辛', '亥', '酉', '辛亥日丁酉时，贵。丑寅卯酉年月；近待、金紫。酉时辛日等同论，出户相迎喜事新；不遇刑冲空克破，何愁富贵不加身。辛日时临丁酉，偏官合局相投。丙、丁重见主淹留，嗣息女多男少。祖业残花秋暮，游人皎月云收。身强官旺福优游，运至财官大有。', '三命通会卷八·六辛日酉时断'),
('DHC_辛亥_戊戌', '辛亥', '戊戌', '辛', '亥', '戌', '辛亥日戊戌时，凶狠、机谋奸猾，计较。一云凶后发。辛日戌时财库闭，如开须待丑辰来；月中甲丙天干透，富贵荣华不用猜。辛日时临戊戌，五行财禄荣昌。柱中辰、戌两相当，名曰钥匙开藏。火水光辉发达，空亡锁闭如常。运行财地并官乡，无破天然福相。', '三命通会卷八·六辛日戌时断'),
('DHC_辛亥_己亥', '辛亥', '己亥', '辛', '亥', '亥', '辛亥日己亥时，年月再亥，飞天禄马，三、四品，贵；武职极品；侯、伯。寅巳，填实，则减。子辰年月，亦吉。辛日天干己亥时，枭神背禄主灾虞；无冲发福亦不重，禄马飞天贵自殊。辛日时临己亥，枭神背禄同宫。好如缺月被云龙。壬巳甲寅无用。父母完全不睦，残花结果防风。若无克破与刑冲，飞天禄马福重。', '三命通会卷八·六辛日亥时断'),
('DHC_壬子_庚子', '壬子', '庚子', '壬', '子', '子', '壬子日庚子时，辰戌丑未月，杂气财官；巳申酉丑，印绶，居土厚分野，俱贵。寅月，金水运，近侍金紫。午月，行西运，六品，子运败凶。若纯壬子羊刃，贫凶。一云，少年富，三十五后艰辛，末大富。忌辛巳月凶恶死，辛亥月大凶，甲子月刑。', '三命通会卷八·六壬日子时断'),
('DHC_壬子_辛丑', '壬子', '辛丑', '壬', '子', '丑', '壬子日辛丑时，巳酉丑月，印绶，多受父母荫。申月，火土运，近侍有权。辰戌丑未，有官有印，丰资旷达，名播天涯。寅午戌月，财破，禄印不成局，平常。亥申年月，贵', '三命通会卷八·六壬日丑时断'),
('DHC_壬子_壬寅', '壬子', '壬寅', '壬', '子', '寅', '壬子日壬寅时，纯子，年月无午冲破，入飞天格，富贵。寅卯巳申酉戌亥年月，俱贵。', '三命通会卷八·六壬日寅时断'),
('DHC_壬子_癸卯', '壬子', '癸卯', '壬', '子', '卯', '壬子日癸卯时，子卯相刑，忧伤妻子，贵人提携，财帛盈余，敦厚之命。', '三命通会卷八·六壬日卯时断'),
('DHC_壬子_甲辰', '壬子', '甲辰', '壬', '子', '辰', '壬子日甲辰时，纯子年月，飞天禄马，无破，六卿。巳酉，大贵。亥，亦贵。', '三命通会卷八·六壬日辰时断'),
('DHC_壬子_乙巳', '壬子', '乙巳', '壬', '子', '巳', '壬子日乙巳时，贵，但难为妻子，性格刚强，不受击触。戌年月，纯煞有制，行木金运，官至三品。', '三命通会卷八·六壬日巳时断'),
('DHC_壬子_丙午', '壬子', '丙午', '壬', '子', '午', '壬子日丙午时，公直撑持，孤高而贵。年月子午，字重，水火既济，极品。', '三命通会卷八·六壬日午时断'),
('DHC_壬子_丁未', '壬子', '丁未', '壬', '子', '未', '壬子日丁未时，月通木气，贵；通金气，富，通火土气，富贵；两全不通，行火土运，亦吉。', '三命通会卷八·六壬日未时断'),
('DHC_壬子_戊申', '壬子', '戊申', '壬', '子', '申', '壬子日戊申时，羊刃带煞，贵人提携。巳午年月，近侍有权。', '三命通会卷八·六壬日申时断'),
('DHC_壬子_己酉', '壬子', '己酉', '壬', '子', '酉', '壬子日己酉时，春平，夏吉，秋常，冬旺。如卯月生，好花酒。', '三命通会卷八·六壬日酉时断'),
('DHC_壬子_庚戌', '壬子', '庚戌', '壬', '子', '戌', '壬子日庚戌时，名利进退，庚辛年月，贵。辰丑，刑冲；酉月，破害，财库得用；巳午，财官旺，俱吉。', '三命通会卷八·六壬日戌时断'),
('DHC_壬子_辛亥', '壬子', '辛亥', '壬', '子', '亥', '壬子日辛亥时，主父母不得善终，后发不富。亥卯年月，文章进身，大贵。', '三命通会卷八·六壬日亥时断'),
('DHC_癸丑_壬子', '癸丑', '壬子', '癸', '丑', '子', '癸丑日壬子时，午寅、乙丑，己丑年月，文职四五品，通身旺木气月，无戊己午巳字，显贵。未，风宪。巳午，进士。忌壬寅、乙未、庚戌月，俱刑。乙丑月，下贱。', '三命通会卷八·六癸日子时断'),
('DHC_癸丑_癸丑', '癸丑', '癸丑', '癸', '丑', '丑', '癸丑日癸丑时，丑遥巳中丙戊为财官，若生丑寅申子酉三合年月，主妻贤于孝，荣贵特达；火土运凶；金水运吉。', '三命通会卷八·六癸日丑时断'),
('DHC_癸丑_甲寅', '癸丑', '甲寅', '癸', '丑', '寅', '癸丑日甲寅时，本贵，丑中有辛金，减其分数。纯水年月，官至一品。秋生印绶，亦贵。辰月，行东运，贫下。纯申破寅，凶。', '三命通会卷八·六癸日寅时断'),
('DHC_癸丑_乙卯', '癸丑', '乙卯', '癸', '丑', '卯', '癸丑日乙卯时，辰丑月，高贵。一云：少贱中年贵。', '三命通会卷八·六癸日卯时断'),
('DHC_癸丑_丙辰', '癸丑', '丙辰', '癸', '丑', '辰', '癸丑日丙辰时，平。辰戌丑未月，财官有气，贵。', '三命通会卷八·六癸日辰时断'),
('DHC_癸丑_丁巳', '癸丑', '丁巳', '癸', '丑', '巳', '癸丑日丁巳时，先贫后富，行火水运，发达。', '三命通会卷八·六癸日巳时断'),
('DHC_癸丑_戊午', '癸丑', '戊午', '癸', '丑', '午', '癸丑日戊午时，财厚，南运主贵寿促，东运吉。', '三命通会卷八·六癸日午时断'),
('DHC_癸丑_己未', '癸丑', '己未', '癸', '丑', '未', '癸丑日己未时，高。年月俱丑，贫薄。辰戌丑未，土旺，主目疾、贫贱。通金木水气，贵。午月，东北运，六七品贵。', '三命通会卷八·六癸日未时断'),
('DHC_癸丑_庚申', '癸丑', '庚申', '癸', '丑', '申', '癸丑日庚申时，辰戌丑未年月，文章冠世，官至三品。子月坐禄，亦吉。', '三命通会卷八·六癸日申时断'),
('DHC_癸丑_辛酉', '癸丑', '辛酉', '癸', '丑', '酉', '癸丑日辛酉时，秋月，印绶格，行官煞运，吉。冬，福禄双全。子寅年月，干头无戊己字，贵。', '三命通会卷八·六癸日酉时断'),
('DHC_癸丑_壬戌', '癸丑', '壬戌', '癸', '丑', '戌', '癸丑日壬戌时，刑，亥月，土厚地方上贵。辰申年月，南方运，状元。五月，南运，都宪。若春秋生，南方运，八九品。', '三命通会卷八·六癸日戌时断'),
('DHC_癸丑_癸亥', '癸丑', '癸亥', '癸', '丑', '亥', '癸丑日癸亥时，作拱禄格。巳酉丑生，福德秀气。午月平常。卯酉月，行南运，金紫风宪，但难为寿。', '三命通会卷八·六癸日亥时断'),
('DHC_甲寅_甲子', '甲寅', '甲子', '甲', '寅', '子', '甲寅日甲子时，拱丑中辛，贵。年月无庚辛申酉丑未，大贵。再甲寅月，孤克，惟憎道可。亥子年月，四品贵。午月，行东北方运，亦贵。如酉丑巳等月，明有官煞，柱但有印，俱贵。卯未，身太旺，未免刑伤。乙巳月，受刑。丁亥月，旺中恶死。', '三命通会卷八·六甲日子时断'),
('DHC_甲寅_乙丑', '甲寅', '乙丑', '甲', '寅', '丑', '甲寅日乙丑时，春贫，秋贵，冬富，夏火制金神，吉。', '三命通会卷八·六甲日丑时断'),
('DHC_甲寅_丙寅', '甲寅', '丙寅', '甲', '寅', '寅', '甲寅日丙寅时，年月无巳酉辛丑字，是归禄格，位至一二品。纯木火带土，富贵双全，六卿之职。丙子及亥未，卯月，四五品贵；行西南方运，最吉。亦有酉、丑月贵者，看干透及年何如。', '三命通会卷八·六甲日寅时断'),
('DHC_甲寅_丁卯', '甲寅', '丁卯', '甲', '寅', '卯', '甲寅日丁卯时，年月木火相停，通明之象，贵。月令坐丑、未贵。乙亥月，文章冠世，官至三品，干支金水全，官印双显贵。', '三命通会卷八·六甲日卯时断'),
('DHC_甲寅_戊辰', '甲寅', '戊辰', '甲', '寅', '辰', '甲寅日戊辰时，龙吟虎啸格，贵。纯辰，中贵。纯寅康寿。亥卯未三合，财旺身强，大贵。酉丑申年月亦吉。', '三命通会卷八·六甲日辰时断'),
('DHC_甲寅_己巳', '甲寅', '己巳', '甲', '寅', '巳', '甲寅日己巳时，时日相刑，忧伤妻子。生火年月，有明断之才，掌兵权之职。戊子年月，承袭祖荫，主富。', '三命通会卷八·六甲日巳时断'),
('DHC_甲寅_庚午', '甲寅', '庚午', '甲', '寅', '午', '甲寅日庚午时，春月有寿。夏月伤官伤尽，财源进退。申有权，酉反复。冬月伤妻子。子未年月煞助印生，四品。', '三命通会卷八·六甲日午时断'),
('DHC_甲寅_辛未', '甲寅', '辛未', '甲', '寅', '未', '甲寅日辛未时，寅申月贵。纯酉丑年月，大贵。', '三命通会卷八·六甲日未时断'),
('DHC_甲寅_壬申', '甲寅', '壬申', '甲', '寅', '申', '甲寅日壬申时，旺中有失。辰戌丑未月勾陈得位；寅、午、戌月，偏官有制；秋月，行东南运，俱贵。', '三命通会卷八·六甲日申时断'),
('DHC_甲寅_癸酉', '甲寅', '癸酉', '甲', '寅', '酉', '甲寅日癸酉时，春生寿，夏反复。秋性不定，多凶。冬平常。丑未月贵。', '三命通会卷八·六甲日酉时断'),
('DHC_甲寅_甲戌', '甲寅', '甲戌', '甲', '寅', '戌', '甲寅日甲戌时，比肩争禄，木气遭焚，四十后渐不如前。甲丙申子年月，大贵。纯戌风宪，午月，行水火运，七八品贵。', '三命通会卷八·六甲日戌时断'),
('DHC_甲寅_乙亥', '甲寅', '乙亥', '甲', '寅', '亥', '甲寅日乙亥时，辰戌丑未月，富。申酉月，贵，冬，平常。若寅亥月，高贵。', '三命通会卷八·六甲日亥时断'),
('DHC_乙卯_丙子', '乙卯', '丙子', '乙', '卯', '子', '乙卯日丙子时，高。辰戌丑未亥年月，不见官星，贵。', '三命通会卷八·六乙日子时断'),
('DHC_乙卯_丁丑', '乙卯', '丁丑', '乙', '卯', '丑', '乙卯日丁丑时，亥月，身旺见辛偏官，柱有丁制，风宪武职。', '三命通会卷八·六乙日丑时断'),
('DHC_乙卯_戊寅', '乙卯', '戊寅', '乙', '卯', '寅', '乙卯日戊寅时，刑中发福。秋生贵。酉年遇辰戌丑未月，富。卯月建禄，午月印生，透官印，俱吉。', '三命通会卷八·六乙日寅时断'),
('DHC_乙卯_己卯', '乙卯', '己卯', '乙', '卯', '卯', '乙卯日己卯时高，春生旺，为僧道，富足。夏平常，不见辛金，吉。秋带疾。冬温厚。卯丑年月，显达高寿。', '三命通会卷八·六乙日卯时断'),
('DHC_乙卯_庚辰', '乙卯', '庚辰', '乙', '卯', '辰', '乙卯日庚辰时，富贵。通火土年月，大贵。', '三命通会卷八·六乙日辰时断'),
('DHC_乙卯_辛巳', '乙卯', '辛巳', '乙', '卯', '巳', '乙卯日辛巳时，春生，身强煞浅，大贵。夏平常。秋，官煞旺；冬，印绶旺，俱吉。秋不如冬。', '三命通会卷八·六乙日巳时断'),
('DHC_乙卯_壬午', '乙卯', '壬午', '乙', '卯', '午', '乙卯日壬午时高，丑月，入杂气财官；申酉月，身煞两停，俱主显贵。纯午酉年月，三四品；辰戌，平常。', '三命通会卷八·六乙日午时断'),
('DHC_乙卯_癸未', '乙卯', '癸未', '乙', '卯', '未', '乙卯日癸未时，改祖离亲，就妻为家。午未年月，贵。春尤贵。', '三命通会卷八·六乙日未时断'),
('DHC_乙卯_甲申', '乙卯', '甲申', '乙', '卯', '申', '乙卯日甲申时，化贵。月通水气无伤破者，贵，不然，富。', '三命通会卷八·六乙日申时断'),
('DHC_乙卯_乙酉', '乙卯', '乙酉', '乙', '卯', '酉', '乙卯日乙酉时，月通金局者贵。未寅年月，官至一二品。', '三命通会卷八·六乙日酉时断'),
('DHC_乙卯_丙戌', '乙卯', '丙戌', '乙', '卯', '戌', '乙卯日丙戌时，寅卯月，运西运，六七品贵。子月印绶；丑月杂气，刑出财官，俱贵。', '三命通会卷八·六乙日戌时断'),
('DHC_乙卯_丁亥', '乙卯', '丁亥', '乙', '卯', '亥', '乙卯日丁亥时，巳酉丑月偏官，申月正官，俱贵。亥月，东南运，风宪。未月，三合木局，大贵。', '三命通会卷八·六乙日亥时断'),
('DHC_丙辰_戊子', '丙辰', '戊子', '丙', '辰', '子', '丙辰日戊子时，丙辰为日德格，喜见官星。若生戌月，身旺最宜，武贵。寅月，行金水运，中贵。申月三合，合煞有印，贵。忌己巳月，凶死；己亥月，自刑死；癸丑月，破祖恶死。', '三命通会卷八·六丙日子时断'),
('DHC_丙辰_己丑', '丙辰', '己丑', '丙', '辰', '丑', '丙辰日己丑时，申亥年月，化水则吉；不化寿促，戌月冲库，无人不发。寅午身旺，成火上格，大贵。', '三命通会卷八·六丙日丑时断'),
('DHC_丙辰_庚寅', '丙辰', '庚寅', '丙', '辰', '寅', '丙辰日庚寅时，生寅午戌未年月，妻贤子孝，富贵双全。申子，行北运，大贵。酉丑，富。', '三命通会卷八·六丙日寅时断'),
('DHC_丙辰_辛卯', '丙辰', '辛卯', '丙', '辰', '卯', '丙辰日辛卯时，生寅戌月，天月二德，高。巳月，行北方运，贵。酉丑亦贵。亥卯未，大贵。', '三命通会卷八·六丙日卯时断'),
('DHC_丙辰_壬辰', '丙辰', '壬辰', '丙', '辰', '辰', '丙辰日壬辰时，身孤有财，主恶死。春生，行北运；夏，东运，俱贵。秋，南运，官至三品。', '三命通会卷八·六丙日辰时断'),
('DHC_丙辰_癸巳', '丙辰', '癸巳', '丙', '辰', '巳', '丙辰日癸巳时，不利祖宗。酉戌寅丑年月，魁罡格，通身旺，贵。', '三命通会卷八·六丙日巳时断'),
('DHC_丙辰_甲午', '丙辰', '甲午', '丙', '辰', '午', '丙辰日甲午时，寅卯印助，申酉印旺，巳午身旺，亥子官旺，俱吉。然以火土为重，无则福薄。未戌辰丑见，吉。', '三命通会卷八·六丙日午时断'),
('DHC_丙辰_乙未', '丙辰', '乙未', '丙', '辰', '未', '丙辰日乙未时，春吉，夏平稳，秋劳碌，冬贵显。巳午月，行西北运，六七品贵。', '三命通会卷八·六丙日未时断'),
('DHC_丙辰_丙申', '丙辰', '丙申', '丙', '辰', '申', '丙辰日丙申时，寅月，行南运，贵。子，三合官局，天干透印，大贵。亥生透壬，多夭。戌未，平常。', '三命通会卷八·六丙日申时断'),
('DHC_丙辰_丁酉', '丙辰', '丁酉', '丙', '辰', '酉', '丙辰日丁酉时，寅午戌巳年月，干透煞印者贵。申子会官，干透印比者贵。如年月火土，宜见财则吉。', '三命通会卷八·六丙日酉时断'),
('DHC_丙辰_戊戌', '丙辰', '戊戌', '丙', '辰', '戌', '丙辰日戊戌时，午月，丙火有气，土厚地方，五六品贵。亥月，金火运，风宪。', '三命通会卷八·六丙日戌时断'),
('DHC_丙辰_己亥', '丙辰', '己亥', '丙', '辰', '亥', '丙辰日己亥时，日德格。寅月生，吉，辰月，为僧道主富，平人孤克。戌月冲辰，巳月冲亥，丙旺库，俱吉。卯未会，行金水运，申子会，行木火运，俱贵。', '三命通会卷八·六丙日亥时断'),
('DHC_丁巳_庚子', '丁巳', '庚子', '丁', '巳', '子', '丁巳日庚子时，春旺，夏强，俱贵。秋冬平常。四季月，制伏得中吉。子辰，行西运，四五品贵。', '三命通会卷八·六丁日子时断'),
('DHC_丁巳_辛丑', '丁巳', '辛丑', '丁', '巳', '丑', '丁巳日辛丑时，因阴人致贵。巳酉丑申年月，财旺生官，富贵。卯月平常，行此运亦贵。丑月，西南运，大贵。', '三命通会卷八·六丁日丑时断'),
('DHC_丁巳_壬寅', '丁巳', '壬寅', '丁', '巳', '寅', '丁巳日壬寅时，丁死于寅，巳无生意，又被寅刑，有始无终，若行金水运，荣贵。寅午年月，身旺；申子辰，官旺；亥卯未，印旺，俱可言贵。', '三命通会卷八·六丁日寅时断'),
('DHC_丁巳_癸卯', '丁巳', '癸卯', '丁', '巳', '卯', '丁巳日癸卯时，丑月生，北方运，土厚地方，吉；水秀之地，二三品贵。申酉，用财亦吉。', '三命通会卷八·六丁日卯时断'),
('DHC_丁巳_甲辰', '丁巳', '甲辰', '丁', '巳', '辰', '丁巳日甲辰时，凶刑孤克。春印吉。夏秋平常。冬官旺。纯戌，木火运，官居冷职。', '三命通会卷八·六丁日辰时断'),
('DHC_丁巳_乙巳', '丁巳', '乙巳', '丁', '巳', '巳', '丁巳日乙巳时，再生巳月，倒冲，亥壬为官，无水填实破格者，主四五品贵。', '三命通会卷八·六丁日巳时断'),
('DHC_丁巳_丙午', '丁巳', '丙午', '丁', '巳', '午', '丁巳日丙午时，丁禄午，丙禄巳，互换禄格，柱无寅亥子字，文章显贵。', '三命通会卷八·六丁日午时断'),
('DHC_丁巳_丁未', '丁巳', '丁未', '丁', '巳', '未', '丁巳日丁未时，拱禄格贵。年有子字，则午为阙门，得拱大贵。忌空亡填实。年月见财官印，俱吉；财，富；官印，贵。', '三命通会卷八·六丁日未时断'),
('DHC_丁巳_戊申', '丁巳', '戊申', '丁', '巳', '申', '丁巳日戊申时，不贵即富，未免刑克。夏生，行西北运，贵，秋冬，劳苦。', '三命通会卷八·六丁日申时断'),
('DHC_丁巳_己酉', '丁巳', '己酉', '丁', '巳', '酉', '丁巳日己酉时，巳酉丑年月，财旺生官，终身富贵。亥子亦吉。', '三命通会卷八·六丁日酉时断'),
('DHC_丁巳_庚戌', '丁巳', '庚戌', '丁', '巳', '戌', '丁巳日庚戌时，辰巳月，金水运，风宪。癸子、壬亥，南方运，极品。纯未，西北运，三四品；身旺不行财官运，平常，为僧道清高。', '三命通会卷八·六丁日戌时断'),
('DHC_丁巳_辛亥', '丁巳', '辛亥', '丁', '巳', '亥', '丁巳日辛亥时，时日相冲，忧伤妻子。若通火气，秋生，行东运，贵。辛月得巳亥者，破祖显秀。', '三命通会卷八·六丁日亥时断'),
('DHC_戊午_壬子', '戊午', '壬子', '戊', '午', '子', '戊午日壬子时，时日并冲，忧伤妻子。巳午年月，风宪。寅卯亥，六卿。申月，行木火运，侯伯。忌丙午月，身不全；癸亥，自刑夭。年月子午不杂，丑戌又刑，俱主大贵。', '三命通会卷八·六戊日子时断'),
('DHC_戊午_癸丑', '戊午', '癸丑', '戊', '午', '丑', '戊午日癸丑时，寅戌未午年月，聪明特达威权。', '三命通会卷八·六戊日丑时断'),
('DHC_戊午_甲寅', '戊午', '甲寅', '戊', '午', '寅', '戊午日甲寅时，曰羊刃，时偏官，以刃合煞，贵。巳酉丑月，刀笔惊人，制伏不宜太过；寅卯辰巳戌子年月，天干有制伏，俱主大贵。', '三命通会卷八·六戊日寅时断'),
('DHC_戊午_乙卯', '戊午', '乙卯', '戊', '午', '卯', '戊午日乙卯时，刃格，正官去刃为福，子寅卯辰午未申亥年月，俱主贵显。', '三命通会卷八·六戊日卯时断'),
('DHC_戊午_丙辰', '戊午', '丙辰', '戊', '午', '辰', '戊午日丙辰时，亥卯年月，行东北运，富贵。未丑，行西南运，风宪。', '三命通会卷八·六戊日辰时断'),
('DHC_戊午_丁巳', '戊午', '丁巳', '戊', '午', '巳', '戊午日丁巳时，柱无甲乙卯寅，日禄归时格，又戊禄居时，丁禄居日，为互换禄，高贵；行伤食印运，吉；有甲乙寅卯未字，作官印取用亦贵。', '三命通会卷八·六戊日巳时断'),
('DHC_戊午_戊午', '戊午', '戊午', '戊', '午', '午', '戊午日戊午时，先刑后发，多不善终。寅巳午戌年月，印绶，大贵。纯午，武职威权，名重镇藩。亥卯未申，富贵双全。', '三命通会卷八·六戊日午时断'),
('DHC_戊午_己未', '戊午', '己未', '戊', '午', '未', '戊午日己未时，羊刃偏官，主人机谋，寿促，不然，妻子难为重立重成。午亥年月，金土运，贵；申酉，富。', '三命通会卷八·六戊日未时断'),
('DHC_戊午_庚申', '戊午', '庚申', '戊', '午', '申', '戊午日庚申时，未酉丑年月，柱无丙甲卯寅，入合禄格，行西北运，贵；有甲丙又合神藏煞没，四柱纯阳格，大贵。', '三命通会卷八·六戊日申时断'),
('DHC_戊午_辛酉', '戊午', '辛酉', '戊', '午', '酉', '戊午日辛酉时，春夏平常。秋，伤官伤尽，权贵寿促。冬，难为妻子。', '三命通会卷八·六戊日酉时断'),
('DHC_戊午_壬戌', '戊午', '壬戌', '戊', '午', '戌', '戊午日壬戌时，寅午戌月生，时岁火多，以印绶论，未免孤克，先难后易，不贵即富。卯月，官星制刃，吉。', '三命通会卷八·六戊日戌时断'),
('DHC_戊午_癸亥', '戊午', '癸亥', '戊', '午', '亥', '戊午日癸亥时，贵。寅巳年月，土厚水秀地方，六七品贵。卯未辰丑，俱吉。', '三命通会卷八·六戊日亥时断'),
('DHC_己未_甲子', '己未', '甲子', '己', '未', '子', '己未日甲子时，高身坐官库，辰戌丑未月，吉。寅亥月，官旺，文章振发，贵显易成。巳丑，文贵晚成。寅卯，贫下。忌甲申月，身不完死。丙子月，孤贫。丁丑月，刑害。', '三命通会卷八·六己日子时断'),
('DHC_己未_乙丑', '己未', '乙丑', '己', '未', '丑', '己未日乙丑时，时日并冲，妻生财可也。卯午年月，金神入火乡，西南运，贵。辰戌四季全，大贵。干透丁辛，纯阴亦贵。', '三命通会卷八·六己日丑时断'),
('DHC_己未_丙寅', '己未', '丙寅', '己', '未', '寅', '己未日丙寅时，生土厚地，方贵。水木年月，行东北运，贵。一云多庶出过房，或父不见生。', '三命通会卷八·六己日寅时断'),
('DHC_己未_丁卯', '己未', '丁卯', '己', '未', '卯', '乙未日丁卯时，不贵则富；卯戌亥丑年月，吉。', '三命通会卷八·六己日卯时断'),
('DHC_己未_戊辰', '己未', '戊辰', '己', '未', '辰', '己未日戊辰时，丑月，杂气财官，吉。寅辰巳亥午戌年月，文章贵显。', '三命通会卷八·六己日辰时断'),
('DHC_己未_己巳', '己未', '己巳', '己', '未', '巳', '己未日己巳时，拱禄格。若无羊刃七煞，午字填实，不犯空亡，主显贵。亥丑辰申年月，行东运，文武极品。此格不如丁巳、丁未，以丁正禄，巳寄禄故也。', '三命通会卷八·六己日巳时断'),
('DHC_己未_庚午', '己未', '庚午', '己', '未', '午', '己未日庚午时，背禄伤官，六亲刑克；无破，晚年发旺。未戌年月，贵。', '三命通会卷八·六己日午时断'),
('DHC_己未_辛未', '己未', '辛未', '己', '未', '未', '己未日辛未时，春夏、丑月，丰姿特达，言语清辨，名高禄重。秋冬，平常。木火运，刑害发财。一云财中自害。', '三命通会卷八·六己日未时断'),
('DHC_己未_壬申', '己未', '壬申', '己', '未', '申', '己未日壬申时，巳月生，贯朽粟陈。亥子寅月，金火运，侯伯。辰亥年月，近侍，贵。', '三命通会卷八·六己日申时断'),
('DHC_己未_癸酉', '己未', '癸酉', '己', '未', '酉', '己未日癸酉时，戌亥丑辰年月，西方运，贵。子巳大贵。卯、辰，近侍不大。', '三命通会卷八·六己日酉时断'),
('DHC_己未_甲戌', '己未', '甲戌', '己', '未', '戌', '己未日甲戌时，克陷遭刑。寅午年月，三、四品，贵。戌月、东南运，五品。纯辛卯年月，刑。', '三命通会卷八·六己日戌时断'),
('DHC_己未_乙亥', '己未', '乙亥', '己', '未', '亥', '己未日乙亥时，无刑破混杂，清高、富贵，文学堪夸。', '三命通会卷八·六己日亥时断'),
('DHC_庚申_丙子', '庚申', '丙子', '庚', '申', '子', '庚申日丙子时，申月，生土厚地方，贵。辰未年月，行西运金，方吉。辛巳月，凶刑。辛亥月，孤夭。', '三命通会卷八·六庚日子时断'),
('DHC_庚申_丁丑', '庚申', '丁丑', '庚', '申', '丑', '庚申日丁丑时，丑月，金火运，极品。辰巳午未戌月，官印两旺，贵。申、酉，身太旺，须行木火。寅、卯，财太旺，须行金水。亥子，金寒水冷，须行火土运，贵。', '三命通会卷八·六庚日丑时断'),
('DHC_庚申_戊寅', '庚申', '戊寅', '庚', '申', '寅', '庚申日戊寅时，时日并冲，忧伤妻子。寅卯辰月、火金运。侯伯。春月、西南运，大贵。寅月，贵显不久。一云先刑后吉。', '三命通会卷八·六庚日寅时断'),
('DHC_庚申_己卯', '庚申', '己卯', '庚', '申', '卯', '庚申日己卯时，卯月，财星格，不贵即富。丑巳年月，翰林清贵，官至亚卿。一云少贫，中年有小灾，克妻少子。', '三命通会卷八·六庚日卯时断'),
('DHC_庚申_庚辰', '庚申', '庚辰', '庚', '申', '辰', '庚申日庚辰时，子、申年月入井栏叉。柱、运不逢丙丁巳午字，贵。纯庚申、庚辰，行西北东运，武职极品。', '三命通会卷八·六庚日辰时断'),
('DHC_庚申_辛巳', '庚申', '辛巳', '庚', '申', '巳', '庚申日辛巳时，刑。巳酉丑月，特达。春夏，木火旺，财官得地，吉。辰戌丑未，印绶，行南运，贵。', '三命通会卷八·六庚日巳时断'),
('DHC_庚申_壬午', '庚申', '壬午', '庚', '申', '午', '庚申日壬午时，禄马同乡，最吉。如午未年月，位至台阁。卯辰已，贵。戌月、行火土运，清虚冷职。', '三命通会卷八·六庚日午时断'),
('DHC_庚申_癸未', '庚申', '癸未', '庚', '申', '未', '庚申日癸未时，酉月，武贵，初年剥权。年月寅午戌、申子辰二局相参，贵。', '三命通会卷八·六庚日未时断'),
('DHC_庚申_甲申', '庚申', '甲申', '庚', '申', '申', '庚申日甲申时，贵。无卯午未戌丙丁字，贵。子丑月，金水运，文贵。余见庚申、甲申，专禄归禄。坚金非火不能锻炼，故巳午戌月生者，多贵。看归禄有七法，勿以为嫌。财月最吉。', '三命通会卷八·六庚日申时断'),
('DHC_庚申_乙酉', '庚申', '乙酉', '庚', '申', '酉', '庚申日乙酉时，真刑。寅午戌，大贵。已酉丑，中贵。申子辰，富。亥卯未，凋零，一云财吉。', '三命通会卷八·六庚日酉时断'),
('DHC_庚申_丙戌', '庚申', '丙戌', '庚', '申', '戌', '庚申日丙戌时，戌亥年月，东南运，贵。申月，大贵。', '三命通会卷八·六庚日戌时断'),
('DHC_庚申_丁亥', '庚申', '丁亥', '庚', '申', '亥', '庚申日丁亥时，秋生，南运，贵显；北运，平常。', '三命通会卷八·六庚日亥时断'),
('DHC_辛酉_戊子', '辛酉', '戊子', '辛', '酉', '子', '辛酉日戊子时，子酉月生，无丙丁火，不行南运，三、四品贵。伤妻子；武职权重。《神白经》云：金火化，主贵，破祖方发。忌壬寅月，凶死。辛已月，大败，祖凶。庚戌月，凶死。六辛日见戊子时，谓之天庭清显气。辛酉辛亥得之，最高。忌丙寅月，死不全尸。丙申月，失乡恶死。丁酉月，失亡恶死。', '三命通会卷八·六辛日子时断'),
('DHC_辛酉_己丑', '辛酉', '己丑', '辛', '酉', '丑', '辛酉日己丑时，破祖。已酉丑月，金多克木，俊俏有财，难为妻子。寅午月，近侍，贵。', '三命通会卷八·六辛日丑时断'),
('DHC_辛酉_庚寅', '辛酉', '庚寅', '辛', '酉', '寅', '辛酉日庚寅时，贵。春财聚；夏官禄成；秋身旺；亥子丑戌午酉等年月，俱贵。', '三命通会卷八·六辛日寅时断'),
('DHC_辛酉_辛卯', '辛酉', '辛卯', '辛', '酉', '卯', '辛酉日辛卯时，出身孤苦，中年获福，末年封妻荫子，贵。巳月，官印逢天德，贵当一品。丑月、木火运、中贵。申酉亥年月，东南运，风宪。', '三命通会卷八·六辛日卯时断'),
('DHC_辛酉_壬辰', '辛酉', '壬辰', '辛', '酉', '辰', '辛酉日壬辰时，春，富贵双全。夏好。秋身旺，贵。冬，白丁；子月，辛生地，学堂，主文学。年月火济，贵。甲戌月，三品。', '三命通会卷八·六辛日辰时断'),
('DHC_辛酉_癸巳', '辛酉', '癸巳', '辛', '酉', '巳', '辛酉日癸巳时，贵显，酒色重。寅卯，财旺，吉。丑，三合全，富贵。', '三命通会卷八·六辛日巳时断'),
('DHC_辛酉_甲午', '辛酉', '甲午', '辛', '酉', '午', '辛酉日甲午时，春，财旺；夏，官贵，俱吉。秋，身强，虽富不永，冬，平常。', '三命通会卷八·六辛日午时断'),
('DHC_辛酉_乙未', '辛酉', '乙未', '辛', '酉', '未', '辛酉日乙未时，月通火气，行东运，贵。辰戌丑未，最吉。亥卯，贵显不久。秋生，身太旺，财官无气，凶夭。', '三命通会卷八·六辛日未时断'),
('DHC_辛酉_丙申', '辛酉', '丙申', '辛', '酉', '申', '辛酉日丙申时，寅巳午戌月，官旺，荣贵。《神白经》云：水化主贵。', '三命通会卷八·六辛日申时断'),
('DHC_辛酉_丁酉', '辛酉', '丁酉', '辛', '酉', '酉', '辛酉日丁酉时，年月通金气，吉。丑月，西方运，风宪。寅午戌，贵。', '三命通会卷八·六辛日酉时断'),
('DHC_辛酉_戊戌', '辛酉', '戊戌', '辛', '酉', '戌', '辛酉日戊戌时，凶刑。巳酉丑辰戌未年月，魁元，卿、尹之命。', '三命通会卷八·六辛日戌时断'),
('DHC_辛酉_己亥', '辛酉', '己亥', '辛', '酉', '亥', '辛酉日己亥时，辰戌丑未、杂气财官，吉。纯亥，冲巳中丙火为官，贵。', '三命通会卷八·六辛日亥时断'),
('DHC_壬戌_庚子', '壬戌', '庚子', '壬', '戌', '子', '壬戌日庚子时，夭。丑月金火运，辰未财官格，俱贵。寅酉，行西北运，贵。申子辰，行东南运，极品。忌巳酉月，孤单凶；丁亥月，凶刑恶死；辛丑月，刑。天干壬日时庚子，枭日由来遇劫财；运弱妻儿防克害，运强财禄自天来。壬日时逢庚子，劫财倒食流连，运行比劫事忧煎，财禄不能通显。雁侣双亲失意，妻儿迟则团圆，财官运步福滔然，祖业从新改变。', '三命通会卷八·六壬日子时断'),
('DHC_壬戌_辛丑', '壬戌', '辛丑', '壬', '戌', '丑', '壬戌日辛丑时，辰月，冲开财官，贵。丑戌，亦吉。柱有乙癸卯字，平常。六壬日干辛丑时，官印相生事事奇；午月更通金土旺，为官清贵定无移。壬日时临辛丑，财官印绶其中，要知开库钥匙通，戊己相逢火重。癸卯乙字减福，有遇龙虎相冲，只争迟早改门风，富贵承恩拜宠。', '三命通会卷八·六壬日丑时断'),
('DHC_壬戌_壬寅', '壬戌', '壬寅', '壬', '戌', '寅', '壬戌日壬寅时，巳月，偏官格，名标金榜，身坐玉堂。纯子，三品，寅卯，行北运，风宪。又，六壬日见壬寅时，名白太虚贵，不久，盛而祸生。六壬逢虎是浮沤，富贵功名莫强求；有印有官为上格，骤然财禄免忧愁。壬日壬寅时遇，比肩相遇食神，弟兄雁侣少同群，此是生时定分。坐局运行官地，身强禄位超伦，身衰刑害祸相侵，衣禄平常之命。', '三命通会卷八·六壬日寅时断'),
('DHC_壬戌_癸卯', '壬戌', '癸卯', '壬', '戌', '卯', '壬戌日癸卯时，甲癸午酉年月，文贵。申，平常，金火运，贵。壬癸相逢见卯贵，刑冲破害不周全。月逢二德兼身旺，改祸为祥乐自然。壬日时临癸卯，败财背禄相逐，平生反复事疑迟，水到东方失位。须有贵人救助，自身文福难齐，祖财骨肉有盈亏，命主晚成先废。', '三命通会卷八·六壬日卯时断'),
('DHC_壬戌_甲辰', '壬戌', '甲辰', '壬', '戌', '辰', '壬戌日甲辰时，寅申酉月，行南运，贵戚。亥卯未申子辰巳午年月，俱吉。时遇甲辰壬日干，喜神重叠福多端；时来早晚功名就，运至申辰作显官。壬日甲辰时好，青龙入庙为高，犹如兰蕙出蓬蒿，水木滋生荣茂。时日冲开库旺，自然成就窝巢，运行吉地逞英豪，贵显亲人难靠。', '三命通会卷八·六壬日辰时断'),
('DHC_壬戌_乙巳', '壬戌', '乙巳', '壬', '戌', '巳', '壬戌日乙巳时，寅年月，入日德格，贵。辰戌丑未，贵。秋印，夏财官，俱吉，春伤、冬旺，看干透何如，亦可取贵。壬日时逢乙巳临，谋为未遇且沈吟：贵人举荐财官旺，子嗣鸳帏不一心。壬日时临乙巳，伤官背禄无取，虽然天乙贵人扶，贵显遇而不遇。谋望云为反覆，生平实事成虚，时来发达改门闾，犹似旱苗得雨。', '三命通会卷八·六壬日巳时断'),
('DHC_壬戌_丙午', '壬戌', '丙午', '壬', '戌', '午', '壬戌日丙午时，寅月，三合财局，弃命相从，富。秋，身有托，贵。冬亦吉。丙午时生壬日强，时中禄马不寻常；运行吉地无冲破，早晚升迁到省堂。壬日时逢丙午，亦名禄马同乡，就中既济见文章，志气宽洪海量。不过刑冲破害，自然财禄盈箱。运行财旺及官乡，定是朝中宰相。', '三命通会卷八·六壬日午时断'),
('DHC_壬戌_丁未', '壬戌', '丁未', '壬', '戌', '未', '壬戌日丁未时，日德，封妻荫子，中年又损妻子。亥子申酉月，贵。巳午，不贵即富。辰月夭，月德贵。壬日时逢丁未临，木化成林忌见金；年月若还无破害，必教富贵福弥深。壬日时临丁来，就中暗合妻财，好来丑戌钥匙开，收积钱财广大。年月克冲不犯，天然衣禄安排，鸳帏子息早年乖，中末依然享泰。', '三命通会卷八·六壬日未时断'),
('DHC_壬戌_戊申', '壬戌', '戊申', '壬', '戌', '申', '壬戌日戊申时，破滞多蹇。纯酉，巨富。若不通身旺月，行煞旺乡，不吉。有甲制亦可。戊己土重，主瞎疾平常。申时壬戌合天元，运去财官福自然；鬼旺身衰无救助，平生劳碌不周全。壬日戊申时显，支干煞旺双全，喜逢辰子两相连，正合衣锦局面。被害刑冲克战，就中文福艰难，运行吉地紫泥宣，富贵妻多子健。', '三命通会卷八·六壬日申时断'),
('DHC_壬戌_己酉', '壬戌', '己酉', '壬', '戌', '酉', '壬戌日己酉时，亥寅子月，行财官运，贵显非常。纯亥，文贵。天干壬日酉时真，改祸为祥遇贵人；若不为官封品级，晚年享福旺家门。壬日时逢己酉，正官印绶无偏，荣枯贵贱是因缘，人自生成便见。乙癸卯冲破克，驳杂财官减半，遭富贵不双全，差了生时难辩。', '三命通会卷八·六壬日酉时断'),
('DHC_壬戌_庚戌', '壬戌', '庚戌', '壬', '戌', '戌', '壬戌日庚戌时，不利妻，主被妻妾害，反覆成败。纯戌，贵。寅丑，武职。申月，长生学堂，修文多贵。亥月，建禄，干透财官；卯月，伤官，干透财星，俱贵。未月，杂气财官，丑戌相刑。吉。壬庚相逢戌时生，库有财官锁闭门；究竟无头多反覆，功名到底似浮云。壬日时逢庚戌，支干倒食难容。财官印绶库内封，无钥不能取用。丑酉辰逢作福，更逢丁己成名，但怕克害过刑冲，驳杂如常之命。', '三命通会卷八·六壬日戌时断'),
('DHC_壬戌_辛亥', '壬戌', '辛亥', '壬', '戌', '亥', '壬戌日辛亥时，少年富贵。亥申巳戌年月，一二品贵。纯戌，水火运，金紫。壬辛会遇亥时推，白玉休嫌出见迟；长生禄马无刑破，抛却麻衣挂紫衣。壬日时临禄马，又为印绶同乡，水从金木自然强，此命极高为上。癸乙暗合咸福，无冲破显文章，积玉堆金满屋堂，荫子封妻之象。', '三命通会卷八·六壬日亥时断'),
('DHC_癸亥_壬子', '癸亥', '壬子', '癸', '亥', '子', '癸亥日壬子时，贵。亥月生，飞天禄马，登科甲第，大贵。又癸禄居子，壬禄居亥，日时互换，三四品贵。忌戊寅月，死不全尸；戊申月孤贫；己酉月孤苦。日禄归时局中得，食神喜遇怕刑冲；伤官莫道伤财运，官不加兮财不丰。癸日时临壬子，名为归禄格同，家门白屋也峥嵘，玄武当权禄重。水清宝瓶益盛，文章博览多通，荣迁来历紫薇封，甲午寅亥破动。', '三命通会卷八·六癸日子时断'),
('DHC_癸亥_癸丑', '癸亥', '癸丑', '癸', '亥', '丑', '癸亥日癸丑时，拱禄格，怕冲破、填实，柱无子巳午未字，大贵。寅午戌月，南方运，六七品。阴水重重时库收，少年难发莫强求；(cid:939)来受过中年后，安坐高堂任白头。癸日时逢癸丑，水流金局盈冲，库逢戌未禄财丰，不过空乏难动。无匙少年不显，有匙禄马和同，运来何用苦劳心，发达门庭大庆。', '三命通会卷八·六癸日丑时断'),
('DHC_癸亥_甲寅', '癸亥', '甲寅', '癸', '亥', '寅', '癸亥日甲寅时，子丑未申月，进士，运行金水，风宪。卯戌年月，地支六合，贵。甲寅癸日戊丙开，少年未遇且沉埋；若还四柱无冲破，平步登云到省台。癸日寅时克应，支干相合光荣，若无壬己戊庚申，必然财禄丰润。运至皇州显达，文章虎榜标名，但逢一字稍空冲，克子伤食剥俸。', '三命通会卷八·六癸日寅时断'),
('DHC_癸亥_乙卯', '癸亥', '乙卯', '癸', '亥', '卯', '癸亥日乙卯时，辰己月，风宪。乙癸相逢旺食支，天工造物本无私；运行自有高人荐，手攀丹桂上云逵。癸日时逢乙卯，贵人食禄之乡，玉堂乙卯位侯王，便是金门将相。君子文章播发，常人财禄盈箱，甲寅辛酉颇安常，富贵荣华大享。', '三命通会卷八·六癸日卯时断'),
('DHC_癸亥_丙辰', '癸亥', '丙辰', '癸', '亥', '辰', '癸亥日丙辰时，柱无甲木破损官库，贵，运南。癸日丙辰官库闭，财星虽透却无气；官要匙开财要兴，柱逢卯戊方为贵。癸日丙辰时遇，库中锁闭财官，要逢卯戊钥匙开，守祖六亲阻碍。暗有食神相助，空乏虚度资财，先贫后富命中排，改祖重兴渐快。', '三命通会卷八·六癸日辰时断'),
('DHC_癸亥_丁巳', '癸亥', '丁巳', '癸', '亥', '巳', '癸亥日丁巳时，刑害。春夏月生，好。秋，印绶，吉。冬，平常。庚寅年月，武贵。巳时禄马同争先，造化无私产大贤；刑冲减半无空克，运至声名扬九天。癸日时临丁巳，贵人禄马同乡，三重蛇马正朝纲，玉殿金阶来往。壬亥申寅减半，只愁运落空亡，果无冲克无刑伤，舞拜凤凰池上。', '三命通会卷八·六癸日巳时断'),
('DHC_癸亥_戊午', '癸亥', '戊午', '癸', '亥', '午', '癸亥日戊午时，贵，未月，东方运；金月有制，俱贵显。将星扶禄命高低，见爱于人是与非；得志退毛鸡化凤，虎卧平坡被兔欺。癸日时逢戊午，天元既济之方，化为真火显威光，灾难消除福长。壬会甲寅减半，是非成败难防，六亲不睦暗刑伤，难得资财富旺。', '三命通会卷八·六癸日午时断'),
('DHC_癸亥_己未', '癸亥', '己未', '癸', '亥', '未', '癸亥日己未时，贵。未月生，忠孝双金，官至风宪。如煞官混杂，恐终在外。亥年月，贵。偏官暗鬼库中埋，险难惊忧不聚财；丑戌相逢钥匙吉，旺中癸福定无灾。癸日时临己未，库中耗鬼身衰，不逢卯戌钥匙开，锁闭不能通泰。花落重荣结子，双亲雁侣难谐，纵然先贫后富来，弃旧迎新无碍。', '三命通会卷八·六癸日未时断'),
('DHC_癸亥_庚申', '癸亥', '庚申', '癸', '亥', '申', '癸亥日庚申时，性平身孤。卯未月，饱学，贵命。申，亦贵。子申，近侍有权。癸日庚申仔细推，禹门深处见龙飞；文章得助雄威力，柱合财官世所希。癸日庚申时正，印绶齐合官星，亥寅申丙巳刑冲，离合立之身不定。无破黄甲显姓，常人财禄安宁，果无刑害与灾星，便是锦鸡化凤。', '三命通会卷八·六癸日申时断'),
('DHC_癸亥_辛酉', '癸亥', '辛酉', '癸', '亥', '酉', '癸亥日辛酉时，戌月，行东南运，金紫；东北，风宪。子月建禄，年遇财官，大贵。天元是癸时申酉，用尽心机度日忙；官印相生逢印合，胸中便富且如常。癸日辛酉时遇，倒食偏印难禁，柱中无依且安贫，财官月遇亦称。只怕癸水失地，不能驱驾奚胜，六亲骨肉各西东，一生劳苦之命。', '三命通会卷八·六癸日酉时断'),
('DHC_癸亥_壬戌', '癸亥', '壬戌', '癸', '亥', '戌', '癸亥日壬戌时，春生，伤官见官，夏财旺，秋、冬吉，名利有成。戌辰月，行亥子运，贵。子月，行西南运，金紫。天乙壬癸戌时排，库内财官等钥开；不遇刑冲空锁闭，少年难发更生灾。癸日时逢壬戌，就中仓库盈余，将星天德两相扶，辰戌钥匙开助。土旺长流水局，六亲恩处成疏，不遇空亡有增余，中末荣华享福。', '三命通会卷八·六癸日戌时断'),
('DHC_癸亥_癸亥', '癸亥', '癸亥', '癸', '亥', '亥', '癸亥日癸亥时，性聪飘逸，中年大富。冬月生，飞天禄马，无戊巳子字填实惹绊，贵显；不然，孤克为僧道，亦主清高。年月辰亥，干透辛壬，无填实巳字，有智量，大贵。卯月，金紫。巳丑亦贵。阴水重重透海波，少年未遇且蹉跎；困龙得志方能化，不遇时来虎卧坡。癸日时逢癸亥，败财带禄亨通。喜宜秋夏忌春冬，戊丙庚木富盛。巳亥甲丙反复，六亲大不和同。一身不定好翻腾，先败后成之命。以上诸命，原本十之六，增十之四，间有一命而两载者，传闻之误，岂曰无之，要在知命者以意消息之可也。卷十（缺）卷十一（缺）卷十二（缺）', '三命通会卷八·六癸日亥时断');

-- ============================================================================
-- 8c. 调候逐月条文库（120；经 OBDA 暴露 yongshen:TiaohouClause）｜穷通宝鉴（造化元钥）·各干逐月取用
--   十天干 × 十二月 = 120；原文明示者照录，首句无据者 56 条标【待考】（不编造）。
-- ============================================================================
INSERT INTO `tiaohou_clause` (clause_id, day_stem, month_branch, month_order, primary_use, secondary_use, clause_text, source_note) VALUES
('THC_甲_寅', '甲', '寅', 1, '壬', '', '秉令，故用壬以庚制木为佐，二月阳壮木渴，专用壬水，寅卯月为壬水病死之地，用壬须藉金生助，则为正二月所同也。', '穷通宝鉴（造化元钥）·正月甲'),
('THC_甲_卯', '甲', '卯', 2, '【待考】', '', '与正月雨水后甲木，用法略同，所不同者，即煞刃一格耳。', '穷通宝鉴（造化元钥）·二月甲'),
('THC_甲_辰', '甲', '辰', 3, '庚', '壬/丁', '先庚次壬，或支成金局，方可用丁，不然，三月无用丁之法。', '穷通宝鉴（造化元钥）·三月甲'),
('THC_甲_巳', '甲', '巳', 4, '壬', '', '退气，不宜克制太过，金多则受病，丙火司权，木气泄弱，根枯叶焦，必用壬水，方配得中和，壬为偏印，故因庇荫而得显名，煞印相生格局，而煞印皆休囚无力，故有好高之病，有名无实，作事无成，用假神之徵应也。', '穷通宝鉴（造化元钥）·四月甲'),
('THC_甲_午', '甲', '午', 5, '【待考】', '', '无从财南昌有化合，但化气必须见辰，方为真化，否则，虽不争妒，亦属平庸之辈，化气喜行旺地，甲己化土，生於五六月，火生土旺，逢时得地，未有不大富贵，尤以六月土旺时为美，但恐化气不真耳，（凡化气必须见辰，则化之元神透出，如甲己化土见辰，遁干戊辰，为土之元神也，详滴天髓徵义）。', '穷通宝鉴（造化元钥）·五月甲'),
('THC_甲_未', '甲', '未', 6, '【待考】', '', '即使四柱干支皆土，亦是假从非真从，盖未为木库，月令有微根故也，书曰财多身弱，富屋贫人，财多而无力支配其财，反为财所困，财为妻，故主反畏妻子也，印绶壬癸也，得水润土生木，则能克制己土，财为我用，否则，财虽多，非我所有，一生贫困，六月犹可者，金水进气之后也。', '穷通宝鉴（造化元钥）·六月甲'),
('THC_甲_申', '甲', '申', 7, '丁', '', '以用丁火为上格，庚金为月令当旺之气。', '穷通宝鉴（造化元钥）·七月甲'),
('THC_甲_酉', '甲', '酉', 8, '丁', '丙', '木气休囚，金旺乘仅，用丁所以制金，用丙所以调候，月令金神当旺，故以丁火为先，无丁用丙，炼金丁火之力强，调候丙火之力足，各有优点，若庚金透干，非丁火制之不可，或见辛透，亦宜丁火，丙与辛合，反失其用，若比劫多，或支成木局，则宜金制，更须有火制金，（详下）故云庚金为次。', '穷通宝鉴（造化元钥）·八月甲'),
('THC_甲_戌', '甲', '戌', 9, '丁', '癸/戊', '用财者，爱丁癸滋扶，见首节，专用丁癸者，喜丁癸配合也，戊透配得中和者，以戊土财星为用也，如戊戌一造，支成水局而透壬水，水多以戊为奇，戌宫戊土出干，用财损印，富大贵小之命，不见丁庚，难以致身通显，此论其表面也，其实财多身弱，好在月日之间，夹癸亥，日时之间，夹乙丑丙寅丁卯，前引后从，无形之中，木有生气，运行东北，故小有成就耳。', '穷通宝鉴（造化元钥）·九月甲'),
('THC_甲_亥', '甲', '亥', 10, '【待考】', '', '见食伤生财，多武职大贵，此理为本书所未载。', '穷通宝鉴（造化元钥）·十月甲'),
('THC_甲_子', '甲', '子', 11, '庚', '丁', '为寒气所束缚，非丙火无发生之意，虽以庚丁取贵，不能无丙解冻也，总论云：金纵多不能克伐，火重见温暖有助，又云须忌死绝之地，只宜生旺之方，可见无丙而用庚丁，亦只宜行东南运也。', '穷通宝鉴（造化元钥）·十一月甲'),
('THC_甲_丑', '甲', '丑', 12, '庚', '', '天气寒冻，木性极寒，无发生之意，先用庚劈甲以引丁火，木火始有通明之象，故丁次之。', '穷通宝鉴（造化元钥）·十二月甲'),
('THC_乙_寅', '乙', '寅', 1, '【待考】', '', '见寅午会局，泄散乙木之气，非取水为救，不能制火润木，同一理也。', '穷通宝鉴（造化元钥）·正月乙'),
('THC_乙_卯', '乙', '卯', 2, '庚', '', '乘权，权官会党者，支成木局也，庚金见乙，输晴相合，失相克之意，故云亦难制乙，若隔位不合，自无此弊，加一甲在内，为官煞混杂，非得庚金扫除官煞，必为禄浅之人，见下官煞会党节，七煞无制，其131为人必缺乏理智，不能自节也，丙多木多，阳壮木竭，同上一派丙火及一派甲木节，以上论正二戊土之用。', '穷通宝鉴（造化元钥）·二月乙'),
('THC_乙_辰', '乙', '辰', 3, '癸', '丙/戊', '以用癸丙为正，水多用戊己，取财破印为变，壬癸多见，春水汪洋，己土不能为水堤防，故云只恐高才不第，见戊土堤防，可发异途，提支者，月令提纲之支也，天干虽无壬癸，而地支申子辰会水局，同为春水泛滥，须得戊土堤防，更见丙火暖土，主富中取贵，异途功名，盖病与药之用，不如癸丙之秀，故主异途武科也。', '穷通宝鉴（造化元钥）·三月乙'),
('THC_乙_巳', '乙', '巳', 4, '癸', '丙/庚', '以用癸印为正，柱金水，用丙火伤官为例外，庚金佐癸，须不与乙木相合，方能收发水源之用，况庚为阳金，癸为阴水，以庚佐癸，不如以辛佐癸为清也。', '穷通宝鉴（造化元钥）·四月乙'),
('THC_乙_午', '乙', '午', 5, '【待考】', '', '之正用也。', '穷通宝鉴（造化元钥）·五月乙'),
('THC_乙_未', '乙', '未', 6, '【待考】', '', '无癸丙不能取富贵，支见辛金，无制乙之力，偏官主性情孤傲，贫贱而孤傲，必为僧道之流也。', '穷通宝鉴（造化元钥）·六月乙'),
('THC_乙_申', '乙', '申', 7, '己', '丙', '取用基本之法，若四柱无己，而癸水出干，除月令外，又不见庚金，丙火藏支，则不用己土，而用癸水，承官印相生，亦无不可，惟格局平庸，仅许贡监生员，无丙配合，格局更次，不失儒秀而已，若癸水藏支，四柱多庚，此必须用丙己二神，乙木得培植，卉草向荣，方能显其用，（见上己透加丙节）无丙己，又无癸水，格之下也，用癸泄庚生木者，金为妻，水为子。', '穷通宝鉴（造化元钥）·七月乙'),
('THC_乙_酉', '乙', '酉', 8, '丙', '癸', '以丙癸并用为贵，如辛金出干，或支成金局，则宜有丁火制之，癸辛丁并透，大贵之格，食神制煞，贵，多就武，见下阎汤诸造例证，倘无丁癸制化，则木被金伤，残疾夭折之命，所谓秋乙逢金，非贫即夭是也。', '穷通宝鉴（造化元钥）·八月乙'),
('THC_乙_戌', '乙', '戌', 9, '【待考】', '', '不离癸水，木火土金俱全，待水而发胎元丁丑，丑中有癸水余气，元机暗藏也。', '穷通宝鉴（造化元钥）·九月乙'),
('THC_乙_亥', '乙', '亥', 10, '戊', '甲/庚', '水旺用戊，戊多71用甲，甲多用庚，应病与药，随宜配合，但寒木向阳，必兼丙火为用。', '穷通宝鉴（造化元钥）·十月乙'),
('THC_乙_子', '乙', '子', 11, '【待考】', '', '【待考】源本未载，待校', '穷通宝鉴（造化元钥）·十一月乙'),
('THC_乙_丑', '乙', '丑', 12, '【待考】', '', '十二月寒木见丙，有回春之意。', '穷通宝鉴（造化元钥）·十二月乙'),
('THC_丙_寅', '丙', '寅', 1, '庚', '壬/戊', '以用庚壬为正轨，财滋弱煞也，用庚者，如木多以财破印，土多以泄食神，格之次也，壬多用戊，戊多用甲，又其次也。', '穷通宝鉴（造化元钥）·正月丙'),
('THC_丙_卯', '丙', '卯', 2, '壬', '己', '以用壬为正，无壬癸用己土。', '穷通宝鉴（造化元钥）·二月丙'),
('THC_丙_辰', '丙', '辰', 3, '壬', '甲', '向旺，专用壬水，与二月同，雪中鼓雨之后，土旺用事，虽不见戊，无形之中，自有晦丙塞壬之患，故用壬，须取甲木为辅，见甲木出干，丙壬之气清，自然取贵，成土局者，支聚四墓也，丙火用壬，名水辅阳光，在土旺之时，虽干不透戊己，支不聚墓库，亦非甲木为辅，不足以取贵，况支成土局乎。', '穷通宝鉴（造化元钥）·三月丙'),
('THC_丙_巳', '丙', '巳', 4, '壬', '', '司权，专用壬水，见申子辰成局为大贵也。', '穷通宝鉴（造化元钥）·四月丙'),
('THC_丙_午', '丙', '午', 5, '【待考】', '', '火土旺而见一二癸水，同一理也，若见壬长流之水，则非此论，更济之以申宫得禄之金，必然富贵兼全，印旺用财损印，不必定要甲木见土出制壬，平常人物。', '穷通宝鉴（造化元钥）·五月丙'),
('THC_丙_未', '丙', '未', 6, '壬', '', '用壬，不同余月用壬，故运入东南，家富千金，西北则贫苦无聊，余月用壬，俱喜行西北之运。', '穷通宝鉴（造化元钥）·六月丙'),
('THC_丙_申', '丙', '申', 7, '【待考】', '', '之正格，虽两申冲寅，两干透甲乙，有印相生，日元不弱，以财生煞为用，以上造化元钥。', '穷通宝鉴（造化元钥）·七月丙'),
('THC_丙_酉', '丙', '酉', 8, '壬', '', '身强用壬，才旺生煞为上格，见首节，若壬癸出干而丙火不旺，则不能不用印，盖八月为火之死地，日近西山，非甲木不能化壬水而生丙火，同上七月。', '穷通宝鉴（造化元钥）·八月丙'),
('THC_丙_戌', '丙', '戌', 9, '【待考】', '', '入墓，炎上非其时，凡炎上格必须行东南运，合於炎上之性，则吉。', '穷通宝鉴（造化元钥）·九月丙'),
('THC_丙_亥', '丙', '亥', 10, '甲', '', '以甲木为主要关键，庚戊壬随时损益可也。', '穷通宝鉴（造化元钥）·十月丙'),
('THC_丙_子', '丙', '子', 11, '【待考】', '', '【待考】源本未载，待校', '穷通宝鉴（造化元钥）·十一月丙'),
('THC_丙_丑', '丙', '丑', 12, '壬', '甲', '十二月气进二阳，侮雪欺霜，应先壬为用，己土司令，己多须用甲为佐。', '穷通宝鉴（造化元钥）·十二月丙'),
('THC_丁_寅', '丁', '寅', 1, '【待考】', '', '见壬，值寅月寅时，则成化木，化格以印为用，故并言癸，如见庚金破化格，则用财官，如不成化气，又无财官为用，必致困穷也，总结上文。', '穷通宝鉴（造化元钥）·正月丁'),
('THC_丁_卯', '丁', '卯', 2, '【待考】', '', '乙木秉令，偏印当旺，以财损印为正用，正印偏印，用法不同，故上文分庚甲庚乙两节，详释其义也。', '穷通宝鉴（造化元钥）·二月丁'),
('THC_丁_辰', '丁', '辰', 3, '庚', '甲/戊', '不离庚甲为用，土盛用庚用甲皆可，并用尤妙，支成水局者，以戊为用，当以火为妻，土为子。', '穷通宝鉴（造化元钥）·三月丁'),
('THC_丁_巳', '丁', '巳', 4, '甲', '庚/壬', '以用甲庚为正轨，用壬癸及炎上格，皆格局之变也。', '穷通宝鉴（造化元钥）·四月丁'),
('THC_丁_午', '丁', '午', 5, '【待考】', '', '秉令，壬水阳干，阳刚之性，不能从阴，乃财多身弱也，但此说不可拘泥，如壬午日元，丁火出干，化木从火，八法关键化象节云：壬生五月水无根，乃弃命从午中丁火，丁与壬合如夫妇，此伏象也，可见非不可从，但阳从阴为格非纯，不作上命论耳，木多泄弱壬水，又非从格，僧道之命。', '穷通宝鉴（造化元钥）·五月丁'),
('THC_丁_未', '丁', '未', 6, '【待考】', '', '节。', '穷通宝鉴（造化元钥）·六月丁'),
('THC_丁_申', '丁', '申', 7, '【待考】', '', '辛亥，丙申，丁丑，丙午。', '穷通宝鉴（造化元钥）·七月丁'),
('THC_丁_酉', '丁', '酉', 8, '【待考】', '', '癸巳，辛酉，丁巳，戊申。', '穷通宝鉴（造化元钥）·八月丁'),
('THC_丁_戌', '丁', '戌', 9, '【待考】', '', '庚午，丙戌，丁未，壬寅。', '穷通宝鉴（造化元钥）·九月丁'),
('THC_丁_亥', '丁', '亥', 10, '【待考】', '', '126癸亥，癸亥，丁亥，辛亥。', '穷通宝鉴（造化元钥）·十月丁'),
('THC_丁_子', '丁', '子', 11, '庚', '戊', '以庚劈甲引丁为正用，故妻贤子肖，水旺用戊，火旺用水，皆为去病之药，有病则用之，随宜酌用，无定法也。', '穷通宝鉴（造化元钥）·十一月丁'),
('THC_丁_丑', '丁', '丑', 12, '【待考】', '', '戊子，乙丑，丁未，甲辰。', '穷通宝鉴（造化元钥）·十二月丁'),
('THC_戊_寅', '戊', '寅', 1, '【待考】', '', '丙寅，庚寅，戊辰，庚申。', '穷通宝鉴（造化元钥）·正月戊'),
('THC_戊_卯', '戊', '卯', 2, '【待考】', '', '总论十一、二月严寒冰冻，丙火为尊，甲木为佐。', '穷通宝鉴（造化元钥）·二月戊'),
('THC_戊_辰', '戊', '辰', 3, '庚', '', '暗旺，用庚金泄土生水为用，支见三刑，戊寅年五月廿七日遭暗杀，在戌运中寿六十九。', '穷通宝鉴（造化元钥）·三月戊'),
('THC_戊_巳', '戊', '巳', 4, '庚', '辛', '见木火重重，无水解炎，只怕阳刃倒戈，己土虽无阳刃之厄，然偏枯之命，亦为贫寒鳏孤之象，水被土克，庚被丁伤，皆犯格局之忌，得庚辛生水，富贵非轻，病重得药，旋乾转坤之力，亦非寻常也，水为目，又心肾属於水，水被熬乾，故主心肾目疾。', '穷通宝鉴（造化元钥）·四月戊'),
('THC_戊_午', '戊', '午', 5, '甲', '', '不离壬癸，火炎土燥，得水方云中和，次取甲木者，有壬水方可用甲木，无壬则木化成灰，不能用也，三夏土实，得甲木则灵。', '穷通宝鉴（造化元钥）·五月戊'),
('THC_戊_未', '戊', '未', 6, '癸', '丙', '癸丙甲皆可为用，火多用土，土重用癸，水多用丙。', '穷通宝鉴（造化元钥）·六月戊'),
('THC_戊_申', '戊', '申', 7, '【待考】', '', '不离丙癸甲之理，秋土气寒，有丙火暖土而用财官，方为贵格，无丙者，即使配合适宜，不过富中取贵而已，分两节，首节言月丙取贵，次节言无丙取富，末节言妻子，癸为妻，甲为子，然秋土泄弱，无丙火暖土，不能胜任142财官，故有丙火者妻子全，并贤肖，无丙癸甲者，勿问妻子。', '穷通宝鉴（造化元钥）·七月戊'),
('THC_戊_酉', '戊', '酉', 8, '丙', '', '金泄身寒，赖丙照暖，喜水滋润，先丙后癸，不必木疏。', '穷通宝鉴（造化元钥）·八月戊'),
('THC_戊_戌', '戊', '戌', 9, '【待考】', '', '太旺，甲木乃去病之药，不可或缺，辛癸二者缺一，尚不失富贵也。', '穷通宝鉴（造化元钥）·九月戊'),
('THC_戊_亥', '戊', '亥', 10, '甲', '丙/丁', '以甲丙为主要用神，取丁制庚，无庚丁亦无所用，专取丙申，即使丙甲俱藏，亦不失富贵，丙甲两困者，有壬困丙，有庚困甲，即上文庚多破甲也，常人，有壬困丙，用神虽伤，仍有丙火之用，若无丙更为下格。', '穷通宝鉴（造化元钥）·十月戊'),
('THC_戊_子', '戊', '子', 11, '【待考】', '', '【待考】源本未载，待校', '穷通宝鉴（造化元钥）·十一月戊'),
('THC_戊_丑', '戊', '丑', 12, '【待考】', '', '癸卯，乙丑，戊申，壬子。', '穷通宝鉴（造化元钥）·十二月戊'),
('THC_己_寅', '己', '寅', 1, '丙', '', '专以丙火为用，癸为佐，戊庚丁甲，皆应病之药也。', '穷通宝鉴（造化元钥）·正月己'),
('THC_己_卯', '己', '卯', 2, '【待考】', '', '癸卯造。', '穷通宝鉴（造化元钥）·二月己'),
('THC_己_辰', '己', '辰', 3, '丙', '癸/甲', '先用丙癸，辰中原有癸水返映之气，（墓气）故先丙后癸，再用甲疏之，己土见丙戊并透，又生於土旺之月，其用与戊土同，无甲疏辟，则土不灵，特其用在既暖且润之后也。', '穷通宝鉴（造化元钥）·三月己'),
('THC_己_巳', '己', '巳', 4, '【待考】', '', '为然，戊癸相合，格局转变，为祸为福，另看格局定之，故不可不辨也。', '穷通宝鉴（造化元钥）·四月己'),
('THC_己_午', '己', '午', 5, '壬', '癸', '则非忌，然仲夏火旺之时，土燥不能生金，必须兼用壬水，用壬润土，所以成反生之功，非以泄辛金之秀，故壬己不兼用也，（取金水气清者，忌己土混浊，取反生者，利用其混浊，）无壬用癸，但力弱耳。', '穷通宝鉴（造化元钥）·五月己'),
('THC_己_未', '己', '未', 6, '甲', '辛', '秉令，混浊壬水，如见己土出干，必须以甲木为救应，次取辛金发水源，地支更宜藏一二点比劫，否则，土燥木枯，不能尽其用也。', '穷通宝鉴（造化元钥）·六月己'),
('THC_己_申', '己', '申', 7, '【待考】', '', '庚申，甲申，己丑，癸酉。', '穷通宝鉴（造化元钥）·七月己'),
('THC_己_酉', '己', '酉', 8, '【待考】', '', '乙亥，乙酉，己巳，乙丑。', '穷通宝鉴（造化元钥）·八月己'),
('THC_己_戌', '己', '戌', 9, '【待考】', '', '无甲不足以取贵，丙透无癸，土燥而枯，贵多就武。', '穷通宝鉴（造化元钥）·九月己'),
('THC_己_亥', '己', '亥', 10, '【待考】', '', '169甲午，乙亥，己丑，戊辰。', '穷通宝鉴（造化元钥）·十月己'),
('THC_己_子', '己', '子', 11, '丙', '丁', '见一派庚金，调候以丙火为正，制庚以丁火为强，丁透丙藏，金温土暖，秋冬土金伤官佩印，皆为富贵之命，而十二月体用同宫，尤为奇特，但不可缺丙丁耳。', '穷通宝鉴（造化元钥）·十一月己'),
('THC_己_丑', '己', '丑', 12, '【待考】', '', '甲午，丁丑，己未，癸酉。', '穷通宝鉴（造化元钥）·十二月己'),
('THC_庚_寅', '庚', '寅', 1, '辛', '己', '喜丙解寒，忌土压没，何以辛金相反，不知庚金刚锐，其性自寒，故喜丙火出干解冻，辛金温润，其气轻清，有寅宫丙火，阳回大地，金气自温，197若丙火出干，丙辛相合，不能不用官星，辛金太弱，不能任才官，必反为所困也，正月之金，不能无土，特土多有埋金之优，庚金生旺，见戊土多，喜甲木疏泄，辛金衰竭，用己土忌甲木破印也，庚金以克为功，辛金以泄为美，其性质殊也。', '穷通宝鉴（造化元钥）·正月庚'),
('THC_庚_卯', '庚', '卯', 2, '丁', '甲/庚', '专用丁火以抑其强，次用甲木引丁，又须用庚劈甲，八字如无丁用丙火，富贵多出於勉强，即有富贵，亦是辛苦得来。', '穷通宝鉴（造化元钥）·二月庚'),
('THC_庚_辰', '庚', '辰', 3, '甲', '丙/丁', '土旺用甲，金旺用丙丁，无别种法了。', '穷通宝鉴（造化元钥）·三月庚'),
('THC_庚_巳', '庚', '巳', 4, '【待考】', '', '节）辛金喜壬水为用，与庚金不同，见壬水出干，更有甲制戊，俾金水一清澈底，自是富贵之命，癸透壬藏，俱承上支成金局论之，辛金柔弱，生於四月，惟支成金局，亦不可无水也，如壬癸水俱无，但见烈烈火攻，金被火镕，贫贱残疾之命，木火炼金者阳金，非辛金也，甲出制戊，承上金局而言，甲木为财，故云可主衣禄，无水总非佳造，盖甲木无水，未能制戊，反而生火也，详下。', '穷通宝鉴（造化元钥）·四月庚'),
('THC_庚_午', '庚', '午', 5, '【待考】', '', '节。', '穷通宝鉴（造化元钥）·五月庚'),
('THC_庚_未', '庚', '未', 6, '丁', '', '专用丁火，甲木为佐。', '穷通宝鉴（造化元钥）·六月庚'),
('THC_庚_申', '庚', '申', 7, '丁', '甲', '秉令，刚锐已极，明理赋云：强金得水，方挫其锋，似宜水以泄之，不185知庚金之性质，必须煅炼方成大器，以用丁火为贵，甲木生寅，宜泄不宜克，庚金生申，宜无不宜泄，五行各有所宜，而兼有气候之关系，此理仅本书有此发明，（月令建禄，以才官为正用，初春甲木喜丙乃例外，仲春即宜才官，）煅炼庚金，丁火为上，而丁火必藉甲木为引，方能炉火常红，故以甲为佐，滴天髓云：如。', '穷通宝鉴（造化元钥）·七月庚'),
('THC_庚_酉', '庚', '酉', 8, '【待考】', '', '秉令，首论用火制刃，为煞刃格，次论用水泄金，为从革格，此言用财，金旺木衰，得火则同煞刃，得水为食伤生财，从革不成，商贾艺术之流亚也，旺金无用印之理，置之不论。', '穷通宝鉴（造化元钥）·八月庚'),
('THC_庚_戌', '庚', '戌', 9, '甲', '壬', '在霜降之前，与八月同论，土旺用事之后，无形之中，充塞宇宙，大惧戊土出干，土厚埋金，必以甲木为先，更取壬水冲刷土层，庚金之用自显，金水宜其清澄，见戊土则阴壬之流，见己土则浊壬之气，故戊己二者，皆以出干为忌也。', '穷通宝鉴（造化元钥）·九月庚'),
('THC_庚_亥', '庚', '亥', 10, '【待考】', '', '水冷金寒，非见丙丁，不能取贵，除非合於外格耳。', '穷通宝鉴（造化元钥）·十月庚'),
('THC_庚_子', '庚', '子', 11, '丙', '甲/丁', '一理共推，以丙甲丁全为上格，癸水出干，困丙损用，与无丙不同，无丙者清贫，有丙而为癸所困，不失衣禄，同上十一月，宜参阅之。', '穷通宝鉴（造化元钥）·十一月庚'),
('THC_庚_丑', '庚', '丑', 12, '丙', '丁', '十二月寒气太重，丑为湿泥，愈冻愈寒，先用丙火解冻，次取丁火煅金，甲木亦195不可少。', '穷通宝鉴（造化元钥）·十二月庚'),
('THC_辛_寅', '辛', '寅', 1, '【待考】', '', '皆同。', '穷通宝鉴（造化元钥）·正月辛'),
('THC_辛_卯', '辛', '卯', 2, '【待考】', '', '太弱，见戊己又惧埋金，如无庚助，即壬水淘洗，亦力有不生也。', '穷通宝鉴（造化元钥）·二月辛'),
('THC_辛_辰', '辛', '辰', 3, '壬', '', '之需用壬水，正以阳气舒伸，辛金在胎养之位，气势微弱故也，若四柱多火而无壬水，虽见甲木，不能破土，反助火旺，见癸破丙，可许衣衿，（见上文）惟清贫耳。', '穷通宝鉴（造化元钥）·三月辛'),
('THC_辛_巳', '辛', '巳', 4, '【待考】', '', '从煞亦非吉，因月令戊土，正印当旺，庚金长生，无根而有根，不能弃命相从，见下五月。', '穷通宝鉴（造化元钥）·四月辛'),
('THC_辛_午', '辛', '午', 5, '壬', '己/庚', '以壬己并透，支藏癸水，最为上格，午宫自有己土，见壬癸均不少功名，癸水虽嫌力薄，如得庚金生助，涓涓不绝，力用自增，亦必显於异途，若土必须见水，方可用甲破土，无水则木助火旺，不能制土，反生土矣，此必须注意者也。', '穷通宝鉴（造化元钥）·五月辛'),
('THC_辛_未', '辛', '未', 6, '壬', '庚', '以不透戊己，专用壬庚为贵，有戊己出干，则须边境证辗救护，禁忌多端，配合难得适宜也。', '穷通宝鉴（造化元钥）·六月辛'),
('THC_辛_申', '辛', '申', 7, '壬', '戊/甲', '用壬水，宜少不宜多，戊甲为应病之药，水多用戊，水少见戊，取甲为制，皆不得巳之用法也。', '穷通宝鉴（造化元钥）·七月辛'),
('THC_辛_酉', '辛', '酉', 8, '壬', '甲', '太旺，专用壬水，次取甲木破土，水得流通为妙。', '穷通宝鉴（造化元钥）·八月辛'),
('THC_辛_戌', '辛', '戌', 9, '甲', '', '火土为病，水木为药，专壬为用，佐以甲木，丙火酌用。', '穷通宝鉴（造化元钥）·九月辛'),
('THC_辛_亥', '辛', '亥', 10, '壬', '丙/己', '先壬后丙，又或先丙次己，须酌用之。', '穷通宝鉴（造化元钥）·十月辛'),
('THC_辛_子', '辛', '子', 11, '丙', '', '不离壬丙，与十一月略同，气候太寒，故先丙，丙辛不合，方有解冻之用也。', '穷通宝鉴（造化元钥）·十一月辛'),
('THC_辛_丑', '辛', '丑', 12, '丙', '壬', '俱先丙次壬，戊己又次之。', '穷通宝鉴（造化元钥）·十二月辛'),
('THC_壬_寅', '壬', '寅', 1, '【待考】', '', '相同，而辛与隔位不合，各得其用为美。', '穷通宝鉴（造化元钥）·正月壬'),
('THC_壬_卯', '壬', '卯', 2, '【待考】', '', '泄弱，专用酉金，水木清华，当为文学词臣，逆行运颇佳。', '穷通宝鉴（造化元钥）·二月壬'),
('THC_壬_辰', '壬', '辰', 3, '【待考】', '', '不离甲庚，防初学拘执，更申述之。', '穷通宝鉴（造化元钥）·三月壬'),
('THC_壬_巳', '壬', '巳', 4, '【待考】', '', '以印比相互救济为用，有印无比劫，火旺金镕，印绶比劫俱无，偏枯之局，惟合於从财等外格取贵耳。', '穷通宝鉴（造化元钥）·四月壬'),
('THC_壬_午', '壬', '午', 5, '【待考】', '', '此造非是。', '穷通宝鉴（造化元钥）·五月壬'),
('THC_壬_未', '壬', '未', 6, '【待考】', '', '节。', '穷通宝鉴（造化元钥）·六月壬'),
('THC_壬_申', '壬', '申', 7, '戊', '', '专用戊土，丁火为佐。', '穷通宝鉴（造化元钥）·七月壬'),
('THC_壬_酉', '壬', '酉', 8, '甲', '戊', '以用甲木为正，体全格为变，用戊土为应病与药，平常格局也。', '穷通宝鉴（造化元钥）·八月壬'),
('THC_壬_戌', '壬', '戌', 9, '甲', '', '专用甲木，次看丙火，戊土须酌用之。', '穷通宝鉴（造化元钥）·九月壬'),
('THC_壬_亥', '壬', '亥', 10, '丁', '己', '用丁己，不242如丙戊，望重乡闾，寿八十八，卒於戊寅年。', '穷通宝鉴（造化元钥）·十月壬'),
('THC_壬_子', '壬', '子', 11, '丙', '戊', '居垣，谓月令水当旺也，水清主智，己土混杂，反主愚顽，路经南域，谓运行巳午未南方也，日主健旺，主富，消息赋云：北入运在南方，贸易获其厚利是也，冬水以丙戊为主要用神，财官是也，并不限於水木伤官。', '穷通宝鉴（造化元钥）·十一月壬'),
('THC_壬_丑', '壬', '丑', 12, '【待考】', '', '不可无丙，丁甲力薄，有丙富贵，无丙贫苦，显然可见。', '穷通宝鉴（造化元钥）·十二月壬'),
('THC_癸_寅', '癸', '寅', 1, '丙', '辛', '以丙辛为正用，有辛方能用丙，故土妻金子。', '穷通宝鉴（造化元钥）·正月癸'),
('THC_癸_卯', '癸', '卯', 2, '辛', '', '水木伤官为体，木神当旺，不能不佩印，无庚用辛，不必拘执，二月阳气舒伸，无形中自有丙丁，故不必明见丙丁，亦可取贵也。', '穷通宝鉴（造化元钥）·二月癸'),
('THC_癸_辰', '癸', '辰', 3, '【待考】', '', '从化者多，得化者荣禄，不化者平常。', '穷通宝鉴（造化元钥）·三月癸'),
('THC_癸_巳', '癸', '巳', 4, '【待考】', '', '劫印不可缺一，以水制火存金，以金化土生水，交互为用，巳宫庚金长生，气极微弱，逼於火土，不能生水，见丑会局，庚金即转生旺，能生癸水，名湿土生金，此与亥月见未会局，木转生旺，能生丙火同一理也，丑宫土金水，煞印相生，在癸水为绝处逢生，大富贵无疑，亦奇格之一也，见下陈某龙造。', '穷通宝鉴（造化元钥）·四月癸'),
('THC_癸_午', '癸', '午', 5, '【待考】', '', '所以不易言从者，因胎元酉宫，暗生癸水，自然有根也，财为我克，故不易从，煞为克我，故能从，此造好在戊癸丁壬两合，化而兼从，否则，亦难作从论也。', '穷通宝鉴（造化元钥）·五月癸'),
('THC_癸_未', '癸', '未', 6, '庚', '', '作两节推，上半月庚辛无气，下半月庚辛有气，凡六癸日，人多推此月不验，何也，？不知未中有乙，与己同宫，欲破不破，癸水不能从煞，专用庚辛为主，上半月虽有庚出干，却金畏火炎，须有比劫助金，方许科甲富贵，无比劫常人，至下半月，庚辛有气，即无比劫不忌，有丁见庚辛透者，便推富贵，然亦忌丁透与在未者，皆不秀也。', '穷通宝鉴（造化元钥）·六月癸'),
('THC_癸_申', '癸', '申', 7, '【待考】', '', '金多乏丁制一理，（此中有润下飞天禄马等格宜注意）。', '穷通宝鉴（造化元钥）·七月癸'),
('THC_癸_酉', '癸', '酉', 8, '辛', '', '八月酉辛虚灵，非顽金可比，正金白水清之时，取辛为用，丙火佐之，名水暖金温。', '穷通宝鉴（造化元钥）·八月癸'),
('THC_癸_戌', '癸', '戌', 9, '【待考】', '', '要见辛方吉，癸辛有用方妙。', '穷通宝鉴（造化元钥）·九月癸'),
('THC_癸_亥', '癸', '亥', 10, '庚', '辛', '最忌支成木局，泄散元神，故旺中有弱，专用庚辛生发。', '穷通宝鉴（造化元钥）·十月癸'),
('THC_癸_子', '癸', '子', 11, '【待考】', '', '【待考】源本未载，待校', '穷通宝鉴（造化元钥）·十一月癸'),
('THC_癸_丑', '癸', '丑', 12, '丙', '', '落地成冰，万物不能舒泰，专用丙火解冻。', '穷通宝鉴（造化元钥）·十二月癸');

