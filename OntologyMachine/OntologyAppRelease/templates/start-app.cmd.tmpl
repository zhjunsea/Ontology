@echo off
setlocal enableextensions
chcp 936 >nul
cd /d "@{APP_DIR}"

set "JAVA_HOME=@{JAVA_HOME}"
rem [应用级] 用随包 JDK：仅本窗口及子进程生效，不写系统/用户环境变量
set "PATH=%JAVA_HOME%\bin;%PATH%"
set "JAVA_EXE=%JAVA_HOME%\bin\java.exe"
set "APP_JAR=@{APP_JAR}"

echo ============================================================
echo   启动应用本体 Worker: @{APP_NAME} @{APP_VERSION}
echo   工作目录: %CD%
echo ============================================================
echo.

if not exist "%JAVA_EXE%" (
    echo [错误] 未找到 java: %JAVA_EXE%
    echo        请先执行 install.cmd 完成安装。
    pause
    exit /b 1
)
if not exist "%APP_JAR%" (
    echo [错误] 未找到应用 jar: %APP_JAR%
    echo        请先执行 install.cmd 完成安装。
    pause
    exit /b 1
)

echo [提示] 请先运行 start-env.cmd 启动环境服务（Camunda/MySQL/Ontop/RabbitMQ 等），
echo        待其窗口显示「环境服务全部就绪」后，再运行本脚本启动应用 Worker。
echo.

"%JAVA_EXE%" -jar "%APP_JAR%"

echo.
echo [完成] 应用已退出。
pause
