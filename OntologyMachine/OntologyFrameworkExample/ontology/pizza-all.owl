<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/pizza/all"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:terms="http://purl.org/dc/terms/">
     <owl:Ontology rdf:about="http://example.org/pizza/all">
        <owl:imports rdf:resource="http://example.org/pizza/core"/>
        <owl:imports rdf:resource="http://example.org/pizza/components"/>
        <owl:imports rdf:resource="http://example.org/pizza/processes"/>

        <!-- processes-abox 依「推理需要即加载」原则保留（未纳入 ABox 分离）：
             BPMN 12 个工序节点经 query-property-value-ontology 走全局推理器查 Task_* 的 duration，
             工序表未经 OBDA 映射；注释掉会中断流程。 -->
        <owl:imports rdf:resource="http://example.org/pizza/processes-abox"/>
        <!-- abox：其余 ABox 的运行态数据由 OBDA(MySQL) 提供（myPizza.obda 映射至同 IRI 命名空间），
             故按铁律 11 注释掉，由应用侧经 ontology.abox-path 独立加载。
        <owl:imports rdf:resource="http://example.org/pizza/components-abox"/>
        <owl:imports rdf:resource="http://example.org/pizza/core-abox"/>
        -->
        <rdfs:comment xml:lang="zh">
        		加载此文件即可一次性导入所有披萨本体模块。内部重复导入会被 OWL 解析器自动去重，无需担心循环或冲突。
        </rdfs:comment>
        <rdfs:label xml:lang="zh">披萨本体总入口（显式导入所有模块）</rdfs:label>
    </owl:Ontology>
</rdf:RDF>



