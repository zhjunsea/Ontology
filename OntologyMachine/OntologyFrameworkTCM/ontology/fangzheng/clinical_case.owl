    </owl:Class>
    <owl:Class rdf:about="http://www.tcm-classics.org/jingfang#Baitongtangzheng">
        <rdfs:subClassOf rdf:resource="http://www.tcm-classics.org/jingfang#JizhengFangzheng"/>
    </owl:Class>
    <owl:Class rdf:about="http://www.tcm-classics.org/jingfang#Baitongjiazhudanzhitangzheng">
        <rdfs:subClassOf rdf:resource="http://www.tcm-classics.org/jingfang#JizhengFangzheng"/>
    </owl:Class>
    <owl:Class rdf:about="http://www.tcm-classics.org/jingfang#Ganjiangfuzitangzheng">
