    </owl:Class>

    <!-- 表急方证归类（⊑Biao 且 clinicalPriority≤2） -->
    <owl:Class rdf:about="http://www.tcm-classics.org/jingfang#Xumingtangzheng">
        <rdfs:subClassOf rdf:resource="http://www.tcm-classics.org/jingfang#BiaoJiFangzheng"/>
