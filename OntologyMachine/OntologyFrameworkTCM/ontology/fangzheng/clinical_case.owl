    <owl:Class rdf:about="http://www.tcm-classics.org/jingfang#Taohuatangzheng">
        <rdfs:subClassOf rdf:resource="http://www.tcm-classics.org/jingfang#JizhengFangzheng"/>
    </owl:Class>
    <owl:Class rdf:about="http://www.tcm-classics.org/jingfang#Dajianzhongtangzheng">
