    </owl:Class>
    <owl:Class rdf:about="http://www.tcm-classics.org/jingfang#Huanglianejiaotangzheng">
        <rdfs:subClassOf rdf:resource="http://www.tcm-classics.org/jingfang#JizhengFangzheng"/>
    </owl:Class>
    <owl:Class rdf:about="http://www.tcm-classics.org/jingfang#Wutouchishizhiwanzheng">
        <rdfs:subClassOf rdf:resource="http://www.tcm-classics.org/jingfang#JizhengFangzheng"/>
    </owl:Class>
    <owl:Class rdf:about="http://www.tcm-classics.org/jingfang#Daxianxiongtangzheng">
        <rdfs:subClassOf rdf:resource="http://www.tcm-classics.org/jingfang#JizhengFangzheng"/>
    </owl:Class>
    <owl:Class rdf:about="http://www.tcm-classics.org/jingfang#Daxianxiongwanzheng">
        <rdfs:subClassOf rdf:resource="http://www.tcm-classics.org/jingfang#JizhengFangzheng"/>
    </owl:Class>
    <owl:Class rdf:about="http://www.tcm-classics.org/jingfang#Xiexintangzheng">
        <rdfs:subClassOf rdf:resource="http://www.tcm-classics.org/jingfang#JizhengFangzheng"/>
    </owl:Class>

    <!-- 里实方证归类（阳明里实、非急） -->
    <owl:Class rdf:about="http://www.tcm-classics.org/jingfang#Xiaochengqitangzheng">
        <rdfs:subClassOf rdf:resource="http://www.tcm-classics.org/jingfang#LiShiFangzheng"/>
    </owl:Class>
    <owl:Class rdf:about="http://www.tcm-classics.org/jingfang#Tiaoweichengqitangzheng">
