    <!-- ==================== SWRL 变量 ==================== -->
    <rdf:Description rdf:about="http://www.tcm-classics.org/jingfang/clinical-case#c">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.tcm-classics.org/jingfang/clinical-case#p">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.tcm-classics.org/jingfang/clinical-case#j">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>

    <!-- ==================== SWRL 规则 A~E ==================== -->
    <!-- 规则A：里急先救里（主证表证 + 兼证里急）→ 先救里，建议救里方 -->
    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
            <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
            <rdf:first>
                <rdf:Description>
                    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                    <swrl:classPredicate rdf:resource="http://www.tcm-classics.org/jingfang#ClinicalCase"/>
                    <swrl:argument1 rdf:resource="http://www.tcm-classics.org/jingfang/clinical-case#c"/>
                </rdf:Description>
            </rdf:first>
            <rdf:rest>
                <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                    <swrl:propertyPredicate rdf:resource="http://www.tcm-classics.org/jingfang#hasConfirmedPattern"/>
                    <swrl:argument1 rdf:resource="http://www.tcm-classics.org/jingfang/clinical-case#c"/>
                    <swrl:argument2 rdf:resource="http://www.tcm-classics.org/jingfang/clinical-case#p"/>
                </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                    <rdf:first>
                        <rdf:Description>
                    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                    <swrl:classPredicate rdf:resource="http://www.tcm-classics.org/jingfang#Biao"/>
                    <swrl:argument1 rdf:resource="http://www.tcm-classics.org/jingfang/clinical-case#p"/>
                </rdf:Description>
                    </rdf:first>
                    <rdf:rest>
                        <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                    <swrl:propertyPredicate rdf:resource="http://www.tcm-classics.org/jingfang#hasConcomitantPathology"/>
                    <swrl:argument1 rdf:resource="http://www.tcm-classics.org/jingfang/clinical-case#c"/>
                    <swrl:argument2 rdf:resource="http://www.tcm-classics.org/jingfang/clinical-case#j"/>
                </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                            <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                            <rdf:first>
                                <rdf:Description>
                    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                    <swrl:classPredicate rdf:resource="http://www.tcm-classics.org/jingfang#JizhengFangzheng"/>
                    <swrl:argument1 rdf:resource="http://www.tcm-classics.org/jingfang/clinical-case#j"/>
                </rdf:Description>
                            </rdf:first>
                            <rdf:rest>
                                <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                    <swrl:classPredicate rdf:resource="http://www.tcm-classics.org/jingfang#Li"/>
                    <swrl:argument1 rdf:resource="http://www.tcm-classics.org/jingfang/clinical-case#j"/>
                </rdf:Description>
                                </rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                            </rdf:rest>
                        </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                    </rdf:rest>
                </rdf:Description>
                </rdf:rest>
            </rdf:Description>
            </rdf:rest>
        </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
