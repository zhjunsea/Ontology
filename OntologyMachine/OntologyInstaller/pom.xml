<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.junzhang</groupId>
        <artifactId>OntologyMachine</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>com.ocean</groupId>
    <artifactId>OntologyInstaller</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>OntologyInstaller</name>
    <description>
        本体开发环境安装器（Swing UI）：客户选择「软件安装目录」与「开发工作目录」后，
        把 softwares/ 下全部软件拷贝并解压到安装目录（MySQL 额外执行 --initialize-insecure 初始化），
        把 OntologyFrameworkExample 工程解压到工作目录，并改写其 application.yaml / start-env.cmd
        指向安装目录下的各软件 home 与便携式 MySQL（mysqld --console）。
    </description>

    <properties>
        <installer.output.dir>${project.basedir}/../build/installer</installer.output.dir>
    </properties>

    <dependencies>
        <!-- 单元测试（JUnit 5，版本由 spring-boot-starter-parent 管理） -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- AllInstallerSuiteTest（总入口套件，@Suite + @SelectClasses）需要 suite 引擎 -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>OntologyInstaller</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.ocean.installer.OntologyInstaller</mainClass>
                </configuration>
            </plugin>

            <!-- 全量回归时排除总入口套件类，避免与各测试类重复执行 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>**/All*SuiteTest.java</exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- 组装安装器分发目录 build/installer/：可执行 jar + softwares/(zip) + Example 工程包 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>assemble-installer-dist</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <delete dir="${installer.output.dir}" quiet="true"/>
                                <mkdir dir="${installer.output.dir}"/>
                                <mkdir dir="${installer.output.dir}/softwares"/>
                                <copy file="${project.build.directory}/${project.build.finalName}.jar"
                                      tofile="${installer.output.dir}/${project.build.finalName}.jar"/>
                                <!-- 启动脚本：先用随附 JDK 解压出运行时，再用其 java 运行安装器（免预装 Java） -->
                                <copy file="${project.basedir}/src/main/scripts/start-installer.cmd"
                                      todir="${installer.output.dir}"/>
                                <copy todir="${installer.output.dir}/softwares">
                                    <fileset dir="${project.basedir}/../softwares"/>
                                </copy>
                                <copy file="${project.basedir}/../build/OntologyFrameworkExample-0.0.1-SNAPSHOT-project.zip"
                                      todir="${installer.output.dir}"/>
                                <!-- 离线 Maven 仓库快照：由 OntologyFrameworkPlatform/tools/gen-offline-repo.sh 生成，
                                     打包进分发目录，安装时释放到安装目录，使释放出的工程无网也能构建并运行测试。 -->
                                <available file="${project.basedir}/../build/maven-repo" type="dir"
                                           property="offline.maven.repo.present"/>
                                <fail unless="${offline.maven.repo.present}"
                                      message="未找到离线仓库目录 build/maven-repo。请先执行：bash OntologyFrameworkPlatform/tools/gen-offline-repo.sh"/>
                                <zip destfile="${installer.output.dir}/maven-repo.zip"
                                     basedir="${project.basedir}/../build/maven-repo"/>
                                <!-- 四个基础库（三薄 jar + EnvPrepare 可执行 jar）：后续新本体应用开发与运行的基础依赖，
                                     随发布包一并分发，供目标机无网环境按坐标安装或直接引用。 -->
                                <available file="${project.basedir}/../build/OpenlletResolver-0.0.1-SNAPSHOT.jar"
                                           property="base.lib.openllet.present"/>
                                <available file="${project.basedir}/../build/OntopOBDAHandler-0.0.1-SNAPSHOT.jar"
                                           property="base.lib.ontop.present"/>
                                <available file="${project.basedir}/../build/Utilities-0.0.1-SNAPSHOT.jar"
                                           property="base.lib.utilities.present"/>
                                <available file="${project.basedir}/../build/EnvPrepare-0.0.1-SNAPSHOT.jar"
                                           property="base.lib.envprepare.present"/>
                                <fail unless="${base.lib.openllet.present}"
                                      message="未找到基础库 jar build/OpenlletResolver-0.0.1-SNAPSHOT.jar。请先执行根工程 install 与 OntologyFrameworkPlatform package。"/>
                                <fail unless="${base.lib.ontop.present}"
                                      message="未找到基础库 jar build/OntopOBDAHandler-0.0.1-SNAPSHOT.jar。请先执行根工程 install 与 OntologyFrameworkPlatform package。"/>
                                <fail unless="${base.lib.utilities.present}"
                                      message="未找到基础库 jar build/Utilities-0.0.1-SNAPSHOT.jar。请先执行根工程 install 与 OntologyFrameworkPlatform package。"/>
                                <fail unless="${base.lib.envprepare.present}"
                                      message="未找到基础库 jar build/EnvPrepare-0.0.1-SNAPSHOT.jar。请先执行根工程 install 与 OntologyFrameworkPlatform package。"/>
                                <mkdir dir="${installer.output.dir}/lib"/>
                                <copy todir="${installer.output.dir}/lib">
                                    <fileset dir="${project.basedir}/../build">
                                        <include name="OpenlletResolver-*.jar"/>
                                        <include name="OntopOBDAHandler-*.jar"/>
                                        <include name="Utilities-*.jar"/>
                                        <include name="EnvPrepare-*.jar"/>
                                    </fileset>
                                </copy>
                                <!-- 开发/部署文档随发布包根目录分发（亦纳入下方 dist zip） -->
                                <copy file="${project.basedir}/../build/README.md"
                                      tofile="${installer.output.dir}/README.md"/>
                                <copy file="${project.basedir}/../build/新应用开发与部署指南.md"
                                      tofile="${installer.output.dir}/新应用开发与部署指南.md"/>
                                <!-- 本体应用构建 SKILL 工程（OntologyAppBuilder）：随发布包分发，
                                     安装时由安装器投放到工程 .codeartsdoer/skills/ontology-app-builder/，
                                     供客户在码道（CodeArts）中按 14 步流程构建新的本体应用。 -->
                                <copy todir="${installer.output.dir}/skills/ontology-app-builder">
                                    <fileset dir="${project.basedir}/../OntologyAppBuilder"
                                             excludes="scripts/__pycache__/**"/>
                                </copy>
                                <!-- 把整个分发目录打成单个发布压缩包：build/OntologyInstaller-0.0.1-SNAPSHOT-dist.zip -->
                                <zip destfile="${project.basedir}/../build/${project.artifactId}-${project.version}-dist.zip"
                                     basedir="${installer.output.dir}"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
