    <rdf:Description rdf:about="http://example.org/ziweidoushu/state#Char_ZiWei"><rdf:type rdf:resource="http://example.org/ziweidoushu/state#StarCharacter"/><state:characterName>尊</state:characterName></rdf:Description>
