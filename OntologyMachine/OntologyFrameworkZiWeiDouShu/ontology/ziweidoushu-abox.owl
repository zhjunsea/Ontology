    <rdf:Description rdf:about="http://example.org/ziweidoushu/palace#SanFang_TianZhai"><rdf:type rdf:resource="http://example.org/ziweidoushu/palace#SanFangSiZheng"/><palace:sanFangPosition>本宫+对宫+三合二宫</palace:sanFangPosition></rdf:Description>
    <rdf:Description rdf:about="http://example.org/ziweidoushu/palace#SanFang_FuDe"><rdf:type rdf:resource="http://example.org/ziweidoushu/palace#SanFangSiZheng"/><palace:sanFangPosition>本宫+对宫+三合二宫</palace:sanFangPosition></rdf:Description>
    <rdf:Description rdf:about="http://example.org/ziweidoushu/palace#SanFang_FuMu"><rdf:type rdf:resource="http://example.org/ziweidoushu/palace#SanFangSiZheng"/><palace:sanFangPosition>本宫+对宫+三合二宫</palace:sanFangPosition></rdf:Description>
    <rdf:Description rdf:about="http://example.org/ziweidoushu/palace#Meaning_Ming"><rdf:type rdf:resource="http://example.org/ziweidoushu/palace#PalaceMeaning"/><palace:palaceMeaningText>命宫为十二宫之首，主一生格局性情。</palace:palaceMeaningText></rdf:Description>
    <rdf:Description rdf:about="http://example.org/ziweidoushu/palace#Meaning_XiongDi"><rdf:type rdf:resource="http://example.org/ziweidoushu/palace#PalaceMeaning"/><palace:palaceMeaningText>兄弟宫主手足情谊与助力。</palace:palaceMeaningText></rdf:Description>
    <rdf:Description rdf:about="http://example.org/ziweidoushu/palace#Meaning_FuQi"><rdf:type rdf:resource="http://example.org/ziweidoushu/palace#PalaceMeaning"/><palace:palaceMeaningText>夫妻宫主婚姻配偶。</palace:palaceMeaningText></rdf:Description>
    <rdf:Description rdf:about="http://example.org/ziweidoushu/palace#Meaning_ZiNv"><rdf:type rdf:resource="http://example.org/ziweidoushu/palace#PalaceMeaning"/><palace:palaceMeaningText>子女宫主子女缘与桃花。</palace:palaceMeaningText></rdf:Description>
    <rdf:Description rdf:about="http://example.org/ziweidoushu/palace#Meaning_CaiBo"><rdf:type rdf:resource="http://example.org/ziweidoushu/palace#PalaceMeaning"/><palace:palaceMeaningText>财帛宫主财富得失。</palace:palaceMeaningText></rdf:Description>
    <rdf:Description rdf:about="http://example.org/ziweidoushu/palace#Meaning_JiE"><rdf:type rdf:resource="http://example.org/ziweidoushu/palace#PalaceMeaning"/><palace:palaceMeaningText>疾厄宫主健康体质。</palace:palaceMeaningText></rdf:Description>
    <rdf:Description rdf:about="http://example.org/ziweidoushu/palace#Meaning_QianYi"><rdf:type rdf:resource="http://example.org/ziweidoushu/palace#PalaceMeaning"/><palace:palaceMeaningText>迁移宫主外出际遇。</palace:palaceMeaningText></rdf:Description>
    <rdf:Description rdf:about="http://example.org/ziweidoushu/palace#Meaning_JiaoYou"><rdf:type rdf:resource="http://example.org/ziweidoushu/palace#PalaceMeaning"/><palace:palaceMeaningText>交友宫（仆役宫）主朋友部属。</palace:palaceMeaningText></rdf:Description>
    <rdf:Description rdf:about="http://example.org/ziweidoushu/palace#Meaning_GuanLu"><rdf:type rdf:resource="http://example.org/ziweidoushu/palace#PalaceMeaning"/><palace:palaceMeaningText>官禄宫主事业功名。</palace:palaceMeaningText></rdf:Description>
    <rdf:Description rdf:about="http://example.org/ziweidoushu/palace#Meaning_TianZhai"><rdf:type rdf:resource="http://example.org/ziweidoushu/palace#PalaceMeaning"/><palace:palaceMeaningText>田宅宫主家业田产。</palace:palaceMeaningText></rdf:Description>
    <rdf:Description rdf:about="http://example.org/ziweidoushu/palace#Meaning_FuDe"><rdf:type rdf:resource="http://example.org/ziweidoushu/palace#PalaceMeaning"/><palace:palaceMeaningText>福德宫主福泽精神。</palace:palaceMeaningText></rdf:Description>
    <rdf:Description rdf:about="http://example.org/ziweidoushu/palace#Meaning_FuMu"><rdf:type rdf:resource="http://example.org/ziweidoushu/palace#PalaceMeaning"/><palace:palaceMeaningText>父母宫主父母尊长。</palace:palaceMeaningText></rdf:Description>
    <rdf:Description rdf:about="http://example.org/ziweidoushu/rules#AlertDaXiong"><rdf:type rdf:resource="http://example.org/ziweidoushu/rules#AlertFlag"/><rules:alertType>大凶</rules:alertType></rdf:Description>
    <rdf:Description rdf:about="http://example.org/ziweidoushu/rules#AlertShouYuanGuan"><rdf:type rdf:resource="http://example.org/ziweidoushu/rules#AlertFlag"/><rules:alertType>寿元关</rules:alertType></rdf:Description>
    <rdf:Description rdf:about="http://example.org/ziweidoushu/rules#AlertJiBing"><rdf:type rdf:resource="http://example.org/ziweidoushu/rules#AlertFlag"/><rules:alertType>重大疾病</rules:alertType></rdf:Description>
