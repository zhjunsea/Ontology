<!-- ============================ 6. 典型 ABox（§7；枚举型全量 + 代表性） ============================ -->
    <!-- A) 历法基础：阴阳2 / 五行5+生克 / 天干10 / 地支12 / 五行局5+长生12 / 六十甲子代表性6 / 纳音6 -->
    <rdf:Description rdf:about="http://example.org/ziweidoushu/core#Yang"><rdf:type rdf:resource="http://example.org/ziweidoushu/core#YinYang"/><core:yinYangName>阳</core:yinYangName></rdf:Description>
    <rdf:Description rdf:about="http://example.org/ziweidoushu/core#Yin"><rdf:type rdf:resource="http://example.org/ziweidoushu/core#YinYang"/><core:yinYangName>阴</core:yinYangName></rdf:Description>
    <rdf:Description rdf:about="http://example.org/ziweidoushu/core#Mu"><rdf:type rdf:resource="http://example.org/ziweidoushu/core#FivePhase"/><core:phaseName>木</core:phaseName><core:generates rdf:resource="http://example.org/ziweidoushu/core#Huo"/><core:overcomes rdf:resource="http://example.org/ziweidoushu/core#Tu"/></rdf:Description>
    <rdf:Description rdf:about="http://example.org/ziweidoushu/core#Huo"><rdf:type rdf:resource="http://example.org/ziweidoushu/core#FivePhase"/><core:phaseName>火</core:phaseName><core:generates rdf:resource="http://example.org/ziweidoushu/core#Tu"/><core:overcomes rdf:resource="http://example.org/ziweidoushu/core#Jin"/></rdf:Description>
    <rdf:Description rdf:about="http://example.org/ziweidoushu/core#Tu"><rdf:type rdf:resource="http://example.org/ziweidoushu/core#FivePhase"/><core:phaseName>土</core:phaseName><core:generates rdf:resource="http://example.org/ziweidoushu/core#Jin"/><core:overcomes rdf:resource="http://example.org/ziweidoushu/core#Shui"/></rdf:Description>
    <rdf:Description rdf:about="http://example.org/ziweidoushu/core#Jin"><rdf:type rdf:resource="http://example.org/ziweidoushu/core#FivePhase"/><core:phaseName>金</core:phaseName><core:generates rdf:resource="http://example.org/ziweidoushu/core#Shui"/><core:overcomes rdf:resource="http://example.org/ziweidoushu/core#Mu"/></rdf:Description>
    <rdf:Description rdf:about="http://example.org/ziweidoushu/core#Shui"><rdf:type rdf:resource="http://example.org/ziweidoushu/core#FivePhase"/><core:phaseName>水</core:phaseName><core:generates rdf:resource="http://example.org/ziweidoushu/core#Mu"/><core:overcomes rdf:resource="http://example.org/ziweidoushu/core#Huo"/></rdf:Description>

