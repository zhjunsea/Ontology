    <rdf:Description rdf:about="http://example.org/ziweidoushu/pattern#Structure_GuiJu"><rdf:type rdf:resource="http://example.org/ziweidoushu/pattern#SpecialStructure"/><pattern:structureType>贵局</pattern:structureType></rdf:Description>
    <rdf:Description rdf:about="http://example.org/ziweidoushu/pattern#Structure_PinJianJu"><rdf:type rdf:resource="http://example.org/ziweidoushu/pattern#SpecialStructure"/><pattern:structureType>贫贱局</pattern:structureType></rdf:Description>
    <rdf:Description rdf:about="http://example.org/ziweidoushu/pattern#Structure_ZaJu"><rdf:type rdf:resource="http://example.org/ziweidoushu/pattern#SpecialStructure"/><pattern:structureType>杂局</pattern:structureType></rdf:Description>
    <rdf:Description rdf:about="http://example.org/ziweidoushu/pattern#Qual_DeDiHeGe"><rdf:type rdf:resource="http://example.org/ziweidoushu/pattern#PalaceStarQualification"/><pattern:qualificationType>得地合格</pattern:qualificationType></rdf:Description>
    <rdf:Description rdf:about="http://example.org/ziweidoushu/pattern#Qual_ShiXianPoGe"><rdf:type rdf:resource="http://example.org/ziweidoushu/pattern#PalaceStarQualification"/><pattern:qualificationType>失陷破格</pattern:qualificationType></rdf:Description>
