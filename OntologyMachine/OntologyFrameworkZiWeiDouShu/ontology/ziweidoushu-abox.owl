    <rdf:Description rdf:about="http://example.org/ziweidoushu/state#Char_TanLang"><rdf:type rdf:resource="http://example.org/ziweidoushu/state#StarCharacter"/><state:characterName>桃花</state:characterName></rdf:Description>
