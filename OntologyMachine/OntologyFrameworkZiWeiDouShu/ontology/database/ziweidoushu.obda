[PrefixDeclaration]
:        http://example.org/ziweidoushu/
core:    http://example.org/ziweidoushu/core#
calendar: http://example.org/ziweidoushu/calendar#
chart:   http://example.org/ziweidoushu/chart#
star:    http://example.org/ziweidoushu/star#
layout:  http://example.org/ziweidoushu/layout#
state:   http://example.org/ziweidoushu/state#
palace:  http://example.org/ziweidoushu/palace#
pattern: http://example.org/ziweidoushu/pattern#
fortune: http://example.org/ziweidoushu/fortune#
reading: http://example.org/ziweidoushu/reading#
diagnosis: http://example.org/ziweidoushu/diagnosis#
rules:   http://example.org/ziweidoushu/rules#
rdf:     http://www.w3.org/1999/02/22-rdf-syntax-ns#
rdfs:    http://www.w3.org/2000/01/rdf-schema#
owl:     http://www.w3.org/2002/07/owl#
xsd:     http://www.w3.org/2001/XMLSchema#

[MappingDeclaration] @collection [[

mappingId    ganzhi_stem
target       core:{name} a core:HeavenlyStem ;
                 core:stemName "{stem_name}"^^xsd:string ;
                 core:stemYinYang "{stem_yinyang}"^^xsd:string ;
                 core:hasYinYang core:{yinyang} ;
                 core:hasFivePhase core:{five_phase} ;
                 core:stemFivePhase core:{five_phase} .
source       SELECT name,
                 COALESCE(stem_name, '') AS stem_name,
                 COALESCE(stem_yinyang, '') AS stem_yinyang,
                 COALESCE(yinyang, '') AS yinyang,
                 COALESCE(five_phase, '') AS five_phase
             FROM ganzhi_stem
             WHERE name IS NOT NULL
               AND yinyang IS NOT NULL AND yinyang <> ''
               AND five_phase IS NOT NULL AND five_phase <> ''

mappingId    ganzhi_branch
target       core:{name} a core:EarthlyBranch ;
                 core:branchName "{branch_name}"^^xsd:string ;
                 core:branchAnimal "{branch_animal}"^^xsd:string ;
                 core:branchOrder "{branch_order}"^^xsd:integer ;
                 core:hasFivePhase core:{five_phase} .
source       SELECT name,
                 COALESCE(branch_name, '') AS branch_name,
                 COALESCE(branch_animal, '') AS branch_animal,
                 COALESCE(branch_order, 0) AS branch_order,
                 COALESCE(five_phase, '') AS five_phase
             FROM ganzhi_branch
             WHERE name IS NOT NULL
               AND five_phase IS NOT NULL AND five_phase <> ''

mappingId    sexagenary_cycle
target       core:{name} a core:SexagenaryCycle ;
                 core:hasStem core:{stem_local} ;
                 core:hasBranch core:{branch_local} ;
                 core:hasNaYin core:{nayin_local} .
source       SELECT name,
                 COALESCE(stem_local, '') AS stem_local,
                 COALESCE(branch_local, '') AS branch_local,
                 COALESCE(nayin_local, '') AS nayin_local
             FROM sexagenary_cycle
             WHERE name IS NOT NULL
               AND stem_local IS NOT NULL AND stem_local <> ''
               AND branch_local IS NOT NULL AND branch_local <> ''
               AND nayin_local IS NOT NULL AND nayin_local <> ''

mappingId    nayin
target       core:{name} a core:NaYin ;
                 core:naYinName "{nayin_name}"^^xsd:string .
source       SELECT name,
                 COALESCE(nayin_name, '') AS nayin_name
             FROM nayin
             WHERE name IS NOT NULL
               AND nayin_name IS NOT NULL AND nayin_name <> ''

mappingId    bureau
target       core:{name} a core:FivePhaseBureau ;
                 core:bureauName "{item_name}"^^xsd:string ;
                 core:bureauNumber "{item_number}"^^xsd:integer ;
                 core:stageStartBranch "{start_branch}"^^xsd:string .
source       SELECT name,
                 COALESCE(item_name, '') AS item_name,
                 COALESCE(item_number, 0) AS item_number,
                 COALESCE(start_branch, '') AS start_branch
             FROM bureau_stage
             WHERE name IS NOT NULL
               AND kind = 'bureau'

mappingId    twelve_stage
target       core:{name} a core:TwelveStage ;
                 core:stageName "{item_name}"^^xsd:string .
source       SELECT name,
                 COALESCE(item_name, '') AS item_name
             FROM bureau_stage
             WHERE name IS NOT NULL
               AND kind = 'stage'

mappingId    true_solar_time
target       calendar:{name} a calendar:TrueSolarTime ;
                 calendar:longitude "{longitude}"^^xsd:decimal .
source       SELECT name,
                 COALESCE(longitude, '') AS longitude
             FROM true_solar_time
             WHERE name IS NOT NULL
               AND longitude IS NOT NULL AND longitude <> ''

mappingId    leap_month
target       calendar:{name} a calendar:LeapMonth ;
                 calendar:leapMonthRule "{leap_month_rule}"^^xsd:string .
source       SELECT name,
                 COALESCE(leap_month_rule, '') AS leap_month_rule
             FROM leap_month
             WHERE name IS NOT NULL
               AND leap_month_rule IS NOT NULL AND leap_month_rule <> ''

mappingId    case_record
target       reading:CaseRecord_{case_id} a reading:CaseRecord ;
                 reading:caseBirthData "{birth_year}"^^xsd:string ;
                 reading:caseResult "{reading}"^^xsd:string .
source       SELECT case_id,
                 COALESCE(birth_year, '') AS birth_year,
                 COALESCE(reading, '') AS reading
             FROM case_record
             WHERE case_id IS NOT NULL

mappingId    alert_flag
target       rules:AlertFlag_{flag_id} a rules:AlertFlag ;
                 rules:alertType "{alert_type}"^^xsd:string ;
                 rules:alertTriggered "{alert_triggered}"^^xsd:boolean .
source       SELECT flag_id,
                 COALESCE(alert_type, '') AS alert_type,
                 COALESCE(alert_triggered, 0) AS alert_triggered
             FROM alert_flag
             WHERE flag_id IS NOT NULL

mappingId    brightness_map
target       <http://example.org/ziweidoushu/state#Brightness_{map_id}> a <http://example.org/ziweidoushu/state#Brightness> ;
                 <http://example.org/ziweidoushu/state#brightnessName> "{brightness_name}"^^xsd:string ;
                 <http://example.org/ziweidoushu/state#brightnessStarLocal> "{star_local}"^^xsd:string ;
                 <http://example.org/ziweidoushu/state#brightnessPalaceLocal> "{palace_local}"^^xsd:string .
source       SELECT map_id,
                 COALESCE(brightness_name, '') AS brightness_name,
                 COALESCE(star_local, '') AS star_local,
                 COALESCE(palace_local, '') AS palace_local
             FROM brightness_map
             WHERE map_id IS NOT NULL

mappingId    star_layout
target       <http://example.org/ziweidoushu/layout#StarLayout_{rule_id}> a <http://example.org/ziweidoushu/layout#StarLayout> ;
                 <http://example.org/ziweidoushu/layout#layoutRuleKind> "{rule_kind}"^^xsd:string ;
                 <http://example.org/ziweidoushu/layout#layoutBureauName> "{bureau_name}"^^xsd:string ;
                 <http://example.org/ziweidoushu/layout#layoutLunarDay> "{lunar_day}"^^xsd:integer ;
                 <http://example.org/ziweidoushu/layout#layoutStarLocal> "{star_local}"^^xsd:string ;
                 <http://example.org/ziweidoushu/layout#layoutToBranch> "{to_branch}"^^xsd:string .
source       SELECT rule_id,
                 COALESCE(rule_kind, '') AS rule_kind,
                 COALESCE(bureau_name, '') AS bureau_name,
                 COALESCE(lunar_day, 0) AS lunar_day,
                 COALESCE(star_local, '') AS star_local,
                 COALESCE(to_branch, '') AS to_branch
             FROM star_layout
             WHERE rule_id IS NOT NULL

mappingId    sihua_map
target       <http://example.org/ziweidoushu/rules#SihuaRule_{map_id}> a <http://example.org/ziweidoushu/rules#SihuaRule> ;
                 <http://example.org/ziweidoushu/rules#sihuaYearStem> "{year_stem}"^^xsd:string ;
                 <http://example.org/ziweidoushu/rules#sihuaTransformationType> "{transformation_type}"^^xsd:string ;
                 <http://example.org/ziweidoushu/rules#sihuaStarLocal> "{star_local}"^^xsd:string .
source       SELECT map_id,
                 COALESCE(year_stem, '') AS year_stem,
                 COALESCE(transformation_type, '') AS transformation_type,
                 COALESCE(star_local, '') AS star_local
             FROM sihua_map
             WHERE map_id IS NOT NULL

mappingId    palace_stem_map
target       <http://example.org/ziweidoushu/rules#PalaceStemRule_{map_id}> a <http://example.org/ziweidoushu/rules#PalaceStemRule> ;
                 <http://example.org/ziweidoushu/rules#palaceStemGroup> "{year_stem_group}"^^xsd:string ;
                 <http://example.org/ziweidoushu/rules#palaceStartStem> "{start_stem}"^^xsd:string .
source       SELECT map_id,
                 COALESCE(year_stem_group, '') AS year_stem_group,
                 COALESCE(start_stem, '') AS start_stem
             FROM palace_stem_map
             WHERE map_id IS NOT NULL

mappingId    deity_rule
target       <http://example.org/ziweidoushu/rules#DeityRule_{rule_id}> a <http://example.org/ziweidoushu/rules#DeityRule> ;
                 <http://example.org/ziweidoushu/rules#deityRuleId> "{rule_id}"^^xsd:string ;
                 <http://example.org/ziweidoushu/rules#deityRuleKind> "{rule_kind}"^^xsd:string ;
                 <http://example.org/ziweidoushu/rules#deityBase> "{deity_base}"^^xsd:string ;
                 <http://example.org/ziweidoushu/rules#deityName> "{deity_name}"^^xsd:string ;
                 <http://example.org/ziweidoushu/rules#deityToBranch> "{to_branch}"^^xsd:string .
source       SELECT rule_id,
                 COALESCE(rule_kind, '') AS rule_kind,
                 COALESCE(base, '') AS deity_base,
                 COALESCE(deity_name, '') AS deity_name,
                 COALESCE(to_branch, '') AS to_branch
             FROM deity_rule
             WHERE rule_id IS NOT NULL

mappingId    tongyuan_rule
target       <http://example.org/ziweidoushu/pattern#TongYuanRule_{rule_id}> a <http://example.org/ziweidoushu/pattern#TongYuanRule> ;
                 <http://example.org/ziweidoushu/pattern#tongYuanRuleId> "{rule_id}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#tongYuanSubject> "{subject}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#tongYuanBranchCond> "{branch_cond}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#tongYuanAccompany> "{accompany}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#tongYuanStemCond> "{stem_cond}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#tongYuanQuote> "{quote}"^^xsd:string .
source       SELECT rule_id,
                 COALESCE(subject, '') AS subject,
                 COALESCE(branch_cond, '') AS branch_cond,
                 COALESCE(accompany, '') AS accompany,
                 COALESCE(stem_cond, '') AS stem_cond,
                 COALESCE(quote, '') AS quote
             FROM tongyuan_rule
             WHERE rule_id IS NOT NULL

mappingId    star_character
target       <http://example.org/ziweidoushu/pattern#StarCharacter_{seq}> a <http://example.org/ziweidoushu/pattern#StarCharacter> ;
                 <http://example.org/ziweidoushu/pattern#rowSeq> "{seq}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#col0> "{col0}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#col1> "{col1}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#col2> "{col2}"^^xsd:string  .
source       SELECT seq,
                 COALESCE(`star`, '') AS col0,
                 COALESCE(`hua_qi`, '') AS col1,
                 COALESCE(`suo_zhu`, '') AS col2
             FROM star_character
             WHERE seq IS NOT NULL

mappingId    star_xingxing
target       <http://example.org/ziweidoushu/pattern#StarXingXing_{seq}> a <http://example.org/ziweidoushu/pattern#StarXingXing> ;
                 <http://example.org/ziweidoushu/pattern#rowSeq> "{seq}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#col0> "{col0}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#col1> "{col1}"^^xsd:string  .
source       SELECT seq,
                 COALESCE(`star`, '') AS col0,
                 COALESCE(`xing_xiang`, '') AS col1
             FROM star_xingxing
             WHERE seq IS NOT NULL

mappingId    star_qa_character
target       <http://example.org/ziweidoushu/pattern#StarQaCharacter_{seq}> a <http://example.org/ziweidoushu/pattern#StarQaCharacter> ;
                 <http://example.org/ziweidoushu/pattern#rowSeq> "{seq}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#col0> "{col0}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#col1> "{col1}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#col2> "{col2}"^^xsd:string  .
source       SELECT seq,
                 COALESCE(`star`, '') AS col0,
                 COALESCE(`category`, '') AS col1,
                 COALESCE(`quote`, '') AS col2
             FROM star_qa_character
             WHERE seq IS NOT NULL

mappingId    verify_star_traits
target       <http://example.org/ziweidoushu/pattern#VerifyStarTraits_{seq}> a <http://example.org/ziweidoushu/pattern#VerifyStarTraits> ;
                 <http://example.org/ziweidoushu/pattern#rowSeq> "{seq}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#col0> "{col0}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#col1> "{col1}"^^xsd:string  .
source       SELECT seq,
                 COALESCE(`star`, '') AS col0,
                 COALESCE(`traits`, '') AS col1
             FROM verify_star_traits
             WHERE seq IS NOT NULL

mappingId    verify_bureau_traits
target       <http://example.org/ziweidoushu/pattern#VerifyBureauTraits_{seq}> a <http://example.org/ziweidoushu/pattern#VerifyBureauTraits> ;
                 <http://example.org/ziweidoushu/pattern#rowSeq> "{seq}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#col0> "{col0}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#col1> "{col1}"^^xsd:string  .
source       SELECT seq,
                 COALESCE(`bureau`, '') AS col0,
                 COALESCE(`traits`, '') AS col1
             FROM verify_bureau_traits
             WHERE seq IS NOT NULL

mappingId    taisui_xiaoxian
target       <http://example.org/ziweidoushu/pattern#TaisuiXiaoxian_{seq}> a <http://example.org/ziweidoushu/pattern#TaisuiXiaoxian> ;
                 <http://example.org/ziweidoushu/pattern#rowSeq> "{seq}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#col0> "{col0}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#col1> "{col1}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#col2> "{col2}"^^xsd:string  .
source       SELECT seq,
                 COALESCE(`ji_seg`, '') AS col0,
                 COALESCE(`xiong_seg`, '') AS col1,
                 COALESCE(`star_seg`, '') AS col2
             FROM taisui_xiaoxian
             WHERE seq IS NOT NULL

mappingId    palace_zhi_ge
target       <http://example.org/ziweidoushu/pattern#PalaceZhiGe_{seq}> a <http://example.org/ziweidoushu/pattern#PalaceZhiGe> ;
                 <http://example.org/ziweidoushu/pattern#rowSeq> "{seq}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#col0> "{col0}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#col1> "{col1}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#col2> "{col2}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#col3> "{col3}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#col4> "{col4}"^^xsd:string  .
source       SELECT seq,
                 COALESCE(`branch`, '') AS col0,
                 COALESCE(`need_ming`, '') AS col1,
                 COALESCE(`need_sf`, '') AS col2,
                 COALESCE(`ge_ju`, '') AS col3,
                 COALESCE(`stem_cond`, '') AS col4
             FROM palace_zhi_ge
             WHERE seq IS NOT NULL

mappingId    palace_zhi_po
target       <http://example.org/ziweidoushu/pattern#PalaceZhiPo_{seq}> a <http://example.org/ziweidoushu/pattern#PalaceZhiPo> ;
                 <http://example.org/ziweidoushu/pattern#rowSeq> "{seq}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#col0> "{col0}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#col1> "{col1}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#col2> "{col2}"^^xsd:string  .
source       SELECT seq,
                 COALESCE(`branch`, '') AS col0,
                 COALESCE(`stars`, '') AS col1,
                 COALESCE(`quote`, '') AS col2
             FROM palace_zhi_po
             WHERE seq IS NOT NULL

mappingId    palace_fugui
target       <http://example.org/ziweidoushu/pattern#PalaceFuGui_{seq}> a <http://example.org/ziweidoushu/pattern#PalaceFuGui> ;
                 <http://example.org/ziweidoushu/pattern#rowSeq> "{seq}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#col0> "{col0}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#col1> "{col1}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#col2> "{col2}"^^xsd:string  .
source       SELECT seq,
                 COALESCE(`branch`, '') AS col0,
                 COALESCE(`stars`, '') AS col1,
                 COALESCE(`quote`, '') AS col2
             FROM palace_fugui
             WHERE seq IS NOT NULL

mappingId    palace_pinjian
target       <http://example.org/ziweidoushu/pattern#PalacePinJian_{seq}> a <http://example.org/ziweidoushu/pattern#PalacePinJian> ;
                 <http://example.org/ziweidoushu/pattern#rowSeq> "{seq}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#col0> "{col0}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#col1> "{col1}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#col2> "{col2}"^^xsd:string  .
source       SELECT seq,
                 COALESCE(`branch`, '') AS col0,
                 COALESCE(`stars`, '') AS col1,
                 COALESCE(`quote`, '') AS col2
             FROM palace_pinjian
             WHERE seq IS NOT NULL

mappingId    idle_verse
target       <http://example.org/ziweidoushu/pattern#IdleVerse_{seq}> a <http://example.org/ziweidoushu/pattern#IdleVerse> ;
                 <http://example.org/ziweidoushu/pattern#rowSeq> "{seq}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#col0> "{col0}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#col1> "{col1}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#col2> "{col2}"^^xsd:string  .
source       SELECT seq,
                 COALESCE(`star`, '') AS col0,
                 COALESCE(`c_line`, '') AS col1,
                 COALESCE(`quote`, '') AS col2
             FROM idle_verse
             WHERE seq IS NOT NULL

mappingId    idle_star
target       <http://example.org/ziweidoushu/pattern#IdleStar_{seq}> a <http://example.org/ziweidoushu/pattern#IdleStar> ;
                 <http://example.org/ziweidoushu/pattern#rowSeq> "{seq}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#col0> "{col0}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#col1> "{col1}"^^xsd:string  .
source       SELECT seq,
                 COALESCE(`star`, '') AS col0,
                 COALESCE(`branches`, '') AS col1
             FROM idle_star
             WHERE seq IS NOT NULL

mappingId    brightness_variant
target       <http://example.org/ziweidoushu/pattern#BrightnessVariant_{seq}> a <http://example.org/ziweidoushu/pattern#BrightnessVariant> ;
                 <http://example.org/ziweidoushu/pattern#rowSeq> "{seq}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#col0> "{col0}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#col1> "{col1}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#col2> "{col2}"^^xsd:string  .
source       SELECT seq,
                 COALESCE(`star`, '') AS col0,
                 COALESCE(`branch`, '') AS col1,
                 COALESCE(`note`, '') AS col2
             FROM brightness_variant
             WHERE seq IS NOT NULL

mappingId    limit_taboo
target       <http://example.org/ziweidoushu/pattern#LimitTaboo_{seq}> a <http://example.org/ziweidoushu/pattern#LimitTaboo> ;
                 <http://example.org/ziweidoushu/pattern#rowSeq> "{seq}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#col0> "{col0}"^^xsd:string  .
source       SELECT seq,
                 COALESCE(`quote`, '') AS col0
             FROM limit_taboo
             WHERE seq IS NOT NULL

mappingId    sihua_qa
target       <http://example.org/ziweidoushu/pattern#SihuaQa_{seq}> a <http://example.org/ziweidoushu/pattern#SihuaQa> ;
                 <http://example.org/ziweidoushu/pattern#rowSeq> "{seq}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#col0> "{col0}"^^xsd:string  .
source       SELECT seq,
                 COALESCE(`quote`, '') AS col0
             FROM sihua_qa
             WHERE seq IS NOT NULL

mappingId    star_block_all
target       <http://example.org/ziweidoushu/pattern#StarBlockAll_{seq}> a <http://example.org/ziweidoushu/pattern#StarBlockAll> ;
                 <http://example.org/ziweidoushu/pattern#rowSeq> "{seq}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#col0> "{col0}"^^xsd:string  .
source       SELECT seq,
                 COALESCE(`name`, '') AS col0
             FROM star_block_all
             WHERE seq IS NOT NULL

mappingId    classic_corpus
target       <http://example.org/ziweidoushu/pattern#ClassicCorpus_{seq}> a <http://example.org/ziweidoushu/pattern#ClassicCorpus> ;
                 <http://example.org/ziweidoushu/pattern#rowSeq> "{seq}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#col0> "{col0}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#col1> "{col1}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#col2> "{col2}"^^xsd:string  .
source       SELECT seq,
                 COALESCE(`palace`, '') AS col0,
                 COALESCE(CAST(`line_no` AS CHAR), '') AS col1,
                 COALESCE(`quote`, '') AS col2
             FROM classic_corpus
             WHERE seq IS NOT NULL



mappingId    pattern_verse
target       <http://example.org/ziweidoushu/pattern#PatternVerse_{seq}> a <http://example.org/ziweidoushu/pattern#PatternVerse> ;
                 <http://example.org/ziweidoushu/pattern#rowSeq> "{seq}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#col0> "{col0}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#col1> "{col1}"^^xsd:string ;
                 <http://example.org/ziweidoushu/pattern#col2> "{col2}"^^xsd:string  .
source       SELECT seq,
                 COALESCE(`verse_key`, '') AS col0,
                 COALESCE(`display_text`, '') AS col1,
                 COALESCE(`method_tag`, '') AS col2
             FROM pattern_verse
             WHERE seq IS NOT NULL
]]
