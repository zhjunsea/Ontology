<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/ziweidoushu/chart"
     xml:base="http://example.org/ziweidoushu/chart"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:core="http://example.org/ziweidoushu/core#"
     xmlns:calendar="http://example.org/ziweidoushu/calendar#"
     xmlns:chart="http://example.org/ziweidoushu/chart#"
     xmlns:star="http://example.org/ziweidoushu/star#"
     xmlns:layout="http://example.org/ziweidoushu/layout#"
     xmlns:state="http://example.org/ziweidoushu/state#"
     xmlns:palace="http://example.org/ziweidoushu/palace#"
     xmlns:pattern="http://example.org/ziweidoushu/pattern#"
     xmlns:fortune="http://example.org/ziweidoushu/fortune#"
     xmlns:reading="http://example.org/ziweidoushu/reading#"
     xmlns:diagnosis="http://example.org/ziweidoushu/diagnosis#"
     xmlns:rules="http://example.org/ziweidoushu/rules#">

    <owl:Ontology rdf:about="http://example.org/ziweidoushu/chart">
        <owl:imports rdf:resource="http://example.org/ziweidoushu/core"/>
        <owl:imports rdf:resource="http://example.org/ziweidoushu/calendar"/>
        <rdfs:label xml:lang="zh">紫微斗数本体 TBox 子本体 · chart（排盘（生辰输入/命盘/十二宫/命身宫/宫干/命主身主））</rdfs:label>
        <rdfs:comment xml:lang="zh">第 10 步产出：TBox 按业务域拆分。命名空间 http://example.org/ziweidoushu/chart 不变；由 ziweidoushu-tbox.owl 聚合入口统一 imports；imports 单向无环（§4.2）。依据《紫微斗數全書》（[宋]陈抟（陈希夷）撰）。属性值一律使用完整绝对 IRI。</rdfs:comment>
    </owl:Ontology>

    <!-- ============================ 1. 类体系 · chart: 排盘域 + star: 星曜域 ============================ -->

<owl:Class rdf:about="http://example.org/ziweidoushu/chart#ChartDomain"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/core#ZiWeiDouShuEntity"/><rdfs:label xml:lang="zh">排盘域</rdfs:label><skos:exactMatch rdf:resource="http://example.org/ziweidoushu/term/ChartDomain"/></owl:Class>

<owl:Class rdf:about="http://example.org/ziweidoushu/chart#BirthInput"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/chart#ChartDomain"/><rdfs:label xml:lang="zh">生辰输入（公历/农历·年月日时·性别·经度·命主类别·输入模式·推演深度·运限粒度）</rdfs:label><skos:exactMatch rdf:resource="http://example.org/ziweidoushu/term/BirthInput"/></owl:Class>

<owl:Class rdf:about="http://example.org/ziweidoushu/chart#NatalChart"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/chart#ChartDomain"/><rdfs:label xml:lang="zh">命盘</rdfs:label><skos:exactMatch rdf:resource="http://example.org/ziweidoushu/term/NatalChart"/></owl:Class>

<owl:Class rdf:about="http://example.org/ziweidoushu/chart#Palace"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/chart#ChartDomain"/><rdfs:label xml:lang="zh">宫</rdfs:label><skos:exactMatch rdf:resource="http://example.org/ziweidoushu/term/Palace"/></owl:Class>

<owl:Class rdf:about="http://example.org/ziweidoushu/chart#Palace_Ming"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/chart#Palace"/><rdfs:label xml:lang="zh">命宫</rdfs:label><skos:exactMatch rdf:resource="http://example.org/ziweidoushu/term/Palace_Ming"/></owl:Class>

<owl:Class rdf:about="http://example.org/ziweidoushu/chart#Palace_XiongDi"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/chart#Palace"/><rdfs:label xml:lang="zh">兄弟宫</rdfs:label><skos:exactMatch rdf:resource="http://example.org/ziweidoushu/term/Palace_XiongDi"/></owl:Class>

<owl:Class rdf:about="http://example.org/ziweidoushu/chart#Palace_FuQi"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/chart#Palace"/><rdfs:label xml:lang="zh">夫妻宫</rdfs:label><skos:exactMatch rdf:resource="http://example.org/ziweidoushu/term/Palace_FuQi"/></owl:Class>

<owl:Class rdf:about="http://example.org/ziweidoushu/chart#Palace_ZiNv"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/chart#Palace"/><rdfs:label xml:lang="zh">子女宫</rdfs:label><skos:exactMatch rdf:resource="http://example.org/ziweidoushu/term/Palace_ZiNv"/></owl:Class>

<owl:Class rdf:about="http://example.org/ziweidoushu/chart#Palace_CaiBo"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/chart#Palace"/><rdfs:label xml:lang="zh">财帛宫</rdfs:label><skos:exactMatch rdf:resource="http://example.org/ziweidoushu/term/Palace_CaiBo"/></owl:Class>

<owl:Class rdf:about="http://example.org/ziweidoushu/chart#Palace_JiE"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/chart#Palace"/><rdfs:label xml:lang="zh">疾厄宫</rdfs:label><skos:exactMatch rdf:resource="http://example.org/ziweidoushu/term/Palace_JiE"/></owl:Class>

<owl:Class rdf:about="http://example.org/ziweidoushu/chart#Palace_QianYi"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/chart#Palace"/><rdfs:label xml:lang="zh">迁移宫</rdfs:label><skos:exactMatch rdf:resource="http://example.org/ziweidoushu/term/Palace_QianYi"/></owl:Class>

<owl:Class rdf:about="http://example.org/ziweidoushu/chart#Palace_JiaoYou"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/chart#Palace"/><rdfs:label xml:lang="zh">交友宫（仆役宫）</rdfs:label><skos:exactMatch rdf:resource="http://example.org/ziweidoushu/term/Palace_JiaoYou"/></owl:Class>

<owl:Class rdf:about="http://example.org/ziweidoushu/chart#Palace_GuanLu"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/chart#Palace"/><rdfs:label xml:lang="zh">官禄宫</rdfs:label><skos:exactMatch rdf:resource="http://example.org/ziweidoushu/term/Palace_GuanLu"/></owl:Class>

<owl:Class rdf:about="http://example.org/ziweidoushu/chart#Palace_TianZhai"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/chart#Palace"/><rdfs:label xml:lang="zh">田宅宫</rdfs:label><skos:exactMatch rdf:resource="http://example.org/ziweidoushu/term/Palace_TianZhai"/></owl:Class>

<owl:Class rdf:about="http://example.org/ziweidoushu/chart#Palace_FuDe"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/chart#Palace"/><rdfs:label xml:lang="zh">福德宫</rdfs:label><skos:exactMatch rdf:resource="http://example.org/ziweidoushu/term/Palace_FuDe"/></owl:Class>

<owl:Class rdf:about="http://example.org/ziweidoushu/chart#Palace_FuMu"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/chart#Palace"/><rdfs:label xml:lang="zh">父母宫</rdfs:label><skos:exactMatch rdf:resource="http://example.org/ziweidoushu/term/Palace_FuMu"/></owl:Class>

<owl:Class rdf:about="http://example.org/ziweidoushu/chart#LifePalace"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/chart#ChartDomain"/><rdfs:label xml:lang="zh">命宫（本体类·安命）</rdfs:label><skos:exactMatch rdf:resource="http://example.org/ziweidoushu/term/LifePalace"/></owl:Class>

<owl:Class rdf:about="http://example.org/ziweidoushu/chart#BodyPalace"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/chart#ChartDomain"/><rdfs:label xml:lang="zh">身宫</rdfs:label><skos:exactMatch rdf:resource="http://example.org/ziweidoushu/term/BodyPalace"/></owl:Class>

<owl:Class rdf:about="http://example.org/ziweidoushu/chart#PalaceStem"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/chart#ChartDomain"/><rdfs:label xml:lang="zh">宫干（五鼠遁）</rdfs:label><skos:exactMatch rdf:resource="http://example.org/ziweidoushu/term/PalaceStem"/></owl:Class>

<owl:Class rdf:about="http://example.org/ziweidoushu/chart#LifeMaster"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/chart#ChartDomain"/><rdfs:label xml:lang="zh">命主</rdfs:label><skos:exactMatch rdf:resource="http://example.org/ziweidoushu/term/LifeMaster"/></owl:Class>

<owl:Class rdf:about="http://example.org/ziweidoushu/chart#BodyMaster"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/chart#ChartDomain"/><rdfs:label xml:lang="zh">身主</rdfs:label><skos:exactMatch rdf:resource="http://example.org/ziweidoushu/term/BodyMaster"/></owl:Class>

<owl:Class rdf:about="http://example.org/ziweidoushu/chart#MingChartSkeleton"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/chart#ChartDomain"/><rdfs:label xml:lang="zh">命盘骨架（十二宫+命身宫+五行局+命主身主）</rdfs:label><skos:exactMatch rdf:resource="http://example.org/ziweidoushu/term/MingChartSkeleton"/></owl:Class>

<owl:Class rdf:about="http://example.org/ziweidoushu/chart#PilotLimit"><rdfs:subClassOf rdf:resource="http://example.org/ziweidoushu/chart#ChartDomain"/><rdfs:label xml:lang="zh">限（大限/童限/小限 之起法结果）</rdfs:label><skos:exactMatch rdf:resource="http://example.org/ziweidoushu/term/PilotLimit"/></owl:Class>

<owl:ObjectProperty rdf:about="http://example.org/ziweidoushu/chart#hasBirthInput"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/><owl:inverseOf rdf:resource="http://example.org/ziweidoushu/chart#isBirthInputOf"/><rdfs:domain rdf:resource="http://example.org/ziweidoushu/chart#NatalChart"/><rdfs:range rdf:resource="http://example.org/ziweidoushu/chart#BirthInput"/><rdfs:label xml:lang="zh">有生辰输入</rdfs:label><skos:exactMatch rdf:resource="http://example.org/ziweidoushu/term/hasBirthInput"/></owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://example.org/ziweidoushu/chart#isBirthInputOf"><owl:inverseOf rdf:resource="http://example.org/ziweidoushu/chart#hasBirthInput"/><rdfs:domain rdf:resource="http://example.org/ziweidoushu/chart#BirthInput"/><rdfs:range rdf:resource="http://example.org/ziweidoushu/chart#NatalChart"/></owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://example.org/ziweidoushu/chart#hasSkeleton"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/><owl:inverseOf rdf:resource="http://example.org/ziweidoushu/chart#isSkeletonOf"/><rdfs:domain rdf:resource="http://example.org/ziweidoushu/chart#NatalChart"/><rdfs:range rdf:resource="http://example.org/ziweidoushu/chart#MingChartSkeleton"/><rdfs:label xml:lang="zh">有命盘骨架</rdfs:label><skos:exactMatch rdf:resource="http://example.org/ziweidoushu/term/hasSkeleton"/></owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://example.org/ziweidoushu/chart#isSkeletonOf"><owl:inverseOf rdf:resource="http://example.org/ziweidoushu/chart#hasSkeleton"/><rdfs:domain rdf:resource="http://example.org/ziweidoushu/chart#MingChartSkeleton"/><rdfs:range rdf:resource="http://example.org/ziweidoushu/chart#NatalChart"/></owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://example.org/ziweidoushu/chart#hasPalace"><owl:inverseOf rdf:resource="http://example.org/ziweidoushu/chart#isPalaceOf"/><rdfs:domain rdf:resource="http://example.org/ziweidoushu/chart#NatalChart"/><rdfs:range rdf:resource="http://example.org/ziweidoushu/chart#Palace"/><rdfs:label xml:lang="zh">有宫</rdfs:label><skos:exactMatch rdf:resource="http://example.org/ziweidoushu/term/hasPalace"/></owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://example.org/ziweidoushu/chart#isPalaceOf"><owl:inverseOf rdf:resource="http://example.org/ziweidoushu/chart#hasPalace"/><rdfs:domain rdf:resource="http://example.org/ziweidoushu/chart#Palace"/><rdfs:range rdf:resource="http://example.org/ziweidoushu/chart#NatalChart"/></owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://example.org/ziweidoushu/chart#hasLifePalace"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/><owl:inverseOf rdf:resource="http://example.org/ziweidoushu/chart#isLifePalaceOf"/><rdfs:domain rdf:resource="http://example.org/ziweidoushu/chart#NatalChart"/><rdfs:range rdf:resource="http://example.org/ziweidoushu/chart#LifePalace"/><rdfs:label xml:lang="zh">有命宫</rdfs:label><skos:exactMatch rdf:resource="http://example.org/ziweidoushu/term/hasLifePalace"/></owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://example.org/ziweidoushu/chart#isLifePalaceOf"><owl:inverseOf rdf:resource="http://example.org/ziweidoushu/chart#hasLifePalace"/><rdfs:domain rdf:resource="http://example.org/ziweidoushu/chart#LifePalace"/><rdfs:range rdf:resource="http://example.org/ziweidoushu/chart#NatalChart"/></owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://example.org/ziweidoushu/chart#hasBodyPalace"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/><owl:inverseOf rdf:resource="http://example.org/ziweidoushu/chart#isBodyPalaceOf"/><rdfs:domain rdf:resource="http://example.org/ziweidoushu/chart#NatalChart"/><rdfs:range rdf:resource="http://example.org/ziweidoushu/chart#BodyPalace"/><rdfs:label xml:lang="zh">有身宫</rdfs:label><skos:exactMatch rdf:resource="http://example.org/ziweidoushu/term/hasBodyPalace"/></owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://example.org/ziweidoushu/chart#isBodyPalaceOf"><owl:inverseOf rdf:resource="http://example.org/ziweidoushu/chart#hasBodyPalace"/><rdfs:domain rdf:resource="http://example.org/ziweidoushu/chart#BodyPalace"/><rdfs:range rdf:resource="http://example.org/ziweidoushu/chart#NatalChart"/></owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://example.org/ziweidoushu/chart#hasBureau"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/><owl:inverseOf rdf:resource="http://example.org/ziweidoushu/chart#isBureauOf"/><rdfs:domain rdf:resource="http://example.org/ziweidoushu/chart#NatalChart"/><rdfs:range rdf:resource="http://example.org/ziweidoushu/core#FivePhaseBureau"/><rdfs:label xml:lang="zh">有五行局</rdfs:label><skos:exactMatch rdf:resource="http://example.org/ziweidoushu/term/chart_hasBureau"/></owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://example.org/ziweidoushu/chart#isBureauOf"><owl:inverseOf rdf:resource="http://example.org/ziweidoushu/chart#hasBureau"/><rdfs:domain rdf:resource="http://example.org/ziweidoushu/core#FivePhaseBureau"/><rdfs:range rdf:resource="http://example.org/ziweidoushu/chart#NatalChart"/></owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://example.org/ziweidoushu/chart#hasPalaceStem"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/><owl:inverseOf rdf:resource="http://example.org/ziweidoushu/chart#isPalaceStemOf"/><rdfs:domain rdf:resource="http://example.org/ziweidoushu/chart#Palace"/><rdfs:range rdf:resource="http://example.org/ziweidoushu/core#HeavenlyStem"/><rdfs:label xml:lang="zh">宫干（五鼠遁）</rdfs:label><skos:exactMatch rdf:resource="http://example.org/ziweidoushu/term/hasPalaceStem"/></owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://example.org/ziweidoushu/chart#isPalaceStemOf"><owl:inverseOf rdf:resource="http://example.org/ziweidoushu/chart#hasPalaceStem"/><rdfs:domain rdf:resource="http://example.org/ziweidoushu/core#HeavenlyStem"/><rdfs:range rdf:resource="http://example.org/ziweidoushu/chart#Palace"/></owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://example.org/ziweidoushu/chart#hasBranch"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/><owl:inverseOf rdf:resource="http://example.org/ziweidoushu/chart#isBranchOf"/><rdfs:domain rdf:resource="http://example.org/ziweidoushu/chart#Palace"/><rdfs:range rdf:resource="http://example.org/ziweidoushu/core#EarthlyBranch"/><rdfs:label xml:lang="zh">宫之支</rdfs:label><skos:exactMatch rdf:resource="http://example.org/ziweidoushu/term/chart_hasBranch"/></owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://example.org/ziweidoushu/chart#isBranchOf"><owl:inverseOf rdf:resource="http://example.org/ziweidoushu/chart#hasBranch"/><rdfs:domain rdf:resource="http://example.org/ziweidoushu/core#EarthlyBranch"/><rdfs:range rdf:resource="http://example.org/ziweidoushu/chart#Palace"/></owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://example.org/ziweidoushu/chart#hasLifeMaster"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/><owl:inverseOf rdf:resource="http://example.org/ziweidoushu/chart#isLifeMasterOf"/><rdfs:domain rdf:resource="http://example.org/ziweidoushu/chart#NatalChart"/><rdfs:range rdf:resource="http://example.org/ziweidoushu/chart#LifeMaster"/><rdfs:label xml:lang="zh">有命主</rdfs:label><skos:exactMatch rdf:resource="http://example.org/ziweidoushu/term/hasLifeMaster"/></owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://example.org/ziweidoushu/chart#isLifeMasterOf"><owl:inverseOf rdf:resource="http://example.org/ziweidoushu/chart#hasLifeMaster"/><rdfs:domain rdf:resource="http://example.org/ziweidoushu/chart#LifeMaster"/><rdfs:range rdf:resource="http://example.org/ziweidoushu/chart#NatalChart"/></owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://example.org/ziweidoushu/chart#hasBodyMaster"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/><owl:inverseOf rdf:resource="http://example.org/ziweidoushu/chart#isBodyMasterOf"/><rdfs:domain rdf:resource="http://example.org/ziweidoushu/chart#NatalChart"/><rdfs:range rdf:resource="http://example.org/ziweidoushu/chart#BodyMaster"/><rdfs:label xml:lang="zh">有身主</rdfs:label><skos:exactMatch rdf:resource="http://example.org/ziweidoushu/term/hasBodyMaster"/></owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://example.org/ziweidoushu/chart#isBodyMasterOf"><owl:inverseOf rdf:resource="http://example.org/ziweidoushu/chart#hasBodyMaster"/><rdfs:domain rdf:resource="http://example.org/ziweidoushu/chart#BodyMaster"/><rdfs:range rdf:resource="http://example.org/ziweidoushu/chart#NatalChart"/></owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="http://example.org/ziweidoushu/chart#birthDate"><rdfs:domain rdf:resource="http://example.org/ziweidoushu/chart#BirthInput"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">生辰（公历或农历）</rdfs:label><skos:exactMatch rdf:resource="http://example.org/ziweidoushu/term/birthDate"/></owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://example.org/ziweidoushu/chart#calendarType"><rdfs:domain rdf:resource="http://example.org/ziweidoushu/chart#BirthInput"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">历法类型（公历/农历）</rdfs:label><skos:exactMatch rdf:resource="http://example.org/ziweidoushu/term/calendarType"/></owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://example.org/ziweidoushu/chart#birthHour"><rdfs:domain rdf:resource="http://example.org/ziweidoushu/chart#BirthInput"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">时辰</rdfs:label><skos:exactMatch rdf:resource="http://example.org/ziweidoushu/term/birthHour"/></owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://example.org/ziweidoushu/chart#gender"><rdfs:domain rdf:resource="http://example.org/ziweidoushu/chart#BirthInput"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">性别（男/女）</rdfs:label><skos:exactMatch rdf:resource="http://example.org/ziweidoushu/term/gender"/></owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://example.org/ziweidoushu/chart#subjectType"><rdfs:domain rdf:resource="http://example.org/ziweidoushu/chart#BirthInput"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">命主类别（成人男/成人女/小儿）</rdfs:label><skos:exactMatch rdf:resource="http://example.org/ziweidoushu/term/subjectType"/></owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://example.org/ziweidoushu/chart#mode"><rdfs:domain rdf:resource="http://example.org/ziweidoushu/chart#BirthInput"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">输入模式（直接排盘/验盘）</rdfs:label><skos:exactMatch rdf:resource="http://example.org/ziweidoushu/term/mode"/></owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://example.org/ziweidoushu/chart#depth"><rdfs:domain rdf:resource="http://example.org/ziweidoushu/chart#BirthInput"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">推演深度（本命/本命+大限/本命+大限+流年）</rdfs:label><skos:exactMatch rdf:resource="http://example.org/ziweidoushu/term/depth"/></owl:DatatypeProperty>

