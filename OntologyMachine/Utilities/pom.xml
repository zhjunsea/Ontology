<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.ocean</groupId>
    <artifactId>Utilities</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>Utilities</name>
    <description>与业务无关的通用工具库（JUnit 超时中止扩展 / RabbitMQ 发送封装 / 本体标签匹配 / YAML 外科式赋值 / 配置定位 / JobWorker 初始化骨架）</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>26</java.version>
        <spring-ai.version>2.0.1</spring-ai.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring AI BOM：统一 spring-ai-* 版本（经试构建验证，2.0.1 与 Spring Boot 4.1.0 / Java 26 兼容） -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- OntologyLabelMatcher / OntologyWorkerSupport 依赖 BackendService、QueryService -->
        <dependency>
            <groupId>com.ocean</groupId>
            <artifactId>OpenlletResolver</artifactId>
            <version>0.0.1-SNAPSHOT</version>
            <scope>compile</scope>
        </dependency>

        <!-- RabbitMqHandler：spring-amqp / spring-rabbit / amqp-client -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
            <version>4.1.0</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- ProcessOrchestrator：Camunda 8 流程编排通用机制（启流程 / 状态回读 / 幂等部署） -->
        <dependency>
            <groupId>io.camunda</groupId>
            <artifactId>camunda-client-java</artifactId>
            <version>8.9.6</version>
        </dependency>
        <!-- ZeebeClient 旧 API（ProcessOrchestrator.deployIfAbsent 重载，供测试代码使用 ZeebeClient 的场景） -->
        <dependency>
            <groupId>io.camunda</groupId>
            <artifactId>zeebe-client-java</artifactId>
            <version>8.9.6</version>
        </dependency>

        <!-- FileTransferSupport：MultipartFile 存盘 / Content-Disposition -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- ChatAgent：基于 Spring AI 的通用单轮对话封装（内部用 ChatClient + OpenAiChatModel）。
             注意：各宿主应用须设 spring.ai.model.*=none 关闭 Spring AI 默认自动配置，
             由 ChatAgent 按需自建模型（未配置 key 时应用照常启动、LLM 降级返回 null）。 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!-- McpClientHandler / McpServerHandler：MCP（Model Context Protocol）官方 Java SDK 封装
             （mcp = mcp-core + mcp-json-jackson3，自带 STDIO / JDK-HttpClient / Servlet 传输） -->
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp</artifactId>
            <version>2.0.1</version>
        </dependency>
        <!-- McpServerHandler.http 使用 HttpServletStreamableServerTransportProvider，需 Servlet API（由宿主容器提供） -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- StopOnTimeoutExtension 位于 main 源码，需 JUnit 5 扩展 API 以 compile 作用域引入 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
