<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>
    <groupId>com.ocean</groupId>
    <artifactId>OntologyFrameworkPlumBlossom</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>OntologyFrameworkPlumBlossom</name>
    <description>OntologyFrameworkPlumBlossom - 梅花易数占断本体应用（依《梅花易数》原著起卦断占）</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>27</java.version>
        <owlapi.version>5.1.20</owlapi.version>
        <ontop.version>5.5.0</ontop.version>
        <jena.version>6.1.0</jena.version>
        <camunda.version>8.10.0-alpha2</camunda.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.apache.jena</groupId>
            <artifactId>jena-arq</artifactId>
            <version>${jena.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-simple</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.apache.jena</groupId>
            <artifactId>jena-rdfconnection</artifactId>
            <version>${jena.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-simple</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.camunda</groupId>
            <artifactId>zeebe-process-test-extension</artifactId>
            <version>8.9.6</version>
        </dependency>
        <dependency>
            <groupId>com.ocean</groupId>
            <artifactId>OpenlletResolver</artifactId>
            <version>0.0.1-SNAPSHOT</version>
            <scope>compile</scope>
            <!-- 统一 SLF4J 绑定：Spring Boot 已提供 logback；此处排除 log4j 的 SLF4J 绑定与核心实现，
                 避免运行期出现「multiple SLF4J providers」告警（日志统一走 logback）。 -->
            <exclusions>
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-slf4j2-impl</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.ocean</groupId>
            <artifactId>Utilities</artifactId>
            <version>0.0.1-SNAPSHOT</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>com.ocean</groupId>
            <artifactId>OntopOBDAHandler</artifactId>
            <version>0.0.1-SNAPSHOT</version>
            <scope>compile</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-slf4j2-impl</artifactId>
                </exclusion>
                <!-- 统一 SLF4J 绑定：排除 OntopOBDAHandler 传递引入的 slf4j-simple，
                     保留 Spring Boot 的 logback 作为唯一 SLF4J 实现（消除「multiple SLF4J providers」）。 -->
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-simple</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.camunda</groupId>
            <artifactId>spring-boot-starter-camunda-sdk</artifactId>
            <version>8.9.6</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
            <version>4.1.0</version>
        </dependency>
        <dependency>
            <groupId>net.sourceforge.owlapi</groupId>
            <artifactId>owlapi-parsers</artifactId>
            <version>5.5.1</version>
        </dependency>
        <!-- AllPlumBlossomSuiteTest（总入口套件，@Suite + @SelectClasses）需要 suite 引擎 -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 显式钉住编译发行版为 27（与根 java.version 一致），避免 IDE/工具链按低版本并开启预览特性
                 误编译（报「源发行版 26 与 enable-preview 一起使用时无效」）。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>27</release>
                    <parameters>true</parameters>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- JDK 27（FFM/Unsafe）运行期提示：显式放开 native-access 与 unsafe 内存访问，
                         避免启动日志出现 native-access 相关告警。IDE 直接运行请在
                         Run/Debug Configurations 的 VM options 里加同样两项。 -->
                    <jvmArguments>--enable-native-access=ALL-UNNAMED --sun-misc-unsafe-memory-access=allow</jvmArguments>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useManifestOnlyJar>false</useManifestOnlyJar>
                    <!-- AllPlumBlossomSuiteTest（@Suite + @SelectClasses）已包含下列测试类；
                         surefire 默认又会独立发现它们，导致同一测试类被运行两遍
                         （内存引擎测试第二遍会因 Spring 上下文复用已停止的引擎而失败）。
                         故将套件成员类从 surefire 直接发现中排除，只经套件入口运行一次。 -->
                    <excludes>
                        <exclude>**/PlumBlossomOntologyComplianceTest.java</exclude>
                        <exclude>**/PlumBlossomSkosTerminologyTest.java</exclude>
                        <exclude>**/PlumBlossomSwrlRabbitMqTest.java</exclude>
                        <exclude>**/PlumBlossomBpmnInMemoryTest.java</exclude>
                        <exclude>**/PlumBlossomBpmnRealEngineTest.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
