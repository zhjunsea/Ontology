<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns="http://example.org/plumblossom/relations"
         xml:base="http://example.org/plumblossom/relations"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:swrl="http://www.w3.org/2003/11/swrl#"
         xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
         xmlns:core="http://example.org/plumblossom/core/"
         xmlns:div="http://example.org/plumblossom/divination/"
         xmlns:yijing="http://example.org/plumblossom/yijing/"
         xmlns:rel="http://example.org/plumblossom/relations/"
         xmlns:sym="http://example.org/plumblossom/symbols/"
         xmlns:ome="http://example.org/plumblossom/omens/"
         xmlns:jud="http://example.org/plumblossom/judgement/"
         xmlns:cal="http://example.org/plumblossom/calendars/"
         xmlns:rules="http://example.org/plumblossom/rules#">

    <owl:Ontology rdf:about="http://example.org/plumblossom/relations">
        <rdfs:label xml:lang="zh">梅花易数 TBox 子本体 · rel</rdfs:label>
        <rdfs:comment xml:lang="zh">第 10 步产出：TBox 按业务域拆分（关系：五行/生克/体用/旺衰/性情/阴阳次序）。命名空间保持 http://example.org/plumblossom/rel 不变；由 plumblossom-tbox.owl 聚合入口统一 imports。</rdfs:comment>
        <owl:imports rdf:resource="http://example.org/plumblossom/core"/>
        <owl:imports rdf:resource="http://example.org/plumblossom/symbols"/>
    </owl:Ontology>
    <owl:Class rdf:about="rel:YiliDomain">
        <rdfs:label xml:lang="zh">易理域</rdfs:label>
        <rdfs:subClassOf rdf:resource="core:PlumBlossomEntity"/>
    </owl:Class>

    <owl:Class rdf:about="rel:FivePhase">
        <rdfs:label xml:lang="zh">五行</rdfs:label>
        <rdfs:subClassOf rdf:resource="rel:YiliDomain"/>
    </owl:Class>

    <owl:Class rdf:about="rel:ShengKeRelation">
        <rdfs:label xml:lang="zh">五行生克关系</rdfs:label>
        <rdfs:subClassOf rdf:resource="rel:YiliDomain"/>
    </owl:Class>

    <owl:Class rdf:about="rel:Sheng">
        <rdfs:label xml:lang="zh">生</rdfs:label>
        <rdfs:subClassOf rdf:resource="rel:ShengKeRelation"/>
    </owl:Class>

    <owl:Class rdf:about="rel:Ke">
        <rdfs:label xml:lang="zh">克</rdfs:label>
        <rdfs:subClassOf rdf:resource="rel:ShengKeRelation"/>
    </owl:Class>

    <owl:Class rdf:about="rel:BodyUseRelation">
        <rdfs:label xml:lang="zh">体用关系</rdfs:label>
        <rdfs:subClassOf rdf:resource="rel:YiliDomain"/>
    </owl:Class>

    <owl:Class rdf:about="rel:VitalityState">
        <rdfs:label xml:lang="zh">卦气旺衰</rdfs:label>
        <rdfs:subClassOf rdf:resource="rel:YiliDomain"/>
    </owl:Class>

    <owl:Class rdf:about="rel:TrigramNature">
        <rdfs:label xml:lang="zh">八卦性情</rdfs:label>
        <rdfs:subClassOf rdf:resource="rel:YiliDomain"/>
    </owl:Class>

    <owl:Class rdf:about="rel:TrigramOrder">
        <rdfs:label xml:lang="zh">八卦定阴阳次序</rdfs:label>
        <rdfs:subClassOf rdf:resource="rel:YiliDomain"/>
    </owl:Class>

    <owl:ObjectProperty rdf:about="rel:hasBodyTrigram">
        <rdfs:label xml:lang="zh">有体卦</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="rel:BodyUseRelation"/>
        <rdfs:range rdf:resource="core:Trigram"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="rel:isBodyTrigramOf">
        <rdfs:domain rdf:resource="core:Trigram"/>
        <rdfs:range rdf:resource="rel:BodyUseRelation"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="rel:hasUseTrigram">
        <rdfs:label xml:lang="zh">有用卦</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="rel:BodyUseRelation"/>
        <rdfs:range rdf:resource="core:Trigram"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="rel:isUseTrigramOf">
        <rdfs:domain rdf:resource="core:Trigram"/>
        <rdfs:range rdf:resource="rel:BodyUseRelation"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="rel:hasFivePhase">
        <rdfs:label xml:lang="zh">有五行</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="core:Trigram"/>
        <rdfs:range rdf:resource="rel:FivePhase"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="rel:isFivePhaseOf">
        <rdfs:domain rdf:resource="rel:FivePhase"/>
        <rdfs:range rdf:resource="core:Trigram"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="rel:generates">
        <rdfs:label xml:lang="zh">生</rdfs:label>
        <rdfs:domain rdf:resource="rel:FivePhase"/>
        <rdfs:range rdf:resource="rel:FivePhase"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="rel:generatedBy">
        <rdfs:domain rdf:resource="rel:FivePhase"/>
        <rdfs:range rdf:resource="rel:FivePhase"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="rel:overcomes">
        <rdfs:label xml:lang="zh">克</rdfs:label>
        <rdfs:domain rdf:resource="rel:FivePhase"/>
        <rdfs:range rdf:resource="rel:FivePhase"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="rel:overcomeBy">
        <rdfs:domain rdf:resource="rel:FivePhase"/>
        <rdfs:range rdf:resource="rel:FivePhase"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="rel:hasVitalityState">
        <rdfs:label xml:lang="zh">有旺衰</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="core:Trigram"/>
        <rdfs:range rdf:resource="rel:VitalityState"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="rel:isVitalityStateOf">
        <rdfs:domain rdf:resource="rel:VitalityState"/>
        <rdfs:range rdf:resource="core:Trigram"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="rel:generates">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="rel:overcomes">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    </owl:ObjectProperty>

    <!-- ==================== 数据属性 ==================== -->
    <owl:DatatypeProperty rdf:about="rel:shengKeType">
        <rdfs:label xml:lang="zh">生克类型</rdfs:label>
        <rdfs:domain rdf:resource="rel:BodyUseRelation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="rel:vitality">
        <rdfs:label xml:lang="zh">旺相休囚死</rdfs:label>
        <rdfs:domain rdf:resource="rel:VitalityState"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="rel:natureText">
        <rdfs:label xml:lang="zh">性情文本</rdfs:label>
        <rdfs:domain rdf:resource="rel:TrigramNature"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:Class rdf:about="rel:BodyUseRelation">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="rel:hasBodyTrigram"/>
                <owl:qualifiedCardinality rdf:datatype="xsd:nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="core:Trigram"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="rel:BodyUseRelation">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="rel:hasUseTrigram"/>
                <owl:qualifiedCardinality rdf:datatype="xsd:nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="core:Trigram"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>


</rdf:RDF>
