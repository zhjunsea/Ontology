<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns="http://example.org/plumblossom/relations"
         xml:base="http://example.org/plumblossom/relations"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:swrl="http://www.w3.org/2003/11/swrl#"
         xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
         xmlns:core="http://example.org/plumblossom/core/"
         xmlns:div="http://example.org/plumblossom/divination/"
         xmlns:yijing="http://example.org/plumblossom/yijing/"
         xmlns:rel="http://example.org/plumblossom/relations/"
         xmlns:sym="http://example.org/plumblossom/symbols/"
         xmlns:ome="http://example.org/plumblossom/omens/"
         xmlns:jud="http://example.org/plumblossom/judgement/"
         xmlns:cal="http://example.org/plumblossom/calendars/"
         xmlns:rules="http://example.org/plumblossom/rules#">

    <owl:Ontology rdf:about="http://example.org/plumblossom/relations">
        <rdfs:label xml:lang="zh">梅花易数 TBox 子本体 · rel</rdfs:label>
        <rdfs:comment xml:lang="zh">第 10 步产出：TBox 按业务域拆分（关系：五行/生克/体用/旺衰/性情/阴阳次序）。命名空间保持 http://example.org/plumblossom/rel 不变；由 plumblossom-tbox.owl 聚合入口统一 imports。</rdfs:comment>
        <owl:imports rdf:resource="http://example.org/plumblossom/core"/>
        <owl:imports rdf:resource="http://example.org/plumblossom/symbols"/>
    </owl:Ontology>
    <owl:Class rdf:about="http://example.org/plumblossom/relations/YiliDomain">
        <rdfs:label xml:lang="zh">易理域</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://example.org/plumblossom/core/PlumBlossomEntity"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/plumblossom/relations/FivePhase">
        <rdfs:label xml:lang="zh">五行</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://example.org/plumblossom/relations/YiliDomain"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/plumblossom/relations/ShengKeRelation">
        <rdfs:label xml:lang="zh">五行生克关系</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://example.org/plumblossom/relations/YiliDomain"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/plumblossom/relations/Sheng">
        <rdfs:label xml:lang="zh">生</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://example.org/plumblossom/relations/ShengKeRelation"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/plumblossom/relations/Ke">
        <rdfs:label xml:lang="zh">克</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://example.org/plumblossom/relations/ShengKeRelation"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/plumblossom/relations/BodyUseRelation">
        <rdfs:label xml:lang="zh">体用关系</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://example.org/plumblossom/relations/YiliDomain"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/plumblossom/relations/VitalityState">
        <rdfs:label xml:lang="zh">卦气旺衰</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://example.org/plumblossom/relations/YiliDomain"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/plumblossom/relations/TrigramNature">
        <rdfs:label xml:lang="zh">八卦性情</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://example.org/plumblossom/relations/YiliDomain"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/plumblossom/relations/TrigramOrder">
        <rdfs:label xml:lang="zh">八卦定阴阳次序</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://example.org/plumblossom/relations/YiliDomain"/>
    </owl:Class>

    <owl:ObjectProperty rdf:about="http://example.org/plumblossom/relations/hasBodyTrigram">
        <rdfs:label xml:lang="zh">有体卦</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/relations/BodyUseRelation"/>
        <rdfs:range rdf:resource="http://example.org/plumblossom/core/Trigram"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/plumblossom/relations/isBodyTrigramOf">
        <rdfs:domain rdf:resource="http://example.org/plumblossom/core/Trigram"/>
        <rdfs:range rdf:resource="http://example.org/plumblossom/relations/BodyUseRelation"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/plumblossom/relations/hasUseTrigram">
        <rdfs:label xml:lang="zh">有用卦</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/relations/BodyUseRelation"/>
        <rdfs:range rdf:resource="http://example.org/plumblossom/core/Trigram"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/plumblossom/relations/isUseTrigramOf">
        <rdfs:domain rdf:resource="http://example.org/plumblossom/core/Trigram"/>
        <rdfs:range rdf:resource="http://example.org/plumblossom/relations/BodyUseRelation"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/plumblossom/relations/hasFivePhase">
        <rdfs:label xml:lang="zh">有五行</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/core/Trigram"/>
        <rdfs:range rdf:resource="http://example.org/plumblossom/relations/FivePhase"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/plumblossom/relations/isFivePhaseOf">
        <rdfs:domain rdf:resource="http://example.org/plumblossom/relations/FivePhase"/>
        <rdfs:range rdf:resource="http://example.org/plumblossom/core/Trigram"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/plumblossom/relations/generates">
        <rdfs:label xml:lang="zh">生</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/relations/FivePhase"/>
        <rdfs:range rdf:resource="http://example.org/plumblossom/relations/FivePhase"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/plumblossom/relations/generatedBy">
        <rdfs:domain rdf:resource="http://example.org/plumblossom/relations/FivePhase"/>
        <rdfs:range rdf:resource="http://example.org/plumblossom/relations/FivePhase"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/plumblossom/relations/overcomes">
        <rdfs:label xml:lang="zh">克</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/relations/FivePhase"/>
        <rdfs:range rdf:resource="http://example.org/plumblossom/relations/FivePhase"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/plumblossom/relations/overcomeBy">
        <rdfs:domain rdf:resource="http://example.org/plumblossom/relations/FivePhase"/>
        <rdfs:range rdf:resource="http://example.org/plumblossom/relations/FivePhase"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/plumblossom/relations/hasVitalityState">
        <rdfs:label xml:lang="zh">有旺衰</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/core/Trigram"/>
        <rdfs:range rdf:resource="http://example.org/plumblossom/relations/VitalityState"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/plumblossom/relations/isVitalityStateOf">
        <rdfs:domain rdf:resource="http://example.org/plumblossom/relations/VitalityState"/>
        <rdfs:range rdf:resource="http://example.org/plumblossom/core/Trigram"/>
    </owl:ObjectProperty>

    <!--
      注：rel:generates / rel:overcomes 原误声明为 owl:TransitiveProperty。
      五行生克为五元环（金生水→水生木→木生火→火生土→土生金；金克木→木克土→土克水→水克火→火克金），
      若取传递闭包会推出「木生土」等与「木克土」直接矛盾的结论，并使 R3/R6、R5/R7 失去判别力。
      故移除 Transitive 声明，仅以五元环的直接边建模（A7/B1/B2 修正）。
    -->

    <!-- ==================== 数据属性 ==================== -->
    <owl:DatatypeProperty rdf:about="http://example.org/plumblossom/relations/shengKeType">
        <rdfs:label xml:lang="zh">生克类型</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/relations/BodyUseRelation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/plumblossom/relations/vitality">
        <rdfs:label xml:lang="zh">旺相休囚死</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/relations/VitalityState"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/plumblossom/relations/natureText">
        <rdfs:label xml:lang="zh">性情文本</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/relations/TrigramNature"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    </owl:DatatypeProperty>

    <owl:Class rdf:about="http://example.org/plumblossom/relations/BodyUseRelation">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/plumblossom/relations/hasBodyTrigram"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://example.org/plumblossom/core/Trigram"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/plumblossom/relations/BodyUseRelation">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/plumblossom/relations/hasUseTrigram"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://example.org/plumblossom/core/Trigram"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>


</rdf:RDF>
