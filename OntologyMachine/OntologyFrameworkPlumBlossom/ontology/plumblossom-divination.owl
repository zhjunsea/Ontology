<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns="http://example.org/plumblossom/divination"
         xml:base="http://example.org/plumblossom/divination"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:swrl="http://www.w3.org/2003/11/swrl#"
         xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
         xmlns:core="http://example.org/plumblossom/core/"
         xmlns:div="http://example.org/plumblossom/divination/"
         xmlns:yijing="http://example.org/plumblossom/yijing/"
         xmlns:rel="http://example.org/plumblossom/relations/"
         xmlns:sym="http://example.org/plumblossom/symbols/"
         xmlns:ome="http://example.org/plumblossom/omens/"
         xmlns:jud="http://example.org/plumblossom/judgement/"
         xmlns:cal="http://example.org/plumblossom/calendars/"
         xmlns:rules="http://example.org/plumblossom/rules#">

    <owl:Ontology rdf:about="http://example.org/plumblossom/divination">
        <rdfs:label xml:lang="zh">梅花易数 TBox 子本体 · div</rdfs:label>
        <rdfs:comment xml:lang="zh">第 10 步产出：TBox 按业务域拆分（起卦：起卦法与输入、四不占戒律）。命名空间保持 http://example.org/plumblossom/div 不变；由 plumblossom-tbox.owl 聚合入口统一 imports。</rdfs:comment>
        <owl:imports rdf:resource="http://example.org/plumblossom/core"/>
    </owl:Ontology>
    <owl:Class rdf:about="http://example.org/plumblossom/divination/DivinationInput">
        <rdfs:label xml:lang="zh">起卦域</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://example.org/plumblossom/core/PlumBlossomEntity"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/plumblossom/divination/DivinationMethod">
        <rdfs:label xml:lang="zh">起卦法类别</rdfs:label>
        <rdfs:comment xml:lang="zh">共 17 子类（卷之一十六类 + 附录一撮金）</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://example.org/plumblossom/divination/DivinationInput"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/plumblossom/divination/NumberBasedMethod">
        <rdfs:label xml:lang="zh">先天·以数起卦</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://example.org/plumblossom/divination/DivinationMethod"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/plumblossom/divination/ImageBasedMethod">
        <rdfs:label xml:lang="zh">后天·端法·以象起卦</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://example.org/plumblossom/divination/DivinationMethod"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/plumblossom/divination/YearMonthDayHourMethod">
        <rdfs:label xml:lang="zh">年月日时起例</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://example.org/plumblossom/divination/NumberBasedMethod"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/plumblossom/divination/ObjectCountMethod">
        <rdfs:label xml:lang="zh">物占数</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://example.org/plumblossom/divination/NumberBasedMethod"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/plumblossom/divination/SoundCountMethod">
        <rdfs:label xml:lang="zh">声音占</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://example.org/plumblossom/divination/NumberBasedMethod"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/plumblossom/divination/CharacterMethod">
        <rdfs:label xml:lang="zh">字占</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://example.org/plumblossom/divination/NumberBasedMethod"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/plumblossom/divination/ZhangChiMethod">
        <rdfs:label xml:lang="zh">丈尺占</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://example.org/plumblossom/divination/NumberBasedMethod"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/plumblossom/divination/ChiCunMethod">
        <rdfs:label xml:lang="zh">尺寸物占</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://example.org/plumblossom/divination/NumberBasedMethod"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/plumblossom/divination/YicuoJinMethod">
        <rdfs:label xml:lang="zh">一撮金法</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://example.org/plumblossom/divination/NumberBasedMethod"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/plumblossom/divination/XiangZiMethod">
        <rdfs:label xml:lang="zh">相字法</rdfs:label>
        <rdfs:comment xml:lang="zh">卷之四·字画指迷 / 卷之五·拆字杂编「相字（拆字）」专术：以字的笔画形态（六神笔式/五行笔式/八卦辨/五行全备）与偏旁神煞起断，另参玄黄克应（写字时所遇兆应）。与「以数起卦」别系，本应用仅作节点 9「万物类象取象」之取象来源（依《本体顶层设计》§56/§112），不另起卦、不改体用主判（依 C12 不设节点 16 独立栏）。</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://example.org/plumblossom/divination/ImageBasedMethod"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/plumblossom/divination/PersonObserveMethod">
        <rdfs:label xml:lang="zh">为人占</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://example.org/plumblossom/divination/ImageBasedMethod"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/plumblossom/divination/SelfObserveMethod">
        <rdfs:label xml:lang="zh">自己占</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://example.org/plumblossom/divination/ImageBasedMethod"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/plumblossom/divination/MovingThingMethod">
        <rdfs:label xml:lang="zh">占动物</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://example.org/plumblossom/divination/ImageBasedMethod"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/plumblossom/divination/StillThingMethod">
        <rdfs:label xml:lang="zh">占静物</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://example.org/plumblossom/divination/ImageBasedMethod"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/plumblossom/divination/ThingHexagramMethod">
        <rdfs:label xml:lang="zh">物卦起例</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://example.org/plumblossom/divination/ImageBasedMethod"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/plumblossom/divination/WindMethod">
        <rdfs:label xml:lang="zh">风觉占</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://example.org/plumblossom/divination/ImageBasedMethod"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/plumblossom/divination/BirdMethod">
        <rdfs:label xml:lang="zh">鸟占</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://example.org/plumblossom/divination/ImageBasedMethod"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/plumblossom/divination/HeardSoundMethod">
        <rdfs:label xml:lang="zh">听声音占</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://example.org/plumblossom/divination/ImageBasedMethod"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/plumblossom/divination/ShapeMethod">
        <rdfs:label xml:lang="zh">形物占</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://example.org/plumblossom/divination/ImageBasedMethod"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/plumblossom/divination/ColorMethod">
        <rdfs:label xml:lang="zh">验色占</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://example.org/plumblossom/divination/ImageBasedMethod"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/plumblossom/divination/Precept">
        <rdfs:label xml:lang="zh">心法戒律·四不占</rdfs:label>
        <rdfs:comment xml:lang="zh">四不占戒律（卷之一·观梅占；附录·一撮金）</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://example.org/plumblossom/divination/DivinationInput"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/plumblossom/divination/InputDatum">
        <rdfs:label xml:lang="zh">起卦输入数据</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://example.org/plumblossom/divination/DivinationInput"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/plumblossom/divination/DivinationSubject">
        <rdfs:label xml:lang="zh">占断事项域</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://example.org/plumblossom/core/PlumBlossomEntity"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/plumblossom/divination/AppendixText">
        <rdfs:label xml:lang="zh">附录文献</rdfs:label>
        <rdfs:comment xml:lang="zh">附录·渔樵对问 / 宋史·邵雍传：邵雍易学义理（观物·以物观物／体用相息／太极两仪四象八卦／权变／性命）与生平史料。依《本体顶层设计》原著范围（附录三篇＝一撮金·渔樵对问·宋史·邵雍传）；一撮金承载于 yicuo_jin_yao，余二篇文本入 DB appendix_text、ABox 仅引用。第 26 轮补。</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://example.org/plumblossom/core/PlumBlossomEntity"/>
    </owl:Class>

    <owl:DatatypeProperty rdf:about="http://example.org/plumblossom/divination/methodCode">
        <rdfs:label xml:lang="zh">起卦法代码</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/divination/DivinationMethod"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/plumblossom/divination/preceptName">
        <rdfs:label xml:lang="zh">戒律名</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/divination/Precept"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/plumblossom/divination/strokeCount">
        <rdfs:label xml:lang="zh">笔画数</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/divination/InputDatum"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/plumblossom/divination/rawNumber">
        <rdfs:label xml:lang="zh">起卦原始数</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/divination/InputDatum"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/plumblossom/divination/appendixWorkName">
        <rdfs:label xml:lang="zh">附录篇名</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/divination/AppendixText"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/plumblossom/divination/appendixSectionIndex">
        <rdfs:label xml:lang="zh">附录段序</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/divination/AppendixText"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/plumblossom/divination/appendixSectionTopic">
        <rdfs:label xml:lang="zh">附录段主题</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/divination/AppendixText"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/plumblossom/divination/appendixTextBody">
        <rdfs:label xml:lang="zh">附录原文文本</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/divination/AppendixText"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/plumblossom/divination/appendixSourceRef">
        <rdfs:label xml:lang="zh">附录出处</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/divination/AppendixText"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>


</rdf:RDF>
