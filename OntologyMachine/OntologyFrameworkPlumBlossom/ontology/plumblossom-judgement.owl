<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns="http://example.org/plumblossom/judgement"
         xml:base="http://example.org/plumblossom/judgement"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:swrl="http://www.w3.org/2003/11/swrl#"
         xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
         xmlns:core="http://example.org/plumblossom/core/"
         xmlns:div="http://example.org/plumblossom/divination/"
         xmlns:yijing="http://example.org/plumblossom/yijing/"
         xmlns:rel="http://example.org/plumblossom/relations/"
         xmlns:sym="http://example.org/plumblossom/symbols/"
         xmlns:ome="http://example.org/plumblossom/omens/"
         xmlns:jud="http://example.org/plumblossom/judgement/"
         xmlns:cal="http://example.org/plumblossom/calendars/"
         xmlns:rules="http://example.org/plumblossom/rules#">

    <owl:Ontology rdf:about="http://example.org/plumblossom/judgement">
        <rdfs:label xml:lang="zh">梅花易数 TBox 子本体 · jud</rdfs:label>
        <rdfs:comment xml:lang="zh">第 10 步产出：TBox 按业务域拆分（断验：事项类别/吉凶/应期/修身/一撮金）。命名空间保持 http://example.org/plumblossom/jud 不变；由 plumblossom-tbox.owl 聚合入口统一 imports。</rdfs:comment>
        <owl:imports rdf:resource="http://example.org/plumblossom/relations"/>
        <owl:imports rdf:resource="http://example.org/plumblossom/symbols"/>
        <owl:imports rdf:resource="http://example.org/plumblossom/omens"/>
        <owl:imports rdf:resource="http://example.org/plumblossom/yijing"/>
    </owl:Ontology>
    <owl:Class rdf:about="http://example.org/plumblossom/judgement/SubjectCategory">
        <rdfs:label xml:lang="zh">事项类别</rdfs:label>
        <rdfs:comment xml:lang="zh">18 子类（卷之二十八章占例）</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://example.org/plumblossom/divination/DivinationSubject"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/plumblossom/judgement/JudgementDomain">
        <rdfs:label xml:lang="zh">断验域</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://example.org/plumblossom/core/PlumBlossomEntity"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/plumblossom/judgement/Auspiciousness">
        <rdfs:label xml:lang="zh">吉凶等级</rdfs:label>
        <rdfs:comment xml:lang="zh">大吉/吉/平/凶/大凶</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://example.org/plumblossom/judgement/JudgementDomain"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/plumblossom/judgement/YicuoJinAdmonition">
        <rdfs:label xml:lang="zh">一撮金爻诀断辞</rdfs:label>
        <rdfs:comment xml:lang="zh">附录·一撮金</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://example.org/plumblossom/judgement/JudgementDomain"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/plumblossom/judgement/YicuoJinGrade">
        <rdfs:label xml:lang="zh">一撮金吉凶六等</rdfs:label>
        <rdfs:comment xml:lang="zh">上上…下下</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://example.org/plumblossom/judgement/JudgementDomain"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/plumblossom/judgement/ResponsePeriod">
        <rdfs:label xml:lang="zh">应期</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://example.org/plumblossom/judgement/JudgementDomain"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/plumblossom/judgement/SelfCultivationAdvice">
        <rdfs:label xml:lang="zh">修身建议</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://example.org/plumblossom/judgement/JudgementDomain"/>
    </owl:Class>

    <!-- ==================== 对象属性 ==================== -->
    <owl:ObjectProperty rdf:about="http://example.org/plumblossom/judgement/belongsToCategory">
        <rdfs:label xml:lang="zh">属事项类别</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/divination/DivinationInput"/>
        <rdfs:range rdf:resource="http://example.org/plumblossom/judgement/SubjectCategory"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/plumblossom/judgement/hasMethod">
        <rdfs:label xml:lang="zh">所据起卦法</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/judgement/JudgementDomain"/>
        <rdfs:range rdf:resource="http://example.org/plumblossom/divination/DivinationMethod"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/plumblossom/judgement/hasAuspiciousness">
        <rdfs:label xml:lang="zh">有吉凶等级</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/judgement/JudgementDomain"/>
        <rdfs:range rdf:resource="http://example.org/plumblossom/judgement/Auspiciousness"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/plumblossom/judgement/isAuspiciousnessOf">
        <rdfs:domain rdf:resource="http://example.org/plumblossom/judgement/Auspiciousness"/>
        <rdfs:range rdf:resource="http://example.org/plumblossom/judgement/JudgementDomain"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/plumblossom/judgement/hasYicuoJinAdmonition">
        <rdfs:label xml:lang="zh">有一撮金爻诀</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/judgement/JudgementDomain"/>
        <rdfs:range rdf:resource="http://example.org/plumblossom/judgement/YicuoJinAdmonition"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/plumblossom/judgement/admonitionOfHexagram">
        <rdfs:domain rdf:resource="http://example.org/plumblossom/judgement/YicuoJinAdmonition"/>
        <rdfs:range rdf:resource="http://example.org/plumblossom/judgement/JudgementDomain"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/plumblossom/judgement/hasYicuoJinGrade">
        <rdfs:label xml:lang="zh">有爻诀等级</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/judgement/YicuoJinAdmonition"/>
        <rdfs:range rdf:resource="http://example.org/plumblossom/judgement/YicuoJinGrade"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/plumblossom/judgement/hasResponsePeriod">
        <rdfs:label xml:lang="zh">有应期</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/judgement/JudgementDomain"/>
        <rdfs:range rdf:resource="http://example.org/plumblossom/judgement/ResponsePeriod"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/plumblossom/judgement/isResponsePeriodOf">
        <rdfs:domain rdf:resource="http://example.org/plumblossom/judgement/ResponsePeriod"/>
        <rdfs:range rdf:resource="http://example.org/plumblossom/judgement/JudgementDomain"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/plumblossom/judgement/hasAdvice">
        <rdfs:label xml:lang="zh">有修身建议</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/judgement/JudgementDomain"/>
        <rdfs:range rdf:resource="http://example.org/plumblossom/judgement/SelfCultivationAdvice"/>
    </owl:ObjectProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/plumblossom/judgement/divinationSystem">
        <rdfs:label xml:lang="zh">先天/后天体系</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/judgement/JudgementDomain"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/plumblossom/judgement/usesZhouyiDictum">
        <rdfs:label xml:lang="zh">是否引周易卦爻辞</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/judgement/JudgementDomain"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/plumblossom/judgement/auspiciousnessLevel">
        <rdfs:label xml:lang="zh">吉凶等级值</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/judgement/Auspiciousness"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/plumblossom/judgement/yicuoJinGradeValue">
        <rdfs:label xml:lang="zh">一撮金六等值</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/judgement/YicuoJinGrade"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>

    <!-- 附录·一撮金·爻诀（YicuoJinAdmonition）数据属性：64卦×3爻＝192首爻诀，
         文本/爻题/爻位/所属卦/等级（文本）等，DB（yicuo_jin_yao）为唯一真源，经 OBDA 引用。
         （第23轮补：此前 TBox 仅建模「有等级」，无承载爻诀文本之属性，致断辞无处安放。） -->
    <owl:DatatypeProperty rdf:about="http://example.org/plumblossom/judgement/yicuoJinDictumText">
        <rdfs:label xml:lang="zh">一撮金爻诀断辞</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/judgement/YicuoJinAdmonition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/plumblossom/judgement/yicuoJinYaoLabel">
        <rdfs:label xml:lang="zh">一撮金爻题</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/judgement/YicuoJinAdmonition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/plumblossom/judgement/yicuoJinLinePosition">
        <rdfs:label xml:lang="zh">一撮金爻位</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/judgement/YicuoJinAdmonition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/plumblossom/judgement/yicuoJinGradeText">
        <rdfs:label xml:lang="zh">一撮金等级（文本）</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/judgement/YicuoJinAdmonition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/plumblossom/judgement/yicuoJinAdmonitionHexagram">
        <rdfs:label xml:lang="zh">爻诀所属卦</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/judgement/YicuoJinAdmonition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/plumblossom/judgement/processDescription">
        <rdfs:label xml:lang="zh">过程描述</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/judgement/JudgementDomain"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/plumblossom/judgement/processFlag">
        <rdfs:label xml:lang="zh">过程标记</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/judgement/JudgementDomain"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/plumblossom/judgement/isMajorResult">
        <rdfs:label xml:lang="zh">重大结果标记</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/judgement/JudgementDomain"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/plumblossom/judgement/responseValue">
        <rdfs:label xml:lang="zh">应期数值</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/judgement/ResponsePeriod"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/plumblossom/judgement/responseUnit">
        <rdfs:label xml:lang="zh">应期单位</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/judgement/ResponsePeriod"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:Class rdf:about="http://example.org/plumblossom/judgement/JudgementDomain">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/plumblossom/judgement/hasAuspiciousness"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://example.org/plumblossom/judgement/Auspiciousness"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/plumblossom/judgement/YicuoJinAdmonition">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/plumblossom/judgement/hasYicuoJinGrade"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://example.org/plumblossom/judgement/YicuoJinGrade"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <!-- ==================== SWRL 规则（R1~R14；R15 见下方注释） ==================== -->
    <!-- 变量声明 -->

</rdf:RDF>
