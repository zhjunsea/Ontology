[PrefixDeclaration]
:        http://example.org/plumblossom/
cal:     http://example.org/plumblossom/calendars/
yijing:  http://example.org/plumblossom/yijing/
jud:     http://example.org/plumblossom/judgement/
rel:     http://example.org/plumblossom/relations/
div:     http://example.org/plumblossom/divination/
core:    http://example.org/plumblossom/core/
rdf:     http://www.w3.org/1999/02/22-rdf-syntax-ns#
rdfs:    http://www.w3.org/2000/01/rdf-schema#
owl:     http://www.w3.org/2002/07/owl#
xsd:     http://www.w3.org/2001/XMLSchema#

[MappingDeclaration] @collection [[

mappingId    cal_heavenly_stem
target       <http://example.org/plumblossom/calendars/{name}> a <http://example.org/plumblossom/calendars/HeavenlyStem> ;
                 rdfs:label "{label}"@zh ;
                 <http://example.org/plumblossom/calendars/stemName> "{stem_name}"^^xsd:string ;
                 <http://example.org/plumblossom/calendars/stemFivePhase> <http://example.org/plumblossom/relations/{five_phase}> .
source       SELECT name,
                 COALESCE(stem_name, '') AS stem_name,
                 COALESCE(five_phase, '') AS five_phase,
                 COALESCE(label, '') AS label
             FROM calendar_heavenly_stem
             WHERE name IS NOT NULL

mappingId    cal_earthly_branch
target       <http://example.org/plumblossom/calendars/{name}> a <http://example.org/plumblossom/calendars/EarthlyBranch> ;
                 rdfs:label "{label}"@zh ;
                 <http://example.org/plumblossom/calendars/branchName> "{branch_name}"^^xsd:string ;
                 <http://example.org/plumblossom/calendars/branchAnimal> "{branch_animal}"^^xsd:string ;
                 <http://example.org/plumblossom/calendars/zhiOrder> "{zhi_order}"^^xsd:integer ;
                 <http://example.org/plumblossom/calendars/branchFivePhase> <http://example.org/plumblossom/relations/{five_phase}> .
source       SELECT name,
                 COALESCE(branch_name, '') AS branch_name,
                 COALESCE(branch_animal, '') AS branch_animal,
                 COALESCE(zhi_order, 0) AS zhi_order,
                 COALESCE(five_phase, '') AS five_phase,
                 COALESCE(label, '') AS label
             FROM calendar_earthly_branch
             WHERE name IS NOT NULL

mappingId    cal_nayin
target       <http://example.org/plumblossom/calendars/{name}> a <http://example.org/plumblossom/calendars/NaYin> ;
                 rdfs:label "{label}"@zh ;
                 <http://example.org/plumblossom/calendars/naYinName> "{nayin_name}"^^xsd:string ;
                 <http://example.org/plumblossom/calendars/naYinPhase> <http://example.org/plumblossom/relations/{five_phase}> .
source       SELECT name,
                 COALESCE(nayin_name, '') AS nayin_name,
                 COALESCE(five_phase, '') AS five_phase,
                 COALESCE(label, '') AS label
             FROM calendar_nayin
             WHERE name IS NOT NULL

mappingId    cal_sexagenary_cycle
target       <http://example.org/plumblossom/calendars/{name}> a <http://example.org/plumblossom/calendars/SexagenaryCycle> ;
                 rdfs:label "{label}"@zh ;
                 <http://example.org/plumblossom/calendars/hasNaYin> <http://example.org/plumblossom/calendars/{nayin_name}> .
source       SELECT name,
                 COALESCE(ganzhi, '') AS label,
                 COALESCE(nayin_name, '') AS nayin_name
             FROM calendar_sexagenary_cycle
             WHERE name IS NOT NULL
               AND nayin_name IS NOT NULL
               AND nayin_name <> ''

mappingId    cal_life_stage
target       <http://example.org/plumblossom/calendars/{name}> a <http://example.org/plumblossom/calendars/LifeStage> ;
                 rdfs:label "{label}"@zh ;
                 <http://example.org/plumblossom/calendars/lifeStageText> "{life_stage_text}"^^xsd:string .
source       SELECT name,
                 COALESCE(life_stage_text, '') AS life_stage_text,
                 COALESCE(label, '') AS label
             FROM calendar_life_stage
             WHERE name IS NOT NULL

mappingId    yijing_hexagram_sequence
target       <http://example.org/plumblossom/yijing/{name}> a <http://example.org/plumblossom/yijing/HexagramSequence> ;
                 rdfs:label "{label}"@zh ;
                 rdfs:label "{hexagram_name}"@zh ;
                 <http://example.org/plumblossom/yijing/hexagramSequence> "{sequence_no}"^^xsd:integer .
source       SELECT name,
                 COALESCE(sequence_no, 0) AS sequence_no,
                 COALESCE(hexagram_name, '') AS hexagram_name,
                 COALESCE(label, '') AS label
             FROM yijing_hexagram_sequence
             WHERE name IS NOT NULL

mappingId    yijing_hexagram_dictum
target       <http://example.org/plumblossom/yijing/{name}> a <http://example.org/plumblossom/yijing/HexagramDictum> ;
                 rdfs:label "{label}"@zh ;
                 <http://example.org/plumblossom/yijing/hexagramDictumText> "{dictum_text}"^^xsd:string ;
                 <http://example.org/plumblossom/yijing/hexagramDictumInterpretation> "{interpretation}"^^xsd:string .
source       SELECT name,
                 COALESCE(dictum_text, '') AS dictum_text,
                 COALESCE(interpretation, '') AS interpretation,
                 COALESCE(label, '') AS label
             FROM yijing_hexagram_dictum
             WHERE name IS NOT NULL

mappingId    yijing_line_dictum
target       <http://example.org/plumblossom/yijing/{name}> a <http://example.org/plumblossom/yijing/LineDictum> ;
                 rdfs:label "{label}"@zh ;
                 <http://example.org/plumblossom/yijing/lineDictumPosition> "{position}"^^xsd:integer ;
                 <http://example.org/plumblossom/yijing/lineDictumText> "{dictum_text}"^^xsd:string ;
                 <http://example.org/plumblossom/yijing/lineDictumInterpretation> "{interpretation}"^^xsd:string .
source       SELECT name,
                 COALESCE(position, 0) AS position,
                 COALESCE(dictum_text, '') AS dictum_text,
                 COALESCE(interpretation, '') AS interpretation,
                 COALESCE(label, '') AS label
             FROM yijing_line_dictum
             WHERE name IS NOT NULL

mappingId    jud_divination_result
target       <http://example.org/plumblossom/judgement/{pb_name}> a <http://example.org/plumblossom/judgement/JudgementDomain> ;
                 <http://example.org/plumblossom/judgement/divinationSystem> "{divination_system}"^^xsd:string ;
                 <http://example.org/plumblossom/judgement/hasAuspiciousness> <http://example.org/plumblossom/judgement/{auspiciousness}> ;
                 <http://example.org/plumblossom/judgement/hasMethod> <http://example.org/plumblossom/divination/{method}> ;
                 <http://example.org/plumblossom/judgement/isMajorResult> "{is_major_result}"^^xsd:boolean ;
                 <http://example.org/plumblossom/judgement/usesZhouyiDictum> "{uses_zhouyi_dictum}"^^xsd:boolean ;
                 <http://example.org/plumblossom/judgement/processFlag> "{process_flag}"^^xsd:string ;
                 <http://example.org/plumblossom/judgement/processDescription> "{description}"^^xsd:string .
source       SELECT pb_name,
                 COALESCE(divination_system, '') AS divination_system,
                 COALESCE(method, '') AS method,
                 COALESCE(subject_category, '') AS subject_category,
                 COALESCE(auspiciousness, '') AS auspiciousness,
                 COALESCE(is_major_result, 0) AS is_major_result,
                 COALESCE(uses_zhouyi_dictum, 0) AS uses_zhouyi_dictum,
                 COALESCE(response_period, '') AS response_period,
                 COALESCE(process_flag, '') AS process_flag,
                 COALESCE(description, '') AS description
             FROM divination_result
             WHERE pb_name IS NOT NULL
               AND auspiciousness IS NOT NULL
               AND auspiciousness <> ''

mappingId    yicuo_jin_yao
target       <http://example.org/plumblossom/judgement/{name}> a <http://example.org/plumblossom/judgement/YicuoJinAdmonition> ;
                 rdfs:label "{label}"@zh ;
                 <http://example.org/plumblossom/judgement/yicuoJinAdmonitionHexagram> "{hexagram_name}"^^xsd:string ;
                 <http://example.org/plumblossom/judgement/yicuoJinLinePosition> "{line_position}"^^xsd:integer ;
                 <http://example.org/plumblossom/judgement/yicuoJinYaoLabel> "{yao_label}"^^xsd:string ;
                 <http://example.org/plumblossom/judgement/yicuoJinGradeText> "{grade}"^^xsd:string ;
                 <http://example.org/plumblossom/judgement/hasYicuoJinGrade> <http://example.org/plumblossom/judgement/{grade_iri}> ;
                 <http://example.org/plumblossom/judgement/yicuoJinDictumText> "{dictum_text}"^^xsd:string .
source       SELECT name,
                 COALESCE(hexagram_name, '') AS hexagram_name,
                 COALESCE(line_position, 0) AS line_position,
                 COALESCE(yao_label, '') AS yao_label,
                 COALESCE(grade, '') AS grade,
                 COALESCE(grade_iri, '') AS grade_iri,
                 COALESCE(dictum_text, '') AS dictum_text,
                 COALESCE(label, '') AS label
             FROM yicuo_jin_yao
             WHERE name IS NOT NULL


mappingId    xiangzi_rule
target       <http://example.org/plumblossom/symbols/{name}> a <http://example.org/plumblossom/symbols/XiangZiRule> ;
                 rdfs:label "{label}"@zh ;
                 <http://example.org/plumblossom/symbols/xiangZiCategory> "{category}"^^xsd:string ;
                 <http://example.org/plumblossom/symbols/xiangZiRuleKey> "{rule_key}"^^xsd:string ;
                 <http://example.org/plumblossom/symbols/xiangZiRuleText> "{rule_text}"^^xsd:string ;
                 <http://example.org/plumblossom/symbols/xiangZiSourceRef> "{source_ref}"^^xsd:string .
source       SELECT name,
                 COALESCE(category, '') AS category,
                 COALESCE(rule_key, '') AS rule_key,
                 COALESCE(rule_text, '') AS rule_text,
                 COALESCE(source_ref, '') AS source_ref,
                 COALESCE(label, '') AS label
             FROM xiangzi_rule
             WHERE name IS NOT NULL

mappingId    appendix_text
target       <http://example.org/plumblossom/divination/{name}> a <http://example.org/plumblossom/divination/AppendixText> ;
                 rdfs:label "{label}"@zh ;
                 <http://example.org/plumblossom/divination/appendixWorkName> "{work_name}"^^xsd:string ;
                 <http://example.org/plumblossom/divination/appendixSectionIndex> "{section_index}"^^xsd:integer ;
                 <http://example.org/plumblossom/divination/appendixSectionTopic> "{section_topic}"^^xsd:string ;
                 <http://example.org/plumblossom/divination/appendixTextBody> "{text_body}"^^xsd:string ;
                 <http://example.org/plumblossom/divination/appendixSourceRef> "{source_ref}"^^xsd:string .
source       SELECT name,
                 COALESCE(work_name, '') AS work_name,
                 COALESCE(section_index, 0) AS section_index,
                 COALESCE(section_topic, '') AS section_topic,
                 COALESCE(text_body, '') AS text_body,
                 COALESCE(source_ref, '') AS source_ref,
                 COALESCE(label, '') AS label
             FROM appendix_text
             WHERE name IS NOT NULL

mappingId    trigram
target       <http://example.org/plumblossom/core/{local}> a <http://example.org/plumblossom/core/Trigram> ;
                 rdfs:label "{label}"@zh ;
                 <http://example.org/plumblossom/core/trigramNumber> "{number}"^^xsd:integer ;
                 <http://example.org/plumblossom/relations/hasFivePhase> <http://example.org/plumblossom/relations/{five_local}> ;
                 <http://example.org/plumblossom/core/hasDirection> <http://example.org/plumblossom/core/{dir_local}> ;
                 <http://example.org/plumblossom/core/trigramFamilyRole> "{role}"@zh ;
                 <http://example.org/plumblossom/core/trigramNature> "{nature}"@zh ;
                 <http://example.org/plumblossom/core/trigramMainImage> "{main_image}"@zh .
             <http://example.org/plumblossom/relations/{five_local}> rdfs:label "{five_label}"@zh .
             <http://example.org/plumblossom/core/{dir_local}> rdfs:label "{dir_label}"@zh .
source       SELECT local,
                 COALESCE(label, '') AS label,
                 COALESCE(number, 0) AS number,
                 COALESCE(five_local, '') AS five_local,
                 COALESCE(five_label, '') AS five_label,
                 COALESCE(dir_local, '') AS dir_local,
                 COALESCE(dir_label, '') AS dir_label,
                 COALESCE(role, '') AS role,
                 COALESCE(nature, '') AS nature,
                 COALESCE(main_image, '') AS main_image
             FROM trigram
             WHERE local IS NOT NULL



mappingId    five_phase_attr
target       <http://example.org/plumblossom/relations/{local}> a <http://example.org/plumblossom/relations/FivePhase> ;
                 rdfs:label "{phase_label}"@zh ;
                 <http://example.org/plumblossom/relations/fiveDirection> "{direction}"^^xsd:string ;
                 <http://example.org/plumblossom/relations/fiveColor> "{color}"^^xsd:string ;
                 <http://example.org/plumblossom/relations/fiveSeason> "{season}"^^xsd:string ;
                 <http://example.org/plumblossom/relations/fiveObject> "{object}"^^xsd:string .
source       SELECT local,
                 COALESCE(phase_label, '') AS phase_label,
                 COALESCE(direction, '') AS direction,
                 COALESCE(color, '') AS color,
                 COALESCE(season, '') AS season,
                 COALESCE(object, '') AS object
             FROM five_phase_attr
             WHERE local IS NOT NULL

mappingId    season_vitality
target       <http://example.org/plumblossom/relations/SeasonVitality_{phase_local}_{season_code}> a <http://example.org/plumblossom/relations/SeasonVitality> ;
                 <http://example.org/plumblossom/relations/forFivePhase> <http://example.org/plumblossom/relations/{phase_local}> ;
                 <http://example.org/plumblossom/relations/inSeason> "{season}"^^xsd:string ;
                 <http://example.org/plumblossom/relations/vitality> "{vitality}"^^xsd:string .
source       SELECT phase_local,
                 season,
                 CASE season WHEN '春' THEN 'Chun' WHEN '夏' THEN 'Xia' WHEN '秋' THEN 'Qiu' WHEN '冬' THEN 'Dong' ELSE 'Siji' END AS season_code,
                 COALESCE(vitality, '') AS vitality
             FROM season_vitality
             WHERE phase_local IS NOT NULL

mappingId    bodyuse_level
target       <http://example.org/plumblossom/relations/BodyUseLevel_{level}> a <http://example.org/plumblossom/relations/BodyUseLevel> ;
                 <http://example.org/plumblossom/relations/bodyUseLevel> "{level}"^^xsd:integer ;
                 <http://example.org/plumblossom/relations/shengKeName> "{shengke_name}"^^xsd:string ;
                 <http://example.org/plumblossom/relations/auspiciousnessLabel> "{auspiciousness}"^^xsd:string .
source       SELECT level,
                 COALESCE(shengke_name, '') AS shengke_name,
                 COALESCE(auspiciousness, '') AS auspiciousness
             FROM bodyuse_level
             WHERE level IS NOT NULL

mappingId    auspiciousness_level
target       <http://example.org/plumblossom/judgement/{local}> a <http://example.org/plumblossom/judgement/Auspiciousness> ;
                 rdfs:label "{label}"@zh ;
                 <http://example.org/plumblossom/judgement/auspiciousnessLevel> "{level}"^^xsd:integer .
source       SELECT local,
                 COALESCE(label, '') AS label,
                 COALESCE(level, 0) AS level
             FROM auspiciousness_level
             WHERE local IS NOT NULL

mappingId    div_precept
target       <http://example.org/plumblossom/divination/Precept_{local}> a <http://example.org/plumblossom/divination/Precept> ;
                 rdfs:label "{label}"@zh ;
                 <http://example.org/plumblossom/divination/preceptName> "{label}"@zh ;
                 <http://example.org/plumblossom/divination/preceptAdmonition> "{admonition}"@zh .
source       SELECT local,
                 COALESCE(label, '') AS label,
                 COALESCE(admonition, '') AS admonition
             FROM precept
             WHERE local IS NOT NULL

mappingId    zuo_duan
target       <http://example.org/plumblossom/divination/ZuoDuan_{name}> a <http://example.org/plumblossom/divination/ZuoDuanEntry> ;
                 rdfs:label "{name}"@zh ;
                 <http://example.org/plumblossom/divination/zuoDuanText> "{text}"^^xsd:string .
source       SELECT name,
                 COALESCE(text, '') AS text
             FROM zuo_duan
             WHERE name IS NOT NULL

mappingId    shi_da_ying
target       <http://example.org/plumblossom/omens/ShiDaYing_{name}> a <http://example.org/plumblossom/omens/TenResponses> ;
                 rdfs:label "{name}"@zh ;
                 <http://example.org/plumblossom/omens/omenText> "{text}"^^xsd:string .
source       SELECT name,
                 COALESCE(text, '') AS text
             FROM shi_da_ying
             WHERE name IS NOT NULL

mappingId    gua_ying
target       <http://example.org/plumblossom/symbols/GuaYing_{name}> a <http://example.org/plumblossom/symbols/ImageSymbol> ;
                 rdfs:label "{name}"@zh ;
                 <http://example.org/plumblossom/symbols/symbolText> "{text}"^^xsd:string .
source       SELECT name,
                 COALESCE(text, '') AS text
             FROM gua_ying
             WHERE name IS NOT NULL

mappingId    domain_lore
target       <http://example.org/plumblossom/divination/Lore_{collection}_{k}> a <http://example.org/plumblossom/divination/LoreTextEntry> ;
                 <http://example.org/plumblossom/divination/loreCollection> "{collection}"^^xsd:string ;
                 <http://example.org/plumblossom/divination/loreKey> "{k}"^^xsd:string ;
                 <http://example.org/plumblossom/divination/loreText> "{text}"^^xsd:string .
source       SELECT `collection`, `k`,
                 COALESCE(`text`, '') AS `text`
             FROM domain_lore
             WHERE `collection` IS NOT NULL AND `k` IS NOT NULL

mappingId    judge_weight
target       <http://example.org/plumblossom/judgement/JudgeWeight_{item}> a <http://example.org/plumblossom/judgement/JudgeWeight> ;
                 rdfs:label "{label}"@zh ;
                 <http://example.org/plumblossom/judgement/judgeWeightItem> "{item}"^^xsd:string ;
                 <http://example.org/plumblossom/judgement/judgeWeightValue> "{weight}"^^xsd:integer .
source       SELECT item,
                 COALESCE(label, '') AS label,
                 COALESCE(weight, 0) AS weight
             FROM judge_weight
             WHERE item IS NOT NULL

mappingId    juan_text
target       <http://example.org/plumblossom/divination/JuanText_{code}> a <http://example.org/plumblossom/divination/JuanTextEntry> ;
                 <http://example.org/plumblossom/divination/juanCode> "{code}"^^xsd:string ;
                 <http://example.org/plumblossom/divination/juanVolume> "{juan}"^^xsd:string ;
                 <http://example.org/plumblossom/divination/juanTitle> "{title}"^^xsd:string ;
                 <http://example.org/plumblossom/divination/juanText> "{content}"^^xsd:string .
source       SELECT `code`,
                 COALESCE(`juan`, '') AS `juan`,
                 COALESCE(`title`, '') AS `title`,
                 COALESCE(`content`, '') AS `content`
             FROM juan_text
             WHERE `code` IS NOT NULL

]]
