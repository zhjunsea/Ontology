<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns="http://example.org/plumblossom/tbox"
         xml:base="http://example.org/plumblossom/tbox"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:swrl="http://www.w3.org/2003/11/swrl#"
         xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
         xmlns:core="http://example.org/plumblossom/core/"
         xmlns:div="http://example.org/plumblossom/divination/"
         xmlns:yijing="http://example.org/plumblossom/yijing/"
         xmlns:rel="http://example.org/plumblossom/relations/"
         xmlns:sym="http://example.org/plumblossom/symbols/"
         xmlns:ome="http://example.org/plumblossom/omens/"
         xmlns:jud="http://example.org/plumblossom/judgement/"
         xmlns:cal="http://example.org/plumblossom/calendars/"
         xmlns:rules="http://example.org/plumblossom/rules#">

    <owl:Ontology rdf:about="http://example.org/plumblossom/tbox">
        <owl:imports rdf:resource="http://example.org/plumblossom/core"/>
        <owl:imports rdf:resource="http://example.org/plumblossom/divination"/>
        <owl:imports rdf:resource="http://example.org/plumblossom/yijing"/>
        <owl:imports rdf:resource="http://example.org/plumblossom/relations"/>
        <owl:imports rdf:resource="http://example.org/plumblossom/symbols"/>
        <owl:imports rdf:resource="http://example.org/plumblossom/omens"/>
        <owl:imports rdf:resource="http://example.org/plumblossom/judgement"/>
        <owl:imports rdf:resource="http://example.org/plumblossom/calendars"/>
        <owl:imports rdf:resource="http://example.org/plumblossom/rules"/>
        <owl:imports rdf:resource="http://example.org/plumblossom/term"/>
        <rdfs:label xml:lang="zh">梅花易数 TBox 聚合入口（显式 imports 九个子本体 + SKOS 术语表）</rdfs:label>
        <rdfs:comment xml:lang="zh">第 10 步产出：TBox 聚合入口，按业务域显式导入 core/div/yijing/rel/sym/ome/jud/cal/rules 九个子本体；语义与原单文件 TBox 等价，imports 无环。</rdfs:comment>
    </owl:Ontology>

</rdf:RDF>
