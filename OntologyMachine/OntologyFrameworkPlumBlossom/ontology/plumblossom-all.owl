<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns="http://example.org/plumblossom/all"
         xml:base="http://example.org/plumblossom/all"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:swrl="http://www.w3.org/2003/11/swrl#"
         xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
         xmlns:core="http://example.org/plumblossom/core/"
         xmlns:div="http://example.org/plumblossom/divination/"
         xmlns:yijing="http://example.org/plumblossom/yijing/"
         xmlns:rel="http://example.org/plumblossom/relations/"
         xmlns:sym="http://example.org/plumblossom/symbols/"
         xmlns:ome="http://example.org/plumblossom/omens/"
         xmlns:jud="http://example.org/plumblossom/judgement/"
         xmlns:cal="http://example.org/plumblossom/calendars/"
         xmlns:rules="http://example.org/plumblossom/rules#">

    <owl:Ontology rdf:about="http://example.org/plumblossom/all">
        <owl:imports rdf:resource="http://example.org/plumblossom/tbox"/>
        <!-- abox
             第 9 步：ABox 的 owl:imports 按铁律 11 注释掉——ABox 不进全局推理器（避免拖累 CLASS_HIERARCHY 分类），
             由应用侧经 ontology.abox-path 独立加载（复用 OntologyService，见 PlumBlossomOntologyJobWorker）。
             参考 Example/ontology/pizza-all.owl 的分离形态。
        <owl:imports rdf:resource="http://example.org/plumblossom/abox"/>
        -->
        <rdfs:label xml:lang="zh">梅花易数本体总入口（TBox 聚合入口；ABox 由应用侧独立加载）</rdfs:label>
        <rdfs:comment xml:lang="zh">第 9 步产出：聚合入口，显式导入 TBox。ABox 的 imports 依铁律 11 注释掉，由应用工程经 ontology.abox-path 指向 plumblossom-abox.owl 独立加载。加载此文件即可导入全部 TBox 模块。</rdfs:comment>
    </owl:Ontology>

</rdf:RDF>
