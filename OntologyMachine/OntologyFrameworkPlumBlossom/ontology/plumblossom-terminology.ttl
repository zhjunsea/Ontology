    skos:definition "上上…下下"@zh ;
    skos:broader term:JudgementDomain ;
    skos:exactMatch <http://example.org/plumblossom/judgement/YicuoJinGrade> .

term:OmenDomain
    a skos:Concept ;
    skos:prefLabel "外应域"@zh ;
    skos:altLabel "外应"@zh ;
    skos:altLabel "外卦"@zh ;
    skos:altLabel "应卦"@zh ;
    skos:broader term:PlumBlossomEntity ;
    skos:exactMatch <http://example.org/plumblossom/omens/OmenDomain> .

term:TenResponses
    a skos:Concept ;
    skos:prefLabel "十应"@zh ;
    skos:altLabel "十应奥论"@zh ;
    skos:broader term:OmenDomain ;
    skos:exactMatch <http://example.org/plumblossom/omens/TenResponses> .

term:ThreeEssentials
    a skos:Concept ;
    skos:prefLabel "三要"@zh ;
    skos:altLabel "三要灵验"@zh ;
    skos:altLabel "耳目心"@zh ;
    skos:definition "耳/目/心"@zh ;
    skos:broader term:OmenDomain ;
    skos:exactMatch <http://example.org/plumblossom/omens/ThreeEssentials> .

term:BodyUseRelation
    a skos:Concept ;
    skos:prefLabel "体用关系"@zh ;
    skos:altLabel "体用"@zh ;
    skos:broader term:YiliDomain ;
    skos:exactMatch <http://example.org/plumblossom/relations/BodyUseRelation> .

term:FivePhase
    a skos:Concept ;
    skos:prefLabel "五行"@zh ;
