@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix term: <http://example.org/plumblossom/term/> .

<http://example.org/plumblossom/term>
    a owl:Ontology ;
    a skos:ConceptScheme ;
    skos:prefLabel "梅花易数业务术语体系"@zh ;
    skos:prefLabel "Plum Blossom Numerology Business Terminology"@en ;
    dct:created "2026-10-20"^^<http://www.w3.org/2001/XMLSchema#date> ;
    dct:description "梅花易数领域核心业务术语的标准化词汇表，术语全部来源于本体 (owl:Class / owl:ObjectProperty / owl:DatatypeProperty 的 rdfs:label)，用于统一 OWL 本体及其他系统中的词义，实现同名同义、同义同名。"@zh .

# ========================
# 类（业务概念）（71）
# ========================
term:CalendarDatum
    a skos:Concept ;
    skos:prefLabel "历法数据"@zh ;
    skos:altLabel "历法"@zh ;
    skos:broader term:CalendarDomain ;
    skos:exactMatch <http://example.org/plumblossom/calendars/CalendarDatum> .

term:CalendarDomain
    a skos:Concept ;
    skos:prefLabel "历法域"@zh ;
    skos:broader term:PlumBlossomEntity ;
    skos:exactMatch <http://example.org/plumblossom/calendars/CalendarDomain> .

term:EarthlyBranch
    a skos:Concept ;
    skos:prefLabel "十二地支"@zh ;
    skos:altLabel "十二支"@zh ;
    skos:broader term:CalendarDomain ;
    skos:exactMatch <http://example.org/plumblossom/calendars/EarthlyBranch> .

term:HeavenlyStem
    a skos:Concept ;
    skos:prefLabel "十天干"@zh ;
    skos:altLabel "十干"@zh ;
    skos:broader term:CalendarDomain ;
    skos:exactMatch <http://example.org/plumblossom/calendars/HeavenlyStem> .

term:LifeStage
    a skos:Concept ;
    skos:prefLabel "五行长生"@zh ;
    skos:altLabel "长生"@zh ;
    skos:broader term:CalendarDomain ;
    skos:exactMatch <http://example.org/plumblossom/calendars/LifeStage> .

term:NaYin
    a skos:Concept ;
    skos:prefLabel "纳音"@zh ;
    skos:altLabel "纳音五行"@zh ;
    skos:broader term:CalendarDomain ;
    skos:exactMatch <http://example.org/plumblossom/calendars/NaYin> .

term:SexagenaryCycle
    a skos:Concept ;
    skos:prefLabel "六十甲子"@zh ;
    skos:altLabel "花甲"@zh ;
    skos:altLabel "六十花甲"@zh ;
    skos:broader term:CalendarDomain ;
    skos:exactMatch <http://example.org/plumblossom/calendars/SexagenaryCycle> .

term:ChangedHexagram
    a skos:Concept ;
    skos:prefLabel "变卦"@zh ;
    skos:altLabel "变应"@zh ;
    skos:broader term:Hexagram ;
    skos:exactMatch <http://example.org/plumblossom/core/ChangedHexagram> .

term:Direction
    a skos:Concept ;
    skos:prefLabel "八方"@zh ;
    skos:altLabel "方位"@zh ;
    skos:broader term:HexagramDomain ;
    skos:exactMatch <http://example.org/plumblossom/core/Direction> .

term:Hexagram
    a skos:Concept ;
    skos:prefLabel "重卦"@zh ;
    skos:definition "由上下卦组成"@zh ;
    skos:broader term:HexagramDomain ;
    skos:exactMatch <http://example.org/plumblossom/core/Hexagram> .

term:HexagramDomain
    a skos:Concept ;
    skos:prefLabel "卦象域"@zh ;
    skos:broader term:PlumBlossomEntity ;
    skos:exactMatch <http://example.org/plumblossom/core/HexagramDomain> .

term:Line
    a skos:Concept ;
    skos:prefLabel "爻"@zh ;
    skos:broader term:HexagramDomain ;
    skos:exactMatch <http://example.org/plumblossom/core/Line> .

term:MovingLine
    a skos:Concept ;
    skos:prefLabel "动爻"@zh ;
    skos:definition "一卦一爻动"@zh ;
    skos:broader term:Line ;
    skos:exactMatch <http://example.org/plumblossom/core/MovingLine> .

term:MutualHexagram
    a skos:Concept ;
    skos:prefLabel "互卦"@zh ;
    skos:altLabel "互应"@zh ;
    skos:broader term:Hexagram ;
    skos:exactMatch <http://example.org/plumblossom/core/MutualHexagram> .

term:OriginalHexagram
    a skos:Concept ;
    skos:prefLabel "本卦"@zh ;
    skos:altLabel "正卦"@zh ;
    skos:broader term:Hexagram ;
    skos:exactMatch <http://example.org/plumblossom/core/OriginalHexagram> .

term:PlumBlossomEntity
    a skos:Concept ;
    skos:prefLabel "本体事物根"@zh ;
    skos:definition "梅花易数本体根类"@zh ;
    skos:exactMatch <http://example.org/plumblossom/core/PlumBlossomEntity> .

term:SixBitHexagram
    a skos:Concept ;
    skos:prefLabel "六十四卦名录"@zh ;
    skos:altLabel "六十四卦"@zh ;
    skos:definition "术语型"@zh ;
    skos:broader term:Hexagram ;
    skos:exactMatch <http://example.org/plumblossom/core/SixBitHexagram> .

term:Trigram
    a skos:Concept ;
    skos:prefLabel "八卦"@zh ;
    skos:broader term:HexagramDomain ;
    skos:exactMatch <http://example.org/plumblossom/core/Trigram> .

term:YangLine
    a skos:Concept ;
    skos:prefLabel "阳爻"@zh ;
    skos:broader term:Line ;
    skos:exactMatch <http://example.org/plumblossom/core/YangLine> .

term:YinLine
    a skos:Concept ;
    skos:prefLabel "阴爻"@zh ;
    skos:broader term:Line ;
    skos:exactMatch <http://example.org/plumblossom/core/YinLine> .

term:BirdMethod
    a skos:Concept ;
    skos:prefLabel "鸟占"@zh ;
    skos:altLabel "风觉鸟占"@zh ;
    skos:broader term:ImageBasedMethod ;
    skos:exactMatch <http://example.org/plumblossom/divination/BirdMethod> .

term:CharacterMethod
    a skos:Concept ;
    skos:prefLabel "字占"@zh ;
    skos:broader term:NumberBasedMethod ;
    skos:exactMatch <http://example.org/plumblossom/divination/CharacterMethod> .

term:ChiCunMethod
    a skos:Concept ;
    skos:prefLabel "尺寸物占"@zh ;
    skos:broader term:NumberBasedMethod ;
    skos:exactMatch <http://example.org/plumblossom/divination/ChiCunMethod> .

term:ColorMethod
    a skos:Concept ;
    skos:prefLabel "验色占"@zh ;
    skos:broader term:ImageBasedMethod ;
    skos:exactMatch <http://example.org/plumblossom/divination/ColorMethod> .

term:DivinationInput
    a skos:Concept ;
    skos:prefLabel "起卦域"@zh ;
    skos:altLabel "起卦"@zh ;
    skos:broader term:PlumBlossomEntity ;
    skos:exactMatch <http://example.org/plumblossom/divination/DivinationInput> .

term:DivinationMethod
    a skos:Concept ;
    skos:prefLabel "起卦法类别"@zh ;
    skos:altLabel "起卦法"@zh ;
    skos:definition "共 17 子类（卷之一十六类 + 附录一撮金）"@zh ;
    skos:broader term:DivinationInput ;
    skos:exactMatch <http://example.org/plumblossom/divination/DivinationMethod> .

term:DivinationSubject
    a skos:Concept ;
    skos:prefLabel "占断事项域"@zh ;
    skos:altLabel "占断事项"@zh ;
    skos:broader term:PlumBlossomEntity ;
    skos:exactMatch <http://example.org/plumblossom/divination/DivinationSubject> .

term:HeardSoundMethod
    a skos:Concept ;
    skos:prefLabel "听声音占"@zh ;
    skos:broader term:ImageBasedMethod ;
    skos:exactMatch <http://example.org/plumblossom/divination/HeardSoundMethod> .

term:ImageBasedMethod
    a skos:Concept ;
    skos:prefLabel "后天·端法·以象起卦"@zh ;
    skos:altLabel "后天起卦法"@zh ;
    skos:altLabel "以象起卦"@zh ;
    skos:altLabel "端法"@zh ;
    skos:altLabel "后天之数"@zh ;
    skos:broader term:DivinationMethod ;
    skos:exactMatch <http://example.org/plumblossom/divination/ImageBasedMethod> .

term:InputDatum
    a skos:Concept ;
    skos:prefLabel "起卦输入数据"@zh ;
    skos:broader term:DivinationInput ;
    skos:exactMatch <http://example.org/plumblossom/divination/InputDatum> .

term:MovingThingMethod
    a skos:Concept ;
    skos:prefLabel "占动物"@zh ;
    skos:broader term:ImageBasedMethod ;
    skos:exactMatch <http://example.org/plumblossom/divination/MovingThingMethod> .

term:NumberBasedMethod
    a skos:Concept ;
    skos:prefLabel "先天·以数起卦"@zh ;
    skos:altLabel "先天起卦法"@zh ;
    skos:altLabel "以数起卦"@zh ;
    skos:altLabel "先天之数"@zh ;
    skos:broader term:DivinationMethod ;
    skos:exactMatch <http://example.org/plumblossom/divination/NumberBasedMethod> .

term:ObjectCountMethod
    a skos:Concept ;
    skos:prefLabel "物占数"@zh ;
    skos:altLabel "物数占"@zh ;
    skos:broader term:NumberBasedMethod ;
    skos:exactMatch <http://example.org/plumblossom/divination/ObjectCountMethod> .

term:PersonObserveMethod
    a skos:Concept ;
    skos:prefLabel "为人占"@zh ;
    skos:broader term:ImageBasedMethod ;
    skos:exactMatch <http://example.org/plumblossom/divination/PersonObserveMethod> .

term:Precept
    a skos:Concept ;
    skos:prefLabel "心法戒律·四不占"@zh ;
    skos:altLabel "四不占"@zh ;
    skos:altLabel "不动不占"@zh ;
    skos:definition "四不占戒律（卷之一·观梅占；附录·一撮金）"@zh ;
    skos:broader term:DivinationInput ;
    skos:exactMatch <http://example.org/plumblossom/divination/Precept> .

term:SelfObserveMethod
    a skos:Concept ;
    skos:prefLabel "自己占"@zh ;
    skos:broader term:ImageBasedMethod ;
    skos:exactMatch <http://example.org/plumblossom/divination/SelfObserveMethod> .

term:ShapeMethod
    a skos:Concept ;
    skos:prefLabel "形物占"@zh ;
    skos:broader term:ImageBasedMethod ;
    skos:exactMatch <http://example.org/plumblossom/divination/ShapeMethod> .

term:SoundCountMethod
    a skos:Concept ;
    skos:prefLabel "声音占"@zh ;
    skos:broader term:NumberBasedMethod ;
    skos:exactMatch <http://example.org/plumblossom/divination/SoundCountMethod> .

term:StillThingMethod
    a skos:Concept ;
    skos:prefLabel "占静物"@zh ;
    skos:broader term:ImageBasedMethod ;
    skos:exactMatch <http://example.org/plumblossom/divination/StillThingMethod> .

term:ThingHexagramMethod
    a skos:Concept ;
    skos:prefLabel "物卦起例"@zh ;
    skos:altLabel "寓物卦数起例"@zh ;
    skos:broader term:ImageBasedMethod ;
    skos:exactMatch <http://example.org/plumblossom/divination/ThingHexagramMethod> .

term:WindMethod
    a skos:Concept ;
    skos:prefLabel "风觉占"@zh ;
    skos:altLabel "风觉鸟占"@zh ;
    skos:broader term:ImageBasedMethod ;
    skos:exactMatch <http://example.org/plumblossom/divination/WindMethod> .

term:YearMonthDayHourMethod
    a skos:Concept ;
    skos:prefLabel "年月日时起例"@zh ;
    skos:altLabel "年月日时占"@zh ;
    skos:broader term:NumberBasedMethod ;
    skos:exactMatch <http://example.org/plumblossom/divination/YearMonthDayHourMethod> .

term:YicuoJinMethod
    a skos:Concept ;
    skos:prefLabel "一撮金法"@zh ;
    skos:altLabel "一撮金"@zh ;
    skos:altLabel "邵康节易数一撮金"@zh ;
    skos:broader term:NumberBasedMethod ;
    skos:exactMatch <http://example.org/plumblossom/divination/YicuoJinMethod> .

term:ZhangChiMethod
    a skos:Concept ;
    skos:prefLabel "丈尺占"@zh ;
    skos:broader term:NumberBasedMethod ;
    skos:exactMatch <http://example.org/plumblossom/divination/ZhangChiMethod> .

term:Auspiciousness
    a skos:Concept ;
    skos:prefLabel "吉凶等级"@zh ;
    skos:altLabel "吉凶"@zh ;
    skos:definition "大吉/吉/平/凶/大凶"@zh ;
    skos:broader term:JudgementDomain ;
    skos:exactMatch <http://example.org/plumblossom/judgement/Auspiciousness> .

term:JudgementDomain
    a skos:Concept ;
    skos:prefLabel "断验域"@zh ;
    skos:broader term:PlumBlossomEntity ;
    skos:exactMatch <http://example.org/plumblossom/judgement/JudgementDomain> .

term:ResponsePeriod
    a skos:Concept ;
    skos:prefLabel "应期"@zh ;
    skos:altLabel "刻期"@zh ;
    skos:broader term:JudgementDomain ;
    skos:exactMatch <http://example.org/plumblossom/judgement/ResponsePeriod> .

term:SelfCultivationAdvice
    a skos:Concept ;
    skos:prefLabel "修身建议"@zh ;
    skos:altLabel "修身"@zh ;
    skos:broader term:JudgementDomain ;
    skos:exactMatch <http://example.org/plumblossom/judgement/SelfCultivationAdvice> .

term:SubjectCategory
    a skos:Concept ;
    skos:prefLabel "事项类别"@zh ;
    skos:altLabel "分类占断"@zh ;
    skos:altLabel "占断事项"@zh ;
    skos:definition "18 子类（卷之二十八章占例）"@zh ;
    skos:broader term:DivinationSubject ;
    skos:exactMatch <http://example.org/plumblossom/judgement/SubjectCategory> .

term:YicuoJinAdmonition
