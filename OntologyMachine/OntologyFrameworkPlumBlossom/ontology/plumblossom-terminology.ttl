# 类（业务概念）（71）
# ========================
term:CalendarDatum
    a skos:Concept ;
    skos:prefLabel "历法数据"@zh ;
    skos:altLabel "历法"@zh ;
    skos:broader term:CalendarDomain ;
    skos:exactMatch <cal:CalendarDatum> .

term:CalendarDomain
    a skos:Concept ;
    skos:prefLabel "历法域"@zh ;
    skos:broader term:PlumBlossomEntity ;
    skos:exactMatch <cal:CalendarDomain> .

term:EarthlyBranch
    a skos:Concept ;
    skos:prefLabel "十二地支"@zh ;
    skos:altLabel "十二支"@zh ;
    skos:broader term:CalendarDomain ;
    skos:exactMatch <cal:EarthlyBranch> .

term:HeavenlyStem
