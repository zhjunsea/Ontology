    skos:prefLabel "卦气旺衰"@zh ;
    skos:altLabel "衰旺"@zh ;
    skos:altLabel "旺衰"@zh ;
    skos:broader term:YiliDomain ;
    skos:exactMatch <http://example.org/plumblossom/relations/VitalityState> .

term:YiliDomain
    a skos:Concept ;
    skos:prefLabel "易理域"@zh ;
    skos:broader term:PlumBlossomEntity ;
    skos:exactMatch <http://example.org/plumblossom/relations/YiliDomain> .

term:ImageSymbol
    a skos:Concept ;
    skos:prefLabel "万物类象"@zh ;
    skos:altLabel "类象"@zh ;
    skos:altLabel "取象"@zh ;
    skos:altLabel "万物类占"@zh ;
    skos:broader term:YiliDomain ;
    skos:exactMatch <http://example.org/plumblossom/symbols/ImageSymbol> .

term:ModernEntity
