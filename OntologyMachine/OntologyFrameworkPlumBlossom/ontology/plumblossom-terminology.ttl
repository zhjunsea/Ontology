    skos:exactMatch <http://example.org/plumblossom/relations/Sheng> .

term:ShengKeRelation
    a skos:Concept ;
    skos:prefLabel "五行生克关系"@zh ;
    skos:altLabel "生克比和"@zh ;
    skos:altLabel "生克"@zh ;
    skos:broader term:YiliDomain ;
    skos:exactMatch <http://example.org/plumblossom/relations/ShengKeRelation> .

term:TrigramNature
    a skos:Concept ;
    skos:prefLabel "八卦性情"@zh ;
    skos:altLabel "卦德"@zh ;
    skos:broader term:YiliDomain ;
    skos:exactMatch <http://example.org/plumblossom/relations/TrigramNature> .

term:TrigramOrder
    a skos:Concept ;
