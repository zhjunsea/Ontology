<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns="http://example.org/plumblossom/calendars"
         xml:base="http://example.org/plumblossom/calendars"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:swrl="http://www.w3.org/2003/11/swrl#"
         xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
         xmlns:core="http://example.org/plumblossom/core/"
         xmlns:div="http://example.org/plumblossom/divination/"
         xmlns:yijing="http://example.org/plumblossom/yijing/"
         xmlns:rel="http://example.org/plumblossom/relations/"
         xmlns:sym="http://example.org/plumblossom/symbols/"
         xmlns:ome="http://example.org/plumblossom/omens/"
         xmlns:jud="http://example.org/plumblossom/judgement/"
         xmlns:cal="http://example.org/plumblossom/calendars/"
         xmlns:rules="http://example.org/plumblossom/rules#">

    <owl:Ontology rdf:about="http://example.org/plumblossom/calendars">
        <rdfs:label xml:lang="zh">梅花易数 TBox 子本体 · cal</rdfs:label>
        <rdfs:comment xml:lang="zh">第 10 步产出：TBox 按业务域拆分（历法：干支/六十甲子/纳音/长生）。命名空间保持 http://example.org/plumblossom/cal 不变；由 plumblossom-tbox.owl 聚合入口统一 imports。</rdfs:comment>
    </owl:Ontology>
    <owl:Class rdf:about="http://example.org/plumblossom/calendars/CalendarDomain">
        <rdfs:label xml:lang="zh">历法域</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://example.org/plumblossom/core/PlumBlossomEntity"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/plumblossom/calendars/HeavenlyStem">
        <rdfs:label xml:lang="zh">十天干</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://example.org/plumblossom/calendars/CalendarDomain"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/plumblossom/calendars/EarthlyBranch">
        <rdfs:label xml:lang="zh">十二地支</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://example.org/plumblossom/calendars/CalendarDomain"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/plumblossom/calendars/SexagenaryCycle">
        <rdfs:label xml:lang="zh">六十甲子</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://example.org/plumblossom/calendars/CalendarDomain"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/plumblossom/calendars/NaYin">
        <rdfs:label xml:lang="zh">纳音</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://example.org/plumblossom/calendars/CalendarDomain"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/plumblossom/calendars/LifeStage">
        <rdfs:label xml:lang="zh">五行长生</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://example.org/plumblossom/calendars/CalendarDomain"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/plumblossom/calendars/CalendarDatum">
        <rdfs:label xml:lang="zh">历法数据</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://example.org/plumblossom/calendars/CalendarDomain"/>
    </owl:Class>

    <owl:ObjectProperty rdf:about="http://example.org/plumblossom/calendars/hasStem">
        <rdfs:label xml:lang="zh">有天干</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/calendars/CalendarDatum"/>
        <rdfs:range rdf:resource="http://example.org/plumblossom/calendars/HeavenlyStem"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/plumblossom/calendars/isStemOf">
        <rdfs:domain rdf:resource="http://example.org/plumblossom/calendars/HeavenlyStem"/>
        <rdfs:range rdf:resource="http://example.org/plumblossom/calendars/CalendarDatum"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/plumblossom/calendars/hasBranch">
        <rdfs:label xml:lang="zh">有地支</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/calendars/CalendarDatum"/>
        <rdfs:range rdf:resource="http://example.org/plumblossom/calendars/EarthlyBranch"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/plumblossom/calendars/isBranchOf">
        <rdfs:domain rdf:resource="http://example.org/plumblossom/calendars/EarthlyBranch"/>
        <rdfs:range rdf:resource="http://example.org/plumblossom/calendars/CalendarDatum"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/plumblossom/calendars/stemFivePhase">
        <rdfs:label xml:lang="zh">天干五行</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/calendars/HeavenlyStem"/>
        <rdfs:range rdf:resource="http://example.org/plumblossom/relations/FivePhase"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/plumblossom/calendars/branchFivePhase">
        <rdfs:label xml:lang="zh">地支五行</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/calendars/EarthlyBranch"/>
        <rdfs:range rdf:resource="http://example.org/plumblossom/relations/FivePhase"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/plumblossom/calendars/hasNaYin">
        <rdfs:label xml:lang="zh">有纳音</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/calendars/SexagenaryCycle"/>
        <rdfs:range rdf:resource="http://example.org/plumblossom/calendars/NaYin"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/plumblossom/calendars/isNaYinOf">
        <rdfs:domain rdf:resource="http://example.org/plumblossom/calendars/NaYin"/>
        <rdfs:range rdf:resource="http://example.org/plumblossom/calendars/SexagenaryCycle"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/plumblossom/calendars/naYinPhase">
        <rdfs:label xml:lang="zh">纳音五行</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/calendars/NaYin"/>
        <rdfs:range rdf:resource="http://example.org/plumblossom/relations/FivePhase"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/plumblossom/calendars/datumFivePhase">
        <rdfs:label xml:lang="zh">历法数据五行</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/calendars/CalendarDatum"/>
        <rdfs:range rdf:resource="http://example.org/plumblossom/relations/FivePhase"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/plumblossom/calendars/hasLifeStage">
        <rdfs:label xml:lang="zh">有长生</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/relations/FivePhase"/>
        <rdfs:range rdf:resource="http://example.org/plumblossom/calendars/LifeStage"/>
    </owl:ObjectProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/plumblossom/calendars/ganzhiYear">
        <rdfs:label xml:lang="zh">干支纪年</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/calendars/CalendarDatum"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/plumblossom/calendars/ganzhiMonth">
        <rdfs:label xml:lang="zh">干支纪月</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/calendars/CalendarDatum"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/plumblossom/calendars/ganzhiDay">
        <rdfs:label xml:lang="zh">干支纪日</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/calendars/CalendarDatum"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/plumblossom/calendars/ganzhiHour">
        <rdfs:label xml:lang="zh">干支纪时</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/calendars/CalendarDatum"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/plumblossom/calendars/season">
        <rdfs:label xml:lang="zh">季节</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/calendars/CalendarDatum"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/plumblossom/calendars/stemName">
        <rdfs:label xml:lang="zh">天干名</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/calendars/HeavenlyStem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/plumblossom/calendars/branchName">
        <rdfs:label xml:lang="zh">地支名</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/calendars/EarthlyBranch"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/plumblossom/calendars/branchAnimal">
        <rdfs:label xml:lang="zh">生肖</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/calendars/EarthlyBranch"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/plumblossom/calendars/zhiOrder">
        <rdfs:label xml:lang="zh">地支序</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/calendars/EarthlyBranch"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/plumblossom/calendars/naYinName">
        <rdfs:label xml:lang="zh">纳音名</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/calendars/NaYin"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/plumblossom/calendars/lifeStageText">
        <rdfs:label xml:lang="zh">长生文本</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/plumblossom/calendars/LifeStage"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <!-- ==================== 约束（owl:Restriction） ==================== -->
    <owl:Class rdf:about="http://example.org/plumblossom/calendars/CalendarDatum">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/plumblossom/calendars/hasStem"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://example.org/plumblossom/calendars/HeavenlyStem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/plumblossom/calendars/CalendarDatum">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/plumblossom/calendars/hasBranch"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://example.org/plumblossom/calendars/EarthlyBranch"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>


</rdf:RDF>
