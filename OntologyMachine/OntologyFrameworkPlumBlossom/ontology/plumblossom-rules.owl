                                <swrl:propertyPredicate rdf:resource="http://example.org/plumblossom/core/hasMovingLine"/>
                                <swrl:argument1 rdf:resource="http://example.org/plumblossom/rules#h2"/>
                                <swrl:argument2 rdf:resource="http://example.org/plumblossom/rules#m2"/>
                            </rdf:Description>
            </rdf:first>
            <rdf:rest>
<rdf:Description>
            <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
            <rdf:first>
                <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://example.org/plumblossom/core/linePosition"/>
                                <swrl:argument1 rdf:resource="http://example.org/plumblossom/rules#m2"/>
                                <swrl:argument2 rdf:resource="http://example.org/plumblossom/rules#p2"/>
                            </rdf:Description>
            </rdf:first>
            <rdf:rest>
<rdf:Description>
            <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
            <rdf:first>
                <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/>
                                <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#greaterThan"/>
                                <swrl:arguments>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first rdf:resource="http://example.org/plumblossom/rules#p2"/>
                                        <rdf:rest>
<rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</rdf:first>
                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                    </rdf:Description>
</rdf:rest>
                                    </rdf:Description>
                                </swrl:arguments>
                            </rdf:Description>
            </rdf:first>
            <rdf:rest>
<rdf:Description>
            <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
            <rdf:first>
                <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://example.org/plumblossom/core/hasUpperTrigram"/>
                                <swrl:argument1 rdf:resource="http://example.org/plumblossom/rules#h2"/>
                                <swrl:argument2 rdf:resource="http://example.org/plumblossom/rules#use2"/>
                            </rdf:Description>
            </rdf:first>
