    <!-- R1 体用判定：动爻在 1/2/3 → 下卦为用、上卦为体 -->
    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
        <rdf:Description>
            <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
            <rdf:first>
                <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                <swrl:classPredicate rdf:resource="http://example.org/plumblossom/core/OriginalHexagram"/>
                                <swrl:argument1 rdf:resource="http://example.org/plumblossom/rules#h"/>
                            </rdf:Description>
            </rdf:first>
            <rdf:rest>
<rdf:Description>
            <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
            <rdf:first>
                <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://example.org/plumblossom/core/hasMovingLine"/>
                                <swrl:argument1 rdf:resource="http://example.org/plumblossom/rules#h"/>
                                <swrl:argument2 rdf:resource="http://example.org/plumblossom/rules#m"/>
                            </rdf:Description>
            </rdf:first>
            <rdf:rest>
<rdf:Description>
            <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
            <rdf:first>
                <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://example.org/plumblossom/core/linePosition"/>
                                <swrl:argument1 rdf:resource="http://example.org/plumblossom/rules#m"/>
                                <swrl:argument2 rdf:resource="http://example.org/plumblossom/rules#p"/>
                            </rdf:Description>
            </rdf:first>
            <rdf:rest>
<rdf:Description>
            <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
            <rdf:first>
                <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/>
                                <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#lessThanOrEqual"/>
                                <swrl:arguments>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first rdf:resource="http://example.org/plumblossom/rules#p"/>
                                        <rdf:rest>
<rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</rdf:first>
                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                    </rdf:Description>
</rdf:rest>
                                    </rdf:Description>
                                </swrl:arguments>
                            </rdf:Description>
            </rdf:first>
            <rdf:rest>
<rdf:Description>
            <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
            <rdf:first>
                <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://example.org/plumblossom/core/hasLowerTrigram"/>
                                <swrl:argument1 rdf:resource="http://example.org/plumblossom/rules#h"/>
                                <swrl:argument2 rdf:resource="http://example.org/plumblossom/rules#use"/>
                            </rdf:Description>
            </rdf:first>
            <rdf:rest>
<rdf:Description>
            <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
            <rdf:first>
                <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://example.org/plumblossom/core/hasUpperTrigram"/>
                                <swrl:argument1 rdf:resource="http://example.org/plumblossom/rules#h"/>
                                <swrl:argument2 rdf:resource="http://example.org/plumblossom/rules#body"/>
                            </rdf:Description>
            </rdf:first>
            <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
</rdf:rest>
        </rdf:Description>
</rdf:rest>
        </rdf:Description>
</rdf:rest>
        </rdf:Description>
</rdf:rest>
        </rdf:Description>
</rdf:rest>
        </rdf:Description>
        </swrl:body>
        <swrl:head>
        <rdf:Description>
            <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
            <rdf:first>
                <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://example.org/plumblossom/relations/hasUseTrigram"/>
                                <swrl:argument1 rdf:resource="http://example.org/plumblossom/rules#h"/>
                                <swrl:argument2 rdf:resource="http://example.org/plumblossom/rules#use"/>
                            </rdf:Description>
            </rdf:first>
            <rdf:rest>
<rdf:Description>
            <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
            <rdf:first>
                <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://example.org/plumblossom/relations/hasBodyTrigram"/>
                                <swrl:argument1 rdf:resource="http://example.org/plumblossom/rules#h"/>
                                <swrl:argument2 rdf:resource="http://example.org/plumblossom/rules#body"/>
                            </rdf:Description>
            </rdf:first>
            <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
</rdf:rest>
        </rdf:Description>
        </swrl:head>
    </rdf:Description>

    <!-- R2 体用判定：动爻在 4/5/6 → 上卦为用、下卦为体 -->
    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
        <rdf:Description>
            <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
            <rdf:first>
