    <owl:DatatypeProperty rdf:about="#reportValidity"><rdfs:domain rdf:resource="#RefreshSignal"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">洞察成果有效期</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#refreshTrigger"><rdfs:domain rdf:resource="#RefreshSignal"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">触发刷新的信号</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#deliverableLevel"><rdfs:domain rdf:resource="#LayeredDeliverable"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">交付层级</rdfs:label></owl:DatatypeProperty>
