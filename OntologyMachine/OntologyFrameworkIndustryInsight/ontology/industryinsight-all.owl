    <owl:DatatypeProperty rdf:about="#dmuRole"><rdfs:domain rdf:resource="#DecisionMakingUnit"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">决策链角色</rdfs:label></owl:DatatypeProperty>
