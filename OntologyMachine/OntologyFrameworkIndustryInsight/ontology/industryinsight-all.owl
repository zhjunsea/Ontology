    <owl:DatatypeProperty rdf:about="#requiresOutbound"><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/><rdfs:label xml:lang="zh">需外发（SWRL 推导）</rdfs:label></owl:DatatypeProperty>
