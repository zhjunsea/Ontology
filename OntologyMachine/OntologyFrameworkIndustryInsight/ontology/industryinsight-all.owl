<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns="http://example.org/industryinsight#"
         xml:base="http://example.org/industryinsight#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:skos="http://www.w3.org/2004/02/skos/core#"
         xmlns:swrl="http://www.w3.org/2003/11/swrl#"
         xmlns:swrlb="http://www.w3.org/2003/11/swrlb#">

    <owl:Ontology rdf:about="http://example.org/industryinsight#">
        <rdfs:label xml:lang="zh">行业洞察（IndustryInsight）单文件本体（TBox + 典型 ABox）</rdfs:label>
        <rdfs:comment xml:lang="zh">「五看三定」战略洞察方法论的框架与判据本体化；泛化为任意行业，不含任何特定行业事实/数值（未经确认处标【待考】）。命名空间采用单一前缀。本文件为第 6 步单文件（第 9/10 步再分离/拆分）。</rdfs:comment>
    </owl:Ontology>

    <!-- ====================== OBJECT PROPERTIES ====================== -->
    <owl:ObjectProperty rdf:about="#derivedFrom">
        <rdfs:range rdf:resource="#InsightScenario"/>
        <rdfs:label xml:lang="zh">源自洞察场景</rdfs:label>
        <rdfs:comment xml:lang="zh">各洞察/机会/报告追溯到 InsightScenario（★10 可追溯）</rdfs:comment>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#derivedInsight">
        <owl:inverseOf rdf:resource="#derivedFrom"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#belongsToScenario">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="#IndustryInsightConcept"/>
        <rdfs:range rdf:resource="#InsightScenario"/>
        <rdfs:label xml:lang="zh">属于洞察场景</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasConclusion">
        <rdfs:domain rdf:resource="#InsightConclusionSet"/>
        <rdfs:range rdf:resource="#InsightConclusion"/>
        <rdfs:label xml:lang="zh">含洞察结论</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#conclusionOf">
        <owl:inverseOf rdf:resource="#hasConclusion"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasEvidenceLog">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="#InsightConclusionSet"/>
        <rdfs:range rdf:resource="#ConclusionEvidenceLog"/>
        <rdfs:label xml:lang="zh">含结论证据台账</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#evidencedBy">
        <rdfs:domain rdf:resource="#InsightConclusion"/>
        <rdfs:range rdf:resource="#ToolFinding"/>
        <rdfs:label xml:lang="zh">由证据支撑</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#evidenceFor">
        <owl:inverseOf rdf:resource="#evidencedBy"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#basedOn">
        <rdfs:domain rdf:resource="#Opportunity"/>
        <rdfs:range rdf:resource="#FiveLooksInsight"/>
        <rdfs:label xml:lang="zh">基于五看洞察</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasToolFinding">
        <rdfs:range rdf:resource="#ToolFinding"/>
        <rdfs:label xml:lang="zh">含工具结论</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#findingOf">
        <owl:inverseOf rdf:resource="#hasToolFinding"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasConsensusPoint">
        <rdfs:range rdf:resource="#ConsensusPoint"/>
        <rdfs:label xml:lang="zh">含共识点</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#consensusOf">
        <owl:inverseOf rdf:resource="#hasConsensusPoint"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasDivergencePoint">
        <rdfs:range rdf:resource="#DivergencePoint"/>
        <rdfs:label xml:lang="zh">含分歧点</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#divergenceOf">
        <owl:inverseOf rdf:resource="#hasDivergencePoint"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasAnalysisSummary">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="#AnalysisSummary"/>
        <rdfs:label xml:lang="zh">含总结分析</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#summaryOf">
        <owl:inverseOf rdf:resource="#hasAnalysisSummary"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#referencesTool">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="#ToolFinding"/>
        <rdfs:range rdf:resource="#AnalysisTool"/>
        <rdfs:label xml:lang="zh">引用分析工具</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasQualityChecklist">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="#FiveLooksInsight"/>
        <rdfs:range rdf:resource="#QualityChecklist"/>
        <rdfs:label xml:lang="zh">含质量检查清单</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasDmu">
        <rdfs:domain rdf:resource="#MarketCustomerInsight"/>
        <rdfs:range rdf:resource="#DecisionMakingUnit"/>
        <rdfs:label xml:lang="zh">含决策链角色</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasOpportunity">
        <rdfs:domain rdf:resource="#OpportunityList"/>
        <rdfs:range rdf:resource="#Opportunity"/>
        <rdfs:label xml:lang="zh">含机会点</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#opportunityOf">
        <owl:inverseOf rdf:resource="#hasOpportunity"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasSpanPosition">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="#Opportunity"/>
        <rdfs:range rdf:resource="#SpanPosition"/>
        <rdfs:label xml:lang="zh">含 SPAN 定位</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasPriority">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="#Opportunity"/>
        <rdfs:range rdf:resource="#OpportunityPriority"/>
        <rdfs:label xml:lang="zh">含优先级</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasControlPoint">
        <rdfs:range rdf:resource="#StrategicControlPoint"/>
        <rdfs:label xml:lang="zh">含战略控制点</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#controlPointOf">
        <owl:inverseOf rdf:resource="#hasControlPoint"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasControlPointType">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="#StrategicControlPoint"/>
        <rdfs:range rdf:resource="#ControlPointType"/>
        <rdfs:label xml:lang="zh">控制点类型</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasObjective">
        <rdfs:range rdf:resource="#Objective"/>
        <rdfs:label xml:lang="zh">含目标</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#objectiveOf">
        <owl:inverseOf rdf:resource="#hasObjective"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasStrategy">
        <rdfs:range rdf:resource="#Strategy"/>
        <rdfs:label xml:lang="zh">含策略</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#strategyOf">
        <owl:inverseOf rdf:resource="#hasStrategy"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#mapsToStrategy">
        <rdfs:domain rdf:resource="#KeyInsightConversionTable"/>
        <rdfs:range rdf:resource="#Strategy"/>
        <rdfs:label xml:lang="zh">映射到策略</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#mapsFromInsight">
        <rdfs:domain rdf:resource="#KeyInsightConversionTable"/>
        <rdfs:range rdf:resource="#FiveLooksInsight"/>
        <rdfs:label xml:lang="zh">映射自洞察</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#includesInsight">
        <rdfs:range rdf:resource="#IndustryInsightConcept"/>
        <rdfs:label xml:lang="zh">汇总包含</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#includedInReport">
        <owl:inverseOf rdf:resource="#includesInsight"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasSoWhat">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="#InsightReport"/>
        <rdfs:range rdf:resource="#SoWhat"/>
        <rdfs:label xml:lang="zh">含 So What</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasRefreshSignal">
        <rdfs:domain rdf:resource="#InsightReport"/>
        <rdfs:range rdf:resource="#RefreshSignal"/>
        <rdfs:label xml:lang="zh">含刷新信号</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasLayeredDeliverable">
        <rdfs:domain rdf:resource="#InsightReport"/>
        <rdfs:range rdf:resource="#LayeredDeliverable"/>
        <rdfs:label xml:lang="zh">含分层交付物</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#triggeredBy">
        <rdfs:domain rdf:resource="#OutboundInsightMessage"/>
        <rdfs:range rdf:resource="#IndustryInsightConcept"/>
        <rdfs:label xml:lang="zh">触发自</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#relatesToInsight">
        <rdfs:domain rdf:resource="#OutboundInsightMessage"/>
        <rdfs:range rdf:resource="#FiveLooksInsight"/>
        <rdfs:label xml:lang="zh">关联洞察</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#resolves">
        <rdfs:domain rdf:resource="#ConflictResolution"/>
        <rdfs:range rdf:resource="#DivergencePoint"/>
        <rdfs:label xml:lang="zh">消解分歧</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#marksPending">
        <rdfs:domain rdf:resource="#InsightConsistencyMatrix"/>
        <rdfs:range rdf:resource="#PendingJudgment"/>
        <rdfs:label xml:lang="zh">标记待确认判断</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#mapsConclusion">
        <rdfs:domain rdf:resource="#ConclusionStrategyMapping"/>
        <rdfs:range rdf:resource="#KeyJudgment"/>
        <rdfs:label xml:lang="zh">映射结论</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#plansActionOf">
        <rdfs:domain rdf:resource="#ActionPlan"/>
        <rdfs:range rdf:resource="#KeyJudgment"/>
        <rdfs:label xml:lang="zh">为结论制定应用行动</rdfs:label>
    </owl:ObjectProperty>

    <!-- ====================== DATA PROPERTIES ====================== -->
    <owl:DatatypeProperty rdf:about="#scenarioText"><rdfs:domain rdf:resource="#InsightScenario"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">洞察场景文本</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#industryDomain"><rdfs:domain rdf:resource="#InsightScenario"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">行业/领域</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#region"><rdfs:domain rdf:resource="#InsightScenario"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">地域范围</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#timeWindow"><rdfs:domain rdf:resource="#InsightScenario"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">时间窗</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#insightGoal"><rdfs:domain rdf:resource="#InsightScenario"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">洞察目标</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#parseSource"><rdfs:domain rdf:resource="#InsightScenario"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">解析来源（LLM/Fallback）</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#validationResult"><rdfs:domain rdf:resource="#ScenarioValidation"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">校验结果（通过/不通过）</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#missingElement"><rdfs:domain rdf:resource="#ScenarioValidation"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">缺失要素</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#clarificationText"><rdfs:domain rdf:resource="#ScenarioClarification"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">澄清提示文本</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#conclusionStatement"><rdfs:domain rdf:resource="#InsightConclusion"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">结论陈述</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#conclusionBranch"><rdfs:domain rdf:resource="#InsightConclusion"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">结论分支</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#keySupportPoint"><rdfs:domain rdf:resource="#InsightConclusion"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">支撑要点</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#evidenceSource"><rdfs:domain rdf:resource="#InsightConclusion"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">证据来源</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#uncertaintyLevel"><rdfs:domain rdf:resource="#KeyJudgment"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">不确定性等级</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#riskIfInvalid"><rdfs:domain rdf:resource="#KeyJudgment"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">若不成立的影响</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#validationApproach"><rdfs:domain rdf:resource="#ActionPlan"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">应用途径</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#validationRole"><rdfs:domain rdf:resource="#ActionPlan"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">责任角色</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#validationTimepoint"><rdfs:domain rdf:resource="#ActionPlan"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">应用时间点</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#findingConclusion"><rdfs:domain rdf:resource="#ToolFinding"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">工具结论</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#citation"><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">出处/【待考】</rdfs:label><rdfs:comment xml:lang="zh">横切：结论类均须标出处（★8/9/10）</rdfs:comment></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#sourceLevel"><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">数据来源等级</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#confidence"><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">置信度</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#opportunityName"><rdfs:domain rdf:resource="#Opportunity"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">机会点名称</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#targetCustomerScene"><rdfs:domain rdf:resource="#Opportunity"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">目标客群场景</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#painpointEvidence"><rdfs:domain rdf:resource="#Opportunity"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">客户痛点证据</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#marketSizeEstimate"><rdfs:domain rdf:resource="#Opportunity"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/><rdfs:label xml:lang="zh">市场规模估算【待考】</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#competitiveGap"><rdfs:domain rdf:resource="#Opportunity"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">竞争空隙</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#requiredCapability"><rdfs:domain rdf:resource="#Opportunity"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">所需核心能力</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#priorityValue"><rdfs:domain rdf:resource="#OpportunityPriority"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">优先级值（高/中/低）</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#spanAttractiveness"><rdfs:domain rdf:resource="#SpanPosition"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/><rdfs:label xml:lang="zh">市场吸引力【待考：量纲】</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#spanCompetitiveness"><rdfs:domain rdf:resource="#SpanPosition"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/><rdfs:label xml:lang="zh">竞争实力【待考：量纲】</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#spanQuadrant"><rdfs:domain rdf:resource="#SpanPosition"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">SPAN 象限</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#controlPointRationale"><rdfs:domain rdf:resource="#StrategicControlPoint"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">控制点依据</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#sustainability"><rdfs:domain rdf:resource="#StrategicControlPoint"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">可持续性</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#leadingIndicator"><rdfs:domain rdf:resource="#StrategicControlPoint"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">领先指标</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#objectiveExpression"><rdfs:domain rdf:resource="#Objective"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">目标表述</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#smartSpecific"><rdfs:domain rdf:resource="#Objective"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/><rdfs:label xml:lang="zh">SMART-具体性</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#smartMeasurable"><rdfs:domain rdf:resource="#Objective"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/><rdfs:label xml:lang="zh">SMART-可衡量</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#smartAchievable"><rdfs:domain rdf:resource="#Objective"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/><rdfs:label xml:lang="zh">SMART-可实现</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#smartRelevant"><rdfs:domain rdf:resource="#Objective"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/><rdfs:label xml:lang="zh">SMART-相关性</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#smartTimeBound"><rdfs:domain rdf:resource="#Objective"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/><rdfs:label xml:lang="zh">SMART-时限性</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#metric"><rdfs:domain rdf:resource="#Objective"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">量化指标</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#timeLimit"><rdfs:domain rdf:resource="#Objective"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">时限</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#bscDimension"><rdfs:domain rdf:resource="#Objective"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">BSC 维度</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#strategyAction"><rdfs:domain rdf:resource="#Strategy"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">关键举措</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#resourceInput"><rdfs:domain rdf:resource="#Strategy"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">资源投入</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#resourceFit"><rdfs:domain rdf:resource="#Strategy"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">资源匹配度</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#pathPhase"><rdfs:domain rdf:resource="#Strategy"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">路径节奏（速赢/攻坚/布局）</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#riskResponse"><rdfs:domain rdf:resource="#Strategy"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">风险应对</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#milestone"><rdfs:domain rdf:resource="#Strategy"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">关键里程碑</rdfs:label></owl:DatatypeProperty>
