INSERT INTO `tiaohou_clause` (clause_id, day_stem, month_branch, month_order, primary_use, secondary_use, clause_text, source_note) VALUES
('THC_甲_寅', '甲', '寅', 1, '丙', '癸', '正月甲木，初春尚有余寒，得丙癸透，富贵双全，癸藏丙透，名寒木向阳，以丙为重。', '穷通宝鉴（造化元钥）·正月甲'),
('THC_甲_卯', '甲', '卯', 2, '丙', '癸', '二月甲木，与正月雨水后用法略同，仍以丙癸为用，所不同者即煞刃一格耳。', '穷通宝鉴（造化元钥）·二月甲'),
('THC_甲_辰', '甲', '辰', 3, '庚', '壬', '三月木气将竭，先取庚，次取壬；或支成金局，方可用丁，不然三月无用丁之法。', '穷通宝鉴（造化元钥）·三月甲'),
('THC_甲_巳', '甲', '巳', 4, '癸', '丁', '四月木气已退，丙火司权，先癸次丁，又须有庚透（癸丁与庚齐透为科甲）。', '穷通宝鉴（造化元钥）·四月甲'),
('THC_甲_午', '甲', '午', 5, '癸', '丁', '五六月甲木，木性虚焦，一理共推，五月先癸后丁，庚金次之。', '穷通宝鉴（造化元钥）·五月甲'),
('THC_甲_未', '甲', '未', 6, '丁', '庚', '六月三伏生寒，丁火退气，先丁后庚，无癸亦可，或五月乏癸用丁亦可。', '穷通宝鉴（造化元钥）·六月甲'),
('THC_甲_申', '甲', '申', 7, '丁', '庚', '七月甲堪为戟，非丁不能造庚，非庚不能造甲，丁庚两透，科甲可许。', '穷通宝鉴（造化元钥）·七月甲'),
('THC_甲_酉', '甲', '酉', 8, '丁', '丙', '八月甲木，木衰金旺，丁火为先，次用丙火，庚金再次。', '穷通宝鉴（造化元钥）·八月甲'),
('THC_甲_戌', '甲', '戌', 9, '丁', '壬', '九月甲木，木性凋零，丁火壬癸滋扶；不论用戊用庚，四柱宜有丁火壬癸为配合。', '穷通宝鉴（造化元钥）·九月甲'),
('THC_甲_亥', '甲', '亥', 10, '庚', '丁', '十月甲木，以庚为君，以丁为佐，丙火次之，忌壬水泛木，须戊土为制，故戊又次之。', '穷通宝鉴（造化元钥）·十月甲'),
('THC_甲_子', '甲', '子', 11, '丁', '庚', '十一月甲木，本性生寒，先丁后庚，取丙佐之，寒木向阳。', '穷通宝鉴（造化元钥）·十一月甲'),
('THC_甲_丑', '甲', '丑', 12, '庚', '丁', '十二月甲木，天气寒冻，先用庚劈甲以引丁火，木火始有通明之象，故丁次之。', '穷通宝鉴（造化元钥）·十二月甲'),
('THC_乙_寅', '乙', '寅', 1, '丙', '癸', '正月乙木，天气犹有余寒，非丙不长，虽有癸润恐凝寒气，故先用丙，癸次之。', '穷通宝鉴（造化元钥）·正月乙'),
('THC_乙_卯', '乙', '卯', 2, '丙', '癸', '二月乙木，阳气渐升，木不寒矣，以丙为君，癸为臣，丙癸两透，科甲富贵无疑。', '穷通宝鉴（造化元钥）·二月乙'),
('THC_乙_辰', '乙', '辰', 3, '癸', '丙', '三月乙木，阳气愈炽，先癸次丙；阳盛宜癸水滋之，木盛宜丙火泄之。', '穷通宝鉴（造化元钥）·三月乙'),
('THC_乙_巳', '乙', '巳', 4, '癸', '庚', '四月乙木，巳宫自有丙火，故取癸水为尊，以庚辛为佐（辛透为清）。', '穷通宝鉴（造化元钥）·四月乙'),
('THC_乙_午', '乙', '午', 5, '癸', '丙', '五月乙木，丁火司权，上半月先癸次丙，下半月三伏生寒，丙癸俱尊。', '穷通宝鉴（造化元钥）·五月乙'),
('THC_乙_未', '乙', '未', 6, '丙', '癸', '六月乙木，性枯而寒，柱多金水，丙火为尊，丙癸两透，大富大贵。', '穷通宝鉴（造化元钥）·六月乙'),
('THC_乙_申', '乙', '申', 7, '己', '丙', '七月乙木，庚金司令，喜己土为用，丙癸出干，又加三己污金，可许科甲。', '穷通宝鉴（造化元钥）·七月乙'),
('THC_乙_酉', '乙', '酉', 8, '癸', '丙', '八月乙木，白露后专用癸水以滋桂，秋分后宜先用丙，癸水次之。', '穷通宝鉴（造化元钥）·八月乙'),
('THC_乙_戌', '乙', '戌', 9, '癸', '辛', '九月乙木，枝枯叶落，必赖癸水滋养，故必以癸水为先。', '穷通宝鉴（造化元钥）·九月乙'),
('THC_乙_亥', '乙', '亥', 10, '丙', '戊', '十月乙木，壬水司令，丙为尊，壬多用戊土；丙戊两透定许科甲。', '穷通宝鉴（造化元钥）·十月乙'),
('THC_乙_子', '乙', '子', 11, '丙', '戊', '十一月乙木，根叶寒冻，喜丙复一阳，用丙火解冻，故专用丙火，戊去癸水之病。', '穷通宝鉴（造化元钥）·十一月乙'),
('THC_乙_丑', '乙', '丑', 12, '丙', '', '十二月乙木，寒木见丙有回春之意，除丙火外别无用神可取，与十一月同。', '穷通宝鉴（造化元钥）·十二月乙'),
('THC_丙_寅', '丙', '寅', 1, '壬', '庚', '正月丙火，三阳开泰，火气渐炎，取壬为尊，庚金为佐，名水辅阳光。', '穷通宝鉴（造化元钥）·正月丙'),
('THC_丙_卯', '丙', '卯', 2, '壬', '庚', '二月丙火，阳气舒升，专用壬水；寅卯为壬水病死之地，用壬须藉金生助。', '穷通宝鉴（造化元钥）·二月丙'),
('THC_丙_辰', '丙', '辰', 3, '壬', '甲', '三月丙火，火气渐炎，专用壬水；支成土局，取甲为辅，壬不可离。', '穷通宝鉴（造化元钥）·三月丙'),
('THC_丙_巳', '丙', '巳', 4, '壬', '庚', '四月丙火，建禄于巳，专用壬水；然必有庚，方为有源之水，壬庚两透为上。', '穷通宝鉴（造化元钥）·四月丙'),
('THC_丙_午', '丙', '午', 5, '壬', '庚', '五月丙火，火气愈炎，得二壬一庚出干方为上格，或一壬无庚亦须好运。', '穷通宝鉴（造化元钥）·五月丙'),
('THC_丙_未', '丙', '未', 6, '壬', '庚', '六月丙火，火气渐退，三伏生寒，己土泄气，取庚佐壬用。', '穷通宝鉴（造化元钥）·六月丙'),
('THC_丙_申', '丙', '申', 7, '壬', '', '七月丙火，太阳转西，阳气渐衰，故专用壬水，辅映太阳光辉。', '穷通宝鉴（造化元钥）·七月丙'),
('THC_丙_酉', '丙', '酉', 8, '壬', '', '八月丙火，日近黄昏，仍用壬水辅映，以印比配合，丙气衰故也。', '穷通宝鉴（造化元钥）·八月丙'),
('THC_丙_戌', '丙', '戌', 9, '甲', '壬', '九月丙火愈衰，忌土晦光，先用甲木，次取壬水，甲壬两透，科甲有准。', '穷通宝鉴（造化元钥）·九月丙'),
('THC_丙_亥', '丙', '亥', 10, '甲', '庚', '十月丙火，太阳失令，见甲戊庚齐透科甲有准；以甲木为主要关键，庚戊壬随时损益。', '穷通宝鉴（造化元钥）·十月丙'),
('THC_丙_子', '丙', '子', 11, '壬', '戊', '十一月丙火，冬至阳生，弱中生旺，先壬，戊佐之；用壬不可少甲。', '穷通宝鉴（造化元钥）·十一月丙'),
('THC_丙_丑', '丙', '丑', 12, '壬', '甲', '十二月丙火，气进二阳，应先壬为用；己土司令，己多须用甲为佐。', '穷通宝鉴（造化元钥）·十二月丙'),
('THC_丁_寅', '丁', '寅', 1, '庚', '壬', '正月丁火，甲木当权，乃为母旺，非庚不能劈甲何以引丁，先庚次壬。', '穷通宝鉴（造化元钥）·正月丁'),
('THC_丁_卯', '丁', '卯', 2, '庚', '甲', '二月丁火，木旺火塞，必须用财破印；非庚不能扫乙，非甲不能引丁，先庚后甲。', '穷通宝鉴（造化元钥）·二月丁'),
('THC_丁_辰', '丁', '辰', 3, '甲', '庚', '三月丁火，戊土司令，泄弱丁气，先用甲木引丁制戊，次看庚金。', '穷通宝鉴（造化元钥）·三月丁'),
('THC_丁_巳', '丁', '巳', 4, '甲', '庚', '四月丁火，火气乘旺，取甲引丁，必须庚金制甲，有庚有甲方云木火通明。', '穷通宝鉴（造化元钥）·四月丁'),
('THC_丁_午', '丁', '午', 5, '壬', '癸', '五月丁火，以用壬癸为正轨，壬癸太旺用甲木乃例外；时逢建禄不得轻用甲木。', '穷通宝鉴（造化元钥）·五月丁'),
('THC_丁_未', '丁', '未', 6, '甲', '壬', '六月丁火，阴柔日弱，又值三伏生寒，专用甲木，壬水次之。', '穷通宝鉴（造化元钥）·六月丁'),
('THC_丁_申', '丁', '申', 7, '甲', '庚', '三秋丁火，阴柔退气，专用甲木，仍取庚劈甲，又借丙暖金晒甲。', '穷通宝鉴（造化元钥）·七月丁'),
('THC_丁_酉', '丁', '酉', 8, '甲', '庚', '八月丁火，专用甲木，仍取庚劈甲；无甲用乙，富贵皆小。', '穷通宝鉴（造化元钥）·八月丁'),
('THC_丁_戌', '丁', '戌', 9, '甲', '庚', '九月丁火，专用甲庚；甲不离庚，乙不离丙，九月戊土当旺必须用甲制之。', '穷通宝鉴（造化元钥）·九月丁'),
('THC_丁_亥', '丁', '亥', 10, '甲', '庚', '三冬丁火微寒，专用甲庚；用甲木、庚不可少，无庚不能劈甲，无甲何以引丁。', '穷通宝鉴（造化元钥）·十月丁'),
('THC_丁_子', '丁', '子', 11, '甲', '庚', '十一月丁火，专用甲木，庚金为佐；冬丁有甲，虽水多金多可称上格。', '穷通宝鉴（造化元钥）·十一月丁'),
('THC_丁_丑', '丁', '丑', 12, '甲', '庚', '十二月丁火，三冬专用甲庚，以庚劈甲引丁为正用。', '穷通宝鉴（造化元钥）·十二月丁'),
('THC_戊_寅', '戊', '寅', 1, '丙', '甲', '三春戊土，正二月先丙后甲，癸次之；无丙照暖戊土不生，无甲疏劈戊土不灵。', '穷通宝鉴（造化元钥）·正月戊'),
('THC_戊_卯', '戊', '卯', 2, '丙', '甲', '二月戊土，先丙后甲，癸次之；丙甲癸三者齐透，富贵极品。', '穷通宝鉴（造化元钥）·二月戊'),
('THC_戊_辰', '戊', '辰', 3, '甲', '丙', '三月戊土，先甲后丙，癸亦次之；因戊土司令，故先用甲木。', '穷通宝鉴（造化元钥）·三月戊'),
('THC_戊_巳', '戊', '巳', 4, '甲', '丙', '四月戊土，阳气外发，先取甲木疏劈，次取丙癸佐之。', '穷通宝鉴（造化元钥）·四月戊'),
('THC_戊_午', '戊', '午', 5, '壬', '甲', '五月戊土，火炎土燥，先看壬水，次取甲木，丙火酌用；用癸恐其力微。', '穷通宝鉴（造化元钥）·五月戊'),
('THC_戊_未', '戊', '未', 6, '癸', '丙', '六月戊土，遇夏干枯，先看癸水，次用丙火甲木；大暑后金水进气宜丙。', '穷通宝鉴（造化元钥）·六月戊'),
('THC_戊_申', '戊', '申', 7, '丙', '癸', '七月戊土，阳气渐入，寒气渐出，先丙后癸，甲木次之。', '穷通宝鉴（造化元钥）·七月戊'),
('THC_戊_酉', '戊', '酉', 8, '丙', '癸', '八月戊土，金泄身寒，赖丙照暖，喜水滋润，先丙后癸，不必木疏。', '穷通宝鉴（造化元钥）·八月戊'),
('THC_戊_戌', '戊', '戌', 9, '甲', '癸', '九月戊土当权，先看甲木，次取癸水，再取丙火配合支干，方成有生之土。', '穷通宝鉴（造化元钥）·九月戊'),
('THC_戊_亥', '戊', '亥', 10, '甲', '丙', '十月戊土，时值小阳，先用甲木，次取丙火；非甲土不灵，非丙土不暖。', '穷通宝鉴（造化元钥）·十月戊'),
('THC_戊_子', '戊', '子', 11, '丙', '甲', '十一、二月戊土，严寒冰冻，丙火为尊，甲木为佐；决不可缺丙。', '穷通宝鉴（造化元钥）·十一月戊'),
('THC_戊_丑', '戊', '丑', 12, '丙', '甲', '十二月戊土，严寒冰冻，丙火为尊，甲木为佐；丙甲两透，秋闱可望。', '穷通宝鉴（造化元钥）·十二月戊'),
('THC_己_寅', '己', '寅', 1, '丙', '甲', '正月己土，寒气未退，田园犹冻，丙暖为尊；得丙照暖万物自生，忌见壬水，须戊作堤。', '穷通宝鉴（造化元钥）·正月己'),
('THC_己_卯', '己', '卯', 2, '甲', '癸', '二月己土，阳气渐升，宜先取甲木疏之，次取癸水润之，得丙印配合福泽愈厚。', '穷通宝鉴（造化元钥）·二月己'),
('THC_己_辰', '己', '辰', 3, '丙', '癸', '三月己土，正栽培之时，先丙后癸，令土暖而润，复用甲疏之。', '穷通宝鉴（造化元钥）·三月己'),
('THC_己_巳', '己', '巳', 4, '癸', '丙', '三夏己土，时值和稼在田，急须甘露为润，取癸为要，次用丙火。', '穷通宝鉴（造化元钥）·四月己'),
('THC_己_午', '己', '午', 5, '癸', '丙', '五月己土，夏炎取癸为要，次用丙火；无癸曰旱田，无丙曰孤阴。', '穷通宝鉴（造化元钥）·五月己'),
('THC_己_未', '己', '未', 6, '癸', '丙', '六月己土，取癸为要，次用丙火；调和气候癸水为先。', '穷通宝鉴（造化元钥）·六月己'),
('THC_己_申', '己', '申', 7, '丙', '癸', '三秋己土，万物收藏之际，须丙火温之，癸水润之；丙能制金，癸能泄金，补土精神。', '穷通宝鉴（造化元钥）·七月己'),
('THC_己_酉', '己', '酉', 8, '丙', '癸', '八月己土，金神秉令，子旺母衰，须丙火温之、癸水润之。', '穷通宝鉴（造化元钥）·八月己'),
('THC_己_戌', '己', '戌', 9, '甲', '丙', '九月己土，土燥，喜甲疏季土，次丙癸配合，土暖而润方为有用。', '穷通宝鉴（造化元钥）·九月己'),
('THC_己_亥', '己', '亥', 10, '丙', '甲', '三冬己土，湿泥寒冻，非丙暖不生，取丙为尊，甲木能参用，不可用癸。', '穷通宝鉴（造化元钥）·十月己'),
('THC_己_子', '己', '子', 11, '丙', '甲', '十一月己土，湿泥寒冻，取丙为尊，甲木能参用，不可用癸。', '穷通宝鉴（造化元钥）·十一月己'),
('THC_己_丑', '己', '丑', 12, '丙', '甲', '十二月己土，湿泥寒冻，取丙为尊，甲木能参用，无丙用丁（丁不能解冻，丁多衣禄安然）。', '穷通宝鉴（造化元钥）·十二月己'),
('THC_庚_寅', '庚', '寅', 1, '丙', '甲', '正月庚金，木气渐旺，金之寒气未除，先用丙以暖庚性，次甲疏厚土，令土势不能埋金。', '穷通宝鉴（造化元钥）·正月庚'),
('THC_庚_卯', '庚', '卯', 2, '丁', '甲', '二月庚金，卯中乙木当权，柱中自然有乙又有丁火，先丁后甲。', '穷通宝鉴（造化元钥）·二月庚'),
('THC_庚_辰', '庚', '辰', 3, '甲', '丁', '三月庚金，戊土司令，先用甲疏土，次用丁火煅炼成器。', '穷通宝鉴（造化元钥）·三月庚'),
('THC_庚_巳', '庚', '巳', 4, '壬', '戊', '四月庚金，长生在巳，宜先用壬水方得中和，次取戊土，丙火佐之。', '穷通宝鉴（造化元钥）·四月庚'),
('THC_庚_午', '庚', '午', 5, '壬', '癸', '五月庚金，丁旺而烈，庚逢败地，专用壬水，癸又次之。', '穷通宝鉴（造化元钥）·五月庚'),
('THC_庚_未', '庚', '未', 6, '丁', '甲', '六月庚金，三伏生寒，金顽已极，先丁火，次取甲木。', '穷通宝鉴（造化元钥）·六月庚'),
('THC_庚_申', '庚', '申', 7, '丁', '甲', '七月庚金司令，刚锐已极，专用丁火煅炼，次取甲引丁光。', '穷通宝鉴（造化元钥）·七月庚'),
('THC_庚_酉', '庚', '酉', 8, '丁', '甲', '八月庚金，刚锐未退，仍用丁甲，以丙佐之，丙火不可少也。', '穷通宝鉴（造化元钥）·八月庚'),
('THC_庚_戌', '庚', '戌', 9, '甲', '壬', '九月庚金，戊土司令，大惧土厚埋金，先用甲疏，次用壬洗，金自出矣。', '穷通宝鉴（造化元钥）·九月庚'),
('THC_庚_亥', '庚', '亥', 10, '丁', '丙', '十月庚金，水冷金寒，非丁不能造，非丙不能暖；用丁不离甲木。', '穷通宝鉴（造化元钥）·十月庚'),
('THC_庚_子', '庚', '子', 11, '丙', '丁', '十一月庚金，天气严寒，仍先取丙照，专取丙丁为用，甲木为佐。', '穷通宝鉴（造化元钥）·十一月庚'),
('THC_庚_丑', '庚', '丑', 12, '丙', '丁', '十二月庚金，寒气太重，先用丙火解冻，次取丁火煅金，甲木亦不可少。', '穷通宝鉴（造化元钥）·十二月庚'),
('THC_辛_寅', '辛', '寅', 1, '己', '壬', '正月辛金，寅宫自有丙火，无须另取调候；先取己土为生身之本，次用壬水淘洗。', '穷通宝鉴（造化元钥）·正月辛'),
('THC_辛_卯', '辛', '卯', 2, '壬', '甲', '二月辛金，阳气发于外，壬水为尊；有甲木制己，辛金不致埋没，壬水不致混浊。', '穷通宝鉴（造化元钥）·二月辛'),
('THC_辛_辰', '辛', '辰', 3, '壬', '甲', '三月辛金，与二月同，壬水为尊，月垣正印秉令，湿土相生。', '穷通宝鉴（造化元钥）·三月辛'),
('THC_辛_巳', '辛', '巳', 4, '壬', '甲', '四月辛金，壬水为尊，先取壬水淘洗，次用甲木（癸亦可佐）。', '穷通宝鉴（造化元钥）·四月辛'),
('THC_辛_午', '辛', '午', 5, '己', '壬', '五月辛金，丁火司权，阴柔之极不宜煅炼，须己壬兼用；己无壬不湿，辛无己不生。', '穷通宝鉴（造化元钥）·五月辛'),
('THC_辛_未', '辛', '未', 6, '壬', '庚', '六月辛金，己土当权，专用壬水为妙，次取庚金佐之。', '穷通宝鉴（造化元钥）·六月辛'),
('THC_辛_申', '辛', '申', 7, '壬', '甲', '七月辛金，值庚秉令，不旺自旺，专用壬水；切勿作癸为用。', '穷通宝鉴（造化元钥）·七月辛'),
('THC_辛_酉', '辛', '酉', 8, '壬', '甲', '八月辛金，当权得令，旺之极矣，专用壬水淘之泄之为贵，金见水以流通。', '穷通宝鉴（造化元钥）·八月辛'),
('THC_辛_戌', '辛', '戌', 9, '壬', '甲', '九月辛金，喜甲疏季土，壬泄旺金，先壬次甲。', '穷通宝鉴（造化元钥）·九月辛'),
('THC_辛_亥', '辛', '亥', 10, '壬', '丙', '十月辛金，先用壬水，次用丙火暖壬温辛；金水伤官正指冬令。', '穷通宝鉴（造化元钥）·十月辛'),
('THC_辛_子', '辛', '子', 11, '丙', '壬', '十一月辛金，最忌癸水出干冻金困丙，辛金不离壬丙为用，尤以丙火调候为先。', '穷通宝鉴（造化元钥）·十一月辛'),
('THC_辛_丑', '辛', '丑', 12, '丙', '壬', '十二月辛金，气寒水冻，先丙次壬；非丙不能解冻，解冻水不成冰方可用壬淘洗。', '穷通宝鉴（造化元钥）·十二月辛'),
('THC_壬_寅', '壬', '寅', 1, '庚', '丙', '正月壬水，先用庚金发水之源，次取丙火以除寒气，又次取戊土以止其流。', '穷通宝鉴（造化元钥）·正月壬'),
('THC_壬_卯', '壬', '卯', 2, '戊', '辛', '二月壬水，寒气悉除，清流湛深，不可用火，专取戊土为堤岸，辛发其源。', '穷通宝鉴（造化元钥）·二月壬'),
('THC_壬_辰', '壬', '辰', 3, '甲', '庚', '三月壬水，戊土司权，恐有塞河壅海之患，先用甲疏季土，次取庚发水源。', '穷通宝鉴（造化元钥）·三月壬'),
('THC_壬_巳', '壬', '巳', 4, '壬', '辛', '四月壬水，丙火司权，专取壬水，次取辛金发水源，又以庚金为佐。', '穷通宝鉴（造化元钥）·四月壬'),
('THC_壬_午', '壬', '午', 5, '癸', '庚', '五月壬水，丁旺壬弱，取庚为君，癸为臣；无庚不能蓄源，无癸不能伤丁。', '穷通宝鉴（造化元钥）·五月壬'),
('THC_壬_未', '壬', '未', 6, '辛', '甲', '六月壬水，己土当权，壬水怯弱，先用辛金蓄源，次用甲木制己。', '穷通宝鉴（造化元钥）·六月壬'),
('THC_壬_申', '壬', '申', 7, '戊', '丁', '七月壬水，倚母当令，变弱为强，专用戊土，次取丁制庚佐之。', '穷通宝鉴（造化元钥）·七月壬'),
('THC_壬_酉', '壬', '酉', 8, '甲', '', '八月壬水，辛金司权，金白水清之时，忌戊己为病，专取甲木。', '穷通宝鉴（造化元钥）·八月壬'),
('THC_壬_戌', '壬', '戌', 9, '甲', '丙', '九月壬水，其势将旺，得一甲以破戊戌，又见一戊出干，斯用丙火。', '穷通宝鉴（造化元钥）·九月壬'),
('THC_壬_亥', '壬', '亥', 10, '戊', '丙', '十月壬水，亥水当令，用戊为尊，丙火为佐。', '穷通宝鉴（造化元钥）·十月壬'),
('THC_壬_子', '壬', '子', 11, '戊', '丙', '十一月壬水，阳刃帮身，较前更旺，先取戊土，次用丙火。', '穷通宝鉴（造化元钥）·十一月壬'),
('THC_壬_丑', '壬', '丑', 12, '丙', '甲', '十二月壬水，旺极复衰，上半月专用丙火解冻，下半月丙火为先，徐用甲木为佐。', '穷通宝鉴（造化元钥）·十二月壬'),
('THC_癸_寅', '癸', '寅', 1, '辛', '丙', '正月癸水，值三阳之候，专取辛金发源，次取丙火照暖，名阴阳和合。', '穷通宝鉴（造化元钥）·正月癸'),
('THC_癸_卯', '癸', '卯', 2, '庚', '辛', '二月癸水，乙木司令，泄弱无神，专用庚金为妙，辛金佐之。', '穷通宝鉴（造化元钥）·二月癸'),
('THC_癸_辰', '癸', '辰', 3, '丙', '辛', '三月癸水，清明后专用丙火，谷雨后虽用丙火，还宜辛金佐之。', '穷通宝鉴（造化元钥）·三月癸'),
('THC_癸_巳', '癸', '巳', 4, '辛', '庚', '四月癸水，喜见辛母，无辛庚亦可用；四月火土两旺，癸水临绝地，非印劫生助不足自存。', '穷通宝鉴（造化元钥）·四月癸'),
('THC_癸_午', '癸', '午', 5, '庚', '辛', '五月癸水，至弱无根，喜庚辛为生身之本，须用比肩劫财方得庚辛妙用。', '穷通宝鉴（造化元钥）·五月癸'),
('THC_癸_未', '癸', '未', 6, '庚', '辛', '六月癸水，专用庚辛为主；上半月金畏火炎须比劫助金。', '穷通宝鉴（造化元钥）·六月癸'),
('THC_癸_申', '癸', '申', 7, '丁', '甲', '七月癸水，正母旺子相之时，必取丁火为用以制多金，用丁不能无甲为佐。', '穷通宝鉴（造化元钥）·七月癸'),
('THC_癸_酉', '癸', '酉', 8, '辛', '丙', '八月癸水，正金白水清之时，取辛为用，丙火佐之，名水暖金温。', '穷通宝鉴（造化元钥）·八月癸'),
('THC_癸_戌', '癸', '戌', 9, '辛', '甲', '九月癸水，戊土司权，专用辛金发水源，次用癸甲；有辛水乃得母，有癸木乃有根。', '穷通宝鉴（造化元钥）·九月癸'),
('THC_癸_亥', '癸', '亥', 10, '庚', '辛', '十月癸水，亥水当令，取庚辛为用，佐以戊丁。', '穷通宝鉴（造化元钥）·十月癸'),
('THC_癸_子', '癸', '子', 11, '丙', '辛', '十一月癸水，严寒冰冻，专用丙火解冻，方用辛金滋扶；无丙火辛亦不妙。', '穷通宝鉴（造化元钥）·十一月癸'),
('THC_癸_丑', '癸', '丑', 12, '丙', '丁', '十二月癸水，落地成冰，专用丙火解冻；无丙火调候，无论何物不能用也。', '穷通宝鉴（造化元钥）·十二月癸');

