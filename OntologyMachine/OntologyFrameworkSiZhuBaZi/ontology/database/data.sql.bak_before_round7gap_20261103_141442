INSERT INTO `day_hour_clause` (clause_id, day_pillar, hour_pillar, day_stem, day_branch, hour_branch, clause_text, source_note) VALUES
('DHC_甲子_甲子', '甲子', '甲子', '甲', '子', '子', '甲子日甲子时，子遥巳格，年月无庚辛申酉，丑绊午冲，离祖自立，贵。若年月俱寅，逢申酉运，大富后退财。子亥卯未年月，行西运，贵。甲辰月亦贵。酉月，只以正官格论，大贵。巳午戌月，平常。午月，甲死子冲，尤不吉。乙卯、乙巳月，主法死。以上具以日时为主，而以人命年月附之，其官御不同者，此前代命也。下同。', '三命通会卷八·六甲日子时断'),
('DHC_甲子_乙丑', '甲子', '乙丑', '甲', '子', '丑', '甲子日乙丑时，连珠得合妻贤子贵。春月身旺，财帛破散。夏月甲衰，金神有制，贵。秋生，近侍之贵。丑月最吉，亥、子多凶。', '三命通会卷八·六甲日丑时断'),
('DHC_甲子_丙寅', '甲子', '丙寅', '甲', '子', '寅', '甲子日丙寅时，日禄居时，青云得路，年月无庚辛金，贵；通木火气极贵。午月行东北方运，五六品贵。申月，归禄逢煞，主大权贵；水局平常。若年月与日时同，大贵。', '三命通会卷八·六甲日寅时断'),
('DHC_甲子_丁卯', '甲子', '丁卯', '甲', '子', '卯', '甲子日丁卯时，克剥悭吝，作事进退，不免刑伤妻子，或死他乡。生辰戌丑未月，贵。卯月凶，柱有官煞制亦吉。', '三命通会卷八·六甲日卯时断'),
('DHC_甲子_戊辰', '甲子', '戊辰', '甲', '子', '辰', '甲子日戊辰时，主移根换叶，改姓易宗，妻贤子孝，作高命论。未月，行北方运，贵。酉月，北方运，大贵。', '三命通会卷八·六甲日辰时断'),
('DHC_甲子_己巳', '甲子', '己巳', '甲', '子', '巳', '甲子日己巳时，先贫后富，祖业轻微，妻勤子拗。生寅未巳丑年月，虽贵防疾。申子辰戌，大贵。', '三命通会卷八·六甲日巳时断'),
('DHC_甲子_庚午', '甲子', '庚午', '甲', '子', '午', '甲子日庚午时，时日相冲，忧伤妻子，平常。若子午年月及寅戌月生，行西北方运，金紫风宪。', '三命通会卷八·六甲日午时断'),
('DHC_甲子_辛未', '甲子', '辛未', '甲', '子', '未', '甲子日辛未时，辰戌丑未及己酉月，土金地方，文贵显达。', '三命通会卷八·六甲日未时断'),
('DHC_甲子_壬申', '甲子', '壬申', '甲', '子', '申', '甲子日壬申时，申子辰亥月，水泛木漂，移根换叶，玉堂金马之贵。水土运，凶。', '三命通会卷八·六甲日申时断'),
('DHC_甲子_癸酉', '甲子', '癸酉', '甲', '子', '酉', '甲子日癸酉时，春生木旺；酉月官纯，贵。若混之以煞，或煞多，柱中全无火气，凶。', '三命通会卷八·六甲日酉时断'),
('DHC_甲子_甲戌', '甲子', '甲戌', '甲', '子', '戌', '甲子日甲戌时，春寿，夏暴，秋贵，冬，移根换叶，柱见纯亥夹角，虽贵终凶。辰戌丑未，杂气财官，亦吉。', '三命通会卷八·六甲日戌时断'),
('DHC_甲子_乙亥', '甲子', '乙亥', '甲', '子', '亥', '甲子日乙亥时，成趋乾格，贵。如生申月，煞旺合刃，权贵。酉月正官，柱稍得土助，大贵。辰巳丑未戌月俱吉。年月纯卯，刃旺则凶。', '三命通会卷八·六甲日亥时断'),
('DHC_乙丑_丙子', '乙丑', '丙子', '乙', '丑', '子', '乙丑日丙子时，身弱平常，无午穿冲，贤德温厚。申酉年月，风宪。寅子，贵显。忌丙寅、己未、甲戌、己丑等月，主凶刑恶死。', '三命通会卷八·六乙日子时断'),
('DHC_乙丑_丁丑', '乙丑', '丁丑', '乙', '丑', '丑', '乙丑日丁丑时，秋生有权；主带疾；夏吉，冬平；春旺，贵寿。', '三命通会卷八·六乙日丑时断'),
('DHC_乙丑_戊寅', '乙丑', '戊寅', '乙', '丑', '寅', '乙丑日戊寅时高，生子年戌月者，富贵。辰戌，行木火运，威权。', '三命通会卷八·六乙日寅时断'),
('DHC_乙丑_己卯', '乙丑', '己卯', '乙', '丑', '卯', '乙丑日己卯时高，中年大福。春生，身太旺，孤。夏贫。秋有疾。冬温厚。柱不见辛金，吉。若辰戌丑未月，金紫贵。', '三命通会卷八·六乙日卯时断'),
('DHC_乙丑_庚辰', '乙丑', '庚辰', '乙', '丑', '辰', '乙丑日庚辰时，破祖克父，身弱忌疾，通月气者，贵。子申年月，天干透甲戊，合三奇，大贵。', '三命通会卷八·六乙日辰时断'),
('DHC_乙丑_辛巳', '乙丑', '辛巳', '乙', '丑', '巳', '乙丑日辛巳时，先杂后纯，生寅午丙丁年月，偏官有制，作高命看。巳申酉丑月，官煞重叠，多带疾从煞，亦吉。惟身强主兵权，有名誉。', '三命通会卷八·六乙日巳时断'),
('DHC_乙丑_壬午', '乙丑', '壬午', '乙', '丑', '午', '乙丑日壬午时，春夏多富贵。秋冬官印，或纯煞透干，尤吉。', '三命通会卷八·六乙日午时断'),
('DHC_乙丑_癸未', '乙丑', '癸未', '乙', '丑', '未', '乙丑日癸未时，凶刑孤独，年月通土气，吉。', '三命通会卷八·六乙日未时断'),
('DHC_乙丑_甲申', '乙丑', '甲申', '乙', '丑', '申', '乙丑日甲申时高，纯子辰年月，行东南运，大贵。巳酉丑，贵；中防凶。午未纯，吉。亥卯亦吉。余月平平。', '三命通会卷八·六乙日申时断'),
('DHC_乙丑_乙酉', '乙丑', '乙酉', '乙', '丑', '酉', '乙丑日乙酉时高，生巳酉丑月，合金局，更行西运，大贵。寅午戌月，贫下。亥卯未月，吉。纯子年月，行南运，一二品贵。寅月火金，七品贵。申月水木，金紫贵。', '三命通会卷八·六乙日酉时断'),
('DHC_乙丑_丙戌', '乙丑', '丙戌', '乙', '丑', '戌', '乙丑日丙戌时，春身旺，吉。夏，伤官太重。秋，劳力辛苦。冬亥子，印绶带伤官，极贵。戌月，木火运，七品贵。纯戌年月，天干透庚丙者，大贵。寅午合火者夭。', '三命通会卷八·六乙日戌时断'),
('DHC_乙丑_丁亥', '乙丑', '丁亥', '乙', '丑', '亥', '乙丑日丁亥时秀，生壬子申未卯月，干透财印者，才德兼全，职在风宪。年月干支纯金，身衰煞旺，主凶死。', '三命通会卷八·六乙日亥时断'),
('DHC_丙寅_戊子', '丙寅', '戊子', '丙', '寅', '子', '丙寅日戊子时，生卯丑月，清贵。寅戌，平常。夏月身旺，柱有水金方吉。子月正官，大贵。忌癸巳月，刑；癸亥月，恶死；己酉月，大败。', '三命通会卷八·六丙日子时断'),
('DHC_丙寅_己丑', '丙寅', '己丑', '丙', '寅', '丑', '丙寅日己丑时，平常，生乙酉月，正财格，有乙庚健旺者贵。巳丑年月，干透官印者贵。', '三命通会卷八·六丙日丑时断'),
('DHC_丙寅_庚寅', '丙寅', '庚寅', '丙', '寅', '寅', '丙寅日庚寅时，贵不久。生酉申年月，世裔冷职。子丑寅未，贵显。纯寅尤吉。', '三命通会卷八·六丙日寅时断'),
('DHC_丙寅_辛卯', '丙寅', '辛卯', '丙', '寅', '卯', '丙寅日辛卯时，无祖自立，有肢体疾。寅卯未子月，贵。余月平，岁运同。', '三命通会卷八·六丙日卯时断'),
('DHC_丙寅_壬辰', '丙寅', '壬辰', '丙', '寅', '辰', '丙寅日壬辰时，身煞两旺，寅卯辰丑未年月，大贵。巳午戌年月亦贵。', '三命通会卷八·六丙日辰时断'),
('DHC_丙寅_癸巳', '丙寅', '癸巳', '丙', '寅', '巳', '丙寅日癸巳时，春月，干支无水，文进绣衣，荣妻荫子。卯戌申酉年月，二三品贵。', '三命通会卷八·六丙日巳时断'),
('DHC_丙寅_甲午', '丙寅', '甲午', '丙', '寅', '午', '丙寅日甲午时，生辰戌丑未月，上伏火气，造化得中贵。午月，火太旺，凶。', '三命通会卷八·六丙日午时断'),
('DHC_丙寅_乙未', '丙寅', '乙未', '丙', '寅', '未', '丙寅日乙未时，生卯未月，印绶格，智慧丰厚，难为妻子。寅巳子辰年月，贵。', '三命通会卷八·六丙日未时断'),
('DHC_丙寅_丙申', '丙寅', '丙申', '丙', '寅', '申', '丙寅日丙申时，时日对冲，忧伤妻子，通火气月，行身旺运，吉，亥月，手艺。', '三命通会卷八·六丙日申时断'),
('DHC_丙寅_丁酉', '丙寅', '丁酉', '丙', '寅', '酉', '丙寅日丁酉时，卯亥未年月，干透官煞者贵。余月有艺，平常。', '三命通会卷八·六丙日酉时断'),
('DHC_丙寅_戊戌', '丙寅', '戊戌', '丙', '寅', '戌', '丙寅日戊戌时，庙堂食神，丙以戊为食神寿星，戌上丙火入库，戊土专位，若通火气月及东南运，福厚有寿；不通，平常。', '三命通会卷八·六丙日戌时断'),
('DHC_丙寅_己亥', '丙寅', '己亥', '丙', '寅', '亥', '丙寅日己亥时，夏生，化鬼为官，妻贤子孝，不贵则富。寅卯辰巳申丑年月，或午戌会局，天干更透丙戌字，主大权贵。', '三命通会卷八·六丙日亥时断'),
('DHC_丁卯_庚子', '丁卯', '庚子', '丁', '卯', '子', '丁卯日庚子时贫，辰戌丑未，偏官有制，午月干强，春身旺，俱吉。秋冬平常。忌癸巳月，破祖凶；己未月，刑伤；甲申月，刺面血光死。', '三命通会卷八·六丁日子时断'),
('DHC_丁卯_辛丑', '丁卯', '辛丑', '丁', '卯', '丑', '丁卯日辛丑时，辰巳未年月，富贵，妻子迟。寅卯印助，戌库身旺，刑。丑丁，得倚托，大贵。', '三命通会卷八·六丁日丑时断'),
('DHC_丁卯_壬寅', '丁卯', '壬寅', '丁', '卯', '寅', '丁卯日壬寅时，贵化吉。寅卯年月，行金水运，大贵。亥子月，行西运，贵。', '三命通会卷八·六丁日寅时断'),
('DHC_丁卯_癸卯', '丁卯', '癸卯', '丁', '卯', '卯', '丁卯日癸卯时，寅卯月生，印绶带煞，不为凶论；行官运，贵显。', '三命通会卷八·六丁日卯时断'),
('DHC_丁卯_甲辰', '丁卯', '甲辰', '丁', '卯', '辰', '丁卯日甲辰时，辰戌丑未月，孤克，运通发财。丑月，南方运，贵。卯月，金水运，近侍权贵，不利建白。', '三命通会卷八·六丁日辰时断'),
('DHC_丁卯_乙巳', '丁卯', '乙巳', '丁', '卯', '巳', '丁卯日乙巳时，春印，夏旺，秋财，冬官，看取用何如？俱可论吉。午未年月，文章贵显，行官禄运，吉。', '三命通会卷八·六丁日巳时断'),
('DHC_丁卯_丙午', '丁卯', '丙午', '丁', '卯', '午', '丁卯日丙午时，旺中有灾，卯字刑破白丁。巳月。西北运，贵；东南，极品有权。寅亥，武职二品。若全子酉，大贵。', '三命通会卷八·六丁日午时断'),
('DHC_丁卯_丁未', '丁卯', '丁未', '丁', '卯', '未', '丁卯日丁未时，刑中发。寅卯月，印绶，发财敦厚。辰戌申午，俱吉。', '三命通会卷八·六丁日未时断'),
('DHC_丁卯_戊申', '丁卯', '戊申', '丁', '卯', '申', '丁卯日戊申时，春，伤官用印；秋，伤官用财，俱吉。夏，比肩；冬，伤官见官，平常。四季月，吉。', '三命通会卷八·六丁日申时断'),
('DHC_丁卯_己酉', '丁卯', '己酉', '丁', '卯', '酉', '丁卯日己酉时，时日并冲，忧伤妻子，通火气吉。忌乙卯字。年月有亥未、巳丑，但一字两合，不以冲论。', '三命通会卷八·六丁日酉时断'),
('DHC_丁卯_庚戌', '丁卯', '庚戌', '丁', '卯', '戌', '丁卯日庚戌时，生亥未年月，三合会印，贵。子月，煞印，吉。年月建禄，僧道，主贵。柱无救助，见癸旺，多患目疾，酉月无贵；纯酉戌年月，天干透己甲者贵，中带凶。', '三命通会卷八·六丁日戌时断'),
('DHC_丁卯_辛亥', '丁卯', '辛亥', '丁', '卯', '亥', '丁卯日辛亥时，时上财官印三奇，再得年月印助财生，皆主大贵。纯子，行木火运，官可六品，巳酉丑月，辛财得局，方有倚旺，富贵双全。', '三命通会卷八·六丁日亥时断'),
('DHC_戊辰_壬子', '戊辰', '壬子', '戊', '辰', '子', '戊辰日壬子时，春，财官旺、贵。夏乖。秋少顺。冬财旺，行西南运，五六品贵。忌庚辰月，自刑凶；辛巳月，截路凶刑；乙丑月，破败凶。', '三命通会卷八·六戊日子时断'),
('DHC_戊辰_癸丑', '戊辰', '癸丑', '戊', '辰', '丑', '戊辰日癸丑时，寅巳午未戌月，化火得地，申子辰财局亦吉。年月干支纯土，得四库全者贵。', '三命通会卷八·六戊日丑时断'),
('DHC_戊辰_甲寅', '戊辰', '甲寅', '戊', '辰', '寅', '戊辰日甲寅时，时上偏官，印绶带煞，柱有庚辛制伏者，贵。辰戌丑未，身旺亦贵。', '三命通会卷八·六戊日寅时断'),
('DHC_戊辰_乙卯', '戊辰', '乙卯', '戊', '辰', '卯', '戊辰日乙卯时，身孤，贵。巳卯年月，身强官旺，荣身显祖，子孝妻贤。', '三命通会卷八·六戊日卯时断'),
('DHC_戊辰_丙辰', '戊辰', '丙辰', '戊', '辰', '辰', '戊辰日丙辰时，克父大发，通身旺月，行东北运富；水木月，行身旺运，贵。', '三命通会卷八·六戊日辰时断'),
('DHC_戊辰_丁巳', '戊辰', '丁巳', '戊', '辰', '巳', '戊辰日丁巳时，巳酉丑月，性格风流，威权重大。年月支干不见财官，青云得路。亥戌，行南运，五六品贵。申，行北运，贵。', '三命通会卷八·六戊日巳时断'),
('DHC_戊辰_戊午', '戊辰', '戊午', '戊', '辰', '午', '戊辰日戊午时，拱禄格，年月无寅巳甲乙字，贵。卯申，武职。酉丑亥，行南运，贵。', '三命通会卷八·六戊日午时断'),
('DHC_戊辰_己未', '戊辰', '己未', '戊', '辰', '未', '戊辰日己未时，春冬，行北运，富贵。', '三命通会卷八·六戊日未时断'),
('DHC_戊辰_庚申', '戊辰', '庚申', '戊', '辰', '申', '戊辰日庚申时，专食合禄，纯寅年月，二寅不怕一申冲，亦贵。', '三命通会卷八·六戊日申时断'),
('DHC_戊辰_辛酉', '戊辰', '辛酉', '戊', '辰', '酉', '戊辰日辛酉时，丑未年月，干透财，主贵。若癸巳月，词馆学堂居提纲，主文学高科，寅申巳亥年，则时犯狼藉煞，晚无结果。', '三命通会卷八·六戊日酉时断'),
('DHC_戊辰_壬戌', '戊辰', '壬戌', '戊', '辰', '戌', '戊辰日壬戌时，时日并冲，忧伤妻子，如土厚地方，大贵。卯月，火金运，中贵。寅申戌丑，行西南运，极贵。', '三命通会卷八·六戊日戌时断'),
('DHC_戊辰_癸亥', '戊辰', '癸亥', '戊', '辰', '亥', '戊辰日癸亥时，秀。亥子月，财官格，不贵则富。寅卯年月，贵显。夏生，教职。', '三命通会卷八·六戊日亥时断'),
('DHC_己巳_甲子', '己巳', '甲子', '己', '巳', '子', '己巳日甲子时，辰戌丑未月，风宪三品，要行水木运，西运无成，南运财官无气，虚名薄利，贵而不显。子寅年月，东南运，贵显；《神白经》说：“化土生福，但不显。”忌壬寅月，受刑。乙未月，刑伤。癸酉月，夭。', '三命通会卷八·六己日子时断'),
('DHC_己巳_乙丑', '己巳', '乙丑', '己', '巳', '丑', '己巳日乙丑时，寅卯月，偏官格。无酉戌字，文进贵命。', '三命通会卷八·六己日丑时断'),
('DHC_己巳_丙寅', '己巳', '丙寅', '己', '巳', '寅', '己巳日丙寅时，先刑后旺。寅月，正官格，文章显贵。亥子水，水运，贵。纯戌，武职三品。年月申亥四生局全，大贵，或不善终。', '三命通会卷八·六己日寅时断'),
('DHC_己巳_丁卯', '己巳', '丁卯', '己', '巳', '卯', '己巳日丁卯时，无冲破，富贵；寅午辰年月，刑伤不利。亥月，木火运，贵。若春生透甲乙者，官煞太旺，有制化，亦贵；否则凶夭。', '三命通会卷八·六己日卯时断'),
('DHC_己巳_戊辰', '己巳', '戊辰', '己', '巳', '辰', '己巳日戊辰时，身孤后发。春官贵；夏平稳；秋凶暴；冬财旺。岁运同。', '三命通会卷八·六己日辰时断'),
('DHC_己巳_己巳', '己巳', '己巳', '己', '巳', '巳', '己巳日己巳时，午年月，权威赫赫，名誉昭昭。春月，子孝妻贤。秋冬平常，贵而不显。辰戌，财印官食；申，伤官生财，俱作吉推。', '三命通会卷八·六己日巳时断'),
('DHC_己巳_庚午', '己巳', '庚午', '己', '巳', '午', '己巳日庚午时，贵。寅午戌月，金神入火乡，作印绶论，贵显，辰戌丑未年月，侯伯。若逢合煞运，必不善终。酉月、东南运，贵。', '三命通会卷八·六己日午时断'),
('DHC_己巳_辛未', '己巳', '辛未', '己', '巳', '未', '己巳日辛未时，金神日。寅午戌月生，贵；亥卯辰午，行金火水木运，大贵。', '三命通会卷八·六己日未时断'),
('DHC_己巳_壬申', '己巳', '壬申', '己', '巳', '申', '己巳日壬申时，大凶，刑。己酉丑月，伤官，行财运，吉。寅午戌月，金神入火乡，运西南，贵。申子辰月，木火运，贵。', '三命通会卷八·六己日申时断'),
('DHC_己巳_癸酉', '己巳', '癸酉', '己', '巳', '酉', '己巳日癸酉时，巳酉丑月，伤官伤尽，居武职、风宪。卯戌月，金神入火乡，贵而能言，伤贵，收心早退，以水土败在酉故也。', '三命通会卷八·六己日酉时断'),
('DHC_己巳_甲戌', '己巳', '甲戌', '己', '巳', '戌', '己巳日甲戌时，寅午戌月，金神入火乡，贵显。亥戌年月，官居守令，极有声名。子月、木火运，极品。', '三命通会卷八·六己日戌时断'),
('DHC_己巳_乙亥', '己巳', '乙亥', '己', '巳', '亥', '己巳日乙亥时，寅午戌月，金神入火乡，贵。巳月、西北运，官至公卿。卯午，风宪。纯子亥年月，以财党煞，作弃看，主大兵权。', '三命通会卷八·六己日亥时断'),
('DHC_庚午_丙子', '庚午', '丙子', '庚', '午', '子', '庚午日丙子时，贵。时日相冲，忧伤妻子，运喜西南，通火木月气，风宪三四品。秋生，丙火无气，难为子息。忌己巳月，破祖，凶。己亥月，被劫盗，凶。癸丑月，孤。', '三命通会卷八·六庚日子时断'),
('DHC_庚午_丁丑', '庚午', '丁丑', '庚', '午', '丑', '庚午日丁丑时，通土月气，贵；不，亦富，有名声。', '三命通会卷八·六庚日丑时断'),
('DHC_庚午_戊寅', '庚午', '戊寅', '庚', '午', '寅', '庚午日戊寅时，寅午戌月，金衰火旺，当带残疾。纯寅，反主极贵。秋，金旺，多贵，但忌时遇亡劫，克身则凶。', '三命通会卷八·六庚日寅时断'),
('DHC_庚午_己卯', '庚午', '己卯', '庚', '午', '卯', '庚午日己卯时，刑破。申子辰己酉丑，俱行东南运，贵。寅午戌亥卯未，须得西北运为佳。', '三命通会卷八·六庚日卯时断'),
('DHC_庚午_庚辰', '庚午', '庚辰', '庚', '午', '辰', '庚午日庚辰时，自刑，金神入火乡。申月，行火木运，官可六品。', '三命通会卷八·六庚日辰时断'),
('DHC_庚午_辛巳', '庚午', '辛巳', '庚', '午', '巳', '庚午日辛巳时，巳午卯年月，进士风宪。巳申酉戌，行土木运，侯伯。', '三命通会卷八·六庚日巳时断'),
('DHC_庚午_壬午', '庚午', '壬午', '庚', '午', '午', '庚午日壬午时，寅午戌月、金柔火旺，畏缩残疾。亥子午月、行木火运，贵。', '三命通会卷八·六庚日午时断'),
('DHC_庚午_癸未', '庚午', '癸未', '庚', '午', '未', '庚午日癸未时，贵。酉申巳亥年月，总领兵戎，官至二品。先虚后实。', '三命通会卷八·六庚日未时断'),
('DHC_庚午_甲申', '庚午', '甲申', '庚', '午', '申', '庚午日甲申时，贵。通身旺月，无丙巳寅午丁，伤破，贵。', '三命通会卷八·六庚日申时断'),
('DHC_庚午_乙酉', '庚午', '乙酉', '庚', '午', '酉', '庚午日乙酉时，刑，中贵。寅午戌亥卯未二局，贵。巳，亦吉。', '三命通会卷八·六庚日酉时断'),
('DHC_庚午_丙戌', '庚午', '丙戌', '庚', '午', '戌', '庚午日丙戌时，申酉亥丑、富，贵三品。巳午未申，透出壬字，艮坎乾方运，卿相有寿。', '三命通会卷八·六庚日戌时断'),
('DHC_庚午_丁亥', '庚午', '丁亥', '庚', '午', '亥', '庚午日丁亥时，贵。辰戌丑未月，土能生金，荣显。申亥酉月，行木火运，极品。', '三命通会卷八·六庚日亥时断'),
('DHC_辛未_戊子', '辛未', '戊子', '辛', '未', '子', '辛未日戊子时，贵。寅巳午酉年月，火木运，贵。亥子，翰苑。辰戌丑未，杂气财官印，俱吉。忌庚申月，尸不全死。壬子月，孤凶。癸丑月，凶刑死。', '三命通会卷八·六辛日子时断'),
('DHC_辛未_己丑', '辛未', '己丑', '辛', '未', '丑', '辛未日己丑时，寅卯未月，财星格。巳午，官显。', '三命通会卷八·六辛日丑时断'),
('DHC_辛未_庚寅', '辛未', '庚寅', '辛', '未', '寅', '辛未日庚寅时，巳未丑月，名标金标，妻贤子孝，晚年风疾。寅卯午戌，俱吉。', '三命通会卷八·六辛日寅时断'),
('DHC_辛未_辛卯', '辛未', '辛卯', '辛', '未', '卯', '辛未日辛卯时，纯未、丁年月，虽大权贵，不善终。寅巳亥，纯吉。', '三命通会卷八·六辛日卯时断'),
('DHC_辛未_壬辰', '辛未', '壬辰', '辛', '未', '辰', '辛未日壬辰时、身孤。春生，财星格，吉。夏，劳碌。秋，贵。冬，伤官伤尽，为奇。', '三命通会卷八·六辛日辰时断'),
('DHC_辛未_癸巳', '辛未', '癸巳', '辛', '未', '巳', '辛未日癸巳时，寅午戌月，高命。巳酉丑，身旺平稳。申子辰，白丁。亥卯未，清贵。', '三命通会卷八·六辛日巳时断'),
('DHC_辛未_甲午', '辛未', '甲午', '辛', '未', '午', '辛未日甲午时，申子辰，偏官有制，吉。丑戌，方面。未月。贵。', '三命通会卷八·六辛日午时断'),
('DHC_辛未_乙未', '辛未', '乙未', '辛', '未', '未', '辛未日乙未时，寅卯未年月，财旺生官，名高禄重。通火气，行西运；通金气，行南，俱吉。', '三命通会卷八·六辛日未时断'),
('DHC_辛未_丙申', '辛未', '丙申', '辛', '未', '申', '辛未日丙申时，因贵人门下得富。春，清贵。夏，平常。秋，富。冬，大贵寿促。《神白经》云：金水乖合，又化水，主贵。', '三命通会卷八·六辛日申时断'),
('DHC_辛未_丁酉', '辛未', '丁酉', '辛', '未', '酉', '辛未日丁酉时，不贵则富。月通金气，无丙丁字，行南运，贵。', '三命通会卷八·六辛日酉时断'),
('DHC_辛未_戊戌', '辛未', '戊戌', '辛', '未', '戌', '辛未日戊戌时，凶恶狠暴，忧伤妻子。寅巳午戌丑月，贵。申子辰亥，金水氵亟秀，尤贵。一云克父母，身旺，中年富。', '三命通会卷八·六辛日戌时断'),
('DHC_辛未_己亥', '辛未', '己亥', '辛', '未', '亥', '辛未日己亥时，贵。亥卯未寅月，金能克木，为财盛生官，名利贵显，巳午年月，富贵。秋生，透丙，亦吉。', '三命通会卷八·六辛日亥时断'),
('DHC_壬申_庚子', '壬申', '庚子', '壬', '申', '子', '壬申日庚子时，贫、刑。未月，杂气财官，行财旺运贵显，先难后易。辰，会水太旺，须行火土运，吉。丑、戌，财官印绶，俱吉。春冬平常，秋夏吉庆。忌乙巳月受刑，夭；丁酉，夭；乙亥月孤，自刑。', '三命通会卷八·六壬日子时断'),
('DHC_壬申_辛丑', '壬申', '辛丑', '壬', '申', '丑', '壬申日辛丑时，寅卯亥未年月，进士风宪，官至二品，终有起倒。辰戌，富足。申酉，享用自然，行北运亦贵。', '三命通会卷八·六壬日丑时断'),
('DHC_壬申_壬寅', '壬申', '壬寅', '壬', '申', '寅', '壬申日壬寅时，巳酉丑月，武职三品。辛卯、戌月，亦贵。子寅，大贵。一云贫而发，亦不久。', '三命通会卷八·六壬日寅时断'),
('DHC_壬申_癸卯', '壬申', '癸卯', '壬', '申', '卯', '壬申日癸卯时，亥卯未寅月，伤官伤尽，妻贤子孝，土厚贵命。纯辰，医卜。子月水木，贵。', '三命通会卷八·六壬日卯时断'),
('DHC_壬申_甲辰', '壬申', '甲辰', '壬', '申', '辰', '壬申日甲辰时，水火灾，丑寅年月，文行武权。纯子，金火运，方面。', '三命通会卷八·六壬日辰时断'),
('DHC_壬申_乙巳', '壬申', '乙巳', '壬', '申', '巳', '壬申日乙巳时，身坐长生学堂，财帛进退，名利驱驰。木月，行北运，贵。辰戌丑，俱吉。', '三命通会卷八·六壬日巳时断'),
('DHC_壬申_丙午', '壬申', '丙午', '壬', '申', '午', '壬申日丙午时，通金水月气，贵；不通，弃命就财，主富，不然，极贫下。', '三命通会卷八·六壬日午时断'),
('DHC_壬申_丁未', '壬申', '丁未', '壬', '申', '未', '壬申日丁未时，大富。巳午年月，或透戊己，富贵双全。', '三命通会卷八·六壬日未时断'),
('DHC_壬申_戊申', '壬申', '戊申', '壬', '申', '申', '壬申日戊申时，壬水长生，居申，煞旺身强，更生亥卯未月，偏官有制，吉。', '三命通会卷八·六壬日申时断'),
('DHC_壬申_己酉', '壬申', '己酉', '壬', '申', '酉', '壬申日己酉时，官印临门，局中无冲破，禄马双全，不贵即富。戌月生，东南方运，腰金衣紫。', '三命通会卷八·六壬日酉时断'),
('DHC_壬申_庚戌', '壬申', '庚戌', '壬', '申', '戌', '壬申日庚戌时，通火木月气，富贵；不通，行通运，亦好。丑戌年月，大贵。', '三命通会卷八·六壬日戌时断'),
('DHC_壬申_辛亥', '壬申', '辛亥', '壬', '申', '亥', '壬申日辛亥时，贵。辰戌丑未，杂气财官，吉。年月干无己土，入日禄格，酉月申卯年，行东北运，显贵。', '三命通会卷八·六壬日亥时断'),
('DHC_癸酉_壬子', '癸酉', '壬子', '癸', '酉', '子', '癸酉日壬子时，行藏进退，少子难为妻家。忌丙寅月，不全尸死；乙巳月，大破凶死；丁酉月，自缢死。', '三命通会卷八·六癸日子时断'),
('DHC_癸酉_癸丑', '癸酉', '癸丑', '癸', '酉', '丑', '癸酉日癸丑时，福德秀气格，学问渊源，行藏进退，难为妻家。', '三命通会卷八·六癸日丑时断'),
('DHC_癸酉_甲寅', '癸酉', '甲寅', '癸', '酉', '寅', '癸酉日甲寅时，金神格。寅午戌月，结火局，贵显特达，官至二三品。忌丑年，不贵。巳未亥子年月，富寿。辰丑，干透甲丁者，凶。', '三命通会卷八·六癸日寅时断'),
('DHC_癸酉_乙卯', '癸酉', '乙卯', '癸', '酉', '卯', '癸酉日乙卯时，申子辰月，贵。寅午戌，中。亥卯未，平。巳酉丑，富。', '三命通会卷八·六癸日卯时断'),
('DHC_癸酉_丙辰', '癸酉', '丙辰', '癸', '酉', '辰', '癸酉日丙辰时，孤，贵。巳酉丑月，贵。寅卯，不吉。子午，富。戌月，大贵。', '三命通会卷八·六癸日辰时断'),
('DHC_癸酉_丁巳', '癸酉', '丁巳', '癸', '酉', '巳', '癸酉日丁巳时，先贫后富。巳酉月，官印俱旺。亥卯未，食伤生财，贵显。午戌，财旺，亦吉。', '三命通会卷八·六癸日巳时断'),
('DHC_癸酉_戊午', '癸酉', '戊午', '癸', '酉', '午', '癸酉日戊午时，主伤妻家财，有始无终，子年子贵而无禄，行南运，好。', '三命通会卷八·六癸日午时断'),
('DHC_癸酉_己未', '癸酉', '己未', '癸', '酉', '未', '癸酉日己未时，寅巳申酉丑戌年月，贵。', '三命通会卷八·六癸日未时断'),
('DHC_癸酉_庚申', '癸酉', '庚申', '癸', '酉', '申', '癸酉日庚申时，卯酉戌寅年月，贵。申酉，火木运，大贵。', '三命通会卷八·六癸日申时断'),
('DHC_癸酉_辛酉', '癸酉', '辛酉', '癸', '酉', '酉', '癸酉日辛酉时，申酉月，印绶多，能守祖，破妻家。子巳午月，干透庚辛，禄贵印绶俱全，贵不可言。寅戌，腰金。午亥，大贵。丑月，煞重凶夭。', '三命通会卷八·六癸日酉时断'),
('DHC_癸酉_壬戌', '癸酉', '壬戌', '癸', '酉', '戌', '癸酉日壬戌时，亥子月，才智高贵，妻贤子孝。春平常。夏财官，秋印绶，俱吉。辰丑，刑冲戌库，贵富两全。戌月，东南运，武贵。', '三命通会卷八·六癸日戌时断'),
('DHC_癸酉_癸亥', '癸酉', '癸亥', '癸', '酉', '亥', '癸酉日癸亥时，辰戌丑未月，生涯遂意。酉月，行东北运，八九品贵。申月，东方运，五品。', '三命通会卷八·六癸日亥时断'),
('DHC_甲戌_甲子', '甲戌', '甲子', '甲', '戌', '子', '甲戌日甲子时，拱亥天门，会同帝阙，甲长生地也，不可以隔角论。年月通申巳酉丑金气，大贵。戊寅年月，主聋哑，或狼虎伤害，见壬则吉。乙卯月，刑死，乙亥月，遭盗死。以上六日年月喜忌，当通融活看。下同。甲子相逢甲子连，拟作蟾宫折桂仙；丑绊并冲官鬼破，功名蹭蹬不周全。甲子时逢甲子，就中印绶符同。庚申辛酉若相逢，丑未再兼年月。拱贵暗藏极显，巳午冲破平中。果无刑克与空冲，定主超群出众。', '三命通会卷八·六甲日子时断'),
('DHC_甲戌_乙丑', '甲戌', '乙丑', '甲', '戌', '丑', '甲戌日乙丑时，田连阡陌，贯朽粟陈，但未免先刑。寅年月，父子俱显。子月，西方运，金紫。劫财羊刃忌时垣，宫内财官锁闭门；辰未相逢为大吉，如无随意度晨昏。甲日时逢乙丑，库中金玉收藏。贵人天乙劫财伤，皎月云遮光荡。火局南方运贵，金神制伏相当。木枯水盛且平常，背祖离乡晚旺。', '三命通会卷八·六甲日丑时断'),
('DHC_甲戌_丙寅', '甲戌', '丙寅', '甲', '戌', '寅', '甲戌日丙寅时，年月有土则富；有金反复。如有金，须生亥子印月方贵，余月则否。甲丙相邀入虎乡，福星坐禄显文章；运逢四柱无伤害，早晚陛迁至宪堂。甲日寅时遇丙，学文福禄班齐。若逢辰戌，两三妻，禄主朝元富贵。丁午庚申减福，无官惹绊为奇。生来贵显有人提，此命先难后易。', '三命通会卷八·六甲日寅时断'),
('DHC_甲戌_丁卯', '甲戌', '丁卯', '甲', '戌', '卯', '甲戌日丁卯时，逢亥月，有才学，贵显。羊刃最坏，造化须有制合方吉；身弱无凶，若年月纯煞，甲木秋生，主夭折。甲旬六日逢丁卯，重重叠叠怕冲刑；运行背禄无官贵，到老穷经不许名。甲日时临丁卯，伤官羊刃相随。甲逢丁火化为灰，父母兄弟难倚。祖业田财聚散，妻儿总有刑亏。运行官煞始为奇，性格或嗔或喜。', '三命通会卷八·六甲日卯时断'),
('DHC_甲戌_戊辰', '甲戌', '戊辰', '甲', '戌', '辰', '甲戌日戊辰时，大富，年月扶合亦贵。寅亥年月，三四品贵。但时日并冲克，早年身孤，中年发福。时上偏财不用多，干枝内外细搜罗；运通财旺官生至，运拙身衰恐受磨。甲日戊辰时遇，柱中要戌相扶。财官运气展良图，喜遇钱龙守库。辛庚透干贵显，壬癸滋助不枯。只怕比劫弟兄多，岁运逢之有祸。', '三命通会卷八·六甲日辰时断'),
('DHC_甲戌_己巳', '甲戌', '己巳', '甲', '戌', '巳', '甲戌日己巳时，财神贵格，名利两全。子戌年月，五品以上贵。甲己中央作土神，时逢辰巳脱埃尘；局中岁运趋炎火，显远功名富贵人。甲日时逢己巳，火临土厚无光。旱苗得雨叶枝强，火局金神旺相。进士有名无实，常人改祖番庄。为人性格不寻常，运至晚年气象。', '三命通会卷八·六甲日巳时断'),
('DHC_甲戌_庚午', '甲戌', '庚午', '甲', '戌', '午', '甲戌日庚午时，生辰戌月，敦厚，不贵则富。丑月行火土运，金紫风宪，寅月清贵。午时庚申是偏官，制伏相宜不等闲；身弱煞强无食见，平生谋望主艰难。甲日时逢庚午，柱中喜见寅申。身强煞浅转精神，父母雁行不顺。妻子早年刑害，晚年出众超群。平生反复好翻腾，先破后成之命。', '三命通会卷八·六甲日午时断'),
('DHC_甲戌_辛未', '甲戌', '辛未', '甲', '戌', '未', '甲戌日辛未时，先刑后贵。寅卯酉丑年月贵，子申年月，位至贵显。甲逢辛未是财官，平步青云路不难；不比退毛鸡化凤，得时飞上彩云路。甲日时逢辛未，财官守库相扶。贵人财禄是良图，初苦未终荣富。君子迁官进职，常人丰厚充腴。刑冲破害柱中无，定得青云之路。', '三命通会卷八·六甲日未时断'),
('DHC_甲戌_壬申', '甲戌', '壬申', '甲', '戌', '申', '甲戌日壬申时，辰戌丑未月，衣锦有成；亥月学堂；寅月建禄；俱贵。午酉月寿促，不然贫贱。甲日时逢喜遇申，偏官偏印怕刑冲；欲求名利终难定，有救须教运气通。甲日时逢壬申，倒食暗鬼相侵。生逢身旺主昌荣，身弱性情不定。雁侣六亲少力，谋为自立自成。运行吉地显声名，运弱平常之命。', '三命通会卷八·六甲日申时断'),
('DHC_甲戌_癸酉', '甲戌', '癸酉', '甲', '戌', '酉', '甲戌日癸酉时，子戌年月，文章显贵。子午月，不贵即富。甲日交通癸酉时，金神火局两相宜；运行南地无刑破，富贵荣华事事奇。甲日时逢癸酉，为人富贵双全。三奇发福屡升迁，上下相和贵显。君子寒门将相，常人置立田园。无伤无破是英贤，此命定居台宪。', '三命通会卷八·六甲日酉时断'),
('DHC_甲戌_甲戌', '甲戌', '甲戌', '甲', '戌', '戌', '甲戌日甲戌时，背禄逐马，平常。秋生，官煞有气，贵。辰戌丑未月，吉。卯月凶。若丙寅、甲午年月，三甲食二丙，丙夏得时，居寅长生，甲就食见禄，主富贵。时逢甲戌比肩逢，库有天禄火气冲；鸡鸭同鸣皆聚散，到头心志不相同。甲日时通甲戌，比肩带禄相逢。天孤仓库隐其中，酉丑辰支取用。无钥冲刑开破，立身多学少成。柱金木火旺火生，先暗后明之命。', '三命通会卷八·六甲日戌时断'),
('DHC_甲戌_乙亥', '甲戌', '乙亥', '甲', '戌', '亥', '甲戌日乙亥时，春冬生，富，土厚地方显贵。夏，劳力不聚财。秋平常。甲日时逢乙亥强，有官有印不寻常；时来自有高人荐，运至财乡大显扬。甲日时逢乙亥，就中壬水相生。时临帝座紫微宫，子嗣螟蛉得用。父母雁行少力，花开结子。', '三命通会卷八·六甲日亥时断'),
('DHC_乙亥_丙子', '乙亥', '丙子', '乙', '亥', '子', '乙亥日丙子时，化青赤，主福。生庚辰年月，富贵。纯亥，成败。丑月，行南运郎官。巳午西运，极贫。忌壬辰月，刑；乙酉月，破祖高贵，中恶死。六乙贵格丙子时，如无冲破始为奇；不遇庚申巳酉丑，定乘轩冕拜丹墀。乙日时临丙子，伤官伤尽荣昌。亥卯未月不寻常，运至身健旺相。辛庚不见发福，午冲丑绊平常。如逢刑克空一场。此命或衰或旺。', '三命通会卷八·六乙日子时断'),
('DHC_乙亥_丁丑', '乙亥', '丁丑', '乙', '亥', '丑', '乙亥日丁丑时，亥月，性急有操持，妻贤子孝，官至六七品。午月长生，年月透官印，大贵。仓库时开乙见丁，食神坐库禄财亲。无匙不作朝中客，也是清闲有福人。乙日时逢丁丑，寿星发达无疑，身居磨蝎莫嫌迟，库内钱财积聚。年时月合发达，空刑妻子难为。双亲雁侣有盈亏，运至牢藏金柜。', '三命通会卷八·六乙日丑时断'),
('DHC_乙亥_戊寅', '乙亥', '戊寅', '乙', '亥', '寅', '乙亥日戊寅时，春吉，夏劳力，秋冬贵。子丑年月，贵至三品，有起有落，寿永。乙日寅时仔细推，为人招是又招非；运衰更遇空刑克，劳力劳心无定期。乙日戊寅时遇，就是暗损伤财。伤官背禄柱中排，富贵妻儿刑害。运旺财官发福，运行比煞兴灾。六亲骨肉少和谐，自立自成自在。', '三命通会卷八·六乙日寅时断'),
('DHC_乙亥_己卯', '乙亥', '己卯', '乙', '亥', '卯', '乙亥日己卯时，生寅巳月，不见庚辛，日禄归时格，显达清贵。纯卯年月，高僧羽士。戌，特达聪明，有财禄。日禄居时格不同，食神则马要相逢；伤官印运皆为吉，官不逢兮禄自丰。乙日时临己卯，偏财时禄归迎。辛金酉字不相刑，虎榜定标名姓。父母六亲难靠，雁行各自飞腾，文章光耀有才能，无破无冲贵命。', '三命通会卷八·六乙日卯时断'),
('DHC_乙亥_庚辰', '乙亥', '庚辰', '乙', '亥', '辰', '乙亥日庚辰时，不贵则富。若年月癸戊一化，申卯两旺，巳丑酉会金，行木土运，位至金紫。乙庚相会贵无疑，阴木阳金正合时；运吉身强无冲破，升迁自有贵人提。乙日庚辰时正，天官守库乾元，青年虎榜姓名传，禀性温良恭俭。士庶妻贤子贵。财人禄位升迁。南离戊癸火相连。富贵之中当险。', '三命通会卷八·六乙日辰时断'),
('DHC_乙亥_辛巳', '乙亥', '辛巳', '乙', '亥', '巳', '乙亥日辛巳时，生巳午月，偏官有制。春干强，位居风宪。秋煞重，主残疾。乙巳相伤逢金木，求名求利常反复；六亲骨肉有如无，印绶运乡能发福。乙日时逢辛巳，柱中鬼旺身衰。六亲难靠不和谐，谋望有成有败。几度遇凶则吉，信知苦尽甘来。运行身旺印绶怀，富贵时人喝采。', '三命通会卷八·六乙日巳时断'),
('DHC_乙亥_壬午', '乙亥', '壬午', '乙', '亥', '午', '乙亥日壬午时，春身旺，夏福厚，秋反复，冬吉庆。乙日生逢壬午时，月通水木贵人钦；运行官旺无冲破，家业丰隆事称心。乙日时逢壬午，食神印绶同宫。无冲无破不相刑，信是声名响应。词馆清秀高士，文章出众超群，贵人喜见小人憎，中末峥嵘之命。', '三命通会卷八·六乙日午时断'),
('DHC_乙亥_癸未', '乙亥', '癸未', '乙', '亥', '未', '乙亥日癸未时，春木旺，刑伤妻子。申月官旺，贵。酉煞旺，年月有火则吉。午未戌年月，一二品贵。冬生稳厚。乙日相逢时癸未，算来离祖不成家；有刑克害多成败，运吉如添锦上花。乙日相逢癸未，生逢木墓夭孤。雁行兄弟有如无，心性不常喜怒。自立自成事业，六亲骨肉亲疏，贵人得合两相扶，此命先贫后富。', '三命通会卷八·六乙日未时断'),
('DHC_乙亥_甲申', '乙亥', '甲申', '乙', '亥', '申', '乙亥日甲申时，时落空亡，主少子。秋生，官居六卿。亥卯年未月，俱吉。乙日相逢时遇甲，长生驿马内相亲；贵人天乙来相助，释却褐衣入紫宸。乙日申时逢贵，其间高人见喜。小人称美有奇希，克破冲刑减力。身旺运逢吉地，信知两旺财官。有鞍有马有衣冠，定主门庭改换。', '三命通会卷八·六乙日申时断'),
('DHC_乙亥_乙酉', '乙亥', '乙酉', '乙', '亥', '酉', '乙亥日乙酉时，春生，仁寿格，贵。寅月，行金火运，大贵。日干是乙时临酉，假煞为权身旺奇；身弱遇官徒费力，功名须待运通时。乙日时临乙酉，诞辰乙木无忧。其中权贵任求谋，无破功名定有。妻子早年克害，财源雨散云收。迁宗移祖免忧愁。中末家资成就。', '三命通会卷八·六乙日酉时断'),
('DHC_乙亥_丙戌', '乙亥', '丙戌', '乙', '亥', '戌', '乙亥日丙戌时，血疾。亥子卯未寅月，遇贵发福；天干透伤官生财，尤吉。枯木相逢局，逢春叶更生；晚年方得地，花发再重荣。乙日丙戌时火库，藏辛遇丑乃吉昌；若也运逢凶克害，算来此命且如常。乙日相逢丙戌，伤官库木枝枯。不临辛丑钥匙无。难倚六亲父母，雁侣分飞不睦，于人心悲成疏。要知发福改门闾，此命后甜先苦。', '三命通会卷八·六乙日戌时断'),
('DHC_乙亥_丁亥', '乙亥', '丁亥', '乙', '亥', '亥', '乙亥日丁亥时，有财自刑，寅卯身旺，天干透财者富；辰丑，行金火运，贵。亥子申，官印双清，更辅以财。大贵。时上生逢亥与丁，食神乙木遇长生；月气相扶为最贵，身衰无倚是常人。乙日时逢丁亥，食神印绶相扶。长生得意好无伤，荣显清名贵遇。喜逢丁壬化气，运临冠带迁除。无机妙法实难窥，丙己寅申减贵。', '三命通会卷八·六乙日亥时断'),
('DHC_丙子_戊子', '丙子', '戊子', '丙', '子', '子', '丙子日戊子时，寅巳卯未月，木能生火，大贵。冬月，丙火无气，贫夭。戌月，行火土运，五六品贵。忌丁巳月，夭；己酉月，破家失土，身贱。', '三命通会卷八·六丙日子时断'),
('DHC_丙子_己丑', '丙子', '己丑', '丙', '子', '丑', '丙子日己丑时，寅亥申辰年月，天干透财印食者贵。', '三命通会卷八·六丙日丑时断'),
('DHC_丙子_庚寅', '丙子', '庚寅', '丙', '子', '寅', '丙子日庚寅时，生子月，近贵。癸酉月，行水木运，高贵；火木运，五品以上贵。未申、癸午年月，身居武职，大贵，寿浅。', '三命通会卷八·六丙日寅时断'),
('DHC_丙子_辛卯', '丙子', '辛卯', '丙', '子', '卯', '丙子日辛卯时，子卯相刑，伤妻害子。年月同，主魁名，近侍之贵。寅、午、丑、戌、天干地支俱合者大贵。', '三命通会卷八·六丙日卯时断'),
('DHC_丙子_壬辰', '丙子', '壬辰', '丙', '子', '辰', '丙子日壬辰时，辰戌丑未月，偏官有制，吉。亥卯年月，富贵。寅午，行子运；子，行寅午运，俱贵。不然僧道。', '三命通会卷八·六丙日辰时断'),
('DHC_丙子_癸巳', '丙子', '癸巳', '丙', '子', '巳', '丙子日癸巳时，丙禄在巳，癸禄在巳，互换禄马，岁月无壬巳寅亥冲破，近侍风宪，位至公侯。', '三命通会卷八·六丙日巳时断'),
('DHC_丙子_甲午', '丙子', '甲午', '丙', '子', '午', '丙子日甲午时，春生吉；夏无依，秋财旺，冬官贵，少子晚成，火土运发达。', '三命通会卷八·六丙日午时断'),
('DHC_丙子_乙未', '丙子', '乙未', '丙', '子', '未', '丙子日乙未时，春，印绶稳厚。夏平稳，秋反复，冬贵，岁运同。', '三命通会卷八·六丙日未时断'),
('DHC_丙子_丙申', '丙子', '丙申', '丙', '子', '申', '丙子日丙申时，若通火气及寅卯月再行身旺运，吉。年月纯金，弃命就财，亦以吉论。', '三命通会卷八·六丙日申时断'),
('DHC_丙子_丁酉', '丙子', '丁酉', '丙', '子', '酉', '丙子日丁酉时，春稳，夏贵，秋平，冬吉。未申酉亥年月，大贵。有丑会子，有辰会酉，俱以贵论。', '三命通会卷八·六丙日酉时断'),
('DHC_丙子_戊戌', '丙子', '戊戌', '丙', '子', '戌', '丙子日戊戌时，寿永，名利不失。家亥卯未印及申酉戌巳年胜，贵。', '三命通会卷八·六丙日戌时断'),
('DHC_丙子_己亥', '丙子', '己亥', '丙', '子', '亥', '丙子日己亥时，秋冬，平常。未月，行水木运，干透木火者，贵。子月，行东运，大贵。申、亥、丑、戌年月，亦贵。', '三命通会卷八·六丙日亥时断'),
('DHC_丁丑_庚子', '丁丑', '庚子', '丁', '丑', '子', '丁丑日庚子时平，通木火气，或行身旺运，贵。亦有亥子年月贵者，以丁火阴柔，不怕水乡故也。', '三命通会卷八·六丁日子时断'),
('DHC_丁丑_辛丑', '丁丑', '辛丑', '丁', '丑', '丑', '丁丑日辛丑时，申酉月，财格，财旺生官，贵。午月，伤财身旺，主官禄。纯子寅，武贵三品。水月，艰辛劳苦。辰月贵戚。', '三命通会卷八·六丁日丑时断'),
('DHC_丁丑_壬寅', '丁丑', '壬寅', '丁', '丑', '寅', '丁丑日壬寅时化贵。生冬月，官旺，贵。春，印绶，安稳，夏吉；秋平，行东运好。', '三命通会卷八·六丁日寅时断'),
('DHC_丁丑_癸卯', '丁丑', '癸卯', '丁', '丑', '卯', '丁丑日癸卯时，辰戌丑未月，制伏得中贵。午月干强，贵。申丑，风宪。', '三命通会卷八·六丁日卯时断'),
('DHC_丁丑_甲辰', '丁丑', '甲辰', '丁', '丑', '辰', '丁丑日甲辰时吉，亥子月，富贵。申月，东方运；午月，金水运，俱贵。纯寅，风宪极品。', '三命通会卷八·六丁日辰时断'),
('DHC_丁丑_乙巳', '丁丑', '乙巳', '丁', '丑', '巳', '丁丑日乙巳时，春富，夏孤，秋吉，冬贵。', '三命通会卷八·六丁日巳时断'),
('DHC_丁丑_丙午', '丁丑', '丙午', '丁', '丑', '午', '丁丑日丙午时平，寅卯戌未年月，贵。酉丑，用财最吉。忌亥子官煞。', '三命通会卷八·六丁日午时断'),
('DHC_丁丑_丁未', '丁丑', '丁未', '丁', '丑', '未', '丁丑日丁未时，丑未刑冲，不得善终。年月辰戌，四库全，贵当极品。申未，三品，法司淡薄清闲。', '三命通会卷八·六丁日未时断'),
('DHC_丁丑_戊申', '丁丑', '戊申', '丁', '丑', '申', '丁丑日戊申时，秀贵。未申年月，贵；行东南运，大贵。巳月，西北运，六卿之职。', '三命通会卷八·六丁日申时断'),
('DHC_丁丑_己酉', '丁丑', '己酉', '丁', '丑', '酉', '丁丑日己酉时，辰巳午未申戌年月贵。', '三命通会卷八·六丁日酉时断'),
('DHC_丁丑_庚戌', '丁丑', '庚戌', '丁', '丑', '戌', '丁丑日庚戌时，时日相刑，忧伤妻子。若寅亥申酉年月，官至三品。午未子辰，行金木运亦贵。', '三命通会卷八·六丁日戌时断'),
('DHC_丁丑_辛亥', '丁丑', '辛亥', '丁', '丑', '亥', '丁丑日辛亥时，秋财旺，夏身旺，春印旺，贵显。冬，官煞太重，恐身弱不能胜任其福。', '三命通会卷八·六丁日亥时断'),
('DHC_戊寅_壬子', '戊寅', '壬子', '戊', '寅', '子', '戊寅日壬子时，卯月，正官格，贵。夏乖，秋少顺。丑酉年月，吉。忌己巳月刑，己亥月凶刑。', '三命通会卷八·六戊日子时断'),
('DHC_戊寅_癸丑', '戊寅', '癸丑', '戊', '寅', '丑', '戊寅日癸丑时，寅巳午未戌月，化火吉。秋冬平常。', '三命通会卷八·六戊日丑时断'),
('DHC_戊寅_甲寅', '戊寅', '甲寅', '戊', '寅', '寅', '戊寅日甲寅时，身旺，骨肉不同居。午月，刃印带煞；子月，正财党煞，干透制；亥卯未，纯煞身柔，干透刃，运行西南，兵权万里；巳丑戌年月，身旺敌煞；酉丑申，制煞，皆主大贵，嫌劫煞克身则凶。', '三命通会卷八·六戊日寅时断'),
('DHC_戊寅_乙卯', '戊寅', '乙卯', '戊', '寅', '卯', '戊寅日乙卯时，亥子年月，妻贤子孝，贵。卯辰纯，吉；寅巳亦吉。', '三命通会卷八·六戊日卯时断'),
('DHC_戊寅_丙辰', '戊寅', '丙辰', '戊', '寅', '辰', '戊寅日丙辰时，龙吟虎啸，中年大贵。子月，行北运，土厚地方，官至三品；东运，风宪。丑辰年月，四五品贵。寅午戌年，通土气月，行木火运，极品。', '三命通会卷八·六戊日辰时断'),
('DHC_戊寅_丁巳', '戊寅', '丁巳', '戊', '寅', '巳', '戊寅日丁巳时，寅巳相刑，忧伤妻子。午月，东北运，风宪。寅午年月，四品。', '三命通会卷八·六戊日巳时断'),
('DHC_戊寅_戊午', '戊寅', '戊午', '戊', '寅', '午', '戊寅日戊午时，戌月，三合火局，干透癸化，得天时地利者贵。年月申子会水，寅午会火，有既济之妙；辰月亦得；酉伤官；未官印，俱吉。', '三命通会卷八·六戊日午时断'),
('DHC_戊寅_己未', '戊寅', '己未', '戊', '寅', '未', '戊寅日己未时，先难后易，贵人提携，不贵即富。年月透甲制刃，地支午未身旺，煞刃双显，主大贵。', '三命通会卷八·六戊日未时断'),
('DHC_戊寅_庚申', '戊寅', '庚申', '戊', '寅', '申', '戊寅日庚申时，凶刑后发，如生寅月，作食禄制煞论，贵。', '三命通会卷八·六戊日申时断'),
('DHC_戊寅_辛酉', '戊寅', '辛酉', '戊', '寅', '酉', '戊寅日辛酉时，通土气月，行西北运，不贵亦富。', '三命通会卷八·六戊日酉时断'),
('DHC_戊寅_壬戌', '戊寅', '壬戌', '戊', '寅', '戌', '戊寅日壬戌时，寅午戌辰年月，金水运，大贵。', '三命通会卷八·六戊日戌时断'),
('DHC_戊寅_癸亥', '戊寅', '癸亥', '戊', '寅', '亥', '戊寅日癸亥时，午未月生，化火会局，高命。春，官煞混杂，温饱衣禄。酉丑年月，三品京堂。', '三命通会卷八·六戊日亥时断'),
('DHC_己卯_甲子', '己卯', '甲子', '己', '卯', '子', '己卯日甲子时，先破祖后旺，或旺中有伤。辰戌丑未月，贵。午，身旺。子，聚贵，亥，官长生，俱大贵。忌己巳月，破败凶死。庚申月，血光恶死。壬子月，刑害死。', '三命通会卷八·六己日子时断'),
('DHC_己卯_乙丑', '己卯', '乙丑', '己', '卯', '丑', '己卯日乙丑时，子申月，行金土运，侯伯。巳酉丑戌年月，俱吉。', '三命通会卷八·六己日丑时断'),
('DHC_己卯_丙寅', '己卯', '丙寅', '己', '卯', '寅', '己卯日丙寅时，午辰年月，文章显达，大贵。寅午，官至三品。', '三命通会卷八·六己日寅时断'),
('DHC_己卯_丁卯', '己卯', '丁卯', '己', '卯', '卯', '己卯日丁卯时，巳酉年月，制伏得宜。庚申合煞，文进大贵。子月，刑煞遇贵，主兵权或法官。地支纯印或三合木局，运行寅，混官再遇流年冲运，凶死。', '三命通会卷八·六己日卯时断'),
('DHC_己卯_戊辰', '己卯', '戊辰', '己', '卯', '辰', '己卯日戊辰时，卯月，风宪。水木年月，行东北运，并同。', '三命通会卷八·六己日辰时断'),
('DHC_己卯_己巳', '己卯', '己巳', '己', '卯', '巳', '己卯日己巳时，夹辰财库，主大富。又，卯以巳为驿马，二己通看，谓之坐马。再生午月，禄马俱有，尤为贵命。亥月，财临旺地，官遇长生。巳月，金神遇火，皆主大贵。', '三命通会卷八·六己日巳时断'),
('DHC_己卯_庚午', '己卯', '庚午', '己', '卯', '午', '己卯日庚午时，己禄居午，年月有甲丙及寅午者，大贵。卯月，煞旺庚合，权贵。', '三命通会卷八·六己日午时断'),
('DHC_己卯_辛未', '己卯', '辛未', '己', '卯', '未', '己卯日辛未时，酉戌亥卯，未年月，贵，行东南运，金紫。', '三命通会卷八·六己日未时断'),
('DHC_己卯_壬申', '己卯', '壬申', '己', '卯', '申', '己卯日壬申时，辰月，杂气财官，早贵。亥月、南方运，五、六品贵。寅申年，三、二品贵。', '三命通会卷八·六己日申时断'),
('DHC_己卯_癸酉', '己卯', '癸酉', '己', '卯', '酉', '己卯日癸酉时，时日相逢卯酉，主迁移；刑伤又伤官带煞，主性凶暴，作事迟延。生四季月，吉。', '三命通会卷八·六己日酉时断'),
('DHC_己卯_甲戌', '己卯', '甲戌', '己', '卯', '戌', '己卯日甲戌时，丙丁午戌年月，干有庚辛制伏官煞，生山明水秀地方，官至二、三品。未酉丑月，行土火运，四、五品。午月、东北运，大贵。子运、木火运，风宪。辰巳有倚托者，极品。', '三命通会卷八·六己日戌时断'),
('DHC_己卯_乙亥', '己卯', '乙亥', '己', '卯', '亥', '己卯日乙亥时，卯月，偏官格，煞重身柔，作弃命看。壬字暗逢，志气轩昂；柱有制伏，行土金运，官至三、四品。丑月，杂气。辰、巳，西运，金紫。亥月，水运，夭。', '三命通会卷八·六己日亥时断'),
('DHC_庚辰_丙子', '庚辰', '丙子', '庚', '辰', '子', '庚辰日丙子时，月通木火气，行西运，妙。乙巳月，破败，刑。丁酉月，旺中刑，凶。己丑月，破败，凶。', '三命通会卷八·六庚日子时断'),
('DHC_庚辰_丁丑', '庚辰', '丁丑', '庚', '辰', '丑', '庚辰日丁丑时，丑月，富而寿促。己，近侍，大贵。通火旺土生月，贵；不得，运遇亦富，有名誉。', '三命通会卷八·六庚日丑时断'),
('DHC_庚辰_戊寅', '庚辰', '戊寅', '庚', '辰', '寅', '庚辰日戊寅时，春夏生，干透丙丁，运行身旺，贵。', '三命通会卷八·六庚日寅时断'),
('DHC_庚辰_己卯', '庚辰', '己卯', '庚', '辰', '卯', '庚辰日己卯时，孤。年月通木气及有倚托者，贵。', '三命通会卷八·六庚日卯时断'),
('DHC_庚辰_庚辰', '庚辰', '庚辰', '庚', '辰', '辰', '庚辰日庚辰时，魁罡，年月不见财官并戌字，贵；冲破者富。申子年月作井栏叉，行西南运，吉。纯庚辰，庚申或乙酉化金通无火气，凶徒小人。一云刑。', '三命通会卷八·六庚日辰时断'),
('DHC_庚辰_辛巳', '庚辰', '辛巳', '庚', '辰', '巳', '庚辰日辛巳时，巳酉丑月，身旺，贵。煞旺身弱月，贫。纯申年月，大贵悠久。亥月，东南运、主有权贵。', '三命通会卷八·六庚日巳时断'),
('DHC_庚辰_壬午', '庚辰', '壬午', '庚', '辰', '午', '庚辰日壬午时，食神旺，善饮食，有操持，发即死。', '三命通会卷八·六庚日午时断'),
('DHC_庚辰_癸未', '庚辰', '癸未', '庚', '辰', '未', '庚辰日癸未时，魁罡日。辰中有土制癸。年月无丁；贵。卯月，金水运，七品贵。', '三命通会卷八·六庚日未时断'),
('DHC_庚辰_甲申', '庚辰', '甲申', '庚', '辰', '申', '庚辰日甲申时，日魁罡，又归禄，俱不喜财官、柱无寅午戌丙丁巳字，贵。', '三命通会卷八·六庚日申时断'),
('DHC_庚辰_乙酉', '庚辰', '乙酉', '庚', '辰', '酉', '庚辰日乙酉时，刑。寅卯午年等月，二品权贵。戌亥大贵。《神白经》云：化金，主福厚。', '三命通会卷八·六庚日酉时断'),
('DHC_庚辰_丙戌', '庚辰', '丙戌', '庚', '辰', '戌', '庚辰日丙戌时，时日相冲，忧伤妻子。月通金水气，贵。木火气重者，艰辛，贫夭或残疾。', '三命通会卷八·六庚日戌时断'),
('DHC_庚辰_丁亥', '庚辰', '丁亥', '庚', '辰', '亥', '庚辰日丁亥时，纯未，显达。巳午，西北运，风宪、金紫。亥卯、金紫，有权。申月，建禄，最吉。', '三命通会卷八·六庚日亥时断'),
('DHC_辛巳_戊子', '辛巳', '戊子', '辛', '巳', '子', '辛巳日戊子时，寅巳午月，正官，贵显。亥子，伤官，子少妻多。卯戌，五品贵。《神白经》云：金化象，主贵。忌丙寅月，刑、平。乙巳月，先贫。丁酉月，夭。', '三命通会卷八·六辛日子时断'),
('DHC_辛巳_己丑', '辛巳', '己丑', '辛', '巳', '丑', '辛巳日己丑时，丑巳申酉月生，金多克木，损伤妻子；僧道，贵。寅卯辰。月，南运，贵。', '三命通会卷八·六辛日丑时断'),
('DHC_辛巳_庚寅', '辛巳', '庚寅', '辛', '巳', '寅', '辛巳日庚寅时，春贵；夏官禄，行西北运，大贵；秋身旺；冬暴狠。一云刑后有财。', '三命通会卷八·六辛日寅时断'),
('DHC_辛巳_辛卯', '辛巳', '辛卯', '辛', '巳', '卯', '辛巳日辛卯时，春，财旺；夏、官旺、秋，身强；冬，懦弱。巳酉年月，行木火运，贵戚。申月、水火运，金紫。巳月、西北运，风宪。', '三命通会卷八·六辛日卯时断'),
('DHC_辛巳_壬辰', '辛巳', '壬辰', '辛', '巳', '辰', '辛巳日壬辰时，春、显达；夏，平常；有名利，主暴虐。酉月、行东运，贵。戌未，四库全，最贵。纯未，杂气财印。丑未，冲开，主有权贵。', '三命通会卷八·六辛日辰时断'),
('DHC_辛巳_癸巳', '辛巳', '癸巳', '辛', '巳', '巳', '辛巳日癸巳时，化贵。子午年，寅午戌月，贵，亥卯未，清贵。申子辰，无义之人。辛巳癸巳，两干不杂寅辰，透丙，俱主极贵。丑酉三合，亦吉。', '三命通会卷八·六辛日巳时断'),
('DHC_辛巳_甲午', '辛巳', '甲午', '辛', '巳', '午', '辛巳日甲午时，平。寅午戌，官旺，吉。申子辰、平常。卯戌年，官印双全，公候。', '三命通会卷八·六辛日午时断'),
('DHC_辛巳_乙未', '辛巳', '乙未', '辛', '巳', '未', '辛巳日乙未时，月通金火，贵。运通，亦贵。', '三命通会卷八·六辛日未时断'),
('DHC_辛巳_丙申', '辛巳', '丙申', '辛', '巳', '申', '辛巳日丙申时，见血则福；又云贵中失。申未年月，身厚，妻重子孝，武职三品。', '三命通会卷八·六辛日申时断'),
('DHC_辛巳_丁酉', '辛巳', '丁酉', '辛', '巳', '酉', '辛巳日丁酉时，平。亥月，反复不定。午月，偏官带疾，显达寿促。子月，贵戚。一云有财有喜，寿不过三十一。', '三命通会卷八·六辛日酉时断'),
('DHC_辛巳_戊戌', '辛巳', '戊戌', '辛', '巳', '戌', '辛巳日戊戌时，辰戌丑未月，印绶，文贵少病；生土厚分野，贵。戌月，行木火运，风宪。', '三命通会卷八·六辛日戌时断'),
('DHC_辛巳_己亥', '辛巳', '己亥', '辛', '巳', '亥', '辛巳日己亥时，填实巳字，不入飞天格，作官印论，主父母竭力扶持而后富贵。', '三命通会卷八·六辛日亥时断'),
('DHC_壬午_庚子', '壬午', '庚子', '壬', '午', '子', '壬午日庚子时，时日并冲，女多男少。丑未月，行南运，富贵。余年月，观诸贵命可见。忌甲午月自刑，多是非；癸酉月大破，失乡恶死；辛亥月恶死。', '三命通会卷八·六壬日子时断'),
('DHC_壬午_辛丑', '壬午', '辛丑', '壬', '午', '丑', '壬午日辛丑时，禄马同乡，贵。夏吉。秋，财官印全，亦贵。', '三命通会卷八·六壬日丑时断'),
('DHC_壬午_壬寅', '壬午', '壬寅', '壬', '午', '寅', '壬午日壬寅时，少年多疾厄。壬午，禄马同乡。辰寅年月，二品贵。申酉，高尚，若通木火，才名冠世，贵。戌月，行东南运，方面极品。', '三命通会卷八·六壬日寅时断'),
('DHC_壬午_癸卯', '壬午', '癸卯', '壬', '午', '卯', '壬午日癸卯时，壬居午位，禄马同乡，又值卯时，贵显荣达。巳午年月，武职风宪。', '三命通会卷八·六壬日卯时断'),
('DHC_壬午_甲辰', '壬午', '甲辰', '壬', '午', '辰', '壬午日甲辰时，水火灾。寅辰年月，翰苑宿儒，或居祭酒。纯子，风宪。卯寅，富厚。辰子，儒职。', '三命通会卷八·六壬日辰时断'),
('DHC_壬午_乙巳', '壬午', '乙巳', '壬', '午', '巳', '壬午日乙巳时，辰戌月，贵。亥月，金运，位至都帅。', '三命通会卷八·六壬日巳时断'),
('DHC_壬午_丙午', '壬午', '丙午', '壬', '午', '午', '壬午日丙午时，冬日身旺，吉。夏，财多身弱，丑日近侍，贵。寅午，金土运，独弱从强，弃命就财，高命。', '三命通会卷八·六壬日午时断'),
('DHC_壬午_丁未', '壬午', '丁未', '壬', '午', '未', '壬午日丁未时，春平，夏富，秋贵，冬吉。巳午年月，位至王候。未月，东运，贵。子月，正印、三奇俱藏，贵当极品。', '三命通会卷八·六壬日未时断'),
('DHC_壬午_戊申', '壬午', '戊申', '壬', '午', '申', '壬午日戊申时，偏官偏印。亥卯未寅月，威权。子丑月，木火运，翰林清贵。戌月，行东南运，高品。', '三命通会卷八·六壬日申时断'),
('DHC_壬午_己酉', '壬午', '己酉', '壬', '午', '酉', '壬午日己酉时，禄马同乡，先难后易。丑寅月，行金水运，武职二品。', '三命通会卷八·六壬日酉时断'),
('DHC_壬午_庚戌', '壬午', '庚戌', '壬', '午', '戌', '壬午日庚戌时，禄马同乡，壬自坐禄，有庚辛制甲乙为贵。辰戌丑未年月，吉。申月学堂，文贵大显。亥子水旺，透壬主凶。午戌透戊，煞旺亦凶。', '三命通会卷八·六壬日戌时断'),
('DHC_壬午_辛亥', '壬午', '辛亥', '壬', '午', '亥', '壬午日辛亥时，平。丑月，风宪。寅月，禄马同乡，行金水运，方面。戌月，东北运，四五品。丑午，僧道官命。', '三命通会卷八·六壬日亥时断'),
('DHC_癸未_壬子', '癸未', '壬子', '癸', '未', '子', '癸未日壬子时，申酉月，贵。戌亥，大富贵。寅卯，孤。辰巳，凶。忌壬申月，身不全，凶；庚辰月，凶刑；乙丑月，失土凶死。', '三命通会卷八·六癸日子时断'),
('DHC_癸未_癸丑', '癸未', '癸丑', '癸', '未', '丑', '癸未日癸丑时，子丑寅年月，贵，中年富。卯月，行金水运，极品。辰戌，四库全，大贵。', '三命通会卷八·六癸日丑时断'),
('DHC_癸未_甲寅', '癸未', '甲寅', '癸', '未', '寅', '癸未日甲寅时，主秀实，中年贵显。若生己未己巳年月，武贵。', '三命通会卷八·六癸日寅时断'),
('DHC_癸未_乙卯', '癸未', '乙卯', '癸', '未', '卯', '癸未日乙卯时，寅亥卯未月，伤官伤尽，刚断平常。辰戌申子月，贵。', '三命通会卷八·六癸日卯时断'),
('DHC_癸未_丙辰', '癸未', '丙辰', '癸', '未', '辰', '癸未日丙辰时，高。寅卯未月，平常。辰戌丑月，吉，巳月，财官俱旺，贵。', '三命通会卷八·六癸日辰时断'),
('DHC_癸未_丁巳', '癸未', '丁巳', '癸', '未', '巳', '癸未日丁巳时，寅午戌月，身财旺显，秋冬禄旺，伤残疾。', '三命通会卷八·六癸日巳时断'),
('DHC_癸未_戊午', '癸未', '戊午', '癸', '未', '午', '癸未日戊午时，寅午戌，化火合局，贵显。', '三命通会卷八·六癸日午时断'),
('DHC_癸未_己未', '癸未', '己未', '癸', '未', '未', '癸未日己未时，高。春偏官有制，吉。夏，平常。秋、冬身旺，申月行木运，显贵。巳辰年，六卿。', '三命通会卷八·六癸日未时断'),
('DHC_癸未_庚申', '癸未', '庚申', '癸', '未', '申', '癸未日庚申时，柱有甲寅，乙卯，己与甲合，乙与庚合，妻贤子孝，荣华在后。酉申年月，三四品。秋生，行木火运，二三品。亥卯，文进贵。', '三命通会卷八·六癸日申时断'),
('DHC_癸未_辛酉', '癸未', '辛酉', '癸', '未', '酉', '癸未日辛酉时，春贫，夏先难后易，秋吉，冬贵。', '三命通会卷八·六癸日酉时断'),
('DHC_癸未_壬戌', '癸未', '壬戌', '癸', '未', '戌', '癸未日壬戌时，刑。巳月生，三四品。子庚年月，近侍贵。', '三命通会卷八·六癸日戌时断'),
('DHC_癸未_癸亥', '癸未', '癸亥', '癸', '未', '亥', '癸未日癸亥时，身下坐财官。辰戌丑未月，行东北运，贵。秋月，东运，七八品贵；干透正印、正官，金紫。', '三命通会卷八·六癸日亥时断'),
('DHC_甲申_甲子', '甲申', '甲子', '甲', '申', '子', '甲申日甲子时，甲胎逢印印化煞，贵。鸳鸯重叠，子嗣难为。若行东南方运，文武职居间。亥卯未辰丑申等月，俱贵。乙卯月夭。丁巳月，死不全尸。', '三命通会卷八·六甲日子时断'),
('DHC_甲申_乙丑', '甲申', '乙丑', '甲', '申', '丑', '甲申日乙丑时，带疾平常。子月生，南方运，贵。秋生化煞，天干透印绶，尤贵。', '三命通会卷八·六甲日丑时断'),
('DHC_甲申_丙寅', '甲申', '丙寅', '甲', '申', '寅', '甲申日丙寅时，时日并冲，忧伤妻子。若年月日同，大贵；巳、亥二三品；辰、子年月，会水以煞化印，吉；未月财库，亦吉。', '三命通会卷八·六甲日寅时断'),
('DHC_甲申_丁卯', '甲申', '丁卯', '甲', '申', '卯', '甲申日丁卯时，主武职，风宪权贵。酉月，火木运，中贵。寅、午年月大贵。', '三命通会卷八·六甲日卯时断'),
('DHC_甲申_戊辰', '甲申', '戊辰', '甲', '申', '辰', '甲申日戊辰时，主孤，僧道清高。丑月富贵。寅月尤贵。', '三命通会卷八·六甲日辰时断'),
('DHC_甲申_己巳', '甲申', '己巳', '甲', '申', '巳', '甲申日己巳时，敦厚聪明，善于决断，身孤清贵，不免破刑。', '三命通会卷八·六甲日巳时断'),
('DHC_甲申_庚午', '甲申', '庚午', '甲', '申', '午', '甲申日庚午时，子辰年月会印。亥卯年月身旺，俱贵。寅戌会伤制煞，甲得寄托，亦贵，运喜金水。', '三命通会卷八·六甲日午时断'),
('DHC_甲申_辛未', '甲申', '辛未', '甲', '申', '未', '甲申日辛未时，春吉，夏辛苦，秋显达，冬根基别立贵。子丑月大贵。', '三命通会卷八·六甲日未时断'),
('DHC_甲申_壬申', '甲申', '壬申', '甲', '申', '申', '甲申日壬申时，寅月，身煞两停；卯月，以刃合煞，俱贵。子辰年月，以煞化印；巳午火月，七煞有制，俱吉。最怕煞旺身弱，大凶。', '三命通会卷八·六甲日申时断'),
('DHC_甲申_癸酉', '甲申', '癸酉', '甲', '申', '酉', '甲申日癸酉时，平常。通火气月，行南运，富贵。申酉年月，多夭。有水化金毒，只作官印论，不作金神亦吉，但主退早。', '三命通会卷八·六甲日酉时断'),
('DHC_甲申_甲戌', '甲申', '甲戌', '甲', '申', '戌', '甲申日甲戌时，夹酉官贵，但身孤，发亦不久。春生，木土运，贵。', '三命通会卷八·六甲日戌时断'),
('DHC_甲申_乙亥', '甲申', '乙亥', '甲', '申', '亥', '甲申日乙亥时，亥月，学问有成，贵为风宪。申酉月，先贫后富。子月，行水火运，金紫。辰戌丑未，杂气财官；寅月建禄，俱吉。', '三命通会卷八·六甲日亥时断'),
('DHC_乙酉_丙子', '乙酉', '丙子', '乙', '酉', '子', '乙酉日丙子时，贵，身孤，反复起倒，月通水气，不见辛午亦贵。忌戊寅月，大凶；丁巳月，破祖贫；己酉月，金刃死。', '三命通会卷八·六乙日子时断'),
('DHC_乙酉_丁丑', '乙酉', '丁丑', '乙', '酉', '丑', '乙酉日丁丑时，若通木气有倚托者，显贵。申丑年月亦好，寅亥尤佳。', '三命通会卷八·六乙日丑时断'),
('DHC_乙酉_戊寅', '乙酉', '戊寅', '乙', '酉', '寅', '乙酉日戊寅时，春生富，夏平、秋贵、寿促，冬吉。', '三命通会卷八·六乙日寅时断'),
('DHC_乙酉_己卯', '乙酉', '己卯', '乙', '酉', '卯', '乙酉日己卯时秀，初年破祖，中主发财，未年孤刑。', '三命通会卷八·六乙日卯时断'),
('DHC_乙酉_庚辰', '乙酉', '庚辰', '乙', '酉', '辰', '乙酉日庚辰时，亥子年月，干透戊癸，贵。寅巳午月，官煞有制，吉。纯酉化金，主厚福。', '三命通会卷八·六乙日辰时断'),
('DHC_乙酉_辛巳', '乙酉', '辛巳', '乙', '酉', '巳', '乙酉日辛巳时，若未月生，身坐制伏则吉。秋偏官，贵。酉月，行南方运，贫，不然残疾。', '三命通会卷八·六乙日巳时断'),
('DHC_乙酉_壬午', '乙酉', '壬午', '乙', '酉', '午', '乙酉日壬午时，春吉。秋夏平常。柱纯乙酉，透庚合化，或见印助，大贵。', '三命通会卷八·六乙日午时断'),
('DHC_乙酉_癸未', '乙酉', '癸未', '乙', '酉', '未', '乙酉日癸未时，身坐煞，春，身旺，吉。夏，身弱煞衰，贫。秋，煞旺，身能从化，贵。冬平。辰戌丑未月，透庚辛，行金运，贵。一到刃运，退官罢职。', '三命通会卷八·六乙日未时断'),
('DHC_乙酉_甲申', '乙酉', '甲申', '乙', '酉', '申', '乙酉日甲申时，官煞混杂，若柱丁火制煞留官则吉。亥卯未酉年月，武职极品；不久；行东南方运，大贵。', '三命通会卷八·六乙日申时断'),
('DHC_乙酉_乙酉', '乙酉', '乙酉', '乙', '酉', '酉', '乙酉日乙酉时，旺处自刑，年月火土重，主灾。若通月气，透出印食，行火木运，大贵。地支纯酉，化成金象，但带印绶，贵不可言。最怕岁运遇官。', '三命通会卷八·六乙日酉时断'),
('DHC_乙酉_丙戌', '乙酉', '丙戌', '乙', '酉', '戌', '乙酉日丙戌时，春身旺，冬印旺，大贵。夏巳午，秋酉戌，俱贵。亦看天干如何？丁未、甲辰，生计辛苦；一生遇贵。丑月刑。戌吉。', '三命通会卷八·六乙日戌时断'),
('DHC_乙酉_丁亥', '乙酉', '丁亥', '乙', '酉', '亥', '乙酉日丁亥时，月通金局，行水运，大贵。通木气，发达。土气，称意。', '三命通会卷八·六乙日亥时断'),
('DHC_丙戌_戊子', '丙戌', '戊子', '丙', '戌', '子', '丙戌日戊子时，春生，印绶最吉。夏，身太旺，平常。秋，财旺身衰，有寄托则贵。纯酉年月，文进之贵。忌己亥月，死不全尸；癸丑月，贫夭。活计生涯四季隆，丙逢戊子食官同；无伤晚岁皆成就，吉处遭凶险处通。丙子时逢戊子，官星食福同排。午丁未遇且沉埋，交通中年大快。父母妻子喜合。胸中隐匿文才。若逢好运一时来，富贵清闲自在。', '三命通会卷八·六丙日子时断'),
('DHC_丙戌_己丑', '丙戌', '己丑', '丙', '戌', '丑', '丙戌日己丑时高，武刑后发旺。生亥卯月，火金运，大贵。辰未四库全，火土成局，大富。丙日财官库里藏，戌辰未字显文章；身衰若也无匙钥，求名求利总平常。丙日时逢己丑，伤官财库暗藏。运交未戌不寻常。破出财官必旺。近贵谋夺劫财，算来虽有害。六亲真假少和谐，直断依时莫怪。', '三命通会卷八·六丙日丑时断'),
('DHC_丙戌_庚寅', '丙戌', '庚寅', '丙', '戌', '寅', '丙戌日庚寅时，生亥子月，贵显。申酉年月，行北方运；寅午戌，行官鬼运，俱大贵。若运临死绝，即入黄泉无疑。丙庚相合遇寅时，险难消除福自随；运至寒门名将相，时来平步上云梯。丙日庚寅时准，双亲衰旺离乡。妻儿早害晚荣昌，白虎归山正旺。木有成林松柏，生涯广聚财粮。堆金积玉满高堂，共羡人言上样。”', '三命通会卷八·六丙日寅时断'),
('DHC_丙戌_辛卯', '丙戌', '辛卯', '丙', '戌', '卯', '丙戌日辛卯时，伤妻害子，身旺不化者贵。春，聪明好酒色。冬，行西运，富贵。夏风宪。丙辛化水不相当，有助身强大吉昌；四柱若逢冲克破，劳心劳力过时光。丙日时逢辛卯，贪财坏印难成。财官运步显名声，身弱性情不定。父母六亲难靠，挺身改祖方成。雁行各自望前程，有破如常之命。', '三命通会卷八·六丙日卯时断'),
('DHC_丙戌_壬辰', '丙戌', '壬辰', '丙', '戌', '辰', '丙戌日壬辰时，凶。卯未年月，运行火土，官至三品，妻贤子孝。辰戌丑月，平稳。寅午子巳年月，风宪。丙日壬辰怕见申，再逢阳水定灾屯；柱中若得寅午戌，变凶为吉贵绝伦。丙日壬辰时墓，身衰耗鬼当途。雁行难倚不相扶，妻子何须缘误。君子文章福助，常人恩反成疏。运行官禄任谋图，无破不贵即富。', '三命通会卷八·六丙日辰时断'),
('DHC_丙戌_癸巳', '丙戌', '癸巳', '丙', '戌', '巳', '丙戌日癸巳时，卯戌丑未月，贵，不永。寅亥年月，风宪，嫌冲刑，宜戒酒。丙日时逢癸巳真，号为正贵喜相亲；柱中年月无冲破，必是荣华富贵人。丙日时逢癸巳，正官禄马稀奇。算来妻子早难为，官禄冲克最忌。君子文名出众，常人财禄有余。黄金白玉出沉泥，运至时来偏聚。', '三命通会卷八·六丙日巳时断'),
('DHC_丙戌_甲午', '丙戌', '甲午', '丙', '戌', '午', '丙戌日甲午时，春生吉，夏孤克，秋吉，子少。寅午戌月，富贵超群。神仙宰相。丙日午时少水灾，浑如炎火又添柴；柱中见火刑破，中末荣华不必猜。丙日时逢甲午，柱中劫刃伤官。木衰火旺化为灰。四季提纲方贵。君子亨通出入，常人守祖多灾。六亲骨肉少和谐，作事有成有败。', '三命通会卷八·六丙日午时断'),
('DHC_丙戌_乙未', '丙戌', '乙未', '丙', '戌', '未', '丙戌日乙未时，申子辰年月，近侍贵。寅卯巳年月，大贵。未时丙月生无疑，雁伴随缘各自飞；运气若行东与北，平时衣禄自无亏。丙日时临乙未，运行东北荣华。身强财旺莫咨嗟，显贵高堂大厦。君子封妻荫子，常人定好生涯，堆金积玉实堪垮，富贵骑鞍压马。', '三命通会卷八·六丙日未时断'),
('DHC_丙戌_丙申', '丙戌', '丙申', '丙', '戌', '申', '丙戌日丙申时，柱无壬癸亥子酉字填实，作拱格论，贵。寅戌巳午，身旺无依，僧道。二丙相逢时遇申，无刑无破改门庭；火金销炼多成败，有印方能脱俗伦。丙日时逢申位，比肩阳火迟疑。偏官荣旺是和非，就里妻财恁遂。祖宗盈亏得失，双亲雁侣难依。时来鞍马家道齐，资财虚名薄利。', '三命通会卷八·六丙日申时断'),
('DHC_丙戌_丁酉', '丙戌', '丁酉', '丙', '戌', '酉', '丙戌日丁酉时，月通木气，行水运，贵；通金气，行火运，金马玉堂，才名冠世。露庚藏戊，贫夭。丙火遇酉不相当，太阳日没少辉光；四柱若嫌冲克破，六亲刑害走彷徨。丙日时逢丁酉，天元炎火销金。六亲相守不安宁，阻碍前程难进。日夜思量不足。居官犹自忧贪。若逢巳月改门庭，子午傍人嗔恨。', '三命通会卷八·六丙日酉时断'),
('DHC_丙戌_戊戌', '丙戌', '戊戌', '丙', '戌', '戌', '丙戌日戊戌时贫，若通寅巳午戌火局，福寿双全，大贵。见财亦吉。时上食神局，楼台店舍中；茶房饼酒肆，几度立家风。丙日戌时财库开，少年未遇且沉埋；运通早晚通官爵，设若无官也发财。丙日时逢戊戌，就中仓库兼全。重重福禄自天然，富贵妻贤子羡。君子文章早立，常人财物绵延。天孤父母早淹连，辰戌钥匙开显。', '三命通会卷八·六丙日戌时断'),
('DHC_丙戌_己亥', '丙戌', '己亥', '丙', '戌', '亥', '丙戌日己亥时，寅卯巳午，木生火炎，妻伤子少，聪明富贵；酉亥子丑，平常，东运亦贵。丙日亥时命最高，犹如兰蕙出蓬蒿；四柱若兼冲克破，求名求利却虚劳。丙日时临己亥，若无壬字希奇。命中子少两三妻，就里喜逢天乙。父母雁侣行远，刑空文福难齐。皆因八字有高低，切忌贪财罢职。', '三命通会卷八·六丙日亥时断'),
('DHC_丁亥_庚子', '丁亥', '庚子', '丁', '亥', '子', '丁亥日庚子时，五十后大旺。辰戌丑未月，吉。寅午年月，贵。忌庚寅月，恶死；庚申月，身不全死；辛酉月，破败。庚子时逢日是丁，火落江湖暗复明；四柱若兼冲克破，读书到老只虚名。丁日时逢庚子，日干丁火光辉。火胎金绝有盈亏，妻妾不能全美。有克有刑冲破，就中文福难齐。相生相救贵人提，此命先难后易。', '三命通会卷八·六丁日子时断'),
('DHC_丁亥_辛丑', '丁亥', '辛丑', '丁', '亥', '丑', '丁亥日辛丑时，春印绶，吉，秋生，有火气亦吉，夏太旺，凶。冬官煞旺，吉。未戌月，冲开丑库，富。辛丑遇丁为宝库，柱无匙钥难言富；刑冲运至遇高人，发迹他乡名誉著。丁日时逢辛丑，偏财库喜刑冲。若还不显有虚名。妻子宜尔相庆，父母雁行难睦。家门换改重新，发财发福见中兴。必是荣华之命。', '三命通会卷八·六丁日丑时断'),
('DHC_丁亥_壬寅', '丁亥', '壬寅', '丁', '亥', '寅', '丁亥日壬寅时，日贵格，配合壬寅，官印俱全，文章显达。子月，大贵，化气凶。丁壬合化入金乡，狗禄蝇名空自忙；节概衰残无足取，眼前骨肉亦参商。丁日壬寅时合，化局木旺之乡。月支申酉不相逢，得意高人荐用。父母雁行少力，外人喜笑春风，运逢水木没金踪，贵显荣达之命。', '三命通会卷八·六丁日寅时断'),
('DHC_丁亥_癸卯', '丁亥', '癸卯', '丁', '亥', '卯', '丁亥日癸卯时，卯月，印绶，近侍之贵，寅午，京官五六品。丁丑日逢癸卯生，求名求利且中平；身衰弄巧反成拙，得志须通遇贵人。丁日时临癸卯，身衰无倚平常。门中鬼贼耗财粮，守祖须防破荡。父母雁行少靠，妻子不免离乡。运中身旺煞方降，堪许利名荣畅。', '三命通会卷八·六丁日卯时断'),
('DHC_丁亥_甲辰', '丁亥', '甲辰', '丁', '亥', '辰', '丁亥日甲辰时，日贵格，官禄得位，必当显达。申辰年月，大贵。午月，东北运；辰月，北方运，俱贵。丁日时逢官印同，匙开财库见钱龙；支干四柱无刑破，运至方称富贵翁。丁日辰时库旺，其中印绶相生。匙钥戌开喜壬丁，文秀出群超众。骨肉六亲刑克，果成花谢重荣。只争运迟见钱龙，先暗后明之命。', '三命通会卷八·六丁日辰时断'),
('DHC_丁亥_乙巳', '丁亥', '乙巳', '丁', '亥', '巳', '丁亥日乙巳时，时日并冲，忧伤妻子。巳酉丑申子辰，金水二局，财官得用，以富贵论。丁日巳时怕虎刑，财官运步始能通；好意人情反恶意，先难后易乐从容。丁日时临乙巳，破财倒食难通。双亲雁侣且和平，妻子无嗔无闷。君子文学秀气，常人财艺通明。壬庚辛癸若重逢，中末财名足用。', '三命通会卷八·六丁日巳时断'),
('DHC_丁亥_丙午', '丁亥', '丙午', '丁', '亥', '午', '丁亥日丙午时平，子月，金水运，郎官。未申酉丑年月，俱吉。午时丁日禄元局，不见官星压众曹；四柱无刑行运吉，青云有路步丹霄。丁日时逢丙午，互换禄马光辉。功名煊赫世应希，习学文章主贵。年月无癸子卯，时来文福班齐。布衣换得锦衣归，风送云程万里。', '三命通会卷八·六丁日午时断'),
('DHC_丁亥_丁未', '丁亥', '丁未', '丁', '亥', '未', '丁亥日丁未时，卯月，三合印局，贵而有寿，申，财官旺；亥，官旺，俱吉，夏生，丁火有气，儒官，但不免孤贫。二丁相遇未时排，险路中年发福来；运吉贵人相会合，安闲衣禄不须猜。丁日时逢丁未，其中仓库沉埋。少年难发等时来，丑未相冲通泰。不靠双亲雁侣，花开收果妻财。时逢寿足福重来，末遇荣华堪快。', '三命通会卷八·六丁日未时断'),
('DHC_丁亥_戊申', '丁亥', '戊申', '丁', '亥', '申', '丁亥日戊申时，日时相害，忧伤妻子。通月气身旺者，贵显。年月戊戌、丁巳，火土太重者目疾。丁日戊申时为正，天元气旺显文明；为官虽是甘淡薄，运吉终须家道成；', '三命通会卷八·六丁日申时断'),
('DHC_丁亥_己酉', '丁亥', '己酉', '丁', '亥', '酉', '丁亥日己酉时，蹇滞。如戊己丙丁年月，居近侍有权。卯甲乙寅，西北运，贵。丁日酉时终见贵，偏财食遇禄无归；干支生旺凶中吉，冲破财星隐祸机。丁日时临己酉，食神旺相生财。清闲福禄自然来，一世为人响快。君子宽洪海量，常人四海情怀。财官双美象中排，一路滔滔无碍。', '三命通会卷八·六丁日酉时断'),
('DHC_丁亥_庚戌', '丁亥', '庚戌', '丁', '亥', '戌', '丁亥日庚戌时，日贵格。巳酉丑年月，四五品贵。寅卯亥，火金运，位至六卿。丁日时逢戌刻真，锁钥无匙库闭门；父母兄弟难依靠，立成家计自殷勤。丁日时逢庚戌，火金刑害夭孤。丑辰不遇钥匙无，库闭财能收贮。就合托妻随住，六亲骨肉消疏。晚年发福改门闾，此命后甜先苦。', '三命通会卷八·六丁日戌时断'),
('DHC_丁亥_辛亥', '丁亥', '辛亥', '丁', '亥', '亥', '丁亥日辛亥时，日贵格，又三奇全，通月气身旺者贵。卯未三合印局，大贵。天元丁日亥时富，平步青云路正长；得意退毛鸡化凤，鹏程万里任翱翔。丁日时临辛亥，天元禄马同乡。官居进士挂朝裳，必是寒门将相。定主妻贤子孝，威仪权柄难量。骤升台省与京堂，固是财官生旺。', '三命通会卷八·六丁日亥时断'),
('DHC_戊子_壬子', '戊子', '壬子', '戊', '子', '子', '戊子日壬子时，财星格。寅卯月，禄马朝元，显贵。酉亥丑年月，西北运，金紫风宪。忌乙卯年刑；癸巳月，旺中刑；丙午月，旺中受刑。', '三命通会卷八·六戊日子时断'),
('DHC_戊子_癸丑', '戊子', '癸丑', '戊', '子', '丑', '戊子日癸丑时，戊月生，杂气印绶，天干透丙丁字，不必格局，主富贵。若年月午酉，干透庚乙，乙与庚合，戊与癸合，戊食庚，庚旺于酉，贵于丑，癸为财，乙为官，而印根于午，日时干支为天地合德，贵禄交加，况兼以罗文贵，遇者主极品。', '三命通会卷八·六戊日丑时断'),
('DHC_戊子_甲寅', '戊子', '甲寅', '戊', '子', '寅', '戊子日甲寅时，先破后发，贵。未月生，干有制伏，贵。午月无制，聪明近贵。辰戌丑身旺，亥卯煞旺，但有印有制，贵。纯乙丑年月，金紫。', '三命通会卷八·六戊日寅时断'),
('DHC_戊子_乙卯', '戊子', '乙卯', '戊', '子', '卯', '戊子日乙卯时，时日相刑，伤妻害子，自成自立。年月再遇，主风宪。午酉，四正全，大贵。', '三命通会卷八·六戊日卯时断'),
('DHC_戊子_丙辰', '戊子', '丙辰', '戊', '子', '辰', '戊子日丙辰时，春生近贵。夏辛苦。秋，权高寿促。冬财，通火土，有倚托者贵。', '三命通会卷八·六戊日辰时断'),
('DHC_戊子_丁巳', '戊子', '丁巳', '戊', '子', '巳', '戊子日丁巳时，贵。子月正财，土厚地方，显达。亥丑年月，官居极品，内臣中，富贵双全。', '三命通会卷八·六戊日巳时断'),
('DHC_戊子_戊午', '戊子', '戊午', '戊', '子', '午', '戊子日戊午时，巳寅戌月，风宪。夏不熔铸，先刑后发，旺处多官。灾破祖。', '三命通会卷八·六戊日午时断'),
('DHC_戊子_己未', '戊子', '己未', '戊', '子', '未', '戊子日己未时，时日相穿，忧伤妻子，早苦晚好。月通土气，行财官运，贵；水木月，行身旺运，贵。', '三命通会卷八·六戊日未时断'),
('DHC_戊子_庚申', '戊子', '庚申', '戊', '子', '申', '戊子日庚申时，若生亥子月，亦是合禄，贵。', '三命通会卷八·六戊日申时断'),
('DHC_戊子_辛酉', '戊子', '辛酉', '戊', '子', '酉', '戊子日辛酉时，巳酉丑月，伤官伤尽，行财旺运，武职风宪。', '三命通会卷八·六戊日酉时断'),
('DHC_戊子_壬戌', '戊子', '壬戌', '戊', '子', '戌', '戊子日壬戌时，酉申戌月，家财满目。辰、丑冲刑库开，俱吉。', '三命通会卷八·六戊日戌时断'),
('DHC_戊子_癸亥', '戊子', '癸亥', '戊', '子', '亥', '戊子日癸亥时，年月不见戊字破格，贵。申子年月，东南运；亥卯，南运，俱贵。巳午未旺，大贵。', '三命通会卷八·六戊日亥时断'),
('DHC_己丑_甲子', '己丑', '甲子', '己', '丑', '子', '己丑日甲子时，化贵，午寅年月，夭折；通土气月，贵。忌甲寅月，贵中恶死。丁未月受刑，丁丑月破祖，失乡恶死。', '三命通会卷八·六己日子时断'),
('DHC_己丑_乙丑', '己丑', '乙丑', '己', '丑', '丑', '己丑日乙丑时，时上偏官，居武职都阃，还看地方断之。卯月金水运，六七品贵。', '三命通会卷八·六己日丑时断'),
('DHC_己丑_丙寅', '己丑', '丙寅', '己', '丑', '寅', '己丑日丙寅时，春官旺，夏印旺，秋既济，冬平。辰戌年月，文贵显达。纯丑，寿高。戌月，木火运，五、六品贵。', '三命通会卷八·六己日寅时断'),
('DHC_己丑_丁卯', '己丑', '丁卯', '己', '丑', '卯', '己丑日丁卯时，申子辰，武职。亥卯未，荣富。巳酉丑，行东北运，吉。', '三命通会卷八·六己日卯时断'),
('DHC_己丑_戊辰', '己丑', '戊辰', '己', '丑', '辰', '己丑日戊辰时，身孤。寅卯月，禄旺。辰月透甲，作化气看，贵。午，富厚。寅酉，风宪。年月子丑透甲，行东南运，金紫，近侍；怕西北运，退职。', '三命通会卷八·六己日辰时断'),
('DHC_己丑_己巳', '己丑', '己巳', '己', '丑', '巳', '己丑日己巳时，辰月，西北运，贵。午未火旺，大贵。申子戌巳，亦吉。', '三命通会卷八·六己日巳时断'),
('DHC_己丑_庚午', '己丑', '庚午', '己', '丑', '午', '己丑日庚午时，寅月生，贵；夏凶；秋暴；冬，财旺子少。', '三命通会卷八·六己日午时断'),
('DHC_己丑_辛未', '己丑', '辛未', '己', '丑', '未', '己丑日辛未时，不贵即富。通土气月，富。通木气月，贵。一云刑，凶。', '三命通会卷八·六己日未时断'),
('DHC_己丑_壬申', '己丑', '壬申', '己', '丑', '申', '己丑日壬申时，酉年月，天干透印，富贵好礼，为人慨慷。辰戌吉。亥年，乾清坤夷大格。寅申，官贵相辅，俱吉。', '三命通会卷八·六己日申时断'),
('DHC_己丑_癸酉', '己丑', '癸酉', '己', '丑', '酉', '己丑日癸酉时，春平；夏稳；秋伤官伤尽，有威权；冬富。如丙寅巳月，金神遇火，贵。丑月，金水运，郎官。透乙，大贵。', '三命通会卷八·六己日酉时断'),
('DHC_己丑_甲戌', '己丑', '甲戌', '己', '丑', '戌', '己丑日甲戌时，克父太旺。辰月生，土厚。居巳午未申，临官、帝旺，吉。亥戌寅卯，土病死，凶。酉辰，三、四品，贵，中年退闲。亥木火运，六、七品，贵。', '三命通会卷八·六己日戌时断'),
('DHC_己丑_乙亥', '己丑', '乙亥', '己', '丑', '亥', '己丑日乙亥时，巳酉丑月，制煞留官，贵。午月，身旺，亦贵。子月、火运、七、八品，贵。卯未，透辛制乙，大贵。', '三命通会卷八·六己日亥时断'),
('DHC_庚寅_丙子', '庚寅', '丙子', '庚', '寅', '子', '庚寅日丙子时，春生，带财带煞，行金水运，金紫。夏，煞旺，大贵。秋，身旺，须行南运，贵。冬，身鬼俱弱，平常。纯午年月，位至公卿。壬子，食前煞后随；一阳生后，丙火有气，贵极人臣。忌癸酉月，破败，凶。辛亥月，血光。甲子月，夭。', '三命通会卷八·六庚日子时断'),
('DHC_庚寅_丁丑', '庚寅', '丁丑', '庚', '寅', '丑', '庚寅日丁丑时，魁元。寅卯午未亥月，清秀高命。行午、未运，贵显。通火土年月，贵。', '三命通会卷八·六庚日丑时断'),
('DHC_庚寅_戊寅', '庚寅', '戊寅', '庚', '寅', '寅', '庚寅日戊寅时，月通火局或秋生，行身旺运，贵。庚子月，自死。年见辛酉，贫夭残疾。身衰见丙太旺，同论。', '三命通会卷八·六庚日寅时断'),
('DHC_庚寅_己卯', '庚寅', '己卯', '庚', '寅', '卯', '庚寅日己卯时，亥卯月，财星格，早荣早退。午戌，三合官局，干透金水，行西北运，吉。', '三命通会卷八·六庚日卯时断'),
('DHC_庚寅_庚辰', '庚寅', '庚辰', '庚', '寅', '辰', '庚寅日庚辰时，龙虎拱门。年月通火土者，贵。纯庚辰，王侯；不然，极凶。若年月遇木火，运再行，极品。', '三命通会卷八·六庚日辰时断'),
('DHC_庚寅_辛巳', '庚寅', '辛巳', '庚', '寅', '巳', '庚寅日辛巳时，巳酉丑月，身旺，贵。煞旺身弱月，贫。纯申年月，大贵悠久。亥月，东南运、主有权贵。', '三命通会卷八·六庚日巳时断'),
('DHC_庚寅_壬午', '庚寅', '壬午', '庚', '寅', '午', '庚寅日壬午时，辰戌丑未巳申酉月，身旺，俱贵。寅午，火旺，运气再遇，寿促；不然，残疾。', '三命通会卷八·六庚日午时断'),
