INSERT INTO `auspice_clause` (clause_id, clause_group, subject, clause_text, source_note) VALUES
('AC_StemSeat_JiaYi', '十干坐支', '甲乙日坐支得月时吉凶', '甲木属阳，乃栋梁之材，喜生秋冬、遇申子月为吉，柱见庚辛譬斧凿之论主名利；乙木属阴，为生气之木，喜春生，逢亥卯未、申子辰二局更行北运。诀曰：甲乙贵乎木得宜，要知金水旺为奇，春从南往秋归北，冬夏西行发福基。', '三命通会卷四·论十干坐支兼得月时及行运吉凶（△甲乙）'),
('AC_StemSeat_BingDing', '十干坐支', '丙丁日坐支得月时吉凶', '丙火属阳，乃太阳之正气，喜生春夏，忌戊土透露；丁火属阴，为凡火，喜生夜间、巳酉丑月令为妙，忌壬癸水。诀曰：丙丁日主火为根，金水二星是福源，行运若临西与北，纵然富贵不周全。', '三命通会卷四·论十干坐支兼得月时及行运吉凶（△丙丁）'),
('AC_StemSeat_WuJi', '十干坐支', '戊己日坐支得月时吉凶', '戊土属阳，乃堤岸城墙之土，喜甲乙木以煞化印之地，要火生扶、嫌水克制；己土属阴，为田地山园之土，喜生春夏辰巳之乡。诀曰：戊己日干寻水木，柱中原有还为福，运临北野及东方，德润身兮富润屋。', '三命通会卷四·论十干坐支兼得月时及行运吉凶（△戊己）'),
('AC_StemSeat_GengXin', '十干坐支', '庚辛日坐支得月时吉凶', '庚金属阳，乃金银铜铁，要见丁火制之方能成器，喜行东南火木之运；辛金属阴，乃水银朱砂珍珠之类，最要金清水秀、土气丰厚，忌见丁火。诀曰：庚辛日主号金干，木火相生福自专，年月时中如会合，东西运步定居官。', '三命通会卷四·论十干坐支兼得月时及行运吉凶（△庚辛）'),
('AC_StemSeat_RenGui', '十干坐支', '壬癸日坐支得月时吉凶', '壬水属阳，乃甘泽长流之水，独喜春夏生人；癸水属阴，乃大海无涯之水（一云雨露润泽之水），喜春秋间、运行巳午戌地。诀曰：壬癸日生水为主，根基惟在火与土，春秋来往发财官，冬夏东行为得所。', '三命通会卷四·论十干坐支兼得月时及行运吉凶（△壬癸）'),
('AC_MonthStem_Zi', '十二月支', '子月得日干吉凶', '甲乙日得子月为印绶，喜见官露印，忌坐天财、伤印；丙丁日为官，贵，阴阳和合，喜露财官；戊己日为财，喜露财身旺，忌坐刃透比；庚辛日为长生财，喜坐露财身旺，忌无财身弱；壬癸日壬为旺、癸为建禄，颇宜时带偏官。', '三命通会卷四·论十二月支得日干吉凶（△子月）'),
('AC_MonthStem_Chou', '十二月支', '丑月得日干吉凶', '甲乙日得丑月为杂气官，贵，喜官星透干，不透要冲；丙丁日为杂气财，喜财透干，忌羊刃比肩；戊己日为余气财，月初小寒后七日半生有癸水余气方贵；庚辛日为自库之月，只得身强、少病、多安、寿考；壬癸日为杂气财，贵，喜透印见官及刑冲。', '三命通会卷四·论十二月支得日干吉凶（△丑月）'),
('AC_MonthStem_Yin', '十二月支', '寅月得日干吉凶', '甲日得寅建禄、乙日旺相，月令无格可取，只利身旺年久，宜带时偏官；丙丁日为印，贵，喜坐官露官、再露印星，忌露财；戊日为偏官、己日为正官，贵，喜身旺、露财官；庚辛日为财，喜财多露身旺，忌坐刃透比；壬癸日为长生财，喜财透干，忌伏藏。', '三命通会卷四·论十二月支得日干吉凶（△寅月）'),
('AC_MonthStem_Mao', '十二月支', '卯月得日干吉凶', '甲日得卯旺相、乙日得卯建禄，宜带时上偏官；丙丁日为印，喜露官印二星；戊日为正官、己日为偏官，喜身旺有合；庚辛日为财，喜透自旺，忌坐劫露比；壬癸日为长生财，喜坐露财，带偏官者喜合偏官。', '三命通会卷四·论十二月支得日干吉凶（△卯月）'),
('AC_MonthStem_Chen', '十二月支', '辰月得日干吉凶', '甲乙日生辰月为杂气印，喜见官星及印露，忌财多伤印；丙丁日为杂气官，喜官透，不透要冲；戊己日为杂气财，喜财露旺；庚辛日为余气财，贵，清明后七日半有乙木余气方可发；壬癸日为自库，只是身强少疾，宜时上偏官。', '三命通会卷四·论十二月支得日干吉凶（△辰月）'),
('AC_MonthStem_Si', '十二月支', '巳月得日干吉凶', '甲乙日得巳月为财（亦名长生财），贵，戊土露则财星愈光、丙火露则伤神益壮；丙日建禄、丁旺相，宜时带偏官；戊己日为卯（建禄），露丙火为印；庚日为偏官、辛日为正官，贵；壬日为偏官、癸日为正官，喜身旺及官印之地。', '三命通会卷四·论十二月支得日干吉凶（△巳月）'),
('AC_MonthStem_Wu', '十二月支', '午月得日干吉凶', '甲乙日得午月为财（长生财），贵，己土露则财愈显、丁火露则伤益壮；丙月旺相、丁日建禄；戊己日为印（亦为建禄），露丁为印；庚日正官、辛日偏官，喜身旺合制；壬日正官正财、癸日为偏官，喜身旺，忌七煞伤官。', '三命通会卷四·论十二月支得日干吉凶（△午月）'),
('AC_MonthStem_Wei', '十二月支', '未月得日干吉凶', '甲乙日见未为自库月，主身强少病，宜时偏官；丙丁日为杂气印，喜官及印露，忌印伏无冲与财运；戊己日为杂气官，贵，喜身旺与财及官透；庚辛日为杂气财，喜身强财透旺；壬癸日为余气财，小暑七日后生则为长生财、禄马同乡，贵。', '三命通会卷四·论十二月支得日干吉凶（△未月）'),
('AC_MonthStem_Shen', '十二月支', '申月得日干吉凶', '甲日申月为偏官，喜身旺合制；乙日申月为正官；丙丁日为财官（丙见壬七煞、丁见壬正官）；戊己日为长生财，喜财露；庚日建禄、辛旺相，宜时带偏官；壬癸日为印，喜露官透印，忌财。', '三命通会卷四·论十二月支得日干吉凶（△申月）'),
('AC_MonthStem_You', '十二月支', '酉月得日干吉凶', '甲日酉月为正官、乙日得酉月为偏官，喜身旺露官见财；丙丁日为财，喜身旺露财官，忌刑冲破害；戊己日为长生财；庚日旺相、辛日建禄，宜时带偏官；壬癸日为印，喜露官透印，忌财。', '三命通会卷四·论十二月支得日干吉凶（△酉月）'),
('AC_MonthStem_Xu', '十二月支', '戌月得日干吉凶', '甲乙日戌月为杂气财，喜生旺财透；丙丁日为自库月，主身旺年长，宜时带诸贵格；戊己日为杂气印，喜正官印透，忌印伏无冲、有财伤印；庚辛日为杂气官，贵，要身旺印全；壬癸日为杂气财，要身旺、财官双全为贵。', '三命通会卷四·论十二月支得日干吉凶（△戌月）'),
('AC_MonthStem_Hai', '十二月支', '亥月得日干吉凶', '甲乙日得亥月为印，喜露官透印为福，忌财；丙日为偏官、丁日为正官，喜身旺、透财露官；庚辛日为长生之财；壬癸日壬为建禄、癸为旺相，宜时带偏官及日时诸贵格。', '三命通会卷四·论十二月支得日干吉凶（△亥月）'),
('AC_TimePlace_Zonglun', '五行时地', '时地分野总论', '按王氏所谓：二气者阴阳也，五行者金木水火土也，时者春夏秋冬也，地者冀青兖徐扬荆梁雍豫也。天有阴阳行于四时，地有五行具于九州。甲乙寅卯属木生于兖青为得地、春令为得时；丙丁巳午属火生于徐扬、夏令；戊己辰戌丑未属土生于豫州、四季月；庚辛申酉属金生于荆梁、秋冬；壬癸亥子属水生于冀雍、冬令。', '三命通会卷四·论五行时地分野吉凶（总论）'),
('AC_TimePlace_Mu', '五行时地', '论木·时地吉凶', '正春木：正月生者见火则生意蔼然、富贵无敌，有土无火仅足衣资，冀雍生者贫寒；二月之木遇土培植为佳、火土同行富贵而寿；三月之木见土则根深蒂固、见火则文章秀发，喜火土、忌金水；夏木（五六月）喜雨水夜生，得土培根得水达枝；秋木惟欲晴雨得宜，见金反吉；冬木（八九月正凋零）得土栽培根基稳厚。', '三命通会卷四·论五行时地分野吉凶（○论木）'),
('AC_TimePlace_Huo', '五行时地', '论火·时地吉凶', '三春之火：正月微阳之火遇木生则阳气发挥、逢金为财，徐扬人富而好礼；二月见木败处逢生、木秀火明，文章富贵人；夏令之火得水制之则都将相，惟冀雍生人水不宜盛；秋初之火见土则息、显达非常；冬月之火见水为凶、木生为贵，大抵冬火喜木、忌水。', '三命通会卷四·论五行时地分野吉凶（○论火）'),
('AC_TimePlace_Tu', '五行时地', '论土·时地吉凶', '春令之土一接阳气就能发育万物；正月之土尚有霜寒，惟得火以温之则荣华莫比、逢金制木亦名利两成；三月之土渐有生意，见木非疾则夭、见金制木反凶成吉；土旺长夏见水为吉、遇火为凶；秋令之土见火助之文武名高；冬月之土惟喜火以温之，子丑之月寒气之极、火日融和功名成就。', '三命通会卷四·论五行时地分野吉凶（○论土）'),
('AC_TimePlace_Jin', '五行时地', '论金·时地吉凶', '正月之金见木为财，见火遇土富贵非常、逢水泄之孤寒懦弱；二三月之金见土则生、主人富贵而寿；夏月火盛金至柔也，夏令之金俱宜见土，主人有出将入相之权；七八月之金得令其性刚强，仗火以制其威则有玉带金鱼之贵；冬月之金得火融之然后可以夺其寒气则富贵非常。', '三命通会卷四·论五行时地分野吉凶（○论金）'),
('AC_TimePlace_Shui', '五行时地', '论水·时地吉凶', '春月之水晴则春水溶溶、雨则汪洋泛滥；正月生者见火则冰融冻释、富贵雍容；二三月之水见土则有堤防；夏水失令逢火则干涸、忌晴喜雨，得土止而不流则福气深厚；五六月之水正能滋助万物、喜土同行；秋令正水清秀之时；冬月之水俱喜火以温之则富贵无虞。', '三命通会卷四·论五行时地分野吉凶（○论水）'),
('AC_Progeny_GuaFa', '孕生男女', '定妇人孕生男女·卦法', '诀曰：父母岁数两头安，受胎之月中心取；乾坎艮震为男儿，巽离坤兑总属女。假父母年双为折、受胎月只为单，成坎卦定男；父母年只为单、受胎月双为拆，成离卦定女。父年上、母年下、胎月中，余准此推。', '三命通会卷七·定妇人孕生男女'),
('AC_Progeny_DaYanFa', '孕生男女', '定妇人孕生男女·大衍法', '又一法以「大衍之数」推之，诀曰：七七四十九，问娘何月有；除却母生年，单奇双是偶；奇偶若不常，寿命不长久。假先下四十九数于算盘，乃加上母受胎月数，总得若干数；单则男、双则女。若单生女、双生男，主夭折。', '三命通会卷七·定妇人孕生男女');

