[PrefixDeclaration]
:        http://example.org/sizhubazi/
core:    http://example.org/sizhubazi/core/
calendar: http://example.org/sizhubazi/calendar/
deity:   http://example.org/sizhubazi/deity/
tengod:  http://example.org/sizhubazi/tengod/
reading: http://example.org/sizhubazi/reading/
yongshen: http://example.org/sizhubazi/yongshen/
pattern: http://example.org/sizhubazi/pattern/
fortune: http://example.org/sizhubazi/fortune/
rules:   http://example.org/sizhubazi/rules/
rdf:     http://www.w3.org/1999/02/22-rdf-syntax-ns#
rdfs:    http://www.w3.org/2000/01/rdf-schema#
owl:     http://www.w3.org/2002/07/owl#
xsd:     http://www.w3.org/2001/XMLSchema#

[MappingDeclaration] @collection [[

mappingId    ganzhi_stem
target       core:{name} a core:HeavenlyStem ;
                 rdfs:label "{label}"@zh ;
                 core:stemName "{stem_name}"^^xsd:string ;
                 core:stemYinYang "{stem_yinyang}"^^xsd:string ;
                 core:hasYinYang core:{yinyang} ;
                 core:hasFivePhase core:{five_phase} .
source       SELECT name,
                 COALESCE(stem_name, '') AS stem_name,
                 COALESCE(stem_yinyang, '') AS stem_yinyang,
                 COALESCE(yinyang, '') AS yinyang,
                 COALESCE(five_phase, '') AS five_phase,
                 COALESCE(label, '') AS label
             FROM ganzhi_stem
             WHERE name IS NOT NULL
               AND yinyang IS NOT NULL AND yinyang <> ''
               AND five_phase IS NOT NULL AND five_phase <> ''

mappingId    ganzhi_branch
target       core:{name} a core:EarthlyBranch ;
                 rdfs:label "{label}"@zh ;
                 core:branchName "{branch_name}"^^xsd:string ;
                 core:branchAnimal "{branch_animal}"^^xsd:string ;
                 core:branchOrder "{branch_order}"^^xsd:integer ;
                 core:hasFivePhase core:{five_phase} .
source       SELECT name,
                 COALESCE(branch_name, '') AS branch_name,
                 COALESCE(branch_animal, '') AS branch_animal,
                 COALESCE(branch_order, 0) AS branch_order,
                 COALESCE(five_phase, '') AS five_phase,
                 COALESCE(label, '') AS label
             FROM ganzhi_branch
             WHERE name IS NOT NULL
               AND five_phase IS NOT NULL AND five_phase <> ''

mappingId    sexagenary_cycle
target       core:{name} a core:SexagenaryCycle ;
                 rdfs:label "{ganzhi}"@zh ;
                 core:hasStem core:{stem_local} ;
                 core:hasBranch core:{branch_local} ;
                 core:hasNaYin core:{nayin_local} .
source       SELECT name,
                 COALESCE(ganzhi, '') AS ganzhi,
                 COALESCE(stem_local, '') AS stem_local,
                 COALESCE(branch_local, '') AS branch_local,
                 COALESCE(nayin_local, '') AS nayin_local
             FROM sexagenary_cycle
             WHERE name IS NOT NULL
               AND stem_local IS NOT NULL AND stem_local <> ''
               AND branch_local IS NOT NULL AND branch_local <> ''
               AND nayin_local IS NOT NULL AND nayin_local <> ''

mappingId    nayin
target       core:{name} a core:NaYin ;
                 rdfs:label "{label}"@zh ;
                 core:naYinName "{nayin_name}"^^xsd:string ;
                 core:naYinNature "{nayin_nature}"^^xsd:string ;
                 core:hasFivePhase core:{five_phase} .
source       SELECT name,
                 COALESCE(nayin_name, '') AS nayin_name,
                 COALESCE(nayin_nature, '') AS nayin_nature,
                 COALESCE(five_phase, '') AS five_phase,
                 COALESCE(label, '') AS label
             FROM nayin
             WHERE name IS NOT NULL
               AND five_phase IS NOT NULL AND five_phase <> ''

mappingId    hidden_stem
target       core:{name} a core:HiddenStem ;
                 rdfs:label "{label}"@zh ;
                 core:hiddenStemRole "{role}"^^xsd:string .
source       SELECT name,
                 COALESCE(role, '') AS role,
                 COALESCE(label, '') AS label
             FROM hidden_stem
             WHERE name IS NOT NULL

mappingId    hidden_stem_of_branch
target       core:{branch_local} core:hasHiddenStem core:{name} .
source       SELECT branch_local,
                 name
             FROM hidden_stem
             WHERE name IS NOT NULL
               AND branch_local IS NOT NULL AND branch_local <> ''

mappingId    solar_term
target       calendar:{name} a calendar:SolarTerm ;
                 rdfs:label "{label}"@zh ;
                 calendar:solarTermName "{solar_term_name}"^^xsd:string .
source       SELECT name,
                 COALESCE(solar_term_name, '') AS solar_term_name,
                 COALESCE(label, '') AS label
             FROM solar_term
             WHERE name IS NOT NULL

mappingId    solar_term_time
target       calendar:{name} a calendar:SolarTermInstant ;
                 rdfs:label "{term_name}"@zh ;
                 calendar:termYear "{term_year}"^^xsd:int ;
                 calendar:termIndex "{term_idx}"^^xsd:int ;
                 calendar:termDatetime "{term_datetime}"^^xsd:dateTime ;
                 calendar:instantOf calendar:{term_local} .
source       SELECT name,
                 COALESCE(term_year, 0) AS term_year,
                 COALESCE(term_idx, 0) AS term_idx,
                 COALESCE(term_local, '') AS term_local,
                 COALESCE(term_name, '') AS term_name,
                 COALESCE(term_datetime, NULL) AS term_datetime
             FROM solar_term_time
             WHERE name IS NOT NULL

mappingId    month_order
target       calendar:{name} a calendar:MonthOrder ;
                 rdfs:label "{label}"@zh ;
                 calendar:monthOrderName "{month_order_name}"^^xsd:string .
source       SELECT name,
                 COALESCE(month_order_name, '') AS month_order_name,
                 COALESCE(label, '') AS label
             FROM month_order
             WHERE name IS NOT NULL

mappingId    case_record
target       reading:CaseRecord_{case_id} a reading:CaseRecord ;
                 reading:caseBirthData "{birth_data}"^^xsd:string ;
                 reading:caseResult "{reading_text}"^^xsd:string .
source       SELECT case_id,
                 COALESCE(birth_data, '') AS birth_data,
                 COALESCE(reading, '') AS reading_text
             FROM case_record
             WHERE case_id IS NOT NULL

mappingId    alert_flag
target       rules:AlertRecord_{flag_id} a rules:AlertFlag ;
                 rules:alertType "{alert_type}"^^xsd:string ;
                 rules:alertTriggered "{alert_triggered}"^^xsd:boolean .
source       SELECT flag_id,
                 COALESCE(alert_type, '') AS alert_type,
                 COALESCE(alert_triggered, 0) AS alert_triggered
             FROM alert_flag
             WHERE flag_id IS NOT NULL

mappingId    day_hour_clause
target       reading:{clause_id} a reading:DayHourClause ;
                 rdfs:label "{day_pillar}日{hour_pillar}时断"@zh ;
                 reading:clauseDayPillar "{day_pillar}"^^xsd:string ;
                 reading:clauseHourPillar "{hour_pillar}"^^xsd:string ;
                 reading:readingText "{clause_text}"^^xsd:string ;
                 reading:clauseSource "{source_note}"^^xsd:string .
source       SELECT clause_id,
                 COALESCE(day_pillar, '') AS day_pillar,
                 COALESCE(hour_pillar, '') AS hour_pillar,
                 COALESCE(clause_text, '') AS clause_text,
                 COALESCE(source_note, '') AS source_note
             FROM day_hour_clause
             WHERE clause_id IS NOT NULL

mappingId    tiaohou_clause
target       yongshen:{clause_id} a yongshen:TiaohouClause ;
                 rdfs:label "{month_branch}月{day_stem}调候"@zh ;
                 yongshen:tiaohouMonthBranch "{month_branch}"^^xsd:string ;
                 yongshen:tiaohouPrimaryUse "{primary_use}"^^xsd:string ;
                 yongshen:tiaohouSecondaryUse "{secondary_use}"^^xsd:string ;
                 yongshen:tiaohouText "{clause_text}"^^xsd:string ;
                 yongshen:clauseSource "{source_note}"^^xsd:string .
source       SELECT clause_id,
                 COALESCE(day_stem, '') AS day_stem,
                 COALESCE(month_branch, '') AS month_branch,
                 COALESCE(primary_use, '') AS primary_use,
                 COALESCE(secondary_use, '') AS secondary_use,
                 COALESCE(clause_text, '') AS clause_text,
                 COALESCE(source_note, '') AS source_note
             FROM tiaohou_clause
             WHERE clause_id IS NOT NULL

mappingId    pattern_catalog
target       pattern:{pattern_id} a pattern:Pattern ;
                 rdfs:label "{label}"@zh ;
                 pattern:patternName "{pattern_name}"^^xsd:string ;
                 pattern:patternClass "{pattern_class}"^^xsd:string ;
                 pattern:patternSource "{source_note}"^^xsd:string ;
                 pattern:patternMeaning "{meaning}"^^xsd:string .
source       SELECT pattern_id,
                 COALESCE(pattern_name, '') AS pattern_name,
                 COALESCE(pattern_class, '') AS pattern_class,
                 COALESCE(source_note, '') AS source_note,
                 COALESCE(meaning, '') AS meaning,
                 COALESCE(label, '') AS label
             FROM pattern_catalog
             WHERE pattern_id IS NOT NULL

mappingId    lady_fortune_catalog
target       reading:{lady_id} a reading:LadyFortune ;
                 rdfs:label "{lady_name}"@zh ;
                 reading:readingCategory "{category}"^^xsd:string ;
                 reading:readingSource "{source_note}"^^xsd:string ;
                 reading:readingText "{meaning}"^^xsd:string .
source       SELECT lady_id,
                 COALESCE(lady_name, '') AS lady_name,
                 COALESCE(category, '') AS category,
                 COALESCE(source_note, '') AS source_note,
                 COALESCE(meaning, '') AS meaning
             FROM lady_fortune_catalog
             WHERE lady_id IS NOT NULL

mappingId    technique_catalog
target       reading:{tech_id} a reading:ReadingItem ;
                 rdfs:label "{tech_name}"@zh ;
                 reading:readingCategory "{category}"^^xsd:string ;
                 reading:readingSource "{source_note}"^^xsd:string ;
                 reading:readingText "{meaning}"^^xsd:string .
source       SELECT tech_id,
                 COALESCE(tech_name, '') AS tech_name,
                 COALESCE(category, '') AS category,
                 COALESCE(source_note, '') AS source_note,
                 COALESCE(meaning, '') AS meaning
             FROM technique_catalog
             WHERE tech_id IS NOT NULL

mappingId    sexagenary_nature
target       core:{name} core:sexagenaryNatureText "{nature_text}"^^xsd:string .
source       SELECT name,
                 COALESCE(nature_text, '') AS nature_text
             FROM sexagenary_nature
             WHERE name IS NOT NULL
                AND nature_text IS NOT NULL AND nature_text <> ''

mappingId    auspice_stem_seat
target       reading:{clause_id} a reading:StemBranchAuspice ;
                 rdfs:label "{subject}"@zh ;
                 reading:readingCategory "{clause_group}"^^xsd:string ;
                 reading:readingSource "{source_note}"^^xsd:string ;
                 reading:readingText "{clause_text}"^^xsd:string .
source       SELECT clause_id,
                 COALESCE(subject, '') AS subject,
                 COALESCE(clause_group, '') AS clause_group,
                 COALESCE(source_note, '') AS source_note,
                 COALESCE(clause_text, '') AS clause_text
             FROM auspice_clause
             WHERE clause_group = '十干坐支'

mappingId    auspice_month_branch
target       reading:{clause_id} a reading:MonthBranchDayStemAuspice ;
                 rdfs:label "{subject}"@zh ;
                 reading:readingCategory "{clause_group}"^^xsd:string ;
                 reading:readingSource "{source_note}"^^xsd:string ;
                 reading:readingText "{clause_text}"^^xsd:string .
source       SELECT clause_id,
                 COALESCE(subject, '') AS subject,
                 COALESCE(clause_group, '') AS clause_group,
                 COALESCE(source_note, '') AS source_note,
                 COALESCE(clause_text, '') AS clause_text
             FROM auspice_clause
             WHERE clause_group = '十二月支'

mappingId    auspice_time_place
target       reading:{clause_id} a reading:TimePlaceFortune ;
                 rdfs:label "{subject}"@zh ;
                 reading:readingCategory "{clause_group}"^^xsd:string ;
                 reading:readingSource "{source_note}"^^xsd:string ;
                 reading:readingText "{clause_text}"^^xsd:string .
source       SELECT clause_id,
                 COALESCE(subject, '') AS subject,
                 COALESCE(clause_group, '') AS clause_group,
                 COALESCE(source_note, '') AS source_note,
                 COALESCE(clause_text, '') AS clause_text
             FROM auspice_clause
             WHERE clause_group = '五行时地'

mappingId    auspice_progeny
target       reading:{clause_id} a reading:ProgenyPrediction ;
                 rdfs:label "{subject}"@zh ;
                 reading:readingCategory "{clause_group}"^^xsd:string ;
                 reading:readingSource "{source_note}"^^xsd:string ;
                 reading:readingText "{clause_text}"^^xsd:string .
source       SELECT clause_id,
                 COALESCE(subject, '') AS subject,
                 COALESCE(clause_group, '') AS clause_group,
                 COALESCE(source_note, '') AS source_note,
                 COALESCE(clause_text, '') AS clause_text
             FROM auspice_clause
             WHERE clause_group = '孕生男女'

mappingId    theory_bing_yao
target       yongshen:{clause_id} a yongshen:BingYao ;
                 rdfs:label "{subject}"@zh ;
                 yongshen:yongShenRole "{clause_group}"^^xsd:string ;
                 yongshen:yongShenMethod "{subject}"^^xsd:string ;
                 rdfs:comment "{clause_note}"^^xsd:string .
source       SELECT clause_id,
                 COALESCE(subject, '') AS subject,
                 COALESCE(clause_group, '') AS clause_group,
                 CONCAT(COALESCE(clause_text, ''), '｜出处：', COALESCE(source_note, '')) AS clause_note
             FROM theory_clause
             WHERE clause_group = '病药说'

mappingId    theory_dynamic_static
target       reading:{clause_id} a reading:DynamicStaticTheory ;
                 rdfs:label "{subject}"@zh ;
                 reading:readingCategory "{clause_group}"^^xsd:string ;
                 reading:readingSource "{source_note}"^^xsd:string ;
                 reading:readingText "{clause_text}"^^xsd:string .
source       SELECT clause_id,
                 COALESCE(subject, '') AS subject,
                 COALESCE(clause_group, '') AS clause_group,
                 COALESCE(source_note, '') AS source_note,
                 COALESCE(clause_text, '') AS clause_text
             FROM theory_clause
             WHERE clause_group = '动静说'

mappingId    theory_head_covering
target       reading:{clause_id} a reading:HeadCoveringTheory ;
                 rdfs:label "{subject}"@zh ;
                 reading:readingCategory "{clause_group}"^^xsd:string ;
                 reading:readingSource "{source_note}"^^xsd:string ;
                 reading:readingText "{clause_text}"^^xsd:string .
source       SELECT clause_id,
                 COALESCE(subject, '') AS subject,
                 COALESCE(clause_group, '') AS clause_group,
                 COALESCE(source_note, '') AS source_note,
                 COALESCE(clause_text, '') AS clause_text
             FROM theory_clause
             WHERE clause_group = '盖头说'

mappingId    theory_kinship
target       reading:{clause_id} a reading:KinshipTheory ;
                 rdfs:label "{subject}"@zh ;
                 reading:readingCategory "{clause_group}"^^xsd:string ;
                 reading:readingSource "{source_note}"^^xsd:string ;
                 reading:readingText "{clause_text}"^^xsd:string .
source       SELECT clause_id,
                 COALESCE(subject, '') AS subject,
                 COALESCE(clause_group, '') AS clause_group,
                 COALESCE(source_note, '') AS source_note,
                 COALESCE(clause_text, '') AS clause_text
             FROM theory_clause
             WHERE clause_group = '六亲说'

mappingId    dts_image_pattern
target       pattern:{clause_id} a pattern:ImagePattern ;
                 rdfs:label "{subject}"@zh ;
                 pattern:patternName "{subject}"^^xsd:string ;
                 pattern:patternClass "{clause_group}"^^xsd:string ;
                 pattern:patternSource "{source_note}"^^xsd:string ;
                 pattern:patternMeaning "{clause_text}"^^xsd:string .
source       SELECT clause_id,
                 COALESCE(subject, '') AS subject,
                 COALESCE(clause_group, '') AS clause_group,
                 COALESCE(source_note, '') AS source_note,
                 COALESCE(clause_text, '') AS clause_text
             FROM dts_clause
             WHERE clause_group = '形象'

mappingId    dts_direction_pattern
target       pattern:{clause_id} a pattern:DirectionPattern ;
                 rdfs:label "{subject}"@zh ;
                 pattern:patternName "{subject}"^^xsd:string ;
                 pattern:patternClass "{clause_group}"^^xsd:string ;
                 pattern:patternSource "{source_note}"^^xsd:string ;
                 pattern:patternMeaning "{clause_text}"^^xsd:string .
source       SELECT clause_id,
                 COALESCE(subject, '') AS subject,
                 COALESCE(clause_group, '') AS clause_group,
                 COALESCE(source_note, '') AS source_note,
                 COALESCE(clause_text, '') AS clause_text
             FROM dts_clause
             WHERE clause_group = '方局'

mappingId    dts_zhen_dui_pattern
target       pattern:{clause_id} a pattern:ZhenDuiPattern ;
                 rdfs:label "{subject}"@zh ;
                 pattern:patternName "{subject}"^^xsd:string ;
                 pattern:patternClass "{clause_group}"^^xsd:string ;
                 pattern:patternSource "{source_note}"^^xsd:string ;
                 pattern:patternMeaning "{clause_text}"^^xsd:string .
source       SELECT clause_id,
                 COALESCE(subject, '') AS subject,
                 COALESCE(clause_group, '') AS clause_group,
                 COALESCE(source_note, '') AS source_note,
                 COALESCE(clause_text, '') AS clause_text
             FROM dts_clause
             WHERE clause_group = '震兑'

mappingId    dts_kan_li_pattern
target       pattern:{clause_id} a pattern:KanLiPattern ;
                 rdfs:label "{subject}"@zh ;
                 pattern:patternName "{subject}"^^xsd:string ;
                 pattern:patternClass "{clause_group}"^^xsd:string ;
                 pattern:patternSource "{source_note}"^^xsd:string ;
                 pattern:patternMeaning "{clause_text}"^^xsd:string .
source       SELECT clause_id,
                 COALESCE(subject, '') AS subject,
                 COALESCE(clause_group, '') AS clause_group,
                 COALESCE(source_note, '') AS source_note,
                 COALESCE(clause_text, '') AS clause_text
             FROM dts_clause
             WHERE clause_group = '坎离'

mappingId    dts_assimilation_pattern
target       pattern:{clause_id} a pattern:AssimilationPattern ;
                 rdfs:label "{subject}"@zh ;
                 pattern:patternName "{subject}"^^xsd:string ;
                 pattern:patternClass "{clause_group}"^^xsd:string ;
                 pattern:patternSource "{source_note}"^^xsd:string ;
                 pattern:patternMeaning "{clause_text}"^^xsd:string .
source       SELECT clause_id,
                 COALESCE(subject, '') AS subject,
                 COALESCE(clause_group, '') AS clause_group,
                 COALESCE(source_note, '') AS source_note,
                 COALESCE(clause_text, '') AS clause_text
             FROM dts_clause
             WHERE clause_group = '从象化象假从假化'

mappingId    dts_sequence_pattern
target       pattern:{clause_id} a pattern:SequencePattern ;
                 rdfs:label "{subject}"@zh ;
                 pattern:patternName "{subject}"^^xsd:string ;
                 pattern:patternClass "{clause_group}"^^xsd:string ;
                 pattern:patternSource "{source_note}"^^xsd:string ;
                 pattern:patternMeaning "{clause_text}"^^xsd:string .
source       SELECT clause_id,
                 COALESCE(subject, '') AS subject,
                 COALESCE(clause_group, '') AS clause_group,
                 COALESCE(source_note, '') AS source_note,
                 COALESCE(clause_text, '') AS clause_text
             FROM dts_clause
             WHERE clause_group = '顺反战合局'

mappingId    dts_sovereign_pattern
target       pattern:{clause_id} a pattern:SovereignPattern ;
                 rdfs:label "{subject}"@zh ;
                 pattern:patternName "{subject}"^^xsd:string ;
                 pattern:patternClass "{clause_group}"^^xsd:string ;
                 pattern:patternSource "{source_note}"^^xsd:string ;
                 pattern:patternMeaning "{clause_text}"^^xsd:string .
source       SELECT clause_id,
                 COALESCE(subject, '') AS subject,
                 COALESCE(clause_group, '') AS clause_group,
                 COALESCE(source_note, '') AS source_note,
                 COALESCE(clause_text, '') AS clause_text
             FROM dts_clause
             WHERE clause_group = '君象臣象母象子象'

mappingId    dts_idle_god
target       yongshen:{clause_id} a yongshen:IdleGod ;
                 rdfs:label "{subject}"@zh ;
                 yongshen:yongShenRole "{clause_group}"^^xsd:string ;
                 yongshen:yongShenMethod "{subject}"^^xsd:string ;
                 rdfs:comment "{clause_note}"^^xsd:string .
source       SELECT clause_id,
                 COALESCE(subject, '') AS subject,
                 COALESCE(clause_group, '') AS clause_group,
                 CONCAT(COALESCE(clause_text, ''), '｜出处：', COALESCE(source_note, '')) AS clause_note
             FROM dts_clause
             WHERE clause_group = '闲神'

mappingId    dts_illuminating
target       reading:{clause_id} a reading:IlluminatingChapter ;
                 rdfs:label "{subject}"@zh ;
                 reading:readingCategory "{clause_group}"^^xsd:string ;
                 reading:readingSource "{source_note}"^^xsd:string ;
                 reading:readingText "{clause_text}"^^xsd:string .
source       SELECT clause_id,
                 COALESCE(subject, '') AS subject,
                 COALESCE(clause_group, '') AS clause_group,
                 COALESCE(source_note, '') AS source_note,
                 COALESCE(clause_text, '') AS clause_text
             FROM dts_clause
             WHERE clause_group = '何知章'

mappingId    dts_zhen_yuan
target       fortune:{clause_id} a fortune:ZhenYuan ;
                 rdfs:label "{subject}"@zh ;
                 rdfs:comment "{clause_note}"^^xsd:string .
source       SELECT clause_id,
                 COALESCE(subject, '') AS subject,
                 CONCAT(COALESCE(clause_text, ''), '｜出处：', COALESCE(source_note, '')) AS clause_note
             FROM dts_clause
             WHERE clause_group = '贞元'

mappingId    fu_clause_all
target       reading:{clause_id} a reading:CategoryFortune ;
                 rdfs:label "{subject}"@zh ;
                 reading:readingCategory "{clause_group}"^^xsd:string ;
                 reading:readingSource "{source_note}"^^xsd:string ;
                 reading:readingText "{clause_text}"^^xsd:string .
source       SELECT clause_id,
                 COALESCE(subject, '') AS subject,
                 COALESCE(clause_group, '') AS clause_group,
                 COALESCE(source_note, '') AS source_note,
                 COALESCE(clause_text, '') AS clause_text
             FROM fu_clause

mappingId    ziping_clause_all
target       reading:{clause_id} a reading:ReadingItem ;
                 rdfs:label "{subject}"@zh ;
                 reading:readingCategory "{clause_group}"^^xsd:string ;
                 reading:readingSource "{source_note}"^^xsd:string ;
                 reading:readingText "{clause_text}"^^xsd:string .
source       SELECT clause_id,
                 COALESCE(subject, '') AS subject,
                 COALESCE(clause_group, '') AS clause_group,
                 COALESCE(source_note, '') AS source_note,
                 COALESCE(clause_text, '') AS clause_text
             FROM ziping_clause

mappingId    classic_text_all
target       reading:{text_id} a reading:ReadingItem ;
                 rdfs:label "{chapter}"@zh ;
                 reading:readingCategory "{book_name}"^^xsd:string ;
                 reading:readingSource "{source_note}"^^xsd:string ;
                 reading:readingText "{clause_text}"^^xsd:string .
source       SELECT text_id,
                 COALESCE(book_name, '') AS book_name,
                 COALESCE(chapter, '') AS chapter,
                 COALESCE(source_note, '') AS source_note,
                 COALESCE(clause_text, '') AS clause_text
             FROM classic_text

mappingId    deity_rule
target       deity:{rule_id} a deity:DeityRule ;
                 deity:ruleId "{rule_id}"^^xsd:string ;
                 deity:basePillar "{base_pillar}"^^xsd:string ;
                 deity:baseGanzhi "{base_ganzhi}"^^xsd:string ;
                 deity:ruleDeityName "{deity_name}"^^xsd:string ;
                 deity:deityAlias "{deity_alias}"^^xsd:string ;
                 deity:branchHit "{branch_hit}"^^xsd:string ;
                 deity:ruleCategory "{category}"^^xsd:string ;
                 deity:ruleSource "{source_note}"^^xsd:string .
source       SELECT rule_id,
                 COALESCE(base_pillar, '') AS base_pillar,
                 COALESCE(base_ganzhi, '') AS base_ganzhi,
                 COALESCE(deity_name, '') AS deity_name,
                 COALESCE(deity_alias, '') AS deity_alias,
                 COALESCE(branch_hit, '') AS branch_hit,
                 COALESCE(category, '') AS category,
                 COALESCE(source_note, '') AS source_note
             FROM deity_rule
             WHERE rule_id IS NOT NULL

mappingId    category_verdict
target       reading:{verdict_id} a reading:CategoryVerdict ;
                 rdfs:label "{category}"@zh ;
                 reading:readingCategory "{category}"^^xsd:string ;
                 reading:conditionKey "{condition_key}"^^xsd:string ;
                 reading:readingText "{verdict_text}"^^xsd:string ;
                 reading:readingSource "{source_note}"^^xsd:string .
source       SELECT verdict_id,
                 COALESCE(category, '') AS category,
                 COALESCE(condition_key, '') AS condition_key,
                 COALESCE(verdict_text, '') AS verdict_text,
                 COALESCE(source_note, '') AS source_note
             FROM category_verdict
             WHERE verdict_id IS NOT NULL

mappingId    ten_god_map
target       tengod:{map_id} a tengod:TenGodMap ;
                 tengod:mapId "{map_id}"^^xsd:string ;
                 tengod:baseDayStem "{day_stem}"^^xsd:string ;
                 tengod:targetStem "{target_stem}"^^xsd:string ;
                 tengod:mapTenGodName "{ten_god}"^^xsd:string ;
                 tengod:mapSourceNote "{source_note}"^^xsd:string .
source       SELECT map_id,
                 COALESCE(day_stem, '') AS day_stem,
                 COALESCE(target_stem, '') AS target_stem,
                 COALESCE(ten_god, '') AS ten_god,
                 COALESCE(source_note, '') AS source_note
             FROM ten_god_map
             WHERE map_id IS NOT NULL

]]
