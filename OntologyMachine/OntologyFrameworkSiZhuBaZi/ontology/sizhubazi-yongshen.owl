<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns="http://example.org/sizhubazi/"
         xml:base="http://example.org/sizhubazi/"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:swrl="http://www.w3.org/2003/11/swrl#"
         xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
         xmlns:skos="http://www.w3.org/2004/02/skos/core#"
         xmlns:core="http://example.org/sizhubazi/core/"
         xmlns:calendar="http://example.org/sizhubazi/calendar/"
         xmlns:chart="http://example.org/sizhubazi/chart/"
         xmlns:relations="http://example.org/sizhubazi/relations/"
         xmlns:tengod="http://example.org/sizhubazi/tengod/"
         xmlns:deity="http://example.org/sizhubazi/deity/"
         xmlns:pattern="http://example.org/sizhubazi/pattern/"
         xmlns:yongshen="http://example.org/sizhubazi/yongshen/"
         xmlns:fortune="http://example.org/sizhubazi/fortune/"
         xmlns:reading="http://example.org/sizhubazi/reading/"
         xmlns:diagnosis="http://example.org/sizhubazi/diagnosis/"
         xmlns:rules="http://example.org/sizhubazi/rules/">

    <owl:Ontology rdf:about="http://example.org/sizhubazi/yongshen">
        <owl:imports rdf:resource="http://example.org/sizhubazi/core"/>
        <owl:imports rdf:resource="http://example.org/sizhubazi/pattern"/>
        <owl:imports rdf:resource="http://example.org/sizhubazi/relations"/>
        <rdfs:label xml:lang="zh">四柱命理本体 TBox 子本体 · yongshen（用神旺衰：用神相神忌神 / 调候 / 源流通关 / 旺衰十二宫 / 清浊真假 / 层次）</rdfs:label>
        <rdfs:comment xml:lang="zh">第 10 步产出：TBox 按业务域拆分。命名空间 http://example.org/sizhubazi/yongshen 不变；由 sizhubazi-tbox.owl 聚合入口统一 imports；依赖方向单向无环。</rdfs:comment>
    </owl:Ontology>

    <!-- ============================================================ -->
    <!-- 对象属性 yongshen（用神旺衰域） -->
    <!-- ============================================================ -->
    <owl:ObjectProperty rdf:about="yongshen/hasYongShen"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/><owl:inverseOf rdf:resource="yongshen/isYongShenOf"/><rdfs:domain rdf:resource="chart/FourPillars"/><rdfs:range rdf:resource="yongshen/YongShen"/><rdfs:label xml:lang="zh">有（主取）用神</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="yongshen/isYongShenOf"><owl:inverseOf rdf:resource="yongshen/hasYongShen"/><rdfs:domain rdf:resource="yongshen/YongShen"/><rdfs:range rdf:resource="chart/FourPillars"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="yongshen/hasVitality"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/><owl:inverseOf rdf:resource="yongshen/isVitalityOf"/><rdfs:domain rdf:resource="chart/FourPillars"/><rdfs:range rdf:resource="yongshen/Vitality"/><rdfs:label xml:lang="zh">有旺衰</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="yongshen/isVitalityOf"><owl:inverseOf rdf:resource="yongshen/hasVitality"/><rdfs:domain rdf:resource="yongshen/Vitality"/><rdfs:range rdf:resource="chart/FourPillars"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="yongshen/hasPurity"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/><owl:inverseOf rdf:resource="yongshen/isPurityOf"/><rdfs:domain rdf:resource="chart/FourPillars"/><rdfs:range rdf:resource="yongshen/Purity"/><rdfs:label xml:lang="zh">有清浊真假</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="yongshen/isPurityOf"><owl:inverseOf rdf:resource="yongshen/hasPurity"/><rdfs:domain rdf:resource="yongshen/Purity"/><rdfs:range rdf:resource="chart/FourPillars"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="yongshen/hasLevel"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/><owl:inverseOf rdf:resource="yongshen/isLevelOf"/><rdfs:domain rdf:resource="chart/FourPillars"/><rdfs:range rdf:resource="yongshen/Level"/><rdfs:label xml:lang="zh">有命局层次</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="yongshen/isLevelOf"><owl:inverseOf rdf:resource="yongshen/hasLevel"/><rdfs:domain rdf:resource="yongshen/Level"/><rdfs:range rdf:resource="chart/FourPillars"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="yongshen/hasFlowRelation"><owl:inverseOf rdf:resource="yongshen/isFlowRelationOf"/><rdfs:domain rdf:resource="chart/FourPillars"/><rdfs:range rdf:resource="yongshen/FlowRelation"/><rdfs:label xml:lang="zh">有源流通关</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="yongshen/isFlowRelationOf"><owl:inverseOf rdf:resource="yongshen/hasFlowRelation"/><rdfs:domain rdf:resource="yongshen/FlowRelation"/><rdfs:range rdf:resource="chart/FourPillars"/></owl:ObjectProperty>
    <owl:DatatypeProperty rdf:about="yongshen/yongShenRole"><rdfs:domain rdf:resource="yongshen/YongShen"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">用神角色（用神/相神/忌神）</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="yongshen/yongShenMethod"><rdfs:domain rdf:resource="yongshen/YongShen"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">取用法（格局法/调候法/旺衰法；标主取）</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="yongshen/vitalityState"><rdfs:domain rdf:resource="yongshen/Vitality"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">旺衰态</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="yongshen/purityState"><rdfs:domain rdf:resource="yongshen/Purity"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">清浊真假态</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="yongshen/levelName"><rdfs:domain rdf:resource="yongshen/Level"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">层次名（贵格/富格/平常/贫贱）</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="yongshen/noYongShen"><rdfs:domain rdf:resource="chart/FourPillars"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/><rdfs:label xml:lang="zh">是否无可用用神（简化判据）</rdfs:label></owl:DatatypeProperty>
    <!-- ============================================================ -->
    <!-- 类体系 · yongshen（用神旺衰域） -->
    <!-- ============================================================ -->
    <owl:Class rdf:about="yongshen/YongshenDomain"><rdfs:subClassOf rdf:resource="core/SiZhuBaZiEntity"/><rdfs:label xml:lang="zh">用神旺衰域</rdfs:label></owl:Class>
    <owl:Class rdf:about="yongshen/YongShen"><rdfs:subClassOf rdf:resource="yongshen/YongshenDomain"/><rdfs:label xml:lang="zh">用神（相神/忌神）</rdfs:label></owl:Class>
    <owl:Class rdf:about="yongshen/Tiaohou"><rdfs:subClassOf rdf:resource="yongshen/YongshenDomain"/><rdfs:label xml:lang="zh">调候用神</rdfs:label></owl:Class>
    <owl:Class rdf:about="yongshen/FlowRelation"><rdfs:subClassOf rdf:resource="yongshen/YongshenDomain"/><rdfs:label xml:lang="zh">源流通关寒暖燥湿刚柔顺逆</rdfs:label></owl:Class>
    <owl:Class rdf:about="yongshen/Vitality"><rdfs:subClassOf rdf:resource="yongshen/YongshenDomain"/><rdfs:label xml:lang="zh">旺衰</rdfs:label></owl:Class>
    <owl:Class rdf:about="yongshen/Purity"><rdfs:subClassOf rdf:resource="yongshen/YongshenDomain"/><rdfs:label xml:lang="zh">清浊真假</rdfs:label></owl:Class>
    <owl:Class rdf:about="yongshen/Level"><rdfs:subClassOf rdf:resource="yongshen/YongshenDomain"/><rdfs:label xml:lang="zh">命局层次</rdfs:label></owl:Class>
    <owl:Class rdf:about="yongshen/GuiGe"><rdfs:subClassOf rdf:resource="yongshen/Level"/><rdfs:label xml:lang="zh">贵格</rdfs:label></owl:Class>
    <owl:Class rdf:about="yongshen/FuGe"><rdfs:subClassOf rdf:resource="yongshen/Level"/><rdfs:label xml:lang="zh">富格</rdfs:label></owl:Class>
    <owl:Class rdf:about="yongshen/PingChang"><rdfs:subClassOf rdf:resource="yongshen/Level"/><rdfs:label xml:lang="zh">平常</rdfs:label></owl:Class>
    <owl:Class rdf:about="yongshen/PinJian"><rdfs:subClassOf rdf:resource="yongshen/Level"/><rdfs:label xml:lang="zh">贫贱</rdfs:label></owl:Class>
    <owl:Class rdf:about="chart/FourPillars"><rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="yongshen/hasYongShen"/><owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality><owl:onClass rdf:resource="yongshen/YongShen"/></owl:Restriction></rdfs:subClassOf></owl:Class>
    <owl:Class rdf:about="chart/FourPillars"><rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="yongshen/hasLevel"/><owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality><owl:onClass rdf:resource="yongshen/Level"/></owl:Restriction></rdfs:subClassOf></owl:Class>
    <owl:Class rdf:about="chart/FourPillars"><rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="yongshen/hasVitality"/><owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality><owl:onClass rdf:resource="yongshen/Vitality"/></owl:Restriction></rdfs:subClassOf></owl:Class>
<!-- ===== 第 15 步扩充 · 典籍补遗类（G1/G2/G5/G6/G7）===== -->
    <owl:Class rdf:about="yongshen/BingYao"><rdfs:subClassOf rdf:resource="yongshen/YongshenDomain"/><rdfs:label xml:lang="zh">病药用神（雕枯旺弱四病 / 损益生长四药）</rdfs:label></owl:Class>
    <owl:Class rdf:about="yongshen/IdleGod"><rdfs:subClassOf rdf:resource="yongshen/YongshenDomain"/><rdfs:label xml:lang="zh">闲神</rdfs:label></owl:Class>
    <owl:Class rdf:about="yongshen/TiaohouClause"><rdfs:subClassOf rdf:resource="yongshen/Tiaohou"/><rdfs:label xml:lang="zh">调候逐月条文（十天干生十二月）</rdfs:label></owl:Class>

</rdf:RDF>
