<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns="http://example.org/sizhubazi/"
         xml:base="http://example.org/sizhubazi/"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:swrl="http://www.w3.org/2003/11/swrl#"
         xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
         xmlns:skos="http://www.w3.org/2004/02/skos/core#"
         xmlns:core="http://example.org/sizhubazi/core/"
         xmlns:calendar="http://example.org/sizhubazi/calendar/"
         xmlns:chart="http://example.org/sizhubazi/chart/"
         xmlns:relations="http://example.org/sizhubazi/relations/"
         xmlns:tengod="http://example.org/sizhubazi/tengod/"
         xmlns:deity="http://example.org/sizhubazi/deity/"
         xmlns:pattern="http://example.org/sizhubazi/pattern/"
         xmlns:yongshen="http://example.org/sizhubazi/yongshen/"
         xmlns:fortune="http://example.org/sizhubazi/fortune/"
         xmlns:reading="http://example.org/sizhubazi/reading/"
         xmlns:diagnosis="http://example.org/sizhubazi/diagnosis/"
         xmlns:rules="http://example.org/sizhubazi/rules/">

    <owl:Ontology rdf:about="http://example.org/sizhubazi/tengod">
        <owl:imports rdf:resource="http://example.org/sizhubazi/core"/>
        <owl:imports rdf:resource="http://example.org/sizhubazi/relations"/>
        <rdfs:label xml:lang="zh">四柱命理本体 TBox 子本体 · tengod（十神与六亲：十神 / 生克制化 / 六亲宫位）</rdfs:label>
        <rdfs:comment xml:lang="zh">第 10 步产出：TBox 按业务域拆分。命名空间 http://example.org/sizhubazi/tengod 不变；由 sizhubazi-tbox.owl 聚合入口统一 imports；依赖方向单向无环。</rdfs:comment>
        <rdfs:comment xml:lang="zh">第 52 步：十神映射表 ten_god_map（100 行·日干×目标干全矩阵）经 OBDA 暴露为 tengod:TenGodMap；运行期本体优先取十神、tenGodIndex 五行生克算法降级（实测 100/100 一致）。十神生克制化关系（TenGodRelation）运算由程序编排。</rdfs:comment>
    </owl:Ontology>

    <!-- ============================================================ -->
    <!-- 对象属性 tengod（十神与六亲域） -->
    <!-- ============================================================ -->
    <owl:ObjectProperty rdf:about="tengod/hasTenGod"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/><owl:inverseOf rdf:resource="tengod/isTenGodOf"/><rdfs:domain rdf:resource="chart/Pillar"/><rdfs:range rdf:resource="tengod/TenGod"/><rdfs:label xml:lang="zh">有十神</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="tengod/isTenGodOf"><owl:inverseOf rdf:resource="tengod/hasTenGod"/><rdfs:domain rdf:resource="tengod/TenGod"/><rdfs:range rdf:resource="chart/Pillar"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="tengod/definedByDayMaster"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/><owl:inverseOf rdf:resource="tengod/definesTenGodFor"/><rdfs:domain rdf:resource="tengod/TenGod"/><rdfs:range rdf:resource="chart/DayPillar"/><rdfs:label xml:lang="zh">以日主定义</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="tengod/definesTenGodFor"><owl:inverseOf rdf:resource="tengod/definedByDayMaster"/><rdfs:domain rdf:resource="chart/DayPillar"/><rdfs:range rdf:resource="tengod/TenGod"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="tengod/hasTenGodRelation"><owl:inverseOf rdf:resource="tengod/isTenGodRelationOf"/><rdfs:domain rdf:resource="tengod/TenGod"/><rdfs:range rdf:resource="tengod/TenGodRelation"/><rdfs:label xml:lang="zh">有生克制化</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="tengod/isTenGodRelationOf"><owl:inverseOf rdf:resource="tengod/hasTenGodRelation"/><rdfs:domain rdf:resource="tengod/TenGodRelation"/><rdfs:range rdf:resource="tengod/TenGod"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="tengod/hasKinship"><owl:inverseOf rdf:resource="tengod/isKinshipOf"/><rdfs:domain rdf:resource="chart/Pillar"/><rdfs:range rdf:resource="tengod/Kinship"/><rdfs:label xml:lang="zh">有六亲</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="tengod/isKinshipOf"><owl:inverseOf rdf:resource="tengod/hasKinship"/><rdfs:domain rdf:resource="tengod/Kinship"/><rdfs:range rdf:resource="chart/Pillar"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="tengod/hasPalace"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/><owl:inverseOf rdf:resource="tengod/isPalaceOf"/><rdfs:domain rdf:resource="chart/Pillar"/><rdfs:range rdf:resource="tengod/Palace"/><rdfs:label xml:lang="zh">有宫位</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="tengod/isPalaceOf"><owl:inverseOf rdf:resource="tengod/hasPalace"/><rdfs:domain rdf:resource="tengod/Palace"/><rdfs:range rdf:resource="chart/Pillar"/></owl:ObjectProperty>
    <owl:DatatypeProperty rdf:about="tengod/tenGodName"><rdfs:domain rdf:resource="tengod/TenGod"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">十神名</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="tengod/tenGodAlias"><rdfs:domain rdf:resource="tengod/TenGod"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">十神别名</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="tengod/kinshipName"><rdfs:domain rdf:resource="tengod/Kinship"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">六亲名</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="tengod/palaceName"><rdfs:domain rdf:resource="tengod/Palace"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">宫位名</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="tengod/relationType"><rdfs:domain rdf:resource="tengod/TenGodRelation"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">十神制化类型</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="tengod/mapId"><rdfs:domain rdf:resource="tengod/TenGodMap"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">映射编号</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="tengod/baseDayStem"><rdfs:domain rdf:resource="tengod/TenGodMap"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">基准日干</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="tengod/targetStem"><rdfs:domain rdf:resource="tengod/TenGodMap"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">目标干</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="tengod/mapTenGodName"><rdfs:domain rdf:resource="tengod/TenGodMap"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">所主十神名</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="tengod/mapSourceNote"><rdfs:domain rdf:resource="tengod/TenGodMap"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">出处</rdfs:label></owl:DatatypeProperty>
    <!-- ============================================================ -->
    <!-- 类体系 · tengod（十神与六亲域） -->
    <!-- ============================================================ -->
    <owl:Class rdf:about="tengod/TenGodDomain"><rdfs:subClassOf rdf:resource="core/SiZhuBaZiEntity"/><rdfs:label xml:lang="zh">十神与六亲域</rdfs:label></owl:Class>
    <owl:Class rdf:about="tengod/TenGod"><rdfs:subClassOf rdf:resource="tengod/TenGodDomain"/><rdfs:label xml:lang="zh">十神</rdfs:label></owl:Class>
    <owl:Class rdf:about="tengod/ZhengGuan"><rdfs:subClassOf rdf:resource="tengod/TenGod"/><rdfs:label xml:lang="zh">正官</rdfs:label></owl:Class>
    <owl:Class rdf:about="tengod/PianGuan"><rdfs:subClassOf rdf:resource="tengod/TenGod"/><rdfs:label xml:lang="zh">偏官（七杀）</rdfs:label></owl:Class>
    <owl:Class rdf:about="tengod/ZhengCai"><rdfs:subClassOf rdf:resource="tengod/TenGod"/><rdfs:label xml:lang="zh">正财</rdfs:label></owl:Class>
    <owl:Class rdf:about="tengod/PianCai"><rdfs:subClassOf rdf:resource="tengod/TenGod"/><rdfs:label xml:lang="zh">偏财</rdfs:label></owl:Class>
    <owl:Class rdf:about="tengod/ZhengYin"><rdfs:subClassOf rdf:resource="tengod/TenGod"/><rdfs:label xml:lang="zh">正印</rdfs:label></owl:Class>
    <owl:Class rdf:about="tengod/PianYin"><rdfs:subClassOf rdf:resource="tengod/TenGod"/><rdfs:label xml:lang="zh">偏印（枭神）</rdfs:label></owl:Class>
    <owl:Class rdf:about="tengod/ShiShen"><rdfs:subClassOf rdf:resource="tengod/TenGod"/><rdfs:label xml:lang="zh">食神</rdfs:label></owl:Class>
    <owl:Class rdf:about="tengod/ShangGuan"><rdfs:subClassOf rdf:resource="tengod/TenGod"/><rdfs:label xml:lang="zh">伤官</rdfs:label></owl:Class>
    <owl:Class rdf:about="tengod/BiJian"><rdfs:subClassOf rdf:resource="tengod/TenGod"/><rdfs:label xml:lang="zh">比肩</rdfs:label></owl:Class>
    <owl:Class rdf:about="tengod/JieCai"><rdfs:subClassOf rdf:resource="tengod/TenGod"/><rdfs:label xml:lang="zh">劫财</rdfs:label></owl:Class>
    <owl:Class rdf:about="tengod/TenGodRelation"><rdfs:subClassOf rdf:resource="tengod/TenGodDomain"/><rdfs:label xml:lang="zh">十神生克制化</rdfs:label></owl:Class>
    <owl:Class rdf:about="tengod/OfficialKillMix"><rdfs:subClassOf rdf:resource="tengod/TenGodRelation"/><rdfs:label xml:lang="zh">官杀混杂</rdfs:label></owl:Class>
    <owl:Class rdf:about="tengod/FoodHurtsKill"><rdfs:subClassOf rdf:resource="tengod/TenGodRelation"/><rdfs:label xml:lang="zh">食伤制杀</rdfs:label></owl:Class>
    <owl:Class rdf:about="tengod/WealthOfficialGenerate"><rdfs:subClassOf rdf:resource="tengod/TenGodRelation"/><rdfs:label xml:lang="zh">财官相生</rdfs:label></owl:Class>
    <owl:Class rdf:about="tengod/Kinship"><rdfs:subClassOf rdf:resource="tengod/TenGodDomain"/><rdfs:label xml:lang="zh">六亲</rdfs:label></owl:Class>
    <owl:Class rdf:about="tengod/Palace"><rdfs:subClassOf rdf:resource="tengod/TenGodDomain"/><rdfs:label xml:lang="zh">宫位</rdfs:label></owl:Class>
    <owl:Class rdf:about="tengod/TenGodMap"><rdfs:subClassOf rdf:resource="tengod/TenGodDomain"/><rdfs:label xml:lang="zh">十神映射（日干×目标干→十神）</rdfs:label><rdfs:comment xml:lang="zh">第 52 步：由 DB 表 ten_god_map（100 行，日干×目标干全矩阵）经 OBDA 暴露；运行期本体优先取十神、算法 tenGodIndex 降级。</rdfs:comment></owl:Class>
    <owl:Class rdf:about="chart/Pillar"><rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="tengod/hasTenGod"/><owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality><owl:onClass rdf:resource="tengod/TenGod"/></owl:Restriction></rdfs:subClassOf></owl:Class>
    <owl:Class rdf:about="tengod/TenGod"><rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="tengod/tenGodName"/><owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality></owl:Restriction></rdfs:subClassOf></owl:Class>
    <owl:Class rdf:about="chart/Pillar"><rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="tengod/hasPalace"/><owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality><owl:onClass rdf:resource="tengod/Palace"/></owl:Restriction></rdfs:subClassOf></owl:Class>

</rdf:RDF>
