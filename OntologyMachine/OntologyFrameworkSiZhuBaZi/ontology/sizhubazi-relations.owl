<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns="http://example.org/sizhubazi/"
         xml:base="http://example.org/sizhubazi/"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:swrl="http://www.w3.org/2003/11/swrl#"
         xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
         xmlns:skos="http://www.w3.org/2004/02/skos/core#"
         xmlns:core="http://example.org/sizhubazi/core/"
         xmlns:calendar="http://example.org/sizhubazi/calendar/"
         xmlns:chart="http://example.org/sizhubazi/chart/"
         xmlns:relations="http://example.org/sizhubazi/relations/"
         xmlns:tengod="http://example.org/sizhubazi/tengod/"
         xmlns:deity="http://example.org/sizhubazi/deity/"
         xmlns:pattern="http://example.org/sizhubazi/pattern/"
         xmlns:yongshen="http://example.org/sizhubazi/yongshen/"
         xmlns:fortune="http://example.org/sizhubazi/fortune/"
         xmlns:reading="http://example.org/sizhubazi/reading/"
         xmlns:diagnosis="http://example.org/sizhubazi/diagnosis/"
         xmlns:rules="http://example.org/sizhubazi/rules/">

    <owl:Ontology rdf:about="http://example.org/sizhubazi/relations">
        <owl:imports rdf:resource="http://example.org/sizhubazi/core"/>
        <rdfs:label xml:lang="zh">四柱命理本体 TBox 子本体 · relations（干支作用：五合化气 / 六合三合 / 冲刑穿害 / 合绊 / 暗合暗拱 / 生克）</rdfs:label>
        <rdfs:comment xml:lang="zh">第 10 步产出：TBox 按业务域拆分。命名空间 http://example.org/sizhubazi/relations 不变；由 sizhubazi-tbox.owl 聚合入口统一 imports；依赖方向单向无环。</rdfs:comment>
    </owl:Ontology>

    <!-- ============================================================ -->
    <!-- 对象属性 relations（干支作用域） -->
    <!-- ============================================================ -->
    <owl:ObjectProperty rdf:about="relations/hasStemCombination"><owl:inverseOf rdf:resource="relations/isStemCombinationOf"/><rdfs:domain rdf:resource="core/HeavenlyStem"/><rdfs:range rdf:resource="relations/StemCombination"/><rdfs:label xml:lang="zh">有天干五合</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="relations/isStemCombinationOf"><owl:inverseOf rdf:resource="relations/hasStemCombination"/><rdfs:domain rdf:resource="relations/StemCombination"/><rdfs:range rdf:resource="core/HeavenlyStem"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="relations/combinesWith"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/><rdfs:domain rdf:resource="core/HeavenlyStem"/><rdfs:range rdf:resource="core/HeavenlyStem"/><rdfs:label xml:lang="zh">天干五合</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="relations/transformsTo"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/><owl:inverseOf rdf:resource="relations/isTransformedFrom"/><rdfs:domain rdf:resource="relations/StemCombination"/><rdfs:range rdf:resource="core/FivePhase"/><rdfs:label xml:lang="zh">化气</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="relations/isTransformedFrom"><owl:inverseOf rdf:resource="relations/transformsTo"/><rdfs:domain rdf:resource="core/FivePhase"/><rdfs:range rdf:resource="relations/StemCombination"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="relations/hasBranchRelation"><owl:inverseOf rdf:resource="relations/isBranchRelationOf"/><rdfs:domain rdf:resource="core/EarthlyBranch"/><rdfs:range rdf:resource="relations/BranchRelation"/><rdfs:label xml:lang="zh">有地支关系</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="relations/isBranchRelationOf"><owl:inverseOf rdf:resource="relations/hasBranchRelation"/><rdfs:domain rdf:resource="relations/BranchRelation"/><rdfs:range rdf:resource="core/EarthlyBranch"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="relations/sixCombinesWith"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/><rdfs:domain rdf:resource="core/EarthlyBranch"/><rdfs:range rdf:resource="core/EarthlyBranch"/><rdfs:label xml:lang="zh">六合</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="relations/tripleCombinesWith"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/><rdfs:domain rdf:resource="core/EarthlyBranch"/><rdfs:range rdf:resource="core/EarthlyBranch"/><rdfs:label xml:lang="zh">三合/半合</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="relations/clashesWith"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/><rdfs:domain rdf:resource="core/EarthlyBranch"/><rdfs:range rdf:resource="core/EarthlyBranch"/><rdfs:label xml:lang="zh">相冲</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="relations/harmsWith"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/><rdfs:domain rdf:resource="core/EarthlyBranch"/><rdfs:range rdf:resource="core/EarthlyBranch"/><rdfs:label xml:lang="zh">相穿/六害</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="relations/punishesWith"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/><rdfs:domain rdf:resource="core/EarthlyBranch"/><rdfs:range rdf:resource="core/EarthlyBranch"/><rdfs:label xml:lang="zh">三刑</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="relations/hasHiddenRelation"><owl:inverseOf rdf:resource="relations/isHiddenRelationOf"/><rdfs:domain rdf:resource="core/GanzhiEntity"/><rdfs:range rdf:resource="relations/HiddenRelation"/><rdfs:label xml:lang="zh">有隐蔽作用</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="relations/isHiddenRelationOf"><owl:inverseOf rdf:resource="relations/hasHiddenRelation"/><rdfs:domain rdf:resource="relations/HiddenRelation"/><rdfs:range rdf:resource="core/GanzhiEntity"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="relations/isBondedBy"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/><owl:inverseOf rdf:resource="relations/bonds"/><rdfs:domain rdf:resource="core/GanzhiEntity"/><rdfs:range rdf:resource="relations/Bondage"/><rdfs:label xml:lang="zh">被合绊</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="relations/bonds"><owl:inverseOf rdf:resource="relations/isBondedBy"/><rdfs:domain rdf:resource="relations/Bondage"/><rdfs:range rdf:resource="core/GanzhiEntity"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="relations/hasPhaseRelation"><owl:inverseOf rdf:resource="relations/isPhaseRelationOf"/><rdfs:domain rdf:resource="core/GanzhiEntity"/><rdfs:range rdf:resource="relations/PhaseRelation"/><rdfs:label xml:lang="zh">有五行生克</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="relations/isPhaseRelationOf"><owl:inverseOf rdf:resource="relations/hasPhaseRelation"/><rdfs:domain rdf:resource="relations/PhaseRelation"/><rdfs:range rdf:resource="core/GanzhiEntity"/></owl:ObjectProperty>
    <owl:DatatypeProperty rdf:about="relations/combinationType"><rdfs:domain rdf:resource="relations/StemCombination"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">合化类型</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="relations/branchRelationType"><rdfs:domain rdf:resource="relations/BranchRelation"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">地支关系类型</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="relations/combinationResult"><rdfs:domain rdf:resource="relations/StemCombination"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">合化结果</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="relations/relationTransformed"><rdfs:domain rdf:resource="relations/StemCombination"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/><rdfs:label xml:lang="zh">是否成立/合而不合</rdfs:label></owl:DatatypeProperty>
    <!-- ============================================================ -->
    <!-- 类体系 · relations（干支作用域） -->
    <!-- ============================================================ -->
    <owl:Class rdf:about="relations/RelationDomain"><rdfs:subClassOf rdf:resource="core/SiZhuBaZiEntity"/><rdfs:label xml:lang="zh">干支作用域</rdfs:label></owl:Class>
    <owl:Class rdf:about="relations/StemCombination"><rdfs:subClassOf rdf:resource="relations/RelationDomain"/><rdfs:label xml:lang="zh">天干五合</rdfs:label></owl:Class>
    <owl:Class rdf:about="relations/BranchRelation"><rdfs:subClassOf rdf:resource="relations/RelationDomain"/><rdfs:label xml:lang="zh">地支关系</rdfs:label></owl:Class>
    <owl:Class rdf:about="relations/SixCombination"><rdfs:subClassOf rdf:resource="relations/BranchRelation"/><rdfs:label xml:lang="zh">六合</rdfs:label></owl:Class>
    <owl:Class rdf:about="relations/TripleCombination"><rdfs:subClassOf rdf:resource="relations/BranchRelation"/><rdfs:label xml:lang="zh">三合（半合）</rdfs:label></owl:Class>
    <owl:Class rdf:about="relations/Clash"><rdfs:subClassOf rdf:resource="relations/BranchRelation"/><rdfs:label xml:lang="zh">相冲</rdfs:label></owl:Class>
    <owl:Class rdf:about="relations/Harm"><rdfs:subClassOf rdf:resource="relations/BranchRelation"/><rdfs:label xml:lang="zh">相穿（六害）</rdfs:label></owl:Class>
    <owl:Class rdf:about="relations/Punishment"><rdfs:subClassOf rdf:resource="relations/BranchRelation"/><rdfs:label xml:lang="zh">三刑</rdfs:label></owl:Class>
    <owl:Class rdf:about="relations/TombRelation"><rdfs:subClassOf rdf:resource="relations/BranchRelation"/><rdfs:label xml:lang="zh">墓库刑冲</rdfs:label></owl:Class>
    <owl:Class rdf:about="relations/HiddenRelation"><rdfs:subClassOf rdf:resource="relations/RelationDomain"/><rdfs:label xml:lang="zh">暗合暗拱遥冲遥克</rdfs:label></owl:Class>
    <owl:Class rdf:about="relations/Bondage"><rdfs:subClassOf rdf:resource="relations/RelationDomain"/><rdfs:label xml:lang="zh">合绊（羁绊）</rdfs:label></owl:Class>
    <owl:Class rdf:about="relations/PhaseRelation"><rdfs:subClassOf rdf:resource="relations/RelationDomain"/><rdfs:label xml:lang="zh">干支五行生克</rdfs:label></owl:Class>
    <owl:Class rdf:about="relations/StemCombination"><rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="relations/transformsTo"/><owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality><owl:onClass rdf:resource="core/FivePhase"/></owl:Restriction></rdfs:subClassOf></owl:Class>

</rdf:RDF>
