<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns="http://example.org/sizhubazi/"
         xml:base="http://example.org/sizhubazi/"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:swrl="http://www.w3.org/2003/11/swrl#"
         xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
         xmlns:skos="http://www.w3.org/2004/02/skos/core#"
         xmlns:core="http://example.org/sizhubazi/core/"
         xmlns:calendar="http://example.org/sizhubazi/calendar/"
         xmlns:chart="http://example.org/sizhubazi/chart/"
         xmlns:relations="http://example.org/sizhubazi/relations/"
         xmlns:tengod="http://example.org/sizhubazi/tengod/"
         xmlns:deity="http://example.org/sizhubazi/deity/"
         xmlns:pattern="http://example.org/sizhubazi/pattern/"
         xmlns:yongshen="http://example.org/sizhubazi/yongshen/"
         xmlns:fortune="http://example.org/sizhubazi/fortune/"
         xmlns:reading="http://example.org/sizhubazi/reading/"
         xmlns:diagnosis="http://example.org/sizhubazi/diagnosis/"
         xmlns:rules="http://example.org/sizhubazi/rules/">

    <owl:Ontology rdf:about="http://example.org/sizhubazi/reading">
        <owl:imports rdf:resource="http://example.org/sizhubazi/core"/>
        <owl:imports rdf:resource="http://example.org/sizhubazi/tengod"/>
        <owl:imports rdf:resource="http://example.org/sizhubazi/deity"/>
        <owl:imports rdf:resource="http://example.org/sizhubazi/yongshen"/>
        <owl:imports rdf:resource="http://example.org/sizhubazi/fortune"/>
        <rdfs:label xml:lang="zh">四柱命理本体 TBox 子本体 · reading（断语：性情 / 疾病 / 六亲 / 女命 / 小儿 / 分类事项 / 劝诫 / 合婚）</rdfs:label>
        <rdfs:comment xml:lang="zh">第 10 步产出：TBox 按业务域拆分。命名空间 http://example.org/sizhubazi/reading 不变；由 sizhubazi-tbox.owl 聚合入口统一 imports；依赖方向单向无环。</rdfs:comment>
    </owl:Ontology>

    <!-- ============================================================ -->
    <!-- 对象属性 reading（断语域） -->
    <!-- ============================================================ -->
    <owl:ObjectProperty rdf:about="reading/hasReading"><owl:inverseOf rdf:resource="reading/isReadingOf"/><rdfs:domain rdf:resource="chart/FourPillars"/><rdfs:range rdf:resource="reading/ReadingItem"/><rdfs:label xml:lang="zh">有断语</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="reading/isReadingOf"><owl:inverseOf rdf:resource="reading/hasReading"/><rdfs:domain rdf:resource="reading/ReadingItem"/><rdfs:range rdf:resource="chart/FourPillars"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="reading/hasTemperament"><owl:inverseOf rdf:resource="reading/isTemperamentOf"/><rdfs:domain rdf:resource="chart/FourPillars"/><rdfs:range rdf:resource="reading/Temperament"/><rdfs:label xml:lang="zh">有性情相貌才德</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="reading/isTemperamentOf"><owl:inverseOf rdf:resource="reading/hasTemperament"/><rdfs:domain rdf:resource="reading/Temperament"/><rdfs:range rdf:resource="chart/FourPillars"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="reading/hasDisease"><owl:inverseOf rdf:resource="reading/isDiseaseOf"/><rdfs:domain rdf:resource="chart/FourPillars"/><rdfs:range rdf:resource="reading/Disease"/><rdfs:label xml:lang="zh">有疾病</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="reading/isDiseaseOf"><owl:inverseOf rdf:resource="reading/hasDisease"/><rdfs:domain rdf:resource="reading/Disease"/><rdfs:range rdf:resource="chart/FourPillars"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="reading/hasKinshipFortune"><owl:inverseOf rdf:resource="reading/isKinshipFortuneOf"/><rdfs:domain rdf:resource="chart/FourPillars"/><rdfs:range rdf:resource="reading/KinshipFortune"/><rdfs:label xml:lang="zh">有六亲吉凶</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="reading/isKinshipFortuneOf"><owl:inverseOf rdf:resource="reading/hasKinshipFortune"/><rdfs:domain rdf:resource="reading/KinshipFortune"/><rdfs:range rdf:resource="chart/FourPillars"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="reading/hasLadyFortune"><owl:inverseOf rdf:resource="reading/isLadyFortuneOf"/><rdfs:domain rdf:resource="chart/FourPillars"/><rdfs:range rdf:resource="reading/LadyFortune"/><rdfs:label xml:lang="zh">有女命专论</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="reading/isLadyFortuneOf"><owl:inverseOf rdf:resource="reading/hasLadyFortune"/><rdfs:domain rdf:resource="reading/LadyFortune"/><rdfs:range rdf:resource="chart/FourPillars"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="reading/hasChildFortune"><owl:inverseOf rdf:resource="reading/isChildFortuneOf"/><rdfs:domain rdf:resource="chart/FourPillars"/><rdfs:range rdf:resource="reading/ChildFortune"/><rdfs:label xml:lang="zh">有小儿关杀</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="reading/isChildFortuneOf"><owl:inverseOf rdf:resource="reading/hasChildFortune"/><rdfs:domain rdf:resource="reading/ChildFortune"/><rdfs:range rdf:resource="chart/FourPillars"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="reading/hasCategoryFortune"><owl:inverseOf rdf:resource="reading/isCategoryFortuneOf"/><rdfs:domain rdf:resource="chart/FourPillars"/><rdfs:range rdf:resource="reading/CategoryFortune"/><rdfs:label xml:lang="zh">有分类事项断</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="reading/isCategoryFortuneOf"><owl:inverseOf rdf:resource="reading/hasCategoryFortune"/><rdfs:domain rdf:resource="reading/CategoryFortune"/><rdfs:range rdf:resource="chart/FourPillars"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="reading/hasAdmonition"><owl:inverseOf rdf:resource="reading/isAdmonitionOf"/><rdfs:domain rdf:resource="chart/FourPillars"/><rdfs:range rdf:resource="reading/Admonition"/><rdfs:label xml:lang="zh">有修身劝诫</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="reading/isAdmonitionOf"><owl:inverseOf rdf:resource="reading/hasAdmonition"/><rdfs:domain rdf:resource="reading/Admonition"/><rdfs:range rdf:resource="chart/FourPillars"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="reading/hasMarriageMatch"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/><owl:inverseOf rdf:resource="reading/isMarriageMatchOf"/><rdfs:domain rdf:resource="chart/FourPillars"/><rdfs:range rdf:resource="reading/MarriageMatch"/><rdfs:label xml:lang="zh">有八字合婚</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="reading/isMarriageMatchOf"><owl:inverseOf rdf:resource="reading/hasMarriageMatch"/><rdfs:domain rdf:resource="reading/MarriageMatch"/><rdfs:range rdf:resource="chart/FourPillars"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="reading/hasConclusion"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/><owl:inverseOf rdf:resource="reading/isConclusionOf"/><rdfs:domain rdf:resource="chart/FourPillars"/><rdfs:range rdf:resource="reading/ReadingConclusion"/><rdfs:label xml:lang="zh">有命书结论</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="reading/isConclusionOf"><owl:inverseOf rdf:resource="reading/hasConclusion"/><rdfs:domain rdf:resource="reading/ReadingConclusion"/><rdfs:range rdf:resource="chart/FourPillars"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="reading/hasCaseRecord"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/><owl:inverseOf rdf:resource="reading/isCaseRecordOf"/><rdfs:domain rdf:resource="chart/FourPillars"/><rdfs:range rdf:resource="reading/CaseRecord"/><rdfs:label xml:lang="zh">有命例记录</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="reading/isCaseRecordOf"><owl:inverseOf rdf:resource="reading/hasCaseRecord"/><rdfs:domain rdf:resource="reading/CaseRecord"/><rdfs:range rdf:resource="chart/FourPillars"/></owl:ObjectProperty>
    <owl:DatatypeProperty rdf:about="reading/readingText"><rdfs:domain rdf:resource="reading/ReadingItem"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">断语文本</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="reading/readingCategory"><rdfs:domain rdf:resource="reading/ReadingItem"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">断语类别</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="reading/diseaseOrgan"><rdfs:domain rdf:resource="reading/Disease"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">五脏六腑</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="reading/matchComplementarity"><rdfs:domain rdf:resource="reading/MarriageMatch"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">合婚互补性</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="reading/conclusionText"><rdfs:domain rdf:resource="reading/ReadingConclusion"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">命书结论</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="reading/caseBirthData"><rdfs:domain rdf:resource="reading/CaseRecord"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">命例生辰</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="reading/caseResult"><rdfs:domain rdf:resource="reading/CaseRecord"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">命例批断结果</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="reading/diseaseSevere"><rdfs:domain rdf:resource="reading/Disease"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/><rdfs:label xml:lang="zh">疾病是否重大（简化判据）</rdfs:label></owl:DatatypeProperty>
    <!-- ============================================================ -->
    <!-- 类体系 · reading（断语域）/ diagnosis（出处与流派 S3）/ rules（告警 S5） -->
    <!-- ============================================================ -->
    <owl:Class rdf:about="reading/ReadingDomain"><rdfs:subClassOf rdf:resource="core/SiZhuBaZiEntity"/><rdfs:label xml:lang="zh">断语域</rdfs:label></owl:Class>
    <owl:Class rdf:about="reading/ReadingItem"><rdfs:subClassOf rdf:resource="reading/ReadingDomain"/><rdfs:label xml:lang="zh">断语条目</rdfs:label></owl:Class>
    <owl:Class rdf:about="reading/Temperament"><rdfs:subClassOf rdf:resource="reading/ReadingItem"/><rdfs:label xml:lang="zh">性情相貌才德</rdfs:label></owl:Class>
    <owl:Class rdf:about="reading/Disease"><rdfs:subClassOf rdf:resource="reading/ReadingItem"/><rdfs:label xml:lang="zh">疾病</rdfs:label></owl:Class>
    <owl:Class rdf:about="reading/KinshipFortune"><rdfs:subClassOf rdf:resource="reading/ReadingItem"/><rdfs:label xml:lang="zh">六亲吉凶</rdfs:label></owl:Class>
    <owl:Class rdf:about="reading/LadyFortune"><rdfs:subClassOf rdf:resource="reading/ReadingItem"/><rdfs:label xml:lang="zh">女命专论</rdfs:label></owl:Class>
    <owl:Class rdf:about="reading/ChildFortune"><rdfs:subClassOf rdf:resource="reading/ReadingItem"/><rdfs:label xml:lang="zh">小儿关杀</rdfs:label></owl:Class>
    <owl:Class rdf:about="reading/CategoryFortune"><rdfs:subClassOf rdf:resource="reading/ReadingItem"/><rdfs:label xml:lang="zh">分类事项</rdfs:label></owl:Class>
    <owl:Class rdf:about="reading/Admonition"><rdfs:subClassOf rdf:resource="reading/ReadingItem"/><rdfs:label xml:lang="zh">劝诫修身</rdfs:label></owl:Class>
    <owl:Class rdf:about="reading/MarriageMatch"><rdfs:subClassOf rdf:resource="reading/ReadingItem"/><rdfs:label xml:lang="zh">八字合婚</rdfs:label></owl:Class>
    <owl:Class rdf:about="reading/ReadingConclusion"><rdfs:subClassOf rdf:resource="reading/ReadingDomain"/><rdfs:label xml:lang="zh">综合结论（命书）</rdfs:label></owl:Class>
    <owl:Class rdf:about="reading/CaseRecord"><rdfs:subClassOf rdf:resource="reading/ReadingDomain"/><rdfs:label xml:lang="zh">命例记录（隐私存档 S6）</rdfs:label></owl:Class>
    <owl:Class rdf:about="chart/FourPillars"><rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="reading/hasConclusion"/><owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality><owl:onClass rdf:resource="reading/ReadingConclusion"/></owl:Restriction></rdfs:subClassOf></owl:Class>
    <owl:Class rdf:about="reading/CaseRecord"><rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="reading/caseBirthData"/><owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality></owl:Restriction></rdfs:subClassOf></owl:Class>
    <owl:Class rdf:about="reading/MarriageMatch"><rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="reading/matchComplementarity"/><owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality></owl:Restriction></rdfs:subClassOf></owl:Class>
    <owl:Class rdf:about="reading/StemBranchAuspice"><rdfs:subClassOf rdf:resource="reading/ReadingItem"/><rdfs:label xml:lang="zh">十干坐支得月时吉凶</rdfs:label></owl:Class>
    <owl:Class rdf:about="reading/MonthBranchDayStemAuspice"><rdfs:subClassOf rdf:resource="reading/ReadingItem"/><rdfs:label xml:lang="zh">十二月支得日干吉凶</rdfs:label></owl:Class>
    <owl:Class rdf:about="reading/TimePlaceFortune"><rdfs:subClassOf rdf:resource="reading/ReadingItem"/><rdfs:label xml:lang="zh">五行时地分野吉凶</rdfs:label></owl:Class>
    <owl:Class rdf:about="reading/ProgenyPrediction"><rdfs:subClassOf rdf:resource="reading/ChildFortune"/><rdfs:label xml:lang="zh">孕生男女（定妇人孕生男女）</rdfs:label></owl:Class>
    <owl:Class rdf:about="reading/DynamicStaticTheory"><rdfs:subClassOf rdf:resource="reading/ReadingItem"/><rdfs:label xml:lang="zh">动静说</rdfs:label></owl:Class>
    <owl:Class rdf:about="reading/HeadCoveringTheory"><rdfs:subClassOf rdf:resource="reading/ReadingItem"/><rdfs:label xml:lang="zh">盖头说</rdfs:label></owl:Class>
    <owl:Class rdf:about="reading/IlluminatingChapter"><rdfs:subClassOf rdf:resource="reading/ReadingItem"/><rdfs:label xml:lang="zh">何知章</rdfs:label></owl:Class>
    <owl:Class rdf:about="reading/KinshipTheory"><rdfs:subClassOf rdf:resource="reading/ReadingItem"/><rdfs:label xml:lang="zh">六亲说</rdfs:label></owl:Class>
    <owl:Class rdf:about="reading/DayHourClause"><rdfs:subClassOf rdf:resource="reading/ReadingItem"/><rdfs:label xml:lang="zh">日时断条文（六X日X时断）</rdfs:label></owl:Class>
    <owl:DatatypeProperty rdf:about="reading/readingSource"><rdfs:domain rdf:resource="reading/ReadingItem"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">断语出处</rdfs:label></owl:DatatypeProperty>

    <!-- ============================================================ -->
    <!-- 分类事项白话断语模板（category_verdict 表经 OBDA 暴露；运行期按本命条件取文） -->
    <!--   条件分支：①事业 ②财运 ③婚姻 ④寿夭 ⑤飘荡（依本命十神/宫位/神煞判定） -->
    <!--   出处：渊海子平卷之二·各十神论、卷之三·六亲总论；三命通会卷九·论疾病/论羊刃/论驿马/论劫煞 -->
    <!-- ============================================================ -->
    <owl:Class rdf:about="reading/CategoryVerdict"><rdfs:subClassOf rdf:resource="reading/ReadingItem"/><rdfs:label xml:lang="zh">分类事项白话断语</rdfs:label></owl:Class>
    <owl:DatatypeProperty rdf:about="reading/conditionKey"><rdfs:domain rdf:resource="reading/CategoryVerdict"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">条件键（如 hasGuan_true / marriage_chong）</rdfs:label></owl:DatatypeProperty>

</rdf:RDF>
