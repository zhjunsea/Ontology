<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns="http://example.org/sizhubazi/"
         xml:base="http://example.org/sizhubazi/"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:swrl="http://www.w3.org/2003/11/swrl#"
         xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
         xmlns:skos="http://www.w3.org/2004/02/skos/core#"
         xmlns:core="http://example.org/sizhubazi/core/"
         xmlns:calendar="http://example.org/sizhubazi/calendar/"
         xmlns:chart="http://example.org/sizhubazi/chart/"
         xmlns:relations="http://example.org/sizhubazi/relations/"
         xmlns:tengod="http://example.org/sizhubazi/tengod/"
         xmlns:deity="http://example.org/sizhubazi/deity/"
         xmlns:pattern="http://example.org/sizhubazi/pattern/"
         xmlns:yongshen="http://example.org/sizhubazi/yongshen/"
         xmlns:fortune="http://example.org/sizhubazi/fortune/"
         xmlns:reading="http://example.org/sizhubazi/reading/"
         xmlns:diagnosis="http://example.org/sizhubazi/diagnosis/"
         xmlns:rules="http://example.org/sizhubazi/rules/">

    <owl:Ontology rdf:about="http://example.org/sizhubazi/deity">
        <owl:imports rdf:resource="http://example.org/sizhubazi/core"/>
        <owl:imports rdf:resource="http://example.org/sizhubazi/calendar"/>
        <owl:imports rdf:resource="http://example.org/sizhubazi/chart"/>
        <rdfs:label xml:lang="zh">四柱命理本体 TBox 子本体 · deity（神煞：贵人吉神 / 禄马 / 凶煞 / 空亡）</rdfs:label>
        <rdfs:comment xml:lang="zh">第 10 步产出：TBox 按业务域拆分。命名空间 http://example.org/sizhubazi/deity 不变；由 sizhubazi-tbox.owl 聚合入口统一 imports；依赖方向单向无环。</rdfs:comment>
    </owl:Ontology>

    <!-- ============================================================ -->
    <!-- 对象属性 deity（神煞域） -->
    <!-- ============================================================ -->
    <owl:ObjectProperty rdf:about="deity/hasDeity"><owl:inverseOf rdf:resource="deity/isDeityOf"/><rdfs:domain rdf:resource="chart/Pillar"/><rdfs:range rdf:resource="deity/Deity"/><rdfs:label xml:lang="zh">有神煞</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="deity/isDeityOf"><owl:inverseOf rdf:resource="deity/hasDeity"/><rdfs:domain rdf:resource="deity/Deity"/><rdfs:range rdf:resource="chart/Pillar"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="deity/hasVoid"><owl:inverseOf rdf:resource="deity/isVoidOf"/><rdfs:domain rdf:resource="chart/Pillar"/><rdfs:range rdf:resource="deity/Void"/><rdfs:label xml:lang="zh">有空亡</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="deity/isVoidOf"><owl:inverseOf rdf:resource="deity/hasVoid"/><rdfs:domain rdf:resource="deity/Void"/><rdfs:range rdf:resource="chart/Pillar"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="deity/hasVoidResponse"><owl:inverseOf rdf:resource="deity/isVoidResponseOf"/><rdfs:domain rdf:resource="deity/Void"/><rdfs:range rdf:resource="fortune/ResponsePeriod"/><rdfs:label xml:lang="zh">空亡应期</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="deity/isVoidResponseOf"><owl:inverseOf rdf:resource="deity/hasVoidResponse"/><rdfs:domain rdf:resource="fortune/ResponsePeriod"/><rdfs:range rdf:resource="deity/Void"/></owl:ObjectProperty>
    <owl:DatatypeProperty rdf:about="deity/deityName"><rdfs:domain rdf:resource="deity/Deity"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">神煞名</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="deity/deityCategory"><rdfs:domain rdf:resource="deity/Deity"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">神煞类别</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="deity/voidType"><rdfs:domain rdf:resource="deity/Void"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">空亡类型</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="deity/voidResponseType"><rdfs:domain rdf:resource="deity/Void"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">空亡应期类型</rdfs:label></owl:DatatypeProperty>
    <!-- ============================================================ -->
    <!-- 类体系 · deity（神煞域） -->
    <!-- ============================================================ -->
    <owl:Class rdf:about="deity/DeityDomain"><rdfs:subClassOf rdf:resource="core/SiZhuBaZiEntity"/><rdfs:label xml:lang="zh">神煞域</rdfs:label></owl:Class>
    <owl:Class rdf:about="deity/Deity"><rdfs:subClassOf rdf:resource="deity/DeityDomain"/><rdfs:label xml:lang="zh">神煞</rdfs:label></owl:Class>
    <owl:Class rdf:about="deity/AuspiciousDeity"><rdfs:subClassOf rdf:resource="deity/Deity"/><rdfs:label xml:lang="zh">贵人吉神</rdfs:label></owl:Class>
    <owl:Class rdf:about="deity/LuMa"><rdfs:subClassOf rdf:resource="deity/Deity"/><rdfs:label xml:lang="zh">禄马类</rdfs:label></owl:Class>
    <owl:Class rdf:about="deity/InauspiciousDeity"><rdfs:subClassOf rdf:resource="deity/Deity"/><rdfs:label xml:lang="zh">凶煞类</rdfs:label></owl:Class>
    <owl:Class rdf:about="deity/Void"><rdfs:subClassOf rdf:resource="deity/DeityDomain"/><rdfs:label xml:lang="zh">空亡</rdfs:label></owl:Class>

    <!-- ============================================================ -->
    <!-- 神煞起例规则（deity_rule 表经 OBDA 暴露为 deity:DeityRule；运行期按本命四柱匹配） -->
    <!--   出处：三命通会卷二·诸神煞篇；渊海子平卷之一·诸神煞篇                         -->
    <!-- ============================================================ -->
    <owl:Class rdf:about="deity/DeityRule"><rdfs:subClassOf rdf:resource="deity/DeityDomain"/><rdfs:label xml:lang="zh">神煞起例规则</rdfs:label></owl:Class>
    <owl:DatatypeProperty rdf:about="deity/ruleId"><rdfs:domain rdf:resource="deity/DeityRule"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">起例编号</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="deity/basePillar"><rdfs:domain rdf:resource="deity/DeityRule"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">起例基准柱（年/月/日干/日支/年支等）</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="deity/baseGanzhi"><rdfs:domain rdf:resource="deity/DeityRule"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">基准干支/三合组/月建/旬</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="deity/ruleDeityName"><rdfs:domain rdf:resource="deity/DeityRule"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">神煞名</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="deity/deityAlias"><rdfs:domain rdf:resource="deity/DeityRule"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">神煞异名（异法并陈）</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="deity/branchHit"><rdfs:domain rdf:resource="deity/DeityRule"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">命中地支/天干</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="deity/ruleCategory"><rdfs:domain rdf:resource="deity/DeityRule"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">神煞类别（贵人吉神/禄马/凶煞/空亡）</rdfs:label></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="deity/ruleSource"><rdfs:domain rdf:resource="deity/DeityRule"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><rdfs:label xml:lang="zh">出处</rdfs:label></owl:DatatypeProperty>

</rdf:RDF>
