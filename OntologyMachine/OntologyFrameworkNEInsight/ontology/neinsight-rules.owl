  <swrl:Imp rdf:about="http://example.org/neinsight/rules#R2_HighPriorityAlert">
    <rdfs:label xml:lang="zh">高优先级→外发标记</rdfs:label>
    <swrl:body>
<rdf:Description>
  <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
  <rdf:first>
<rdf:Description>
  <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
  <swrl:classPredicate rdf:resource="http://example.org/neinsight/env#Opportunity"/>
  <swrl:argument1 rdf:resource="http://example.org/neinsight/rules#o"/>
</rdf:Description>
</rdf:first>
  <rdf:rest>
<rdf:Description>
  <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
  <rdf:first>
<rdf:Description>
  <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
  <swrl:propertyPredicate rdf:resource="http://example.org/neinsight/env#opportunityPriority"/>
  <swrl:argument1 rdf:resource="http://example.org/neinsight/rules#o"/>
  <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HIGH</swrl:argument2>
</rdf:Description>
</rdf:first>
  <rdf:rest>
<rdf:Description rdf:about="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
</rdf:rest>
</rdf:Description>
</rdf:rest>
</rdf:Description>
    </swrl:body>
    <swrl:head>
<rdf:Description>
  <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
  <rdf:first>
<rdf:Description>
  <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
  <swrl:propertyPredicate rdf:resource="http://example.org/neinsight/env#flaggedForAlert"/>
  <swrl:argument1 rdf:resource="http://example.org/neinsight/rules#o"/>
  <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrl:argument2>
</rdf:Description>
</rdf:first>
  <rdf:rest>
<rdf:Description rdf:about="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
</rdf:rest>
</rdf:Description>
    </swrl:head>
  </swrl:Imp>
  <swrl:Imp rdf:about="http://example.org/neinsight/rules#R3_SmartCompliance">
    <rdfs:label xml:lang="zh">SMART 校验</rdfs:label>
    <swrl:body>
<rdf:Description>
  <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
  <rdf:first>
<rdf:Description>
  <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
  <swrl:classPredicate rdf:resource="http://example.org/neinsight/decision#Objective"/>
  <swrl:argument1 rdf:resource="http://example.org/neinsight/rules#ob"/>
</rdf:Description>
</rdf:first>
  <rdf:rest>
<rdf:Description>
  <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
  <rdf:first>
<rdf:Description>
  <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
  <swrl:propertyPredicate rdf:resource="http://example.org/neinsight/decision#isMeasurable"/>
  <swrl:argument1 rdf:resource="http://example.org/neinsight/rules#ob"/>
  <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrl:argument2>
</rdf:Description>
</rdf:first>
  <rdf:rest>
<rdf:Description>
  <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
  <rdf:first>
<rdf:Description>
  <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
  <swrl:propertyPredicate rdf:resource="http://example.org/neinsight/decision#isRelevant"/>
  <swrl:argument1 rdf:resource="http://example.org/neinsight/rules#ob"/>
  <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrl:argument2>
</rdf:Description>
</rdf:first>
  <rdf:rest>
<rdf:Description>
  <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
  <rdf:first>
<rdf:Description>
  <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
  <swrl:propertyPredicate rdf:resource="http://example.org/neinsight/decision#hasTimeframe"/>
  <swrl:argument1 rdf:resource="http://example.org/neinsight/rules#ob"/>
  <swrl:argument2 rdf:resource="http://example.org/neinsight/rules#t"/>
</rdf:Description>
</rdf:first>
  <rdf:rest>
<rdf:Description rdf:about="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
</rdf:rest>
</rdf:Description>
</rdf:rest>
</rdf:Description>
</rdf:rest>
</rdf:Description>
</rdf:rest>
</rdf:Description>
    </swrl:body>
    <swrl:head>
<rdf:Description>
  <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
  <rdf:first>
<rdf:Description>
  <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
  <swrl:propertyPredicate rdf:resource="http://example.org/neinsight/decision#smartCompliant"/>
  <swrl:argument1 rdf:resource="http://example.org/neinsight/rules#ob"/>
  <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrl:argument2>
