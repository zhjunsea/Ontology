<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_NEInsight" targetNamespace="http://neinsight.process/standard" exporter="CodeArts OntologyAppBuilder" exporterVersion="1.0.0" xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL https://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd">
  <bpmn:process id="NewEnergyInsightProcess" name="新能源 IT 空间与云空间「五看三定」洞察流程" isExecutable="true">
    <bpmn:extensionElements />
    <bpmn:startEvent id="Start_01" name="流程开始">
      <bpmn:outgoing>Flow_Start_To_DomainGateway</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- 网关①：洞察域选择 -->
    <bpmn:exclusiveGateway id="Gateway_DomainChoice" name="洞察域选择">
      <bpmn:incoming>Flow_Start_To_DomainGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Domain_ITSpace</bpmn:outgoing>
      <bpmn:outgoing>Flow_Domain_CloudSpace</bpmn:outgoing>
      <bpmn:outgoing>Flow_Domain_Combined</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- 洞察域扫描：三选一 -->
    <bpmn:serviceTask id="Task_ScanITSpace" name="洞察 IT 空间扫描">
      <bpmn:documentation>按所选洞察域梳理 IT 空间现状与范围：企业 IT 基础设施 + 业务信息系统。</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="scan-it-space" />
        <zeebe:ioMapping>
          <zeebe:input source="=insightDomain" target="insightDomain" />
          <zeebe:input source="=&#34;http://example.org/neinsight/core#&#34;" target="classPrefix" />
          <zeebe:input source="=&#34;http://example.org/neinsight/abox#&#34;" target="indPrefix" />
          <zeebe:output source="=domainBaseline" target="domainBaseline" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Domain_ITSpace</bpmn:incoming>
      <bpmn:outgoing>Flow_ITSpace_To_Trend</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ScanCloudSpace" name="洞察云空间扫描">
      <bpmn:documentation>按所选洞察域梳理云空间现状与范围：云平台 / 云服务。</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="scan-cloud-space" />
        <zeebe:ioMapping>
          <zeebe:input source="=insightDomain" target="insightDomain" />
          <zeebe:input source="=&#34;http://example.org/neinsight/core#&#34;" target="classPrefix" />
          <zeebe:input source="=&#34;http://example.org/neinsight/abox#&#34;" target="indPrefix" />
          <zeebe:output source="=domainBaseline" target="domainBaseline" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Domain_CloudSpace</bpmn:incoming>
      <bpmn:outgoing>Flow_CloudSpace_To_Trend</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ScanCombinedSpace" name="洞察联合空间扫描">
      <bpmn:documentation>联合域：同时覆盖 IT 空间与云空间，产出合并的洞察域基线。</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="scan-combined-space" />
        <zeebe:ioMapping>
          <zeebe:input source="=insightDomain" target="insightDomain" />
          <zeebe:input source="=&#34;http://example.org/neinsight/core#&#34;" target="classPrefix" />
          <zeebe:input source="=&#34;http://example.org/neinsight/abox#&#34;" target="indPrefix" />
          <zeebe:output source="=domainBaseline" target="domainBaseline" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Domain_Combined</bpmn:incoming>
      <bpmn:outgoing>Flow_Combined_To_Trend</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- 五看 -->
    <bpmn:serviceTask id="Task_ScanIndustryTrend" name="看行业/趋势">
      <bpmn:documentation>分析政治/经济/社会/技术环境、行业发展趋势与产业链，识别「价值转移」方向（趋势＞优势）——依据 S1/S2/S3/S4。</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="scan-industry-trend" />
        <zeebe:ioMapping>
          <zeebe:input source="=insightDomain" target="insightDomain" />
          <zeebe:input source="=&#34;http://example.org/neinsight/env#&#34;" target="classPrefix" />
          <zeebe:input source="=&#34;http://example.org/neinsight/abox#&#34;" target="indPrefix" />
          <zeebe:output source="=industryTrendResult" target="industryTrendResult" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ITSpace_To_Trend</bpmn:incoming>
      <bpmn:incoming>Flow_CloudSpace_To_Trend</bpmn:incoming>
      <bpmn:incoming>Flow_Combined_To_Trend</bpmn:incoming>
      <bpmn:outgoing>Flow_Trend_To_Market</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ScanMarketCustomer" name="看市场/客户">
      <bpmn:documentation>分析目标市场规模与需求变化，研究客户场景/痛点（Pains）/潜在需求（Wants）——依据 S5。</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="scan-market-customer" />
        <zeebe:ioMapping>
          <zeebe:input source="=insightDomain" target="insightDomain" />
          <zeebe:input source="=&#34;http://example.org/neinsight/env#&#34;" target="classPrefix" />
          <zeebe:input source="=&#34;http://example.org/neinsight/abox#&#34;" target="indPrefix" />
          <zeebe:output source="=marketCustomerResult" target="marketCustomerResult" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Trend_To_Market</bpmn:incoming>
      <bpmn:outgoing>Flow_Market_To_Competition</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ScanCompetition" name="看竞争">
      <bpmn:documentation>识别主要竞争对手的战略/优势/劣势/动向，找出差异化发力的空白点（竞品【待考】不指名）。</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="scan-competition" />
        <zeebe:ioMapping>
          <zeebe:input source="=insightDomain" target="insightDomain" />
          <zeebe:input source="=&#34;http://example.org/neinsight/env#&#34;" target="classPrefix" />
          <zeebe:input source="=&#34;http://example.org/neinsight/abox#&#34;" target="indPrefix" />
          <zeebe:output source="=competitionResult" target="competitionResult" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Market_To_Competition</bpmn:incoming>
      <bpmn:outgoing>Flow_Competition_To_Self</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ScanSelf" name="看自己">
      <bpmn:documentation>客观评估自身资源/能力/优势/短板，确定在产业链中的位置与定位——依据 S6。</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="scan-self" />
        <zeebe:ioMapping>
          <zeebe:input source="=insightDomain" target="insightDomain" />
          <zeebe:input source="=&#34;http://example.org/neinsight/env#&#34;" target="classPrefix" />
          <zeebe:input source="=&#34;http://example.org/neinsight/abox#&#34;" target="indPrefix" />
          <zeebe:output source="=selfAssessmentResult" target="selfAssessmentResult" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Competition_To_Self</bpmn:incoming>
      <bpmn:outgoing>Flow_Self_To_Opportunity</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ScanOpportunity" name="看机会（SPAN 定位）">
      <bpmn:documentation>综合前四看，用 SPAN 图（市场吸引力 × 竞争地位）定位机会点并判定优先级（高/中/低，阈值【待考】）。</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="scan-opportunity" />
        <zeebe:ioMapping>
          <zeebe:input source="=insightDomain" target="insightDomain" />
          <zeebe:input source="=&#34;http://example.org/neinsight/env#&#34;" target="classPrefix" />
          <zeebe:input source="=&#34;http://example.org/neinsight/abox#&#34;" target="indPrefix" />
          <zeebe:output source="=opportunityResult" target="opportunityResult" />
          <zeebe:output source="=opportunityPriority" target="opportunityPriority" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Self_To_Opportunity</bpmn:incoming>
      <bpmn:outgoing>Flow_Opportunity_To_PriorityGateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- 网关②：机会点优先级 -->
    <bpmn:exclusiveGateway id="Gateway_PriorityChoice" name="机会点优先级">
      <bpmn:incoming>Flow_Opportunity_To_PriorityGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Priority_High</bpmn:outgoing>
      <bpmn:outgoing>Flow_Priority_NonHigh</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_MarkHighPriority" name="高优先级机会点标记与外发">
      <bpmn:documentation>存在高优先级机会点/关键风险时：标记该机会点并触发外发（RabbitMQ）——依据闸门①。</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="mark-high-priority" />
        <zeebe:ioMapping>
          <zeebe:input source="=insightDomain" target="insightDomain" />
          <zeebe:input source="=&#34;http://example.org/neinsight/env#&#34;" target="classPrefix" />
          <zeebe:input source="=&#34;http://example.org/neinsight/abox#&#34;" target="indPrefix" />
          <zeebe:output source="=alertDispatched" target="alertDispatched" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Priority_High</bpmn:incoming>
      <bpmn:outgoing>Flow_MarkHigh_To_ControlPoint</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- 三定 -->
    <bpmn:serviceTask id="Task_DefineControlPoint" name="定战略控制点">
      <bpmn:documentation>确定不易被模仿/超越的中长期核心竞争力，类型取自 {技术领先、成本优势、品牌、市场份额、价值链控制}——依据用户输入。</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="define-control-point" />
        <zeebe:ioMapping>
          <zeebe:input source="=insightDomain" target="insightDomain" />
          <zeebe:input source="=&#34;http://example.org/neinsight/decision#&#34;" target="classPrefix" />
          <zeebe:input source="=&#34;http://example.org/neinsight/abox#&#34;" target="indPrefix" />
          <zeebe:output source="=controlPointResult" target="controlPointResult" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Priority_NonHigh</bpmn:incoming>
      <bpmn:incoming>Flow_MarkHigh_To_ControlPoint</bpmn:incoming>
      <bpmn:outgoing>Flow_ControlPoint_To_Objective</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_DefineObjective" name="定目标（SMART）">
      <bpmn:documentation>制定可量化、可细化的目标，按 SMART（具体/可衡量/可实现/相关性/有时效）校验（判据量纲【待考】）。</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="define-objective" />
        <zeebe:ioMapping>
          <zeebe:input source="=insightDomain" target="insightDomain" />
          <zeebe:input source="=&#34;http://example.org/neinsight/decision#&#34;" target="classPrefix" />
          <zeebe:input source="=&#34;http://example.org/neinsight/abox#&#34;" target="indPrefix" />
          <zeebe:output source="=objectiveResult" target="objectiveResult" />
          <zeebe:output source="=smartCompliant" target="smartCompliant" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ControlPoint_To_Objective</bpmn:incoming>
      <bpmn:outgoing>Flow_Objective_To_Strategy</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_DefineStrategy" name="定策略">
      <bpmn:documentation>制定实现目标的行动方案（组织策略/产品策略/市场策略），考虑资源配置与优化。</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="define-strategy" />
        <zeebe:ioMapping>
          <zeebe:input source="=insightDomain" target="insightDomain" />
          <zeebe:input source="=&#34;http://example.org/neinsight/decision#&#34;" target="classPrefix" />
          <zeebe:input source="=&#34;http://example.org/neinsight/abox#&#34;" target="indPrefix" />
          <zeebe:output source="=strategyResult" target="strategyResult" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Objective_To_Strategy</bpmn:incoming>
      <bpmn:outgoing>Flow_Strategy_To_Summarize</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Summarize" name="汇总输出">
      <bpmn:documentation>生成「洞察报告生成 SKILL」：以「角色设定 + 任务指令」为骨架、内嵌本次流程检索到的「五看三定」洞察内容，落盘 skill/neinsight-&lt;instanceKey&gt;.md 供大模型生成洞察报告；同时经 Openllet 做一致性校验并回写摘要/实例 IRI/校验状态/SKILL 路径。</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="summarize-insight" />
        <zeebe:ioMapping>
          <zeebe:input source="=insightDomain" target="insightDomain" />
          <zeebe:input source="=&#34;http://example.org/neinsight/abox#&#34;" target="indPrefix" />
          <zeebe:output source="=insightSummary" target="insightSummary" />
          <zeebe:output source="=instanceIri" target="instanceIri" />
          <zeebe:output source="=ontologyValidationStatus" target="ontologyValidationStatus" />
          <zeebe:output source="=insightSkillPath" target="insightSkillPath" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Strategy_To_Summarize</bpmn:incoming>
      <bpmn:outgoing>Flow_Summarize_To_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_01" name="流程结束">
      <bpmn:incoming>Flow_Summarize_To_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- 连线 -->
    <bpmn:sequenceFlow id="Flow_Start_To_DomainGateway" sourceRef="Start_01" targetRef="Gateway_DomainChoice" />
    <bpmn:sequenceFlow id="Flow_Domain_ITSpace" name="IT 空间" sourceRef="Gateway_DomainChoice" targetRef="Task_ScanITSpace">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= insightDomain = &#34;IT_SPACE&#34;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Domain_CloudSpace" name="云空间" sourceRef="Gateway_DomainChoice" targetRef="Task_ScanCloudSpace">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= insightDomain = &#34;CLOUD_SPACE&#34;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Domain_Combined" name="联合" sourceRef="Gateway_DomainChoice" targetRef="Task_ScanCombinedSpace">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= insightDomain = &#34;COMBINED&#34;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ITSpace_To_Trend" sourceRef="Task_ScanITSpace" targetRef="Task_ScanIndustryTrend" />
    <bpmn:sequenceFlow id="Flow_CloudSpace_To_Trend" sourceRef="Task_ScanCloudSpace" targetRef="Task_ScanIndustryTrend" />
    <bpmn:sequenceFlow id="Flow_Combined_To_Trend" sourceRef="Task_ScanCombinedSpace" targetRef="Task_ScanIndustryTrend" />
    <bpmn:sequenceFlow id="Flow_Trend_To_Market" sourceRef="Task_ScanIndustryTrend" targetRef="Task_ScanMarketCustomer" />
    <bpmn:sequenceFlow id="Flow_Market_To_Competition" sourceRef="Task_ScanMarketCustomer" targetRef="Task_ScanCompetition" />
    <bpmn:sequenceFlow id="Flow_Competition_To_Self" sourceRef="Task_ScanCompetition" targetRef="Task_ScanSelf" />
    <bpmn:sequenceFlow id="Flow_Self_To_Opportunity" sourceRef="Task_ScanSelf" targetRef="Task_ScanOpportunity" />
    <bpmn:sequenceFlow id="Flow_Opportunity_To_PriorityGateway" sourceRef="Task_ScanOpportunity" targetRef="Gateway_PriorityChoice" />
    <bpmn:sequenceFlow id="Flow_Priority_High" name="高优先级" sourceRef="Gateway_PriorityChoice" targetRef="Task_MarkHighPriority">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= opportunityPriority = &#34;HIGH&#34;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Priority_NonHigh" name="非高优先级" sourceRef="Gateway_PriorityChoice" targetRef="Task_DefineControlPoint">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= opportunityPriority != &#34;HIGH&#34;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_MarkHigh_To_ControlPoint" sourceRef="Task_MarkHighPriority" targetRef="Task_DefineControlPoint" />
    <bpmn:sequenceFlow id="Flow_ControlPoint_To_Objective" sourceRef="Task_DefineControlPoint" targetRef="Task_DefineObjective" />
    <bpmn:sequenceFlow id="Flow_Objective_To_Strategy" sourceRef="Task_DefineObjective" targetRef="Task_DefineStrategy" />
    <bpmn:sequenceFlow id="Flow_Strategy_To_Summarize" sourceRef="Task_DefineStrategy" targetRef="Task_Summarize" />
    <bpmn:sequenceFlow id="Flow_Summarize_To_End" sourceRef="Task_Summarize" targetRef="End_01" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="NewEnergyInsightProcess">
      <bpmndi:BPMNShape id="Start_01_di" bpmnElement="Start_01">
        <dc:Bounds x="152" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="145" y="225" width="50" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_DomainChoice_di" bpmnElement="Gateway_DomainChoice" isMarkerVisible="true">
        <dc:Bounds x="240" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="234" y="145" width="62" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ScanITSpace_di" bpmnElement="Task_ScanITSpace">
        <dc:Bounds x="350" y="40" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ScanCloudSpace_di" bpmnElement="Task_ScanCloudSpace">
        <dc:Bounds x="350" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ScanCombinedSpace_di" bpmnElement="Task_ScanCombinedSpace">
        <dc:Bounds x="350" y="280" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ScanIndustryTrend_di" bpmnElement="Task_ScanIndustryTrend">
        <dc:Bounds x="520" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ScanMarketCustomer_di" bpmnElement="Task_ScanMarketCustomer">
        <dc:Bounds x="670" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ScanCompetition_di" bpmnElement="Task_ScanCompetition">
        <dc:Bounds x="820" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ScanSelf_di" bpmnElement="Task_ScanSelf">
        <dc:Bounds x="970" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ScanOpportunity_di" bpmnElement="Task_ScanOpportunity">
        <dc:Bounds x="1120" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_PriorityChoice_di" bpmnElement="Gateway_PriorityChoice" isMarkerVisible="true">
        <dc:Bounds x="1270" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1264" y="145" width="62" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_MarkHighPriority_di" bpmnElement="Task_MarkHighPriority">
        <dc:Bounds x="1360" y="40" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DefineControlPoint_di" bpmnElement="Task_DefineControlPoint">
        <dc:Bounds x="1360" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DefineObjective_di" bpmnElement="Task_DefineObjective">
        <dc:Bounds x="1510" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DefineStrategy_di" bpmnElement="Task_DefineStrategy">
        <dc:Bounds x="1660" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Summarize_di" bpmnElement="Task_Summarize">
        <dc:Bounds x="1810" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_01_di" bpmnElement="End_01">
        <dc:Bounds x="1960" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1954" y="225" width="50" height="14" />
        </bpmndi:BPMNLabel>
