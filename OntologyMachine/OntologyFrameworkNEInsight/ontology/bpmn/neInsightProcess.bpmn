<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_NEInsight" targetNamespace="http://neinsight.process/standard" exporter="CodeArts OntologyAppBuilder" exporterVersion="1.0.0" xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL https://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd">
  <bpmn:process id="NewEnergyInsightProcess" name="新能源『五看三定』洞察流程（场景驱动）" isExecutable="true">
    <bpmn:extensionElements />
    <bpmn:startEvent id="Start_01" name="流程开始">
      <bpmn:outgoing>Flow_Start_To_AnalyzeInput</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- 入口：输入分析（流程内兜底；大模型解析客户输入、抽身份/场景等关键信息并精炼场景） -->
    <bpmn:serviceTask id="Task_AnalyzeInput" name="输入分析（入口）">
      <bpmn:documentation>流程内兜底：调用大模型解析客户输入的「洞察场景」，抽取身份/场景/行业/客户/目标等关键信息并精炼场景（忠于原文、不添加原文没有的信息），结果经 refinedScenario 供后续五看三定与 SKILL 生成复用；大模型不可用/失败时降级为确定性提取（仅取场景原文、其余字段留空），流程不中断。</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="analyze-input" />
        <zeebe:ioMapping>
          <zeebe:input source="=insightScenario" target="insightScenario" />
          <zeebe:input source="=scenario" target="scenario" />
          <zeebe:input source="=identity" target="identity" />
          <zeebe:input source="=industry" target="industry" />
          <zeebe:input source="=objective" target="objective" />
          <zeebe:output source="=inputAnalysisResult" target="inputAnalysisResult" />
          <zeebe:output source="=refinedScenario" target="refinedScenario" />
          <zeebe:output source="=inputAnalysisSource" target="inputAnalysisSource" />
          <zeebe:output source="=inputIdentity" target="inputIdentity" />
          <zeebe:output source="=inputMissingFields" target="inputMissingFields" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_To_AnalyzeInput</bpmn:incoming>
      <bpmn:outgoing>Flow_AnalyzeInput_To_Trend</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- 五看 -->
    <bpmn:serviceTask id="Task_ScanIndustryTrend" name="看行业/趋势">
      <bpmn:documentation>在输入洞察场景「insightScenario」语境下，分析政治/经济/社会/技术环境、行业发展趋势与产业链，识别「价值转移」方向（趋势＞优势）——依据 S1/S2/S3/S4。本节点不再内嵌本体业务实例数据；以本体逐节点方法论（core:InsightMethod）为知识基线，检索与加工口径见 SKILL 对应节点「🔎 联网检索指令 + 🧮 数据加工与分析要求」。</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="scan-industry-trend" />
        <zeebe:ioMapping>
          <zeebe:input source="=insightScenario" target="insightScenario" />
          <zeebe:input source="=&#34;http://example.org/neinsight/env#&#34;" target="classPrefix" />
          <zeebe:input source="=&#34;http://example.org/neinsight/abox#&#34;" target="indPrefix" />
          <zeebe:output source="=industryTrendResult" target="industryTrendResult" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AnalyzeInput_To_Trend</bpmn:incoming>
      <bpmn:outgoing>Flow_Trend_To_Market</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ScanMarketCustomer" name="看市场/客户">
      <bpmn:documentation>在输入洞察场景语境下，分析目标市场规模与需求变化，研究客户场景/痛点（Pains）/潜在需求（Wants）——依据 S5。本节点不再内嵌本体业务实例数据；以本体逐节点方法论（core:InsightMethod）为知识基线，检索与加工口径见 SKILL 对应节点「🔎 联网检索指令 + 🧮 数据加工与分析要求」。</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="scan-market-customer" />
        <zeebe:ioMapping>
          <zeebe:input source="=insightScenario" target="insightScenario" />
          <zeebe:input source="=&#34;http://example.org/neinsight/env#&#34;" target="classPrefix" />
          <zeebe:input source="=&#34;http://example.org/neinsight/abox#&#34;" target="indPrefix" />
          <zeebe:output source="=marketCustomerResult" target="marketCustomerResult" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Trend_To_Market</bpmn:incoming>
      <bpmn:outgoing>Flow_Market_To_Competition</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ScanCompetition" name="看竞争">
      <bpmn:documentation>在输入洞察场景语境下，识别主要竞争对手的战略/优势/劣势/动向，找出差异化发力的空白点（竞品【待考】不指名）。本节点不再内嵌本体业务实例数据；以本体逐节点方法论（core:InsightMethod）为知识基线，检索与加工口径见 SKILL 对应节点「🔎 联网检索指令 + 🧮 数据加工与分析要求」。</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="scan-competition" />
        <zeebe:ioMapping>
          <zeebe:input source="=insightScenario" target="insightScenario" />
          <zeebe:input source="=&#34;http://example.org/neinsight/env#&#34;" target="classPrefix" />
          <zeebe:input source="=&#34;http://example.org/neinsight/abox#&#34;" target="indPrefix" />
          <zeebe:output source="=competitionResult" target="competitionResult" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Market_To_Competition</bpmn:incoming>
      <bpmn:outgoing>Flow_Competition_To_Self</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ScanSelf" name="看自己">
      <bpmn:documentation>在输入洞察场景语境下，客观评估自身资源/能力/优势/短板，确定在产业链中的位置与定位——依据 S6。本节点不再内嵌本体业务实例数据；以本体逐节点方法论（core:InsightMethod）为知识基线，检索与加工口径见 SKILL 对应节点「🔎 联网检索指令 + 🧮 数据加工与分析要求」。</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="scan-self" />
        <zeebe:ioMapping>
          <zeebe:input source="=insightScenario" target="insightScenario" />
          <zeebe:input source="=&#34;http://example.org/neinsight/env#&#34;" target="classPrefix" />
          <zeebe:input source="=&#34;http://example.org/neinsight/abox#&#34;" target="indPrefix" />
          <zeebe:output source="=selfAssessmentResult" target="selfAssessmentResult" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Competition_To_Self</bpmn:incoming>
      <bpmn:outgoing>Flow_Self_To_Opportunity</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ScanOpportunity" name="看机会（SPAN 定位）">
      <bpmn:documentation>在输入洞察场景语境下，综合前四看，用 SPAN 图（市场吸引力 × 竞争地位）定位机会点并判定优先级（高/中/低，阈值【待考】）。本节点不再内嵌本体业务实例数据，不再输出机会点实例；opportunityPriority 恒为 NONE，故高优先级分支与外发不触发（定义保留）。检索与加工口径见 SKILL 对应节点。</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="scan-opportunity" />
        <zeebe:ioMapping>
          <zeebe:input source="=insightScenario" target="insightScenario" />
          <zeebe:input source="=&#34;http://example.org/neinsight/env#&#34;" target="classPrefix" />
          <zeebe:input source="=&#34;http://example.org/neinsight/abox#&#34;" target="indPrefix" />
          <zeebe:output source="=opportunityResult" target="opportunityResult" />
          <zeebe:output source="=opportunityPriority" target="opportunityPriority" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Self_To_Opportunity</bpmn:incoming>
      <bpmn:outgoing>Flow_Opportunity_To_PriorityGateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- 网关②：机会点优先级 -->
    <bpmn:exclusiveGateway id="Gateway_PriorityChoice" name="机会点优先级">
      <bpmn:incoming>Flow_Opportunity_To_PriorityGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Priority_High</bpmn:outgoing>
      <bpmn:outgoing>Flow_Priority_NonHigh</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_MarkHighPriority" name="高优先级机会点标记与外发">
      <bpmn:documentation>存在高优先级机会点/关键风险时：标记该机会点并触发外发（RabbitMQ）——依据闸门①。本应用不再内嵌机会点实例数据，故该外发分支恒不触发（节点定义保留）；如后续接入外部机会点数据源可复用。</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="mark-high-priority" />
        <zeebe:ioMapping>
          <zeebe:input source="=insightScenario" target="insightScenario" />
          <zeebe:input source="=&#34;http://example.org/neinsight/env#&#34;" target="classPrefix" />
          <zeebe:input source="=&#34;http://example.org/neinsight/abox#&#34;" target="indPrefix" />
          <zeebe:output source="=alertDispatched" target="alertDispatched" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Priority_High</bpmn:incoming>
      <bpmn:outgoing>Flow_MarkHigh_To_ControlPoint</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- 三定 -->
    <bpmn:serviceTask id="Task_DefineControlPoint" name="定战略控制点">
      <bpmn:documentation>在输入洞察场景语境下，确定不易被模仿/超越的中长期核心竞争力，类型取自 {技术领先、成本优势、品牌、市场份额、价值链控制}——依据用户输入。本节点不再内嵌本体业务实例数据；以本体逐节点方法论（core:InsightMethod）为知识基线，检索与加工口径见 SKILL 对应节点「🔎 联网检索指令 + 🧮 数据加工与分析要求」。</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="define-control-point" />
        <zeebe:ioMapping>
          <zeebe:input source="=insightScenario" target="insightScenario" />
          <zeebe:input source="=&#34;http://example.org/neinsight/decision#&#34;" target="classPrefix" />
          <zeebe:input source="=&#34;http://example.org/neinsight/abox#&#34;" target="indPrefix" />
          <zeebe:output source="=controlPointResult" target="controlPointResult" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Priority_NonHigh</bpmn:incoming>
      <bpmn:incoming>Flow_MarkHigh_To_ControlPoint</bpmn:incoming>
      <bpmn:outgoing>Flow_ControlPoint_To_Objective</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_DefineObjective" name="定目标（SMART）">
      <bpmn:documentation>在输入洞察场景语境下，制定可量化、可细化的目标，按 SMART（具体/可衡量/可实现/相关性/有时效）校验（判据量纲【待考】）。本节点不再内嵌本体业务实例数据，不再输出目标实例；smartCompliant 恒为 false（SMART 规则 R3 定义保留）。检索与加工口径见 SKILL 对应节点。</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="define-objective" />
        <zeebe:ioMapping>
          <zeebe:input source="=insightScenario" target="insightScenario" />
          <zeebe:input source="=&#34;http://example.org/neinsight/decision#&#34;" target="classPrefix" />
          <zeebe:input source="=&#34;http://example.org/neinsight/abox#&#34;" target="indPrefix" />
          <zeebe:output source="=objectiveResult" target="objectiveResult" />
          <zeebe:output source="=smartCompliant" target="smartCompliant" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ControlPoint_To_Objective</bpmn:incoming>
      <bpmn:outgoing>Flow_Objective_To_Strategy</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_DefineStrategy" name="定策略">
      <bpmn:documentation>在输入洞察场景语境下，制定实现目标的行动方案（组织策略/产品策略/市场策略），考虑资源配置与优化。本节点不再内嵌本体业务实例数据；以本体逐节点方法论（core:InsightMethod）为知识基线，检索与加工口径见 SKILL 对应节点「🔎 联网检索指令 + 🧮 数据加工与分析要求」。</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="define-strategy" />
        <zeebe:ioMapping>
          <zeebe:input source="=insightScenario" target="insightScenario" />
          <zeebe:input source="=&#34;http://example.org/neinsight/decision#&#34;" target="classPrefix" />
          <zeebe:input source="=&#34;http://example.org/neinsight/abox#&#34;" target="indPrefix" />
          <zeebe:output source="=strategyResult" target="strategyResult" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Objective_To_Strategy</bpmn:incoming>
      <bpmn:outgoing>Flow_Strategy_To_Summarize</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Summarize" name="汇总输出">
      <bpmn:documentation>生成「洞察报告生成 SKILL」：以「角色设定 + 任务指令」为骨架，按「五看三定」逐节点给出「🔎 联网检索指令 + 🧮 数据加工与分析要求 + 📚 方法论来源」（取自本体 core:InsightMethod）；不内嵌本体业务实例数据（内部知识基线不通用）。落盘 skill/neinsight-&lt;instanceKey&gt;.md 供大模型生成洞察报告；同时经 Openllet 做一致性校验并回写摘要/实例 IRI/校验状态/SKILL 路径。</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="summarize-insight" />
        <zeebe:ioMapping>
          <zeebe:input source="=insightScenario" target="insightScenario" />
          <zeebe:input source="=&#34;http://example.org/neinsight/abox#&#34;" target="indPrefix" />
          <zeebe:output source="=insightSummary" target="insightSummary" />
          <zeebe:output source="=instanceIri" target="instanceIri" />
          <zeebe:output source="=ontologyValidationStatus" target="ontologyValidationStatus" />
          <zeebe:output source="=insightSkillPath" target="insightSkillPath" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Strategy_To_Summarize</bpmn:incoming>
      <bpmn:outgoing>Flow_Summarize_To_GenerateReport</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- 汇总后：把生成的 SKILL 导入大模型，生成洞察报告并落盘供下载 -->
    <bpmn:serviceTask id="Task_GenerateReport" name="生成洞察报告">
      <bpmn:documentation>读取汇总节点产出的「洞察报告生成 SKILL」，先按 SKILL 各节点「🔎 联网检索指令」经检索通道联网采集外部公开数据，再连同 SKILL 导入大模型加工分析生成《洞察报告》并落盘 report/neinsight-&lt;instanceKey&gt;-洞察报告.md，回写报告路径供下载；检索通道不可用退回「仅据 SKILL 方法论」生成，大模型不可用/失败时降级为直接落盘 SKILL 内容，报告落盘失败仅记日志、不阻断流程。</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generate-report" />
        <zeebe:ioMapping>
          <zeebe:input source="=insightScenario" target="insightScenario" />
          <zeebe:input source="=insightSkillPath" target="insightSkillPath" />
          <zeebe:output source="=insightReportPath" target="insightReportPath" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Summarize_To_GenerateReport</bpmn:incoming>
      <bpmn:outgoing>Flow_GenerateReport_To_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_01" name="流程结束">
      <bpmn:incoming>Flow_GenerateReport_To_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- 连线 -->
    <bpmn:sequenceFlow id="Flow_Start_To_AnalyzeInput" sourceRef="Start_01" targetRef="Task_AnalyzeInput" />
    <bpmn:sequenceFlow id="Flow_AnalyzeInput_To_Trend" sourceRef="Task_AnalyzeInput" targetRef="Task_ScanIndustryTrend" />
    <bpmn:sequenceFlow id="Flow_Trend_To_Market" sourceRef="Task_ScanIndustryTrend" targetRef="Task_ScanMarketCustomer" />
    <bpmn:sequenceFlow id="Flow_Market_To_Competition" sourceRef="Task_ScanMarketCustomer" targetRef="Task_ScanCompetition" />
    <bpmn:sequenceFlow id="Flow_Competition_To_Self" sourceRef="Task_ScanCompetition" targetRef="Task_ScanSelf" />
    <bpmn:sequenceFlow id="Flow_Self_To_Opportunity" sourceRef="Task_ScanSelf" targetRef="Task_ScanOpportunity" />
    <bpmn:sequenceFlow id="Flow_Opportunity_To_PriorityGateway" sourceRef="Task_ScanOpportunity" targetRef="Gateway_PriorityChoice" />
    <bpmn:sequenceFlow id="Flow_Priority_High" name="高优先级" sourceRef="Gateway_PriorityChoice" targetRef="Task_MarkHighPriority">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= opportunityPriority = &#34;HIGH&#34;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Priority_NonHigh" name="非高优先级" sourceRef="Gateway_PriorityChoice" targetRef="Task_DefineControlPoint">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= opportunityPriority != &#34;HIGH&#34;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_MarkHigh_To_ControlPoint" sourceRef="Task_MarkHighPriority" targetRef="Task_DefineControlPoint" />
    <bpmn:sequenceFlow id="Flow_ControlPoint_To_Objective" sourceRef="Task_DefineControlPoint" targetRef="Task_DefineObjective" />
    <bpmn:sequenceFlow id="Flow_Objective_To_Strategy" sourceRef="Task_DefineObjective" targetRef="Task_DefineStrategy" />
    <bpmn:sequenceFlow id="Flow_Strategy_To_Summarize" sourceRef="Task_DefineStrategy" targetRef="Task_Summarize" />
    <bpmn:sequenceFlow id="Flow_Summarize_To_GenerateReport" sourceRef="Task_Summarize" targetRef="Task_GenerateReport" />
    <bpmn:sequenceFlow id="Flow_GenerateReport_To_End" sourceRef="Task_GenerateReport" targetRef="End_01" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="NewEnergyInsightProcess">
      <bpmndi:BPMNShape id="Start_01_di" bpmnElement="Start_01">
        <dc:Bounds x="152" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="145" y="225" width="50" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AnalyzeInput_di" bpmnElement="Task_AnalyzeInput">
        <dc:Bounds x="300" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ScanIndustryTrend_di" bpmnElement="Task_ScanIndustryTrend">
        <dc:Bounds x="450" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ScanMarketCustomer_di" bpmnElement="Task_ScanMarketCustomer">
        <dc:Bounds x="600" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ScanCompetition_di" bpmnElement="Task_ScanCompetition">
        <dc:Bounds x="750" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ScanSelf_di" bpmnElement="Task_ScanSelf">
        <dc:Bounds x="900" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ScanOpportunity_di" bpmnElement="Task_ScanOpportunity">
        <dc:Bounds x="1050" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_PriorityChoice_di" bpmnElement="Gateway_PriorityChoice" isMarkerVisible="true">
        <dc:Bounds x="1200" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1194" y="145" width="62" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_MarkHighPriority_di" bpmnElement="Task_MarkHighPriority">
        <dc:Bounds x="1290" y="40" width="100" height="80" />
      </bpmndi:BPMNShape>
