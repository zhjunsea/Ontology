term:CustomerNeed
    a skos:Concept ;
    skos:inScheme <http://example.org/neinsight/term> ;
    skos:prefLabel "客户需求"@zh ;
    skos:prefLabel "Customer Need"@en ;
    skos:definition "NEInsight 本体类，表示“客户需求”。"@zh ;
