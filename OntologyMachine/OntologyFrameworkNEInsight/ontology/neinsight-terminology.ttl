term:CompetitiveLandscape
    a skos:Concept ;
    skos:inScheme <http://example.org/neinsight/term> ;
    skos:prefLabel "竞争格局"@zh ;
    skos:prefLabel "Competitive Landscape"@en ;
    skos:altLabel "竞争格局"@zh ;
    skos:definition "NEInsight 本体类，表示“竞争格局”。"@zh ;
    skos:broader term:EnvironmentScan .

term:Competitor
    a skos:Concept ;
    skos:inScheme <http://example.org/neinsight/term> ;
    skos:prefLabel "竞争对手"@zh ;
    skos:prefLabel "Competitor"@en ;
    skos:definition "NEInsight 本体类，表示“竞争对手”。"@zh ;
    skos:broader term:CompetitiveLandscape .

term:SelfAssessment
    a skos:Concept ;
    skos:inScheme <http://example.org/neinsight/term> ;
    skos:prefLabel "自身评估"@zh ;
    skos:prefLabel "Self Assessment"@en ;
    skos:altLabel "自身评估"@zh ;
    skos:altLabel "自评"@zh ;
    skos:definition "NEInsight 本体类，表示“自身评估”。"@zh ;
