term:SPANQuadrant
    a skos:Concept ;
    skos:inScheme <http://example.org/neinsight/term> ;
    skos:prefLabel "SPAN 象限（分类值类，不继承 Opportunity）"@zh ;
    skos:prefLabel "SPAN Quadrant"@en ;
    skos:altLabel "SPAN 象限"@zh ;
    skos:definition "NEInsight 本体类，表示“SPAN 象限（分类值类，不继承 Opportunity）”。"@zh .

term:Decision
    a skos:Concept ;
    skos:inScheme <http://example.org/neinsight/term> ;
    skos:prefLabel "决策（三定基类）"@zh ;
    skos:prefLabel "Decision"@en ;
