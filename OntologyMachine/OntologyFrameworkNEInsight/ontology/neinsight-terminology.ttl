@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix term: <http://example.org/neinsight/term/> .

<http://example.org/neinsight/term>
    a owl:Ontology ;
    a skos:ConceptScheme ;
    skos:prefLabel "新能源行业 IT 空间与云空间洞察术语体系"@zh ;
    skos:prefLabel "NEInsight Business Terminology"@en ;
    dct:created "2026-10-12"^^xsd:date ;
    dct:description "NEInsight 领域核心业务术语的标准化定义，术语一一对应本体类/属性 IRI，用于统一词义、支持 OntologyLabelMatcher / SkosSynonymReader。"@zh .

# ========================
# 核心类概念（镜像类层级）
# ========================
term:InsightElement
    a skos:Concept ;
    skos:inScheme <http://example.org/neinsight/term> ;
    skos:prefLabel "战略洞察要素"@zh ;
    skos:prefLabel "Insight Element"@en ;
    skos:definition "NEInsight 本体类，表示“战略洞察要素”。"@zh .

term:InsightDomain
    a skos:Concept ;
    skos:inScheme <http://example.org/neinsight/term> ;
    skos:prefLabel "洞察域"@zh ;
    skos:prefLabel "Insight Domain"@en ;
    skos:definition "NEInsight 本体类，表示“洞察域”。"@zh ;
    skos:broader term:InsightElement .

term:ITSpace
    a skos:Concept ;
    skos:inScheme <http://example.org/neinsight/term> ;
    skos:prefLabel "IT 空间"@zh ;
    skos:prefLabel "IT Space"@en ;
    skos:definition "NEInsight 本体类，表示“IT 空间”。"@zh ;
    skos:broader term:InsightDomain .

term:CloudSpace
    a skos:Concept ;
    skos:inScheme <http://example.org/neinsight/term> ;
    skos:prefLabel "云空间"@zh ;
    skos:prefLabel "Cloud Space"@en ;
    skos:definition "NEInsight 本体类，表示“云空间”。"@zh ;
    skos:broader term:InsightDomain .

term:CombinedSpace
    a skos:Concept ;
    skos:inScheme <http://example.org/neinsight/term> ;
    skos:prefLabel "联合空间"@zh ;
    skos:prefLabel "Combined Space"@en ;
    skos:definition "NEInsight 本体类，表示“联合空间”。"@zh ;
    skos:broader term:InsightDomain .

term:EnvironmentScan
    a skos:Concept ;
    skos:inScheme <http://example.org/neinsight/term> ;
    skos:prefLabel "环境扫描（五看基类）"@zh ;
    skos:prefLabel "Environment Scan"@en ;
    skos:definition "NEInsight 本体类，表示“环境扫描（五看基类）”。"@zh ;
    skos:broader term:InsightElement .

term:IndustryTrend
    a skos:Concept ;
    skos:inScheme <http://example.org/neinsight/term> ;
    skos:prefLabel "行业趋势"@zh ;
    skos:prefLabel "Industry Trend"@en ;
    skos:altLabel "行业趋势"@zh ;
    skos:altLabel "产业趋势"@zh ;
    skos:definition "NEInsight 本体类，表示“行业趋势”。"@zh ;
    skos:broader term:EnvironmentScan .

term:MacroFactor
    a skos:Concept ;
    skos:inScheme <http://example.org/neinsight/term> ;
    skos:prefLabel "宏观因素"@zh ;
    skos:prefLabel "Macro Factor"@en ;
    skos:definition "NEInsight 本体类，表示“宏观因素”。"@zh ;
    skos:broader term:IndustryTrend .

term:ValueTransfer
    a skos:Concept ;
    skos:inScheme <http://example.org/neinsight/term> ;
    skos:prefLabel "价值转移"@zh ;
    skos:prefLabel "Value Transfer"@en ;
    skos:altLabel "价值转移方向"@zh ;
    skos:definition "NEInsight 本体类，表示“价值转移”。"@zh ;
    skos:broader term:IndustryTrend .

term:MarketCustomer
    a skos:Concept ;
    skos:inScheme <http://example.org/neinsight/term> ;
    skos:prefLabel "市场与客户"@zh ;
    skos:prefLabel "Market Customer"@en ;
    skos:altLabel "市场与客户"@zh ;
    skos:definition "NEInsight 本体类，表示“市场与客户”。"@zh ;
    skos:broader term:EnvironmentScan .

term:Market
    a skos:Concept ;
    skos:inScheme <http://example.org/neinsight/term> ;
    skos:prefLabel "市场"@zh ;
    skos:prefLabel "Market"@en ;
    skos:definition "NEInsight 本体类，表示“市场”。"@zh ;
    skos:broader term:MarketCustomer .

term:Customer
    a skos:Concept ;
    skos:inScheme <http://example.org/neinsight/term> ;
    skos:prefLabel "客户"@zh ;
    skos:prefLabel "Customer"@en ;
    skos:definition "NEInsight 本体类，表示“客户”。"@zh ;
    skos:broader term:MarketCustomer .

term:CustomerPainPoint
    a skos:Concept ;
    skos:inScheme <http://example.org/neinsight/term> ;
    skos:prefLabel "客户痛点"@zh ;
    skos:prefLabel "Customer Pain Point"@en ;
    skos:definition "NEInsight 本体类，表示“客户痛点”。"@zh ;
