# 数据属性概念
# ========================
term:domainCode
    a skos:Concept ;
    skos:inScheme <http://example.org/neinsight/term> ;
    skos:prefLabel "洞察域编码"@zh ;
    skos:prefLabel "domain Code"@en ;
    skos:definition "NEInsight 数据属性，宿主类“洞察域”，取值类型 string。"@zh .

term:marketAttractiveness
    a skos:Concept ;
    skos:inScheme <http://example.org/neinsight/term> ;
    skos:prefLabel "市场吸引力评分"@zh ;
    skos:prefLabel "market Attractiveness"@en ;
    skos:definition "NEInsight 数据属性，宿主类“机会点”，取值类型 decimal。"@zh .

term:competitivePosition
    a skos:Concept ;
    skos:inScheme <http://example.org/neinsight/term> ;
    skos:prefLabel "竞争地位评分"@zh ;
