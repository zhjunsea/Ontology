# 对象属性概念
# ========================
term:belongsToDomain
    a skos:Concept ;
    skos:inScheme <http://example.org/neinsight/term> ;
    skos:prefLabel "属于洞察域"@zh ;
    skos:prefLabel "belongs To Domain"@en ;
    skos:definition "NEInsight 对象属性，联接“战略洞察要素”与“洞察域”。"@zh .

term:hasElement
    a skos:Concept ;
    skos:inScheme <http://example.org/neinsight/term> ;
    skos:prefLabel "含洞察要素"@zh ;
    skos:prefLabel "has Element"@en ;
    skos:definition "NEInsight 对象属性，联接“洞察域”与“战略洞察要素”。"@zh .

term:hasMacroFactor
    a skos:Concept ;
    skos:inScheme <http://example.org/neinsight/term> ;
    skos:prefLabel "含宏观因素"@zh ;
    skos:prefLabel "has Macro Factor"@en ;
    skos:definition "NEInsight 对象属性，联接“行业趋势”与“宏观因素”。"@zh .

term:macroFactorOf
    a skos:Concept ;
    skos:inScheme <http://example.org/neinsight/term> ;
