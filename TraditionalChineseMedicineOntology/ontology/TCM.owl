<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns="http://www.tcm-classics.org/tcm#"
     xml:base="http://www.tcm-classics.org/tcm"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#">
    
    <owl:Ontology rdf:about="http://www.tcm-classics.org/tcm">
        <dc:title>伤寒杂病论（桂林古本）经方本体·核心框架</dc:title>
        <dc:description>通用顶层类、跨模块桥接属性、通用数据/注释属性。不包含方剂或药物专属定义，保持核心独立性。</dc:description>
        <owl:versionInfo>5.0-CoreOnly</owl:versionInfo>
        <!-- 导入核心子模块，但不导入具体 ABox -->
        <owl:imports rdf:resource="http://www.tcm-classics.org/liujing"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/bagang"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/maixiang"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/bingzheng"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/fangji"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/yaowu"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jianjia"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/shexiang"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/swrl/rules"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/skos/tcm"/>
    </owl:Ontology>

    <!-- ==================== 通用顶层类 ==================== -->
    <owl:Class rdf:about="http://www.tcm-classics.org/tcm#DiseasePattern">
        <rdfs:label xml:lang="zh">病证</rdfs:label>
        <rdfs:comment>伤寒杂病论中所有证候模式的通用父类。</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://www.tcm-classics.org/tcm#Herb">
        <rdfs:label xml:lang="zh">药物</rdfs:label>
        <rdfs:comment>经方药物通用父类。具体实例定义于 yaowu.owl。</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://www.tcm-classics.org/tcm#SymptomSign">
        <rdfs:label xml:lang="zh">症状体征</rdfs:label>
        <rdfs:comment>临床症状体征通用父类。</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://www.tcm-classics.org/tcm#ClinicalCase">
        <rdfs:label xml:lang="zh">临床案例</rdfs:label>
        <rdfs:comment xml:lang="zh">代表一次完整的患者就诊记录，供SWRL推理使用。</rdfs:comment>
    </owl:Class>

    <!-- ==================== 跨模块对象属性 ==================== -->
    <!-- 病证相关 -->
    <owl:ObjectProperty rdf:about="http://www.tcm-classics.org/tcm#belongs_to_channel">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#DiseasePattern"/>
        <rdfs:range rdf:resource="http://www.tcm-classics.org/liujing#SixChannelSyndrome"/>
        <rdfs:label xml:lang="zh">归属六经</rdfs:label>
        <rdfs:comment>将病证关联至六经证候实例。</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.tcm-classics.org/tcm#has_pulse">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#DiseasePattern"/>
        <rdfs:range rdf:resource="http://www.tcm-classics.org/maixiang#PulseManifestation"/>
        <rdfs:label xml:lang="zh">见脉</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.tcm-classics.org/tcm#has_bagang_element">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#DiseasePattern"/>
        <rdfs:range rdf:resource="http://www.tcm-classics.org/bagang#EightPrincipleElement"/>
        <rdfs:label xml:lang="zh">八纲要素</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.tcm-classics.org/tcm#symptom_indicates_bagang">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#SymptomSign"/>
        <rdfs:range rdf:resource="http://www.tcm-classics.org/bagang#EightPrincipleElement"/>
        <rdfs:label xml:lang="zh">症状提示八纲</rdfs:label>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="http://www.tcm-classics.org/tcm#hasConfirmedPattern">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#ClinicalCase"/>
        <rdfs:range rdf:resource="http://www.tcm-classics.org/tcm#DiseasePattern"/>
        <rdfs:label xml:lang="zh">已确认方证</rdfs:label>
        <rdfs:comment xml:lang="zh">经四诊合参后确认成立的方证。由临床录入或上游推理产生。</rdfs:comment>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="http://www.tcm-classics.org/tcm#hasConcomitantPathology">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#ClinicalCase"/>
        <rdfs:range rdf:resource="http://www.tcm-classics.org/jianjia#ConcomitantPathology"/>
        <rdfs:label xml:lang="zh">已确认兼夹</rdfs:label>
        <rdfs:comment xml:lang="zh">经四诊合参后确认存在的兼夹证（水饮、瘀血、食积、气滞、气逆）。</rdfs:comment>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="http://www.tcm-classics.org/tcm#hasCombinationAlert">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#ClinicalCase"/>
        <rdfs:range rdf:resource="http://www.tcm-classics.org/tcm#DiseasePattern"/>
        <rdfs:label xml:lang="zh">合方提示</rdfs:label>
        <rdfs:comment xml:lang="zh">提示该患者存在合方机会。应用层据此查询jj:CombinesWith及jj:combinationResult。</rdfs:comment>
    </owl:ObjectProperty>

    <!-- 症状与病证互逆 -->
    <owl:ObjectProperty rdf:about="http://www.tcm-classics.org/tcm#has_symptom">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#DiseasePattern"/>
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#ClinicalCase"/>
        <rdfs:range rdf:resource="http://www.tcm-classics.org/tcm#SymptomSign"/>
        <rdfs:label xml:lang="zh">具有症状</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.tcm-classics.org/tcm#part_of_pattern">
        <owl:inverseOf rdf:resource="http://www.tcm-classics.org/tcm#has_symptom"/>
        <rdfs:label xml:lang="zh">所属病证</rdfs:label>
    </owl:ObjectProperty>

    <!-- 药物相关（桥接 yaowu 与 zhengzhuang） -->
    <owl:ObjectProperty rdf:about="http://www.tcm-classics.org/tcm#herb_treats_symptom">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#Herb"/>
        <rdfs:range rdf:resource="http://www.tcm-classics.org/tcm#SymptomSign"/>
        <rdfs:label xml:lang="zh">药物主治症状</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.tcm-classics.org/tcm#herb_has_bagang_property">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#Herb"/>
        <rdfs:range rdf:resource="http://www.tcm-classics.org/bagang#EightPrincipleElement"/>
        <rdfs:label xml:lang="zh">药物八纲药性</rdfs:label>
    </owl:ObjectProperty>

    <!-- 临床案例专用 -->
    <owl:ObjectProperty rdf:about="http://www.tcm-classics.org/tcm#current_primary_pattern">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#ClinicalCase"/>
        <rdfs:range rdf:resource="http://www.tcm-classics.org/tcm#DiseasePattern"/>
        <rdfs:label xml:lang="zh">当前主证</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.tcm-classics.org/tcm#has_residual_symptom">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#ClinicalCase"/>
        <rdfs:range rdf:resource="http://www.tcm-classics.org/tcm#SymptomSign"/>
        <rdfs:label xml:lang="zh">残余症状</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.tcm-classics.org/tcm#has_primary_pattern">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#ClinicalCase"/>
        <rdfs:range rdf:resource="http://www.tcm-classics.org/tcm#DiseasePattern"/>
        <rdfs:label xml:lang="zh">推理主证</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.tcm-classics.org/tcm#suggested_new_pattern">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#ClinicalCase"/>
        <rdfs:range rdf:resource="http://www.tcm-classics.org/tcm#DiseasePattern"/>
        <rdfs:label xml:lang="zh">建议转入方证</rdfs:label>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="http://www.tcm-classics.org/tcm#suggestedFormulaPattern">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#ClinicalCase"/>
        <rdfs:range rdf:resource="http://www.tcm-classics.org/tcm#DiseasePattern"/>
        <rdfs:label xml:lang="zh">建议方证</rdfs:label>
        <rdfs:comment xml:lang="zh">SWRL推理输出的目标方证建议。需临床医师最终确认。</rdfs:comment>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="http://www.tcm-classics.org/tcm#hasContraindicationWarning">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#ClinicalCase"/>
        <rdfs:range rdf:resource="http://www.tcm-classics.org/jianjia#ModificationContraindication"/>
        <rdfs:label xml:lang="zh">禁忌警告</rdfs:label>
        <rdfs:comment xml:lang="zh">当前方证所属六经关联的禁忌条目。触发后需人工复核。</rdfs:comment>
    </owl:ObjectProperty>
    <!-- ==================== 通用数据属性 ==================== -->
    <owl:DatatypeProperty rdf:about="http://www.tcm-classics.org/tcm#clause_number">
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:label xml:lang="zh">条文编号</rdfs:label>
        <rdfs:comment>桂林古本条目标号，如【3.12】【金匮·痰饮-35】。</rdfs:comment>
    </owl:DatatypeProperty>

    

    <!-- ==================== 通用注释属性 ==================== -->
    <owl:AnnotationProperty rdf:about="http://www.tcm-classics.org/tcm#source_text">
        <rdfs:label xml:lang="zh">原文出处</rdfs:label>
        <rdfs:comment>桂林古本原文完整引用。</rdfs:comment>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="http://www.tcm-classics.org/tcm#hulaoshi_note">
        <rdfs:label xml:lang="zh">胡老按语</rdfs:label>
        <rdfs:comment>胡希恕先生学术阐释。</rdfs:comment>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="http://www.tcm-classics.org/tcm#clinical_key_points">
        <rdfs:label xml:lang="zh">临床眼目</rdfs:label>
        <rdfs:comment>“但见一证便是”之核心指征。</rdfs:comment>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="http://www.tcm-classics.org/tcm#modern_application">
        <rdfs:label xml:lang="zh">现代应用</rdfs:label>
        <rdfs:comment>后世经方家应用经验。</rdfs:comment>
    </owl:AnnotationProperty>

    <!-- SKOS 桥接 -->
    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#exactMatch">
        <rdfs:label xml:lang="zh">SKOS精确匹配</rdfs:label>
    </owl:AnnotationProperty>

</rdf:RDF>