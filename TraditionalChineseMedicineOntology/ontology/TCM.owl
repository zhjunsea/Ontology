<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns="http://www.tcm-classics.org/tcm#"
     xml:base="http://www.tcm-classics.org/tcm"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#">
    
    <owl:Ontology rdf:about="http://www.tcm-classics.org/tcm">
        <dc:title>伤寒杂病论（桂林古本）经方本体·核心框架</dc:title>
        <dc:description>含方药、病证通用顶层类与跨模块桥接属性。不依赖任何具体子模块，保持核心独立性。</dc:description>
        <owl:versionInfo>4.0-CoreIndependent</owl:versionInfo>
        <!-- 仅导入其他核心定义模块，不导入具体 ABox 模块（如 yaowu, fangji 等） -->
        <owl:imports rdf:resource="http://www.tcm-classics.org/liujing"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/bagang"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/maixiang"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/bingzheng"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/fangji"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/yaowu"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/skos/tcm"/>
    </owl:Ontology>

    <!-- ========================================== -->
    <!-- 通用框架类（仅限 TCM 命名空间） -->
    <!-- ========================================== -->
    <owl:Class rdf:about="http://www.tcm-classics.org/tcm#DiseasePattern">
        <rdfs:label xml:lang="zh">病证</rdfs:label>
        <rdfs:comment>伤寒杂病论中所有证候模式的通用父类。</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://www.tcm-classics.org/tcm#Formula">
        <rdfs:label xml:lang="zh">方剂</rdfs:label>
        <rdfs:comment>经方方剂通用父类。</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="http://www.tcm-classics.org/tcm#FormulaCategory">
        <rdfs:label xml:lang="zh">方剂类别</rdfs:label>
        <rdfs:comment>经方类方分类体系，如桂枝汤类、柴胡汤类等。</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://www.tcm-classics.org/tcm#Herb">
        <rdfs:label xml:lang="zh">药物</rdfs:label>
        <rdfs:comment>经方药物通用父类。具体实例、药性数据定义于 yaowu.owl 中。本类仅作为跨模块引用的语义锚点。</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://www.tcm-classics.org/tcm#SymptomSign">
        <rdfs:label xml:lang="zh">症状体征</rdfs:label>
        <rdfs:comment>临床症状体征通用父类。</rdfs:comment>
    </owl:Class>

    <!-- ========================================== -->
    <!-- 跨模块对象属性（仅限 TCM 命名空间） -->
    <!-- ========================================== -->
    
    <!-- 病证相关 -->
    <owl:ObjectProperty rdf:about="http://www.tcm-classics.org/tcm#belongs_to_channel">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#DiseasePattern"/>
        <rdfs:range rdf:resource="http://www.tcm-classics.org/liujing#SixChannelSyndrome"/>
        <rdfs:label xml:lang="zh">归属六经</rdfs:label>
        <rdfs:comment>将病证关联至 liujing.owl 中定义的六经证候实例。</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.tcm-classics.org/tcm#has_pulse">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#DiseasePattern"/>
        <rdfs:range rdf:resource="http://www.tcm-classics.org/maixiang#PulseManifestation"/>
        <rdfs:label xml:lang="zh">见脉</rdfs:label>
        <rdfs:comment>将病证关联至 maixiang.owl 中定义的脉象实例。</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.tcm-classics.org/tcm#has_bagang_element">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#DiseasePattern"/>
        <rdfs:range rdf:resource="http://www.tcm-classics.org/bagang#EightPrincipleElement"/>
        <rdfs:label xml:lang="zh">八纲要素</rdfs:label>
        <rdfs:comment>将病证直接关联至 bagang.owl 中定义的八纲要素。</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.tcm-classics.org/tcm#symptom_indicates_bagang">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#SymptomSign"/>
        <rdfs:range rdf:resource="http://www.tcm-classics.org/bagang#EightPrincipleElement"/>
        <rdfs:label xml:lang="zh">症状提示八纲</rdfs:label>
        <rdfs:comment>该症状体征所提示的八纲要素。一个症状可提示多个八纲。</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.tcm-classics.org/tcm#has_symptom">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#DiseasePattern"/>
        <rdfs:range rdf:resource="http://www.tcm-classics.org/tcm#SymptomSign"/>
        <rdfs:label xml:lang="zh">具有症状</rdfs:label>
        <rdfs:comment>病证所包含的症状体征。</rdfs:comment>
    </owl:ObjectProperty>

    <!-- 方剂相关 -->
    <owl:ObjectProperty rdf:about="http://www.tcm-classics.org/tcm#indicated_for">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#Formula"/>
        <rdfs:range rdf:resource="http://www.tcm-classics.org/tcm#DiseasePattern"/>
        <rdfs:label xml:lang="zh">主治证候</rdfs:label>
        <rdfs:comment>方剂主治的病证。为方证相应之核心链接。</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.tcm-classics.org/tcm#composed_of">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#Formula"/>
        <rdfs:range rdf:resource="http://www.tcm-classics.org/tcm#Herb"/>
        <rdfs:label xml:lang="zh">组成药物</rdfs:label>
        <rdfs:comment>方剂所包含的药物。具体药物剂量以 original_dosage 数据属性记录。</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.tcm-classics.org/tcm#formula_matches_bagang">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#Formula"/>
        <rdfs:range rdf:resource="http://www.tcm-classics.org/bagang#EightPrincipleElement"/>
        <rdfs:label xml:lang="zh">方证八纲对应</rdfs:label>
        <rdfs:comment>方剂所对应的八纲病机，支持纯八纲维度的方剂检索与推理。</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.tcm-classics.org/tcm#belongs_to_formula_category">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#Formula"/>
        <rdfs:range rdf:resource="http://www.tcm-classics.org/tcm#FormulaCategory"/>
        <rdfs:label xml:lang="zh">归属方剂类别</rdfs:label>
        <rdfs:comment>方剂所属之类方分类，体现经方衍化规律。</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.tcm-classics.org/tcm#contraindicated_for">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#Formula"/>
        <rdfs:range rdf:resource="http://www.tcm-classics.org/tcm#DiseasePattern"/>
        <rdfs:label xml:lang="zh">禁忌证候</rdfs:label>
        <rdfs:comment>该方剂明确禁用的病证。</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.tcm-classics.org/tcm#derived_from">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#Formula"/>
        <rdfs:range rdf:resource="http://www.tcm-classics.org/tcm#Formula"/>
        <rdfs:label xml:lang="zh">衍化自</rdfs:label>
        <rdfs:comment>方剂之间的衍化关系，支持类方谱系推理。</rdfs:comment>
    </owl:ObjectProperty>

    <!-- 药物相关（核心桥接属性，不依赖 yaowu 命名空间） -->
    <owl:ObjectProperty rdf:about="http://www.tcm-classics.org/tcm#herb_treats_symptom">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#Herb"/>
        <rdfs:range rdf:resource="http://www.tcm-classics.org/tcm#SymptomSign"/>
        <rdfs:label xml:lang="zh">药物主治症状</rdfs:label>
        <rdfs:comment>单味药所主治的症状体征。</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.tcm-classics.org/tcm#herb_has_bagang_property">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#Herb"/>
        <rdfs:range rdf:resource="http://www.tcm-classics.org/bagang#EightPrincipleElement"/>
        <rdfs:label xml:lang="zh">药物八纲药性</rdfs:label>
        <rdfs:comment>单味药的八纲属性归类（胡希恕体系）。</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.tcm-classics.org/tcm#herb_belongs_to_formula">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#Herb"/>
        <rdfs:range rdf:resource="http://www.tcm-classics.org/tcm#Formula"/>
        <rdfs:label xml:lang="zh">药物归属方剂</rdfs:label>
        <rdfs:comment>composed_of 的逆属性，支持反向查询。</rdfs:comment>
        <owl:inverseOf rdf:resource="http://www.tcm-classics.org/tcm#composed_of"/>
    </owl:ObjectProperty>

    <!-- ========================================== -->
    <!-- 数据属性（通用） -->
    <!-- ========================================== -->
    <owl:DatatypeProperty rdf:about="http://www.tcm-classics.org/tcm#original_dosage">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#Herb"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="zh">原文剂量</rdfs:label>
        <rdfs:comment>桂林古本原始剂量记录，含汉代度量衡单位。</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.tcm-classics.org/tcm#clause_number">
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:label xml:lang="zh">条文编号</rdfs:label>
        <rdfs:comment>桂林古本条文编号，格式如【3.12】【金匮·痰饮-35】。</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.tcm-classics.org/tcm#decoction_instruction">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#Formula"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:label xml:lang="zh">煎服法原文</rdfs:label>
        <rdfs:comment>桂林古本中方剂煎煮与服用方法的完整原文记录。</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.tcm-classics.org/tcm#post_decoction_note">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#Formula"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:label xml:lang="zh">方后注</rdfs:label>
        <rdfs:comment>方剂条文之后的附加说明，包括服药反应、禁忌、加减法、调护要求等。</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.tcm-classics.org/tcm#formula_modification">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#Formula"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:label xml:lang="zh">加减法</rdfs:label>
        <rdfs:comment>原文所载方剂随证加减规则。</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- ========================================== -->
    <!-- 注释属性（通用） -->
    <!-- ========================================== -->
    <owl:AnnotationProperty rdf:about="http://www.tcm-classics.org/tcm#source_text">
        <rdfs:label xml:lang="zh">原文出处</rdfs:label>
        <rdfs:comment>条文或方剂的桂林古本原文完整引用。</rdfs:comment>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="http://www.tcm-classics.org/tcm#hulaoshi_note">
        <rdfs:label xml:lang="zh">胡老按语</rdfs:label>
        <rdfs:comment>胡希恕先生对该病证、方剂或条文的学术阐释与临床经验总结。</rdfs:comment>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="http://www.tcm-classics.org/tcm#clinical_key_points">
        <rdfs:label xml:lang="zh">临床眼目</rdfs:label>
        <rdfs:comment>胡老提炼的该方证辨证关键点，即"但见一证便是"之核心指征。</rdfs:comment>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="http://www.tcm-classics.org/tcm#modern_application">
        <rdfs:label xml:lang="zh">现代应用</rdfs:label>
        <rdfs:comment>胡老及后世经方家对该方的现代疾病应用经验。</rdfs:comment>
    </owl:AnnotationProperty>

    <!-- ========================================== -->
    <!-- SKOS 桥接声明 -->
    <!-- ========================================== -->
    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#exactMatch">
        <rdfs:label xml:lang="zh">SKOS精确匹配</rdfs:label>
        <rdfs:comment>用于将本体中的实体与SKOS词汇表中的概念进行精确对齐。</rdfs:comment>
    </owl:AnnotationProperty>

</rdf:RDF>