    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#QiShangChongXiong">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">气上冲胸</rdfs:label>
        <skos:altLabel xml:lang="zh">气从少腹上冲心</skos:altLabel>
        <skos:altLabel xml:lang="zh">奔豚气</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·奔豚气病篇第2条：奔豚气上冲胸……奔豚汤主之。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">奔豚气为水饮或寒气从少腹上冲。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#YeJianJiaZhong">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">夜间加重</rdfs:label>
        <skos:altLabel xml:lang="zh">入夜加重</skos:altLabel>
        <skos:altLabel xml:lang="zh">夜间痛甚</skos:altLabel>
        <skos:altLabel xml:lang="zh">暮甚</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <zz:isInferred rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</zz:isInferred>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:huxishuExplanation>胡老：瘀血证常入暮即发，躁扰或疼痛夜间加重。</zz:huxishuExplanation>
        <rdfs:comment xml:lang="zh">瘀血特征性加重规律。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#YiQi">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">噫气</rdfs:label>
        <skos:altLabel xml:lang="zh">嗳气</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第161条：伤寒发汗，若吐若下，解后，心下痞硬，噫气不除者，旋覆代赭汤主之。</zz:originalDescription>
        <zz:originalDescription>伤寒论第157条：心下痞硬，干噫食臭。</zz:originalDescription>
        <zz:huxishuExplanation>胡老：噫气不除为胃虚气逆之特异性表现。</zz:huxishuExplanation>
        <rdfs:comment xml:lang="zh">胃虚气逆。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#BuOu">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">不呕</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#BanBiaoBanLi"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第147条：渴而不呕。柴胡桂枝干姜汤主之。</zz:originalDescription>
        <zz:huxishuExplanation>胡老：小柴胡汤证"喜呕"，本证"不呕而渴"。</zz:huxishuExplanation>
        <rdfs:comment xml:lang="zh">否定性症状，方证鉴别之眼目。</rdfs:comment>
    </owl:NamedIndividual>

