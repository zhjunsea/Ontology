        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第40条：伤寒表不解，心下有水气……或噎……小青龙汤主之。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">水饮内停、气机受阻。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#ZhengKuai">
