<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
    xmlns="http://www.tcm-classics.org/zhengzhuangtizheng#"
    xml:base="http://www.tcm-classics.org/zhengzhuangtizheng"
    xmlns:zz="http://www.tcm-classics.org/zhengzhuangtizheng#"
    xmlns:bg="http://www.tcm-classics.org/bagang#"
    xmlns:tcm="http://www.tcm-classics.org/shanghan/guilin#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:dc="http://purl.org/dc/elements/1.1/">

    <!-- ========================================== -->
    <!-- 本体元数据 -->
    <!-- ========================================== -->
    <owl:Ontology rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng">
        <dc:title>症状体征本体（桂林古本+胡希恕方证指征·完整版）</dc:title>
        <dc:description>严格基于《伤寒杂病论》桂林古本条文及《胡希恕讲伤寒杂病论》构建。复用TCM顶层类与跨模块属性。</dc:description>
        <owl:versionInfo>2.0-Complete</owl:versionInfo>
        <owl:imports rdf:resource="http://www.tcm-classics.org/shanghan/guilin"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/skos/zhengzhuangtizheng"/>
    </owl:Ontology>

    <!-- ========================================== -->
    <!-- 注释属性 -->
    <!-- ========================================== -->
    <owl:AnnotationProperty rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#huxishuExplanation">
        <rdfs:label xml:lang="zh">胡老释义</rdfs:label>
        <rdfs:comment xml:lang="zh">摘自《胡希恕讲伤寒杂病论》或《胡希恕伤寒论讲座》对该症状的白话解释与临床鉴别要点</rdfs:comment>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#guilinClauseRef">
        <rdfs:label xml:lang="zh">桂林古本条文</rdfs:label>
        <rdfs:comment xml:lang="zh">该症状首次出现或最具代表性的桂林古本条文编号</rdfs:comment>
    </owl:AnnotationProperty>

    <!-- ========================================== -->
    <!-- 数据属性 -->
    <!-- ========================================== -->
    <owl:DatatypeProperty rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#originalDescription">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/shanghan/guilin#SymptomSign"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
        <rdfs:label xml:lang="zh">原文描述</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#degreeQualifier">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/shanghan/guilin#SymptomSign"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
        <rdfs:label xml:lang="zh">程度限定</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#temporalQualifier">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/shanghan/guilin#SymptomSign"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
        <rdfs:label xml:lang="zh">时序限定</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#locationQualifier">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/shanghan/guilin#SymptomSign"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
        <rdfs:label xml:lang="zh">部位限定</rdfs:label>
    </owl:DatatypeProperty>

    <!-- ========================================== -->
    <!-- 对象属性（复用TCM的symptom_indicates_bagang，另保留part_of_pattern和co_occurs_with） -->
    <!-- ========================================== -->
    <owl:ObjectProperty rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#part_of_pattern">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/shanghan/guilin#SymptomSign"/>
        <rdfs:range rdf:resource="http://www.tcm-classics.org/shanghan/guilin#DiseasePattern"/>
        <rdfs:label xml:lang="zh">属于证候</rdfs:label>
        <rdfs:comment xml:lang="zh">该症状体征所属的方证模式。</rdfs:comment>
    </owl:ObjectProperty>

    <owl:SymmetricProperty rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#co_occurs_with">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/shanghan/guilin#SymptomSign"/>
        <rdfs:range rdf:resource="http://www.tcm-classics.org/shanghan/guilin#SymptomSign"/>
        <rdfs:label xml:lang="zh">并见症状</rdfs:label>
        <rdfs:comment xml:lang="zh">在桂林古本条文中与该症状固定并见的其他症状。</rdfs:comment>
    </owl:SymmetricProperty>

    <!-- ========================================== -->
    <!-- 顶层类与子类（复用TCM的SymptomSign） -->
    <!-- ========================================== -->
    <owl:Class rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom">
        <rdfs:subClassOf rdf:resource="http://www.tcm-classics.org/shanghan/guilin#SymptomSign"/>
        <rdfs:label xml:lang="zh">自觉症状</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign">
        <rdfs:subClassOf rdf:resource="http://www.tcm-classics.org/shanghan/guilin#SymptomSign"/>
        <rdfs:label xml:lang="zh">他觉体征</rdfs:label>
    </owl:Class>

    <!-- ========================================== -->
    <!-- 完整个体（56个核心方证指征） -->
    <!-- ========================================== -->

    <!-- === 太阳表证 === -->
    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#EHan">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">恶寒</rdfs:label>
        <zz:originalDescription xml:lang="zh">恶寒</zz:originalDescription>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Biao"/>
        <zz:huxishuExplanation xml:lang="zh">恶寒是表证的特异性指征。只要有一分恶寒，便有一分表证。加衣被不减者为恶寒，得温则减者为畏寒，二者不可混同。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【3.1】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#TouXiangQiangTong">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">头项强痛</rdfs:label>
        <zz:originalDescription xml:lang="zh">头项强痛</zz:originalDescription>
        <zz:locationQualifier xml:lang="zh">头项</zz:locationQualifier>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Biao"/>
        <zz:huxishuExplanation xml:lang="zh">太阳经脉循行于头项，邪客于表，经气不利，故头项拘急疼痛。此为太阳表证定位症状。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【3.1】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#FaRe">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">发热</rdfs:label>
        <zz:originalDescription xml:lang="zh">发热</zz:originalDescription>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Yang"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <zz:huxishuExplanation xml:lang="zh">发热是正气抗邪的反应。表证发热必伴恶寒；里证发热不恶寒反恶热。单言发热不足以定病位。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【3.1】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#HanChu">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">汗出</rdfs:label>
        <zz:originalDescription xml:lang="zh">汗出</zz:originalDescription>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Biao"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <zz:huxishuExplanation xml:lang="zh">表证汗出为中风（桂枝汤证），无汗为伤寒（麻黄汤证）。汗出反映营卫不和、腠理疏松。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【3.2】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#WuHan">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">无汗</rdfs:label>
        <zz:originalDescription xml:lang="zh">无汗</zz:originalDescription>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Biao"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <zz:huxishuExplanation xml:lang="zh">表实无汗，腠理闭塞，为麻黄汤证眼目。与汗出相对，二者不可混淆。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【3.3】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#BiMing">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">鼻鸣</rdfs:label>
        <zz:originalDescription xml:lang="zh">鼻鸣</zz:originalDescription>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Biao"/>
        <zz:huxishuExplanation xml:lang="zh">风寒束表，肺气不利，鼻窍不通而作响。为桂枝汤证兼症之一。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【3.12】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#GanOu">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">干呕</rdfs:label>
        <zz:originalDescription xml:lang="zh">干呕</zz:originalDescription>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Biao"/>
        <zz:huxishuExplanation xml:lang="zh">表邪外束，胃气上逆所致。非里证呕吐，乃表证影响胃气和降。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【3.12】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#ShenTiTengTong">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">身体疼痛</rdfs:label>
        <zz:originalDescription xml:lang="zh">身体疼痛</zz:originalDescription>
        <zz:locationQualifier xml:lang="zh">身体</zz:locationQualifier>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Biao"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <zz:huxishuExplanation xml:lang="zh">寒邪束表，营卫凝滞，经络不通则痛。为麻黄汤证重要指征。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【3.3】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <!-- === 少阳半表半里证 === -->
    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#KouKu">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">口苦</rdfs:label>
        <zz:originalDescription xml:lang="zh">口苦</zz:originalDescription>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#BanBiaoBanLi"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <zz:huxishuExplanation xml:lang="zh">口苦是少阳病第一指征。胆火上炎所致。凡见口苦，首虑半表半里。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【5.1】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#YanGan">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">咽干</rdfs:label>
        <zz:originalDescription xml:lang="zh">咽干</zz:originalDescription>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#BanBiaoBanLi"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <zz:huxishuExplanation xml:lang="zh">少阳郁热伤津，故咽干。与阳明大渴引饮不同，此为轻度津伤。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【5.1】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#MuXuan">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">目眩</rdfs:label>
        <zz:originalDescription xml:lang="zh">目眩</zz:originalDescription>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#BanBiaoBanLi"/>
        <zz:huxishuExplanation xml:lang="zh">少阳风火上扰清窍，故目眩。与痰饮眩悸不同，此为热眩。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【5.1】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#WangLaiHanRe">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">往来寒热</rdfs:label>
        <zz:originalDescription xml:lang="zh">往来寒热</zz:originalDescription>
        <zz:temporalQualifier xml:lang="zh">往来</zz:temporalQualifier>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#BanBiaoBanLi"/>
        <zz:huxishuExplanation xml:lang="zh">正邪分争于半表半里，进退不定，故寒热交替发作。此为少阳病特异性热型。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【5.96】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#XiongXieKuMan">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">胸胁苦满</rdfs:label>
        <zz:originalDescription xml:lang="zh">胸胁苦满</zz:originalDescription>
        <zz:locationQualifier xml:lang="zh">胸胁</zz:locationQualifier>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#BanBiaoBanLi"/>
        <zz:huxishuExplanation xml:lang="zh">少阳经布胸胁，邪郁于此，气机不畅，故胸胁部胀满不适。为小柴胡汤证核心腹证。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【5.96】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#MomoBuYuYinShi">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">默默不欲饮食</rdfs:label>
        <zz:originalDescription xml:lang="zh">默默不欲饮食</zz:originalDescription>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#BanBiaoBanLi"/>
        <zz:huxishuExplanation xml:lang="zh">肝胆气郁，影响脾胃运化，神情抑郁、不思饮食。为少阳枢机不利之象。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【5.96】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#XinFanXiOu">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">心烦喜呕</rdfs:label>
        <zz:originalDescription xml:lang="zh">心烦喜呕</zz:originalDescription>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#BanBiaoBanLi"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <zz:huxishuExplanation xml:lang="zh">胆热犯胃，胃失和降则呕；热扰心神则烦。'喜呕'即频繁作呕之意。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【5.96】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <!-- === 阳明里阳证 === -->
    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#DaKe">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">大渴</rdfs:label>
        <zz:originalDescription xml:lang="zh">大渴引饮</zz:originalDescription>
        <zz:degreeQualifier xml:lang="zh">大</zz:degreeQualifier>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <zz:huxishuExplanation xml:lang="zh">阳明热盛，津液大伤，故大渴引饮。与少阳咽干、太阴口不渴截然不同。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【4.26】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#ShenRe">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">身热</rdfs:label>
        <zz:originalDescription xml:lang="zh">身热</zz:originalDescription>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <zz:huxishuExplanation xml:lang="zh">阳明里热蒸腾于外，故身热灼手。与表证发热伴恶寒不同，此为但热不寒。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【4.182】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#BuEhanFanEre">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">不恶寒反恶热</rdfs:label>
        <zz:originalDescription xml:lang="zh">不恶寒反恶热</zz:originalDescription>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Yang"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <zz:huxishuExplanation xml:lang="zh">阳明病标志性症状。表证已罢，里热独盛，故不恶寒反恶热。此为鉴别表里的关键。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【4.182】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#DaBianNan">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">大便难</rdfs:label>
        <zz:originalDescription xml:lang="zh">大便难</zz:originalDescription>
        <zz:degreeQualifier xml:lang="zh">难</zz:degreeQualifier>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <zz:huxishuExplanation xml:lang="zh">排便困难费力，燥屎初结，腑实未甚。可先与小承气汤试探，转矢气者方可攻下。与大便秘结不通有别。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【4.208】</zz:guilinClauseRef>
        <zz:co_occurs_with rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#BuDaBian"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#BuDaBian">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">不大便</rdfs:label>
        <zz:originalDescription xml:lang="zh">不大便</zz:originalDescription>
        <zz:degreeQualifier xml:lang="zh">不</zz:degreeQualifier>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <zz:huxishuExplanation xml:lang="zh">大便完全不通，燥屎已成，腑实已甚。伴潮热、谵语、腹满痛拒按者，当急下之，宜大承气汤。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【4.212】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#FuManJuAn">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">腹满拒按</rdfs:label>
        <zz:originalDescription xml:lang="zh">腹满痛，绕脐痛，拒按</zz:originalDescription>
        <zz:locationQualifier xml:lang="zh">腹</zz:locationQualifier>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <zz:huxishuExplanation xml:lang="zh">燥屎内结，腑气不通，故腹满硬痛、拒按。与太阴腹满喜按截然相反。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【4.239】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#ChaoRe">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">潮热</rdfs:label>
        <zz:originalDescription xml:lang="zh">日晡所发潮热</zz:originalDescription>
        <zz:temporalQualifier xml:lang="zh">日晡所</zz:temporalQualifier>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <zz:huxishuExplanation xml:lang="zh">阳明旺于申酉时，故热势如潮，定时而发。为阳明腑实证典型热型。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【4.208】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#ZhanYu">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">谵语</rdfs:label>
        <zz:originalDescription xml:lang="zh">谵语</zz:originalDescription>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <zz:huxishuExplanation xml:lang="zh">阳明热盛，扰乱神明，故胡言乱语。为腑实重证标志。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【4.212】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#ShouZuJiRanHanChu">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">手足濈然汗出</rdfs:label>
        <zz:originalDescription xml:lang="zh">手足濈然汗出</zz:originalDescription>
        <zz:locationQualifier xml:lang="zh">手足</zz:locationQualifier>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <zz:huxishuExplanation xml:lang="zh">阳明热迫津液外泄，四肢为诸阳之本，故手足持续汗出。为燥屎已成之外候。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【4.220】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <!-- === 太阴里阴证 === -->
    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#FuManErTu">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">腹满而吐</rdfs:label>
        <zz:originalDescription xml:lang="zh">腹满而吐</zz:originalDescription>
        <zz:locationQualifier xml:lang="zh">腹</zz:locationQualifier>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Yin"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <zz:huxishuExplanation xml:lang="zh">太阴虚寒，运化失职，浊阴上逆，故腹满而吐。此为虚满、喜按、喜温。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【6.273】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#ZiLi">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">自利</rdfs:label>
        <zz:originalDescription xml:lang="zh">自利益甚</zz:originalDescription>
        <zz:degreeQualifier xml:lang="zh">益甚</zz:degreeQualifier>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Yin"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <zz:huxishuExplanation xml:lang="zh">太阴虚寒，水谷不别，故下利清谷、自利益甚。此为清稀、不臭、完谷不化。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【6.273】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#ShiBuXia">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">食不下</rdfs:label>
        <zz:originalDescription xml:lang="zh">食不下</zz:originalDescription>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Yin"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <zz:huxishuExplanation xml:lang="zh">太阴脾虚，不能运化水谷，故纳呆厌食。与少阳默默不欲饮食之机理不同。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【6.273】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#ShiFuZiTong">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">时腹自痛</rdfs:label>
        <zz:originalDescription xml:lang="zh">时腹自痛</zz:originalDescription>
        <zz:temporalQualifier xml:lang="zh">时</zz:temporalQualifier>
        <zz:locationQualifier xml:lang="zh">腹</zz:locationQualifier>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Yin"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <zz:huxishuExplanation xml:lang="zh">太阴虚寒，寒凝气滞，故腹痛阵发、喜温喜按。与阳明持续剧痛拒按相反。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【6.273】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <!-- === 少阴表阴证 === -->
    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#MaiWeiXi">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">脉微细</rdfs:label>
        <zz:originalDescription xml:lang="zh">脉微细</zz:originalDescription>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Yin"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <zz:huxishuExplanation xml:lang="zh">少阴阳衰，鼓动无力故脉微；阴血不足，脉道不充故脉细。微细并见，为少阴病提纲脉。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【7.281】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#DanYuMei">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">但欲寐</rdfs:label>
        <zz:originalDescription xml:lang="zh">但欲寐</zz:originalDescription>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Yin"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <zz:huxishuExplanation xml:lang="zh">少阴心肾阳衰，神失所养，故精神萎靡、似睡非睡。非正常困倦，乃阳气欲脱之危象。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【7.281】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#ShouZuJueLeng">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">手足厥冷</rdfs:label>
        <zz:originalDescription xml:lang="zh">手足厥冷</zz:originalDescription>
        <zz:locationQualifier xml:lang="zh">手足</zz:locationQualifier>
        <zz:degreeQualifier xml:lang="zh">冷</zz:degreeQualifier>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Yin"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <zz:huxishuExplanation xml:lang="zh">阳气不足，不达四末，手足冰冷限于腕踝以下。较四肢厥逆为轻，可见于当归四逆汤证。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【7.337】</zz:guilinClauseRef>
        <zz:co_occurs_with rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SiZhiJueNi"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#SiZhiJueNi">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">四肢厥逆</rdfs:label>
        <zz:originalDescription xml:lang="zh">四肢厥逆</zz:originalDescription>
        <zz:locationQualifier xml:lang="zh">四肢</zz:locationQualifier>
        <zz:degreeQualifier xml:lang="zh">逆</zz:degreeQualifier>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Yin"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <zz:huxishuExplanation xml:lang="zh">阳气衰微，不能达于四末，手足冰冷过肘膝。为四逆汤证核心指征，重于手足厥冷。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【7.337】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#XiaLiQingGu">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">下利清谷</rdfs:label>
        <zz:originalDescription xml:lang="zh">下利清谷</zz:originalDescription>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Yin"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <zz:huxishuExplanation xml:lang="zh">少阴阳衰，火不暖土，水谷完全不化，故泻下未消化食物。比太阴自利更重。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【7.317】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <!-- === 厥阴寒热错杂证 === -->
    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#XiaoKe">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">消渴</rdfs:label>
        <zz:originalDescription xml:lang="zh">消渴</zz:originalDescription>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#BanBiaoBanLi"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <zz:huxishuExplanation xml:lang="zh">厥阴上热，灼伤津液，故消渴。与阳明大渴不同，此为渴而饮水不解、伴气上撞心。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【8.326】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#QiShangZhuangXin">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">气上撞心</rdfs:label>
        <zz:originalDescription xml:lang="zh">气上撞心</zz:originalDescription>
        <zz:locationQualifier xml:lang="zh">心</zz:locationQualifier>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#BanBiaoBanLi"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <zz:huxishuExplanation xml:lang="zh">厥阴下寒，阴寒之气上逆冲心，故自觉有气从少腹上冲心胸。为乌梅丸证特异性症状。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【8.326】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#JiErBuYuShi">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">饥而不欲食</rdfs:label>
        <zz:originalDescription xml:lang="zh">饥而不欲食</zz:originalDescription>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#BanBiaoBanLi"/>
        <zz:huxishuExplanation xml:lang="zh">上热则饥，下寒则不欲食。寒热错杂之典型表现。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【8.326】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#ShiZeTuHui">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">食则吐蛔</rdfs:label>
        <zz:originalDescription xml:lang="zh">食则吐蛔</zz:originalDescription>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#BanBiaoBanLi"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <zz:huxishuExplanation xml:lang="zh">肠寒胃热，蛔虫不安，闻食臭而上窜，故进食后吐出蛔虫。为蛔厥证独有指征。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【8.326】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <!-- === 水饮痰湿相关 === -->
    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#XiaoBianBuLi">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">小便不利</rdfs:label>
        <zz:originalDescription xml:lang="zh">小便不利</zz:originalDescription>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Yin"/>
        <zz:huxishuExplanation xml:lang="zh">气化失司，水液代谢障碍，故小便量少、排出不畅。为五苓散证核心指征。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【3.71】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#KeErYuYin">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">渴欲饮水</rdfs:label>
        <zz:originalDescription xml:lang="zh">渴欲饮水，水入则吐</zz:originalDescription>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Yin"/>
        <zz:huxishuExplanation xml:lang="zh">水蓄膀胱，津不上承故渴；新水不入，格拒于上故水入则吐。名曰'水逆'。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【3.74】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#XinXiaPi">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">心下痞</rdfs:label>
        <zz:originalDescription xml:lang="zh">心下痞</zz:originalDescription>
        <zz:locationQualifier xml:lang="zh">心下</zz:locationQualifier>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <zz:huxishuExplanation xml:lang="zh">胃脘部堵塞感，按之柔软不痛。为半夏泻心汤证核心腹证，属寒热错杂痞。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【4.149】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#XinZhongAoNong">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">心中懊憹</rdfs:label>
        <zz:originalDescription xml:lang="zh">心中懊憹</zz:originalDescription>
        <zz:locationQualifier xml:lang="zh">心中</zz:locationQualifier>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <zz:huxishuExplanation xml:lang="zh">无形邪热郁扰胸膈，故心中烦闷特甚、坐卧不安。为栀子豉汤证眼目。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【4.76】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <!-- === 瘀血蓄血相关 === -->
    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#RuKuang">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">如狂</rdfs:label>
        <zz:originalDescription xml:lang="zh">其人如狂</zz:originalDescription>
        <zz:degreeQualifier xml:lang="zh">如</zz:degreeQualifier>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <zz:huxishuExplanation xml:lang="zh">瘀热互结下焦，上扰神明，故神志失常、躁扰不宁。比谵语轻，比烦躁重。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【3.106】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#ShaoFuJiJie">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">少腹急结</rdfs:label>
        <zz:originalDescription xml:lang="zh">少腹急结</zz:originalDescription>
        <zz:locationQualifier xml:lang="zh">少腹</zz:locationQualifier>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <zz:huxishuExplanation xml:lang="zh">瘀血蓄于下焦，气血凝滞，故少腹部拘急硬痛、按之有抵抗感。为桃核承气汤证腹证。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【3.106】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <!-- === 虚损相关 === -->
    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#XinJi">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">心悸</rdfs:label>
        <zz:originalDescription xml:lang="zh">心动悸</zz:originalDescription>
        <zz:locationQualifier xml:lang="zh">心</zz:locationQualifier>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <zz:huxishuExplanation xml:lang="zh">心之气血阴阳亏虚，心失所养，故自觉心跳不安。为炙甘草汤证主症。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【4.177】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#MaiJieDai">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">脉结代</rdfs:label>
        <zz:originalDescription xml:lang="zh">脉结代</zz:originalDescription>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Yin"/>
        <zz:huxishuExplanation xml:lang="zh">心气不足，血脉不续，故脉来缓而时止（结）、止有定数（代）。为炙甘草汤证脉象。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【4.177】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <!-- === 其他重要鉴别症状 === -->
    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#BeiWeiEHan">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">背微恶寒</rdfs:label>
        <zz:originalDescription xml:lang="zh">背微恶寒</zz:originalDescription>
        <zz:degreeQualifier xml:lang="zh">微</zz:degreeQualifier>
        <zz:locationQualifier xml:lang="zh">背</zz:locationQualifier>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <zz:huxishuExplanation xml:lang="zh">阳明热盛，汗出肌疏，背部阳气暂虚，故仅背部轻微恶寒。非表证恶寒，乃白虎加人参汤证。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【4.169】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#SheShangTaiHua">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">舌上苔滑</rdfs:label>
        <zz:originalDescription xml:lang="zh">舌上苔滑</zz:originalDescription>
        <zz:locationQualifier xml:lang="zh">舌</zz:locationQualifier>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#BanBiaoBanLi"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <zz:huxishuExplanation xml:lang="zh">寒湿内停，阳气不化，故舌苔白滑。为柴胡桂枝干姜汤证舌象。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【5.147】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#FanZao">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">烦躁</rdfs:label>
        <zz:originalDescription xml:lang="zh">烦躁</zz:originalDescription>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Yang"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <zz:huxishuExplanation xml:lang="zh">阳热内扰，心神不安，故烦躁不宁。可见于表证（大青龙汤）、里证（承气汤）、虚证（茯苓四逆汤），须合参他症鉴别。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【3.38】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#KeErBuYuYin">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">渴不欲饮</rdfs:label>
        <zz:originalDescription xml:lang="zh">渴不欲饮</zz:originalDescription>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Yin"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <zz:huxishuExplanation xml:lang="zh">内有水饮，津不上承故渴；水饮内停，胃不受纳故不欲饮。与阳明大渴引饮相反。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【4.137】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#TouYun">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">头晕</rdfs:label>
        <zz:originalDescription xml:lang="zh">起则头眩</zz:originalDescription>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Yin"/>
        <zz:huxishuExplanation xml:lang="zh">水饮内停，清阳不升，故起身时头晕目眩。为苓桂术甘汤证指征。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【4.67】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#XiongMan">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">胸满</rdfs:label>
        <zz:originalDescription xml:lang="zh">胸满</zz:originalDescription>
        <zz:locationQualifier xml:lang="zh">胸</zz:locationQualifier>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Biao"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Yang"/>
        <zz:huxishuExplanation xml:lang="zh">表邪未解，胸阳不振，气机不畅，故胸部满闷。为桂枝去芍药汤证。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【3.21】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#JingLuan">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">痉</rdfs:label>
        <zz:originalDescription xml:lang="zh">颈项强急，卒口噤，背反张</zz:originalDescription>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Biao"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <zz:huxishuExplanation xml:lang="zh">风寒湿邪侵袭筋脉，津液亏损，筋失濡养，故拘急抽搐。分刚痉（无汗）与柔痉（汗出）。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【2.1】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#HuangDan">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">黄疸</rdfs:label>
        <zz:originalDescription xml:lang="zh">身黄如橘子色</zz:originalDescription>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <zz:huxishuExplanation xml:lang="zh">湿热蕴结中焦，胆汁外溢，故身目俱黄、色泽鲜明。为茵陈蒿汤证。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【4.236】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#FengShui">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">风水</rdfs:label>
        <zz:originalDescription xml:lang="zh">一身面目黄肿</zz:originalDescription>
        <zz:locationQualifier xml:lang="zh">一身面目</zz:locationQualifier>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Biao"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <zz:huxishuExplanation xml:lang="zh">风邪袭表，肺失宣降，水泛肌肤，故一身面目浮肿。偏表实，宜越婢汤发汗利水。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【14.5】</zz:guilinClauseRef>
        <zz:co_occurs_with rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#PiShui"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#PiShui">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">皮水</rdfs:label>
        <zz:originalDescription xml:lang="zh">腰以下肿</zz:originalDescription>
        <zz:locationQualifier xml:lang="zh">腰以下</zz:locationQualifier>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Yin"/>
        <zz:huxishuExplanation xml:lang="zh">脾虚水停，水液下趋，故腰以下肿甚。偏里虚，宜防己茯苓汤健脾利水。与风水表实有别。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【14.5】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#KeNi">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">咳逆</rdfs:label>
        <zz:originalDescription xml:lang="zh">咳逆倚息不得卧</zz:originalDescription>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Yin"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <zz:huxishuExplanation xml:lang="zh">寒饮伏肺，肺气上逆，故咳嗽气喘、不能平卧。为小青龙汤证重症。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【12.23】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#TuXue">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">吐血</rdfs:label>
        <zz:originalDescription xml:lang="zh">吐血不止</zz:originalDescription>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <zz:huxishuExplanation xml:lang="zh">热伤血络，迫血妄行。柏叶汤治虚寒吐血；泻心汤治实热吐血。须辨寒热虚实。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【16.14】</zz:guilinClauseRef>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#YuanXue">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">远血</rdfs:label>
        <zz:originalDescription xml:lang="zh">下血，先便后血</zz:originalDescription>
        <zz:degreeQualifier xml:lang="zh">远</zz:degreeQualifier>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Yin"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <zz:huxishuExplanation xml:lang="zh">血色暗褐，先便后血，病位在胃肠深处，属脾虚寒不摄血。宜黄土汤温脾摄血。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【16.15】</zz:guilinClauseRef>
        <zz:co_occurs_with rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#JinXue"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#JinXue">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">近血</rdfs:label>
        <zz:originalDescription xml:lang="zh">下血，先血后便</zz:originalDescription>
        <zz:degreeQualifier xml:lang="zh">近</zz:degreeQualifier>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <zz:huxishuExplanation xml:lang="zh">血色鲜红，先血后便，病位在肛门直肠，属湿热下注。宜赤小豆当归散清利湿热。与远血虚实有别。</zz:huxishuExplanation>
        <zz:guilinClauseRef xml:lang="zh">【16.15】</zz:guilinClauseRef>
    </owl:NamedIndividual>

</rdf:RDF>