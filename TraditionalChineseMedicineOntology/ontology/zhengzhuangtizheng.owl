<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
    xmlns="http://www.tcm-classics.org/zhengzhuangtizheng#"
    xml:base="http://www.tcm-classics.org/zhengzhuangtizheng"
    xmlns:zz="http://www.tcm-classics.org/zhengzhuangtizheng#"
    xmlns:bg="http://www.tcm-classics.org/bagang#"
    xmlns:tcm="http://www.tcm-classics.org/tcm#"
    xmlns:skos="http://www.w3.org/2004/02/skos/core#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:dc="http://purl.org/dc/elements/1.1/">

    <!-- ========== 本体元数据 ========== -->
    <owl:Ontology rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng">
        <dc:title xml:lang="zh">症状体征本体（证据链版·v8.0-完整）</dc:title>
        <dc:description xml:lang="zh">v8.0修订：①删除全部 symptom_indicates_liujing 六经标注——六经归属由推理引擎根据八纲动态推导；②补充所有症状的 evidenceLevel（高特异铁证/中特异铁证/一般线索/否决症状）；③保留 symptom_indicates_bagang 作为八纲证据映射。依据：胡希恕“六经来自八纲”原则。本文件包含全部原子症状，无省略。</dc:description>
        <owl:versionInfo>8.0-Complete</owl:versionInfo>
        <!-- ========================================================== -->
				<!-- ★ 修改三（v27.0）：证据等级使用规范（新增）               -->
				<!-- ========================================================== -->
				<rdfs:comment xml:lang="zh">
				    【证据等级使用规范 v27.0】
				    1. zz:evidenceLevel 属性定义于本文件，用于标记症状在方证匹配中的特异性等级。
				    2. 取值：高特异铁证 / 中特异铁证 / 一般线索 / 否决症状。
				    3. ★★★ 重要：本属性为人工可读标注，不参与任何 SWRL 或 JobWorker 的自动推理。
				        “否决症状”的逻辑判定权完全归属 bingzheng.owl 中的 bz:has_exclusion_symptom 对象属性。
				    4. 本属性的唯一用途：供临床医师审阅、UI 展示、知识图谱可视化。
				    5. 新增症状时，若需表达“否决”逻辑，必须在 bingzheng.owl 中通过 bz:has_exclusion_symptom 关联，
				       不得仅依赖本标注。
				</rdfs:comment>
        <rdfs:seeAlso rdf:resource="http://www.tcm-classics.org/bagang"/>
    </owl:Ontology>

    <!-- ========== 注释属性 ========== -->
    <owl:AnnotationProperty rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#originalDescription">
        <rdfs:label xml:lang="zh">原文描述</rdfs:label>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#huxishuExplanation">
        <rdfs:label xml:lang="zh">胡老释义</rdfs:label>
        <rdfs:comment xml:lang="zh">仅收录胡希恕先生口授或冯世纶整理之释义。</rdfs:comment>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#caoyingfuNote">
        <rdfs:label xml:lang="zh">曹颖甫按语</rdfs:label>
        <rdfs:comment xml:lang="zh">曹颖甫《经方实验录》之方证对应按语。</rdfs:comment>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#isInferred">
        <rdfs:label xml:lang="zh">推断性条目</rdfs:label>
        <rdfs:comment xml:lang="zh">标记无直接原文依据，基于医理推断的条目。</rdfs:comment>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#isEventNotSymptom">
        <rdfs:label xml:lang="zh">非典型症状</rdfs:label>
        <rdfs:comment xml:lang="zh">标记为事件或生理现象，非严格意义上的症状/体征。</rdfs:comment>
    </owl:AnnotationProperty>

    <!-- 核心：证据等级 -->
    <owl:AnnotationProperty rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#evidenceLevel">
        <rdfs:label xml:lang="zh">证据等级</rdfs:label>
        <rdfs:comment xml:lang="zh">取值：高特异铁证 / 中特异铁证 / 一般线索 / 否决症状</rdfs:comment>
    </owl:AnnotationProperty>

    <!-- ========== 数据属性 ========== -->
    <owl:DatatypeProperty rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#degreeQualifier">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#SymptomSign"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:label xml:lang="zh">程度限定</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#temporalQualifier">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#SymptomSign"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:label xml:lang="zh">时序限定</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#locationQualifier">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#SymptomSign"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:label xml:lang="zh">部位限定</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#triggered_by">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#SymptomSign"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:label xml:lang="zh">诱发因素</rdfs:label>
    </owl:DatatypeProperty>

    <!-- ========== 对象属性 ========== -->
    <owl:ObjectProperty rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#co_occurs_with">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#SymptomSign"/>
        <rdfs:range rdf:resource="http://www.tcm-classics.org/tcm#SymptomSign"/>
        <rdfs:label xml:lang="zh">并见症状</rdfs:label>
        <rdfs:comment xml:lang="zh">仅收录具有方证鉴别意义的核心并见关系。</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#ignore_for_pattern_selection">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#SymptomSign"/>
        <rdfs:range rdf:resource="http://www.tcm-classics.org/tcm#SymptomSign"/>
        <rdfs:label xml:lang="zh">选方忽略标记</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#is_secondary_to">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#SymptomSign"/>
        <rdfs:range rdf:resource="http://www.tcm-classics.org/tcm#SymptomSign"/>
        <rdfs:label xml:lang="zh">从属于（次生症状的诱发主症）</rdfs:label>
    </owl:ObjectProperty>

    <!-- ========== 顶层分类 ========== -->
    <owl:Class rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom">
        <rdfs:subClassOf rdf:resource="http://www.tcm-classics.org/tcm#SymptomSign"/>
        <rdfs:label xml:lang="zh">自觉症状</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign">
        <rdfs:subClassOf rdf:resource="http://www.tcm-classics.org/tcm#SymptomSign"/>
        <rdfs:label xml:lang="zh">他觉体征</rdfs:label>
    </owl:Class>

    <!-- ========================================== -->
    <!-- 原子症状个体（完整版，无省略）             -->
    <!-- 全部症状均已补充 evidenceLevel             -->
    <!-- 全部 tcm:symptom_indicates_liujing 已删除 -->
    <!-- ========================================== -->

    <!-- 一、寒热汗 -->

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#EHan">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">恶寒</rdfs:label>
        <skos:altLabel xml:lang="zh">怕冷</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Biao"/>
        <zz:evidenceLevel>高特异铁证</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第7条：病有发热恶寒者，发于阳也；无热恶寒者，发于阴也。</zz:originalDescription>
        <zz:huxishuExplanation>胡老：恶寒一症，太阳有之，少阴亦有之。太阳之恶寒与发热并见，少阴之恶寒不发热而但欲寐。</zz:huxishuExplanation>
        <zz:caoyingfuNote>曹颖甫《经方实验录》：'啬啬恶寒'即此。桂枝汤证常见。</zz:caoyingfuNote>
        <zz:co_occurs_with rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#FaRe"/>
        <rdfs:comment xml:lang="zh">表证高特异铁证。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#EFeng">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">恶风</rdfs:label>
        <skos:altLabel xml:lang="zh">怕风</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Biao"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <zz:evidenceLevel>高特异铁证</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第12条：太阳中风，阳浮而阴弱，阳浮者热自发，阴弱者汗自出，啬啬恶寒，淅淅恶风，翕翕发热，鼻鸣干呕者，桂枝汤主之。</zz:originalDescription>
        <zz:caoyingfuNote>曹颖甫《经方实验录》：'淅淅恶风'即此。桂枝汤证主症之一。</zz:caoyingfuNote>
        <zz:huxishuExplanation>胡老：恶风为太阳中风（表虚）之主症，与恶寒之太阳伤寒（表实）相对。</zz:huxishuExplanation>
        <zz:co_occurs_with rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#HanChu"/>
        <rdfs:comment xml:lang="zh">表虚证高特异铁证。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#ERe">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">恶热</rdfs:label>
        <skos:altLabel xml:lang="zh">怕热</skos:altLabel>
        <skos:altLabel xml:lang="zh">不耐热</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <zz:evidenceLevel>高特异铁证</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第182条：问曰：阳明病外证云何？答曰：身热，汗自出，不恶寒，反恶热也。</zz:originalDescription>
        <zz:huxishuExplanation>胡老：恶热为阳明里热炽盛之特异性指征，与太阳表证之恶寒截然相对。</zz:huxishuExplanation>
        <rdfs:comment xml:lang="zh">热证高特异铁证。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#FaRe">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">发热</rdfs:label>
        <skos:altLabel xml:lang="zh">发烧</skos:altLabel>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第3条：太阳病，或已发热，或未发热，必恶寒，体痛，呕逆，脉阴阳俱紧者，名为伤寒。</zz:originalDescription>
        <zz:caoyingfuNote>曹颖甫《经方实验录》：'翕翕发热'属桂枝汤，'蒸蒸发热'属调胃承气汤。</zz:caoyingfuNote>
        <zz:co_occurs_with rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#EHan"/>
        <rdfs:comment xml:lang="zh">非特异线索，需配合其他证据使用。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#ShenRe">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">身热</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第182条：身热，汗自出，不恶寒，反恶热也。</zz:originalDescription>
        <zz:caoyingfuNote>曹颖甫《经方实验录》：白虎汤证四大症之一。</zz:caoyingfuNote>
        <rdfs:comment xml:lang="zh">身热偏重持续高热，需配合其他证据使用。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#ChaoRe">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">潮热</rdfs:label>
        <skos:altLabel xml:lang="zh">日晡潮热</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <zz:evidenceLevel>高特异铁证</zz:evidenceLevel>
        <zz:temporalQualifier rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">日晡所</zz:temporalQualifier>
        <zz:originalDescription>伤寒论第208条：有潮热者，此外欲解，可攻里也。</zz:originalDescription>
        <zz:caoyingfuNote>曹颖甫《经方实验录》：日晡所潮热，属阳明，宜承气汤。</zz:caoyingfuNote>
        <rdfs:comment xml:lang="zh">热证高特异铁证。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#WangLaiHanRe">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">往来寒热</rdfs:label>
        <skos:altLabel xml:lang="zh">寒热往来</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#BanBiaoBanLi"/>
        <zz:evidenceLevel>高特异铁证</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第96条：伤寒五六日中风，往来寒热，胸胁苦满，嘿嘿不欲饮食，心烦喜呕。</zz:originalDescription>
        <zz:huxishuExplanation>胡老：往来寒热为少阳病独有热型，区别于太阳之恶寒发热并见。</zz:huxishuExplanation>
        <zz:co_occurs_with rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#XiongXieKuMan"/>
        <zz:co_occurs_with rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#KouKu"/>
        <rdfs:comment xml:lang="zh">半表半里高特异铁证。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#HanChu">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">汗出</rdfs:label>
        <skos:altLabel xml:lang="zh">有汗</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Biao"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第12条：太阳中风……阴弱者汗自出。</zz:originalDescription>
        <zz:caoyingfuNote>曹颖甫《经方实验录》：'病汗'与'药汗'有别，服桂枝汤后当出'药汗'。</zz:caoyingfuNote>
        <rdfs:comment xml:lang="zh">主表虚线索。需配合恶风、脉缓等证据使用。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#WuHan">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">无汗</rdfs:label>
        <skos:altLabel xml:lang="zh">不出汗</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Biao"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <zz:evidenceLevel>否决症状</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第35条：太阳病，头痛发热，身疼腰痛，骨节疼痛，恶风，无汗而喘者，麻黄汤主之。</zz:originalDescription>
        <zz:caoyingfuNote>曹颖甫《经方实验录》：麻黄汤证主症之一，'无汗而喘'。</zz:caoyingfuNote>
        <rdfs:comment xml:lang="zh">否决桂枝汤。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#ZiHan">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">自汗</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Biao"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第53条：病常自汗出……宜桂枝汤。</zz:originalDescription>
        <zz:caoyingfuNote>曹颖甫《经方实验录》：桂枝汤证'常自汗出'即此。</zz:caoyingfuNote>
        <zz:huxishuExplanation>胡老：自汗主见表虚（桂枝汤证）与阳明里热迫津（白虎汤证）。</zz:huxishuExplanation>
        <rdfs:comment xml:lang="zh">需结合他症判断属表虚还是里热。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#DaoHan">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">盗汗</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·血痹虚劳病篇：男子平人，脉虚弱细微者，善盗汗也。</zz:originalDescription>
        <zz:caoyingfuNote>曹颖甫《经方实验录》：桂枝加龙骨牡蛎汤治盗汗效佳。</zz:caoyingfuNote>
        <rdfs:comment xml:lang="zh">属里虚，需结合脉象判断。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#ShouZuJiRanHanChu">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">手足濈然汗出</rdfs:label>
        <skos:altLabel xml:lang="zh">手足汗出</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <zz:evidenceLevel>高特异铁证</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第208条：手足濈然汗出者，此大便已硬也，大承气汤主之。</zz:originalDescription>
        <zz:huxishuExplanation>胡老：此症为阳明腑实已成之确据，与一般汗出不同。</zz:huxishuExplanation>
        <rdfs:comment xml:lang="zh">阳明腑实高特异铁证。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#TouHan">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">头汗</rdfs:label>
        <skos:altLabel xml:lang="zh">但头汗出</skos:altLabel>
        <skos:altLabel xml:lang="zh">额上汗出</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <zz:evidenceLevel>中特异铁证</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第236条：阳明病……但头汗出，身无汗，剂颈而还，小便不利，渴引水浆者，此为瘀热在里，身必发黄，茵陈蒿汤主之。</zz:originalDescription>
        <zz:huxishuExplanation>胡老：但头汗出为湿热不得外越之征，茵陈蒿汤证之眼目。</zz:huxishuExplanation>
        <rdfs:comment xml:lang="zh">里热中特异铁证。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#HuangHan">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">黄汗</rdfs:label>
        <skos:altLabel xml:lang="zh">汗出沾衣如柏汁</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <zz:evidenceLevel>中特异铁证</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·水气病篇：黄汗之为病，身体肿，发热汗出而渴，状如风水，汗沾衣，色正黄如柏汁。</zz:originalDescription>
        <zz:caoyingfuNote>黄芪芍药桂枝苦酒汤主之。</zz:caoyingfuNote>
        <rdfs:comment xml:lang="zh">湿热郁蒸之征。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#BeiWeiEhanRe">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">背微恶寒（阳明热盛伤气）</rdfs:label>
        <skos:altLabel xml:lang="zh">背恶寒</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <zz:evidenceLevel>中特异铁证</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第169条：伤寒无大热，口燥渴，心烦，背微恶寒者，白虎加人参汤主之。</zz:originalDescription>
        <zz:huxishuExplanation>胡老：背微恶寒为阳明热盛伤气之特征，与表证恶寒不同。以口燥渴、心烦辨之。</zz:huxishuExplanation>
        <rdfs:comment xml:lang="zh">阳明热盛兼气阴两伤。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#BeiWeiEhanHan">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">背恶寒（少阴阳虚）</rdfs:label>
        <skos:altLabel xml:lang="zh">背寒</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <zz:evidenceLevel>中特异铁证</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第304条：少阴病，得之一二日，口中和，其背恶寒者，当灸之，附子汤主之。</zz:originalDescription>
        <zz:huxishuExplanation>胡老：少阴附子汤证之背恶寒为阳虚不能温煦，须以口中和、不渴辨之。</zz:huxishuExplanation>
        <rdfs:comment xml:lang="zh">少阴阳虚。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#MuJiFaRe">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">暮即发热</rdfs:label>
        <skos:altLabel xml:lang="zh">傍晚发热</skos:altLabel>
        <skos:altLabel xml:lang="zh">暮热</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·妇人杂病篇：妇人年五十所，病下利数十日不止，暮即发热……温经汤主之。</zz:originalDescription>
        <zz:huxishuExplanation>胡老：暮即发热为冲任虚寒兼瘀血、阴血不足之虚热，非阳明实热。热势多低，与阳明蒸蒸发热有别。</zz:huxishuExplanation>
        <rdfs:comment xml:lang="zh">虚热线索。</rdfs:comment>
    </owl:NamedIndividual>

    <!-- 二、疼痛 -->

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#TouTong">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">头痛</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Biao"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:locationQualifier rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">前额/巅顶/两侧</zz:locationQualifier>
        <zz:originalDescription>伤寒论第35条：太阳病，头痛发热，身疼腰痛，骨节疼痛，恶风，无汗而喘者，麻黄汤主之。</zz:originalDescription>
        <zz:caoyingfuNote>曹颖甫《经方实验录》：阙上痛属阳明，太阳穴痛属太阳。</zz:caoyingfuNote>
        <rdfs:comment xml:lang="zh">非特异线索，需结合部位及其他证据。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#ShenTiTong">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">身痛</rdfs:label>
        <skos:altLabel xml:lang="zh">身体疼痛</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Biao"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第35条：太阳病，头痛发热，身疼腰痛，骨节疼痛，恶风，无汗而喘者，麻黄汤主之。</zz:originalDescription>
        <zz:caoyingfuNote>曹颖甫《经方实验录》：麻黄汤证'身疼腰痛，骨节疼痛'。</zz:caoyingfuNote>
        <rdfs:comment xml:lang="zh">表证常见线索。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#GuJieTong">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">骨节痛</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Biao"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第35条：太阳病，头痛发热，身疼腰痛，骨节疼痛……麻黄汤主之。</zz:originalDescription>
        <zz:caoyingfuNote>曹颖甫《经方实验录》：'骨节疼痛'属麻黄汤证。</zz:caoyingfuNote>
        <rdfs:comment xml:lang="zh">表寒常见线索。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#FuTong">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">腹痛</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·血痹虚劳病篇第13条：虚劳里急……腹中痛……小建中汤主之。</zz:originalDescription>
        <zz:caoyingfuNote>曹颖甫《经方实验录》：腹痛喜按属虚（小建中汤），拒按属实（承气汤）。</zz:caoyingfuNote>
        <rdfs:comment xml:lang="zh">需结合喜按/拒按判断虚实。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#XiongTong">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">胸痛</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·胸痹心痛短气病篇：胸痹之病，喘息咳唾，胸背痛，短气，寸口脉沉而迟，关上小紧数，栝蒌薤白白酒汤主之。</zz:originalDescription>
        <zz:caoyingfuNote>曹颖甫《经方实验录》：瓜蒌薤白白酒汤治胸痹心痛。</zz:caoyingfuNote>
        <rdfs:comment xml:lang="zh">里证线索。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#XieTong">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">胁痛</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#BanBiaoBanLi"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第96条：伤寒五六日中风，往来寒热，胸胁苦满，嘿嘿不欲饮食，心烦喜呕……小柴胡汤主之。</zz:originalDescription>
        <zz:caoyingfuNote>曹颖甫《经方实验录》：胁痛属少阳，小柴胡汤主之。</zz:caoyingfuNote>
        <rdfs:comment xml:lang="zh">少阳经气不利之征。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#ShaoFuTong">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">少腹痛</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第106条：太阳病不解，热结膀胱，其人如狂……但少腹急结者，乃可攻之，宜桃核承气汤。</zz:originalDescription>
        <zz:caoyingfuNote>曹颖甫《经方实验录》：桃核承气汤治少腹急结。</zz:caoyingfuNote>
        <rdfs:comment xml:lang="zh">蓄血证之少腹痛。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#YaoTong">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">腰痛</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Biao"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第35条：太阳病……身疼腰痛……麻黄汤主之。</zz:originalDescription>
        <zz:caoyingfuNote>曹颖甫《经方实验录》：麻黄汤证'腰疼'属太阳。</zz:caoyingfuNote>
        <rdfs:comment xml:lang="zh">表证常见线索。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#ZhiJieTong">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">肢节痛</rdfs:label>
        <skos:altLabel xml:lang="zh">四肢疼痛</skos:altLabel>
        <skos:altLabel xml:lang="zh">四肢酸疼</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·中风历节病篇第8条：诸肢节疼痛，身体尪羸，脚肿如脱……桂枝芍药知母汤主之。</zz:originalDescription>
        <zz:caoyingfuNote>曹颖甫《经方实验录》：'支节烦疼'属柴胡桂枝汤证。</zz:caoyingfuNote>
        <rdfs:comment xml:lang="zh">风寒湿痹日久化热。</rdfs:comment>
    </owl:NamedIndividual>

    <!-- 三、头项背强硬 -->

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#XiangQiang">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">项强</rdfs:label>
        <skos:altLabel xml:lang="zh">颈项强直</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Biao"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第14条：太阳病，项背强几几，反汗出恶风者，桂枝加葛根汤主之。</zz:originalDescription>
        <zz:caoyingfuNote>曹颖甫《经方实验录》：葛根汤治项背强几几。</zz:caoyingfuNote>
        <rdfs:comment xml:lang="zh">表证线索。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#BeiQiang">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">背强</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Biao"/>
        <zz:isInferred rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</zz:isInferred>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <rdfs:comment xml:lang="zh">"背强"系从"项背强几几"拆分推断。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#JingLuan">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">痉</rdfs:label>
        <skos:altLabel xml:lang="zh">强急</skos:altLabel>
        <skos:altLabel xml:lang="zh">角弓反张</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Biao"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·痉湿暍病篇：太阳病，发热无汗，反恶寒者，名曰刚痉。太阳病，发热汗出，而不恶寒，名曰柔痉。</zz:originalDescription>
        <zz:caoyingfuNote>曹颖甫《经方实验录》：刚痉用葛根汤，柔痉用栝蒌桂枝汤。</zz:caoyingfuNote>
        <rdfs:comment xml:lang="zh">刚痉、柔痉均起于太阳。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#KouJin">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">口噤</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Biao"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·痉湿暍病篇：太阳病，无汗而小便反少，气上冲胸，口噤不得语，欲作刚痉，葛根汤主之。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">口噤为刚痉前驱表现。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#BuDeYu">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">不得语</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Biao"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·痉湿暍病篇：太阳病，无汗而小便反少，气上冲胸，口噤不得语，欲作刚痉，葛根汤主之。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">与口噤并见，为刚痉前驱。</rdfs:comment>
    </owl:NamedIndividual>

    <!-- 四、卧息转侧 -->

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#BuDeWo">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">不得卧</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·痰饮咳嗽病篇：咳逆倚息不得卧，小青龙汤主之。</zz:originalDescription>
        <zz:caoyingfuNote>曹颖甫《经方实验录》：皂荚丸治'但坐不得眠'。</zz:caoyingfuNote>
        <rdfs:comment xml:lang="zh">不能平卧。与不得眠（失眠）不同。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#BuDeMian">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">不得眠</rdfs:label>
        <skos:altLabel xml:lang="zh">失眠</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第303条：少阴病，得之二三日以上，心中烦，不得卧，黄连阿胶汤主之。</zz:originalDescription>
        <zz:originalDescription>金匮要略·血痹虚劳病篇：虚劳虚烦不得眠，酸枣仁汤主之。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">不能入睡。需结合心烦、脉象判断热证属性。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#BuDeXi">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">不得息</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <zz:isInferred rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</zz:isInferred>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·胸痹心痛短气病篇：胸痹不得卧，喘息咳唾，胸背痛，短气。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">胸痹属里证。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#BuDeZhuanCe">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">不得转侧</rdfs:label>
        <skos:altLabel xml:lang="zh">不能自转侧</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Biao"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第174条：伤寒八九日，风湿相搏，身体疼烦，不能自转侧……桂枝附子汤主之。</zz:originalDescription>
        <zz:caoyingfuNote>曹颖甫《经方实验录》：桂枝附子汤治'身体疼烦不能自转侧'。</zz:caoyingfuNote>
        <rdfs:comment xml:lang="zh">风湿相搏于表。</rdfs:comment>
    </owl:NamedIndividual>

    <!-- 五、二便 -->

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#XiaoBianBuLi">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">小便不利</rdfs:label>
        <skos:altLabel xml:lang="zh">尿少</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第71条：若脉浮，小便不利，微热消渴者，五苓散主之。</zz:originalDescription>
        <zz:caoyingfuNote>曹颖甫《经方实验录》：五苓散治'小便不利，微热消渴'。</zz:caoyingfuNote>
        <zz:co_occurs_with rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#Ke"/>
        <rdfs:comment xml:lang="zh">里证线索。需结合渴与不渴、脉象鉴别。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#XiaoBianZiLi">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">小便自利</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <zz:evidenceLevel>高特异铁证</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第124条：太阳病……少腹当硬满，小便自利者，下血乃愈……抵当汤主之。</zz:originalDescription>
        <zz:caoyingfuNote>曹颖甫《经方实验录》：蓄血证小便自利，蓄水证小便不利。</zz:caoyingfuNote>
        <zz:co_occurs_with rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ShaoFuJiJie"/>
        <zz:co_occurs_with rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#RuKuang"/>
        <rdfs:comment xml:lang="zh">蓄血证之鉴别要点。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#XiaoBianShu">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">小便数</rdfs:label>
        <skos:altLabel xml:lang="zh">尿频</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第247条：趺阳脉浮而涩……小便数，大便则硬，其脾为约，麻子仁丸主之。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">脾约证之小便数。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#XiaoBianNan">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">小便难</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·水气病篇：少阴脉紧而沉……小便即难。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">排尿困难、涩滞不畅。属少阴水气病。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#XiaoBianQingChang">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">小便清长</rdfs:label>
        <skos:altLabel xml:lang="zh">小便色白</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <zz:evidenceLevel>高特异铁证</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第282条：少阴病……若小便色白者，少阴病形悉具。</zz:originalDescription>
        <zz:huxishuExplanation>胡老：小便清长为里虚寒之确据，与小便短赤之里热截然相反。</zz:huxishuExplanation>
        <rdfs:comment xml:lang="zh">里虚寒高特异铁证。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#DaBianNan">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">大便难</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第179条：少阳阳明者，发汗利小便已，胃中燥烦实，大便难是也。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">里实线索。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#DaBianYing">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">大便硬</rdfs:label>
        <skos:altLabel xml:lang="zh">大便坚</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第208条：手足濈然汗出者，此大便已硬也，大承气汤主之。</zz:originalDescription>
        <zz:caoyingfuNote>曹颖甫《经方实验录》：麻子仁丸治'大便硬'之脾约证。</zz:caoyingfuNote>
        <rdfs:comment xml:lang="zh">里实线索。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#BuDaBian">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">不大便</rdfs:label>
        <skos:altLabel xml:lang="zh">便秘</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第212条：伤寒若吐若下后不解，不大便五六日……大承气汤主之。</zz:originalDescription>
        <zz:caoyingfuNote>曹颖甫《经方实验录》：承气汤治'不大便'之阳明腑实证。</zz:caoyingfuNote>
        <rdfs:comment xml:lang="zh">里实线索。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#DaBianTang">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">大便溏</rdfs:label>
        <skos:altLabel xml:lang="zh">便溏</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第273条：太阴之为病，腹满而吐，食不下，自利益甚，时腹自痛。</zz:originalDescription>
        <zz:huxishuExplanation>胡老：大便溏为太阴脾虚之确据。</zz:huxishuExplanation>
        <rdfs:comment xml:lang="zh">里虚寒线索。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#XiaLi">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">下利</rdfs:label>
        <skos:altLabel xml:lang="zh">腹泻</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第157条：伤寒汗出解之后，胃中不和……腹中雷鸣下利者，生姜泻心汤主之。</zz:originalDescription>
        <zz:caoyingfuNote>曹颖甫《经方实验录》：葛根芩连汤治热利，理中汤治寒利。</zz:caoyingfuNote>
        <rdfs:comment xml:lang="zh">里证线索。需结合不渴/渴、臭秽与否鉴别寒热。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#ZiLi">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">自利</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第277条：自利不渴者，属太阴，以其脏有寒故也，当温之，宜服四逆辈。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">里虚寒线索。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#LiJi">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">里急</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·血痹虚劳病篇第13条：虚劳里急……小建中汤主之。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">虚劳里急为里虚之征。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#XiaZhong">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">下重</rdfs:label>
        <skos:altLabel xml:lang="zh">后重</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·呕吐哕下利病篇：热利下重者，白头翁汤主之。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">热利之征。</rdfs:comment>
    </owl:NamedIndividual>

    <!-- 六、渴饮 -->

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#Ke">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">渴</rdfs:label>
        <skos:altLabel xml:lang="zh">口渴</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第26条：服桂枝汤，大汗出后，大烦渴不解，脉洪大者，白虎加人参汤主之。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">热证线索。亦可见于水饮内停。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#DaKe">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">大渴</rdfs:label>
        <skos:altLabel xml:lang="zh">大渴引饮</skos:altLabel>
        <skos:altLabel xml:lang="zh">口渴引饮</skos:altLabel>
        <skos:altLabel xml:lang="zh">烦渴</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <zz:evidenceLevel>中特异铁证</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第26条：服桂枝汤，大汗出后，大烦渴不解，脉洪大者，白虎加人参汤主之。</zz:originalDescription>
        <zz:caoyingfuNote>曹颖甫《经方实验录》：白虎汤证四大症之一。</zz:caoyingfuNote>
        <rdfs:comment xml:lang="zh">阳明热盛伤津之征。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#BuKe">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">不渴</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <zz:evidenceLevel>中特异铁证</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第277条：自利不渴者，属太阴，以其脏有寒故也。</zz:originalDescription>
        <zz:caoyingfuNote>曹颖甫《经方实验录》：太阴病'自利不渴'。</zz:caoyingfuNote>
        <rdfs:comment xml:lang="zh">里寒证之铁证。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#KeYuYin">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">渴欲饮</rdfs:label>
        <skos:altLabel xml:lang="zh">渴欲饮水</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第71条：若脉浮，小便不利，微热消渴者，五苓散主之。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">热证线索。亦可见于水饮内停。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#KeBuYuYin">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">渴不欲饮</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <zz:isInferred rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</zz:isInferred>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:huxishuExplanation>胡老：渴不欲饮为水饮内停、津液不能上承之征。</zz:huxishuExplanation>
        <rdfs:comment xml:lang="zh">水饮内停之征。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#KeShuiRuTu">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">渴水入吐</rdfs:label>
        <skos:altLabel xml:lang="zh">水逆</skos:altLabel>
        <skos:altLabel xml:lang="zh">水入则吐</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <zz:evidenceLevel>中特异铁证</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第74条：中风发热……渴欲饮水，水入则吐者，名曰水逆，五苓散主之。</zz:originalDescription>
        <zz:caoyingfuNote>曹颖甫《经方实验录》：五苓散治'水逆'。</zz:caoyingfuNote>
        <zz:huxishuExplanation>胡老：水逆为渴欲饮与水入则吐并见之特殊状态。</zz:huxishuExplanation>
        <rdfs:comment xml:lang="zh">水饮内停之铁证。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#XiaoKe">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">消渴</rdfs:label>
        <skos:altLabel xml:lang="zh">饮水不解渴</skos:altLabel>
        <skos:altLabel xml:lang="zh">渴欲饮水不止</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#BanBiaoBanLi"/>
        <zz:evidenceLevel>中特异铁证</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第326条：厥阴之为病，消渴，气上撞心，心中疼热，饥而不欲食，食则吐蛔。</zz:originalDescription>
        <zz:huxishuExplanation>胡老：厥阴之消渴为寒热错杂、津液不上承所致，与阳明大渴引饮之纯热证不同。</zz:huxishuExplanation>
        <rdfs:comment xml:lang="zh">厥阴提纲证之首症。</rdfs:comment>
    </owl:NamedIndividual>

    <!-- 七、呕哕逆 -->

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#GanOu">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">干呕</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第40条：伤寒表不解，心下有水气，干呕，发热而咳。</zz:originalDescription>
        <zz:huxishuExplanation>胡老：干呕属里饮或少阳者十之八九，非单纯表证。</zz:huxishuExplanation>
        <rdfs:comment xml:lang="zh">有声无物。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#Ou">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">呕</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第96条：伤寒五六日中风……心烦喜呕。</zz:originalDescription>
        <zz:huxishuExplanation>胡老：呕为胃气上逆之泛称。</zz:huxishuExplanation>
        <rdfs:comment xml:lang="zh">有声有物之呕。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#Tu">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">吐</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第273条：太阴之为病，腹满而吐，食不下，自利益甚。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">有物吐出。太阴里虚寒之表现。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#YuOu">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">欲呕</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·中风历节病篇第8条：诸肢节疼痛……温温欲吐。</zz:originalDescription>
        <zz:huxishuExplanation>胡老：欲呕与干呕同类。</zz:huxishuExplanation>
        <zz:isInferred rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</zz:isInferred>
        <rdfs:comment xml:lang="zh">有恶心感未实际吐出。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#YuTu">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">欲吐</rdfs:label>
        <skos:altLabel xml:lang="zh">恶心</skos:altLabel>
        <skos:altLabel xml:lang="zh">泛恶</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第397条：伤寒解后，虚羸少气，气逆欲吐，竹叶石膏汤主之。</zz:originalDescription>
        <zz:huxishuExplanation>胡老：欲吐为胃气上逆之自觉症状。</zz:huxishuExplanation>
        <rdfs:comment xml:lang="zh">恶心感但未实际吐出。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#E">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">哕</rdfs:label>
        <skos:altLabel xml:lang="zh">呃逆</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第380条：……胃中虚冷故也。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">里虚寒之表现。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#QiNi">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">气逆</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第397条：伤寒解后，虚羸少气，气逆欲吐，竹叶石膏汤主之。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">热病后期余热未清。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#TuHui">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">吐蛔</rdfs:label>
        <skos:altLabel xml:lang="zh">吐虫</skos:altLabel>
        <skos:altLabel xml:lang="zh">食则吐蛔</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#BanBiaoBanLi"/>
        <zz:evidenceLevel>高特异铁证</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第326条：厥阴之为病……食则吐蛔。</zz:originalDescription>
        <zz:huxishuExplanation>胡老：食则吐蛔为厥阴病提纲特异性体征。</zz:huxishuExplanation>
        <rdfs:comment xml:lang="zh">厥阴提纲证之特异性症状。</rdfs:comment>
    </owl:NamedIndividual>

    <!-- 八、腹心下 -->

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#FuMan">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">腹满</rdfs:label>
        <skos:altLabel xml:lang="zh">腹胀满</skos:altLabel>
        <skos:altLabel xml:lang="zh">腹胀</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第273条：太阴之为病，腹满而吐……</zz:originalDescription>
        <zz:caoyingfuNote>曹颖甫《经方实验录》：腹满拒按属实（承气），喜按属虚（理中）。</zz:caoyingfuNote>
        <rdfs:comment xml:lang="zh">里证线索。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#XinXiaPi">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">心下痞</rdfs:label>
        <skos:altLabel xml:lang="zh">心下痞满</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第149条：但满而不痛者，此为痞……宜半夏泻心汤。</zz:originalDescription>
        <zz:caoyingfuNote>曹颖甫《经方实验录》：半夏泻心汤治心下痞。</zz:caoyingfuNote>
        <rdfs:comment xml:lang="zh">寒热错杂之痞。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#XinXiaMan">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">心下满</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第67条：伤寒，若吐、若下后，心下逆满，气上冲胸……茯苓桂枝白术甘草汤主之。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">水饮停于心下。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#XinXiaYin">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">心下饮</rdfs:label>
        <skos:altLabel xml:lang="zh">心下有水气</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第40条：伤寒表不解，心下有水气，干呕，发热而咳……小青龙汤主之。</zz:originalDescription>
        <zz:caoyingfuNote>曹颖甫《经方实验录》：小青龙汤治心下有水气。</zz:caoyingfuNote>
        <rdfs:comment xml:lang="zh">外寒内饮。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#LeiMing">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">腹中雷鸣</rdfs:label>
        <skos:altLabel xml:lang="zh">雷鸣</skos:altLabel>
        <skos:altLabel xml:lang="zh">肠鸣</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第157条：伤寒汗出解之后……腹中雷鸣下利者，生姜泻心汤主之。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">水饮与气滞并见。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#ShaoFuJiJie">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">少腹急结</rdfs:label>
        <skos:altLabel xml:lang="zh">少腹硬满</skos:altLabel>
        <skos:altLabel xml:lang="zh">少腹急</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <zz:evidenceLevel>高特异铁证</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第106条：但少腹急结者，乃可攻之，宜桃核承气汤。</zz:originalDescription>
        <zz:huxishuExplanation>胡老：少腹急结为蓄血证腹诊之眼目。</zz:huxishuExplanation>
        <rdfs:comment xml:lang="zh">太阳蓄血证之腹诊体征。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#FuZhongLeng">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">腹中寒</rdfs:label>
        <skos:altLabel xml:lang="zh">腹中冷</skos:altLabel>
        <skos:altLabel xml:lang="zh">腹部发凉</skos:altLabel>
        <skos:altLabel xml:lang="zh">腹中寒气</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·腹满寒疝宿食病篇第10条：腹中寒气，雷鸣切痛……附子粳米汤主之。</zz:originalDescription>
        <zz:huxishuExplanation>胡老：腹中寒气为里虚寒之自觉指征。</zz:huxishuExplanation>
        <rdfs:comment xml:lang="zh">里虚寒。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#XinXiaJi">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">心下急</rdfs:label>
        <skos:altLabel xml:lang="zh">心下急迫</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第103条：呕不止，心下急……与大柴胡汤下之则愈。</zz:originalDescription>
        <zz:huxishuExplanation>胡老：心下急为少阳病兼里实之特有腹症。</zz:huxishuExplanation>
        <rdfs:comment xml:lang="zh">少阳兼里实之征。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#XinXiaJian">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">心下硬</rdfs:label>
        <skos:altLabel xml:lang="zh">心下坚</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第157条：伤寒汗出解之后，胃中不和，心下痞硬……生姜泻心汤主之。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">寒热错杂痞证之征。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#ShaoFuXianJi">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">少腹弦急</rdfs:label>
        <skos:altLabel xml:lang="zh">少腹拘急</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·血痹虚劳病篇第8条：夫失精家，少腹弦急……桂枝加龙骨牡蛎汤主之。</zz:originalDescription>
        <zz:huxishuExplanation>胡老：少腹弦急为阴阳两虚、筋脉失养之腹诊特征。</zz:huxishuExplanation>
        <rdfs:comment xml:lang="zh">虚劳失精家之症。</rdfs:comment>
    </owl:NamedIndividual>

    <!-- 九、心胸 -->

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#XinJi">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">心悸</rdfs:label>
        <skos:altLabel xml:lang="zh">心动悸</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第177条：伤寒，脉结代，心动悸，炙甘草汤主之。</zz:originalDescription>
        <zz:caoyingfuNote>曹颖甫《经方实验录》：炙甘草汤治心动悸脉结代。</zz:caoyingfuNote>
        <rdfs:comment xml:lang="zh">气血两虚之征。亦可见于水饮凌心。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#XinFan">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">心烦</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第96条：伤寒五六日中风……心烦喜呕……小柴胡汤主之。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">热证线索。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#XinZhongAoNong">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">心中懊憹</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第76条：发汗吐下后，虚烦不得眠……心中懊憹，栀子豉汤主之。</zz:originalDescription>
        <zz:caoyingfuNote>曹颖甫《经方实验录》：栀子豉汤治心中懊憹。</zz:caoyingfuNote>
        <rdfs:comment xml:lang="zh">余热扰于胸膈之征。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#XinZhongTengRe">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">心中疼热</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <zz:evidenceLevel>高特异铁证</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第326条：厥阴之为病……心中疼热。</zz:originalDescription>
        <zz:caoyingfuNote>曹颖甫《经方实验录》：乌梅丸证'心中疼热'。</zz:caoyingfuNote>
        <rdfs:comment xml:lang="zh">厥阴提纲证之上热表现。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#QiShangZhuangXin">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">气上撞心</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#BanBiaoBanLi"/>
        <zz:evidenceLevel>高特异铁证</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第326条：厥阴之为病……气上撞心。</zz:originalDescription>
        <zz:huxishuExplanation>胡老：气上撞心为厥阴寒热错杂之特有表现。</zz:huxishuExplanation>
        <rdfs:comment xml:lang="zh">厥阴提纲证之特异性症状。</rdfs:comment>
    </owl:NamedIndividual>

    <!-- 十、喘咳气 -->

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#KeNi">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">咳逆</rdfs:label>
        <skos:altLabel xml:lang="zh">咳逆倚息</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·痰饮咳嗽病篇：咳逆倚息不得卧，小青龙汤主之。</zz:originalDescription>
        <zz:caoyingfuNote>曹颖甫《经方实验录》：小青龙汤治'咳逆倚息不得卧'。</zz:caoyingfuNote>
        <rdfs:comment xml:lang="zh">外寒内饮。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#KeSou">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">咳嗽</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第40条：伤寒表不解，心下有水气……发热而咳……小青龙汤主之。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">外寒引动内饮。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#Chuan">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">喘</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Biao"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第35条：太阳病……无汗而喘者，麻黄汤主之。</zz:originalDescription>
        <zz:caoyingfuNote>曹颖甫《经方实验录》：麻杏甘石汤治'汗出而喘'。</zz:caoyingfuNote>
        <rdfs:comment xml:lang="zh">表闭肺气不宣之征。亦见于里热壅肺。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#DuanQi">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">短气</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·中风历节病篇第8条：……头眩短气……桂枝芍药知母汤主之。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">气虚之征。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#ShangQi">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">上气</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·肺痿肺痈咳嗽上气病篇：上气喘而躁者……发汗则愈。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">肺胃气逆之泛称。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#XiongMan">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">胸满</rdfs:label>
        <skos:altLabel xml:lang="zh">胸闷</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第264条：少阳中风……胸中满而烦者，不可吐下。</zz:originalDescription>
        <zz:huxishuExplanation>胡老：胸满非独表证，痰饮气滞皆可见之。</zz:huxishuExplanation>
        <rdfs:comment xml:lang="zh">少阳中风之胸满。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#XiongXieKuMan">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">胸胁苦满</rdfs:label>
        <skos:altLabel xml:lang="zh">胸胁满</skos:altLabel>
        <skos:altLabel xml:lang="zh">胁下满</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#BanBiaoBanLi"/>
        <zz:evidenceLevel>高特异铁证</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第96条：伤寒五六日中风，往来寒热，胸胁苦满……小柴胡汤主之。</zz:originalDescription>
        <zz:huxishuExplanation>胡老：胸胁苦满为少阳病之核心症状。</zz:huxishuExplanation>
        <rdfs:comment xml:lang="zh">少阳主症之一。</rdfs:comment>
    </owl:NamedIndividual>

    <!-- 十一、头面五官 -->

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#TouYun">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">头晕</rdfs:label>
        <skos:altLabel xml:lang="zh">头眩</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第67条：伤寒……心下逆满，气上冲胸，起则头眩……茯苓桂枝白术甘草汤主之。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">水饮上犯之征。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#MuXuan">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">目眩</rdfs:label>
        <skos:altLabel xml:lang="zh">眼花</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#BanBiaoBanLi"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第263条：少阳之为病，口苦，咽干，目眩也。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">少阳提纲证之一。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#MuChi">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">目赤</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第264条：少阳中风……目赤，胸中满而烦者，不可吐下。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">热证线索。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#MuMing">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">目瞑</rdfs:label>
        <skos:altLabel xml:lang="zh">畏光闭目</skos:altLabel>
        <skos:altLabel xml:lang="zh">目闭不欲开</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Biao"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第46条：其人发烦目瞑，剧者必衄。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">瞑眩反应。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#ErLong">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">耳聋</rdfs:label>
        <skos:altLabel xml:lang="zh">两耳无所闻</skos:altLabel>
        <skos:altLabel xml:lang="zh">耳不闻</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#BanBiaoBanLi"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第264条：少阳中风，两耳无所闻……不可吐下。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">少阳经脉循耳。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#KouKu">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">口苦</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#BanBiaoBanLi"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第263条：少阳之为病，口苦，咽干，目眩也。</zz:originalDescription>
        <zz:caoyingfuNote>曹颖甫《经方实验录》：少阳病提纲证之一。</zz:caoyingfuNote>
        <rdfs:comment xml:lang="zh">少阳提纲证之一。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#YanGan">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">咽干</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#BanBiaoBanLi"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第263条：少阳之为病，口苦，咽干，目眩也。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">少阳提纲证之一。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#YanTong">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">咽痛</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第311条：少阴病，二三日，咽痛者，可与甘草汤。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">热证线索。少阴咽痛有虚热、实热之分。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#BiMing">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">鼻鸣</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Biao"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第12条：太阳中风，阳浮而阴弱……鼻鸣干呕者，桂枝汤主之。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">太阳中风表虚之兼症。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#MianChi">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">面赤</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第317条：少阴病……身反不恶寒，其人面色赤……通脉四逆汤主之。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">戴阳证（虚阳上浮），非实热。</rdfs:comment>
    </owl:NamedIndividual>

    <!-- 十二、四肢 -->

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#SiZhiJueNi">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">四肢厥逆</rdfs:label>
        <skos:altLabel xml:lang="zh">四肢逆冷</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <zz:evidenceLevel>高特异铁证</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第353条：大汗出，热不去，内拘急，四肢疼，又下利厥逆而恶寒者，四逆汤主之。</zz:originalDescription>
        <zz:caoyingfuNote>曹颖甫《经方实验录》：四逆汤治四肢厥逆。</zz:caoyingfuNote>
        <zz:huxishuExplanation>胡老：冷过肘膝为厥逆，冷不过腕踝为手足冷，程度有别。</zz:huxishuExplanation>
        <rdfs:comment xml:lang="zh">寒证高特异铁证。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#ShouZuJueLeng">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">手足厥冷</rdfs:label>
        <skos:altLabel xml:lang="zh">手足冷</skos:altLabel>
        <skos:altLabel xml:lang="zh">手足不温</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第337条：凡厥者，阴阳气不相顺接，便为厥。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">手足厥冷程度较四肢厥逆为轻。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#ShouZuRe">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">手足热</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <zz:isInferred rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</zz:isInferred>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第335条：厥者必发热……厥深者热亦深，厥微者热亦微。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">实热充斥之手足热。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#ShouZuHan">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">手足寒</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第305条：少阴病，身体痛，手足寒，骨节痛，脉沉者，附子汤主之。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">少阴病手足寒。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#MaMu">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">麻木</rdfs:label>
        <skos:altLabel xml:lang="zh">肌肤麻木</skos:altLabel>
        <skos:altLabel xml:lang="zh">肢体麻木</skos:altLabel>
        <skos:altLabel xml:lang="zh">身体不仁</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Biao"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·血痹虚劳病篇：血痹……外证身体不仁……黄芪桂枝五物汤主之。</zz:originalDescription>
        <zz:huxishuExplanation>胡老：麻木与手足不仁同类。</zz:huxishuExplanation>
        <rdfs:comment xml:lang="zh">营卫俱虚，表虚。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#ShouZuFanRe">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">手足烦热</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·血痹虚劳病篇第13条：虚劳里急……手足烦热……小建中汤主之。</zz:originalDescription>
        <zz:huxishuExplanation>胡老：手足烦热为虚劳阴虚内热之典型表现。</zz:huxishuExplanation>
        <rdfs:comment xml:lang="zh">虚劳阴虚内热。</rdfs:comment>
    </owl:NamedIndividual>

    <!-- 十三、水肿 -->

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#ShenTiZhong">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">身肿</rdfs:label>
        <skos:altLabel xml:lang="zh">全身水肿</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·水气病篇：诸有水者，腰以下肿，当利小便；腰以上肿，当发汗乃愈。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">水液泛溢肌肤。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#ShuiZhong">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">水肿</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <zz:isInferred rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</zz:isInferred>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <rdfs:comment xml:lang="zh">水液泛溢肌肤之泛称。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#MianFu">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">面浮</rdfs:label>
        <skos:altLabel xml:lang="zh">面目浮肿</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <zz:isInferred rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</zz:isInferred>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <rdfs:comment xml:lang="zh">水饮内停外溢。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#JiaoZhong">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">脚肿</rdfs:label>
        <skos:altLabel xml:lang="zh">脚肿如脱</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·中风历节病篇第8条：诸肢节疼痛……脚肿如脱……桂枝芍药知母汤主之。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">水湿下注。</rdfs:comment>
    </owl:NamedIndividual>

    <!-- 十四、神志 -->

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#ZhanYu">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">谵语</rdfs:label>
        <skos:altLabel xml:lang="zh">说胡话</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第212条：伤寒若吐若下后不解……但发热谵语者，大承气汤主之。</zz:originalDescription>
        <zz:caoyingfuNote>曹颖甫《经方实验录》：承气汤治谵语。</zz:caoyingfuNote>
        <rdfs:comment xml:lang="zh">阳明腑实、热扰心神之表现。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#RuKuang">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">如狂</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第106条：太阳病不解，热结膀胱，其人如狂……宜桃核承气汤。</zz:originalDescription>
        <zz:caoyingfuNote>曹颖甫《经方实验录》：桃核承气汤治如狂。</zz:caoyingfuNote>
        <rdfs:comment xml:lang="zh">太阳蓄血证。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#FanZao">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">烦躁</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第61条：下之后，复发汗，昼日烦躁不得眠……干姜附子汤主之。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">热证烦躁或阳虚烦躁。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#DanYuMei">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">但欲寐</rdfs:label>
        <skos:altLabel xml:lang="zh">嗜睡</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <zz:evidenceLevel>高特异铁证</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第281条：少阴之为病，脉微细，但欲寐也。</zz:originalDescription>
        <zz:caoyingfuNote>曹颖甫《经方实验录》：少阴病提纲证。</zz:caoyingfuNote>
        <zz:huxishuExplanation>胡老：少阴为里之阴证，阳气衰微，故但欲寐。</zz:huxishuExplanation>
        <rdfs:comment xml:lang="zh">少阴提纲证。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#MoMo">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">嘿嘿</rdfs:label>
        <skos:altLabel xml:lang="zh">默默</skos:altLabel>
        <skos:altLabel xml:lang="zh">神情默默</skos:altLabel>
        <skos:altLabel xml:lang="zh">不欲言语</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#BanBiaoBanLi"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第96条：嘿嘿不欲饮食……小柴胡汤主之。</zz:originalDescription>
        <zz:huxishuExplanation>胡老：'嘿嘿'与'不欲食'为两个独立症状。</zz:huxishuExplanation>
        <rdfs:comment xml:lang="zh">少阳证表现之一。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#Jing">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">惊</rdfs:label>
        <skos:altLabel xml:lang="zh">惊惕</skos:altLabel>
        <skos:altLabel xml:lang="zh">惊狂</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第112条：伤寒脉浮，医以火迫劫之，亡阳，必惊狂……桂枝去芍药加蜀漆牡蛎龙骨救逆汤主之。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">误治亡阳后之惊狂。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#Kong">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">恐</rdfs:label>
        <skos:altLabel xml:lang="zh">恐惧</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·五脏风寒积聚病篇：邪哭使魂魄不安者，血气少也……其人则畏。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">心气虚则畏恐。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#MengJiao">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">梦交</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·血痹虚劳病篇第8条：脉得诸芤动微紧，男子失精，女子梦交……桂枝加龙骨牡蛎汤主之。</zz:originalDescription>
        <zz:caoyingfuNote>曹颖甫《经方实验录》：桂枝加龙骨牡蛎汤治梦交。</zz:caoyingfuNote>
        <rdfs:comment xml:lang="zh">虚劳失精家之症。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#BeiShang">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">悲伤</rdfs:label>
        <skos:altLabel xml:lang="zh">悲伤欲哭</skos:altLabel>
        <skos:altLabel xml:lang="zh">喜悲伤欲哭</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·妇人杂病篇第6条：妇人脏躁，喜悲伤欲哭……甘麦大枣汤主之。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">脏躁为脏阴不足。</rdfs:comment>
    </owl:NamedIndividual>

    <!-- 十五、出血 -->

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#TuXue">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">吐血</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·惊悸吐血下血胸满瘀血病篇：吐血不止者，柏叶汤主之。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">吐血有虚实寒热之分。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#BianXue">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">便血</rdfs:label>
        <skos:altLabel xml:lang="zh">下血</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·惊悸吐血下血胸满瘀血病篇：下血，先便后血，此远血也，黄土汤主之。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">脾阳虚不能统血之远血。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#BiNiu">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">鼻衄</rdfs:label>
        <skos:altLabel xml:lang="zh">衄血</skos:altLabel>
        <skos:altLabel xml:lang="zh">鼻出血</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第46条：太阳病……剧者必衄，衄乃解。</zz:originalDescription>
        <zz:huxishuExplanation>胡老：衄为表邪外解之一途，亦有阳明热盛迫血妄行者。</zz:huxishuExplanation>
        <rdfs:comment xml:lang="zh">热证线索。</rdfs:comment>
    </owl:NamedIndividual>

    <!-- 十六、外伤 -->

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#JinChuang">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">金创</rdfs:label>
        <zz:isEventNotSymptom rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</zz:isEventNotSymptom>
        <zz:evidenceLevel>非典型症状</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·疮痈肠痈浸淫病篇：病金疮，王不留行散主之。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">外伤事件，非典型症状。</rdfs:comment>
    </owl:NamedIndividual>

    <!-- 十七、饮食虚劳 -->

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#ShiBuXia">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">食不下</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第273条：太阴之为病……食不下。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">太阴提纲证之一。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#ShaoQi">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">少气</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第397条：伤寒解后，虚羸少气……竹叶石膏汤主之。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">气阴两伤。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#NengShi">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">能食</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第190条：阳明病，若能食，名中风。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">阳明中风（热证）之鉴别点。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#BuYuShi">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">不欲食</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#BanBiaoBanLi"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第96条：嘿嘿不欲饮食……小柴胡汤主之。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">少阳证表现之一。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#JiBuYuShi">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">饥不欲食</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#BanBiaoBanLi"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第326条：厥阴之为病……饥而不欲食。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">厥阴提纲证之一。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#TuXianMo">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">吐涎沫</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·肺痿肺痈咳嗽上气病篇：肺痿，吐涎沫……甘草干姜汤以温之。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">肺中冷，里虚寒。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#TuNong">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">吐脓</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·肺痿肺痈咳嗽上气病篇：咳而胸满……久久吐脓如米粥者，为肺痈，桔梗汤主之。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">肺痈热毒壅肺。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#TuZhuo">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">吐浊</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <zz:isInferred rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</zz:isInferred>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <rdfs:comment xml:lang="zh">浊唾腥臭，里实证。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#YiJing">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">遗精</rdfs:label>
        <skos:altLabel xml:lang="zh">失精</skos:altLabel>
        <skos:altLabel xml:lang="zh">梦遗</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·血痹虚劳病篇第8条：夫失精家……</zz:originalDescription>
        <rdfs:comment xml:lang="zh">虚劳失精家之症。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#XuLei">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">虚羸</rdfs:label>
        <skos:altLabel xml:lang="zh">消瘦</skos:altLabel>
        <skos:altLabel xml:lang="zh">形体瘦弱</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第397条：伤寒解后，虚羸少气……竹叶石膏汤主之。</zz:originalDescription>
        <zz:huxishuExplanation>胡老：虚羸为热病后期气阴两伤之体征。</zz:huxishuExplanation>
        <rdfs:comment xml:lang="zh">虚证线索。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#WangLei">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">身体尪羸</rdfs:label>
        <skos:altLabel xml:lang="zh">关节变形</skos:altLabel>
        <skos:altLabel xml:lang="zh">尪羸</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·中风历节病篇第8条：诸肢节疼痛，身体尪羸……桂枝芍药知母汤主之。</zz:originalDescription>
        <zz:huxishuExplanation>胡老：身体尪羸指风湿历节日久、关节变形。</zz:huxishuExplanation>
        <rdfs:comment xml:lang="zh">风湿历节日久伤正。</rdfs:comment>
    </owl:NamedIndividual>

    <!-- 十八、杂症 -->

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#MianSeHei">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">面色黑</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·血痹虚劳病篇第18条：五劳虚极羸瘦……两目黯黑……大黄蟅虫丸主之。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">干血之候。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#ShouZuBuRen">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">手足不仁</rdfs:label>
        <skos:altLabel xml:lang="zh">手足麻木</skos:altLabel>
        <skos:altLabel xml:lang="zh">不仁</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Biao"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·血痹虚劳病篇：血痹……外证身体不仁……黄芪桂枝五物汤主之。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">营卫俱虚。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#QiXiaJi">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">脐下悸</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第65条：发汗后，其人脐下悸者，欲作奔豚……茯苓桂枝甘草大枣汤主之。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">水饮欲动。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#JiFuJiaCuo">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">肌肤甲错</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·血痹虚劳病篇第18条：五劳虚极羸瘦……内有干血，肌肤甲错……大黄蟅虫丸主之。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">干血内停之征。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#FuPiJi">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">腹皮急</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·疮痈肠痈浸淫病篇：肠痈之为病……腹皮急……薏苡附子败酱散主之。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">肠痈之腹诊体征。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#AnZhiRu">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">按之濡</rdfs:label>
        <skos:altLabel xml:lang="zh">按之软</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第151条：脉浮而紧，而复下之，紧反入里，则作痞，按之自濡，但气痞耳。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">无形之气滞，属里虚。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#AnTong">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">按痛</rdfs:label>
        <skos:altLabel xml:lang="zh">按之痛</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第138条：小结胸病，正在心下，按之则痛……小陷胸汤主之。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">痰热互结心下。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#JuAn">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">拒按</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <zz:isInferred rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</zz:isInferred>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <rdfs:comment xml:lang="zh">实证腹诊特征。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#ShenYouChuang">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">身有疮</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·疮痈肠痈浸淫病篇：浸淫疮……黄连粉主之。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">湿热实证。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#YouNong">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">有脓</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·疮痈肠痈浸淫病篇：诸痈肿，欲知有脓无脓，以手掩肿上，热者为有脓……</zz:originalDescription>
        <rdfs:comment xml:lang="zh">痈肿有脓为热毒壅聚。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#YanZhongYiWu">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">咽中异物感</rdfs:label>
        <skos:altLabel xml:lang="zh">咽中如有炙脔</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·妇人杂病篇第5条：妇人咽中如有炙脔，半夏厚朴汤主之。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">痰气交阻于咽喉。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#ShuQianShen">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">数欠伸</rdfs:label>
        <skos:altLabel xml:lang="zh">频繁打哈欠</skos:altLabel>
        <skos:altLabel xml:lang="zh">数欠</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·妇人杂病篇第6条：妇人脏躁……数欠伸……甘麦大枣汤主之。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">脏阴不足。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#ChunKouGanZao">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">唇口干燥</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·妇人杂病篇第9条（温经汤证）：唇口干燥。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">阴血不足之虚热。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#YinChuang">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">阴疮</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·妇人杂病篇：少阴脉滑而数者，阴中即生疮……狼牙汤洗之。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">湿热下注。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#YinChui">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">阴吹</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·妇人杂病篇：胃气下泄，阴吹而正喧，此谷气之实也……膏发煎导之。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">胃肠积滞。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#ShiQi">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">失气</rdfs:label>
        <skos:altLabel xml:lang="zh">放屁</skos:altLabel>
        <skos:altLabel xml:lang="zh">转矢气</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第209条：阳明病……转矢气者，此有燥屎也……</zz:originalDescription>
        <rdfs:comment xml:lang="zh">燥屎内结之征。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#TaiDong">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">胎动</rdfs:label>
        <zz:isEventNotSymptom rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</zz:isEventNotSymptom>
        <zz:evidenceLevel>非典型症状</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·妇人妊娠病篇第2条：妇人素有癥病……胎动在脐上者……</zz:originalDescription>
        <rdfs:comment xml:lang="zh">妊娠期生理现象。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#ShenTiChen">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">身重</rdfs:label>
        <skos:altLabel xml:lang="zh">身体沉重</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Biao"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第39条：伤寒脉浮缓，身不疼但重……大青龙汤发之。</zz:originalDescription>
        <rdfs:comment xml:lang="zh">表证线索。亦见于少阴里证。</rdfs:comment>
    </owl:NamedIndividual>

    <!-- 十九、妇科 -->

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#LouXia">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">漏下</rdfs:label>
        <skos:altLabel xml:lang="zh">经血淋漓</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·妇人妊娠病篇第2条：妇人素有癥病……而得漏下不止……桂枝茯苓丸主之。</zz:originalDescription>
        <zz:huxishuExplanation>胡老：漏下为胞宫出血淋漓不断。</zz:huxishuExplanation>
        <rdfs:comment xml:lang="zh">瘀血阻滞或冲任虚寒。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#JingDuan">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">经断</rdfs:label>
        <skos:altLabel xml:lang="zh">停经</skos:altLabel>
        <skos:altLabel xml:lang="zh">月经停止</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·妇人妊娠病篇第2条：妇人素有癥病，经断未及三月……桂枝茯苓丸主之。</zz:originalDescription>
        <zz:huxishuExplanation>胡老：经断未及三月而复漏下，提示癥积阻滞。</zz:huxishuExplanation>
        <rdfs:comment xml:lang="zh">生殖周期之生理/病理状态变化。</rdfs:comment>
    </owl:NamedIndividual>

    <!-- 二十、毛发及新增概念 -->

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#FaLuo">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">发落</rdfs:label>
        <skos:altLabel xml:lang="zh">脱发</skos:altLabel>
        <skos:altLabel xml:lang="zh">头发脱落</skos:altLabel>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·血痹虚劳病篇第8条：夫失精家……发落……</zz:originalDescription>
        <zz:huxishuExplanation>胡老：发落为失精家精血亏虚之体征。</zz:huxishuExplanation>
        <rdfs:comment xml:lang="zh">精血亏虚。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#YinTouHan">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">阴头寒</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·血痹虚劳病篇第8条：夫失精家……阴头寒……</zz:originalDescription>
        <zz:huxishuExplanation>胡老：阴头寒为肾阳虚衰之特异性自觉症。</zz:huxishuExplanation>
        <rdfs:comment xml:lang="zh">肾阳虚衰。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#ShenRunDong">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ObjectiveSign"/>
        <rdfs:label xml:lang="zh">身瞤动</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第82条：太阳病发汗……心下悸，头眩，身瞤动……真武汤主之。</zz:originalDescription>
        <zz:huxishuExplanation>胡老：身瞤动为阳虚水泛之体征。</zz:huxishuExplanation>
        <rdfs:comment xml:lang="zh">阳虚水泛。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#ShouZhangFanRe">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">手掌烦热</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·妇人杂病篇（温经汤证）：手掌烦热。</zz:originalDescription>
        <zz:huxishuExplanation>胡老：手掌烦热为冲任虚寒兼瘀血之虚热表现。</zz:huxishuExplanation>
        <rdfs:comment xml:lang="zh">虚热。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#WenWenYuTu">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">温温欲吐</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>金匮要略·中风历节病篇第8条：……温温欲吐……桂枝芍药知母汤主之。</zz:originalDescription>
        <zz:huxishuExplanation>胡老：温温欲吐为风湿历节化热伤胃之自觉症。</zz:huxishuExplanation>
        <rdfs:comment xml:lang="zh">胃气不和。</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#XinXiaJiDong">
        <rdf:type rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SubjectiveSymptom"/>
        <rdfs:label xml:lang="zh">心下悸动</rdfs:label>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:symptom_indicates_bagang rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <zz:evidenceLevel>一般线索</zz:evidenceLevel>
        <zz:originalDescription>伤寒论第127条：太阳病，小便利者，以饮水多，必心下悸……</zz:originalDescription>
        <zz:huxishuExplanation>胡老：心下悸动为水饮停于心下之自觉症。</zz:huxishuExplanation>
        <rdfs:comment xml:lang="zh">水饮停于心下。</rdfs:comment>
    </owl:NamedIndividual>

    <!-- ===== 新增原子症状（基于核验报告补缺） ===== -->

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#Ye">
