@prefix fjs: <http://www.tcm-classics.org/skos/fangji#> .
@prefix fj: <http://www.tcm-classics.org/fangji#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ✅ 关键：显式声明 Ontology IRI
<http://www.tcm-classics.org/skos/fangji>  a owl:Ontology ;
    owl:versionInfo "1.0" .
    
# ==========================================
# ConceptScheme 定义
# ==========================================
<http://www.tcm-classics.org/skos/fangji>
    a skos:ConceptScheme ;
    dc:title "伤寒杂病论方剂名称词汇表（完整版）"@zh ;
    dc:description "覆盖113首核心经方的SKOS词表，统一异名、别名、俗名检索归一。"@zh .

# ==========================================
# 桂枝汤类（18方）
# ==========================================
fjs:GuiZhiTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "桂枝汤"@zh ;
    skos:definition "出自《伤寒论》，由桂枝、芍药、甘草、生姜、大枣组成，主治太阳中风表虚证，功能解肌发表、调和营卫。"@zh ;
    skos:altLabel "桂枝"@zh, "桂枝发汗汤"@zh, "治感冒出汗的汤"@zh, "桂芍甘姜枣汤"@zh, "阳旦汤"@zh ;
    skos:exactMatch fj:GuiZhiTang .

fjs:GuiZhiJiaGeGenTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "桂枝加葛根汤"@zh ;
    skos:definition "桂枝汤加葛根，主治太阳中风兼项背强几几、汗出恶风者。"@zh ;
    skos:altLabel "桂枝葛根汤"@zh, "治脖子僵出汗的汤"@zh ;
    skos:exactMatch fj:GuiZhiJiaGeGenTang .

fjs:GuiZhiJiaHouPoXingRenTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "桂枝加厚朴杏子汤"@zh ;
    skos:definition "桂枝汤加厚朴、杏仁，主治太阳中风兼喘、宿有喘疾复感外邪者。"@zh ;
    skos:altLabel "桂枝朴杏汤"@zh, "治感冒出汗喘的汤"@zh ;
    skos:exactMatch fj:GuiZhiJiaHouPoXingRenTang .

fjs:GuiZhiJiaFuZiTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "桂枝加附子汤"@zh ;
    skos:definition "桂枝汤加附子，主治过汗伤阳、汗漏不止、恶风、四肢拘急者。"@zh ;
    skos:altLabel "桂枝附子汤"@zh, "治出汗不止怕冷的汤"@zh ;
    skos:exactMatch fj:GuiZhiJiaFuZiTang .

fjs:GuiZhiQuShaoYaoTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "桂枝去芍药汤"@zh ;
    skos:definition "桂枝汤去芍药，主治误下后胸满、脉促、表未解者。"@zh ;
    skos:altLabel "去芍桂枝汤"@zh, "治胸闷脉快的桂枝汤"@zh ;
    skos:exactMatch fj:GuiZhiQuShaoYaoTang .

fjs:GuiZhiQuShaoYaoJiaFuZiTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "桂枝去芍药加附子汤"@zh ;
    skos:definition "桂枝去芍药汤加附子，主治胸阳虚甚兼表阳不足、胸满微恶寒者。"@zh ;
    skos:altLabel "去芍加附桂枝汤"@zh ;
    skos:exactMatch fj:GuiZhiQuShaoYaoJiaFuZiTang .

fjs:GuiZhiXinJiaTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "桂枝新加汤"@zh ;
    skos:definition "桂枝汤加芍药、生姜各一两，人参三两，主治汗后营气不足身痛、脉沉迟者。"@zh ;
    skos:altLabel "新加汤"@zh, "桂枝加芍药生姜人参汤"@zh, "治出汗后身痛的汤"@zh ;
    skos:exactMatch fj:GuiZhiXinJiaTang .

fjs:GuiZhiGanCaoTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "桂枝甘草汤"@zh ;
    skos:definition "桂枝、甘草二味，主治过汗伤心阳、心下悸动、叉手自冒心者。"@zh ;
    skos:altLabel "桂甘汤"@zh, "治心慌心跳的简单汤"@zh ;
    skos:exactMatch fj:GuiZhiGanCaoTang .

fjs:LingGuiZhuGanTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "茯苓桂枝白术甘草汤"@zh ;
    skos:definition "茯苓、桂枝、白术、甘草四味，主治脾阳虚水饮上冲、心下逆满、气上冲胸、头眩者。"@zh ;
    skos:altLabel "苓桂术甘汤"@zh, "苓桂术甘"@zh, "治头晕水饮的汤"@zh ;
    skos:exactMatch fj:FuLingGuiZhiBaiZhuGanCaoTang .

fjs:ShaoYaoGanCaoTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "芍药甘草汤"@zh ;
    skos:definition "芍药、甘草二味，酸甘化阴缓急止痛，主治脚挛急、肌肉痉挛者。"@zh ;
    skos:altLabel "芍甘汤"@zh, "治抽筋的汤"@zh ;
    skos:exactMatch fj:ShaoYaoGanCaoTang .

fjs:ShaoYaoGanCaoFuZiTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "芍药甘草附子汤"@zh ;
    skos:definition "芍药、甘草、附子三味，主治汗后阴阳两虚、恶寒脚挛急者。"@zh ;
    skos:altLabel "芍甘附汤"@zh ;
    skos:exactMatch fj:ShaoYaoGanCaoFuZiTang .

fjs:GuiZhiFuZiTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "桂枝附子汤"@zh ;
    skos:definition "桂枝、附子、生姜、大枣、甘草，主治风湿在表兼阳虚、身体疼烦不能转侧者。"@zh ;
    skos:altLabel "桂附汤"@zh, "治风湿身痛的桂枝汤"@zh ;
    skos:exactMatch fj:GuiZhiFuZiTang .

fjs:BaiZhuFuZiTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "白术附子汤"@zh ;
    skos:definition "白术、附子、生姜、大枣、甘草，主治风湿偏里湿重于风、大便坚小便自利者。"@zh ;
    skos:altLabel "术附汤"@zh, "去桂加白术汤"@zh ;
    skos:exactMatch fj:BaiZhuFuZiTang .

fjs:GanCaoFuZiTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "甘草附子汤"@zh ;
    skos:definition "甘草、附子、白术、桂枝，主治风湿俱盛表里阳气皆虚、骨节掣痛不得屈伸者。"@zh ;
    skos:altLabel "甘附汤"@zh, "治关节剧痛怕风的汤"@zh ;
    skos:exactMatch fj:GanCaoFuZiTang .

fjs:GuiZhiJiaLongGuMuLiTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "桂枝加龙骨牡蛎汤"@zh ;
    skos:definition "桂枝汤加龙骨、牡蛎，主治阴阳两虚失精证、遗精滑泄、心悸失眠者。"@zh ;
    skos:altLabel "桂枝龙牡汤"@zh, "治遗精心慌的汤"@zh ;
    skos:exactMatch fj:GuiZhiJiaLongGuMuLiTang .

fjs:HuangQiJianZhongTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "黄芪建中汤"@zh ;
    skos:definition "小建中汤加黄芪，主治虚劳里急诸不足偏于气虚者。"@zh ;
    skos:altLabel "芪建中"@zh, "治体虚肚子痛的汤"@zh ;
    skos:exactMatch fj:HuangQiJianZhongTang .

fjs:XiaoJianZhongTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "小建中汤"@zh ;
    skos:definition "桂枝汤倍芍药加饴糖，主治中焦虚寒里急腹痛、虚劳腹痛者。"@zh ;
    skos:altLabel "建中汤"@zh, "治肚子痛喜按的汤"@zh ;
    skos:exactMatch fj:XiaoJianZhongTang .

fjs:DaJianZhongTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "大建中汤"@zh ;
    skos:definition "蜀椒、干姜、人参、胶饴，主治中阳衰微阴寒内盛、心胸大寒痛、呕不能食者。"@zh ;
    skos:altLabel "治剧烈肚子痛呕吐的汤"@zh ;
    skos:exactMatch fj:DaJianZhongTang .

# ==========================================
# 麻黄汤类（8方）
# ==========================================
fjs:MaHuangTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "麻黄汤"@zh ;
    skos:definition "麻黄、桂枝、甘草、杏仁，主治太阳伤寒表实证、无汗恶寒身痛脉浮紧者。"@zh ;
    skos:altLabel "麻黄"@zh, "麻黄发汗汤"@zh, "治感冒不出汗的汤"@zh, "麻桂杏甘汤"@zh ;
    skos:exactMatch fj:MaHuangTang .

fjs:DaQingLongTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "大青龙汤"@zh ;
    skos:definition "麻黄汤倍麻黄加石膏姜枣，主治外寒内热表实兼里热烦躁、无汗烦躁者。"@zh ;
    skos:altLabel "大青龙"@zh, "治感冒不出汗烦躁的汤"@zh ;
    skos:exactMatch fj:DaQingLongTang .

fjs:XiaoQingLongTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "小青龙汤"@zh ;
    skos:definition "麻黄、芍药、细辛、干姜、甘草、桂枝、五味子、半夏，主治外寒内饮证、咳喘痰稀白者。"@zh ;
    skos:altLabel "小青龙"@zh, "治咳喘痰稀的汤"@zh ;
    skos:exactMatch fj:XiaoQingLongTang .

fjs:MaXingShiGanTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "麻杏石甘汤"@zh ;
    skos:definition "麻黄、杏仁、甘草、石膏，主治邪热壅肺证、汗出而喘、身无大热者。"@zh ;
    skos:altLabel "麻杏甘石汤"@zh, "治喘出汗的汤"@zh ;
    skos:exactMatch fj:MaHuangXingRenGanCaoShiGaoTang .

fjs:MaXiFuXinTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "麻黄附子细辛汤"@zh ;
    skos:definition "麻黄、附子、细辛，主治太少两感证、发热脉沉者。"@zh ;
    skos:altLabel "麻附辛汤"@zh, "治发烧脉沉的汤"@zh ;
    skos:exactMatch fj:MaHuangFuZiXiXinTang .

fjs:MaHuangFuZiGanCaoTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "麻黄附子甘草汤"@zh ;
    skos:definition "麻黄、附子、甘草，主治太少两感轻证、微发热脉沉者。"@zh ;
    skos:altLabel "麻附甘汤"@zh ;
    skos:exactMatch fj:MaHuangFuZiGanCaoTang .

fjs:MaHuangJiaZhuTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "麻黄加术汤"@zh ;
    skos:definition "麻黄汤加白术，主治寒湿在表证、身烦疼者。"@zh ;
    skos:altLabel "麻黄术汤"@zh, "治湿气身痛的汤"@zh ;
    skos:exactMatch fj:MaHuangJiaZhuTang .

fjs:MaHuangYiYiGanCaoTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "麻黄薏苡甘草汤"@zh ;
    skos:definition "麻黄、甘草、薏苡仁、杏仁，主治风湿在表偏热证、一身尽疼日晡发热者。"@zh ;
    skos:altLabel "麻杏苡甘汤"@zh, "治下午发热身痛的汤"@zh ;
    skos:exactMatch fj:MaHuangYiYiGanCaoTang .

# ==========================================
# 葛根汤类（3方）
# ==========================================
fjs:GeGenTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "葛根汤"@zh ;
    skos:definition "葛根、麻黄、桂枝、生姜、甘草、芍药、大枣，主治太阳伤寒兼项背强几几、无汗恶风者。"@zh ;
    skos:altLabel "治脖子僵不出汗的汤"@zh ;
    skos:exactMatch fj:GeGenTang .

fjs:GeGenJiaBanXiaTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "葛根加半夏汤"@zh ;
    skos:definition "葛根汤加半夏，主治太阳阳明合病呕逆、无汗项背强者。"@zh ;
    skos:altLabel "葛根半夏汤"@zh ;
    skos:exactMatch fj:GeGenJiaBanXiaTang .

fjs:GeGenHuangQinHuangLianTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "葛根黄芩黄连汤"@zh ;
    skos:definition "葛根、甘草、黄芩、黄连，主治协热下利证、下利不止喘而汗出者。"@zh ;
    skos:altLabel "葛根芩连汤"@zh, "治拉肚子喘出汗的汤"@zh ;
    skos:exactMatch fj:GeGenHuangQinHuangLianTang .

# ==========================================
# 柴胡汤类（7方）
# ==========================================
fjs:XiaoChaiHuTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "小柴胡汤"@zh ;
    skos:definition "柴胡、黄芩、人参、半夏、甘草、生姜、大枣，主治少阳病半表半里证、往来寒热胸胁苦满者。"@zh ;
    skos:altLabel "小柴胡"@zh, "柴胡汤"@zh, "治忽冷忽热的汤"@zh, "柴芩参夏甘姜枣汤"@zh ;
    skos:exactMatch fj:XiaoChaiHuTang .

fjs:DaChaiHuTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "大柴胡汤"@zh ;
    skos:definition "小柴胡汤去人参甘草加芍药枳实大黄，主治少阳阳明合病、呕不止心下急痛者。"@zh ;
    skos:altLabel "大柴胡"@zh, "治呕吐肚子胀痛便秘的汤"@zh ;
    skos:exactMatch fj:DaChaiHuTang .

fjs:ChaiHuGuiZhiTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "柴胡桂枝汤"@zh ;
    skos:definition "小柴胡汤桂枝汤各半量，主治太阳少阳合病、发热微恶寒肢节疼微呕者。"@zh ;
    skos:altLabel "柴桂汤"@zh, "治感冒又忽冷忽热的汤"@zh ;
    skos:exactMatch fj:ChaiHuGuiZhiTang .

fjs:ChaiHuJiaMangXiaoTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "柴胡加芒硝汤"@zh ;
    skos:definition "小柴胡汤三分之一量加芒硝，主治少阳兼阳明燥结轻证、胸胁满呕日晡潮热者。"@zh ;
    skos:altLabel "柴胡芒硝汤"@zh ;
    skos:exactMatch fj:ChaiHuJiaMangXiaoTang .

fjs:ChaiHuGuiZhiGanJiangTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "柴胡桂枝干姜汤"@zh ;
    skos:definition "柴胡、桂枝、干姜、瓜蒌根、黄芩、牡蛎、甘草，主治少阳兼水饮内结证、胸胁满微结渴小便不利者。"@zh ;
    skos:altLabel "柴胡干姜汤"@zh, "治口渴胸胁胀的柴胡汤"@zh ;
    skos:exactMatch fj:ChaiHuGuiZhiGanJiangTang .

fjs:ChaiHuJiaLongGuMuLiTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "柴胡加龙骨牡蛎汤"@zh ;
    skos:definition "小柴胡汤去甘草加龙骨牡蛎桂枝茯苓大黄铅丹，主治少阳兼烦惊谵语证、胸满烦惊身重者。"@zh ;
    skos:altLabel "柴胡龙牡汤"@zh, "治失眠惊恐烦躁的汤"@zh ;
    skos:exactMatch fj:ChaiHuJiaLongGuMuLiTang .

fjs:SiNiSan_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "四逆散"@zh ;
    skos:definition "甘草、枳实、柴胡、芍药，主治阳郁厥逆证、手足不温胸胁胀闷脉弦者。"@zh ;
    skos:altLabel "治手脚凉心情郁闷的散"@zh ;
    skos:exactMatch fj:SiNiSan .

# ==========================================
# 白虎汤类（3方）
# ==========================================
fjs:BaiHuTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "白虎汤"@zh ;
    skos:definition "知母、石膏、甘草、粳米，主治阳明经证、大热大汗大渴脉洪大者。"@zh ;
    skos:altLabel "治高烧大汗大渴的汤"@zh ;
    skos:exactMatch fj:BaiHuTang .

fjs:BaiHuJiaRenShenTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "白虎加人参汤"@zh ;
    skos:definition "白虎汤加人参，主治阳明热盛兼气津两伤、大渴引饮时时恶风者。"@zh ;
    skos:altLabel "白虎人参汤"@zh, "治高烧大渴乏力的汤"@zh ;
    skos:exactMatch fj:BaiHuJiaRenShenTang .

fjs:ZhuYeShiGaoTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "竹叶石膏汤"@zh ;
    skos:definition "竹叶、石膏、半夏、麦门冬、人参、甘草、粳米，主治热病后期余热未清气阴两伤、虚羸少气气逆欲吐者。"@zh ;
    skos:altLabel "治退烧后虚弱呕吐的汤"@zh ;
    skos:exactMatch fj:ZhuYeShiGaoTang .

# ==========================================
# 承气汤类（5方）
# ==========================================
fjs:DaChengQiTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "大承气汤"@zh ;
    skos:definition "大黄、厚朴、枳实、芒硝，主治阳明腑实重证、痞满燥实坚俱全、潮热谵语腹满痛拒按者。"@zh ;
    skos:altLabel "大承气"@zh, "治严重便秘腹胀说胡话的汤"@zh ;
    skos:exactMatch fj:DaChengQiTang .

fjs:XiaoChengQiTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "小承气汤"@zh ;
    skos:definition "大黄、厚朴、枳实，主治阳明腑实轻证、痞满实而不燥坚、谵语便硬者。"@zh ;
    skos:altLabel "小承气"@zh, "治轻度便秘腹胀的汤"@zh ;
    skos:exactMatch fj:XiaoChengQiTang .

fjs:TiaoWeiChengQiTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "调胃承气汤"@zh ;
    skos:definition "大黄、甘草、芒硝，主治阳明燥热初结、心烦蒸蒸发热腹满不甚者。"@zh ;
    skos:altLabel "调胃承气"@zh, "治心烦发热轻微腹胀的汤"@zh ;
    skos:exactMatch fj:TiaoWeiChengQiTang .

fjs:TaoHeChengQiTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "桃核承气汤"@zh ;
    skos:definition "桃仁、大黄、桂枝、甘草、芒硝，主治蓄血轻证、如狂少腹急结者。"@zh ;
    skos:altLabel "桃仁承气汤"@zh, "治小腹急痛精神异常的汤"@zh ;
    skos:exactMatch fj:TaoHeChengQiTang .

fjs:DiDangTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "抵当汤"@zh ;
    skos:definition "水蛭、虻虫、桃仁、大黄，主治蓄血重证、发狂少腹硬满脉沉结者。"@zh ;
    skos:altLabel "治严重瘀血发狂的汤"@zh ;
    skos:exactMatch fj:DiDangTang .

# ==========================================
# 理中汤类（3方）
# ==========================================
fjs:LiZhongTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "理中汤"@zh ;
    skos:definition "人参、干姜、甘草、白术，主治太阴虚寒本证、腹满吐利食不下口不渴者。"@zh ;
    skos:altLabel "理中丸"@zh, "治肚子冷痛拉肚子的汤"@zh ;
    skos:exactMatch fj:LiZhongTang .

fjs:FuZiLiZhongTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "附子理中汤"@zh ;
    skos:definition "理中汤加附子，主治太阴虚寒重证兼肾阳不足、腹满吐利畏寒肢冷者。"@zh ;
    skos:altLabel "附子理中丸"@zh, "治严重肚子冷痛怕冷的汤"@zh ;
    skos:exactMatch fj:FuZiLiZhongTang .

fjs:WuZhuYuTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "吴茱萸汤"@zh ;
    skos:definition "吴茱萸、人参、生姜、大枣，主治肝胃虚寒浊阴上逆证、食谷欲呕头痛吐涎沫者。"@zh ;
    skos:altLabel "治吃东西就吐头痛的汤"@zh ;
    skos:exactMatch fj:WuZhuYuTang .

# ==========================================
# 四逆汤类（6方）
# ==========================================
fjs:SiNiTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "四逆汤"@zh ;
    skos:definition "甘草、干姜、附子，主治少阴寒化本证、四肢厥逆下利清谷脉沉微者。"@zh ;
    skos:altLabel "治手脚冰凉拉肚子脉弱的汤"@zh ;
    skos:exactMatch fj:SiNiTang .

fjs:TongMaiSiNiTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "通脉四逆汤"@zh ;
    skos:definition "四逆汤加重干姜附子，主治少阴阴盛格阳证、下利清谷手足厥逆面赤脉微欲绝者。"@zh ;
    skos:altLabel "治假热真寒危证的汤"@zh ;
    skos:exactMatch fj:TongMaiSiNiTang .

fjs:BaiTongTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "白通汤"@zh ;
    skos:definition "葱白、干姜、附子，主治少阴阴盛戴阳证、下利面赤脉微者。"@zh ;
    skos:altLabel "治拉肚子脸红的汤"@zh ;
    skos:exactMatch fj:BaiTongTang .

fjs:BaiTongJiaZhuDanZhiTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "白通加猪胆汁汤"@zh ;
    skos:definition "白通汤加人尿猪胆汁，主治阴盛格阳服热药拒不受、利不止厥逆无脉干呕烦者。"@zh ;
    skos:altLabel "白通加胆汁汤"@zh ;
    skos:exactMatch fj:BaiTongJiaZhuDanZhiTang .

fjs:ZhenWuTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "真武汤"@zh ;
    skos:definition "茯苓、芍药、白术、生姜、附子，主治少阴阳虚水泛证、四肢沉重小便不利下利头眩者。"@zh ;
    skos:altLabel "治水肿头晕怕冷的汤"@zh ;
    skos:exactMatch fj:ZhenWuTang .

fjs:HuangLianEJiaoTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "黄连阿胶汤"@zh ;
    skos:definition "黄连、黄芩、芍药、鸡子黄、阿胶，主治少阴热化证、心中烦不得卧者。"@zh ;
    skos:altLabel "治心烦失眠的滋阴汤"@zh ;
    skos:exactMatch fj:HuangLianEJiaoTang .

