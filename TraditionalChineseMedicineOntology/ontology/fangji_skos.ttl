    skos:altLabel "治吃东西马上吐的汤"@zh ;
    skos:exactMatch fj:GanJiangHuangQinHuangLianRenShenTang .

fjs:BanXiaXieXinTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "半夏泻心汤"@zh ;
