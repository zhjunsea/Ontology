    skos:definition "栀子、香豉，主治热郁胸膈证、虚烦不得眠心中懊憹者。"@zh ;
    skos:altLabel "栀豉汤"@zh, "治心烦睡不着的汤"@zh ;
    skos:exactMatch fj:ZhiZiChiTang .

fjs:ZhiZiGanCaoTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
