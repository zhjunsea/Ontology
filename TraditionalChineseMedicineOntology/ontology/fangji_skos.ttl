    skos:altLabel "瓜蒌薤白汤"@zh, "治胸痛气短的汤"@zh ;
    skos:exactMatch fj:GuaLouXieBaiBaiJiuTang .

fjs:GuaLouXieBaiBanXiaTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "瓜蒌薤白半夏汤"@zh ;
    skos:definition "瓜蒌实、薤白、半夏、白酒，主治胸痹痰浊壅盛证、心痛彻背不得卧者。"@zh ;
    skos:altLabel "治严重胸痛不能躺的汤"@zh ;
    skos:exactMatch fj:GuaLouXieBaiBanXiaTang .

fjs:ZhiShiXieBaiGuiZhiTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
