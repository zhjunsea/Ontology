    skos:definition "当归四逆汤加吴茱萸生姜，主治血虚寒凝兼内有久寒、手足厥寒脘腹冷痛呕吐清涎者。"@zh ;
    skos:altLabel "当归四逆加萸姜汤"@zh ;
    skos:exactMatch fj:DangGuiSiNiJiaWuZhuYuShengJiangTang .

fjs:BaiTouWengTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "白头翁汤"@zh ;
    skos:definition "白头翁、黄柏、黄连、秦皮，主治厥阴湿热下利证、下利脓血里急后重者。"@zh ;
    skos:altLabel "治痢疾脓血的汤"@zh ;
    skos:exactMatch fj:BaiTouWengTang .

fjs:GanJiangHuangQinHuangLianRenShenTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
