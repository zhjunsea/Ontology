    skos:definition "枳实、厚朴、薤白、桂枝、瓜蒌实，主治胸痹气结重证、心中痞气胁下逆抢心者。"@zh ;
    skos:altLabel "治胸胁胀痛气上冲的汤"@zh ;
    skos:exactMatch fj:ZhiShiXieBaiGuiZhiTang .

fjs:HouPoQiWuTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "厚朴七物汤"@zh ;
    skos:definition "厚朴、甘草、大黄、大枣、枳实、桂枝、生姜，主治腹满兼表证、腹满发热脉浮数者。"@zh ;
    skos:altLabel "治肚子胀发烧的汤"@zh ;
    skos:exactMatch fj:HouPoQiWuTang .

fjs:GuiZhiShaoYaoZhiMuTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "桂枝芍药知母汤"@zh ;
    skos:definition "桂枝、芍药、甘草、麻黄、生姜、白术、知母、防风、附子，主治风湿历节证、肢节疼痛身体尪羸脚肿者。"@zh ;
    skos:altLabel "治关节肿痛变形的汤"@zh ;
    skos:exactMatch fj:GuiZhiShaoYaoZhiMuTang .

fjs:WuTouTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "乌头汤"@zh ;
    skos:definition "川乌、麻黄、芍药、黄芪、甘草，主治寒湿历节重证、关节剧痛不可屈伸者。"@zh ;
    skos:altLabel "治关节剧痛不能动的汤"@zh ;
    skos:exactMatch fj:WuTouTang .

fjs:GuiZhiFuLingWan_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "桂枝茯苓丸"@zh ;
    skos:definition "桂枝、茯苓、牡丹皮、桃仁、芍药，主治瘀血癥积证、漏下不止少腹癥块者。"@zh ;
    skos:altLabel "治子宫肌瘤出血的丸"@zh ;
    skos:exactMatch fj:GuiZhiFuLingWan .

fjs:WenJingTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "温经汤"@zh ;
    skos:definition "吴茱萸、当归、川芎、芍药、人参、桂枝、阿胶、牡丹皮、生姜、甘草、半夏、麦门冬，主治冲任虚寒瘀血阻滞证、暮热少腹里急手掌烦热唇口干燥者。"@zh ;
    skos:altLabel "治更年期月经不调的汤"@zh ;
    skos:exactMatch fj:WenJingTang .

fjs:JiaoAiTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
