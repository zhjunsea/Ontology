# 厥阴病及金匮杂病方（33方）
# ==========================================
fjs:WuMeiWan_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "乌梅丸"@zh ;
    skos:definition "乌梅、细辛、干姜、黄连、当归、附子、蜀椒、桂枝、人参、黄柏，主治厥阴寒热错杂证、蛔厥久利者。"@zh ;
    skos:altLabel "治蛔虫腹痛久泻的丸"@zh ;
    skos:exactMatch fj:WuMeiWan .

fjs:DangGuiSiNiTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "当归四逆汤"@zh ;
    skos:definition "当归、桂枝、芍药、细辛、甘草、通草、大枣，主治厥阴血虚寒凝证、手足厥寒脉细欲绝者。"@zh ;
    skos:altLabel "治手脚凉脉细的汤"@zh ;
    skos:exactMatch fj:DangGuiSiNiTang .

fjs:DangGuiSiNiJiaWuZhuYuShengJiangTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
