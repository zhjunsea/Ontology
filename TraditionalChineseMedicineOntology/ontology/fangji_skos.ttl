    skos:prefLabel "栀子生姜汤"@zh ;
    skos:definition "栀子豉汤加生姜，主治热郁胸膈兼呕、虚烦懊憹呕吐者。"@zh ;
    skos:altLabel "栀姜汤"@zh ;
    skos:exactMatch fj:ZhiZiShengJiangTang .

fjs:ZhiZiHouPoTang_Concept
