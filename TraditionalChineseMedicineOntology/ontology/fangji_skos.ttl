    skos:altLabel "治严重拉肚子胃胀心烦的汤"@zh ;
    skos:exactMatch fj:GanCaoXieXinTang .

fjs:DaHuangHuangLianXieXinTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "大黄黄连泻心汤"@zh ;
    skos:definition "大黄、黄连，主治热痞证、心下痞按之濡关脉浮者。"@zh ;
    skos:altLabel "治胃胀按着软的清热汤"@zh ;
    skos:exactMatch fj:DaHuangHuangLianXieXinTang .

fjs:FuZiXieXinTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "附子泻心汤"@zh ;
    skos:definition "大黄、黄连、黄芩、附子，主治热痞兼表阳虚证、心下痞恶寒汗出者。"@zh ;
    skos:altLabel "治胃胀又怕冷出汗的汤"@zh ;
    skos:exactMatch fj:FuZiXieXinTang .

fjs:WuLingSan_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "五苓散"@zh ;
    skos:definition "猪苓、泽泻、白术、茯苓、桂枝，主治蓄水证、小便不利口渴微热者。"@zh ;
    skos:altLabel "治口渴尿少的散"@zh ;
    skos:exactMatch fj:WuLingSan .

fjs:FuLingGanCaoTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "茯苓甘草汤"@zh ;
    skos:definition "茯苓、桂枝、甘草、生姜，主治胃中停水证、汗出不渴心下悸者。"@zh ;
    skos:altLabel "苓甘汤"@zh ;
    skos:exactMatch fj:FuLingGanCaoTang .

fjs:XuanFuDaiZheTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "旋覆代赭汤"@zh ;
    skos:definition "旋覆花、人参、生姜、代赭石、甘草、半夏、大枣，主治胃虚痰阻气逆证、心下痞硬噫气不除者。"@zh ;
    skos:altLabel "治打嗝不止胃胀的汤"@zh ;
    skos:exactMatch fj:XuanFuDaiZheTang .

fjs:HouPoShengJiangBanXiaGanCaoRenShenTang_Concept
