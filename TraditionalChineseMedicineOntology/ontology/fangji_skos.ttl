    skos:altLabel "芎归胶艾汤"@zh, "治崩漏安胎的汤"@zh ;
    skos:exactMatch fj:JiaoAiTang .

fjs:DangGuiShaoYaoSan_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "当归芍药散"@zh ;
    skos:definition "当归、芍药、川芎、茯苓、白术、泽泻，主治肝脾不和血虚湿滞证、妊娠腹痛水肿者。"@zh ;
    skos:altLabel "归芍散"@zh, "治孕妇肚子痛水肿的散"@zh ;
    skos:exactMatch fj:DangGuiShaoYaoSan .

fjs:BaiHeDiHuangTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "百合地黄汤"@zh ;
    skos:definition "百合、生地黄汁，主治心肺阴虚内热证、神志恍惚口苦小便赤脉微数者。"@zh ;
    skos:altLabel "治精神恍惚口苦的汤"@zh ;
    skos:exactMatch fj:BaiHeDiHuangTang .

fjs:SuanZaoRenTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "酸枣仁汤"@zh ;
    skos:definition "酸枣仁、甘草、知母、茯苓、川芎，主治肝血不足虚热扰心证、虚烦不眠心悸盗汗者。"@zh ;
    skos:altLabel "治失眠心慌盗汗的汤"@zh ;
    skos:exactMatch fj:SuanZaoRenTang .

fjs:HuangTuTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "黄土汤"@zh ;
    skos:definition "甘草、干地黄、白术、附子、阿胶、黄芩、灶心黄土，主治脾阳虚寒便血证、先便后血色暗淡者。"@zh ;
    skos:altLabel "治大便出血色暗的汤"@zh ;
    skos:exactMatch fj:HuangTuTang .

fjs:ChiXiaoDouDangGuiSan_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "赤小豆当归散"@zh ;
    skos:definition "赤小豆、当归，主治湿热便血证、先血后便血色鲜红者。"@zh ;
    skos:altLabel "治痔疮出血的散"@zh ;
    skos:exactMatch fj:ChiXiaoDouDangGuiSan .

fjs:MaiMenDongTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "麦门冬汤"@zh ;
    skos:definition "麦门冬、半夏、人参、甘草、粳米、大枣，主治肺胃阴虚气逆证、咳逆上气咽喉不利者。"@zh ;
    skos:altLabel "治干咳嗓子干的汤"@zh ;
    skos:exactMatch fj:MaiMenDongTang .

fjs:SheGanMaHuangTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "射干麻黄汤"@zh ;
    skos:definition "射干、麻黄、生姜、细辛、紫菀、款冬花、五味子、大枣、半夏，主治寒饮郁肺咳喘证、咳而上气喉中水鸡声者。"@zh ;
    skos:altLabel "治哮喘喉咙响的汤"@zh ;
    skos:exactMatch fj:SuanZaoRenTang_JinKui .

fjs:HouPoMaHuangTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "厚朴麻黄汤"@zh ;
    skos:definition "厚朴、麻黄、石膏、杏仁、半夏、干姜、细辛、小麦、五味子，主治饮热迫肺咳喘证、咳而脉浮胸满烦躁者。"@zh ;
    skos:altLabel "治咳嗽胸满烦躁的汤"@zh ;
    skos:exactMatch fj:HouPoMaHuangTang .

fjs:ZeQiTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "泽漆汤"@zh ;
    skos:definition "半夏、紫参、生姜、白前、甘草、黄芩、人参、桂枝、泽漆，主治水饮内停咳喘证、咳而脉沉身肿者。"@zh ;
    skos:altLabel "治咳嗽水肿脉沉的汤"@zh ;
    skos:exactMatch fj:ZeQiTang .

fjs:TouFengMoSan_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
    skos:prefLabel "头风摩散"@zh ;
    skos:definition "大附子、盐，外用方，主治头风头痛。"@zh ;
    skos:altLabel "治头痛的外用药"@zh ;
    skos:exactMatch fj:TianWuTouChiShiMiSan .