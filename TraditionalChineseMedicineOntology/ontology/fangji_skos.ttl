    skos:altLabel "治胃胀呕吐拉肚子的汤"@zh ;
    skos:exactMatch fj:BanXiaXieXinTang .

fjs:ShengJiangXieXinTang_Concept
    a skos:Concept ;
    skos:inScheme fjs:Scheme ;
