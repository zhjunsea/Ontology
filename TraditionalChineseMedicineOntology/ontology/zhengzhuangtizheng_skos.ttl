### ========== 一、寒热汗（17个） ==========

zzskos:EHan a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "恶寒"@zh ;
    skos:definition "自觉怕冷，加衣被不减。太阳表证或少阴里虚寒均可见。"@zh ;
    skos:altLabel "恶风寒"@zh, "憎寒"@zh, "畏寒"@zh, "寒战"@zh, "洒淅恶寒"@zh ;
    skos:hiddenLabel "怕冷"@zh, "发冷"@zh, "打寒战"@zh, "觉得冷"@zh, "冻得慌"@zh, "盖被子也冷"@zh, "冷战"@zh, "浑身发冷"@zh ;
    skos:note "伤寒论第7条：'病有发热恶寒者，发于阳也；无热恶寒者，发于阴也。'曹颖甫《经方实验录》：'啬啬恶寒'即此。胡老：太阳之恶寒与发热并见，少阴之恶寒不发热而但欲寐。"@zh ;
    skos:exactMatch zz:EHan .

zzskos:EFeng a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "恶风"@zh ;
    skos:definition "自觉怕风，遇风则冷，避风则缓。太阳中风证（表虚证）特异性指征。"@zh ;
    skos:altLabel "畏风"@zh, "恶风怕冷"@zh, "不耐风"@zh ;
    skos:hiddenLabel "怕风"@zh, "怕吹风"@zh, "见风冷"@zh, "不喜欢风"@zh, "避风"@zh, "一吹风就不舒服"@zh ;
    skos:note "伤寒论第12条：'太阳中风……淅淅恶风'。曹颖甫《经方实验录》：'淅淅恶风'即此。胡老：恶风为太阳中风（表虚）之主症。"@zh ;
    skos:exactMatch zz:EFeng .

zzskos:ERe a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "恶热"@zh ;
    skos:definition "自觉怕热、不耐热。阳明里热炽盛之特异性指征，与太阳表证之恶寒相对。"@zh ;
    skos:altLabel "怕热"@zh, "畏热"@zh, "不耐热"@zh, "身畏热"@zh ;
    skos:hiddenLabel "热得慌"@zh, "不喜欢热"@zh, "一热就烦"@zh, "讨厌热"@zh, "嫌热"@zh ;
    skos:note "伤寒论第182条：'身热，汗自出，不恶寒，反恶热也。'胡老：此证为里热之确据，不可误作表证。"@zh ;
    skos:exactMatch zz:ERe .

zzskos:FaRe a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "发热"@zh ;
    skos:definition "体温升高或自觉身热。正气抗邪之反应。"@zh ;
    skos:altLabel "发烧"@zh, "壮热"@zh, "蒸蒸发热"@zh, "翕翕发热"@zh ;
    skos:hiddenLabel "烧"@zh, "烫"@zh, "体温高"@zh, "低烧"@zh, "高烧"@zh, "身上烫"@zh, "发烫"@zh, "体温37.5以上"@zh, "低热"@zh, "高热不退"@zh ;
    skos:note "伤寒论第3条：'太阳病，或已发热，或未发热。'曹颖甫《经方实验录》：'翕翕发热'属桂枝汤，'蒸蒸发热'属调胃承气汤。"@zh ;
    skos:exactMatch zz:FaRe .

zzskos:ShenRe a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "身热"@zh ;
    skos:definition "身体灼热，但热不寒。阳明里热蒸腾于外。"@zh ;
    skos:altLabel "身大热"@zh, "肌肤灼热"@zh ;
    skos:hiddenLabel "浑身烫"@zh, "烧得厉害"@zh, "滚烫"@zh, "全身发热"@zh ;
    skos:note "伤寒论第182条。曹颖甫《经方实验录》：白虎汤证四大症之一。"@zh ;
    skos:exactMatch zz:ShenRe .

zzskos:ChaoRe a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "潮热"@zh ;
    skos:definition "热势如潮，定时而发（日晡所）。阳明腑实典型热型。"@zh ;
    skos:altLabel "日晡潮热"@zh, "日晡发热"@zh, "日晡所发潮热"@zh ;
    skos:hiddenLabel "下午发烧"@zh, "到点就烧"@zh, "傍晚热"@zh, "定时发热"@zh ;
    skos:note "伤寒论第208条。曹颖甫《经方实验录》：日晡所潮热，属阳明，宜承气汤。"@zh ;
    skos:exactMatch zz:ChaoRe .

zzskos:WangLaiHanRe a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "往来寒热"@zh ;
    skos:definition "寒热交替发作，正邪分争，有明确时序交替特征。少阳病特异性热型。"@zh ;
    skos:altLabel "寒热往来"@zh, "休作有时"@zh, "寒热交作"@zh ;
    skos:hiddenLabel "忽冷忽热"@zh, "一会冷一会热"@zh, "冷热交替"@zh, "打摆子"@zh, "一阵冷一阵热"@zh ;
    skos:note "伤寒论第96条。胡老：往来寒热为少阳病独有热型。"@zh ;
    skos:exactMatch zz:WangLaiHanRe .

zzskos:HanChu a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "汗出"@zh ;
    skos:definition "体表有汗液排出。表证汗出为中风（桂枝汤证）。"@zh ;
    skos:altLabel "出汗"@zh, "有汗"@zh, "汗自出"@zh, "微汗出"@zh, "自汗出"@zh ;
    skos:hiddenLabel "流汗"@zh, "冒汗"@zh, "一身汗"@zh, "虚汗"@zh, "出汗不止"@zh ;
    skos:note "伤寒论第12条：'阴弱者汗自出。'曹颖甫《经方实验录》：'病汗'与'药汗'有别。"@zh ;
    skos:exactMatch zz:HanChu .

zzskos:WuHan a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "无汗"@zh ;
    skos:definition "体表干燥无汗。表实证标志，腠理闭塞。"@zh ;
    skos:altLabel "不出汗"@zh, "汗不出"@zh, "无汗出"@zh ;
    skos:hiddenLabel "干烧"@zh, "没汗"@zh, "皮肤干"@zh, "一滴汗都没有"@zh ;
    skos:note "伤寒论第35条。曹颖甫《经方实验录》：麻黄汤证主症之一，'无汗而喘'。"@zh ;
    skos:exactMatch zz:WuHan .

zzskos:ZiHan a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "自汗"@zh ;
    skos:definition "不因劳作、天热而自然汗出。表虚或阳明里热迫津所致。"@zh ;
    skos:altLabel "常自汗出"@zh ;
    skos:hiddenLabel "动不动就出汗"@zh, "虚汗"@zh, "白天出汗"@zh ;
    skos:note "伤寒论第53条。曹颖甫《经方实验录》：桂枝汤证'常自汗出'即此。胡老：自汗主见表虚与阳明里热迫津。"@zh ;
    skos:exactMatch zz:ZiHan .

zzskos:DaoHan a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "盗汗"@zh ;
    skos:definition "睡中汗出，醒则汗止。阴虚或阳虚所致。"@zh ;
    skos:altLabel "夜汗"@zh, "寝汗"@zh ;
    skos:hiddenLabel "睡觉出汗"@zh, "半夜出汗"@zh, "醒来一身汗"@zh ;
    skos:note "金匮要略·血痹虚劳病篇：'男子平人，脉虚弱细微者，善盗汗也。'曹颖甫《经方实验录》：桂枝加龙骨牡蛎汤治盗汗效佳。"@zh ;
    skos:exactMatch zz:DaoHan .

zzskos:ShouZuJiRanHanChu a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "手足濈然汗出"@zh ;
    skos:definition "手足持续微汗不断。阳明腑实燥屎已成之特异性指征。"@zh ;
    skos:altLabel "手足汗出"@zh, "手足濈濈然汗出"@zh, "手足汗出濈濈然"@zh ;
    skos:hiddenLabel "手心出汗"@zh, "脚底出汗"@zh, "手脚一直冒汗"@zh, "手足湿润"@zh ;
    skos:note "伤寒论第208条。胡老：此症为阳明腑实已成之确据。"@zh ;
    skos:exactMatch zz:ShouZuJiRanHanChu .

zzskos:TouHan a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "头汗"@zh ;
    skos:definition "仅头部出汗，剂颈而还。湿热郁蒸或虚阳上越之征。"@zh ;
    skos:altLabel "但头汗出"@zh, "额上汗出"@zh, "额汗"@zh, "头汗出"@zh ;
    skos:hiddenLabel "额头冒汗"@zh, "只有脑门出汗"@zh, "脖子以下没汗"@zh, "头上出汗"@zh ;
    skos:note "伤寒论第236条：'但头汗出，身无汗，剂颈而还。'v6.3将原EShangHanChu合并入本概念，'额上汗出'为其部位细化。"@zh ;
    skos:exactMatch zz:TouHan .

zzskos:HuangHan a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "黄汗"@zh ;
    skos:definition "汗出色黄，沾衣如柏汁。水气病篇专有病证。"@zh ;
    skos:altLabel "汗出沾衣如柏汁"@zh, "汗色黄"@zh ;
    skos:hiddenLabel "出黄汗"@zh, "汗是黄的"@zh, "衣服染黄"@zh ;
    skos:note "金匮要略·水气病篇：'黄汗之为病，身体肿，发热汗出而渴，状如风水，汗沾衣，色正黄如柏汁。'黄芪芍药桂枝苦酒汤主之。"@zh ;
    skos:exactMatch zz:HuangHan .

zzskos:BeiWeiEhanRe a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "背微恶寒（阳明热盛伤气）"@zh ;
    skos:definition "背部轻微怕冷，兼口燥渴、心烦。阳明热盛兼气阴两伤之特征，属里+热。与少阴阳虚之背恶寒病机迥异，须以口中和、不渴辨之。"@zh ;
    skos:altLabel "背恶寒"@zh, "背微寒"@zh ;
    skos:hiddenLabel "后背怕冷"@zh, "背脊发凉"@zh, "后背凉飕飕"@zh, "背寒"@zh ;
    skos:note "伤寒论第169条：'伤寒无大热，口燥渴，心烦，背微恶寒者，白虎加人参汤主之。'胡老：背微恶寒为阳明热盛伤气之特征，与表证恶寒不同。v6.3由原BeiWeiEhan拆出，与BeiWeiEhanHan（少阴阳虚）并列。"@zh ;
    skos:exactMatch zz:BeiWeiEhanRe .

zzskos:BeiWeiEhanHan a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "背恶寒（少阴阳虚）"@zh ;
    skos:definition "背部恶寒，口中和、不渴。少阴阳虚不能温煦之征，属里+寒+虚。与阳明热盛之背微恶寒病机迥异。"@zh ;
    skos:altLabel "背寒"@zh, "背恶寒"@zh ;
    skos:hiddenLabel "后背怕冷"@zh, "背脊发凉"@zh, "后背凉飕飕"@zh ;
    skos:note "伤寒论第304条：'少阴病，得之一二日，口中和，其背恶寒者，当灸之，附子汤主之。'胡老：少阴附子汤证之背恶寒为阳虚不能温煦，须以口中和、不渴辨之。v6.3由原BeiWeiEhan拆出。"@zh ;
    skos:exactMatch zz:BeiWeiEhanHan .

zzskos:MuJiFaRe a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "暮即发热"@zh ;
    skos:definition "傍晚定时发热。冲任虚寒兼瘀血、阴血不足之虚热表现，热势多低，与阳明蒸蒸发热有别。"@zh ;
    skos:altLabel "傍晚发热"@zh, "暮热"@zh, "日暮发热"@zh ;
    skos:hiddenLabel "一到傍晚就发烧"@zh, "晚上定时热"@zh, "天黑就热"@zh, "下午后半段发热"@zh ;
    skos:note "金匮要略·妇人杂病篇：'妇人年五十所，病下利数十日不止，暮即发热，少腹里急，腹满，手掌烦热，唇口干燥……温经汤主之。'胡老：暮即发热为冲任虚寒兼瘀血、阴血不足之虚热，非单纯瘀血化热。热势多低，与阳明蒸蒸发热有别。"@zh ;
    skos:exactMatch zz:MuJiFaRe .

### ========== 二、疼痛（9个） ==========

zzskos:TouTong a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "头痛"@zh ;
    skos:definition "头部疼痛。太阳表证或阳明热证均可致。"@zh ;
    skos:altLabel "头胀痛"@zh, "头剧痛"@zh, "满头剧痛"@zh, "阙上痛"@zh ;
    skos:hiddenLabel "头疼"@zh, "脑袋疼"@zh, "太阳穴疼"@zh, "头胀"@zh ;
    skos:note "伤寒论第35条。曹颖甫《经方实验录》：阙上痛属阳明，太阳穴痛属太阳。"@zh ;
    skos:exactMatch zz:TouTong .

zzskos:ShenTiTong a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "身痛"@zh ;
    skos:definition "全身肌肉疼痛。寒邪束表，营卫凝滞。"@zh ;
    skos:altLabel "身体疼痛"@zh, "一身尽痛"@zh, "身疼"@zh, "身体疼烦"@zh ;
    skos:hiddenLabel "浑身疼"@zh, "酸痛"@zh, "身上难受"@zh, "像被打了一样"@zh, "全身酸痛"@zh ;
    skos:note "伤寒论第35条。曹颖甫《经方实验录》：麻黄汤证'身疼腰痛，骨节疼痛'。"@zh ;
    skos:exactMatch zz:ShenTiTong .

zzskos:GuJieTong a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "骨节痛"@zh ;
    skos:definition "关节疼痛。寒湿或风湿痹阻。"@zh ;
    skos:altLabel "骨节疼痛"@zh, "骨节烦疼"@zh ;
    skos:hiddenLabel "关节疼"@zh, "骨头痛"@zh, "浑身骨节疼"@zh ;
    skos:note "伤寒论第35条：'骨节疼痛'。曹颖甫《经方实验录》：'骨节疼痛'属麻黄汤证。v6.3修正：原误作'支节烦疼'，今正。"@zh ;
    skos:exactMatch zz:GuJieTong .

zzskos:FuTong a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "腹痛"@zh ;
    skos:definition "腹部疼痛。虚实寒热均可致。"@zh ;
    skos:altLabel "腹中痛"@zh, "腹大痛"@zh, "腹中切痛"@zh, "绕脐痛"@zh, "腹中急痛"@zh ;
    skos:hiddenLabel "肚子疼"@zh, "肚痛"@zh, "胃脘痛"@zh, "小腹痛"@zh, "绞痛"@zh ;
    skos:note "金匮要略·血痹虚劳病篇第13条。曹颖甫《经方实验录》：腹痛喜按属虚（小建中汤），拒按属实（承气汤）。"@zh ;
    skos:exactMatch zz:FuTong .

zzskos:XiongTong a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "胸痛"@zh ;
    skos:definition "胸部疼痛。胸痹或瘀血所致。"@zh ;
    skos:altLabel "胸背痛"@zh, "心痛彻背"@zh, "胸中痛"@zh ;
    skos:hiddenLabel "胸口疼"@zh, "心口痛"@zh, "前胸疼"@zh ;
    skos:note "金匮要略·胸痹心痛短气病篇。曹颖甫《经方实验录》：瓜蒌薤白白酒汤治胸痹心痛。"@zh ;
    skos:exactMatch zz:XiongTong .

zzskos:XieTong a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "胁痛"@zh ;
    skos:definition "胁肋部疼痛。少阳经气不利。"@zh ;
    skos:altLabel "胁下痛"@zh, "两胁痛"@zh, "胁肋痛"@zh, "胸胁痛"@zh ;
    skos:hiddenLabel "肋骨疼"@zh, "两肋疼"@zh, "胁下疼"@zh ;
    skos:note "伤寒论第96条。曹颖甫《经方实验录》：胁痛属少阳，小柴胡汤主之。"@zh ;
    skos:exactMatch zz:XieTong .

zzskos:ShaoFuTong a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "少腹痛"@zh ;
    skos:definition "小腹部疼痛。下焦瘀血或寒凝。"@zh ;
    skos:altLabel "少腹急痛"@zh, "少腹满痛"@zh, "脐下痛"@zh ;
    skos:hiddenLabel "小肚子疼"@zh, "下腹痛"@zh, "小腹疼"@zh ;
    skos:note "伤寒论第106条。曹颖甫《经方实验录》：桃核承气汤治少腹急结。"@zh ;
    skos:exactMatch zz:ShaoFuTong .

zzskos:YaoTong a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "腰痛"@zh ;
    skos:definition "腰部疼痛。太阳表证或肾虚所致。"@zh ;
    skos:altLabel "腰脊痛"@zh, "腰背痛"@zh, "腰以下痛"@zh ;
    skos:hiddenLabel "腰疼"@zh, "后腰疼"@zh, "腰酸"@zh ;
    skos:note "伤寒论第35条。曹颖甫《经方实验录》：麻黄汤证'腰疼'属太阳。"@zh ;
    skos:exactMatch zz:YaoTong .

zzskos:ZhiJieTong a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "肢节痛"@zh ;
    skos:definition "四肢关节疼痛。风寒湿痹。"@zh ;
    skos:altLabel "四肢疼痛"@zh, "肢节烦疼"@zh, "四肢酸疼"@zh ;
    skos:hiddenLabel "手脚疼"@zh, "四肢酸痛"@zh, "胳膊腿疼"@zh ;
    skos:note "金匮要略·中风历节病篇第8条。曹颖甫《经方实验录》：'支节烦疼'属柴胡桂枝汤证。"@zh ;
    skos:exactMatch zz:ZhiJieTong .

### ========== 三、头项背强硬（5个） ==========

zzskos:XiangQiang a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "项强"@zh ;
    skos:definition "颈项部拘紧不舒，转动不利。太阳表证经输不利之指征。"@zh ;
    skos:altLabel "颈项强直"@zh, "项背强几几"@zh, "项强急"@zh ;
    skos:hiddenLabel "脖子硬"@zh, "脖子转不动"@zh, "后脖子紧"@zh, "项背发僵"@zh ;
    skos:note "伤寒论第14条。曹颖甫《经方实验录》：葛根汤治项背强几几。"@zh ;
    skos:exactMatch zz:XiangQiang .

zzskos:BeiQiang a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "背强"@zh ;
    skos:definition "背部拘紧强直。系从'项背强几几'拆分推断，非仲景原文直述。本条为推断性条目（isInferred=true），供临床检索使用。"@zh ;
    skos:altLabel "背强急"@zh, "背脊强直"@zh ;
    skos:hiddenLabel "后背僵"@zh, "背发紧"@zh, "背板硬"@zh ;
    skos:note "v6.3标注：'背强'系从'项背强几几'拆分推断，非仲景原文直述。仲景书中'背'与'项'常合言。"@zh ;
    skos:exactMatch zz:BeiQiang .

zzskos:JingLuan a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "痉"@zh ;
    skos:definition "筋脉拘急，角弓反张。金匮有专篇论治。"@zh ;
    skos:altLabel "强急"@zh, "角弓反张"@zh, "痉病"@zh ;
    skos:hiddenLabel "抽搐"@zh, "身体反弓"@zh, "筋抽"@zh ;
    skos:note "金匮要略·痉湿暍病篇。曹颖甫《经方实验录》：刚痉用葛根汤，柔痉用栝蒌桂枝汤。"@zh ;
    skos:exactMatch zz:JingLuan .

zzskos:KouJin a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "口噤"@zh ;
    skos:definition "牙关紧闭，不能开口。痉病或中风之兼症。"@zh ;
    skos:altLabel "口噤不开"@zh, "牙关紧闭"@zh ;
    skos:hiddenLabel "张不开嘴"@zh, "咬牙"@zh, "嘴合不上"@zh ;
    skos:note "金匮要略·痉湿暍病篇：'口噤不得语'。"@zh ;
    skos:exactMatch zz:KouJin .

zzskos:BuDeYu a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "不得语"@zh ;
    skos:definition "不能言语。痉病或中风之兼症。"@zh ;
    skos:altLabel "不能言"@zh, "失语"@zh ;
    skos:hiddenLabel "说不出话"@zh, "不能说话"@zh ;
    skos:note "金匮要略·痉湿暍病篇：'口噤不得语'。"@zh ;
    skos:exactMatch zz:BuDeYu .

### ========== 四、卧息转侧（4个） ==========

zzskos:BuDeWo a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "不得卧"@zh ;
    skos:definition "不能平卧，只能坐起。水饮射肺或喘逆之重症。与'不得眠'（不能入睡）为不同原子。"@zh ;
    skos:altLabel "但坐不得卧"@zh, "倚息不得卧"@zh ;
    skos:hiddenLabel "躺不下"@zh, "平躺就喘"@zh, "只能坐着睡"@zh, "晚上没法躺"@zh ;
    skos:note "金匮要略·痰饮咳嗽病篇：'咳逆倚息不得卧，小青龙汤主之。'曹颖甫《经方实验录》：皂荚丸治'但坐不得眠'。"@zh ;
    skos:exactMatch zz:BuDeWo .

zzskos:BuDeMian a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "不得眠"@zh ;
    skos:definition "不能入睡。与'不得卧'（不能平卧）为不同原子：不得眠侧重入睡困难，不得卧侧重体位受限。"@zh ;
    skos:altLabel "失眠"@zh, "虚烦不得眠"@zh ;
    skos:hiddenLabel "睡不着"@zh, "失眠"@zh, "辗转难眠"@zh, "整夜不睡"@zh ;
    skos:note "伤寒论第303条：'少阴病，得之二三日以上，心中烦，不得卧，黄连阿胶汤主之。'金匮要略·血痹虚劳病篇：'虚劳虚烦不得眠，酸枣仁汤主之。'v6.3由原BuDeWo拆出。"@zh ;
    skos:exactMatch zz:BuDeMian .

zzskos:BuDeXi a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "不得息"@zh ;
    skos:definition "呼吸不畅，气息窒塞。水饮或痰浊壅肺。"@zh ;
    skos:altLabel "息不得"@zh, "呼吸不利"@zh ;
    skos:hiddenLabel "喘不上气"@zh, "气憋"@zh, "呼吸不畅"@zh ;
    skos:note "仲景书中'不得息'见于金匮·胸痹篇'胸痹不得卧，喘息咳唾'之延伸表述，非独立原文。本条为推断性条目（isInferred=true）。"@zh ;
    skos:exactMatch zz:BuDeXi .

zzskos:BuDeZhuanCe a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "不得转侧"@zh ;
    skos:definition "身体不能自行翻转。风湿痹阻或疼痛剧烈所致。"@zh ;
    skos:altLabel "不能自转侧"@zh, "不能翻身"@zh ;
    skos:hiddenLabel "翻不了身"@zh, "动不了"@zh, "一翻身就疼"@zh ;
    skos:note "伤寒论第174条。曹颖甫《经方实验录》：桂枝附子汤治'身体疼烦不能自转侧'。"@zh ;
    skos:exactMatch zz:BuDeZhuanCe .

### ========== 五、二便（13个） ==========

zzskos:XiaoBianBuLi a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "小便不利"@zh ;
    skos:definition "尿量减少或排尿不畅。水液代谢障碍之核心指征。"@zh ;
    skos:altLabel "尿少"@zh, "小便短少"@zh ;
    skos:hiddenLabel "尿不出来"@zh, "尿得少"@zh, "小便少"@zh, "没多少尿"@zh ;
    skos:note "伤寒论第71条。曹颖甫《经方实验录》：五苓散治'小便不利，微热消渴'。"@zh ;
    skos:related zzskos:XiaoBianNan ;
    skos:exactMatch zz:XiaoBianBuLi .

zzskos:XiaoBianZiLi a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "小便自利"@zh ;
    skos:definition "小便通畅，量正常或偏多。蓄血证之鉴别指征：小便自利则病在血分非水分。"@zh ;
    skos:altLabel "小便通利"@zh, "小便利"@zh ;
    skos:hiddenLabel "小便正常"@zh, "尿没问题"@zh ;
    skos:note "伤寒论第124条。曹颖甫《经方实验录》：蓄血证小便自利，蓄水证小便不利。"@zh ;
    skos:exactMatch zz:XiaoBianZiLi .

zzskos:XiaoBianShu a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "小便数"@zh ;
    skos:definition "排尿次数增多。"@zh ;
    skos:altLabel "尿频"@zh, "小便频数"@zh ;
    skos:hiddenLabel "老跑厕所"@zh, "尿多"@zh, "一会儿一趟"@zh ;
    skos:note "伤寒论第247条：'涩则小便数'。"@zh ;
    skos:exactMatch zz:XiaoBianShu .

zzskos:XiaoBianNan a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "小便难"@zh ;
    skos:definition "排尿困难、涩滞不畅。与'小便不利'（量少）有别：小便难侧重排出障碍，小便不利侧重量之减少。"@zh ;
    skos:altLabel "小便涩"@zh, "排尿困难"@zh ;
    skos:hiddenLabel "尿不出来"@zh, "尿得费劲"@zh, "滴滴答答"@zh, "尿等待"@zh ;
    skos:note "金匮要略·水气病篇：'少阴脉紧而沉……小便即难。'"@zh ;
    skos:related zzskos:XiaoBianBuLi ;
    skos:exactMatch zz:XiaoBianNan .

zzskos:XiaoBianQingChang a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "小便清长"@zh ;
    skos:definition "小便色清量多。里虚寒之确据。"@zh ;
    skos:altLabel "小便色白"@zh, "小便清白"@zh, "小便清"@zh ;
    skos:hiddenLabel "尿是清的"@zh, "尿多而清"@zh, "尿像水一样"@zh ;
    skos:note "伤寒论第282条：'若小便色白者，少阴病形悉具。'胡老：小便清长为里虚寒之确据，与小便短赤之里热截然相反。"@zh ;
    skos:exactMatch zz:XiaoBianQingChang .

zzskos:DaBianNan a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "大便难"@zh ;
    skos:definition "排便困难、费力。与'不大便'（多日不行）有别：大便难侧重排出障碍。"@zh ;
    skos:altLabel "排便困难"@zh, "大便涩"@zh ;
    skos:hiddenLabel "拉不出来"@zh, "排便费劲"@zh, "使不上劲"@zh, "蹲半天拉不出"@zh ;
    skos:note "伤寒论第179条：'少阳阳明者……大便难是也。'"@zh ;
    skos:related zzskos:BuDaBian ;
    skos:exactMatch zz:DaBianNan .

zzskos:DaBianYing a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "大便硬"@zh ;
    skos:definition "大便燥结成块。津液不足或热盛伤津。"@zh ;
    skos:altLabel "大便坚"@zh, "大便燥结"@zh, "便硬"@zh ;
    skos:hiddenLabel "大便干"@zh, "拉羊屎蛋"@zh, "便便硬邦邦"@zh, "干结"@zh ;
    skos:note "伤寒论第208条。曹颖甫《经方实验录》：麻子仁丸治'大便硬'之脾约证。"@zh ;
    skos:exactMatch zz:DaBianYing .

zzskos:BuDaBian a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "不大便"@zh ;
    skos:definition "多日未排便。阳明腑实之核心指征。"@zh ;
    skos:altLabel "便秘"@zh, "不大便五六日"@zh, "多日未行"@zh ;
    skos:hiddenLabel "好几天没拉"@zh, "不拉屎"@zh, "几天没大便"@zh ;
    skos:note "伤寒论第212条。曹颖甫《经方实验录》：承气汤治'不大便'之阳明腑实证。"@zh ;
    skos:related zzskos:DaBianNan ;
    skos:exactMatch zz:BuDaBian .

zzskos:DaBianTang a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "大便溏"@zh ;
    skos:definition "大便稀软不成形。太阴脾虚之确据。"@zh ;
    skos:altLabel "便溏"@zh, "大便不实"@zh, "大便稀软"@zh, "溏便"@zh ;
    skos:hiddenLabel "拉稀"@zh, "大便不成形"@zh, "稀的"@zh, "软便"@zh ;
    skos:note "伤寒论第273条：太阴病提纲。胡老：大便溏为太阴脾虚之确据。"@zh ;
    skos:exactMatch zz:DaBianTang .

zzskos:XiaLi a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "下利"@zh ;
    skos:definition "大便次数增多，质稀或水样。寒热虚实皆可见。"@zh ;
    skos:altLabel "腹泻"@zh, "拉肚子"@zh, "下利清谷"@zh, "热利下重"@zh ;
    skos:hiddenLabel "拉稀"@zh, "跑肚"@zh, "水泻"@zh, "一天拉好几次"@zh ;
    skos:note "伤寒论第157条。曹颖甫《经方实验录》：葛根芩连汤治热利，理中汤治寒利。"@zh ;
    skos:exactMatch zz:XiaLi .

zzskos:ZiLi a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "自利"@zh ;
    skos:definition "不因攻下而自行下利。三阴病之特征。"@zh ;
    skos:altLabel "自利益甚"@zh, "自利不渴"@zh ;
    skos:hiddenLabel "自己拉稀"@zh, "没吃药也拉"@zh ;
    skos:note "伤寒论第277条：'自利不渴者，属太阴。'"@zh ;
    skos:exactMatch zz:ZiLi .

zzskos:LiJi a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "里急"@zh ;
    skos:definition "腹中急迫欲便。"@zh ;
    skos:altLabel "腹中急"@zh, "里急腹痛"@zh ;
    skos:hiddenLabel "肚子急"@zh, "憋不住"@zh, "急着要拉"@zh ;
    skos:note "金匮要略·血痹虚劳病篇第13条：'虚劳里急，悸，衄，腹中痛……小建中汤主之。'"@zh ;
    skos:exactMatch zz:LiJi .

zzskos:XiaZhong a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "下重"@zh ;
    skos:definition "肛门坠胀，便后不爽。"@zh ;
    skos:altLabel "里急后重"@zh, "后重"@zh ;
    skos:hiddenLabel "拉不干净"@zh, "肛门坠"@zh, "总想拉又拉不出"@zh ;
    skos:note "金匮要略·呕吐哕下利病篇：'热利下重者，白头翁汤主之。'"@zh ;
    skos:exactMatch zz:XiaZhong .

### ========== 六、渴饮（7个） ==========

zzskos:Ke a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "渴"@zh ;
    skos:definition "口渴欲饮。"@zh ;
    skos:altLabel "口渴"@zh, "口干"@zh, "口渴欲饮"@zh ;
    skos:hiddenLabel "嘴干"@zh, "想喝水"@zh, "口干舌燥"@zh ;
    skos:note "伤寒论第26条。"@zh ;
    skos:exactMatch zz:Ke .

zzskos:DaKe a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "大渴"@zh ;
    skos:definition "口渴剧烈，大量饮水。阳明热盛津伤。"@zh ;
    skos:altLabel "大渴引饮"@zh, "烦渴"@zh, "渴饮无度"@zh ;
    skos:hiddenLabel "特别渴"@zh, "拼命喝水"@zh, "口干得要命"@zh, "喝不够"@zh ;
    skos:note "伤寒论第26条：'大烦渴不解'。曹颖甫《经方实验录》：白虎汤证四大症之一。"@zh ;
    skos:exactMatch zz:DaKe .

zzskos:BuKe a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "不渴"@zh ;
    skos:definition "口不渴。太阴病或水饮内停。"@zh ;
    skos:altLabel "口不渴"@zh, "不渴饮"@zh ;
    skos:hiddenLabel "不觉得渴"@zh, "不想喝水"@zh ;
    skos:note "伤寒论第277条：'自利不渴者，属太阴。'曹颖甫《经方实验录》：太阴病'自利不渴'。"@zh ;
    skos:exactMatch zz:BuKe .

zzskos:KeYuYin a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "渴欲饮"@zh ;
    skos:definition "口渴想喝水。"@zh ;
    skos:altLabel "渴欲饮水"@zh, "渴而欲饮"@zh ;
    skos:hiddenLabel "想喝水"@zh, "渴得想喝"@zh ;
    skos:note "伤寒论第71条。"@zh ;
    skos:exactMatch zz:KeYuYin .

zzskos:KeBuYuYin a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "渴不欲饮"@zh ;
    skos:definition "口渴但不想喝水。内有水饮，津不上承。属里属寒，非阴虚之口干。"@zh ;
    skos:altLabel "渴不喜饮"@zh, "口干不欲饮"@zh ;
    skos:hiddenLabel "口干不想喝水"@zh, "渴了也不想喝"@zh, "嘴干但不想喝"@zh ;
    skos:note "本条为推断性条目（isInferred=true），基于水饮内停之病机推断。曹颖甫《经方实验录》：水饮内停常见渴不欲饮。胡老：渴不欲饮为水饮内停、津液不能上承之征。"@zh ;
    skos:exactMatch zz:KeBuYuYin .

zzskos:KeShuiRuTu a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "渴水入吐"@zh ;
    skos:definition "口渴饮水即吐。水逆证。"@zh ;
    skos:altLabel "水逆"@zh, "水入则吐"@zh, "饮水即吐"@zh ;
    skos:hiddenLabel "喝了就吐"@zh, "想喝水但喝了就吐"@zh, "喝水吐水"@zh ;
    skos:note "伤寒论第74条。曹颖甫《经方实验录》：五苓散治'水逆'。"@zh ;
    skos:exactMatch zz:KeShuiRuTu .

zzskos:XiaoKe a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "消渴"@zh ;
    skos:definition "口渴引饮、饮水不解渴。厥阴病提纲第326条特异性症状，病机为寒热错杂、津液不上承。非纯热证，不可单标'热'。本症含上热成分，由心中疼热（XinZhongTengRe）之热标承载，本原子不重复标注。亦非后世独立病名'消渴病'（≈糖尿病）。"@zh ;
    skos:altLabel "渴欲饮水不止"@zh, "饮水不解渴"@zh ;
    skos:hiddenLabel "喝水也不解渴"@zh, "越喝越渴"@zh, "嘴干拼命喝水"@zh, "渴得厉害"@zh ;
    skos:note "伤寒论第326条：'厥阴之为病，消渴，气上撞心，心中疼热……'胡老：厥阴之消渴为寒热错杂、津液不上承所致，与阳明大渴引饮之纯热证不同。v6.3明确：本症上热由XinZhongTengRe之热标承载。"@zh ;
    skos:related zzskos:DaKe ;
    skos:exactMatch zz:XiaoKe .

### ========== 七、呕哕逆（8个） ==========

zzskos:GanOu a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "干呕"@zh ;
    skos:definition "有声无物之呕。胃气上逆或少阳枢机不利。"@zh ;
    skos:altLabel "干哕"@zh ;
    skos:hiddenLabel "想吐吐不出来"@zh, "犯恶心"@zh, "干噫"@zh ;
    skos:note "伤寒论第40条。胡老：干呕属里饮或少阳者十之八九，非单纯表证。"@zh ;
    skos:related zzskos:YuTu, zzskos:YuOu ;
    skos:exactMatch zz:GanOu .

zzskos:Ou a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "呕"@zh ;
    skos:definition "呕吐，有物吐出。胃气上逆之泛称。"@zh ;
    skos:altLabel "呕吐"@zh, "吐逆"@zh ;
    skos:hiddenLabel "反胃"@zh ;
    skos:note "伤寒论第96条。胡老：呕为胃气上逆之泛称。'食则吐蛔'已独立为zzskos:TuHui。"@zh ;
    skos:related zzskos:TuHui ;
    skos:exactMatch zz:Ou .

zzskos:Tu a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "吐"@zh ;
    skos:definition "吐出物。与'呕'（有声有物）侧重不同：吐侧重物之出。"@zh ;
    skos:altLabel "吐物"@zh ;
    skos:hiddenLabel "吐东西"@zh, "呕出"@zh ;
    skos:note "伤寒论第273条：'腹满而吐，食不下。'"@zh ;
    skos:exactMatch zz:Tu .

zzskos:YuOu a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "欲呕"@zh ;
    skos:definition "恶心欲吐。"@zh ;
    skos:altLabel "喜呕"@zh ;
    skos:hiddenLabel "想吐"@zh, "恶心"@zh, "犯恶心"@zh ;
    skos:note "金匮要略·中风历节病篇第8条：'温温欲吐'。胡老：欲呕与干呕同类，属里或半表半里。"@zh ;
    skos:related zzskos:YuTu, zzskos:GanOu ;
    skos:exactMatch zz:YuOu .

zzskos:YuTu a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "欲吐"@zh ;
    skos:definition "自觉恶心欲吐而未实际吐出。胃气上逆之轻症或前驱状态。"@zh ;
    skos:altLabel "恶心"@zh, "泛恶"@zh ;
    skos:hiddenLabel "想吐"@zh, "胃里翻腾想吐"@zh, "干恶心"@zh, "犯恶心"@zh ;
    skos:note "伤寒论第397条：'气逆欲吐'。胡老：欲吐为胃气上逆之自觉症状，有恶心感但未实际吐出。"@zh ;
    skos:related zzskos:GanOu, zzskos:YuOu ;
    skos:exactMatch zz:YuTu .

zzskos:E a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "哕"@zh ;
    skos:definition "呃逆，气逆上冲。"@zh ;
    skos:altLabel "呃逆"@zh, "噫气"@zh ;
    skos:hiddenLabel "打嗝"@zh, "呃呃"@zh ;
    skos:note "伤寒论第380条。"@zh ;
    skos:exactMatch zz:E .

zzskos:QiNi a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "气逆"@zh ;
    skos:definition "气机上逆。原URI为Ni（逆），因'逆'在仲景书中不独立使用，修正为QiNi（气逆）。"@zh ;
    skos:altLabel "气上逆"@zh, "上逆"@zh ;
    skos:hiddenLabel "气往上冲"@zh, "反逆"@zh ;
    skos:note "伤寒论第397条：'气逆欲吐'。"@zh ;
    skos:exactMatch zz:QiNi .

zzskos:TuHui a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "吐蛔"@zh ;
    skos:definition "进食后吐出蛔虫。厥阴病提纲第326条特异性体征，提示上热下寒、蛔虫因脏寒上扰。"@zh ;
    skos:altLabel "吐虫"@zh, "食则吐蛔"@zh ;
    skos:hiddenLabel "吐出虫子"@zh, "吃饭吐蛔虫"@zh ;
    skos:note "伤寒论第326条。胡老：食则吐蛔为厥阴病提纲特异性体征。乌梅丸证之眼目。"@zh ;
    skos:related zzskos:Ou ;
    skos:exactMatch zz:TuHui .

### ========== 八、腹心下（10个） ==========

zzskos:FuMan a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "腹满"@zh ;
    skos:definition "腹部胀满。"@zh ;
    skos:altLabel "腹胀满"@zh, "腹胀"@zh ;
    skos:hiddenLabel "肚子胀"@zh, "胃胀"@zh, "腹部鼓胀"@zh ;
    skos:note "伤寒论第273条太阴提纲。曹颖甫《经方实验录》：腹满拒按属实（承气），喜按属虚（理中）。"@zh ;
    skos:exactMatch zz:FuMan .

zzskos:FuZhang a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:broader zzskos:FuMan ;
    skos:prefLabel "腹胀"@zh ;
    skos:definition "腹部胀大。非独立原子，为#FuMan之同义入口。"@zh ;
    skos:altLabel "腹胀大"@zh, "腹大"@zh ;
    skos:hiddenLabel "肚子鼓"@zh, "腹部胀"@zh ;
    skos:note "此为FuMan之同义检索入口，非独立原子。"@zh ;
    skos:exactMatch zz:FuMan .

zzskos:XinXiaPi a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "心下痞"@zh ;
    skos:definition "胃脘部堵塞感，按之柔软不痛。"@zh ;
    skos:altLabel "心下痞满"@zh, "痞满"@zh ;
    skos:hiddenLabel "胃堵"@zh, "心口堵"@zh, "胃里堵得慌"@zh, "胀但不疼"@zh, "胃堵得慌"@zh, "按着不疼就是堵"@zh ;
    skos:note "伤寒论第149条：'但满而不痛者，此为痞。'曹颖甫《经方实验录》：半夏泻心汤治心下痞。仲景另有'心下痞硬'为痞与硬并见，与XinXiaJian（心下硬）有交叉但不等价。"@zh ;
    skos:related zzskos:XinXiaJian ;
    skos:exactMatch zz:XinXiaPi .

zzskos:XinXiaMan a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "心下满"@zh ;
    skos:definition "胃脘部胀满。"@zh ;
    skos:altLabel "心下胀满"@zh, "心下满胀"@zh ;
    skos:hiddenLabel "心口胀"@zh, "胃胀"@zh ;
    skos:note "伤寒论第67条：'心下逆满'。"@zh ;
    skos:exactMatch zz:XinXiaMan .

zzskos:XinXiaYin a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "心下饮"@zh ;
    skos:definition "胃脘部有水饮停留感。注意：'心下有水气'严格而言为病理状态描述，临证以心下悸、胃脘振水声为实际可察指征。"@zh ;
    skos:altLabel "心下有水气"@zh, "心下停饮"@zh ;
    skos:hiddenLabel "胃里有水"@zh, "心口有水声"@zh ;
    skos:note "伤寒论第40条。曹颖甫《经方实验录》：小青龙汤治心下有水气。"@zh ;
    skos:exactMatch zz:XinXiaYin .

zzskos:LeiMing a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "雷鸣"@zh ;
    skos:definition "肠鸣音亢进，腹中雷响。"@zh ;
    skos:altLabel "腹中雷鸣"@zh, "肠鸣"@zh, "腹中响"@zh ;
    skos:hiddenLabel "肚子响"@zh, "肠子咕噜"@zh, "腹鸣"@zh ;
    skos:note "伤寒论第157条：'腹中雷鸣下利者，生姜泻心汤主之。'"@zh ;
    skos:exactMatch zz:LeiMing .

zzskos:ShaoFuJiJie a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "少腹急结"@zh ;
    skos:definition "少腹部拘急硬满，按之有抵抗感或压痛。桃核承气汤证核心腹征。"@zh ;
    skos:altLabel "少腹硬满"@zh, "少腹急"@zh, "少腹急结硬"@zh ;
    skos:hiddenLabel "小肚子硬"@zh, "小腹按着疼"@zh, "下腹紧绷"@zh, "小肚子发硬发紧"@zh ;
    skos:note "伤寒论第106条。胡老：少腹急结为蓄血证腹诊之眼目。"@zh ;
    skos:related zzskos:ShaoFuXianJi ;
    skos:exactMatch zz:ShaoFuJiJie .

zzskos:FuZhongLeng a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "腹中冷"@zh ;
    skos:definition "自觉腹部寒冷感。太阴虚寒之自觉症。"@zh ;
    skos:altLabel "腹中寒"@zh, "腹部发凉"@zh, "腹冷"@zh ;
    skos:hiddenLabel "肚子凉"@zh, "肚皮冷"@zh, "肚子里冷冰冰"@zh, "腹部怕冷"@zh ;
    skos:note "金匮要略·腹满寒疝宿食病篇第10条：'腹中寒气，雷鸣切痛……附子粳米汤主之。'胡老：腹中冷为里虚寒之自觉指征。SKOS词表以临床常用表述'腹中冷'为首选标签，本体以仲景原文'腹中寒'为正名。"@zh ;
    skos:exactMatch zz:FuZhongLeng .

zzskos:XinXiaJi a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "心下急"@zh ;
    skos:definition "胃脘部急迫疼痛或紧迫不适感。少阳兼里实之特有腹症。"@zh ;
    skos:altLabel "心下急迫"@zh, "心下拘急"@zh ;
    skos:hiddenLabel "心口急迫"@zh, "胃里紧迫"@zh, "心口揪着疼"@zh ;
    skos:note "伤寒论第103条：'呕不止，心下急，郁郁微烦者……与大柴胡汤下之则愈。'胡老：心下急为少阳病兼里实之特有腹症，与心下痞、心下硬不同。"@zh ;
    skos:exactMatch zz:XinXiaJi .

zzskos:XinXiaJian a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "心下硬"@zh ;
    skos:definition "胃脘部硬满，按之有抵抗感。URI由XinXiaYing修正为XinXiaJian，消除与XinXiaYin（心下饮）之歧义。"@zh ;
    skos:altLabel "心下坚"@zh, "心下硬满"@zh ;
    skos:hiddenLabel "心口硬"@zh, "胃硬"@zh, "按着硬"@zh ;
    skos:note "伤寒论第157条：'心下痞硬'。临证注意：仲景另有'心下痞硬'为痞与硬并见之复合状态，非单纯心下硬。"@zh ;
    skos:related zzskos:XinXiaPi ;
    skos:exactMatch zz:XinXiaJian .

zzskos:ShaoFuXianJi a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "少腹弦急"@zh ;
    skos:definition "少腹部拘急如弦，筋脉失养之虚证腹征。桂枝加龙骨牡蛎汤证之腹诊特征。与少腹急结（瘀热实证）病机迥异。"@zh ;
    skos:altLabel "少腹拘急"@zh, "少腹弦"@zh ;
    skos:hiddenLabel "小肚子绷着"@zh, "小腹拘紧"@zh, "下腹发紧"@zh, "小肚子像根弦"@zh ;
    skos:note "金匮要略·血痹虚劳病篇第8条：'夫失精家，少腹弦急，阴头寒……桂枝加龙骨牡蛎汤主之。'胡老：少腹弦急为阴阳两虚、筋脉失养之腹诊特征。"@zh ;
    skos:related zzskos:ShaoFuJiJie ;
    skos:exactMatch zz:ShaoFuXianJi .

### ========== 九、心胸（5个） ==========

zzskos:XinJi a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "心悸"@zh ;
    skos:definition "自觉心跳不安。"@zh ;
    skos:altLabel "心动悸"@zh, "怔忡"@zh, "心中悸"@zh ;
    skos:hiddenLabel "心慌"@zh, "心跳得快"@zh, "心脏乱跳"@zh, "心里扑通扑通"@zh ;
    skos:note "伤寒论第177条。曹颖甫《经方实验录》：炙甘草汤治心动悸脉结代。"@zh ;
    skos:exactMatch zz:XinJi .

zzskos:XinFan a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "心烦"@zh ;
    skos:definition "心中烦闷不宁。"@zh ;
    skos:altLabel "烦"@zh, "心烦不宁"@zh, "心中烦"@zh ;
    skos:hiddenLabel "心里烦"@zh, "烦躁"@zh, "闹心"@zh ;
    skos:note "伤寒论第96条。"@zh ;
    skos:exactMatch zz:XinFan .

zzskos:XinZhongAoNong a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "心中懊憹"@zh ;
    skos:definition "心中烦闷特甚，坐卧不安。栀子豉汤证之眼目。"@zh ;
    skos:altLabel "懊憹"@zh, "烦闷"@zh, "心中懊恼"@zh ;
    skos:hiddenLabel "心里难受"@zh, "烦躁不安"@zh, "坐立不安"@zh, "心里抓挠"@zh ;
    skos:note "伤寒论第76条。曹颖甫《经方实验录》：栀子豉汤治心中懊憹。"@zh ;
    skos:exactMatch zz:XinZhongAoNong .

zzskos:XinZhongTengRe a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "心中疼热"@zh ;
    skos:definition "心中灼痛感。厥阴寒热错杂之上热表现。本原子承载厥阴提纲证之上热标（bagang#Re），消渴（XiaoKe）之上热成分亦由此原子之热标覆盖，XiaoKe本身不重复标注热。"@zh ;
    skos:altLabel "心中痛热"@zh, "心热痛"@zh ;
    skos:hiddenLabel "心里疼"@zh, "心口灼热"@zh, "烧心"@zh ;
    skos:note "伤寒论第326条。曹颖甫《经方实验录》：乌梅丸证'心中疼热'。v6.3明确：本原子之热标同时覆盖消渴（XiaoKe）之上热成分。"@zh ;
    skos:exactMatch zz:XinZhongTengRe .

zzskos:QiShangZhuangXin a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "气上撞心"@zh ;
    skos:definition "气从少腹向上冲撞心胸部位，伴心中疼热。厥阴病提纲特异性症状（宋本第326条）。病机为寒热错杂、阴阳不相顺接。与'上气'（ShangQi）不同：后者为肺胃气逆之泛称，属里证；本症为厥阴半表半里之特异性症状。"@zh ;
    skos:altLabel "气上撞"@zh, "气撞心胸"@zh ;
    skos:hiddenLabel "一股气撞到心口"@zh, "心口被顶着"@zh, "气往上撞心脏"@zh ;
    skos:note "伤寒论第326条。胡老：气上撞心为厥阴寒热错杂、阴阳不相顺接之特有表现，须与消渴、心中疼热并见方可定厥阴。"@zh ;
    skos:related zzskos:ShangQi ;
    skos:exactMatch zz:QiShangZhuangXin .

### ========== 十、喘咳气（7个） ==========

zzskos:KeNi a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "咳逆"@zh ;
    skos:definition "咳嗽气喘，不能平卧。水饮射肺或痰浊壅肺。"@zh ;
    skos:altLabel "咳喘"@zh, "咳逆倚息"@zh, "咳嗽气喘"@zh ;
    skos:hiddenLabel "咳嗽喘"@zh, "躺不下"@zh, "喘不上气"@zh, "咳得睡不着"@zh ;
