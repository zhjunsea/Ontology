    skos:note "伤寒论第264条：'少阳中风，两耳无所闻。'"@zh ;
    skos:exactMatch zz:ErLong .

zzskos:KouKu a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "口苦"@zh ;
    skos:definition "口中自觉苦味。少阳胆火上炎。"@zh ;
    skos:altLabel "口苦咽干"@zh, "口苦目眩"@zh ;
    skos:hiddenLabel "嘴里苦"@zh, "苦味"@zh, "早上嘴苦"@zh, "口发苦"@zh ;
    skos:note "伤寒论第263条：少阳提纲。曹颖甫《经方实验录》：少阳病提纲证之一。"@zh ;
    skos:exactMatch zz:KouKu .

zzskos:YanGan a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "咽干"@zh ;
    skos:definition "咽喉干燥。"@zh ;
    skos:altLabel "口干咽燥"@zh, "咽燥"@zh ;
    skos:hiddenLabel "嗓子干"@zh, "喉咙干"@zh, "口干"@zh ;
    skos:note "伤寒论第263条。"@zh ;
    skos:exactMatch zz:YanGan .

zzskos:YanTong a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "咽痛"@zh ;
    skos:definition "咽喉疼痛。"@zh ;
    skos:altLabel "喉痛"@zh, "咽喉肿痛"@zh, "咽中痛"@zh ;
    skos:hiddenLabel "嗓子疼"@zh, "喉咙疼"@zh ;
    skos:note "伤寒论第311条：'少阴病，二三日，咽痛者，可与甘草汤。'"@zh ;
    skos:exactMatch zz:YanTong .

zzskos:BiMing a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "鼻鸣"@zh ;
    skos:definition "鼻塞呼吸有声。太阳表证兼症。"@zh ;
    skos:altLabel "鼻塞声重"@zh, "鼻塞"@zh ;
    skos:hiddenLabel "鼻子堵"@zh, "鼻子不通气"@zh, "哼哼唧唧"@zh ;
    skos:note "伤寒论第12条：桂枝汤证。"@zh ;
    skos:exactMatch zz:BiMing .

zzskos:MianChi a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "面赤"@zh ;
    skos:definition "面色红赤。热象。"@zh ;
    skos:altLabel "面色红"@zh, "面红"@zh, "满面红"@zh ;
    skos:hiddenLabel "脸红"@zh, "面色潮红"@zh, "面色红赤"@zh ;
    skos:note "伤寒论第317条：通脉四逆汤证'面色赤'。"@zh ;
    skos:exactMatch zz:MianChi .

### ========== 十二、四肢（6个） ==========

zzskos:SiZhiJueNi a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "四肢厥逆"@zh ;
    skos:definition "手足冰冷过肘膝。阳气衰微之危候。"@zh ;
    skos:altLabel "四肢逆冷"@zh, "厥逆"@zh, "手足厥逆"@zh ;
    skos:hiddenLabel "手脚冰凉"@zh, "冰冷"@zh, "冻透了"@zh, "手脚没有温度"@zh ;
    skos:note "伤寒论第353条。曹颖甫《经方实验录》：四逆汤治四肢厥逆。胡老：冷过肘膝为厥逆，冷不过腕踝为手足冷，程度有别。"@zh ;
    skos:exactMatch zz:SiZhiJueNi .

zzskos:ShouZuJueLeng a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "手足厥冷"@zh ;
    skos:definition "手足冰冷，程度轻于四肢厥逆（冷不过肘膝）。"@zh ;
    skos:altLabel "手足冷"@zh, "手足不温"@zh ;
    skos:hiddenLabel "手脚凉"@zh, "手足冰凉"@zh ;
    skos:note "伤寒论第337条：'凡厥者，阴阳气不相顺接，便为厥。厥者，手足逆冷者是也。'"@zh ;
    skos:related zzskos:ShouZuHan ;
    skos:exactMatch zz:ShouZuJueLeng .

zzskos:ShouZuRe a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "手足热"@zh ;
    skos:definition "手足发热。实热充斥所致。与虚劳之手足烦热（ShouZuFanRe）病机不同。"@zh ;
    skos:altLabel "手足发热"@zh ;
    skos:hiddenLabel "手脚热"@zh, "手心发热"@zh ;
    skos:note "伤寒论第335条：'厥深者热亦深'。本条为推断性条目（isInferred=true），依据'手足温''手足热'之义推得。v6.3标注为推断性。"@zh ;
    skos:related zzskos:ShouZuFanRe ;
    skos:exactMatch zz:ShouZuRe .

zzskos:ShouZuHan a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "手足寒"@zh ;
    skos:definition "手足寒冷，程度轻于手足厥冷（ShouZuJueLeng），冷不过腕踝。"@zh ;
    skos:hiddenLabel "手脚凉"@zh, "手足冰冷"@zh, "手脚不温"@zh ;
    skos:note "伤寒论第305条：'身体痛，手足寒，骨节痛，脉沉者，附子汤主之。'"@zh ;
    skos:related zzskos:ShouZuJueLeng ;
    skos:exactMatch zz:ShouZuHan .

zzskos:ShouZuFanRe a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "手足烦热"@zh ;
    skos:definition "手足心发热，烦扰不舒。虚劳阴虚内热之典型表现。与实热之手足热（ShouZuRe）不同：彼为热邪充斥，此为阴血不足、虚热内生。"@zh ;
    skos:altLabel "手足心热"@zh, "掌心热"@zh ;
    skos:hiddenLabel "手心热得慌"@zh, "手脚心烫"@zh, "脚心热"@zh, "五心烦热"@zh, "手心脚心热"@zh, "五心发热"@zh ;
    skos:note "金匮要略·血痹虚劳病篇第13条：'虚劳里急……手足烦热，咽干口燥，小建中汤主之。'胡老：手足烦热为虚劳阴虚内热之典型表现，与实热之手足热不同。"@zh ;
    skos:related zzskos:ShouZuRe ;
    skos:exactMatch zz:ShouZuFanRe .

zzskos:MaMu a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "麻木"@zh ;
    skos:definition "肌肤或肢体麻木，感觉减退或消失。血痹、风痰、气血不荣皆可致。"@zh ;
    skos:altLabel "肌肤麻木"@zh, "肢体麻木"@zh, "不仁"@zh ;
    skos:hiddenLabel "麻了"@zh, "没感觉了"@zh, "木木的"@zh, "像不是自己的"@zh ;
    skos:note "金匮要略·血痹虚劳病篇。胡老：麻木与手足不仁同类，但范围更广，不限于手足。"@zh ;
    skos:exactMatch zz:MaMu .

### ========== 十三、水肿（4个） ==========

zzskos:ShenTiZhong a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "身肿"@zh ;
    skos:definition "全身浮肿。"@zh ;
    skos:altLabel "全身水肿"@zh, "一身尽肿"@zh, "身体浮肿"@zh ;
    skos:hiddenLabel "全身肿"@zh, "浮肿"@zh ;
    skos:note "金匮要略·水气病篇：'诸有水者，腰以下肿，当利小便；腰以上肿，当发汗乃愈。'"@zh ;
    skos:exactMatch zz:ShenTiZhong .

zzskos:ShuiZhong a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "水肿"@zh ;
    skos:definition "水液泛溢肌肤之泛称。仲景书中无'水肿'专词，多称'水气''肿'，本条基于水气病通义推断（isInferred=true）。"@zh ;
    skos:altLabel "浮肿"@zh, "肿"@zh, "水气"@zh ;
    skos:hiddenLabel "肿了"@zh, "脸肿"@zh, "腿肿"@zh, "眼皮肿"@zh, "胖了"@zh ;
    skos:note "v6.3标注为推断性条目（isInferred=true）。与ShenTiZhong（身肿）互为近义，身肿偏重全身，水肿兼含局部。"@zh ;
    skos:exactMatch zz:ShuiZhong .

zzskos:MianFu a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "面浮"@zh ;
    skos:definition "面目浮肿。多为水饮内停外溢，属里证。本条基于'一身面目黄肿'等原文推断（isInferred=true）。"@zh ;
    skos:altLabel "面目浮肿"@zh, "面肿"@zh ;
    skos:hiddenLabel "脸肿"@zh, "眼皮肿"@zh, "眼睛肿"@zh ;
    skos:note "金匮要略·水气病篇：'里水者，一身面目黄肿，其脉沉，小便不利，故令病水。'v6.3标注为推断性条目（isInferred=true）。"@zh ;
    skos:exactMatch zz:MianFu .

zzskos:JiaoZhong a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "脚肿"@zh ;
    skos:definition "足部浮肿。历节病或水气病。"@zh ;
    skos:altLabel "脚肿如脱"@zh, "足肿"@zh ;
    skos:hiddenLabel "脚肿"@zh, "脚踝肿"@zh, "下肢浮肿"@zh ;
    skos:note "金匮要略·中风历节病篇第8条。"@zh ;
    skos:exactMatch zz:JiaoZhong .

### ========== 十四、神志（9个） ==========

zzskos:ZhanYu a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "谵语"@zh ;
    skos:definition "神志不清，胡言乱语。阳明热盛扰神。"@zh ;
    skos:altLabel "妄言"@zh, "说胡话"@zh, "谵妄"@zh ;
    skos:hiddenLabel "乱说话"@zh, "神志不清"@zh, "迷糊说话"@zh ;
    skos:note "伤寒论第212条。曹颖甫《经方实验录》：承气汤治谵语。"@zh ;
    skos:exactMatch zz:ZhanYu .

zzskos:RuKuang a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "如狂"@zh ;
    skos:definition "神志失常，躁扰不宁，似狂非狂。蓄血证之眼目。"@zh ;
    skos:altLabel "发狂"@zh, "其人如狂"@zh ;
    skos:hiddenLabel "疯了似的"@zh, "躁狂"@zh, "不老实"@zh, "打人骂人"@zh ;
    skos:note "伤寒论第106条。曹颖甫《经方实验录》：桃核承气汤治如狂。"@zh ;
    skos:exactMatch zz:RuKuang .

zzskos:FanZao a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "烦躁"@zh ;
    skos:definition "烦躁不宁，心神不安。"@zh ;
    skos:altLabel "躁烦"@zh, "烦扰"@zh ;
    skos:hiddenLabel "烦"@zh, "急躁"@zh, "坐不住"@zh, "闹腾"@zh, "不耐烦"@zh ;
    skos:note "伤寒论第61条。"@zh ;
    skos:exactMatch zz:FanZao .

zzskos:DanYuMei a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "但欲寐"@zh ;
    skos:definition "精神萎靡，似睡非睡，唤之能应但旋即又寐。少阴为里之阴证，阳气衰微之特异性神志表现。"@zh ;
    skos:altLabel "嗜卧"@zh, "神疲欲寐"@zh, "倦卧"@zh, "嗜睡"@zh, "精神萎靡"@zh, "似睡非睡"@zh ;
    skos:hiddenLabel "总想睡"@zh, "没精神"@zh, "昏昏沉沉"@zh, "睁不开眼"@zh, "迷糊"@zh ;
    skos:note "伤寒论第281条：少阴提纲。曹颖甫《经方实验录》：少阴病提纲证。胡老：少阴为里之阴证，阳气衰微故但欲寐。"@zh ;
    skos:exactMatch zz:DanYuMei .

zzskos:MoMo a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "默默"@zh ;
    skos:definition "神情抑郁，沉默寡言，不欲言语。少阳病气机郁滞之神志表现。"@zh ;
    skos:altLabel "神情默默"@zh, "不欲言语"@zh, "嘿嘿"@zh, "默默不语"@zh ;
    skos:hiddenLabel "不想说话"@zh, "闷闷的"@zh, "沉默"@zh, "不愿搭理人"@zh, "蔫了"@zh ;
    skos:note "伤寒论第96条：'嘿嘿不欲饮食'。胡老：'默默'与'不欲食'为两个独立症状。SKOS词表以临床通用表述'默默'为首选标签，本体以宋本正字'嘿嘿'为正名。二者等价，参见exactMatch映射。"@zh ;
    skos:exactMatch zz:MoMo .

zzskos:Jing a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "惊"@zh ;
    skos:definition "易受惊吓，惊狂不安。阳虚或火迫亡阳所致。"@zh ;
    skos:altLabel "惊惕"@zh, "惊狂"@zh, "惊恐"@zh ;
    skos:hiddenLabel "吓一跳"@zh, "受惊"@zh, "一惊一乍"@zh, "心里一惊"@zh ;
    skos:note "伤寒论第112条：'伤寒脉浮，医以火迫劫之，亡阳，必惊狂……桂枝去芍药加蜀漆牡蛎龙骨救逆汤主之。'v6.3由原JingKong拆出，与Kong（恐）为不同原子。"@zh ;
    skos:related zzskos:Kong ;
    skos:exactMatch zz:Jing .

zzskos:Kong a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "恐"@zh ;
    skos:definition "恐惧不安，心神不宁。心虚胆怯或肾虚所致。"@zh ;
    skos:altLabel "恐惧"@zh, "畏"@zh, "畏惧"@zh ;
    skos:hiddenLabel "害怕"@zh, "恐惧不安"@zh, "心里害怕"@zh, "胆小"@zh ;
    skos:note "金匮要略·五脏风寒积聚病篇：'心气虚者，其人则畏。'仲景原文作'畏'，'恐'为后世对应词。v6.3由原JingKong拆出，与Jing（惊）为不同原子：惊为突发反应，恐为持续情绪。"@zh ;
    skos:related zzskos:Jing ;
    skos:exactMatch zz:Kong .

zzskos:MengJiao a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "梦交"@zh ;
    skos:definition "梦中性交。虚劳证，阴阳两虚、心神不守。"@zh ;
    skos:altLabel "梦精"@zh ;
    skos:hiddenLabel "春梦"@zh, "梦中性事"@zh ;
    skos:note "金匮要略·血痹虚劳病篇第8条：'女子梦交，桂枝加龙骨牡蛎汤主之。'曹颖甫《经方实验录》：桂枝加龙骨牡蛎汤治梦交。v5.8已将'梦遗'归入YiJing之altLabel。"@zh ;
    skos:related zzskos:YiJing ;
    skos:exactMatch zz:MengJiao .

zzskos:BeiShang a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "悲伤"@zh ;
    skos:definition "情绪悲伤，欲哭。脏躁或虚劳。"@zh ;
    skos:altLabel "悲伤欲哭"@zh, "喜悲伤"@zh ;
    skos:hiddenLabel "想哭"@zh, "难过"@zh, "伤心"@zh ;
    skos:note "金匮要略·妇人杂病篇第6条：'妇人脏躁，喜悲伤欲哭……甘麦大枣汤主之。'"@zh ;
    skos:exactMatch zz:BeiShang .

### ========== 十五、出血（3个） ==========

zzskos:TuXue a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "吐血"@zh ;
    skos:definition "血从口出。"@zh ;
    skos:altLabel "呕血"@zh, "咯血"@zh, "吐鲜血"@zh ;
    skos:hiddenLabel "吐血"@zh, "嘴里出血"@zh, "咳血"@zh, "呕吐带血"@zh ;
    skos:note "金匮要略·惊悸吐血下血胸满瘀血病篇：'吐血不止者，柏叶汤主之。'"@zh ;
    skos:exactMatch zz:TuXue .

zzskos:BianXue a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "便血"@zh ;
    skos:definition "血从肛门出。肠道出血。"@zh ;
    skos:altLabel "下血"@zh, "便下血"@zh, "远血"@zh, "近血"@zh ;
    skos:hiddenLabel "拉血"@zh, "大便带血"@zh, "肛门出血"@zh, "血便"@zh ;
    skos:note "金匮要略·惊悸吐血下血胸满瘀血病篇：'下血，先便后血，此远血也，黄土汤主之。'"@zh ;
    skos:exactMatch zz:BianXue .

zzskos:XiaXue a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:broader zzskos:BianXue ;
    skos:prefLabel "下血"@zh ;
    skos:definition "血从下出（便血）。非独立原子，为BianXue之同义检索入口。"@zh ;
    skos:altLabel "下血不止"@zh ;
    skos:hiddenLabel "拉血"@zh, "出血"@zh ;
    skos:note "此为BianXue之同义检索入口，非独立原子。"@zh ;
    skos:exactMatch zz:BianXue .

zzskos:BiNiu a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "鼻衄"@zh ;
    skos:definition "鼻腔出血。太阳表实衄解或阳明热盛迫血。"@zh ;
    skos:altLabel "衄血"@zh, "鼻出血"@zh, "衄"@zh ;
    skos:hiddenLabel "流鼻血"@zh, "鼻子出血"@zh, "鼻血"@zh ;
    skos:note "伤寒论第46条：'剧者必衄，衄乃解。'胡老：衄为表邪外解之一途，亦有阳明热盛迫血妄行者。"@zh ;
    skos:exactMatch zz:BiNiu .

### ========== 十六、外伤（1个） ==========

zzskos:JinChuang a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "金创"@zh ;
    skos:definition "金刃外伤。严格而言为外伤事件而非症状，仲景《金匮》有专条论治（王不留行散），保留于本体中。"@zh ;
    skos:altLabel "金疮"@zh, "刀伤"@zh ;
    skos:hiddenLabel "外伤"@zh, "刀伤"@zh ;
    skos:note "金匮要略·疮痈肠痈浸淫病篇：'病金疮，王不留行散主之。'"@zh ;
    skos:exactMatch zz:JinChuang .

### ========== 十七、饮食虚劳（11个） ==========

zzskos:ShiBuXia a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "食不下"@zh ;
    skos:definition "不能进食。太阴病提纲证之一。"@zh ;
    skos:altLabel "不能食"@zh, "纳呆"@zh ;
    skos:hiddenLabel "吃不下"@zh, "没食欲"@zh, "厌食"@zh, "看见饭就饱"@zh ;
    skos:note "伤寒论第273条太阴提纲。"@zh ;
    skos:related zzskos:BuYuShi ;
    skos:exactMatch zz:ShiBuXia .

zzskos:NengShi a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "能食"@zh ;
    skos:definition "能进食。阳明病鉴别指征之一。"@zh ;
    skos:altLabel "食欲好"@zh, "健饭"@zh ;
    skos:hiddenLabel "能吃"@zh, "胃口好"@zh ;
    skos:note "伤寒论第190条：'若能食，名中风。'"@zh ;
    skos:exactMatch zz:NengShi .

zzskos:BuYuShi a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "不欲食"@zh ;
    skos:definition "不想吃饭。少阳病或太阴病可见。"@zh ;
    skos:hiddenLabel "不想吃"@zh, "没胃口"@zh, "看着饭就烦"@zh ;
    skos:note "伤寒论第96条。v6.3删除'嘿嘿不欲饮食'altLabel，因'嘿嘿'已独立为MoMo。"@zh ;
    skos:related zzskos:ShiBuXia ;
    skos:exactMatch zz:BuYuShi .

zzskos:JiBuYuShi a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "饥不欲食"@zh ;
    skos:definition "饥饿但不想吃。厥阴寒热错杂之特异性症状。"@zh ;
    skos:altLabel "饥而欲食不能食"@zh ;
    skos:hiddenLabel "饿但不想吃"@zh, "肚子饿嘴不想吃"@zh, "饿了又吃不下"@zh ;
    skos:note "伤寒论第326条：厥阴提纲。"@zh ;
    skos:exactMatch zz:JiBuYuShi .

zzskos:TuXianMo a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "吐涎沫"@zh ;
    skos:definition "吐出清稀涎沫。寒饮内停。"@zh ;
    skos:altLabel "吐痰涎"@zh, "涎沫多"@zh ;
    skos:hiddenLabel "吐沫子"@zh, "口水多"@zh, "吐清痰"@zh ;
    skos:note "金匮要略·肺痿肺痈咳嗽上气病篇：'吐涎沫而不咳者……甘草干姜汤以温之。'"@zh ;
    skos:exactMatch zz:TuXianMo .

zzskos:TuNong a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "吐脓"@zh ;
    skos:definition "吐出脓液。肺痈成脓期。"@zh ;
    skos:altLabel "吐脓血"@zh, "咳吐脓痰"@zh ;
    skos:hiddenLabel "吐脓"@zh, "咯脓痰"@zh ;
    skos:note "金匮要略·肺痿肺痈咳嗽上气病篇：'久久吐脓如米粥者，为肺痈，桔梗汤主之。'"@zh ;
    skos:exactMatch zz:TuNong .

zzskos:TuZhuo a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "吐浊"@zh ;
    skos:definition "吐出浊痰。'吐浊'一词系从金匮'浊唾腥臭'或'吐浊涕'推断，非仲景原文直述（isInferred=true）。"@zh ;
    skos:altLabel "吐浊痰"@zh, "时时吐浊"@zh ;
    skos:hiddenLabel "吐黏痰"@zh, "咯稠痰"@zh ;
    skos:note "v6.3标注为推断性条目（isInferred=true）。"@zh ;
    skos:exactMatch zz:TuZhuo .

zzskos:YiJing a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "遗精"@zh ;
    skos:definition "不因性事而精液自泄。虚劳失精家之主症。"@zh ;
    skos:altLabel "失精"@zh, "滑精"@zh, "梦遗"@zh ;
    skos:hiddenLabel "遗精"@zh, "漏精"@zh, "滑精"@zh ;
    skos:note "金匮要略·血痹虚劳病篇第8条：'夫失精家……脉极虚芤迟，为清谷、亡血、失精。'v5.8将'梦遗'从MengJiao移入本概念。"@zh ;
    skos:related zzskos:MengJiao ;
    skos:exactMatch zz:YiJing .

zzskos:ShaoQi a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "少气"@zh ;
    skos:definition "气息短弱，言语无力。气虚之征。"@zh ;
    skos:altLabel "气少"@zh, "少气息"@zh ;
    skos:hiddenLabel "气短"@zh, "没气力"@zh, "说话没劲"@zh ;
    skos:note "伤寒论第397条：'虚羸少气'。"@zh ;
    skos:related zzskos:DuanQi ;
    skos:exactMatch zz:ShaoQi .

zzskos:XuLei a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "虚羸"@zh ;
    skos:definition "形体消瘦虚弱。热病后期气阴两伤、形体失养之体征。与'身体尪羸'（WangLei）不同：彼兼关节变形，此为单纯消瘦虚弱。"@zh ;
    skos:altLabel "羸瘦"@zh, "虚羸少气"@zh, "消瘦"@zh, "形体瘦弱"@zh ;
    skos:hiddenLabel "瘦得厉害"@zh, "皮包骨"@zh, "病后消瘦"@zh, "弱不禁风"@zh ;
    skos:note "伤寒论第397条：'伤寒解后，虚羸少气，气逆欲吐，竹叶石膏汤主之。'胡老：虚羸为热病后期气阴两伤、形体失养之体征。"@zh ;
    skos:related zzskos:WangLei ;
    skos:exactMatch zz:XuLei .

zzskos:WangLei a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "身体尪羸"@zh ;
    skos:definition "形体消瘦且关节变形。风湿历节日久伤正之眼目。与'虚羸'（XuLei）不同：此为痹证特有之形体改变，兼有关节肿大变形。"@zh ;
    skos:altLabel "尪羸"@zh, "关节变形"@zh, "身体羸弱"@zh ;
    skos:hiddenLabel "关节肿大变形"@zh, "瘦得关节都突出来"@zh, "人瘦关节大"@zh ;
    skos:note "金匮要略·中风历节病篇第8条：'诸肢节疼痛，身体尪羸，脚肿如脱……桂枝芍药知母汤主之。'胡老：身体尪羸指风湿历节日久、关节变形、形体消瘦。"@zh ;
    skos:related zzskos:XuLei ;
    skos:exactMatch zz:WangLei .

### ========== 十八、杂症（18个） ==========

zzskos:MianSeHei a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "面色黑"@zh ;
    skos:definition "面色暗黑。肾虚或瘀血。"@zh ;
    skos:altLabel "面黑"@zh, "面色黧黑"@zh, "额上黑"@zh ;
    skos:hiddenLabel "脸色发黑"@zh, "面色晦暗"@zh, "脸黑"@zh ;
    skos:note "金匮要略·血痹虚劳病篇第18条：'两目黯黑'，属面色黑之局部表现。"@zh ;
    skos:exactMatch zz:MianSeHei .

zzskos:ShouZuBuRen a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "手足不仁"@zh ;
    skos:definition "手足麻木，感觉迟钝。血痹或中风后遗症。"@zh ;
    skos:altLabel "手足麻木"@zh, "不仁"@zh ;
    skos:hiddenLabel "手脚麻木"@zh, "手麻脚麻"@zh, "没感觉"@zh ;
    skos:note "金匮要略·血痹虚劳病篇：'外证身体不仁，如风痹状。'原文作'身体不仁'，本条取手足部位之局部表现。"@zh ;
    skos:exactMatch zz:ShouZuBuRen .

zzskos:QiXiaJi a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "脐下悸"@zh ;
    skos:definition "脐下跳动感。水饮动于下焦。"@zh ;
    skos:altLabel "脐下动悸"@zh, "脐下悸动"@zh ;
    skos:hiddenLabel "小肚子跳"@zh, "脐下跳动"@zh ;
    skos:note "伤寒论第65条：'发汗后，其人脐下悸者，欲作奔豚，茯苓桂枝甘草大枣汤主之。'"@zh ;
    skos:exactMatch zz:QiXiaJi .

zzskos:JiFuJiaCuo a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "肌肤甲错"@zh ;
    skos:definition "皮肤粗糙如鱼鳞。干血劳或瘀血内停之体征。"@zh ;
    skos:altLabel "甲错"@zh, "皮肤甲错"@zh ;
    skos:hiddenLabel "皮肤粗糙"@zh, "鱼鳞皮肤"@zh ;
    skos:note "金匮要略·血痹虚劳病篇第18条：'内有干血，肌肤甲错'，大黄蟅虫丸主之。"@zh ;
    skos:exactMatch zz:JiFuJiaCuo .

zzskos:FuPiJi a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "腹皮急"@zh ;
    skos:definition "腹部皮肤拘急紧张。肠痈或腹膜炎之腹征。"@zh ;
    skos:altLabel "腹皮急紧"@zh, "腹皮绷急"@zh ;
    skos:hiddenLabel "肚子皮紧"@zh, "腹部绷紧"@zh ;
    skos:note "金匮要略·疮痈肠痈浸淫病篇：'肠痈之为病……腹皮急，按之濡……薏苡附子败酱散主之。'"@zh ;
    skos:exactMatch zz:FuPiJi .

zzskos:AnZhiRu a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "按之濡"@zh ;
    skos:definition "触之柔软。虚证或气滞之腹诊特征。"@zh ;
    skos:altLabel "按之软"@zh, "濡软"@zh ;
    skos:hiddenLabel "按着软"@zh, "摸着软"@zh ;
    skos:note "伤寒论第151条：'按之自濡，但气痞耳。'"@zh ;
    skos:exactMatch zz:AnZhiRu .

zzskos:AnTong a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "按痛"@zh ;
    skos:definition "按压时疼痛。实证或瘀血之腹诊特征。"@zh ;
    skos:altLabel "按之痛"@zh, "压痛"@zh ;
    skos:hiddenLabel "按着疼"@zh, "一按就疼"@zh ;
    skos:note "伤寒论第138条：'小结胸病，正在心下，按之则痛，小陷胸汤主之。'"@zh ;
    skos:exactMatch zz:AnTong .

zzskos:JuAn a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "拒按"@zh ;
    skos:definition "拒绝按压，按压加重疼痛。实证之确据。'拒按'为后世辨证语，仲景原文无此专词，其义涵见于'按之则痛'（第138条）、'按之石硬'等。"@zh ;
    skos:altLabel "按之痛甚"@zh ;
    skos:hiddenLabel "不让碰"@zh, "一碰就疼"@zh, "按着更疼"@zh ;
    skos:note "v6.3标注为推断性条目（isInferred=true）。本条目保留作为腹诊体征，但临证当结合具体语境。"@zh ;
    skos:exactMatch zz:JuAn .

zzskos:ShenYouChuang a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "身有疮"@zh ;
    skos:definition "身上有疮疡。"@zh ;
    skos:altLabel "身疮"@zh, "有疮"@zh ;
    skos:hiddenLabel "身上长疮"@zh, "生疮"@zh ;
    skos:note "金匮要略·疮痈肠痈浸淫病篇。"@zh ;
    skos:exactMatch zz:ShenYouChuang .

zzskos:YouNong a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "有脓"@zh ;
    skos:definition "疮疡化脓。"@zh ;
    skos:altLabel "化脓"@zh, "有脓液"@zh ;
    skos:hiddenLabel "化脓了"@zh, "有脓水"@zh ;
    skos:note "金匮要略·疮痈肠痈浸淫病篇：'诸痈肿，欲知有脓无脓，以手掩肿上，热者为有脓，不热者为无脓。'"@zh ;
    skos:exactMatch zz:YouNong .

zzskos:YanZhongYiWu a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "咽中异物感"@zh ;
    skos:definition "咽部如有物梗阻，吞之不下，吐之不出。梅核气。"@zh ;
    skos:altLabel "咽中如有炙脔"@zh, "梅核气"@zh ;
    skos:hiddenLabel "嗓子有东西"@zh, "喉咙异物感"@zh ;
    skos:note "金匮要略·妇人杂病篇第5条：'妇人咽中如有炙脔，半夏厚朴汤主之。'v6.1修正altLabel：原'炙肉'改为'炙脔'。"@zh ;
    skos:exactMatch zz:YanZhongYiWu .

zzskos:ShuQianShen a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "数欠伸"@zh ;
    skos:definition "频繁打哈欠伸懒腰。脏躁或虚劳。"@zh ;
    skos:altLabel "频频欠伸"@zh, "数欠"@zh ;
    skos:hiddenLabel "总打哈欠"@zh, "频繁伸懒腰"@zh ;
    skos:note "金匮要略·妇人杂病篇第6条：'数欠伸，甘麦大枣汤主之。'"@zh ;
    skos:exactMatch zz:ShuQianShen .

zzskos:ChunKouGanZao a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "唇口干燥"@zh ;
    skos:definition "口唇干燥。津液不足或瘀血内停。"@zh ;
    skos:altLabel "唇燥"@zh, "口干唇燥"@zh ;
    skos:hiddenLabel "嘴唇干"@zh, "口干舌燥"@zh ;
    skos:note "金匮要略·妇人杂病篇第9条（温经汤证）：'唇口干燥。何以知之？其证唇口干燥，故知之。'"@zh ;
    skos:exactMatch zz:ChunKouGanZao .

zzskos:YinChuang a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "阴疮"@zh ;
    skos:definition "外阴疮疡。妇人杂病。"@zh ;
    skos:altLabel "阴中疮"@zh, "阴部疮疡"@zh ;
    skos:hiddenLabel "外阴溃疡"@zh, "下阴生疮"@zh ;
    skos:note "金匮要略·妇人杂病篇：'少阴脉滑而数者，阴中即生疮，狼牙汤洗之。'"@zh ;
    skos:exactMatch zz:YinChuang .

zzskos:YinChui a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "阴吹"@zh ;
    skos:definition "阴道排气有声。谷气实或气虚下陷。"@zh ;
    skos:altLabel "阴道排气"@zh ;
    skos:hiddenLabel "下面出气"@zh ;
    skos:note "金匮要略·妇人杂病篇：'胃气下泄，阴吹而正喧，此谷气之实也，膏发煎导之。'"@zh ;
    skos:exactMatch zz:YinChui .

zzskos:ShiQi a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "失气"@zh ;
    skos:definition "肛门排气（放屁）。阳明腑实或气机通畅之征。"@zh ;
    skos:altLabel "放屁"@zh, "转矢气"@zh, "矢气"@zh ;
    skos:hiddenLabel "排气"@zh, "响屁"@zh ;
    skos:note "伤寒论第209条：'转矢气者，此有燥屎也，乃可攻之。'"@zh ;
    skos:exactMatch zz:ShiQi .

zzskos:TaiDong a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "胎动"@zh ;
    skos:definition "自觉胎儿活动不安。妊娠病。胎动严格来说为妊娠期生理现象，而非典型'症状'，但因桂枝茯苓丸证中出现，临证常作为病理参考指征。"@zh ;
    skos:altLabel "胎动不安"@zh, "胎动异常"@zh ;
    skos:hiddenLabel "胎动"@zh, "肚子里动"@zh ;
    skos:note "金匮要略·妇人妊娠病篇第2条：'而得漏下不止，胎动在脐上者，为癥痼害。'v6.3标记为isEventNotSymptom。"@zh ;
    skos:exactMatch zz:TaiDong .

zzskos:ShenTiChen a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "身重"@zh ;
    skos:definition "身体沉重感。有两种语境：（1）表证身重伴无汗烦躁（大青龙汤证第39条'身不疼但重，乍有轻时'）；（2）里证身重伴但欲寐（少阴病）。"@zh ;
    skos:altLabel "身体沉重"@zh, "身重如铅"@zh ;
    skos:hiddenLabel "身子沉"@zh, "全身沉重"@zh, "乏重"@zh ;
    skos:note "伤寒论第39条：'伤寒脉浮缓，身不疼但重，乍有轻时，无少阴证者，大青龙汤发之。'此属表证。少阴病之身重属里虚。v6.3主标取表证。"@zh ;
    skos:exactMatch zz:ShenTiChen .

### ========== 十九、妇科（2个） ==========

zzskos:LouXia a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "漏下"@zh ;
    skos:definition "胞宫出血，淋漓不断。非便血（肠道出血），病位在胞宫。桂枝茯苓丸证、胶艾汤证、温经汤证均见此症。"@zh ;
    skos:altLabel "经血淋漓"@zh, "漏下不止"@zh ;
    skos:hiddenLabel "月经淋漓不尽"@zh, "一直出血"@zh, "血止不住"@zh, "滴滴答答出血"@zh, "下面一直有血"@zh ;
    skos:note "金匮要略·妇人妊娠病篇第2条：'妇人素有癥病……而得漏下不止……桂枝茯苓丸主之。'胡老：漏下为胞宫出血淋漓不断。v6.3删除'崩漏'altLabel：'崩'为大量出血，病势不同，不得混同。"@zh ;
    skos:exactMatch zz:LouXia .

zzskos:JingDuan a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "经断"@zh ;
    skos:definition "月经停止。桂枝茯苓丸证中与漏下并见，提示癥积阻滞、血不归经，非正常妊娠。"@zh ;
    skos:altLabel "停经"@zh, "月经停止"@zh, "经水断"@zh, "经断未及三月"@zh ;
    skos:hiddenLabel "不来月经"@zh, "月经没了"@zh, "闭经"@zh, "好几个月没来"@zh ;
    skos:note "金匮要略·妇人妊娠病篇第2条：'经断未及三月，而得漏下不止……桂枝茯苓丸主之。'胡老：经断未及三月而复漏下，提示癥积阻滞、血不归经。"@zh ;
    skos:exactMatch zz:JingDuan .

### ========== 二十、毛发及新增概念（6个） ==========

zzskos:FaLuo a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "发落"@zh ;
    skos:definition "头发脱落。失精家精血亏虚、毛发失养之体征。桂枝加龙骨牡蛎汤证之兼症。"@zh ;
    skos:altLabel "脱发"@zh, "头发脱落"@zh, "落发"@zh ;
    skos:hiddenLabel "掉头发"@zh, "头发掉得厉害"@zh, "秃了"@zh, "头发稀疏"@zh, "一梳掉一把"@zh ;
    skos:note "金匮要略·血痹虚劳病篇第8条：'夫失精家，少腹弦急，阴头寒，目眩，发落……桂枝加龙骨牡蛎汤主之。'胡老：发落为失精家精血亏虚、毛发失养之体征。"@zh ;
    skos:exactMatch zz:FaLuo .

zzskos:YinTouHan a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "阴头寒"@zh ;
    skos:definition "外生殖器（阴头）自觉寒冷感。肾阳虚衰、下元不温之特异性自觉症，与少腹弦急、发落并见，为失精家之确据。"@zh ;
    skos:altLabel "阴部冷"@zh, "下元寒"@zh ;
    skos:hiddenLabel "阴部发凉"@zh, "下身冷"@zh, "睾丸凉"@zh ;
    skos:note "金匮要略·血痹虚劳病篇第8条：'夫失精家，少腹弦急，阴头寒，目眩，发落。'胡老：阴头寒为肾阳虚衰、下元不温之特异性自觉症。v6.3新增。"@zh ;
    skos:exactMatch zz:YinTouHan .

zzskos:ShenRunDong a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "身瞤动"@zh ;
    skos:definition "身体肌肉不自主跳动。阳虚水泛、筋脉失养之体征，真武汤证之眼目。与痉病之强急不同，此为肌肉跳动不自主。"@zh ;
    skos:altLabel "肌肉瞤动"@zh, "身动"@zh ;
    skos:hiddenLabel "肉跳"@zh, "肌肉跳动"@zh, "身上抽动"@zh, "筋跳"@zh ;
    skos:note "伤寒论第82条：'太阳病发汗，汗出不解，其人仍发热，心下悸，头眩，身瞤动，振振欲擗地者，真武汤主之。'胡老：身瞤动为阳虚水泛、筋脉失养之体征。v6.3新增。"@zh ;
    skos:exactMatch zz:ShenRunDong .

zzskos:ShouZhangFanRe a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "手掌烦热"@zh ;
    skos:definition "手掌心发热、烦扰不舒。冲任虚寒兼瘀血、阴血不足之虚热表现。与'手足烦热'（ShouZuFanRe）有别：本症仅限手掌，见于温经汤证；手足烦热见于小建中汤证，范围更广。"@zh ;
    skos:altLabel "掌心热"@zh, "手掌发热"@zh ;
    skos:hiddenLabel "手心热得慌"@zh, "手掌心烫"@zh, "手心烦热"@zh ;
    skos:note "金匮要略·妇人杂病篇：'妇人年五十所……暮即发热，少腹里急，腹满，手掌烦热，唇口干燥……温经汤主之。'胡老：原文用'手掌烦热'，非'手足烦热'，部位精确，不可混同。v6.3新增。"@zh ;
    skos:related zzskos:ShouZuFanRe ;
    skos:exactMatch zz:ShouZhangFanRe .

zzskos:WenWenYuTu a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "温温欲吐"@zh ;
    skos:definition "胃中温热不适，恶心欲吐。风湿历节化热伤胃、胃气不和之自觉症。与一般恶心欲吐程度较轻，有郁热蕴结之意。"@zh ;
    skos:altLabel "温温恶心"@zh, "胃中温热欲吐"@zh ;
    skos:hiddenLabel "胃里热辣辣的想吐"@zh, "恶心带热感"@zh, "胃热想吐"@zh ;
    skos:note "金匮要略·中风历节病篇第8条：'诸肢节疼痛，身体尪羸，脚肿如脱，头眩短气，温温欲吐，桂枝芍药知母汤主之。'胡老：温温欲吐为风湿历节化热伤胃、胃气不和之自觉症。v6.3新增。"@zh ;
    skos:related zzskos:YuTu ;
    skos:exactMatch zz:WenWenYuTu .

zzskos:XinXiaJiDong a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "心下悸动"@zh ;
    skos:definition "胃脘部跳动感。与'心悸'（XinJi）有别：心悸泛指心跳不安，心下悸动特指胃脘部跳动感，多为水饮停聚心下所致。"@zh ;
    skos:altLabel "心下悸"@zh, "胃脘悸动"@zh ;
    skos:hiddenLabel "胃里跳"@zh, "心口跳"@zh, "胃脘跳动"@zh, "心窝处跳"@zh ;
    skos:note "伤寒论第127条：'太阳病，小便利者，以饮水多，必心下悸；小便少者，必苦里急也。'胡老：心下悸动为水饮停于心下（胃脘）之自觉症，与心脏之心悸部位不同。苓桂术甘汤、小青龙汤证常见。v6.3新增。"@zh ;
    skos:related zzskos:XinJi ;
    skos:exactMatch zz:XinXiaJiDong .

# ==========================================
# 新增原子症状/体征 SKOS 概念（11个）
# 基于核验报告补缺，对应症状体征本体新增个体
# ==========================================

zzskos:Ye a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "噎"@zh ;
    skos:definition "饮食吞咽不利，噎塞不畅。小青龙汤或然症之一，气机受阻、水饮内停所致。"@zh ;
    skos:altLabel "噎塞"@zh, "饮食噎"@zh ;
    skos:note "伤寒论第40条：'……或噎……小青龙汤主之。'属里证，标Li。"@zh ;
    skos:exactMatch zz:Ye .

zzskos:ZhengKuai a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "癥块"@zh ;
    skos:definition "腹中坚硬结块，推之不移，按之硬满。桂枝茯苓丸证之核心腹征。"@zh ;
    skos:altLabel "癥痼"@zh, "腹中癥积"@zh ;
    skos:note "金匮要略·妇人妊娠病篇第2条：'妇人素有癥病……当下其癥，桂枝茯苓丸主之。'属里、实（bg:Li + bg:Shi）。与'少腹急结'（拘急感）不同。"@zh ;
    skos:exactMatch zz:ZhengKuai .

zzskos:XiaoBianChi a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "小便赤"@zh ;
    skos:definition "尿色深黄或红赤，主里热。"@zh ;
    skos:altLabel "小便赤色"@zh, "尿赤"@zh ;
    skos:note "金匮要略·百合狐惑阴阳毒病篇第1条：'百合病……小便赤。'属里、热（Li+Re）。与'小便不利'（量少）、'小便数'（频次）不同。"@zh ;
    skos:exactMatch zz:XiaoBianChi .

zzskos:XieXiaPiYing a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "胁下痞硬"@zh ;
    skos:definition "胁肋下方硬满不适，按之拒按。小柴胡汤或然症之一。"@zh ;
    skos:altLabel "胁下硬满"@zh ;
    skos:note "伤寒论第96条方后注：'或胁下痞硬，去大枣、芍药，加牡蛎四两。'属半表半里（BanBiaoBanLi）。"@zh ;
    skos:exactMatch zz:XieXiaPiYing .

zzskos:TanDuo a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "痰多"@zh ;
    skos:definition "痰涎增多，或稠或稀，多因水饮内停、脾失运化所致。属推断性条目（isInferred=true）。"@zh ;
    skos:altLabel "多痰"@zh, "痰涎壅盛"@zh ;
    skos:note "仲景原文无'痰多'一词，多用'浊唾''涎沫'，本条为后世临床常用，标isInferred。"@zh ;
    skos:exactMatch zz:TanDuo .

zzskos:GuDingCiTong a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "固定刺痛"@zh ;
    skos:definition "疼痛位置固定，性质如针刺，为瘀血特征性疼痛。属推断性条目（isInferred=true）。"@zh ;
    skos:altLabel "刺痛不移"@zh ;
    skos:note "仲景无直接'固定刺痛'原文，但'痛有定处''刺痛'为后世瘀血辨证要点，标isInferred。"@zh ;
    skos:exactMatch zz:GuDingCiTong .

zzskos:ChunAn a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "唇暗"@zh ;
    skos:definition "口唇色暗，紫暗不泽，为瘀血体征之一。属推断性条目（isInferred=true）。"@zh ;
    skos:altLabel "唇色暗"@zh, "口唇紫暗"@zh ;
    skos:note "仲景有'唇口干燥'（温经汤），未言'唇暗'，本条为后世临床补充，标isInferred。"@zh ;
    skos:exactMatch zz:ChunAn .

zzskos:AiFu a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "嗳腐"@zh ;
    skos:definition "嗳气酸腐臭秽，宿食不化，胃气上逆所致。属推断性条目（isInferred=true）。"@zh ;
    skos:altLabel "嗳气酸腐"@zh, "噫气腐臭"@zh ;
    skos:note "仲景有'干噫食臭'（生姜泻心汤），义近。本条标isInferred。"@zh ;
    skos:exactMatch zz:AiFu .

zzskos:DaBianChouHui a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "大便臭秽"@zh ;
    skos:definition "大便气味臭秽异常，食积或湿热之征。属推断性条目（isInferred=true）。"@zh ;
    skos:altLabel "便臭"@zh, "下利臭秽"@zh ;
    skos:note "仲景有'宿食'条，未直言臭秽，然下利臭秽为热利之眼目，标isInferred。"@zh ;
    skos:exactMatch zz:DaBianChouHui .

zzskos:ShanTaiXi a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "善太息"@zh ;
    skos:definition "频繁叹气，胸胁不舒，肝气郁结之征。属推断性条目（isInferred=true）。"@zh ;
    skos:altLabel "长叹气"@zh, "叹息"@zh ;
    skos:note "仲景有'数欠伸'，与此不同。本条目为气滞兼夹常用辨证点，标isInferred。"@zh ;
    skos:exactMatch zz:ShanTaiXi .

zzskos:QiShangChongXiong a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "气上冲胸"@zh ;
    skos:definition "气从少腹或腹部上冲至胸部，如奔豚状。奔豚汤证之特异性症状。"@zh ;
    skos:altLabel "气从少腹上冲心"@zh, "奔豚气"@zh ;
    skos:note "金匮要略·奔豚气病篇第2条：'奔豚气上冲胸，腹痛，往来寒热，奔豚汤主之。'与'气上撞心'（厥阴提纲）病位、病机不同。"@zh ;
    skos:exactMatch zz:QiShangChongXiong .
    
zzskos:YeJianJiaZhong a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "夜间加重"@zh ;
    skos:definition "症状（尤其疼痛、躁扰）在入夜后显著加重。瘀血证之特征性昼夜节律，与阴气转盛、血行郁滞密切相关。"@zh ;
    skos:altLabel "入夜加重"@zh, "夜间痛甚"@zh, "暮甚"@zh, "夜剧"@zh ;
    skos:hiddenLabel "晚上加重"@zh, "天黑更疼"@zh, "半夜难受"@zh ;
    skos:note "本条为临床推断性条目（对应OWL个体标注为isInferred=true）。仲景原文虽无'夜间加重'专词，然蓄血诸证（第106条、第124条等）以及胡老临证经验中，凡瘀血者多具'入暮即发、夜则痛甚'之规律。胡老明言：'瘀血证常入暮即发，躁扰或疼痛夜间加重，此乃瘀热互结之特征。' 故立此目以补原文昼夜节律之未备。"@zh ;
    skos:exactMatch zz:YeJianJiaZhong .
    
# ===== 新增症状体征（2个） =====

zz:YiQi
    a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "噫气"@zh ;
    skos:altLabel "嗳气"@zh ;
    skos:definition "胃中浊气上出咽喉所发之声。旋覆代赭汤证'噫气不除'为持续性、频发性嗳气，为本方之眼目。与干呕（有声无物）、哕（呃逆）不同。"@zh ;
    skos:scopeNote "胡老：噫气不除为胃虚气逆之特异性表现，与泻心汤证之痞而兼热不同，本证以虚为主。"@zh ;
    skos:example "伤寒论第161条：心下痞硬，噫气不除者，旋覆代赭汤主之。"@zh ;
    skos:example "伤寒论第157条：心下痞硬，干噫食臭。"@zh ;
    skos:broader <http://www.tcm-classics.org/skos/zhengzhuangtizheng#OuHuiNi> ;
    skos:related bz:XuanFuDaiZheTangZheng .

zz:BuOu
    a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "不呕"@zh ;
    skos:definition "否定性症状。无恶心呕吐。柴胡桂枝干姜汤证'渴而不呕'为与小柴胡汤证'喜呕'之关键鉴别，亦是去半夏、生姜之方药依据。权重不高（0.50），但方证鉴别意义重大。"@zh ;
    skos:scopeNote "胡老：小柴胡汤证'喜呕'，本证'不呕而渴'，故去半夏、生姜，加栝蒌根。此为方证鉴别之眼目。"@zh ;
    skos:example "伤寒论第147条：渴而不呕。柴胡桂枝干姜汤主之。"@zh ;
    skos:broader <http://www.tcm-classics.org/skos/zhengzhuangtizheng#OuHuiNi> ;
    skos:related bz:ChaiHuGuiZhiGanJiangTangZheng .