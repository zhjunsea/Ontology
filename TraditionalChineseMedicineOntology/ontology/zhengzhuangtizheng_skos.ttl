    skos:exactMatch zz:KeNi .

zzskos:KeSou a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "咳嗽"@zh ;
    skos:definition "咳嗽，肺气上逆。"@zh ;
    skos:altLabel "咳"@zh, "咳唾"@zh, "咳嗽上气"@zh ;
    skos:hiddenLabel "咳"@zh, "咳痰"@zh, "干咳"@zh ;
    skos:note "伤寒论第40条。"@zh ;
    skos:exactMatch zz:KeSou .

zzskos:Chuan a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "喘"@zh ;
    skos:definition "气喘，呼吸急促困难。"@zh ;
    skos:altLabel "喘息"@zh, "喘促"@zh, "喘急"@zh, "气急"@zh ;
    skos:hiddenLabel "喘不上气"@zh, "气短"@zh, "呼哧带喘"@zh ;
    skos:note "伤寒论第35条。曹颖甫《经方实验录》：麻杏甘石汤治'汗出而喘'。"@zh ;
    skos:exactMatch zz:Chuan .

zzskos:DuanQi a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "短气"@zh ;
    skos:definition "气息短促，呼吸不足以息。"@zh ;
    skos:altLabel "气短"@zh, "呼吸短促"@zh ;
    skos:hiddenLabel "气不够用"@zh, "喘不上来气"@zh, "心慌气短"@zh ;
    skos:note "金匮要略·中风历节病篇第8条。"@zh ;
    skos:related zzskos:ShaoQi ;
    skos:exactMatch zz:DuanQi .

zzskos:ShangQi a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "上气"@zh ;
    skos:definition "气上冲，气逆。肺胃气逆之泛称，病位在里。与厥阴之'气上撞心'（QiShangZhuangXin）病机不同：彼为寒热错杂、阴阳不相顺接之厥阴特异性症状，此为肺胃气逆之里证泛称。"@zh ;
    skos:altLabel "气上冲"@zh, "气上冲胸"@zh, "气喘"@zh ;
    skos:hiddenLabel "一股气往上冲"@zh, "气往上顶"@zh ;
    skos:note "金匮要略·肺痿肺痈咳嗽上气病篇。v6.3明确：上气为里证泛称，与厥阴之气上撞心病机不同。"@zh ;
    skos:related zzskos:QiShangZhuangXin ;
    skos:exactMatch zz:ShangQi .

zzskos:XiongMan a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "胸满"@zh ;
    skos:definition "胸部满闷。可见于表邪内陷、痰饮、气滞，主属里证。"@zh ;
    skos:altLabel "胸闷"@zh, "胸中满"@zh, "胸满闷"@zh ;
    skos:hiddenLabel "胸口闷"@zh, "喘不上气"@zh, "胸口堵得慌"@zh ;
    skos:note "伤寒论第264条：'胸中满而烦'。胡老：胸满非独表证，痰饮气滞皆可见之，当以里为主。"@zh ;
    skos:exactMatch zz:XiongMan .

zzskos:XiongXieKuMan a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:topConceptOf <http://www.tcm-classics.org/skos/zhengzhuangtizheng> ;
    skos:prefLabel "胸胁苦满"@zh ;
    skos:definition "胸胁部胀满不舒，或按之不适。少阳病枢机不利之核心症状，非胸满、胁痛可替代。"@zh ;
    skos:altLabel "胸胁满"@zh, "胁下满"@zh, "胸胁胀满"@zh ;
    skos:hiddenLabel "胸胁发胀"@zh, "肋骨下胀"@zh, "胸胁堵得慌"@zh, "侧胸胀满"@zh ;
    skos:note "伤寒论第96条。胡老：胸胁苦满为少阳病之核心症状。"@zh ;
    skos:exactMatch zz:XiongXieKuMan .

### ========== 十一、头面五官（10个） ==========

