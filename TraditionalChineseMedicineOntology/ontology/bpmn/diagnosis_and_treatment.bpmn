<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_JingFang_HuXishu" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.48.0" xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL https://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd">
  <bpmn:process id="JingFang_HuXishu_C8" name="经方派(胡希恕)标准诊治流程 [C8]" isExecutable="true">
    <bpmn:extensionElements />
    <bpmn:startEvent id="Start_Patient_Visit" name="患者就诊">
      <bpmn:outgoing>Flow_To_Step1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_To_Step1" sourceRef="Start_Patient_Visit" targetRef="Task_Step1_SiZhen" />
    <bpmn:userTask id="Task_Step1_SiZhen" name="第一步：四诊合参&#10;(客观采集症状)">
      <bpmn:documentation>【操作规范】只抓客观征象，排除主观臆断。拒绝患者自我定性（如"我肾虚""我上火"）。&#10;&#10;1. 表证相关：有无恶寒、发热、身痛、关节痛、鼻塞、出汗与否、怕风、皮肤痒、浮肿。出汗关键区分：自汗、盗汗、无汗。&#10;2. 里证相关（消化道为核心）：食欲、恶心呕吐、嗳气、腹胀、腹痛、大便（干/稀/溏/黏/几日一次）；口干、口苦、口渴喜冷饮/热饮。&#10;3. 半表半里相关：往来寒热、胸胁苦满、心烦、易惊恐、失眠、头晕、耳鸣。&#10;4. 二便与水饮瘀血：小便频/不利；水肿、痰多、眩晕（水饮）；固定刺痛、唇暗、肌肤甲错（瘀血）。&#10;5. 舌脉：作为参考，不唯脉论。证不合，单凭脉象不能定六经。&#10;&#10;【禁忌】问诊初期不下任何辨证结论，纯客观记录。</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_Step1</bpmn:incoming>
      <bpmn:incoming>Flow_Redo_Loop</bpmn:incoming>
      <bpmn:outgoing>Flow_To_GW_BingWei</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_To_GW_BingWei" sourceRef="Task_Step1_SiZhen" targetRef="GW_BingWei" />
    <bpmn:exclusiveGateway id="GW_BingWei" name="第二步：分辨病位&#10;(表/里/半表半里)">
      <bpmn:incoming>Flow_To_GW_BingWei</bpmn:incoming>
      <bpmn:outgoing>Flow_Wei_Biao</bpmn:outgoing>
      <bpmn:outgoing>Flow_Wei_Li</bpmn:outgoing>
      <bpmn:outgoing>Flow_Wei_Ban</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Wei_Biao" name="表" sourceRef="GW_BingWei" targetRef="Task_Wei_Biao" />
    <bpmn:sequenceFlow id="Flow_Wei_Li" name="里" sourceRef="GW_BingWei" targetRef="Task_Wei_Li" />
    <bpmn:sequenceFlow id="Flow_Wei_Ban" name="半表半里" sourceRef="GW_BingWei" targetRef="Task_Wei_Ban" />
    <bpmn:task id="Task_Wei_Biao" name="病位：表&#10;(太阳/少阴)">
      <bpmn:documentation>特征：恶寒、身痛、发热等躯体外部症状为主。&#10;口诀：有恶寒优先考虑表。</bpmn:documentation>
      <bpmn:incoming>Flow_Wei_Biao</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge_Biao</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Wei_Li" name="病位：里&#10;(阳明/太阴)">
      <bpmn:documentation>特征：大便、腹满、呕利、胃部不适为主。&#10;口诀：胸腹胀满二便异常优先考虑里。</bpmn:documentation>
      <bpmn:incoming>Flow_Wei_Li</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge_Li</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Wei_Ban" name="病位：半表半里&#10;(少阳/厥阴)">
      <bpmn:documentation>特征：往来寒热、胸胁不适，正邪僵持。&#10;口诀：寒热交替、胸胁不适优先半表半里。</bpmn:documentation>
      <bpmn:incoming>Flow_Wei_Ban</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge_Ban</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_Merge_Biao" sourceRef="Task_Wei_Biao" targetRef="GW_Merge_Wei" />
    <bpmn:sequenceFlow id="Flow_Merge_Li" sourceRef="Task_Wei_Li" targetRef="GW_Merge_Wei" />
    <bpmn:sequenceFlow id="Flow_Merge_Ban" sourceRef="Task_Wei_Ban" targetRef="GW_Merge_Wei" />
    <bpmn:exclusiveGateway id="GW_Merge_Wei">
      <bpmn:incoming>Flow_Merge_Biao</bpmn:incoming>
      <bpmn:incoming>Flow_Merge_Li</bpmn:incoming>
      <bpmn:incoming>Flow_Merge_Ban</bpmn:incoming>
      <bpmn:outgoing>Flow_To_GW_BingXing</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_To_GW_BingXing" sourceRef="GW_Merge_Wei" targetRef="GW_BingXing" />
    <bpmn:exclusiveGateway id="GW_BingXing" name="第三步：区分病性&#10;(阴/阳)">
      <bpmn:incoming>Flow_To_GW_BingXing</bpmn:incoming>
      <bpmn:outgoing>Flow_Xing_Yang</bpmn:outgoing>
      <bpmn:outgoing>Flow_Xing_Yin</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Xing_Yang" name="阳证" sourceRef="GW_BingXing" targetRef="Task_Xing_Yang" />
    <bpmn:sequenceFlow id="Flow_Xing_Yin" name="阴证" sourceRef="GW_BingXing" targetRef="Task_Xing_Yin" />
    <bpmn:task id="Task_Xing_Yang" name="病性：阳证&#10;(正气充足)">
      <bpmn:documentation>表现：精神尚可、声高、怕热、口干喜凉、脉偏有力。多热、多实。</bpmn:documentation>
      <bpmn:incoming>Flow_Xing_Yang</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge_Yang</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Xing_Yin" name="病性：阴证&#10;(机能沉衰)">
      <bpmn:documentation>表现：乏力、萎靡、畏寒、喜热饮、脉弱。多寒、多虚。注意寒热错杂。</bpmn:documentation>
      <bpmn:incoming>Flow_Xing_Yin</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge_Yin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_Merge_Yang" sourceRef="Task_Xing_Yang" targetRef="GW_Merge_Xing" />
    <bpmn:sequenceFlow id="Flow_Merge_Yin" sourceRef="Task_Xing_Yin" targetRef="GW_Merge_Xing" />
    <bpmn:exclusiveGateway id="GW_Merge_Xing">
      <bpmn:incoming>Flow_Merge_Yang</bpmn:incoming>
      <bpmn:incoming>Flow_Merge_Yin</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Step4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_To_Step4" sourceRef="GW_Merge_Xing" targetRef="Task_Step4_LiuJing" />
    <bpmn:userTask id="Task_Step4_LiuJing" name="第四步：定六经&#10;(病位+病性组合)">
      <bpmn:documentation>【胡希恕六经定义】&#10;1. 太阳病【表阳】：恶寒发热身痛脉浮。&#10;2. 阳明病【里阳】：里实热，便硬腹满潮热。&#10;3. 少阳病【半表半里阳】：往来寒热胸胁苦满。禁汗禁下。&#10;4. 太阴病【里阴】：里虚寒，腹满自利不渴。&#10;5. 少阴病【表阴】：表证+机能沉衰(脉微细但欲寐)。&#10;6. 厥阴病【半表半里阴】：寒热错杂，上热下寒。&#10;&#10;⚠️ 注意合病、并病（如太阳太阴合病）。</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_Step4</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Step5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_To_Step5" sourceRef="Task_Step4_LiuJing" targetRef="Task_Step5_JianJia" />
    <bpmn:userTask id="Task_Step5_JianJia" name="第五步：辨兼夹&#10;(水饮/瘀血/食积)">
      <bpmn:documentation>【二次细化】&#10;1. 水饮：痰多眩晕水肿心悸 → 苓术泽泻&#10;2. 瘀血：刺痛血块唇暗 → 桃仁丹皮&#10;3. 食积：腹胀嗳腐苔腻&#10;4. 气滞：胸胁胀满</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_Step5</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Step6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_To_Step6" sourceRef="Task_Step5_JianJia" targetRef="Task_Step6_FangZheng" />
    <bpmn:userTask id="Task_Step6_FangZheng" name="第六步：辨方证&#10;(方证对应是最高原则)">
      <bpmn:documentation>【核心落点】&#10;将患者全部脉证与《伤寒论》原文逐条比对。重合度越高，契合度越高。&#10;例：同为太阳病&#10;- 无汗身痛 → 麻黄汤&#10;- 有汗恶风 → 桂枝汤&#10;- 兼水饮咳喘 → 小青龙汤&#10;&#10;【禁止】脱离经方体系自由组方。</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_Step6</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Step7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_To_Step7" sourceRef="Task_Step6_FangZheng" targetRef="Task_Step7_ZhiFa" />
    <bpmn:userTask id="Task_Step7_ZhiFa" name="第七步：判定治法&#10;(剂量与禁忌)">
      <bpmn:documentation>【治则与禁忌】&#10;- 太阳发汗 / 少阴温阳解表&#10;- 阳明清下 / 太阴温中&#10;- 少阳和解 / 厥阴清温并用&#10;&#10;⚠️ 禁逆治：少阳禁汗下；少阴禁纯寒凉；阳明实热禁温补。&#10;顾护胃气：久病体虚者避免攻伐太过。</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_Step7</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Step8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_To_Step8" sourceRef="Task_Step7_ZhiFa" targetRef="Task_Step8_FuZhen" />
    <bpmn:userTask id="Task_Step8_FuZhen" name="第八步：复诊观测&#10;(疗效判断标准)">
      <bpmn:documentation>【以症状变化为准】&#10;1. 核心痛苦是否减轻&#10;2. 饮食二便睡眠是否趋常&#10;3. 有无不良反应(腹泻/上火提示辨证偏差)&#10;&#10;根据反馈调整方剂或重新复盘。</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_Step8</bpmn:incoming>
      <bpmn:outgoing>Flow_To_GW_Result</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_To_GW_Result" sourceRef="Task_Step8_FuZhen" targetRef="GW_Result" />
    <bpmn:exclusiveGateway id="GW_Result" name="疗效达标？" default="Flow_Redo_Loop">
      <bpmn:incoming>Flow_To_GW_Result</bpmn:incoming>
      <bpmn:outgoing>Flow_Success</bpmn:outgoing>
      <bpmn:outgoing>Flow_Redo_Loop</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Success" name="达标" sourceRef="GW_Result" targetRef="End_Success" />
    <bpmn:sequenceFlow id="Flow_Redo_Loop" name="未达标" sourceRef="GW_Result" targetRef="Task_Step1_SiZhen" />
    <bpmn:endEvent id="End_Success" name="痊愈/结案">
      <bpmn:incoming>Flow_Success</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
