<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:dc="http://purl.org/dc/elements/1.1/"
    xmlns:sx="http://www.tcm-classics.org/shexiang#"
    xml:base="http://www.tcm-classics.org/shexiang">

  <!-- ================================================================ -->
  <!--  本体元数据                                                       -->
  <!-- ================================================================ -->

  <owl:Ontology rdf:about="http://www.tcm-classics.org/shexiang">
    <rdfs:label xml:lang="zh">舌象本体（温病学派舌诊体系）</rdfs:label>
    <rdfs:label xml:lang="en">Tongue Manifestation Ontology (Wenbing School)</rdfs:label>
    <dc:title xml:lang="zh">舌象本体（温病学派舌诊体系）</dc:title>
    <dc:creator xml:lang="zh">温病舌诊本体建模组</dc:creator>
    <dc:description xml:lang="zh">
      以温病学派（叶天士、吴鞠通、薛生白、王孟英）舌诊理论为核心，
      兼顾伤寒六经辨证使用需求，构建舌质、舌苔、舌形、舌态、舌下络脉、
      润燥六维舌象分类体系。温病以舌为辨证之眼目：卫气营血之传变、
      三焦之升降、湿热与温热之鉴别，皆以舌象为第一依据。
    </dc:description>
    <owl:versionInfo>1.0.0</owl:versionInfo>
  </owl:Ontology>

  <!-- ================================================================ -->
  <!--  顶层类（1）                                                      -->
  <!-- ================================================================ -->

  <owl:Class rdf:about="#TongueManifestation">
    <rdfs:label xml:lang="zh">舌象</rdfs:label>
    <rdfs:comment xml:lang="zh">
      舌象本体顶层类。涵盖舌质、舌苔、舌形、舌态、舌下络脉、润燥六维。
      温病以舌为辨证之眼目，舌象为判定卫气营血传变之第一依据。
    </rdfs:comment>
    <sx:classicalSource xml:lang="zh">
      叶天士《外感温热篇》："其热传营，舌色必绛。"
    </sx:classicalSource>
  </owl:Class>

  <!-- ================================================================ -->
  <!--  一级分类：六维（6）                                              -->
  <!-- ================================================================ -->

  <owl:Class rdf:about="#TongueBodyColor">
    <rdfs:subClassOf rdf:resource="#TongueManifestation"/>
    <rdfs:label xml:lang="zh">舌质颜色</rdfs:label>
    <rdfs:comment xml:lang="zh">
      舌体本色，反映气血营阴之盛衰与热邪之深浅。
      温病尤重舌质：淡红→红→绛→紫，标志卫→气→营→血之传变。
    </rdfs:comment>
    <sx:classicalSource xml:lang="zh">
      叶天士《外感温热篇》、吴鞠通《温病条辨》
    </sx:classicalSource>
  </owl:Class>

  <owl:Class rdf:about="#TongueCoating">
    <rdfs:subClassOf rdf:resource="#TongueManifestation"/>
    <rdfs:label xml:lang="zh">舌苔</rdfs:label>
    <rdfs:comment xml:lang="zh">
      舌面所生苔垢，反映胃气之存亡、邪气之性质与深浅。
      温病辨湿热，全凭苔之厚薄腐腻；辨津液，全凭苔之润燥。
    </rdfs:comment>
    <sx:classicalSource xml:lang="zh">
      《伤寒舌鉴》、曹元恒《辨舌指南》
    </sx:classicalSource>
  </owl:Class>

  <owl:Class rdf:about="#TongueShape">
    <rdfs:subClassOf rdf:resource="#TongueManifestation"/>
    <rdfs:label xml:lang="zh">舌形</rdfs:label>
    <rdfs:comment xml:lang="zh">
      舌体之胖瘦、老嫩、点刺、裂纹、瘀斑等形态特征。
    </rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#TongueDynamics">
    <rdfs:subClassOf rdf:resource="#TongueManifestation"/>
    <rdfs:label xml:lang="zh">舌态</rdfs:label>
    <rdfs:comment xml:lang="zh">
      舌体之动态：强硬、痿软、颤动、歪斜、吐弄、短缩。
      温病见舌态异常多为热极生风或内闭心包之危候。
    </rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#SublingualVein">
    <rdfs:subClassOf rdf:resource="#TongueManifestation"/>
    <rdfs:label xml:lang="zh">舌下络脉</rdfs:label>
    <rdfs:comment xml:lang="zh">
      舌系带两侧静脉之颜色、粗细、曲直。主察瘀血。
    </rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#TongueMoisture">
    <rdfs:subClassOf rdf:resource="#TongueManifestation"/>
    <rdfs:label xml:lang="zh">舌面润燥</rdfs:label>
    <rdfs:comment xml:lang="zh">
      舌面津液之盈亏。温病最重津液，润燥为存津与否之直接证据。
    </rdfs:comment>
    <sx:wenbingNote xml:lang="zh">
      叶天士："舌绛而干燥者，火邪劫营，凉血清火为要。"
      润燥决定滋阴与化湿之取舍。
    </sx:wenbingNote>
  </owl:Class>

  <!-- ================================================================ -->
  <!--  二级/三级舌象类（33）                                            -->
  <!-- ================================================================ -->

  <!-- ── 舌质颜色（6）────────────────────────────────────────────── -->

  <owl:Class rdf:about="#PaleRedTongue">
    <rdfs:subClassOf rdf:resource="#TongueBodyColor"/>
    <rdfs:label xml:lang="zh">淡红舌</rdfs:label>
    <rdfs:comment xml:lang="zh">
      舌质淡红润泽，为正常舌色，或温病初起邪浅之象。
    </rdfs:comment>
    <sx:correspondsToWeiQiYingXue rdf:resource="#WeiStage"/>
    <sx:prognosisIndicator xml:lang="zh">
      淡红不变→邪未深入；转红→将入气分。
    </sx:prognosisIndicator>
  </owl:Class>

  <owl:Class rdf:about="#PaleWhiteTongue">
    <rdfs:subClassOf rdf:resource="#TongueBodyColor"/>
    <rdfs:label xml:lang="zh">淡白舌</rdfs:label>
    <rdfs:comment xml:lang="zh">
      舌色浅淡，主气血不足、阳虚寒盛。
      温病见此多为素体阳虚感邪，或过用寒凉伤阳。
    </rdfs:comment>
    <sx:indicatesPathomechanism rdf:resource="#YangDeficiencyPathomechanism"/>
  </owl:Class>

  <owl:Class rdf:about="#RedTongue">
    <rdfs:subClassOf rdf:resource="#TongueBodyColor"/>
    <rdfs:label xml:lang="zh">红舌</rdfs:label>
    <rdfs:comment xml:lang="zh">
      舌色鲜红，主热。温病气分热盛之标志。
      舌尖红→心火；舌边红→肝胆热；舌中红→胃热。
    </rdfs:comment>
    <sx:wenbingNote xml:lang="zh">
      邪由卫入气，舌由淡红转红，为热势渐深之征。
    </sx:wenbingNote>
    <sx:correspondsToWeiQiYingXue rdf:resource="#QiStage"/>
    <sx:indicatesPathomechanism rdf:resource="#QiFengPathomechanism"/>
    <sx:relatedTo rdf:resource="#YellowCoating"/>
  </owl:Class>

  <owl:Class rdf:about="#CrimsonTongue">
    <rdfs:subClassOf rdf:resource="#TongueBodyColor"/>
    <rdfs:label xml:lang="zh">绛舌</rdfs:label>
    <rdfs:comment xml:lang="zh">
      舌色深红近绛，主热入营分。温病辨证之关键节点。
      绛而干燥→营热伤阴；绛而有苔→气营两燔；绛而无苔→纯入营血。
    </rdfs:comment>
    <sx:wenbingNote xml:lang="zh">
      叶天士："其热传营，舌色必绛。绛，深红色也。"
      绛舌是温病由气入营的分水岭。
    </sx:wenbingNote>
    <sx:classicalSource xml:lang="zh">叶天士《外感温热篇》</sx:classicalSource>
    <sx:correspondsToWeiQiYingXue rdf:resource="#YingStage"/>
    <sx:indicatesPathomechanism rdf:resource="#YingFengPathomechanism"/>
    <sx:relatedTo rdf:resource="#RedTongue"/>
    <sx:relatedTo rdf:resource="#PurpleTongue"/>
  </owl:Class>

  <owl:Class rdf:about="#PurpleTongue">
    <rdfs:subClassOf rdf:resource="#TongueBodyColor"/>
    <rdfs:label xml:lang="zh">紫舌</rdfs:label>
    <rdfs:comment xml:lang="zh">
      舌色紫暗或紫红。紫而干燥→热极伤阴、血热互结；
      紫而湿润→寒凝血瘀；紫暗有瘀斑→瘀血内阻。
    </rdfs:comment>
    <sx:wenbingNote xml:lang="zh">
      绛→紫标志营分→血分传变，或瘀热互结。
    </sx:wenbingNote>
    <sx:correspondsToWeiQiYingXue rdf:resource="#XueStage"/>
    <sx:indicatesPathomechanism rdf:resource="#XueFengPathomechanism"/>
    <sx:relatedTo rdf:resource="#CrimsonTongue"/>
    <sx:relatedTo rdf:resource="#EcchymosisTongue"/>
  </owl:Class>

  <owl:Class rdf:about="#BlueTongue">
    <rdfs:subClassOf rdf:resource="#TongueBodyColor"/>
    <rdfs:label xml:lang="zh">青舌</rdfs:label>
    <rdfs:comment xml:lang="zh">
      舌色青蓝，主寒凝、瘀血重证。
      温病少见，见于阴寒内盛或瘀血极重之危候。
    </rdfs:comment>
    <sx:indicatesPathomechanism rdf:resource="#BloodStasisPathomechanism"/>
  </owl:Class>

  <!-- ── 舌苔·苔色（4）───────────────────────────────────────────── -->

  <owl:Class rdf:about="#WhiteCoating">
    <rdfs:subClassOf rdf:resource="#TongueCoating"/>
    <rdfs:label xml:lang="zh">白苔</rdfs:label>
    <rdfs:comment xml:lang="zh">
      主表证、寒证、湿证。温病初起邪在卫分多见薄白苔。
      白厚腻→湿浊中阻；白滑→水饮内停；白燥→津伤。
    </rdfs:comment>
    <sx:correspondsToWeiQiYingXue rdf:resource="#WeiStage"/>
    <sx:relatedTo rdf:resource="#ThinCoating"/>
  </owl:Class>

  <owl:Class rdf:about="#YellowCoating">
    <rdfs:subClassOf rdf:resource="#TongueCoating"/>
    <rdfs:label xml:lang="zh">黄苔</rdfs:label>
    <rdfs:comment xml:lang="zh">
      主里热。温病邪入气分之标志。
      薄黄→热初入里；黄厚→阳明腑实或湿热蕴结；
      黄腻→湿热交蒸；黄燥→热盛伤津。
    </rdfs:comment>
    <sx:wenbingNote xml:lang="zh">
      白苔→黄苔标志邪由卫（表）入气（里）。
    </sx:wenbingNote>
    <sx:correspondsToWeiQiYingXue rdf:resource="#QiStage"/>
    <sx:indicatesPathomechanism rdf:resource="#QiFengPathomechanism"/>
    <sx:relatedTo rdf:resource="#WhiteCoating"/>
    <sx:relatedTo rdf:resource="#RedTongue"/>
  </owl:Class>

  <owl:Class rdf:about="#GreyCoating">
    <rdfs:subClassOf rdf:resource="#TongueCoating"/>
    <rdfs:label xml:lang="zh">灰苔</rdfs:label>
    <rdfs:comment xml:lang="zh">
      灰苔主里证。灰而燥→热盛伤阴；灰而润→痰饮内停或寒湿。
    </rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#BlackCoating">
    <rdfs:subClassOf rdf:resource="#TongueCoating"/>
    <rdfs:label xml:lang="zh">黑苔</rdfs:label>
    <rdfs:comment xml:lang="zh">
      主热极或寒极。黑而干燥起刺→热极津枯；黑而滑润→阳虚寒盛。
      温病见黑燥苔为危候。
    </rdfs:comment>
    <sx:classicalSource xml:lang="zh">
      吴鞠通《温病条辨》："黑苔而燥，热极也，急下之。"
    </sx:classicalSource>
  </owl:Class>

  <!-- ── 舌苔·苔质（6）───────────────────────────────────────────── -->

  <owl:Class rdf:about="#ThinCoating">
    <rdfs:subClassOf rdf:resource="#TongueCoating"/>
    <rdfs:label xml:lang="zh">薄苔</rdfs:label>
    <rdfs:comment xml:lang="zh">
      透过苔层可见舌体。主邪浅病轻，或正常。
    </rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#ThickCoating">
    <rdfs:subClassOf rdf:resource="#TongueCoating"/>
    <rdfs:label xml:lang="zh">厚苔</rdfs:label>
    <rdfs:comment xml:lang="zh">
      不能透过苔层见舌体。主邪盛入里，或有食积痰湿。
    </rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#GreasyCoating">
    <rdfs:subClassOf rdf:resource="#TongueCoating"/>
    <rdfs:label xml:lang="zh">腻苔</rdfs:label>
    <rdfs:comment xml:lang="zh">
      苔质致密，颗粒细腻，如涂油垢，刮之不去。
      主湿浊、痰饮、食积。温病湿热证之核心舌征。
    </rdfs:comment>
    <sx:wenbingNote xml:lang="zh">
      薛生白《湿热病篇》以腻苔辨湿热之偏重：
      白腻→湿重于热；黄腻→热重于湿。
    </sx:wenbingNote>
    <sx:indicatesPathomechanism rdf:resource="#DampnessHeatPathomechanism"/>
    <sx:relatedTo rdf:resource="#CurdyCoating"/>
  </owl:Class>

  <owl:Class rdf:about="#CurdyCoating">
    <rdfs:subClassOf rdf:resource="#TongueCoating"/>
    <rdfs:label xml:lang="zh">腐苔</rdfs:label>
    <rdfs:comment xml:lang="zh">
      苔质疏松粗大，如豆腐渣堆铺，刮之易去。主食积、痰浊。
      与腻苔鉴别要点：腐松腻密。
    </rdfs:comment>
    <sx:indicatesPathomechanism rdf:resource="#FoodStagnationPathomechanism"/>
    <sx:relatedTo rdf:resource="#GreasyCoating"/>
  </owl:Class>

  <owl:Class rdf:about="#PeelingCoating">
    <rdfs:subClassOf rdf:resource="#TongueCoating"/>
    <rdfs:label xml:lang="zh">剥苔</rdfs:label>
    <rdfs:comment xml:lang="zh">
      苔部分剥落。主胃气阴两伤。
      花剥→气阴不足。温病后期阴伤之征。
    </rdfs:comment>
    <sx:wenbingNote xml:lang="zh">
      温病后期见剥苔，提示阴液大伤，须急投滋阴。
    </sx:wenbingNote>
    <sx:indicatesPathomechanism rdf:resource="#FluidDepletionPathomechanism"/>
  </owl:Class>

  <owl:Class rdf:about="#MirrorTongue">
    <rdfs:subClassOf rdf:resource="#PeelingCoating"/>
    <rdfs:label xml:lang="zh">镜面舌</rdfs:label>
    <rdfs:comment xml:lang="zh">
      舌苔全部剥落，舌面光滑如镜。胃阴枯竭之危象。
    </rdfs:comment>
    <sx:indicatesPathomechanism rdf:resource="#FluidDepletionPathomechanism"/>
  </owl:Class>

  <!-- ── 舌形（7）────────────────────────────────────────────────── -->

  <owl:Class rdf:about="#SwollenTongue">
    <rdfs:subClassOf rdf:resource="#TongueShape"/>
    <rdfs:label xml:lang="zh">胖大舌</rdfs:label>
    <rdfs:comment xml:lang="zh">
      舌体胖大。主脾虚湿盛、水饮内停。
    </rdfs:comment>
    <sx:relatedTo rdf:resource="#TeethMarkedTongue"/>
  </owl:Class>

  <owl:Class rdf:about="#ThinTongue">
    <rdfs:subClassOf rdf:resource="#TongueShape"/>
    <rdfs:label xml:lang="zh">瘦薄舌</rdfs:label>
    <rdfs:comment xml:lang="zh">
      舌体瘦小而薄。主气血两虚、阴虚火旺。温病后期阴伤多见。
    </rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#TeethMarkedTongue">
    <rdfs:subClassOf rdf:resource="#TongueShape"/>
    <rdfs:label xml:lang="zh">齿痕舌</rdfs:label>
    <rdfs:comment xml:lang="zh">
      舌边有齿压痕迹。主脾虚湿盛。常与胖大舌并见。
    </rdfs:comment>
    <sx:relatedTo rdf:resource="#SwollenTongue"/>
  </owl:Class>

  <owl:Class rdf:about="#CrackedTongue">
    <rdfs:subClassOf rdf:resource="#TongueShape"/>
    <rdfs:label xml:lang="zh">裂纹舌</rdfs:label>
    <rdfs:comment xml:lang="zh">
      舌面有裂沟。主阴液亏耗。温病后期津伤之征。
    </rdfs:comment>
    <sx:relatedTo rdf:resource="#DryTongue"/>
  </owl:Class>

  <owl:Class rdf:about="#PrickledTongue">
    <rdfs:subClassOf rdf:resource="#TongueShape"/>
    <rdfs:label xml:lang="zh">点刺舌</rdfs:label>
    <rdfs:comment xml:lang="zh">
      舌面乳头增大如刺，摸之棘手。主热极。
      温病气分大热或热入营血之征。
    </rdfs:comment>
    <sx:classicalSource xml:lang="zh">
      叶天士："舌生芒刺者，热极也。"
    </sx:classicalSource>
    <sx:relatedTo rdf:resource="#RedTongue"/>
  </owl:Class>

  <owl:Class rdf:about="#EcchymosisTongue">
    <rdfs:subClassOf rdf:resource="#TongueShape"/>
    <rdfs:label xml:lang="zh">瘀斑舌</rdfs:label>
    <rdfs:comment xml:lang="zh">
      舌面或舌边有青紫或暗红瘀斑。主瘀血内阻。
    </rdfs:comment>
    <sx:indicatesPathomechanism rdf:resource="#BloodStasisPathomechanism"/>
    <sx:relatedTo rdf:resource="#PurpleTongue"/>
    <sx:relatedTo rdf:resource="#PurpleDistendedVein"/>
  </owl:Class>

  <owl:Class rdf:about="#PetechialTongue">
    <rdfs:subClassOf rdf:resource="#TongueShape"/>
    <rdfs:label xml:lang="zh">瘀点舌</rdfs:label>
    <rdfs:comment xml:lang="zh">
      舌面散在细小瘀点。主热入血分、迫血妄行，或瘀血轻证。
    </rdfs:comment>
    <sx:indicatesPathomechanism rdf:resource="#XueFengPathomechanism"/>
  </owl:Class>

  <!-- ── 舌态（6）────────────────────────────────────────────────── -->

  <owl:Class rdf:about="#StiffTongue">
    <rdfs:subClassOf rdf:resource="#TongueDynamics"/>
    <rdfs:label xml:lang="zh">强硬舌</rdfs:label>
    <rdfs:comment xml:lang="zh">
      舌体板硬，转动不灵，语言謇涩。
      温病为热入心包或热极生风之危候。
    </rdfs:comment>
    <sx:wenbingNote xml:lang="zh">
      温病见舌强硬，须防内闭心包，急用安宫牛黄、紫雪、至宝。
    </sx:wenbingNote>
    <sx:indicatesPathomechanism rdf:resource="#HeartPackageBlockagePathomechanism"/>
    <sx:relatedTo rdf:resource="#CrimsonTongue"/>
  </owl:Class>

  <owl:Class rdf:about="#FlaccidTongue">
    <rdfs:subClassOf rdf:resource="#TongueDynamics"/>
    <rdfs:label xml:lang="zh">痿软舌</rdfs:label>
    <rdfs:comment xml:lang="zh">
      舌体软弱无力，不能伸缩。主气血虚极或阴液枯竭。
    </rdfs:comment>
    <sx:indicatesPathomechanism rdf:resource="#FluidDepletionPathomechanism"/>
  </owl:Class>

  <owl:Class rdf:about="#TremblingTongue">
    <rdfs:subClassOf rdf:resource="#TongueDynamics"/>
    <rdfs:label xml:lang="zh">颤动舌</rdfs:label>
    <rdfs:comment xml:lang="zh">
      舌体不自主颤动。主肝风内动。温病为热极生风或阴虚风动。
    </rdfs:comment>
    <sx:indicatesPathomechanism rdf:resource="#InternalWindPathomechanism"/>
  </owl:Class>

  <owl:Class rdf:about="#DeviatedTongue">
    <rdfs:subClassOf rdf:resource="#TongueDynamics"/>
    <rdfs:label xml:lang="zh">歪斜舌</rdfs:label>
    <rdfs:comment xml:lang="zh">
      伸舌偏向一侧。主中风或风痰阻络。
    </rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#ProtrudingTongue">
    <rdfs:subClassOf rdf:resource="#TongueDynamics"/>
    <rdfs:label xml:lang="zh">吐弄舌</rdfs:label>
    <rdfs:comment xml:lang="zh">
      舌常伸出口外为"吐"；反复舐唇为"弄"。
      主心脾热盛或小儿惊风先兆。
    </rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#ShortenedTongue">
    <rdfs:subClassOf rdf:resource="#TongueDynamics"/>
    <rdfs:label xml:lang="zh">短缩舌</rdfs:label>
    <rdfs:comment xml:lang="zh">
      舌体紧缩不能伸出。主寒凝筋脉或热极伤津、痰浊内阻。
      温病见短缩为危候。
    </rdfs:comment>
    <sx:relatedTo rdf:resource="#PurpleTongue"/>
  </owl:Class>

  <!-- ── 舌下络脉（1）────────────────────────────────────────────── -->

  <owl:Class rdf:about="#PurpleDistendedVein">
    <rdfs:subClassOf rdf:resource="#SublingualVein"/>
    <rdfs:label xml:lang="zh">舌下络脉瘀紫怒张</rdfs:label>
    <rdfs:comment xml:lang="zh">
      络脉青紫或紫黑，粗张迂曲。主瘀血内阻重证。
    </rdfs:comment>
    <sx:indicatesPathomechanism rdf:resource="#BloodStasisPathomechanism"/>
    <sx:relatedTo rdf:resource="#EcchymosisTongue"/>
  </owl:Class>

  <!-- ── 润燥（3）────────────────────────────────────────────────── -->

  <owl:Class rdf:about="#SlipperyTongue">
    <rdfs:subClassOf rdf:resource="#TongueMoisture"/>
    <rdfs:label xml:lang="zh">滑舌</rdfs:label>
    <rdfs:comment xml:lang="zh">
      舌面水液过多，扪之湿滑。主水饮内停、阳虚不化。
    </rdfs:comment>
    <sx:indicatesPathomechanism rdf:resource="#WaterRetentionPathomechanism"/>
  </owl:Class>

  <owl:Class rdf:about="#DryTongue">
    <rdfs:subClassOf rdf:resource="#TongueMoisture"/>
    <rdfs:label xml:lang="zh">燥舌</rdfs:label>
    <rdfs:comment xml:lang="zh">
      舌面干燥少津。主热盛伤津或阴虚液亏。温病最重此征。
    </rdfs:comment>
    <sx:wenbingNote xml:lang="zh">
      叶天士："舌绛而干燥者，火邪劫营。"
      燥之程度即津伤之程度，为温病用药之第一指征。
    </sx:wenbingNote>
    <sx:indicatesPathomechanism rdf:resource="#FluidDepletionPathomechanism"/>
    <sx:relatedTo rdf:resource="#CrimsonTongue"/>
    <sx:relatedTo rdf:resource="#CrackedTongue"/>
  </owl:Class>

  <owl:Class rdf:about="#RoughTongue">
    <rdfs:subClassOf rdf:resource="#TongueMoisture"/>
    <rdfs:label xml:lang="zh">糙舌</rdfs:label>
    <rdfs:comment xml:lang="zh">
      舌面粗糙如砂纸，津液全无。主热极津枯，温病危候。
    </rdfs:comment>
    <sx:indicatesPathomechanism rdf:resource="#FluidDepletionPathomechanism"/>
  </owl:Class>

  <!-- ================================================================ -->
  <!--  病机类（12）                                                     -->
  <!-- ================================================================ -->

  <owl:Class rdf:about="#Pathomechanism">
    <rdfs:label xml:lang="zh">病机</rdfs:label>
    <rdfs:comment xml:lang="zh">
      舌象所反映的核心病机。温病以卫气营血、三焦、湿热、津伤为主线，
      兼顾六经兼夹证之瘀血、水饮、食积等病机。
    </rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#WeiFengPathomechanism">
    <rdfs:subClassOf rdf:resource="#Pathomechanism"/>
    <rdfs:label xml:lang="zh">卫分病机</rdfs:label>
    <rdfs:comment xml:lang="zh">
      邪犯肺卫，卫阳被郁。见于温病初起。
    </rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#QiFengPathomechanism">
    <rdfs:subClassOf rdf:resource="#Pathomechanism"/>
    <rdfs:label xml:lang="zh">气分病机</rdfs:label>
    <rdfs:comment xml:lang="zh">
      邪入气分，正盛邪实，里热炽盛。包括阳明经腑证、湿热蕴结等。
    </rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#YingFengPathomechanism">
    <rdfs:subClassOf rdf:resource="#Pathomechanism"/>
    <rdfs:label xml:lang="zh">营分病机</rdfs:label>
    <rdfs:comment xml:lang="zh">
      热灼营阴，心神被扰。营热伤阴为温病关键转折。
    </rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#XueFengPathomechanism">
    <rdfs:subClassOf rdf:resource="#Pathomechanism"/>
    <rdfs:label xml:lang="zh">血分病机</rdfs:label>
    <rdfs:comment xml:lang="zh">
      热盛动血，耗血动风。包括血热妄行、热瘀互结、阴虚风动。
    </rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#DampnessHeatPathomechanism">
    <rdfs:subClassOf rdf:resource="#Pathomechanism"/>
    <rdfs:label xml:lang="zh">湿热病机</rdfs:label>
    <rdfs:comment xml:lang="zh">
      湿与热合，缠绵难解。薛生白《湿热病篇》核心病机。
    </rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#FluidDepletionPathomechanism">
    <rdfs:subClassOf rdf:resource="#Pathomechanism"/>
    <rdfs:label xml:lang="zh">津液亏伤病机</rdfs:label>
    <rdfs:comment xml:lang="zh">
      热盛伤津或阴液枯竭。温病全程须顾护津液。
    </rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#BloodStasisPathomechanism">
    <rdfs:subClassOf rdf:resource="#Pathomechanism"/>
    <rdfs:label xml:lang="zh">瘀血病机</rdfs:label>
    <rdfs:comment xml:lang="zh">
      血行不畅或离经之血内停。可见于温病血分证或兼夹证。
    </rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#WaterRetentionPathomechanism">
    <rdfs:subClassOf rdf:resource="#Pathomechanism"/>
    <rdfs:label xml:lang="zh">水饮病机</rdfs:label>
    <rdfs:comment xml:lang="zh">
      水液代谢失常，停聚为饮。多见于素体阳虚或误治伤阳。
    </rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#FoodStagnationPathomechanism">
    <rdfs:subClassOf rdf:resource="#Pathomechanism"/>
    <rdfs:label xml:lang="zh">食积病机</rdfs:label>
    <rdfs:comment xml:lang="zh">
      饮食停滞，脾胃运化失司。可为温病兼夹或独立病证。
    </rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#YangDeficiencyPathomechanism">
    <rdfs:subClassOf rdf:resource="#Pathomechanism"/>
    <rdfs:label xml:lang="zh">阳虚寒盛病机</rdfs:label>
    <rdfs:comment xml:lang="zh">
      阳气不足，阴寒内盛。温病少见，多为素体阳虚感邪或过用寒凉所致。
    </rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#InternalWindPathomechanism">
    <rdfs:subClassOf rdf:resource="#Pathomechanism"/>
    <rdfs:label xml:lang="zh">肝风内动病机</rdfs:label>
    <rdfs:comment xml:lang="zh">
      热极生风或阴虚风动。温病危重阶段常见。
    </rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#HeartPackageBlockagePathomechanism">
    <rdfs:subClassOf rdf:resource="#Pathomechanism"/>
    <rdfs:label xml:lang="zh">热闭心包病机</rdfs:label>
    <rdfs:comment xml:lang="zh">
      邪热内陷心包，神明被蒙。温病危候，见舌强硬、神昏谵语。
    </rdfs:comment>
  </owl:Class>

  <!-- ================================================================ -->
  <!--  卫气营血辨证阶段（4 + 父类）                                     -->
  <!-- ================================================================ -->

  <owl:Class rdf:about="#WeiQiYingXueStage">
    <rdfs:label xml:lang="zh">卫气营血阶段</rdfs:label>
    <rdfs:comment xml:lang="zh">
      叶天士创立的温病辨证纲领。卫→气→营→血标志邪由表入里、
      由浅入深的传变层次，舌象为判定阶段之第一依据。
    </rdfs:comment>
    <sx:classicalSource xml:lang="zh">
      叶天士《外感温热篇》："卫之后方言气，营之后方言血。"
    </sx:classicalSource>
  </owl:Class>

  <owl:Class rdf:about="#WeiStage">
    <rdfs:subClassOf rdf:resource="#WeiQiYingXueStage"/>
    <rdfs:label xml:lang="zh">卫分</rdfs:label>
    <rdfs:comment xml:lang="zh">
      温病初起，邪犯肺卫。症见发热微恶寒、口微渴、脉浮数。
      舌象：淡红舌、薄白苔。治以辛凉解表。
    </rdfs:comment>
    <sx:wenbingNote xml:lang="zh">
      叶天士："在卫汗之可也。"
    </sx:wenbingNote>
  </owl:Class>

  <owl:Class rdf:about="#QiStage">
    <rdfs:subClassOf rdf:resource="#WeiQiYingXueStage"/>
    <rdfs:label xml:lang="zh">气分</rdfs:label>
    <rdfs:comment xml:lang="zh">
      邪入气分，正盛邪实，里热炽盛。
      症见壮热不恶寒、汗出、口渴、脉洪大或滑数。
      舌象：红舌、黄苔。治以清气泄热。
    </rdfs:comment>
    <sx:wenbingNote xml:lang="zh">
      叶天士："到气才可清气。"
    </sx:wenbingNote>
  </owl:Class>

  <owl:Class rdf:about="#YingStage">
    <rdfs:subClassOf rdf:resource="#WeiQiYingXueStage"/>
    <rdfs:label xml:lang="zh">营分</rdfs:label>
    <rdfs:comment xml:lang="zh">
      热灼营阴，心神被扰。
      症见身热夜甚、心烦不寐、斑疹隐隐、脉细数。
      舌象：绛舌、少苔或无苔。治以清营透热、养阴凉营。
    </rdfs:comment>
    <sx:wenbingNote xml:lang="zh">
      叶天士："入营犹可透热转气。"
    </sx:wenbingNote>
  </owl:Class>

  <owl:Class rdf:about="#XueStage">
    <rdfs:subClassOf rdf:resource="#WeiQiYingXueStage"/>
    <rdfs:label xml:lang="zh">血分</rdfs:label>
    <rdfs:comment xml:lang="zh">
      热盛动血，耗血动风。
      症见出血发斑、神昏谵语、抽搐痉厥、脉细数或弦数。
      舌象：紫舌、瘀斑瘀点。治以凉血散血、熄风开窍。
    </rdfs:comment>
    <sx:wenbingNote xml:lang="zh">
      叶天士："入血就恐耗血动血，直须凉血散血。"
    </sx:wenbingNote>
  </owl:Class>

  <!-- ================================================================ -->
  <!--  对象属性（6）                                                    -->
  <!-- ================================================================ -->

  <owl:ObjectProperty rdf:about="#indicatesPathomechanism">
    <rdfs:domain rdf:resource="#TongueManifestation"/>
    <rdfs:range rdf:resource="#Pathomechanism"/>
    <rdfs:label xml:lang="zh">所主病机</rdfs:label>
    <rdfs:comment xml:lang="zh">该舌象所反映的核心病机。</rdfs:comment>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#correspondsToWeiQiYingXue">
    <rdfs:domain rdf:resource="#TongueManifestation"/>
    <rdfs:range rdf:resource="#WeiQiYingXueStage"/>
    <rdfs:label xml:lang="zh">对应卫气营血阶段</rdfs:label>
    <rdfs:comment xml:lang="zh">
      温病特有：该舌象标志邪在卫、气、营、血何层。
    </rdfs:comment>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#progressesTo">
    <rdfs:domain rdf:resource="#TongueManifestation"/>
    <rdfs:range rdf:resource="#TongueManifestation"/>
    <rdfs:label xml:lang="zh">传变为</rdfs:label>
    <rdfs:comment xml:lang="zh">
      该舌象在温病传变中可能演变为的下一阶段舌象。
    </rdfs:comment>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#progressesFrom">
    <rdfs:domain rdf:resource="#TongueManifestation"/>
    <rdfs:range rdf:resource="#TongueManifestation"/>
    <rdfs:label xml:lang="zh">传变自</rdfs:label>
    <owl:inverseOf rdf:resource="#progressesTo"/>
    <rdfs:comment xml:lang="zh">该舌象由何种前驱舌象演变而来。</rdfs:comment>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#relatedTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdfs:domain rdf:resource="#TongueManifestation"/>
    <rdfs:range rdf:resource="#TongueManifestation"/>
    <rdfs:label xml:lang="zh">相关舌象</rdfs:label>
    <rdfs:comment xml:lang="zh">
      跨维度关联：该舌象常与另一舌象并见或互为印证。
    </rdfs:comment>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#hasAuxiliaryTongueSign">
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="#TongueManifestation"/>
    <rdfs:label xml:lang="zh">辅助舌征</rdfs:label>
    <rdfs:comment xml:lang="zh">
      舌象主要用于佐证兼夹证（水饮、瘀血、食积），
      不作为主证的独立辨证依据。须在主证方证成立的前提下参考。
    </rdfs:comment>
    <sx:wenbingNote xml:lang="zh">
      舌诊不可脱离脉证单独定方。有是证用是方，舌仅为印证之一端。
    </sx:wenbingNote>
  </owl:ObjectProperty>

  <!-- ================================================================ -->
  <!--  数据属性（3）                                                    -->
  <!-- ================================================================ -->

  <owl:DatatypeProperty rdf:about="#classicalSource">
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
    <rdfs:label xml:lang="zh">经典出处</rdfs:label>
    <rdfs:comment xml:lang="zh">
      该概念所依据的中医经典文献原文或出处。
    </rdfs:comment>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#wenbingNote">
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
    <rdfs:label xml:lang="zh">温病按语</rdfs:label>
    <rdfs:comment xml:lang="zh">
      温病学派医家对该概念的辨证要点与治法提示。
    </rdfs:comment>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#prognosisIndicator">
    <rdfs:domain rdf:resource="#TongueManifestation"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
    <rdfs:label xml:lang="zh">预后指标</rdfs:label>
    <rdfs:comment xml:lang="zh">该舌象对病情转归的提示。</rdfs:comment>
  </owl:DatatypeProperty>

  <!-- ================================================================ -->
  <!--  传变链实例（4）：卫 → 气 → 营 → 血                              -->
  <!-- ================================================================ -->

  <sx:WhiteCoating rdf:about="#Instance_WeiFeng_ThinWhite">
    <rdfs:label xml:lang="zh">卫分·薄白苔</rdfs:label>
    <rdfs:comment xml:lang="zh">
      温病初起，邪在卫分。舌象：薄白苔、淡红舌。
    </rdfs:comment>
    <sx:correspondsToWeiQiYingXue rdf:resource="#WeiStage"/>
    <sx:indicatesPathomechanism rdf:resource="#WeiFengPathomechanism"/>
    <sx:progressesTo rdf:resource="#Instance_QiFeng_YellowCoating"/>
    <sx:prognosisIndicator xml:lang="zh">
      邪在表，病势轻浅。若苔由薄转厚、白转黄，为邪入气分。
    </sx:prognosisIndicator>
  </sx:WhiteCoating>

  <sx:YellowCoating rdf:about="#Instance_QiFeng_YellowCoating">
    <rdfs:label xml:lang="zh">气分·黄苔</rdfs:label>
    <rdfs:comment xml:lang="zh">
      邪入气分。舌象：黄苔、红舌。
    </rdfs:comment>
    <sx:correspondsToWeiQiYingXue rdf:resource="#QiStage"/>
    <sx:indicatesPathomechanism rdf:resource="#QiFengPathomechanism"/>
    <sx:progressesFrom rdf:resource="#Instance_WeiFeng_ThinWhite"/>
    <sx:progressesTo rdf:resource="#Instance_YingFeng_CrimsonTongue"/>
    <sx:prognosisIndicator xml:lang="zh">
      邪已入里化热。黄苔持续加重为热势鸱张；黄转灰黑为热极。
    </sx:prognosisIndicator>
  </sx:YellowCoating>

  <sx:CrimsonTongue rdf:about="#Instance_YingFeng_CrimsonTongue">
    <rdfs:label xml:lang="zh">营分·绛舌</rdfs:label>
    <rdfs:comment xml:lang="zh">
      热入营分。舌象：绛舌、少苔或无苔。
    </rdfs:comment>
    <sx:correspondsToWeiQiYingXue rdf:resource="#YingStage"/>
    <sx:indicatesPathomechanism rdf:resource="#YingFengPathomechanism"/>
    <sx:progressesFrom rdf:resource="#Instance_QiFeng_YellowCoating"/>
    <sx:progressesTo rdf:resource="#Instance_XueFeng_PurpleTongue"/>
    <sx:prognosisIndicator xml:lang="zh">
      热入营分，阴液已伤。绛而干→急需凉营养阴；绛转紫→将入血分。
    </sx:prognosisIndicator>
  </sx:CrimsonTongue>

  <sx:PurpleTongue rdf:about="#Instance_XueFeng_PurpleTongue">
    <rdfs:label xml:lang="zh">血分·紫舌</rdfs:label>
    <rdfs:comment xml:lang="zh">
      热入血分。舌象：紫舌、瘀斑瘀点。
    </rdfs:comment>
    <sx:correspondsToWeiQiYingXue rdf:resource="#XueStage"/>
    <sx:indicatesPathomechanism rdf:resource="#XueFengPathomechanism"/>
    <sx:progressesFrom rdf:resource="#Instance_YingFeng_CrimsonTongue"/>
    <sx:prognosisIndicator xml:lang="zh">
      热入血分，动血耗阴。紫而燥→热瘀互结；见瘀斑瘀点→迫血妄行。
    </sx:prognosisIndicator>
  </sx:PurpleTongue>

  <!-- ================================================================ -->
  <!--  兼夹证舌象关联实例（3）                                          -->
  <!-- ================================================================ -->

  <sx:GreasyCoating rdf:about="#Instance_ShuiYin_GreasyCoating">
    <rdfs:label xml:lang="zh">水饮·白腻滑苔</rdfs:label>
    <rdfs:comment xml:lang="zh">
      白腻滑苔为水饮内停之舌征。
    </rdfs:comment>
    <sx:indicatesPathomechanism rdf:resource="#WaterRetentionPathomechanism"/>
    <sx:wenbingNote xml:lang="zh">
      提示方剂：苓桂术甘汤、五苓散、小青龙汤。
    </sx:wenbingNote>
    <sx:relatedTo rdf:resource="#SlipperyTongue"/>
  </sx:GreasyCoating>

  <sx:EcchymosisTongue rdf:about="#Instance_YuXue_Ecchymosis">
    <rdfs:label xml:lang="zh">瘀血·瘀斑舌</rdfs:label>
    <rdfs:comment xml:lang="zh">
      瘀斑舌为瘀血内阻之舌征。
    </rdfs:comment>
    <sx:indicatesPathomechanism rdf:resource="#BloodStasisPathomechanism"/>
    <sx:wenbingNote xml:lang="zh">
      提示方剂：桃核承气汤、桂枝茯苓丸、下瘀血汤。
    </sx:wenbingNote>
    <sx:relatedTo rdf:resource="#PurpleDistendedVein"/>
  </sx:EcchymosisTongue>

  <sx:CurdyCoating rdf:about="#Instance_ShiJi_CurdyCoating">
    <rdfs:label xml:lang="zh">食积·腐苔</rdfs:label>
    <rdfs:comment xml:lang="zh">
      腐苔为食积、痰浊之舌征。
    </rdfs:comment>
    <sx:indicatesPathomechanism rdf:resource="#FoodStagnationPathomechanism"/>
    <sx:wenbingNote xml:lang="zh">
      提示方剂：大承气汤、厚朴三物汤。
    </sx:wenbingNote>
  </sx:CurdyCoating>

  <!-- ================================================================ -->
  <!--  互斥声明（2）                                                    -->
  <!-- ================================================================ -->

  <!-- 六维一级分类互斥 -->
  <rdf:Description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
    <owl:members rdf:parseType="Collection">
      <owl:Class rdf:about="#TongueBodyColor"/>
      <owl:Class rdf:about="#TongueCoating"/>
      <owl:Class rdf:about="#TongueShape"/>
      <owl:Class rdf:about="#TongueDynamics"/>
      <owl:Class rdf:about="#SublingualVein"/>
      <owl:Class rdf:about="#TongueMoisture"/>
    </owl:members>
  </rdf:Description>

  <!-- 卫气营血四阶段互斥 -->
  <rdf:Description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
    <owl:members rdf:parseType="Collection">
      <owl:Class rdf:about="#WeiStage"/>
      <owl:Class rdf:about="#QiStage"/>
      <owl:Class rdf:about="#YingStage"/>
      <owl:Class rdf:about="#XueStage"/>
    </owl:members>
  </rdf:Description>

</rdf:RDF>