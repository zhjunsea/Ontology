<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
    xmlns="http://www.tcm-classics.org/liujing#"
    xml:base="http://www.tcm-classics.org/liujing"
    xmlns:lj="http://www.tcm-classics.org/liujing#"
    xmlns:mx="http://www.tcm-classics.org/maixiang#"
    xmlns:tcm="http://www.tcm-classics.org/tcm#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:dc="http://purl.org/dc/elements/1.1/">

    <!-- ========================================== -->
    <!-- 本体元数据 -->
    <!-- ========================================== -->
    <owl:Ontology rdf:about="http://www.tcm-classics.org/liujing">
        <dc:title>六经本体（桂林古本+胡希恕释）</dc:title>
        <dc:description>严格基于《伤寒杂病论》桂林古本提纲证及胡希恕六经八纲理论构建。不含脏腑经络衍义。</dc:description>
        <owl:versionInfo>1.4-Aggravates-Full</owl:versionInfo>
        <owl:imports rdf:resource="http://www.tcm-classics.org/tcm"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/skos/liujing"/>
    </owl:Ontology>

    <!-- ========================================== -->
    <!-- 顶层类定义 -->
    <!-- ========================================== -->
    <owl:Class rdf:about="http://www.tcm-classics.org/liujing#SixChannelSyndrome">
        <rdfs:label xml:lang="zh">六经证候</rdfs:label>
        <rdfs:comment xml:lang="zh">六经非经络脏腑，乃病位与病性组合之证候反应状态（胡希恕定义）</rdfs:comment>
    </owl:Class>

    <!-- ========================================== -->
    <!-- 六个互斥子类 -->
    <!-- ========================================== -->
    <owl:Class rdf:about="http://www.tcm-classics.org/liujing#Taiyang">
        <rdfs:subClassOf rdf:resource="http://www.tcm-classics.org/liujing#SixChannelSyndrome"/>
        <rdfs:label xml:lang="zh">太阳病</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://www.tcm-classics.org/liujing#Yangming">
        <rdfs:subClassOf rdf:resource="http://www.tcm-classics.org/liujing#SixChannelSyndrome"/>
        <rdfs:label xml:lang="zh">阳明病</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://www.tcm-classics.org/liujing#Shaoyang">
        <rdfs:subClassOf rdf:resource="http://www.tcm-classics.org/liujing#SixChannelSyndrome"/>
        <rdfs:label xml:lang="zh">少阳病</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://www.tcm-classics.org/liujing#Taiyin">
        <rdfs:subClassOf rdf:resource="http://www.tcm-classics.org/liujing#SixChannelSyndrome"/>
        <rdfs:label xml:lang="zh">太阴病</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://www.tcm-classics.org/liujing#Shaoyin">
        <rdfs:subClassOf rdf:resource="http://www.tcm-classics.org/liujing#SixChannelSyndrome"/>
        <rdfs:label xml:lang="zh">少阴病</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://www.tcm-classics.org/liujing#Jueyin">
        <rdfs:subClassOf rdf:resource="http://www.tcm-classics.org/liujing#SixChannelSyndrome"/>
        <rdfs:label xml:lang="zh">厥阴病</rdfs:label>
    </owl:Class>

    <!-- ========================================== -->
    <!-- 属性定义（range已修正为rdf:langString） -->
    <!-- ========================================== -->
    <owl:DatatypeProperty rdf:about="http://www.tcm-classics.org/liujing#hasDiseaseLocation">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/liujing#SixChannelSyndrome"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:label xml:lang="zh">病位</rdfs:label>
        <rdfs:comment xml:lang="zh">取值范围：表、里、半表半里（胡老八纲定位）</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.tcm-classics.org/liujing#hasDiseaseNature">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/liujing#SixChannelSyndrome"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:label xml:lang="zh">病性</rdfs:label>
        <rdfs:comment xml:lang="zh">取值范围：阳证、阴证（胡老八纲定性）</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.tcm-classics.org/liujing#hasKeySymptom">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/liujing#SixChannelSyndrome"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:label xml:lang="zh">提纲症</rdfs:label>
    </owl:DatatypeProperty>

    <owl:ObjectProperty rdf:about="http://www.tcm-classics.org/liujing#hasTypicalPulse">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/liujing#SixChannelSyndrome"/>
        <rdfs:range rdf:resource="http://www.tcm-classics.org/maixiang#PulseManifestation"/>
        <rdfs:label xml:lang="zh">提纲脉</rdfs:label>
    </owl:ObjectProperty>

    <owl:DatatypeProperty rdf:about="http://www.tcm-classics.org/liujing#tigangClause">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/liujing#SixChannelSyndrome"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:label xml:lang="zh">提纲条文号</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.tcm-classics.org/liujing#hulaoshiInterpretation">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/liujing#SixChannelSyndrome"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:label xml:lang="zh">胡老释义</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.tcm-classics.org/liujing#guilinOriginalText">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/liujing#SixChannelSyndrome"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:label xml:lang="zh">桂林本原文</rdfs:label>
    </owl:DatatypeProperty>

    <!-- ========================================== -->
    <!-- 六经完整实例 -->
    <!-- ========================================== -->

    <!-- 太阳病 -->
    <lj:Taiyang rdf:about="http://www.tcm-classics.org/liujing#Taiyang_Instance">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="zh">太阳病</rdfs:label>
        <lj:hasDiseaseLocation xml:lang="zh">表</lj:hasDiseaseLocation>
        <lj:hasDiseaseNature xml:lang="zh">阳证</lj:hasDiseaseNature>
        <lj:hasTypicalPulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Fu"/>
        <lj:hasKeySymptom xml:lang="zh">头项强痛</lj:hasKeySymptom>
        <lj:hasKeySymptom xml:lang="zh">恶寒</lj:hasKeySymptom>
        <lj:tigangClause xml:lang="zh">【辨太阳病脉证并治上·第1条】</lj:tigangClause>
        <lj:guilinOriginalText xml:lang="zh">太阳之为病，脉浮，头项强痛而恶寒。</lj:guilinOriginalText>
        <lj:hulaoshiInterpretation xml:lang="zh">太阳病即表阳证。正气充实于体表抗邪，故脉浮、恶寒、头项强痛。凡见表证而属阳者，皆归太阳。</lj:hulaoshiInterpretation>
    </lj:Taiyang>

    <!-- 阳明病 -->
    <lj:Yangming rdf:about="http://www.tcm-classics.org/liujing#Yangming_Instance">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="zh">阳明病</rdfs:label>
        <lj:hasDiseaseLocation xml:lang="zh">里</lj:hasDiseaseLocation>
        <lj:hasDiseaseNature xml:lang="zh">阳证</lj:hasDiseaseNature>
        <lj:hasTypicalPulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Hong"/>
        <lj:hasTypicalPulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Shi"/>
        <lj:hasTypicalPulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Chi"/>
        <lj:hasKeySymptom xml:lang="zh">胃家实</lj:hasKeySymptom>
        <lj:hasKeySymptom xml:lang="zh">身热</lj:hasKeySymptom>
        <lj:hasKeySymptom xml:lang="zh">汗自出</lj:hasKeySymptom>
        <lj:hasKeySymptom xml:lang="zh">不恶寒反恶热</lj:hasKeySymptom>
        <lj:tigangClause xml:lang="zh">【辨阳明病脉证并治·第180条】</lj:tigangClause>
        <lj:guilinOriginalText xml:lang="zh">阳明之为病，胃家实是也。</lj:guilinOriginalText>
        <lj:hulaoshiInterpretation xml:lang="zh">阳明病即里阳证。热结于里，津液受损，故见大热、大汗、大渴、脉洪大或沉实。分经证（白虎）与腑证（承气）。</lj:hulaoshiInterpretation>
    </lj:Yangming>

    <!-- 少阳病 -->
    <lj:Shaoyang rdf:about="http://www.tcm-classics.org/liujing#Shaoyang_Instance">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="zh">少阳病</rdfs:label>
        <lj:hasDiseaseLocation xml:lang="zh">半表半里</lj:hasDiseaseLocation>
        <lj:hasDiseaseNature xml:lang="zh">阳证</lj:hasDiseaseNature>
        <lj:hasTypicalPulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Xian_Yin"/>
        <lj:hasKeySymptom xml:lang="zh">口苦</lj:hasKeySymptom>
        <lj:hasKeySymptom xml:lang="zh">咽干</lj:hasKeySymptom>
        <lj:hasKeySymptom xml:lang="zh">目眩</lj:hasKeySymptom>
        <lj:hasKeySymptom xml:lang="zh">往来寒热</lj:hasKeySymptom>
        <lj:hasKeySymptom xml:lang="zh">胸胁苦满</lj:hasKeySymptom>
        <lj:tigangClause xml:lang="zh">【辨少阳病脉证并治·第263条】</lj:tigangClause>
        <lj:guilinOriginalText xml:lang="zh">少阳之为病，口苦、咽干、目眩也。</lj:guilinOriginalText>
        <lj:hulaoshiInterpretation xml:lang="zh">少阳病即半表半里阳证。邪不在表亦不在里，正邪分争于胸腹腔间，故见往来寒热、胸胁苦满、口苦咽干。小柴胡汤为主方。</lj:hulaoshiInterpretation>
    </lj:Shaoyang>

    <!-- 太阴病 -->
    <lj:Taiyin rdf:about="http://www.tcm-classics.org/liujing#Taiyin_Instance">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="zh">太阴病</rdfs:label>
        <lj:hasDiseaseLocation xml:lang="zh">里</lj:hasDiseaseLocation>
        <lj:hasDiseaseNature xml:lang="zh">阴证</lj:hasDiseaseNature>
        <lj:hasTypicalPulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Chen"/>
        <lj:hasTypicalPulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Ruo"/>
        <lj:hasKeySymptom xml:lang="zh">腹满而吐</lj:hasKeySymptom>
        <lj:hasKeySymptom xml:lang="zh">食不下</lj:hasKeySymptom>
        <lj:hasKeySymptom xml:lang="zh">自利益甚</lj:hasKeySymptom>
        <lj:hasKeySymptom xml:lang="zh">时腹自痛</lj:hasKeySymptom>
        <lj:tigangClause xml:lang="zh">【辨太阴病脉证并治·第273条】</lj:tigangClause>
        <lj:guilinOriginalText xml:lang="zh">太阴之为病，腹满而吐，食不下，自利益甚，时腹自痛。若下之，必胸下结硬。</lj:guilinOriginalText>
        <lj:hulaoshiInterpretation xml:lang="zh">太阴病即里阴证。脾胃虚寒，运化失职，故见腹满、吐利、食不下。与阳明里实相对，此为里虚寒。理中汤为主方。</lj:hulaoshiInterpretation>
    </lj:Taiyin>

    <!-- 少阴病 -->
    <lj:Shaoyin rdf:about="http://www.tcm-classics.org/liujing#Shaoyin_Instance">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="zh">少阴病</rdfs:label>
        <lj:hasDiseaseLocation xml:lang="zh">表</lj:hasDiseaseLocation>
        <lj:hasDiseaseNature xml:lang="zh">阴证</lj:hasDiseaseNature>
        <lj:hasTypicalPulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Wei"/>
        <lj:hasTypicalPulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Xi"/>
        <lj:hasKeySymptom xml:lang="zh">脉微细</lj:hasKeySymptom>
        <lj:hasKeySymptom xml:lang="zh">但欲寐</lj:hasKeySymptom>
        <lj:hasKeySymptom xml:lang="zh">四肢厥逆</lj:hasKeySymptom>
        <lj:tigangClause xml:lang="zh">【辨少阴病脉证并治·第281条】</lj:tigangClause>
        <lj:guilinOriginalText xml:lang="zh">少阴之为病，脉微细，但欲寐也。</lj:guilinOriginalText>
        <lj:hulaoshiInterpretation xml:lang="zh">少阴病即表阴证（亦有里阴重证）。正气衰微，抗邪无力，故脉微细、精神萎靡。寒化用四逆汤回阳，热化用黄连阿胶汤育阴。</lj:hulaoshiInterpretation>
    </lj:Shaoyin>

    <!-- 厥阴病 -->
    <lj:Jueyin rdf:about="http://www.tcm-classics.org/liujing#Jueyin_Instance">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="zh">厥阴病</rdfs:label>
        <lj:hasDiseaseLocation xml:lang="zh">半表半里</lj:hasDiseaseLocation>
        <lj:hasDiseaseNature xml:lang="zh">阴证</lj:hasDiseaseNature>
        <lj:hasTypicalPulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Xian_Yin"/>
        <lj:hasTypicalPulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Wei"/>
        <lj:hasKeySymptom xml:lang="zh">消渴</lj:hasKeySymptom>
        <lj:hasKeySymptom xml:lang="zh">气上撞心</lj:hasKeySymptom>
        <lj:hasKeySymptom xml:lang="zh">心中疼热</lj:hasKeySymptom>
        <lj:hasKeySymptom xml:lang="zh">饥而不欲食</lj:hasKeySymptom>
        <lj:hasKeySymptom xml:lang="zh">食则吐蛔</lj:hasKeySymptom>
        <lj:tigangClause xml:lang="zh">【辨厥阴病脉证并治·第326条】</lj:tigangClause>
        <lj:guilinOriginalText xml:lang="zh">厥阴之为病，消渴，气上撞心，心中疼热，饥而不欲食，食则吐蛔。下之利不止。</lj:guilinOriginalText>
        <lj:hulaoshiInterpretation xml:lang="zh">厥阴病即半表半里阴证。阴阳不相顺接，寒热错杂，上热下寒。乌梅丸为寒热并用之主方。此经最为复杂，须细辨寒热比例。</lj:hulaoshiInterpretation>
    </lj:Jueyin>

    <!-- ========================================== -->
    <!-- 新增：六经间加重（aggravates）关系       -->
    <!-- 说明：所有传变关系皆以临床症状为最终依据，以下是经典论述中较为常见的路径 -->
    <!-- ========================================== -->

    <!-- 1. 太阳传阳明（顺传，最常见规律） -->
    <!-- 出处：《伤寒论》太阳病篇及胡希恕学术思想 -->
    <!-- 说明：太阳病不解，邪气入里化热，最容易传入阳明 -->
    <rdf:Description rdf:about="http://www.tcm-classics.org/liujing#Taiyang_Instance">
        <tcm:aggravates rdf:resource="http://www.tcm-classics.org/liujing#Yangming_Instance"/>
        <rdfs:comment xml:lang="zh">太阳病不解，邪气入里化热，传入阳明。此为临床最常见传变规律。</rdfs:comment>
    </rdf:Description>

    <!-- 2. 太阳传少阳（循经传/越经传） -->
    <!-- 出处：《伤寒论》第5条："伤寒二三日，阳明少阳证不见者，为不传也。" -->
    <!-- 说明：太阳病也可直接传入少阳，表现为"半表半里"证 -->
    <rdf:Description rdf:about="http://www.tcm-classics.org/liujing#Taiyang_Instance">
        <tcm:aggravates rdf:resource="http://www.tcm-classics.org/liujing#Shaoyang_Instance"/>
        <rdfs:comment xml:lang="zh">太阳病不解，邪气可直传少阳，出现往来寒热、胸胁苦满等半表半里证。</rdfs:comment>
    </rdf:Description>

    <!-- 3. 太阳传太阴（表邪入里，影响里气） -->
    <!-- 出处：《伤寒论》桂枝汤证兼太阴下利之机理 -->
    <!-- 说明：太阳病失治或误治，可致太阴虚寒，如桂枝汤证兼见下利 -->
    <rdf:Description rdf:about="http://www.tcm-classics.org/liujing#Taiyang_Instance">
        <tcm:aggravates rdf:resource="http://www.tcm-classics.org/liujing#Taiyin_Instance"/>
        <rdfs:comment xml:lang="zh">太阳病不解，表邪入里，可影响太阴之气，出现腹满、自利等里虚寒象。</rdfs:comment>
    </rdf:Description>

    <!-- 4. 少阳传阳明（少阳病传入阳明） -->
    <!-- 出处：《張卿子傷寒論》："少阳病传之入胃，则更不传三阴" -->
    <!-- 说明：少阳病失治，邪气可传入阳明，表现为大柴胡汤证 -->
    <rdf:Description rdf:about="http://www.tcm-classics.org/liujing#Shaoyang_Instance">
        <tcm:aggravates rdf:resource="http://www.tcm-classics.org/liujing#Yangming_Instance"/>
        <rdfs:comment xml:lang="zh">少阳病不解，邪热可传入阳明，出现心下急、呕不止、郁郁微烦等阳明兼症。</rdfs:comment>
    </rdf:Description>

    <!-- 5. 太阴传少阴（太阴虚寒进一步加重） -->
    <!-- 出处：《医宗金鉴·订正仲景全书伤寒论注》："太阴寒邪，传少阴之寒证也" -->
    <!-- 说明：太阴虚寒证加重，病邪深入少阴，脉微细、但欲寐 -->
    <rdf:Description rdf:about="http://www.tcm-classics.org/liujing#Taiyin_Instance">
        <tcm:aggravates rdf:resource="http://www.tcm-classics.org/liujing#Shaoyin_Instance"/>
        <rdfs:comment xml:lang="zh">太阴虚寒证继续发展，阳气更衰，传入少阴，出现脉微细、但欲寐等危象。</rdfs:comment>
    </rdf:Description>

    <!-- 6. 少阴传厥阴（少阴病传入厥阴） -->
    <!-- 出处：《医宗金鉴·订正仲景全书伤寒论注》："少阴寒邪传厥阴之寒证也" -->
    <!-- 说明：少阴病进一步发展，可传入厥阴，此为阴证的终末阶段 -->
    <rdf:Description rdf:about="http://www.tcm-classics.org/liujing#Shaoyin_Instance">
        <tcm:aggravates rdf:resource="http://www.tcm-classics.org/liujing#Jueyin_Instance"/>
        <rdfs:comment xml:lang="zh">少阴病进一步发展，阳气更衰，传入厥阴，出现寒热错杂、上热下寒之象。</rdfs:comment>
    </rdf:Description>

    <!-- 7. 太阳传少阴（表里传，表证陷入） -->
    <!-- 出处：太阳与少阴相表里，表病失治可直中少阴 -->
    <!-- 说明：太阳病（表阳证）不解，正气虚衰，可直中少阴（表阴证），表现为反发热、脉沉 -->
    <rdf:Description rdf:about="http://www.tcm-classics.org/liujing#Taiyang_Instance">
        <tcm:aggravates rdf:resource="http://www.tcm-classics.org/liujing#Shaoyin_Instance"/>
        <rdfs:comment xml:lang="zh">太阳病失治，正气虚衰，可直中少阴，出现发热而脉沉（麻黄附子细辛汤证）。</rdfs:comment>
    </rdf:Description>

    <!-- 8. 阳明传太阴（表里传，里热转虚寒） -->
    <!-- 出处：阳明与太阴相表里，过用寒凉可致虚寒 -->
    <!-- 说明：阳明病（里阳证）失治，或过用寒凉，可转为太阴病（里阴证） -->
    <rdf:Description rdf:about="http://www.tcm-classics.org/liujing#Yangming_Instance">
        <tcm:aggravates rdf:resource="http://www.tcm-classics.org/liujing#Taiyin_Instance"/>
        <rdfs:comment xml:lang="zh">阳明病失治，或过用寒凉攻下，可转为太阴虚寒证，出现腹满、自利等象。</rdfs:comment>
    </rdf:Description>

    <!-- 9. 少阳传厥阴（表里传，半表半里阳转阴） -->
    <!-- 出处：少阳与厥阴相表里，少阳病失治可陷入厥阴 -->
    <!-- 说明：少阳病（半表半里阳证）不解，正气不足，可陷入厥阴（半表半里阴证） -->
    <rdf:Description rdf:about="http://www.tcm-classics.org/liujing#Shaoyang_Instance">
        <tcm:aggravates rdf:resource="http://www.tcm-classics.org/liujing#Jueyin_Instance"/>
        <rdfs:comment xml:lang="zh">少阳病失治，正气不足，可陷入厥阴，出现寒热错杂、上热下寒之象。</rdfs:comment>
    </rdf:Description>

</rdf:RDF>