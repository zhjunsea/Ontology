<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns="http://www.tcm-classics.org/bingzheng#"
     xml:base="http://www.tcm-classics.org/bingzheng"
     xmlns:bz="http://www.tcm-classics.org/bingzheng#"
     xmlns:fj="http://www.tcm-classics.org/fangji#"
     xmlns:tcm="http://www.tcm-classics.org/tcm#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:lj="http://www.tcm-classics.org/liujing#"
     xmlns:bg="http://www.tcm-classics.org/bagang#"
     xmlns:zz="http://www.tcm-classics.org/zhengzhuangtizheng#"
     xmlns:mx="http://www.tcm-classics.org/maixiang#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:sx="http://www.tcm-classics.org/shexiang#">

    <!-- ==================== 本体声明 ==================== -->
    <owl:Ontology rdf:about="http://www.tcm-classics.org/bingzheng">
        <dc:title>伤寒杂病论病证本体·审校定本</dc:title>
        <dc:description>严格基于宋本（赵开美本）《伤寒论》《金匮要略》原文及胡希恕学术体系。条文编号依宋本。文本与桂林古本互校无异者不另注。
                    【v5.5版变更】
                        （1）新增否决症状支持：has_exclusion_symptom 对象属性。
                        （2）新增加减规则支持：ModificationRule 类及 has_modification_rule、trigger_symptom、action_description 属性。
                        （3）为典型方证添加示例否决与加减规则，并提取为具名个体。
                        （4）新增 evidenceLevel 数据属性（位于症状命名空间），用于标记症状的证据等级（确据/一般），支持方证匹配时的证据链排序。
                        （5）为小青龙汤补充“渴”的加减规则（第40条方后注），为桂枝汤补充“喘”的加减规则（第18条）。
                    【v5.4版变更】
                        （1）修复variantOf属性命名空间错误（bianzheng→bingzheng）。
                        （2）删除重复方证定义（乌梅丸、当归四逆、吴茱萸、白头翁）及重复章节注释。
                        （3）葛根汤主证及变体补bg:Yang（太阳即表阳证，与v5.0修正(5)体例统一）。
                        （4）删除少阴提纲证上不当的fj:indicated_for断言。
                        （5）葛根汤脉象Pulse_FuJin改为Pulse_Fu+Pulse_Jin，与太阳伤寒、大青龙体例统一。
                        （6）真武汤补或然症（或咳、或呕），据第316条原文。
                        （7）变体has_symptom精简为仅保留特有症状，基础症状通过variantOf继承。
                    【v5.3版变更】
                        （1）删除全部 belongs_to_channel 断言（63处）。该属性已在 tcm.owl v5.1 中删除，方证归属六经的唯一权威属性为 bz:belongs_to_liujing。
                        （2）六个废弃提纲证个体（*BingGangZheng）亦不再携带归属断言，仅保留原文、胡老释义及 patternRole 供追溯。
                        （3）SWRL规则集同步升级至v2.1，规则C改用 bz:belongs_to_liujing。
                    【v5.2版重大架构变更】
                    （1）新增 bz:belongs_to_liujing 对象属性，range 指向六经本体（liujing.owl）的 SixChannelSyndrome 实例。
                    （2）新增 bz:patternRole 数据属性。
                    （3）六个提纲证个体标记为 owl:deprecated=true。
                    （4）所有可处方方证添加 belongs_to_liujing 断言。
                    （5）三个类别占位个体标记 patternRole=placeholder。
                    【v27.0修订——主证/或然症重新校准】
                    依据《伤寒论》《金匮要略》原文及胡希恕“方证相应”学术思想，重新校准每个方证的：
                    （1）主证（tcm:has_symptom）：方证成立的必要条件，缺一不可；
                    （2）或然症（bz:has_or_symptom）：原文以“或”字领起或非必要的伴随症状，不参与淘汰判定；
                    （3）否决症状（bz:has_exclusion_symptom）：存在即直接淘汰该方证。
        </dc:description>
        <owl:versionInfo>5.6</owl:versionInfo>
        <owl:imports rdf:resource="http://www.tcm-classics.org/skos/bingzheng"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/liujing"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng"/>
    </owl:Ontology>

    <!-- ==================== 注释属性 ==================== -->
    <owl:AnnotationProperty rdf:about="http://www.tcm-classics.org/bingzheng#originalDescription">
        <rdfs:label xml:lang="zh">原文描述</rdfs:label>
    </owl:AnnotationProperty>
    <owl:AnnotationProperty rdf:about="http://www.tcm-classics.org/bingzheng#huxishuExplanation">
        <rdfs:label xml:lang="zh">胡老释义</rdfs:label>
    </owl:AnnotationProperty>

    <!-- ==================== 对象属性 ==================== -->
    <owl:ObjectProperty rdf:about="http://www.tcm-classics.org/bingzheng#has_typical_tongue">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#DiseasePattern"/>
        <rdfs:range rdf:resource="http://www.tcm-classics.org/shexiang#TongueManifestation"/>
        <rdfs:label xml:lang="zh">典型舌象</rdfs:label>
        <rdfs:comment xml:lang="zh">该病证常见舌象，作为参考依据，不参与主证强制匹配。</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.tcm-classics.org/bingzheng#has_or_symptom">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#DiseasePattern"/>
        <rdfs:range rdf:resource="http://www.tcm-classics.org/tcm#SymptomSign"/>
        <rdfs:label xml:lang="zh">或然症状</rdfs:label>
        <rdfs:comment xml:lang="zh">原文以“或”字领起之症状，或非必要伴随症状，不参与主证淘汰判定。</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.tcm-classics.org/bingzheng#has_concomitant">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#DiseasePattern"/>
        <rdfs:range rdf:resource="http://www.tcm-classics.org/jianjia#ConcomitantPathology"/>
        <rdfs:label xml:lang="zh">兼夹</rdfs:label>
        <rdfs:comment xml:lang="zh">标注六经主证之外附带的兼夹证。</rdfs:comment>
    </owl:ObjectProperty>

    <!-- v5.2 属性 -->
    <owl:ObjectProperty rdf:about="http://www.tcm-classics.org/bingzheng#belongs_to_liujing">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#DiseasePattern"/>
        <rdfs:range rdf:resource="http://www.tcm-classics.org/liujing#SixChannelSyndrome"/>
        <rdfs:label xml:lang="zh">归属六经</rdfs:label>
        <rdfs:comment xml:lang="zh">标注该方证从属于哪个六经证候实例。</rdfs:comment>
    </owl:ObjectProperty>
        
    <owl:ObjectProperty rdf:about="http://www.tcm-classics.org/bingzheng#variantOf">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#DiseasePattern"/>
        <rdfs:range rdf:resource="http://www.tcm-classics.org/tcm#DiseasePattern"/>
        <rdfs:label xml:lang="zh">变体于</rdfs:label>
        <rdfs:comment xml:lang="zh">表示某病证模式是另一病证模式的合病/兼证/变证版本。</rdfs:comment>
    </owl:ObjectProperty>

    <owl:DatatypeProperty rdf:about="http://www.tcm-classics.org/bingzheng#patternRole">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#DiseasePattern"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:label xml:lang="zh">方证角色</rdfs:label>
        <rdfs:comment xml:lang="zh">显式标记个体角色：gangzheng / prescribable / placeholder。</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- v5.5 新增 -->
    <owl:ObjectProperty rdf:about="http://www.tcm-classics.org/bingzheng#has_exclusion_symptom">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#DiseasePattern"/>
        <rdfs:range rdf:resource="http://www.tcm-classics.org/tcm#SymptomSign"/>
        <rdfs:label xml:lang="zh">否决症状</rdfs:label>
        <rdfs:comment xml:lang="zh">若患者存在该症状，则直接否决本证候。</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.tcm-classics.org/bingzheng#has_modification_rule">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#DiseasePattern"/>
        <rdfs:range rdf:resource="http://www.tcm-classics.org/bingzheng#ModificationRule"/>
        <rdfs:label xml:lang="zh">加减规则</rdfs:label>
        <rdfs:comment xml:lang="zh">本证候在特定或然症状下应遵循的加减化裁规则。</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.tcm-classics.org/bingzheng#trigger_symptom">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/bingzheng#ModificationRule"/>
        <rdfs:range rdf:resource="http://www.tcm-classics.org/tcm#SymptomSign"/>
        <rdfs:label xml:lang="zh">触发症状</rdfs:label>
    </owl:ObjectProperty>

    <owl:DatatypeProperty rdf:about="http://www.tcm-classics.org/bingzheng#action_description">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/bingzheng#ModificationRule"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:label xml:lang="zh">加减操作描述</rdfs:label>
        <rdfs:comment xml:lang="zh">如“去半夏，加人参、瓜蒌根”等。</rdfs:comment>
    </owl:DatatypeProperty>
    
    <owl:DatatypeProperty rdf:about="http://www.tcm-classics.org/bingzheng#triggerMode">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/bingzheng#ModificationRule"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:label xml:lang="zh">触发模式</rdfs:label>
        <rdfs:comment xml:lang="zh">
            加减规则的触发模式。取值：
            - "ALL"（默认）：所有触发症状必须全部存在（AND 逻辑）
            - "ANY"：任一触发症状存在即可触发（OR 逻辑）
            若未定义该属性，默认按 "ALL" 处理。
        </rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.tcm-classics.org/zhengzhuangtizheng#evidenceLevel">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#SymptomSign"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="zh">证据等级</rdfs:label>
        <rdfs:comment xml:lang="zh">用于标记症状在方证匹配中的特异性等级，取值"高特异铁证"/"中特异铁证"/"一般线索"/"否决症状"。</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:Class rdf:about="http://www.tcm-classics.org/bingzheng#ModificationRule">
        <rdfs:label xml:lang="zh">加减规则</rdfs:label>
        <rdfs:comment xml:lang="zh">描述方证加减的具体规则，包括触发症状和操作描述。</rdfs:comment>
    </owl:Class>

    <!-- ================================================================ -->
    <!-- 一、太阳病篇                                                    -->
    <!-- ================================================================ -->

    <!-- 1. 太阳病提纲证（废弃） -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#TaiYangBingGangZheng">
        <rdfs:label xml:lang="zh">太阳病提纲证</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">gangzheng</bz:patternRole>
        <tcm:clause_number xml:lang="zh">【辨太阳病脉证并治上·第1条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">太阳之为病，脉浮，头项强痛而恶寒。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">太阳病总纲。</bz:huxishuExplanation>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Biao"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Yang"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#EHan"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#TouTong"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#XiangQiang"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Fu"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#WhiteCoating"/>
    </tcm:DiseasePattern>

    <!-- 2. 太阳中风证 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#TaiYangZhongFengZheng">
        <rdfs:label xml:lang="zh">太阳中风证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【辨太阳病脉证并治上·第2条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">太阳病，发热，汗出，恶风，脉缓者，名为中风。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">桂枝汤证。表虚证也。主证为汗出、恶风、脉缓。发热为常可伴见，而非必有。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Taiyang"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Biao"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Yang"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <!-- ★ 主证：汗出 + 恶风（第2条核心） -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#HanChu"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#EFeng"/>
        <!-- ★ 或然症：发热、脉缓（脉象参考） -->
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#FaRe"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Huan"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Fu"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#WhiteCoating"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#GuiZhiTang"/>
        <!-- 否决症状 -->
        <bz:has_exclusion_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#WuHan"/>
        <bz:has_exclusion_symptom rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Jin"/>
        <!-- 加减规则 -->
        <bz:has_modification_rule rdf:resource="http://www.tcm-classics.org/bingzheng#ModRule_GuiZhi_Chuan"/>
    </tcm:DiseasePattern>

    <!-- 3. 太阳伤寒证 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#TaiYangShangHanZheng">
        <rdfs:label xml:lang="zh">太阳伤寒证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【辨太阳病脉证并治上·第3条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">太阳病，或已发热，或未发热，必恶寒，体痛，呕逆，脉阴阳俱紧者，名为伤寒。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">麻黄汤证。表实证也。主证为恶寒、无汗、体痛、脉紧。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Taiyang"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Biao"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Yang"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <!-- ★ 主证：恶寒 + 无汗 + 体痛 + 脉紧 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#EHan"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#WuHan"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ShenTiTong"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Jin"/>
        <!-- ★ 或然症：发热（或已发热/或未发热）、呕逆 -->
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#FaRe"/>
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#Ou"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#WhiteCoating"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#MaHuangTang"/>
        <!-- 否决症状 -->
        <bz:has_exclusion_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#HanChu"/>
        <bz:has_exclusion_symptom rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Huan"/>
    </tcm:DiseasePattern>

    <!-- 4. 太阳温病证 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#TaiYangWenBingZheng">
        <rdfs:label xml:lang="zh">太阳温病证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【辨太阳病脉证并治上·第6条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">太阳病，发热而渴，不恶寒者，为温病。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">温病初起即热盛伤津。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Taiyang"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Biao"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Yang"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <!-- ★ 主证：发热 + 渴 + 不恶寒 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#FaRe"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#Ke"/>
        <bz:has_exclusion_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#EHan"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#RedTongue"/>
    </tcm:DiseasePattern>

    <!-- 5. 大青龙汤证 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#DaQingLongTangZheng">
        <rdfs:label xml:lang="zh">大青龙汤证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【辨太阳病脉证并治中·第38条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">太阳中风，脉浮紧，发热恶寒，身疼痛，不汗出而烦躁者，大青龙汤主之。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">外寒内热，表实兼里热烦躁。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Taiyang"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Biao"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <!-- ★ 主证：无汗 + 烦躁 + 脉浮紧 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#WuHan"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#FanZao"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Fu"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Jin"/>
        <!-- ★ 或然症：发热、恶寒、身痛 -->
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#FaRe"/>
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#EHan"/>
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ShenTiTong"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#YellowCoating"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#DaQingLongTang"/>
    </tcm:DiseasePattern>

    <!-- 6. 小青龙汤证 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#XiaoQingLongTangZheng">
        <rdfs:label xml:lang="zh">小青龙汤证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【辨太阳病脉证并治中·第40条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">伤寒表不解，心下有水气，干呕发热而咳，或渴，或利，或噎，或小便不利、少腹满，或喘者，小青龙汤主之。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">外寒内饮证。核心为“表不解”+“心下有水气”，干呕、发热、咳为主证，余皆或然。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Taiyang"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Biao"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Yang"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <bz:has_concomitant rdf:resource="http://www.tcm-classics.org/jianjia#WaterRetention_Instance"/>
        <!-- ★ 主证：干呕 + 发热 + 咳（表不解+心下有水气之核心外候） -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#GanOu"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#FaRe"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#KeSou"/>
        <!-- ★ 或然症：原文所有“或”字症状 -->
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#Ke"/>
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#XiaLi"/>
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#Ye"/>
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#XiaoBianBuLi"/>
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#FuMan"/>
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#Chuan"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Fu"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#SlipperyTongue"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#WhiteCoating"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#XiaoQingLongTang"/>
        <!-- 否决症状 -->
        <bz:has_exclusion_symptom rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Ruo"/>
        <bz:has_exclusion_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#HanChu"/>
        <!-- 加减规则 -->
        <bz:has_modification_rule rdf:resource="http://www.tcm-classics.org/bingzheng#ModRule_XiaoQingLong_FanZao"/>
        <bz:has_modification_rule rdf:resource="http://www.tcm-classics.org/bingzheng#ModRule_XiaoQingLong_Ke"/>
    </tcm:DiseasePattern>

    <!-- 7. 五苓散证 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#WuLingSanZheng">
        <rdfs:label xml:lang="zh">五苓散证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【辨太阳病脉证并治中·第71条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">若脉浮，小便不利，微热消渴者，五苓散主之。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">蓄水证。核心为脉浮、小便不利、渴。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Taiyang"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Biao"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Yang"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <!-- ★ 主证：小便不利 + 脉浮 + 渴/消渴 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#XiaoBianBuLi"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#Ke"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Fu"/>
        <!-- ★ 或然症：微热 -->
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#FaRe"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#SlipperyTongue"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#WhiteCoating"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#WuLingSan"/>
    </tcm:DiseasePattern>

    <!-- 8. 桃核承气汤证 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#TaoHeChengQiTangZheng">
        <rdfs:label xml:lang="zh">桃核承气汤证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【辨太阳病脉证并治中·第106条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">太阳病不解，热结膀胱，其人如狂，血自下，下者愈。但少腹急结者，乃可攻之，宜桃核承气汤。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">蓄血轻证。核心为少腹急结。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Taiyang"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <!-- ★ 主证：少腹急结 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ShaoFuJiJie"/>
        <!-- ★ 或然症：如狂 -->
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#RuKuang"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#PurpleTongue"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#TaoHeChengQiTang"/>
    </tcm:DiseasePattern>

    <!-- ================================================================ -->
    <!-- 二、阳明病篇                                                    -->
    <!-- ================================================================ -->

    <!-- 9. 阳明病提纲证（废弃） -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#YangMingBingGangZheng">
        <rdfs:label xml:lang="zh">阳明病提纲证</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">gangzheng</bz:patternRole>
        <tcm:clause_number xml:lang="zh">【辨阳明病脉证并治·第180条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">阳明之为病，胃家实是也。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">阳明总纲。</bz:huxishuExplanation>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Yang"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ERe"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ShenRe"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Hong"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#YellowCoating"/>
    </tcm:DiseasePattern>

    <!-- 10. 白虎汤证 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#BaiHuTangZheng">
        <rdfs:label xml:lang="zh">白虎汤证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【辨阳明病脉证并治·第176条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">伤寒脉浮滑，此以表有热，里有寒，白虎汤主之。（胡老校：表里俱热）</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">阳明经证。四大症：大热、大汗、大渴、脉洪大。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Yangming"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <!-- ★ 主证：大渴 + 身热 + 汗出 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#DaKe"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ShenRe"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#HanChu"/>
        <!-- ★ 或然症：脉象（浮、滑、洪） -->
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Fu"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Hua"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Hong"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#RedTongue"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#YellowCoating"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#BaiHuTang"/>
    </tcm:DiseasePattern>

    <!-- 11. 大承气汤证 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#DaChengQiTangZheng">
        <rdfs:label xml:lang="zh">大承气汤证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【辨阳明病脉证并治·第208条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">阳明病，脉迟，虽汗出不恶寒者，其身必重，短气，腹满而喘，有潮热者……大承气汤主之。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">阳明腑实重证。核心为潮热、腹满硬痛、不大便。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Yangming"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <!-- ★ 主证：潮热 + 腹满拒按 + 不大便 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ChaoRe"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#FuMan"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#JuAn"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#BuDaBian"/>
        <!-- ★ 或然症：身重、短气、喘、手足濈然汗出、谵语 -->
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ShenTiChen"/>
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#DuanQi"/>
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#Chuan"/>
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ShouZuJiRanHanChu"/>
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ZhanYu"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Chi"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Shi"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#YellowCoating"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#DryTongue"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#DaChengQiTang"/>
    </tcm:DiseasePattern>

    <!-- 12. 小承气汤证 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#XiaoChengQiTangZheng">
        <rdfs:label xml:lang="zh">小承气汤证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【辨阳明病脉证并治·第213条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">阳明病，其人多汗，以津液外出，胃中燥，大便必硬，硬则谵语，小承气汤主之。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">阳明腑实轻证。核心为大便硬、谵语、汗出。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Yangming"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <!-- ★ 主证：大便硬 + 汗出 + 谵语 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#DaBianYing"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#HanChu"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ZhanYu"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Hua"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#YellowCoating"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#XiaoChengQiTang"/>
    </tcm:DiseasePattern>

    <!-- 13. 调胃承气汤证 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#TiaoWeiChengQiTangZheng">
        <rdfs:label xml:lang="zh">调胃承气汤证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【辨阳明病脉证并治·第207条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">阳明病，不吐不下，心烦者，可与调胃承气汤。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">阳明燥热初结。核心为心烦、蒸蒸发热。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Yangming"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <!-- ★ 主证：心烦 + 身热 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#XinFan"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ShenRe"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Shu"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#YellowCoating"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#TiaoWeiChengQiTang"/>
    </tcm:DiseasePattern>

    <!-- 14. 竹叶石膏汤证 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#ZhuYeShiGaoTangZheng">
        <rdfs:label xml:lang="zh">竹叶石膏汤证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【辨阴阳易差后劳复病脉证并治·第397条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">伤寒解后，虚羸少气，气逆欲吐，竹叶石膏汤主之。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">热病后期余热未清，气阴两伤。核心为虚羸少气、气逆欲吐。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Yangming"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <!-- ★ 主证：虚羸少气 + 气逆欲吐 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#XuLei"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ShaoQi"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#YuTu"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Xu"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Shu"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#RedTongue"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#DryTongue"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#ZhuYeShiGaoTang"/>
    </tcm:DiseasePattern>

    <!-- ================================================================ -->
    <!-- 三、少阳病篇                                                    -->
    <!-- ================================================================ -->

    <!-- 15. 少阳病提纲证（废弃） -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#ShaoYangBingGangZheng">
        <rdfs:label xml:lang="zh">少阳病提纲证</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">gangzheng</bz:patternRole>
        <tcm:clause_number xml:lang="zh">【辨少阳病脉证并治·第263条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">少阳之为病，口苦，咽干，目眩也。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">少阳总纲。</bz:huxishuExplanation>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#BanBiaoBanLi"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Yang"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#KouKu"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#YanGan"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#MuXuan"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Xian"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Xi"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#RedTongue"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#WhiteCoating"/>
    </tcm:DiseasePattern>

    <!-- 16. 小柴胡汤证 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#XiaoChaiHuTangZheng">
        <rdfs:label xml:lang="zh">小柴胡汤证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【辨太阳病脉证并治中·第96条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">伤寒五六日中风，往来寒热，胸胁苦满，嘿嘿不欲饮食，心烦喜呕……小柴胡汤主之。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">少阳本证。四大主症：往来寒热、胸胁苦满、默默不欲饮食、心烦喜呕。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Shaoyang"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#BanBiaoBanLi"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Yang"/>
        <!-- ★ 主证：往来寒热 + 胸胁苦满 + 默默不欲饮食 + 心烦喜呕 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#WangLaiHanRe"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#XiongXieKuMan"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#MoMo"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#BuYuShi"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#Ou"/>
        <!-- ★ 或然症：原文所有“或”字症状及部分常见伴随 -->
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#XinFan"/>
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#Ke"/>
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#FuTong"/>
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#XieXiaPiYing"/>
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#XinJi"/>
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#XiaoBianBuLi"/>
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#BuKe"/>
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ShenRe"/>
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#KeSou"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Xian"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Xi"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#RedTongue"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#WhiteCoating"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#XiaoChaiHuTang"/>
        <!-- 否决症状 -->
        <bz:has_exclusion_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#FuManJuAn"/>
        <bz:has_exclusion_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#BuDaBian"/>
        <!-- 加减规则 -->
        <bz:has_modification_rule rdf:resource="http://www.tcm-classics.org/bingzheng#ModRule_XiaoChaiHu_KouKe"/>
        <bz:has_modification_rule rdf:resource="http://www.tcm-classics.org/bingzheng#ModRule_XiaoChaiHu_XinJiXiaoBianBuLi"/>
    </tcm:DiseasePattern>

    <!-- 17. 大柴胡汤证 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#DaChaiHuTangZheng">
        <rdfs:label xml:lang="zh">大柴胡汤证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【辨太阳病脉证并治中·第103条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">呕不止，心下急，郁郁微烦者，为未解也，与大柴胡汤下之则愈。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">少阳阳明合病。核心为呕不止、心下急、郁郁微烦。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Shaoyang"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#BanBiaoBanLi"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <!-- ★ 主证：呕不止 + 心下急 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#Ou"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#XinXiaJi"/>
        <!-- ★ 或然症：郁郁微烦 -->
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#XinFan"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Xian"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Xi"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Shu"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#YellowCoating"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#DaChaiHuTang"/>
    </tcm:DiseasePattern>

    <!-- 18. 柴胡桂枝汤证 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#ChaiHuGuiZhiTangZheng">
        <rdfs:label xml:lang="zh">柴胡桂枝汤证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【辨太阳病脉证并治下·第146条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">伤寒六七日，发热微恶寒，支节烦疼，微呕，心下支结，外证未去者，柴胡桂枝汤主之。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">太阳少阳合病。核心为发热微恶寒、支节烦疼、微呕、心下支结。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Taiyang"/>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Shaoyang"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Biao"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#BanBiaoBanLi"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Yang"/>
        <!-- ★ 主证：发热微恶寒 + 支节烦疼 + 心下支结 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#FaRe"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#EHan"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ShenTiTong"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#XinXiaMan"/>
        <!-- ★ 或然症：微呕、脉象 -->
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#Ou"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Fu"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Xian"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Xi"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#WhiteCoating"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#ChaiHuGuiZhiTang"/>
    </tcm:DiseasePattern>

    <!-- ================================================================ -->
    <!-- 四、太阴病篇                                                    -->
    <!-- ================================================================ -->

    <!-- 19. 太阴病提纲证（废弃） -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#TaiYinBingGangZheng">
        <rdfs:label xml:lang="zh">太阴病提纲证</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">gangzheng</bz:patternRole>
        <tcm:clause_number xml:lang="zh">【辨太阴病脉证并治·第273条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">太阴之为病，腹满而吐，食不下，自利益甚，时腹自痛。若下之，必胸下结硬。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">太阴总纲。</bz:huxishuExplanation>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Yin"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#FuMan"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#Tu"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ShiBuXia"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ZiLi"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#FuTong"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Chen"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Chi"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#PaleWhiteTongue"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#SlipperyTongue"/>
    </tcm:DiseasePattern>

    <!-- 20. 理中汤证 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#LiZhongTangZheng">
        <rdfs:label xml:lang="zh">理中汤证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【辨霍乱病脉证并治·第386条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">霍乱，头痛发热，身疼痛，热多欲饮水者，五苓散主之；寒多不用水者，理中丸主之。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">太阴虚寒本证。核心为腹满、吐、食不下、自利不渴。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Taiyin"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Yin"/>
        <!-- ★ 主证：腹满 + 自利 + 食不下 + 不渴 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#FuMan"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ZiLi"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ShiBuXia"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#BuKe"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Chen"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Chi"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#PaleWhiteTongue"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#SlipperyTongue"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#LiZhongTang"/>
    </tcm:DiseasePattern>

    <!-- 21. 四逆汤证（太阴转少阴） -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#SiNiTangZheng_TaiYin">
        <rdfs:label xml:lang="zh">四逆汤证（太阴转少阴）</rdfs:label>
        <tcm:clause_number xml:lang="zh">【辨太阴病脉证并治·第277条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">自利不渴者，属太阴，以其脏有寒故也，当温之，宜服四逆辈。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">太阴虚寒重证，波及少阴。核心为自利不渴、手足厥冷。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Taiyin"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Yin"/>
        <!-- ★ 主证：自利 + 不渴 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ZiLi"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#BuKe"/>
        <!-- ★ 或然症：手足厥冷 -->
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ShouZuJueLeng"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Chen"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Wei"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#PaleWhiteTongue"/>
    </tcm:DiseasePattern>

    <!-- ================================================================ -->
    <!-- 五、少阴病篇                                                    -->
    <!-- ================================================================ -->

    <!-- 22. 少阴病提纲证（废弃） -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#ShaoYinBingGangZheng">
        <rdfs:label xml:lang="zh">少阴病提纲证</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">gangzheng</bz:patternRole>
        <tcm:clause_number xml:lang="zh">【辨少阴病脉证并治·第281条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">少阴之为病，脉微细，但欲寐也。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">少阴总纲。</bz:huxishuExplanation>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Biao"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Yin"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#DanYuMei"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Wei"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Xi"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#PaleWhiteTongue"/>
    </tcm:DiseasePattern>

    <!-- 23. 四逆汤证（少阴寒化证） -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#SiNiTangZheng_ShaoYin">
        <rdfs:label xml:lang="zh">四逆汤证（少阴寒化证）</rdfs:label>
        <tcm:clause_number xml:lang="zh">【辨少阴病脉证并治·第323条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">少阴病，脉沉者，急温之，宜四逆汤。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">少阴寒化本证。核心为脉沉、四肢厥逆、下利清谷。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Shaoyin"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Yin"/>
        <!-- ★ 主证：脉沉 + 四肢厥逆 + 下利 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SiZhiJueNi"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#XiaLi"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Chen"/>
        <!-- ★ 或然症：但欲寐 -->
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#DanYuMei"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Wei"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#PaleWhiteTongue"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#SiNiTang"/>
    </tcm:DiseasePattern>

    <!-- 24. 通脉四逆汤证 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#TongMaiSiNiTangZheng">
        <rdfs:label xml:lang="zh">通脉四逆汤证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【辨少阴病脉证并治·第317条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">少阴病，下利清谷，里寒外热，手足厥逆，脉微欲绝，身反不恶寒，其人面色赤，或腹痛，或干呕，或咽痛，或利止脉不出者，通脉四逆汤主之。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">少阴阴盛格阳证。核心为下利清谷、里寒外热、脉微欲绝。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Shaoyin"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Yin"/>
        <!-- ★ 主证：下利清谷 + 手足厥逆 + 脉微欲绝 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#XiaLi"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SiZhiJueNi"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Wei"/>
        <!-- ★ 或然症：面色赤、腹痛、干呕、咽痛 -->
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#MianChi"/>
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#FuTong"/>
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#GanOu"/>
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#YanTong"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#PaleWhiteTongue"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#TongMaiSiNiTang"/>
    </tcm:DiseasePattern>

    <!-- 25. 黄连阿胶汤证 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#HuangLianEJiaoTangZheng">
        <rdfs:label xml:lang="zh">黄连阿胶汤证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【辨少阴病脉证并治·第303条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">少阴病，得之二三日以上，心中烦，不得卧，黄连阿胶汤主之。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">少阴热化证。核心为心中烦、不得卧。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Shaoyin"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Yin"/>
        <!-- ★ 主证：心中烦 + 不得卧 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#XinFan"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#BuDeWo"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Xi"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Shu"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#RedTongue"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#DryTongue"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#HuangLianEJiaoTang"/>
    </tcm:DiseasePattern>

    <!-- 26. 真武汤证 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#ZhenWuTangZheng">
        <rdfs:label xml:lang="zh">真武汤证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【辨少阴病脉证并治·第316条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">少阴病，二三日不已，至四五日，腹痛，小便不利，四肢沉重疼痛，自下利者，此为有水气……真武汤主之。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">少阴阳虚水泛证。核心为腹痛、小便不利、四肢沉重疼痛、下利。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Shaoyin"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Yin"/>
        <bz:has_concomitant rdf:resource="http://www.tcm-classics.org/jianjia#WaterRetention_Instance"/>
        <!-- ★ 主证：小便不利 + 四肢沉重疼痛 + 自下利 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#XiaoBianBuLi"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ShenTiTong"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ZiLi"/>
        <!-- ★ 或然症：腹痛、咳、呕 -->
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#FuTong"/>
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#KeSou"/>
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#Ou"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Chen"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Wei"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#PaleWhiteTongue"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#SlipperyTongue"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#ZhenWuTang"/>
    </tcm:DiseasePattern>

    <!-- 27. 麻黄附子细辛汤证 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#MaHuangFuZiXiXinTangZheng">
        <rdfs:label xml:lang="zh">麻黄附子细辛汤证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【辨少阴病脉证并治·第301条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">少阴病，始得之，反发热，脉沉者，麻黄附子细辛汤主之。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">少阴兼表证。核心为反发热、脉沉。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Shaoyin"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Biao"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <!-- ★ 主证：反发热 + 脉沉 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#FaRe"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Chen"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#PaleWhiteTongue"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#MaHuangFuZiXiXinTang"/>
    </tcm:DiseasePattern>

    <!-- ================================================================ -->
    <!-- 六、厥阴病篇                                                    -->
    <!-- ================================================================ -->

    <!-- 28. 厥阴病提纲证（废弃） -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#JueYinBingGangZheng">
        <rdfs:label xml:lang="zh">厥阴病提纲证</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">gangzheng</bz:patternRole>
        <tcm:clause_number xml:lang="zh">【辨厥阴病脉证并治·第326条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">厥阴之为病，消渴，气上撞心，心中疼热，饥而不欲食，食则吐蛔，下之利不止。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">厥阴总纲。寒热错杂。</bz:huxishuExplanation>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#BanBiaoBanLi"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Yin"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#XiaoKe"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#QiShangZhuangXin"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#XinZhongTengRe"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#JiBuYuShi"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#TuHui"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Xian"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Xi"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Wei"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#RedTongue"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#PaleWhiteTongue"/>
    </tcm:DiseasePattern>

    <!-- 29. 乌梅丸证 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#WuMeiWanZheng">
        <rdfs:label xml:lang="zh">乌梅丸证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【辨厥阴病脉证并治·第338条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">蛔厥者，乌梅丸主之。又主久利。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">厥阴寒热错杂正治主方。核心为蛔厥、久利、寒热错杂。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Jueyin"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#BanBiaoBanLi"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Yin"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <!-- ★ 主证：蛔厥（吐蛔 + 手足厥冷）或 久利 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#TuHui"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ShouZuJueLeng"/>
        <!-- ★ 或然症：心烦、呕 -->
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#XinFan"/>
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#Ou"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Wei"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#PaleWhiteTongue"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#RedTongue"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#WuMeiWan"/>
    </tcm:DiseasePattern>

    <!-- 30. 当归四逆汤证 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#DangGuiSiNiTangZheng">
        <rdfs:label xml:lang="zh">当归四逆汤证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【辨厥阴病脉证并治·第351条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">手足厥寒，脉细欲绝者，当归四逆汤主之。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">血虚寒凝证。核心为手足厥寒、脉细欲绝。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Jueyin"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Biao"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <!-- ★ 主证：手足厥寒 + 脉细欲绝 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ShouZuJueLeng"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Xi"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#PaleWhiteTongue"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#DangGuiSiNiTang"/>
    </tcm:DiseasePattern>

    <!-- 31. 吴茱萸汤证 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#WuZhuYuTangZheng">
        <rdfs:label xml:lang="zh">吴茱萸汤证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【辨厥阴病脉证并治·第378条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">干呕，吐涎沫，头痛者，吴茱萸汤主之。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">肝胃虚寒、浊阴上逆证。核心为干呕、吐涎沫、头痛。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Jueyin"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <!-- ★ 主证：干呕 + 吐涎沫 + 头痛 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#GanOu"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#TuXianMo"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#TouTong"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Chen"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Chi"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#PaleWhiteTongue"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#SlipperyTongue"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#WuZhuYuTang"/>
    </tcm:DiseasePattern>

    <!-- 32. 白头翁汤证 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#BaiTouWengTangZheng">
        <rdfs:label xml:lang="zh">白头翁汤证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【辨厥阴病脉证并治·第371条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">热利下重者，白头翁汤主之。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">湿热下利证。核心为热利、下重。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Jueyin"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <!-- ★ 主证：下利 + 下重 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#XiaLi"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#XiaZhong"/>
        <!-- ★ 或然症：口渴、便脓血 -->
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#KeYuYin"/>
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#BianNongXue"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Xian"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Shu"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#RedTongue"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#YellowCoating"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#BaiTouWengTang"/>
    </tcm:DiseasePattern>

    <!-- ================================================================ -->
    <!-- 七、金匮杂病篇                                                  -->
    <!-- ================================================================ -->

    <!-- 33. 苓桂术甘汤证 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#LingGuiZhuGanTangZheng">
        <rdfs:label xml:lang="zh">苓桂术甘汤证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【金匮·痰饮咳嗽病脉证并治·第16条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">心下有痰饮，胸胁支满，目眩，苓桂术甘汤主之。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">中焦水饮证。核心为胸胁支满、目眩。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Taiyin"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <bz:has_concomitant rdf:resource="http://www.tcm-classics.org/jianjia#WaterRetention_Instance"/>
        <!-- ★ 主证：胸胁支满 + 目眩 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#XiongXieZhiMan"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#MuXuan"/>
        <!-- ★ 或然症：短气 -->
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#DuanQi"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Chen"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Xian"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#PaleWhiteTongue"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#SlipperyTongue"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#LingGuiZhuGanTang"/>
    </tcm:DiseasePattern>

    <!-- 34. 肾气丸证 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#ShenQiWanZheng">
        <rdfs:label xml:lang="zh">肾气丸证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【金匮·血痹虚劳病脉证并治·第15条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">虚劳腰痛，少腹拘急，小便不利者，八味肾气丸主之。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">肾阳虚衰证。核心为腰痛、少腹拘急、小便不利。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Shaoyin"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <!-- ★ 主证：腰痛 + 少腹拘急 + 小便不利 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#YaoTong"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ShaoFuJuJi"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#XiaoBianBuLi"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Chen"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Xi"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#PaleWhiteTongue"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#ShenQiWan"/>
    </tcm:DiseasePattern>

    <!-- 35. 小建中汤证 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#XiaoJianZhongTangZheng">
        <rdfs:label xml:lang="zh">小建中汤证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【金匮·血痹虚劳病脉证并治·第13条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">虚劳里急，悸，衄，腹中痛，梦失精，四肢酸疼，手足烦热，咽干口燥，小建中汤主之。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">中焦虚寒、营卫不和证。核心为里急、腹中痛、虚劳。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Taiyin"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <!-- ★ 主证：里急 + 腹中痛 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#LiJi"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#FuTong"/>
        <!-- ★ 或然症：心悸、手足烦热、咽干口燥等虚劳表现 -->
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#XinJi"/>
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ShouZuFanRe"/>
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#YanGan"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Xian"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Xi"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#PaleWhiteTongue"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#XiaoJianZhongTang"/>
    </tcm:DiseasePattern>

    <!-- 36. 桂枝茯苓丸证 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#GuiZhiFuLingWanZheng">
        <rdfs:label xml:lang="zh">桂枝茯苓丸证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【金匮·妇人妊娠病脉证并治·第2条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">妇人宿有癥病，经断未及三月，而得漏下不止，胎动在脐上者，为癥痼害……桂枝茯苓丸主之。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">瘀血癥块证。核心为癥病、漏下、少腹急结。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Taiyang"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <bz:has_concomitant rdf:resource="http://www.tcm-classics.org/jianjia#BloodStasis_Instance"/>
        <!-- ★ 主证：癥病（少腹癥块）+ 漏下 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#LouXia"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ShaoFuJiJie"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_She"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#PurpleTongue"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#GuiZhiFuLingWan"/>
    </tcm:DiseasePattern>

    <!-- 37. 温经汤证 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#WenJingTangZheng">
        <rdfs:label xml:lang="zh">温经汤证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【金匮·妇人杂病脉证并治·第9条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">妇人年五十所，病下利数十日不止，暮即发热，少腹里急，腹满，手掌烦热，唇口干燥……温经汤主之。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">冲任虚寒、瘀血内阻证。核心为暮即发热、少腹里急、唇口干燥。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Jueyin"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <bz:has_concomitant rdf:resource="http://www.tcm-classics.org/jianjia#BloodStasis_Instance"/>
        <!-- ★ 主证：暮即发热 + 少腹里急 + 唇口干燥 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#MuRe"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ShaoFuLiJi"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ChunKouGanZao"/>
        <!-- ★ 或然症：腹满、手掌烦热 -->
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#FuMan"/>
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ShouZhangFanRe"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Chen"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_She"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#PaleWhiteTongue"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#WenJingTang"/>
    </tcm:DiseasePattern>

    <!-- 38. 酸枣仁汤证 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#SuanZaoRenTangZheng">
        <rdfs:label xml:lang="zh">酸枣仁汤证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【金匮·血痹虚劳病脉证并治·第17条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">虚劳虚烦不得眠，酸枣仁汤主之。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">肝血不足、虚热内扰证。核心为虚烦不得眠。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Shaoyin"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <!-- ★ 主证：虚烦不得眠 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#XuFan"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#BuDeMian"/>
        <!-- ★ 或然症：头晕、心悸 -->
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#TouYun"/>
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#XinJi"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Xian"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Xi"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#RedTongue"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#SuanZaoRenTang"/>
    </tcm:DiseasePattern>

    <!-- 39. 厚朴七物汤证 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#HouPoQiWuTangZheng">
        <rdfs:label xml:lang="zh">厚朴七物汤证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【金匮·腹满寒疝宿食病脉证并治·第9条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">病腹满，发热十日，脉浮而数，饮食如故，厚朴七物汤主之。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">太阳阳明合病（表未解兼里实）。核心为腹满、发热、脉浮数。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Taiyang"/>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Yangming"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Biao"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <!-- ★ 主证：腹满 + 发热 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#FuMan"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#FaRe"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Fu"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Shu"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#YellowCoating"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#HouPoQiWuTang"/>
    </tcm:DiseasePattern>

    <!-- 40. 葛根芩连汤证 ★★ -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#GeGenQinLianTangZheng">
        <rdfs:label xml:lang="zh">葛根芩连汤证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【辨太阳病脉证并治中·第34条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">太阳病，桂枝证，医反下之，利遂不止，脉促者，表未解也；喘而汗出者，葛根黄芩黄连汤主之。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">表邪内陷、协热下利证。核心为下利不止、汗出。喘和脉促为或然症，非必备。胡老：“葛根芩连汤的主证是下利，特征是汗出，热势外逼。喘是或然症，不是必有症。”</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Taiyang"/>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Yangming"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Biao"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <!-- ★ 主证：下利 + 汗出（协热下利之眼目） -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#XiaLi"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#HanChu"/>
        <!-- ★ 或然症：喘、脉促、舌象（原文虽列，非必有） -->
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#Chuan"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Cu"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#RedTongue"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#YellowCoating"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#GeGenQinLianTang"/>
    </tcm:DiseasePattern>

    <!-- 41a. 葛根汤证（主证） -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#GeGenTangZheng">
        <rdfs:label xml:lang="zh">葛根汤证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【辨太阳病脉证并治中·第31条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">太阳病，项背强几几，无汗恶风，葛根汤主之。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">太阳伤寒兼经输不利证。核心为项背强几几、无汗、恶风。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Taiyang"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Biao"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Yang"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <!-- ★ 主证：项背强几几 + 无汗 + 恶风 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#XiangQiang"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#BeiQiang"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#WuHan"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#EFeng"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Fu"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Jin"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#NormalTongue"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#WhiteCoating"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#GeGenTang"/>
    </tcm:DiseasePattern>

    <!-- 41b. 葛根汤证·合病下利型 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#GeGenTangZheng_HeBing">
        <rdfs:label xml:lang="zh">葛根汤证·合病下利型</rdfs:label>
        <tcm:clause_number xml:lang="zh">【辨太阳病脉证并治中·第32条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">太阳与阳明合病者，必自下利，葛根汤主之。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">太阳阳明合病自下利证。核心为太阳表实证 + 下利。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:variantOf rdf:resource="http://www.tcm-classics.org/bingzheng#GeGenTangZheng"/>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Taiyang"/>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Yangming"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Biao"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Yang"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <!-- ★ 主证：继承葛根汤主证 + 下利 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#XiaLi"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Fu"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Jin"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#NormalTongue"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#WhiteCoating"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#GeGenTang"/>
    </tcm:DiseasePattern>

    <!-- 42. 泽漆汤证 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#ZeQiTangZheng">
        <rdfs:label xml:lang="zh">泽漆汤证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【金匮·肺痿肺痈咳嗽上气病脉证并治·第8条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">咳而脉沉者，泽漆汤主之。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">水饮犯肺证。核心为咳嗽、脉沉。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Taiyin"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <bz:has_concomitant rdf:resource="http://www.tcm-classics.org/jianjia#WaterRetention_Instance"/>
        <!-- ★ 主证：咳嗽 + 脉沉 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#KeSou"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Chen"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#PaleWhiteTongue"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#SlipperyTongue"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#ZeQiTang"/>
    </tcm:DiseasePattern>

    <!-- ================================================================ -->
    <!-- 八、温病方证（补充）                                            -->
    <!-- ================================================================ -->

    <!-- 43. 血分证（温病） -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#XueFenZheng">
        <rdfs:label xml:lang="zh">血分证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【温病·卫气营血辨证】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">身热夜甚，斑疹隐隐，吐血衄血，舌绛。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">温病血分证。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <!-- ★ 主证：身热夜甚 + 舌绛 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ShenRe"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#DeepRedTongue"/>
        <!-- ★ 或然症：斑疹、吐血衄血 -->
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#BanZhen"/>
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#TuXue"/>
    </tcm:DiseasePattern>

    <!-- 44. 热陷心包证（温病） -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#ReXianXinBaoZheng">
        <rdfs:label xml:lang="zh">热陷心包证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【温病·卫气营血辨证】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">高热，神昏谵语，舌蹇肢厥。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">温病热陷心包证。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <!-- ★ 主证：高热 + 神昏谵语 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ShenRe"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ShenHun"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ZhanYu"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#DeepRedTongue"/>
    </tcm:DiseasePattern>

    <!-- ================================================================ -->
    <!-- 九、补充方证                                                    -->
    <!-- ================================================================ -->

    <!-- 麻杏石甘汤证 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#MaXingShiGanTangZheng">
        <rdfs:label xml:lang="zh">麻杏石甘汤证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【辨太阳病脉证并治中·第63条；第162条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">（第63条）发汗后，不可更行桂枝汤，汗出而喘，无大热者，可与麻黄杏仁甘草石膏汤。（第162条）下后，不可更行桂枝汤，若汗出而喘，无大热者，可与麻黄杏子甘草石膏汤。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">邪热壅肺证。核心为汗出而喘。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Yangming"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <!-- ★ 主证：汗出 + 喘 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#HanChu"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#Chuan"/>
        <!-- ★ 或然症：发热、脉数 -->
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#FaRe"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Shu"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#RedTongue"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#YellowCoating"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#MaXingShiGanTang"/>
    </tcm:DiseasePattern>

    <!-- 猪苓汤证 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#ZhuLingTangZheng">
        <rdfs:label xml:lang="zh">猪苓汤证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【辨阳明病脉证并治·第223条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">若脉浮发热，渴欲饮水，小便不利者，猪苓汤主之。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">水热互结兼阴伤证。核心为小便不利、渴欲饮水、发热。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Yangming"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <!-- ★ 主证：小便不利 + 渴欲饮水 + 发热 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#XiaoBianBuLi"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#KeYuYin"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#FaRe"/>
        <!-- ★ 或然症：心烦、不得眠 -->
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#XinFan"/>
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#BuDeMian"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Fu"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#RedTongue"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#ZhuLingTang"/>
    </tcm:DiseasePattern>

    <!-- 十枣汤证 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#ShiZaoTangZheng">
        <rdfs:label xml:lang="zh">十枣汤证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【辨太阳病脉证并治下·第152条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">太阳中风，下利呕逆，表解者，乃可攻之。其人漐漐汗出，发作有时，头痛，心下痞硬满，引胁下痛，干呕短气，汗出不恶寒者，此表解里未和也，十枣汤主之。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">悬饮重证。核心为心下痞硬满、引胁下痛、干呕短气。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Taiyin"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <bz:has_concomitant rdf:resource="http://www.tcm-classics.org/jianjia#WaterRetention_Instance"/>
        <!-- ★ 主证：心下痞硬满 + 引胁下痛 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#XinXiaPi"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#FuMan"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#XieTong"/>
        <!-- ★ 或然症：干呕、短气、汗出 -->
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#GanOu"/>
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#DuanQi"/>
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#HanChu"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#SlipperyTongue"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#WhiteCoating"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#ShiZaoTang"/>
    </tcm:DiseasePattern>

    <!-- 抵当汤证 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#DiDangTangZheng">
        <rdfs:label xml:lang="zh">抵当汤证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【辨太阳病脉证并治中·第124条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">太阳病六七日，表证仍在，脉微而沉，反不结胸，其人发狂者，以热在下焦，少腹当硬满，小便自利者，下血乃愈……抵当汤主之。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">蓄血重证。核心为发狂、少腹硬满、小便自利。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Taiyang"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <bz:has_concomitant rdf:resource="http://www.tcm-classics.org/jianjia#BloodStasis_Instance"/>
        <!-- ★ 主证：少腹硬满 + 小便自利 + 发狂 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ShaoFuYingMan"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#XiaoBianZiLi"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#RuKuang"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Chen"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#PurpleTongue"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#DiDangTang"/>
    </tcm:DiseasePattern>

    <!-- 瓜蒂散证 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#GuaDiSanZheng">
        <rdfs:label xml:lang="zh">瓜蒂散证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【辨太阳病脉证并治下·第166条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">病如桂枝证，头不痛，项不强，寸脉微浮，胸中痞硬，气上冲喉咽，不得息者，此为胸有寒也，当吐之，宜瓜蒂散。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">胸中痰涎宿食阻滞证。核心为胸中痞硬、气上冲喉咽、不得息。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Taiyang"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <!-- ★ 主证：胸中痞硬 + 气上冲喉咽 + 不得息 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#XinXiaPi"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ShangQi"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Fu"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#SlipperyTongue"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#GuaDiSan"/>
    </tcm:DiseasePattern>

    <!-- 四逆散证 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#SiNiSanZheng">
        <rdfs:label xml:lang="zh">四逆散证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【辨少阴病脉证并治·第318条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">少阴病，四逆，其人或咳，或悸，或小便不利，或腹中痛，或泄利下重者，四逆散主之。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">阳郁不伸、气机阻滞证。核心为四逆（非寒厥）。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Shaoyang"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#BanBiaoBanLi"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Yang"/>
        <!-- ★ 主证：四逆 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#SiZhiJueNi"/>
        <!-- ★ 或然症：原文所有“或”字症状 -->
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#Ke"/>
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#XinJi"/>
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#XiaoBianBuLi"/>
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#FuTong"/>
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#XiaLi"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#WhiteCoating"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#SiNiSan"/>
    </tcm:DiseasePattern>

    <!-- 柴胡桂枝干姜汤证 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#ChaiHuGuiZhiGanJiangTangZheng">
        <rdfs:label xml:lang="zh">柴胡桂枝干姜汤证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【辨太阳病脉证并治下·第147条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">伤寒五六日，已发汗而复下之，胸胁满微结，小便不利，渴而不呕，但头汗出，往来寒热，心烦者，此为未解也，柴胡桂枝干姜汤主之。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">少阳太阴合病。核心为胸胁满微结、往来寒热、渴。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Shaoyang"/>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Taiyin"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#BanBiaoBanLi"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <bz:has_concomitant rdf:resource="http://www.tcm-classics.org/jianjia#WaterRetention_Instance"/>
        <!-- ★ 主证：胸胁满微结 + 往来寒热 + 渴 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#XiongXieKuMan"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#WangLaiHanRe"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#Ke"/>
        <!-- ★ 或然症：小便不利、心烦、但头汗出 -->
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#XiaoBianBuLi"/>
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#XinFan"/>
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#TouHan"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#WhiteCoating"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#ChaiHuGuiZhiGanJiangTang"/>
    </tcm:DiseasePattern>

    <!-- 干姜黄芩黄连人参汤证 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#GanJiangHuangQinHuangLianRenShenTangZheng">
        <rdfs:label xml:lang="zh">干姜黄芩黄连人参汤证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【辨厥阴病脉证并治·第359条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">伤寒本自寒下，医复吐下之，寒格更逆吐下，若食入口即吐，干姜黄芩黄连人参汤主之。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">上热下寒格拒证。核心为食入口即吐。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Jueyin"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <!-- ★ 主证：食入口即吐 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#Tu"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#PaleWhiteTongue"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#YellowCoating"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#GanJiangHuangQinHuangLianRenShenTang"/>
    </tcm:DiseasePattern>

    <!-- 桂枝芍药知母汤证 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#GuiZhiShaoYaoZhiMuTangZheng">
        <rdfs:label xml:lang="zh">桂枝芍药知母汤证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【金匮·中风历节病脉证并治·第8条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">诸肢节疼痛，身体尪羸，脚肿如脱，头眩短气，温温欲吐，桂枝芍药知母汤主之。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">风湿历节证。核心为肢节疼痛、身体尪羸、脚肿。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Jueyin"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Biao"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <!-- ★ 主证：肢节疼痛 + 身体尪羸 + 脚肿如脱 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ShenTiTong"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#WangLei"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#JiaoZhong"/>
        <!-- ★ 或然症：头眩、短气、欲吐 -->
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#MuXuan"/>
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#DuanQi"/>
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#YuTu"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#PaleWhiteTongue"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#GuiZhiShaoYaoZhiMuTang"/>
    </tcm:DiseasePattern>

    <!-- 百合地黄汤证 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#BaiHeDiHuangTangZheng">
        <rdfs:label xml:lang="zh">百合地黄汤证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【金匮·百合狐惑阴阳毒病脉证并治·第5条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">百合病，不经吐、下、发汗，病形如初者，百合地黄汤主之。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">心肺阴虚内热证。核心为百合病（神志恍惚、口苦、小便赤）。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Shaoyin"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <!-- ★ 主证：口苦 + 小便赤（百合病核心） -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#KouKu"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#XiaoBianChi"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Wei"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Shu"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#RedTongue"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#BaiHeDiHuangTang"/>
    </tcm:DiseasePattern>

    <!-- 黄土汤证 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#HuangTuTangZheng">
        <rdfs:label xml:lang="zh">黄土汤证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【金匮·惊悸吐衄下血胸满瘀血病脉证并治·第15条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">下血，先便后血，此远血也，黄土汤主之。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">脾阳虚寒便血证。核心为先便后血。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Taiyin"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <!-- ★ 主证：先便后血 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#BianXue"/>
        <!-- ★ 或然症：手足厥冷 -->
        <bz:has_or_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ShouZuJueLeng"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Chen"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Chi"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#PaleWhiteTongue"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#HuangTuTang"/>
    </tcm:DiseasePattern>

    <!-- 赤小豆当归散证 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#ChiXiaoDouDangGuiSanZheng">
        <rdfs:label xml:lang="zh">赤小豆当归散证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【金匮·惊悸吐衄下血胸满瘀血病脉证并治·第16条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">下血，先血后便，此近血也，赤小豆当归散主之。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">湿热便血证。核心为先血后便。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Yangming"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <!-- ★ 主证：先血后便 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#BianXue"/>
        <tcm:has_pulse rdf:resource="http://www.tcm-classics.org/maixiang#Pulse_Shu"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#RedTongue"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#YellowCoating"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#ChiXiaoDouDangGuiSan"/>
    </tcm:DiseasePattern>

    <!-- 半夏厚朴汤证 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#BanXiaHouPoTangZheng">
        <rdfs:label xml:lang="zh">半夏厚朴汤证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【金匮·妇人杂病脉证并治·第5条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">妇人咽中如有炙脔，半夏厚朴汤主之。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">痰气交阻咽喉证（梅核气）。核心为咽中异物感。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Taiyin"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <bz:has_concomitant rdf:resource="http://www.tcm-classics.org/jianjia#WaterRetention_Instance"/>
        <!-- ★ 主证：咽中异物感 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#YanZhongYiWu"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#WhiteCoating"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#SlipperyTongue"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#BanXiaHouPoTang"/>
    </tcm:DiseasePattern>

    <!-- 旋覆代赭汤证 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#XuanFuDaiZheTangZheng">
        <rdfs:label xml:lang="zh">旋覆代赭汤证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【辨太阳病脉证并治下·第161条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">伤寒发汗，若吐若下，解后，心下痞硬，噫气不除者，旋覆代赭汤主之。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">胃虚痰阻气逆证。核心为心下痞硬、噫气不除。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Taiyin"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Xu"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <!-- ★ 主证：心下痞硬 + 噫气不除 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#XinXiaPi"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#YiQi"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#WhiteCoating"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#SlipperyTongue"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#XuanFuDaiZheTang"/>
    </tcm:DiseasePattern>

    <!-- 奔豚汤证 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#BenTunTangZheng">
        <rdfs:label xml:lang="zh">奔豚汤证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【金匮·奔豚气病脉证并治·第2条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">奔豚气上冲胸，腹痛，往来寒热，奔豚汤主之。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">肝气上冲之热性奔豚。核心为气上冲胸、腹痛、往来寒热。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Shaoyang"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#BanBiaoBanLi"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Yang"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Re"/>
        <!-- ★ 主证：气上冲胸 + 腹痛 + 往来寒热 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ShangQi"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#FuTong"/>
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#WangLaiHanRe"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#RedTongue"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#BenTunTang"/>
    </tcm:DiseasePattern>

    <!-- 桂枝加桂汤证 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#GuiZhiJiaGuiTangZheng">
        <rdfs:label xml:lang="zh">桂枝加桂汤证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【辨太阳病脉证并治下·第117条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">烧针令其汗，针处被寒，核起而赤者，必发奔豚。气从少腹上冲心者，灸其核上各一壮，与桂枝加桂汤，更加桂二两也。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">寒性奔豚。核心为气从少腹上冲心。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Taiyang"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Biao"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Yang"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <!-- ★ 主证：气从少腹上冲心 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#ShangQi"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#WhiteCoating"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#GuiZhiJiaGuiTang"/>
    </tcm:DiseasePattern>

    <!-- 头风摩散证 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#TouFengMoSanZheng">
        <rdfs:label xml:lang="zh">头风摩散证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【金匮·中风历节病脉证并治·附方】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">头风摩散方：大附子一枚（炮），盐等分。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">头风头痛外用摩散方。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Taiyang"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Biao"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Han"/>
        <!-- ★ 主证：头痛（外治） -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#TouTong"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#WhiteCoating"/>
        <fj:indicated_for rdf:resource="http://www.tcm-classics.org/fangji#TouFengMoSan"/>
    </tcm:DiseasePattern>

    <!-- 下瘀血汤证 -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#XiaYuXueTangZheng">
        <rdfs:label xml:lang="zh">下瘀血汤证</rdfs:label>
        <tcm:clause_number xml:lang="zh">【金匮·妇人产后病脉证并治·第6条】</tcm:clause_number>
        <bz:originalDescription xml:lang="zh">师曰：产妇腹痛，法当以枳实芍药散，假令不愈者，此为腹中有干血着脐下，宜下瘀血汤主之。</bz:originalDescription>
        <bz:huxishuExplanation xml:lang="zh">干血着脐下证。核心为产妇腹痛、瘀块。</bz:huxishuExplanation>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">prescribable</bz:patternRole>
        <bz:belongs_to_liujing rdf:resource="http://www.tcm-classics.org/liujing#Taiyang"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Li"/>
        <tcm:has_bagang_element rdf:resource="http://www.tcm-classics.org/bagang#Shi"/>
        <bz:has_concomitant rdf:resource="http://www.tcm-classics.org/jianjia#BloodStasis_Instance"/>
        <!-- ★ 主证：产后腹痛 -->
        <tcm:has_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#FuTong"/>
        <bz:has_typical_tongue rdf:resource="http://www.tcm-classics.org/shexiang#PurpleTongue"/>
    </tcm:DiseasePattern>

    <!-- ================================================================ -->
    <!-- 类别占位个体                                                     -->
    <!-- ================================================================ -->
    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#FuRenChanHouBing">
        <rdfs:label xml:lang="zh">妇人产后病</rdfs:label>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">placeholder</bz:patternRole>
    </tcm:DiseasePattern>

    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#BenTunQiBing">
        <rdfs:label xml:lang="zh">奔豚气病</rdfs:label>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">placeholder</bz:patternRole>
    </tcm:DiseasePattern>

    <tcm:DiseasePattern rdf:about="http://www.tcm-classics.org/bingzheng#FuRenZaBing">
        <rdfs:label xml:lang="zh">妇人杂病</rdfs:label>
        <bz:patternRole rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">placeholder</bz:patternRole>
    </tcm:DiseasePattern>

    <!-- ================================================================ -->
    <!-- 加减规则具名个体库                                               -->
    <!-- ================================================================ -->
    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/bingzheng#ModRule_XiaoChaiHu_KouKe">
        <rdf:type rdf:resource="http://www.tcm-classics.org/bingzheng#ModificationRule"/>
        <bz:trigger_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#Ke"/>
        <bz:action_description xml:lang="zh">去半夏，加人参、瓜蒌根</bz:action_description>
        <rdfs:comment xml:lang="zh">【第96条】"若渴，去半夏，加人参合前成四两半，瓜蒌根四两。"</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/bingzheng#ModRule_XiaoChaiHu_XinJiXiaoBianBuLi">
        <rdf:type rdf:resource="http://www.tcm-classics.org/bingzheng#ModificationRule"/>
        <bz:trigger_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#XinJi"/>
        <bz:trigger_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#XiaoBianBuLi"/>
        <bz:action_description xml:lang="zh">去黄芩，加茯苓</bz:action_description>
        <rdfs:comment xml:lang="zh">【第96条】"若心下悸，小便不利者，去黄芩，加茯苓四两。"</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/bingzheng#ModRule_XiaoQingLong_FanZao">
        <rdf:type rdf:resource="http://www.tcm-classics.org/bingzheng#ModificationRule"/>
        <bz:trigger_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#FanZao"/>
        <bz:action_description xml:lang="zh">加石膏</bz:action_description>
        <rdfs:comment xml:lang="zh">【第40条方后注】胡老补充："烦躁者，加石膏。"</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/bingzheng#ModRule_XiaoQingLong_Ke">
        <rdf:type rdf:resource="http://www.tcm-classics.org/bingzheng#ModificationRule"/>
        <bz:trigger_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#Ke"/>
        <bz:action_description xml:lang="zh">去半夏，加瓜蒌根</bz:action_description>
        <rdfs:comment xml:lang="zh">【第40条方后注】"若渴，去半夏，加栝楼根三两。"</rdfs:comment>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.tcm-classics.org/bingzheng#ModRule_GuiZhi_Chuan">
        <rdf:type rdf:resource="http://www.tcm-classics.org/bingzheng#ModificationRule"/>
        <bz:trigger_symptom rdf:resource="http://www.tcm-classics.org/zhengzhuangtizheng#Chuan"/>
        <bz:action_description xml:lang="zh">加厚朴、杏子</bz:action_description>
        <rdfs:comment xml:lang="zh">【第18条】"喘家作桂枝汤，加厚朴杏子佳。"</rdfs:comment>
    </owl:NamedIndividual>

</rdf:RDF>