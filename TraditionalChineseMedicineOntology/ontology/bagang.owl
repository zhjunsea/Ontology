        <rdfs:label xml:lang="zh">半表半里＋阴→厥阴</rdfs:label>
        <rdfs:comment xml:lang="zh">病位在半表半里、正气已虚（阴）→厥阴病。详见liujing本体lj:Jueyin_Instance。</rdfs:comment>
    </owl:NamedIndividual>

</rdf:RDF>