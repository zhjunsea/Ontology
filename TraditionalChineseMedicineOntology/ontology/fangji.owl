<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns="http://www.tcm-classics.org/fangji#"
     xml:base="http://www.tcm-classics.org/fangji"
     xmlns:fj="http://www.tcm-classics.org/fangji#"
     xmlns:tcm="http://www.tcm-classics.org/tcm#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:dc="http://purl.org/dc/elements/1.1/">

    <owl:Ontology rdf:about="http://www.tcm-classics.org/fangji">
        <dc:title xml:lang="zh">伤寒杂病论方剂本体·TBox（术语层）</dc:title>
        <dc:description xml:lang="zh">仅含方剂相关的类定义、数据属性、对象属性（复用TCM）和注释属性。不含任何方剂个体实例。ABox数据存于tcmdb.formula等关系表中。</dc:description>
        <owl:versionInfo>3.0-TBox-Reuse</owl:versionInfo>
        <owl:imports rdf:resource="http://www.tcm-classics.org/tcm"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/skos/fangji"/>
    </owl:Ontology>

    <!-- ==================== 类定义（全部复用 TCM） ==================== -->
    <!-- 
        本模块不再定义 Formula、FormulaCategory、Herb 类，
        完全使用 tcm:Formula、tcm:FormulaCategory、tcm:Herb。
        如需扩展子类，可在此添加，但默认直接使用父类。
    -->

    <!-- ==================== 数据属性（方剂特有） ==================== -->
    <owl:DatatypeProperty rdf:about="http://www.tcm-classics.org/fangji#original_dosage">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#Formula"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:label xml:lang="zh">原方剂量</rdfs:label>
        <rdfs:comment xml:lang="zh">桂林古本所载原方药物剂量原文，含炮制与单位。对应数据库表 tcmdb.formula.original_dosage。</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.tcm-classics.org/fangji#decoction_method">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#Formula"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:label xml:lang="zh">煎煮法</rdfs:label>
        <rdfs:comment xml:lang="zh">桂林古本方后注所载煎煮服用方法原文。对应 tcmdb.formula.decoction_method。</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.tcm-classics.org/fangji#source_clause">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#Formula"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:label xml:lang="zh">出处条文</rdfs:label>
        <rdfs:comment xml:lang="zh">桂林古本中该方的原始条文编号与内容摘要。对应 tcmdb.formula.source_clause。</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- ==================== 注释属性（方剂特有） ==================== -->
    <owl:AnnotationProperty rdf:about="http://www.tcm-classics.org/fangji#huxishu_note">
        <rdfs:label xml:lang="zh">胡老按语</rdfs:label>
        <rdfs:comment xml:lang="zh">胡希恕先生著作中对该方的专门论述摘录。对应 tcmdb.formula.huxishu_note。</rdfs:comment>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="http://www.tcm-classics.org/fangji#clinical_key_points">
        <rdfs:label xml:lang="zh">临床眼目</rdfs:label>
        <rdfs:comment xml:lang="zh">胡老提炼的该方辨证关键点。对应 tcmdb.formula.clinical_key_points。</rdfs:comment>
    </owl:AnnotationProperty>

    <!-- ==================== 对象属性（全部复用 TCM，不再重复定义） ==================== -->
    <!-- 
        以下属性已在 TCM.owl 中定义，本模块直接使用，无需再次声明：
        - tcm:indicated_for          （主治病证）
        - tcm:composed_of            （组成药物）
        - tcm:belongs_to_formula_category （归属类别）
        - tcm:contraindicated_for    （禁忌证候）
        - tcm:derived_from           （衍化自）
        - tcm:formula_matches_bagang （方证八纲对应）
        本模块不再重复定义，以确保语义一致性。
    -->

</rdf:RDF>