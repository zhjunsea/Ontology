ys:MengChong
    a skos:Concept ;
    skos:prefLabel "虻虫"@zh ;
    skos:altLabel "牛虻"@zh, "蜚虻"@zh ;
    skos:definition "虻科昆虫复带虻或其他同属昆虫的雌性全体。破血逐瘀。"@zh ;
    skos:inScheme ys:Scheme ;
    skos:broader ys:HerbRoot ;
    skos:exactMatch yw:MengChong .

ys:MuDanPi
    a skos:Concept ;
