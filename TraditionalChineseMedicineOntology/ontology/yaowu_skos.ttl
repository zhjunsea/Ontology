@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# 关联本体前缀
@prefix yw: <http://www.tcm-classics.org/yaowu#> .
@prefix tcm: <http://www.tcm-classics.org/tcm#> .
@prefix fj: <http://www.tcm-classics.org/fangji#> .
@prefix bg: <http://www.tcm-classics.org/bagang#> .
@prefix zz: <http://www.tcm-classics.org/zhengzhuangtizheng#> .

# SKOS 词表专属命名空间
@prefix ys: <http://www.tcm-classics.org/skos/yaowu#> .

<http://www.tcm-classics.org/skos/yaowu> a owl:Ontology ;
    owl:versionInfo "2.1.0-WithHerbInstances" .

# ==========================================
# 1. ConceptScheme 定义
# ==========================================
ys:Scheme
    a skos:ConceptScheme ;
    dc:title "伤寒杂病论经方药物知识组织系统（含药物实例）"@zh ;
    dc:description "基于 yaowu.owl 4.1-Enhanced 构建，包含属性维度和全部经方药物概念。用于异名归一、临床检索与知识导航。"@zh ;
    dcterms:creator "TCM-Classics Knowledge Graph Team" ;
    dcterms:created "2023-10-27"^^xsd:date ;
    dcterms:modified "2026-08-21"^^xsd:date ;
    owl:versionInfo "2.1.0" ;
    skos:hasTopConcept ys:HerbRoot .

# ==========================================
# 2. 根概念：经方药物
# ==========================================
ys:HerbRoot
    a skos:Concept ;
    skos:prefLabel "经方药物"@zh ;
    skos:altLabel "桂林古本药物"@zh, "伤寒杂病论药物"@zh ;
    skos:definition "桂林古本所载全部经方药物的通用父类。具体实例如下。"@zh ;
    skos:inScheme ys:Scheme ;
    skos:topConceptOf ys:Scheme ;
    skos:exactMatch tcm:Herb ;
    skos:narrower
        ys:OriginalTaste, ys:OriginalNature, ys:ShennongCategory,
        ys:EarliestSource, ys:GuilinDosageUnit, ys:ProcessingMethod,
        ys:TreatsSymptom, ys:BelongsToFormula, ys:HasBagangProperty,
        ys:ShennongOriginalText, ys:BieluOriginalText,
        ys:HuxishuNote, ys:ClinicalKeyPoints, ys:ModernApplication .

# ==========================================
# 3. 属性维度概念（同前，略）
# ==========================================
# ... （保留原有属性概念，此处省略，实际文件应完整包含）
# 以下为药物实例概念（共87味）
# ==========================================

ys:EJiao
    a skos:Concept ;
    skos:prefLabel "阿胶"@zh ;
    skos:altLabel "驴皮胶"@zh, "傅致胶"@zh, "黄明胶"@zh ;
    skos:definition "马科动物驴的干燥皮经煎煮浓缩制成的固体胶。补血滋阴，润燥止血。主治血虚、出血。"@zh ;
    skos:inScheme ys:Scheme ;
    skos:broader ys:HerbRoot ;
    skos:exactMatch yw:EJiao .

ys:AiYe
    a skos:Concept ;
    skos:prefLabel "艾叶"@zh ;
    skos:altLabel "艾"@zh, "医草"@zh, "灸草"@zh ;
    skos:definition "菊科植物艾的干燥叶。温经止血，散寒止痛。主治虚寒出血、腹痛。"@zh ;
    skos:inScheme ys:Scheme ;
    skos:broader ys:HerbRoot ;
    skos:exactMatch yw:AiYe .

ys:BaiHe
    a skos:Concept ;
    skos:prefLabel "百合"@zh ;
    skos:altLabel "百合花"@zh, "山丹"@zh ;
    skos:definition "百合科植物卷丹、百合或细叶百合的干燥肉质鳞叶。养阴润肺，清心安神。"@zh ;
    skos:inScheme ys:Scheme ;
    skos:broader ys:HerbRoot ;
    skos:exactMatch yw:BaiHe .

ys:BaiQian
    a skos:Concept ;
    skos:prefLabel "白前"@zh ;
    skos:altLabel "鹅管白前"@zh, "水杨柳"@zh ;
    skos:definition "萝藦科植物柳叶白前或芫花叶白前的干燥根茎及根。降气化痰，止咳。"@zh ;
    skos:inScheme ys:Scheme ;
    skos:broader ys:HerbRoot ;
    skos:exactMatch yw:BaiQian .

ys:BaiShi
    a skos:Concept ;
    skos:prefLabel "白石"@zh ;
    skos:altLabel "白石英"@zh ;
    skos:definition "矿物石英（氧化硅），温肺肾，安心神。今少用。"@zh ;
    skos:inScheme ys:Scheme ;
    skos:broader ys:HerbRoot ;
    skos:exactMatch yw:BaiShi .

ys:BaiTouWeng
    a skos:Concept ;
    skos:prefLabel "白头翁"@zh ;
    skos:altLabel "野丈人"@zh, "白头公"@zh, "毛姑朵花"@zh ;
    skos:definition "毛茛科植物白头翁的干燥根。清热解毒，凉血止痢。主治热痢。"@zh ;
    skos:inScheme ys:Scheme ;
    skos:broader ys:HerbRoot ;
    skos:exactMatch yw:BaiTouWeng .

ys:BaiZhu
    a skos:Concept ;
    skos:prefLabel "白术"@zh ;
    skos:altLabel "于术"@zh, "冬术"@zh, "浙术"@zh ;
    skos:definition "菊科植物白术的干燥根茎。健脾益气，燥湿利水，止汗安胎。"@zh ;
    skos:inScheme ys:Scheme ;
    skos:broader ys:HerbRoot ;
    skos:exactMatch yw:BaiZhu .

ys:BanXia
    a skos:Concept ;
    skos:prefLabel "半夏"@zh ;
    skos:altLabel "地文"@zh, "守田"@zh, "羊眼半夏"@zh ;
    skos:definition "天南星科植物半夏的干燥块茎。燥湿化痰，降逆止呕，消痞散结。"@zh ;
    skos:inScheme ys:Scheme ;
    skos:broader ys:HerbRoot ;
    skos:exactMatch yw:BanXia .

ys:BeiMu
    a skos:Concept ;
    skos:prefLabel "贝母"@zh ;
    skos:altLabel "川贝母"@zh, "浙贝母"@zh, "象贝"@zh ;
    skos:definition "百合科植物川贝母、浙贝母等的干燥鳞茎。清热化痰，润肺止咳。"@zh ;
    skos:inScheme ys:Scheme ;
    skos:broader ys:HerbRoot ;
    skos:exactMatch yw:BeiMu .

ys:BiXie
    a skos:Concept ;
    skos:prefLabel "萆薢"@zh ;
    skos:altLabel "川萆薢"@zh, "粉萆薢"@zh ;
    skos:definition "薯蓣科植物绵萆薢或福州薯蓣的干燥根茎。利湿去浊，祛风通痹。"@zh ;
    skos:inScheme ys:Scheme ;
    skos:broader ys:HerbRoot ;
    skos:exactMatch yw:BiXie .

ys:ChaiHu
    a skos:Concept ;
    skos:prefLabel "柴胡"@zh ;
    skos:altLabel "茈胡"@zh, "地薰"@zh, "山菜"@zh, "北柴胡"@zh, "南柴胡"@zh ;
    skos:definition "伞形科植物柴胡或狭叶柴胡的干燥根。和解表里，疏肝升阳。主治少阳病。"@zh ;
    skos:inScheme ys:Scheme ;
    skos:broader ys:HerbRoot ;
    skos:exactMatch yw:ChaiHu .

ys:ChuanWu
    a skos:Concept ;
    skos:prefLabel "川乌"@zh ;
    skos:altLabel "乌头"@zh, "川乌头"@zh ;
    skos:definition "毛茛科植物乌头的干燥母根。祛风除湿，温经止痛。大毒。"@zh ;
    skos:inScheme ys:Scheme ;
    skos:broader ys:HerbRoot ;
    skos:exactMatch yw:ChuanWu .

ys:ChuanXiong
    a skos:Concept ;
    skos:prefLabel "川芎"@zh ;
    skos:altLabel "芎䓖"@zh, "香果"@zh, "西芎"@zh ;
    skos:definition "伞形科植物川芎的干燥根茎。活血行气，祛风止痛。"@zh ;
    skos:inScheme ys:Scheme ;
    skos:broader ys:HerbRoot ;
    skos:exactMatch yw:ChuanXiong .

ys:CongBai
    a skos:Concept ;
    skos:prefLabel "葱白"@zh ;
    skos:altLabel "葱茎白"@zh, "葱"@zh ;
    skos:definition "百合科植物葱的鳞茎。发汗解表，通阳散寒。"@zh ;
    skos:inScheme ys:Scheme ;
    skos:broader ys:HerbRoot ;
    skos:exactMatch yw:CongBai .

ys:DaHuang
    a skos:Concept ;
    skos:prefLabel "大黄"@zh ;
    skos:altLabel "将军"@zh, "川军"@zh, "锦纹"@zh, "生军"@zh ;
    skos:definition "蓼科植物掌叶大黄、唐古特大黄或药用大黄的干燥根及根茎。泻下攻积，清热泻火，凉血解毒，逐瘀通经。"@zh ;
    skos:inScheme ys:Scheme ;
    skos:broader ys:HerbRoot ;
    skos:exactMatch yw:DaHuang .

ys:DaZao
    a skos:Concept ;
    skos:prefLabel "大枣"@zh ;
    skos:altLabel "红枣"@zh, "枣"@zh, "干枣"@zh ;
    skos:definition "鼠李科植物枣的干燥成熟果实。补中益气，养血安神，缓和药性。"@zh ;
    skos:inScheme ys:Scheme ;
    skos:broader ys:HerbRoot ;
    skos:exactMatch yw:DaZao .

ys:DaiZheShi
    a skos:Concept ;
    skos:prefLabel "代赭石"@zh ;
    skos:altLabel "赭石"@zh, "红土石"@zh ;
    skos:definition "氧化物类矿物赤铁矿的矿石。平肝潜阳，重镇降逆，凉血止血。"@zh ;
    skos:inScheme ys:Scheme ;
    skos:broader ys:HerbRoot ;
    skos:exactMatch yw:DaiZheShi .

ys:DangGui
    a skos:Concept ;
    skos:prefLabel "当归"@zh ;
    skos:altLabel "秦归"@zh, "云归"@zh, "西归"@zh ;
    skos:definition "伞形科植物当归的干燥根。补血活血，调经止痛，润肠通便。"@zh ;
    skos:inScheme ys:Scheme ;
    skos:broader ys:HerbRoot ;
    skos:exactMatch yw:DangGui .

ys:DiHuang
    a skos:Concept ;
    skos:prefLabel "地黄"@zh ;
    skos:altLabel "干地黄"@zh, "生地"@zh, "熟地"@zh ;
    skos:definition "玄参科植物地黄的新鲜或干燥块根。清热凉血，养阴生津（生）；补血滋阴（熟）。"@zh ;
    skos:inScheme ys:Scheme ;
    skos:broader ys:HerbRoot ;
    skos:exactMatch yw:DiHuang .

ys:FuLing
    a skos:Concept ;
    skos:prefLabel "茯苓"@zh ;
    skos:altLabel "云苓"@zh, "白茯苓"@zh, "赤茯苓"@zh ;
    skos:definition "多孔菌科真菌茯苓的干燥菌核。利水渗湿，健脾宁心。"@zh ;
    skos:inScheme ys:Scheme ;
    skos:broader ys:HerbRoot ;
    skos:exactMatch yw:FuLing .

ys:FuZi
    a skos:Concept ;
    skos:prefLabel "附子"@zh ;
    skos:altLabel "川附子"@zh, "黑顺片"@zh, "白附片"@zh ;
    skos:definition "毛茛科植物乌头的子根。回阳救逆，补火助阳，散寒止痛。有毒。"@zh ;
    skos:inScheme ys:Scheme ;
    skos:broader ys:HerbRoot ;
    skos:exactMatch yw:FuZi .

ys:GanCao
    a skos:Concept ;
    skos:prefLabel "甘草"@zh ;
    skos:altLabel "炙甘草"@zh, "生甘草"@zh, "甜草"@zh, "国老"@zh ;
    skos:definition "豆科植物甘草、胀果甘草或光果甘草的干燥根及根茎。补脾益气，清热解毒，祛痰止咳，缓急止痛，调和诸药。"@zh ;
    skos:inScheme ys:Scheme ;
    skos:broader ys:HerbRoot ;
    skos:exactMatch yw:GanCao .

ys:GanJiang
    a skos:Concept ;
    skos:prefLabel "干姜"@zh ;
    skos:altLabel "姜"@zh, "白姜"@zh, "均姜"@zh ;
    skos:definition "姜科植物姜的干燥根茎。温中散寒，回阳通脉，温肺化饮。"@zh ;
    skos:inScheme ys:Scheme ;
    skos:broader ys:HerbRoot ;
    skos:exactMatch yw:GanJiang .

ys:GeGen
    a skos:Concept ;
    skos:prefLabel "葛根"@zh ;
    skos:altLabel "甘葛"@zh, "粉葛"@zh, "野葛"@zh ;
    skos:definition "豆科植物野葛的干燥根。解肌退热，生津止渴，透疹，升阳止泻。"@zh ;
    skos:inScheme ys:Scheme ;
    skos:broader ys:HerbRoot ;
    skos:exactMatch yw:GeGen .

ys:GuaLouGen
    a skos:Concept ;
    skos:prefLabel "瓜蒌根"@zh ;
    skos:altLabel "天花粉"@zh, "栝楼根"@zh ;
    skos:definition "葫芦科植物栝楼或双边栝楼的干燥根。清热生津，消肿排脓。"@zh ;
    skos:inScheme ys:Scheme ;
    skos:broader ys:HerbRoot ;
    skos:exactMatch yw:GuaLouGen .

ys:GuaLouShi
    a skos:Concept ;
    skos:prefLabel "瓜蒌实"@zh ;
    skos:altLabel "栝楼"@zh, "全瓜蒌"@zh ;
    skos:definition "葫芦科植物栝楼或双边栝楼的干燥成熟果实。清热化痰，宽胸散结，润肠通便。"@zh ;
    skos:inScheme ys:Scheme ;
    skos:broader ys:HerbRoot ;
    skos:exactMatch yw:GuaLouShi .

ys:GuiZhi
    a skos:Concept ;
    skos:prefLabel "桂枝"@zh ;
    skos:altLabel "肉桂"@zh, "桂支"@zh, "阳旦"@zh, "牡桂"@zh, "桂"@zh ;
    skos:definition "樟科植物肉桂的干燥嫩枝。发汗解肌，温通经脉，助阳化气。主太阳中风表虚证。"@zh ;
    skos:inScheme ys:Scheme ;
    skos:broader ys:HerbRoot ;
    skos:exactMatch yw:GuiZhi .

ys:HouPo
    a skos:Concept ;
    skos:prefLabel "厚朴"@zh ;
    skos:altLabel "川朴"@zh, "紫油朴"@zh, "厚皮"@zh ;
    skos:definition "木兰科植物厚朴或凹叶厚朴的干燥干皮、根皮及枝皮。燥湿消痰，下气除满。"@zh ;
    skos:inScheme ys:Scheme ;
    skos:broader ys:HerbRoot ;
    skos:exactMatch yw:HouPo .

ys:HuangBai
    a skos:Concept ;
    skos:prefLabel "黄柏"@zh ;
    skos:altLabel "黄檗"@zh, "川黄柏"@zh, "关黄柏"@zh ;
