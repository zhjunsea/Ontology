    skos:inScheme ys:Scheme ;
    skos:broader ys:HerbRoot ;
    skos:exactMatch yw:HuangBai .

ys:HuangLian
    a skos:Concept ;
    skos:prefLabel "黄连"@zh ;
    skos:altLabel "川连"@zh, "味连"@zh, "雅连"@zh ;
    skos:definition "毛茛科植物黄连、三角叶黄连或云连的干燥根茎。清热燥湿，泻火解毒。"@zh ;
    skos:inScheme ys:Scheme ;
    skos:broader ys:HerbRoot ;
    skos:exactMatch yw:HuangLian .

ys:HuangQin
    a skos:Concept ;
    skos:prefLabel "黄芩"@zh ;
    skos:altLabel "腐肠"@zh, "黄文"@zh, "苦茶"@zh, "条芩"@zh ;
