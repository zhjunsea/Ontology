    skos:broader ys:HerbRoot ;
    skos:exactMatch yw:MaiMenDong .

ys:MangXiao
    a skos:Concept ;
    skos:prefLabel "芒硝"@zh ;
    skos:altLabel "朴硝"@zh, "皮硝"@zh, "玄明粉"@zh ;
    skos:definition "硫酸盐类矿物芒硝经加工精制而成的结晶体。泻下通便，润燥软坚，清热消肿。"@zh ;
    skos:inScheme ys:Scheme ;
    skos:broader ys:HerbRoot ;
