    skos:inScheme ys:Scheme ;
    skos:broader ys:HerbRoot ;
    skos:exactMatch yw:HuangQin .

ys:HuangQi
    a skos:Concept ;
    skos:prefLabel "黄芪"@zh ;
    skos:altLabel "绵黄芪"@zh, "北芪"@zh, "黄耆"@zh ;
