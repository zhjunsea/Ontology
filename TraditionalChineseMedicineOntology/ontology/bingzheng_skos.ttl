@prefix : <http://www.tcm-classics.org/skos/bingzheng#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .

<http://www.tcm-classics.org/skos/bingzheng> a skos:ConceptScheme ;
    dc:title "伤寒杂病论病证SKOS词汇表·完整版" ;
    dc:description "覆盖六经主要病证及金匮杂病核心病证的标准化术语体系。" ;
    dc:creator "张仲景, 胡希恕" .

# === 太阳病 ===
:TaiYangBingGangZheng a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/bingzheng> ;
    skos:prefLabel "太阳病提纲证"@zh ;
    skos:definition "外邪侵袭体表，正气抗邪于肌表的证候总纲。脉浮、头项强痛、恶寒。" ;
    skos:altLabel "太阳病"@zh, "表证提纲"@zh ;
    rdfs:comment "【白话】感冒初期怕冷脖子僵脉浮。【常用】太阳病。【简写】太阳提纲。【非专业】着凉伤风。" .

:TaiYangZhongFengZheng a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/bingzheng> ;
    skos:prefLabel "太阳中风证"@zh ;
    skos:definition "太阳表虚证。发热汗出恶风脉缓。桂枝汤证。" ;
    skos:altLabel "桂枝汤证"@zh, "表虚证"@zh, "中风表虚"@zh ;
    rdfs:comment "【白话】出汗怕风的感冒。【常用】太阳中风、桂枝汤证。【简写】中风证。【非专业】出汗感冒、虚人感冒。【注意】非脑卒中。" .

:TaiYangShangHanZheng a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/bingzheng> ;
    skos:prefLabel "太阳伤寒证"@zh ;
    skos:definition "太阳表实证。恶寒体痛无汗脉紧。麻黄汤证。" ;
    skos:altLabel "麻黄汤证"@zh, "表实证"@zh ;
    rdfs:comment "【白话】怕冷身痛不出汗的感冒。【常用】太阳伤寒、麻黄汤证。【简写】伤寒证。【非专业】重度感冒、冻着了。" .

:TaiYangWenBingZheng a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/bingzheng> ;
    skos:prefLabel "太阳温病证"@zh ;
    skos:definition "温邪犯表，热盛伤津。发热口渴不恶寒。" ;
    skos:altLabel "温病初起"@zh, "风温"@zh ;
    rdfs:comment "【白话】发烧口渴不怕冷的热性感冒。【常用】太阳温病。【简写】温病。【非专业】热感冒、病毒性感冒。" .

:DaQingLongTangZheng a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/bingzheng> ;
    skos:prefLabel "大青龙汤证"@zh ;
    skos:definition "外寒内热表实兼烦躁。不汗出而烦躁。" ;
    skos:altLabel "外寒内热证"@zh, "表寒里热证"@zh ;
    rdfs:comment "【白话】怕冷身痛不出汗还烦躁。【常用】大青龙汤证。【简写】大青龙证。【非专业】感冒憋得慌烦躁。" .

:XiaoQingLongTangZheng a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/bingzheng> ;
    skos:prefLabel "小青龙汤证"@zh ;
    skos:definition "外寒内饮。表不解心下有水气，咳喘痰稀白。" ;
    skos:altLabel "外寒内饮证"@zh, "寒饮咳喘证"@zh ;
    rdfs:comment "【白话】感冒咳嗽痰多清稀泡沫。【常用】小青龙汤证。【简写】小青龙证。【非专业】受凉咳喘、寒咳。" .

:WuLingSanZheng a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/bingzheng> ;
    skos:prefLabel "五苓散证"@zh ;
    skos:definition "蓄水证。表邪未解膀胱气化失司。口渴小便不利。" ;
    skos:altLabel "蓄水证"@zh, "膀胱气化不利证"@zh ;
    rdfs:comment "【白话】口渴尿少微热。【常用】五苓散证、蓄水证。【简写】五苓证。【非专业】水肿尿少口渴。" .

:TaoHeChengQiTangZheng a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/bingzheng> ;
    skos:prefLabel "桃核承气汤证"@zh ;
    skos:definition "蓄血轻证。瘀热互结下焦。如狂少腹急结。" ;
    skos:altLabel "蓄血轻证"@zh, "瘀热下焦证"@zh ;
    rdfs:comment "【白话】小腹拘急疼痛精神烦躁如狂。【常用】桃核承气汤证。【简写】桃核证。【非专业】肚子胀痛发狂。" .

# === 阳明病 ===
:YangMingBingGangZheng a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/bingzheng> ;
    skos:prefLabel "阳明病提纲证"@zh ;
    skos:definition "里阳热实证总纲。胃家实。" ;
    skos:altLabel "阳明病"@zh, "胃家实证"@zh ;
    rdfs:comment "【白话】肠胃实热便秘高烧。【常用】阳明病。【简写】阳明提纲。【非专业】实火、肠胃积热。" .

:BaiHuTangZheng a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/bingzheng> ;
    skos:prefLabel "白虎汤证"@zh ;
    skos:definition "阳明经证。大热大汗大渴脉洪大。无形热盛。" ;
    skos:altLabel "阳明经证"@zh, "气分热盛证"@zh ;
    rdfs:comment "【白话】高烧大汗大渴脉大。【常用】白虎汤证。【简写】白虎证。【非专业】高热不退大汗口渴。" .

:DaChengQiTangZheng a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/bingzheng> ;
    skos:prefLabel "大承气汤证"@zh ;
    skos:definition "阳明腑实重证。痞满燥实坚俱全。潮热谵语腹满痛拒按。" ;
    skos:altLabel "阳明腑实重证"@zh, "燥屎内结证"@zh ;
    rdfs:comment "【白话】便秘腹胀痛拒按说胡话下午发热。【常用】大承气汤证。【简写】大承气证。【非专业】严重便秘腹胀发烧说胡话。" .

:XiaoChengQiTangZheng a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/bingzheng> ;
    skos:prefLabel "小承气汤证"@zh ;
    skos:definition "阳明腑实轻证。痞满实而不燥坚。便硬谵语无潮热。" ;
    skos:altLabel "阳明腑实轻证"@zh ;
    rdfs:comment "【白话】便秘腹胀但不至于剧痛。【常用】小承气汤证。【简写】小承气证。【非专业】轻度便秘腹胀。" .

:TiaoWeiChengQiTangZheng a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/bingzheng> ;
    skos:prefLabel "调胃承气汤证"@zh ;
    skos:definition "阳明燥热初结。心烦蒸蒸发热，腹满不甚。" ;
    skos:altLabel "阳明燥热证"@zh, "胃热证"@zh ;
    rdfs:comment "【白话】心烦发热大便干但肚子不太胀。【常用】调胃承气汤证。【简写】调胃证。【非专业】胃热心烦便秘。" .

:ZhuYeShiGaoTangZheng a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/bingzheng> ;
    skos:prefLabel "竹叶石膏汤证"@zh ;
    skos:definition "热病后期余热未清气阴两伤。虚羸少气气逆欲吐。" ;
    skos:altLabel "余热未清气阴两伤证"@zh ;
    rdfs:comment "【白话】大病后虚弱气短恶心低热。【常用】竹叶石膏汤证。【简写】竹叶石膏证。【非专业】病后虚弱恶心。" .

# === 少阳病 ===
:ShaoYangBingGangZheng a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/bingzheng> ;
    skos:prefLabel "少阳病提纲证"@zh ;
    skos:definition "半表半里阳证总纲。口苦咽干目眩。" ;
    skos:altLabel "少阳病"@zh, "半表半里证"@zh ;
    rdfs:comment "【白话】嘴苦嗓子干头晕。【常用】少阳病。【简写】少阳提纲。【非专业】上火头晕口苦。" .

:XiaoChaiHuTangZheng a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/bingzheng> ;
    skos:prefLabel "小柴胡汤证"@zh ;
    skos:definition "少阳本证。往来寒热胸胁苦满默默不欲食心烦喜呕。" ;
    skos:altLabel "少阳本证"@zh, "柴胡证"@zh ;
    rdfs:comment "【白话】忽冷忽热胁胀不想吃饭心烦恶心。【常用】小柴胡汤证、柴胡证。【简写】小柴胡证。【非专业】一阵冷一阵热、肝胆不和。" .

:DaChaiHuTangZheng a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/bingzheng> ;
    skos:prefLabel "大柴胡汤证"@zh ;
    skos:definition "少阳阳明合病。呕不止心下急郁郁微烦。" ;
    skos:altLabel "少阳阳明合病证"@zh ;
    rdfs:comment "【白话】呕吐不止胃脘急痛烦躁便秘。【常用】大柴胡汤证。【简写】大柴胡证。【非专业】胆囊炎胰腺炎急性发作。" .

:ChaiHuGuiZhiTangZheng a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/bingzheng> ;
    skos:prefLabel "柴胡桂枝汤证"@zh ;
    skos:definition "太阳少阳合病。发热微恶寒肢节烦疼微呕心下支结。" ;
    skos:altLabel "太阳少阳合病证"@zh ;
    rdfs:comment "【白话】感冒关节痛伴恶心胁胀。【常用】柴胡桂枝汤证。【简写】柴桂证。【非专业】感冒浑身疼还恶心。" .

# === 太阴病 ===
:TaiYinBingGangZheng a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/bingzheng> ;
    skos:prefLabel "太阴病提纲证"@zh ;
    skos:definition "里阴寒虚证总纲。腹满而吐食不下自利时腹自痛。" ;
    skos:altLabel "太阴病"@zh, "脾虚寒湿证"@zh ;
    rdfs:comment "【白话】肚子胀吐吃不下拉肚子阵痛。【常用】太阴病。【简写】太阴提纲。【非专业】脾胃虚寒拉肚子。" .

:LiZhongTangZheng a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/bingzheng> ;
    skos:prefLabel "理中汤证"@zh ;
    skos:definition "太阴虚寒本证。腹满吐利食不下口不渴。" ;
    skos:altLabel "太阴虚寒证"@zh, "中焦虚寒证"@zh ;
    rdfs:comment "【白话】肚子胀吐泻不想吃东西不怕冷。【常用】理中汤证。【简写】理中证。【非专业】脾胃虚寒消化不良。" .

:SiNiTangZheng_TaiYin a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/bingzheng> ;
    skos:prefLabel "四逆汤证（太阴转少阴）"@zh ;
    skos:definition "太阴虚寒重证波及少阴。自利不渴。" ;
    skos:altLabel "太阴寒利证"@zh ;
    rdfs:comment "【白话】拉肚子不口渴手脚凉。【常用】四逆汤证。【简写】四逆证。【非专业】严重腹泻手脚冰冷。" .

# === 少阴病 ===
:ShaoYinBingGangZheng a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/bingzheng> ;
    skos:prefLabel "少阴病提纲证"@zh ;
    skos:definition "全身虚衰证总纲。脉微细但欲寐。" ;
    skos:altLabel "少阴病"@zh, "心肾阳虚证"@zh ;
    rdfs:comment "【白话】脉极弱精神萎靡嗜睡。【常用】少阴病。【简写】少阴提纲。【非专业】极度虚弱嗜睡。" .

:SiNiTangZheng_ShaoYin a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/bingzheng> ;
    skos:prefLabel "四逆汤证（少阴寒化）"@zh ;
    skos:definition "少阴寒化本证。脉沉微四肢厥逆下利清谷但欲寐。" ;
    skos:altLabel "少阴寒化证"@zh, "回阳救逆证"@zh ;
    rdfs:comment "【白话】手脚冰凉拉稀水样便精神萎靡脉微弱。【常用】四逆汤证。【简写】四逆证。【非专业】休克前期、阳虚欲脱。" .

:TongMaiSiNiTangZheng a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/bingzheng> ;
    skos:prefLabel "通脉四逆汤证"@zh ;
    skos:definition "少阴阴盛格阳证。里寒外热面赤脉微欲绝。" ;
    skos:altLabel "阴盛格阳证"@zh, "真寒假热证"@zh ;
    rdfs:comment "【白话】里面极寒外面假热脸红脉几乎摸不到。【常用】通脉四逆汤证。【简写】通脉四逆证。【非专业】假热真寒、危重阳脱。" .

:HuangLianEJiaoTangZheng a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/bingzheng> ;
    skos:prefLabel "黄连阿胶汤证"@zh ;
    skos:definition "少阴热化证。心中烦不得卧。" ;
    skos:altLabel "少阴热化证"@zh, "阴虚火旺失眠证"@zh ;
    rdfs:comment "【白话】心烦失眠舌红少苔。【常用】黄连阿胶汤证。【简写】连胶证。【非专业】阴虚失眠心烦。" .

:ZhenWuTangZheng a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/bingzheng> ;
    skos:prefLabel "真武汤证"@zh ;
    skos:definition "少阴阳虚水泛证。四肢沉重小便不利下利。" ;
    skos:altLabel "阳虚水泛证"@zh ;
    rdfs:comment "【白话】水肿尿少拉肚子四肢沉重怕冷。【常用】真武汤证。【简写】真武证。【非专业】肾虚水肿。" .

:MaXiFuXinTangZheng a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/bingzheng> ;
    skos:prefLabel "麻黄附子细辛汤证"@zh ;
    skos:definition "少阴兼表证。反发热脉沉。" ;
    skos:altLabel "太少两感证"@zh, "阳虚外感证"@zh ;
    rdfs:comment "【白话】阳虚体质感冒发热脉沉。【常用】麻附辛汤证。【简写】麻附辛证。【非专业】体虚感冒。" .

# === 厥阴病 ===
:JueYinBingGangZheng a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/bingzheng> ;
    skos:prefLabel "厥阴病提纲证"@zh ;
    skos:definition "寒热错杂证总纲。消渴气上撞心心中疼热饥不欲食。" ;
    skos:altLabel "厥阴病"@zh, "寒热错杂证"@zh ;
    rdfs:comment "【白话】又渴又饿不想吃心里灼热气上冲。【常用】厥阴病。【简写】厥阴提纲。【非专业】上热下寒怪病。" .

:WuMeiWanZheng a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/bingzheng> ;
    skos:prefLabel "乌梅丸证"@zh ;
    skos:definition "厥阴寒热错杂本证。蛔厥或久利。时烦时静得食而呕。" ;
    skos:altLabel "蛔厥证"@zh, "寒热错杂久利证"@zh ;
    rdfs:comment "【白话】腹痛时作时止吐蛔虫或长期腹泻寒热夹杂。【常用】乌梅丸证。【简写】乌梅证。【非专业】虫积腹痛、慢性结肠炎寒热夹杂。" .

:DangGuiSiNiTangZheng a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/bingzheng> ;
    skos:prefLabel "当归四逆汤证"@zh ;
    skos:definition "厥阴血虚寒凝证。手足厥寒脉细欲绝。" ;
    skos:altLabel "血虚寒凝证"@zh, "寒凝经脉证"@zh ;
    rdfs:comment "【白话】手脚冰凉脉细弱不是阳虚而是血虚受寒。【常用】当归四逆汤证。【简写】归四逆证。【非专业】手脚冰凉血脉不通。" .

:BaiTouWengTangZheng a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/bingzheng> ;
    skos:prefLabel "白头翁汤证"@zh ;
    skos:definition "厥阴湿热下利证。热利下重脓血便。" ;
    skos:altLabel "湿热痢疾证"@zh, "热毒下利证"@zh ;
    rdfs:comment "【白话】拉肚子脓血便肛门灼热里急后重。【常用】白头翁汤证。【简写】白头翁证。【非专业】细菌性痢疾、急性肠炎。" .

:GanJiangHuangQinHuangLianRenShenTangZheng a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/bingzheng> ;
    skos:prefLabel "干姜黄芩黄连人参汤证"@zh ;
    skos:definition "上热下寒格拒证。食入口即吐。" ;
    skos:altLabel "寒热格拒证"@zh, "上热下寒吐逆证"@zh ;
    rdfs:comment "【白话】吃东西马上就吐上面热下面寒。【常用】干姜芩连参汤证。【简写】姜芩连参证。【非专业】吃什么吐什么寒热不调。" .

# === 金匮杂病 ===
:TanYinKeSouBing_XiaoQingLong a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/bingzheng> ;
    skos:prefLabel "痰饮咳嗽病·小青龙汤证"@zh ;
    skos:definition "支饮重证。咳逆倚息不得卧。" ;
    skos:altLabel "支饮证"@zh, "寒饮射肺证"@zh ;
    rdfs:comment "【白话】咳喘不能平卧痰多泡沫。【常用】小青龙汤证（痰饮）。【简写】支饮证。【非专业】哮喘急性发作、慢阻肺急性加重。" .

:XiongBi_GuaLouXieBaiBaiJiuTang a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/bingzheng> ;
    skos:prefLabel "胸痹病·瓜蒌薤白白酒汤证"@zh ;
    skos:definition "胸痹本证。胸背痛短气喘息息咳唾。" ;
    skos:altLabel "胸痹证"@zh, "胸阳不振痰浊痹阻证"@zh ;
    rdfs:comment "【白话】胸闷胸痛气短咳嗽。【常用】瓜蒌薤白白酒汤证。【简写】胸痹本证。【非专业】冠心病心绞痛。" .

:ShuiQiBing_LingGuiZhuGanTang a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/bingzheng> ;
    skos:prefLabel "水气病·苓桂术甘汤证"@zh ;
    skos:definition "狭义痰饮本证。心下痰饮胸胁支满目眩。" ;
    skos:altLabel "痰饮证"@zh, "脾虚水停证"@zh ;
    rdfs:comment "【白话】胃脘胀满头晕眼花心悸。【常用】苓桂术甘汤证。【简写】苓桂术甘证。【非专业】胃积水头晕。" .

:FuTong_HouPoQiWuTang a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/bingzheng> ;
    skos:prefLabel "腹满寒疝·厚朴七物汤证"@zh ;
    skos:definition "腹满兼表证。腹满发热脉浮数饮食如故。" ;
    skos:altLabel "腹满兼表证"@zh, "表里同病腹满证"@zh ;
    rdfs:comment "【白话】肚子胀还发烧但吃饭正常。【常用】厚朴七物汤证。【简写】厚朴七物证。【非专业】感冒肚子胀。" .

:XueBi_GuiZhiShaoYaoZhiMuTang a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/bingzheng> ;
    skos:prefLabel "血痹虚劳·桂枝芍药知母汤证"@zh ;
    skos:definition "风湿历节证。肢节疼痛身体尪羸脚肿如脱。" ;
    skos:altLabel "风湿历节证"@zh, "寒热错杂痹证"@zh ;
    rdfs:comment "【白话】关节肿痛变形身体消瘦。【常用】桂枝芍药知母汤证。【简写】桂芍知母证。【非专业】类风湿关节炎。" .

:FuRenZhengJia_GuiZhiFuLingWan a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/bingzheng> ;
    skos:prefLabel "妇人妊娠·桂枝茯苓丸证"@zh ;
    skos:definition "瘀血癥积证。漏下不止少腹癥块。" ;
    skos:altLabel "瘀血癥积证"@zh, "胞宫瘀阻证"@zh ;
    rdfs:comment "【白话】阴道出血不止小腹有包块。【常用】桂枝茯苓丸证。【简写】桂茯丸证。【非专业】子宫肌瘤、宫外孕、痛经血块。" .

:BaiHeBing_BaiHeDiHuangTang a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/bingzheng> ;
    skos:prefLabel "百合病·百合地黄汤证"@zh ;
    skos:definition "心肺阴虚内热证。神志恍惚口苦小便赤脉微数。" ;
    skos:altLabel "百合病"@zh, "心肺阴虚证"@zh ;
    rdfs:comment "【白话】精神恍惚不定口苦尿黄。【常用】百合地黄汤证。【简写】百合病。【非专业】神经官能症、焦虑抑郁状态。" .

:SuanZaoRenTangZheng a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/bingzheng> ;
    skos:prefLabel "酸枣仁汤证"@zh ;
    skos:definition "肝血不足虚热扰心证。虚烦不得眠。" ;
    skos:altLabel "虚烦不眠证"@zh, "肝血虚失眠证"@zh ;
    rdfs:comment "【白话】心烦睡不着血虚盗汗。【常用】酸枣仁汤证。【简写】枣仁汤证。【非专业】失眠多梦血虚。" .

:HuangTuTangZheng a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/bingzheng> ;
    skos:prefLabel "黄土汤证"@zh ;
    skos:definition "脾阳虚寒便血证。先便后血远血。" ;
    skos:altLabel "远血证"@zh, "脾虚寒便血证"@zh ;
    rdfs:comment "【白话】先拉大便后出血血色暗手脚凉。【常用】黄土汤证。【简写】黄土汤证。【非专业】消化道出血虚寒型。" .

:ChiXiaoDouDangGuiSanZheng a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/bingzheng> ;
    skos:prefLabel "赤小豆当归散证"@zh ;
    skos:definition "湿热便血证。先血后便近血。" ;
    skos:altLabel "近血证"@zh, "湿热便血证"@zh ;
    rdfs:comment "【白话】先出血后大便血色鲜红肛门热。【常用】赤小豆当归散证。【简写】赤豆当归证。【非专业】痔疮出血、肛裂。" .