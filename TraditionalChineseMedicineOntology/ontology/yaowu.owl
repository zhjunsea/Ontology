<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns="http://www.tcm-classics.org/yaowu#"
     xml:base="http://www.tcm-classics.org/yaowu"
     xmlns:yw="http://www.tcm-classics.org/yaowu#"
     xmlns:tcm="http://www.tcm-classics.org/tcm#"
     xmlns:bg="http://www.tcm-classics.org/bagang#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:dc="http://purl.org/dc/elements/1.1/">

    <owl:Ontology rdf:about="http://www.tcm-classics.org/yaowu">
        <dc:title xml:lang="zh">伤寒杂病论经方药物本体·TBox（术语层）</dc:title>
        <dc:description xml:lang="zh">药物模块，显式声明 yaowu 命名空间下的类与数据/注释属性，并复用 TCM 核心的对象属性。不含任何药物个体实例，ABox 数据存于 tcmdb.herb 等表中。</dc:description>
        <owl:versionInfo>4.0-ExplicitDeclaration</owl:versionInfo>
        <!-- 仅导入核心框架 TCM，避免循环依赖 -->
        <owl:imports rdf:resource="http://www.tcm-classics.org/tcm"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/skos/yaowu"/>
    </owl:Ontology>

    <!-- ==================== 类定义（显式声明 yaowu 命名空间） ==================== -->
    <owl:Class rdf:about="http://www.tcm-classics.org/yaowu#Herb">
        <rdfs:subClassOf rdf:resource="http://www.tcm-classics.org/tcm#Herb"/>
        <rdfs:label xml:lang="zh">经方药物</rdfs:label>
        <rdfs:comment xml:lang="zh">本类继承自 tcm:Herb，作为 yaowu 命名空间的明确锚点。具体药物实例通过 rdf:type 引用此类及 tcm:Herb。</rdfs:comment>
    </owl:Class>

    <!-- ==================== 数据属性（药物特有） ==================== -->
    <owl:DatatypeProperty rdf:about="http://www.tcm-classics.org/yaowu#original_taste">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#Herb"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:label xml:lang="zh">原味</rdfs:label>
        <rdfs:comment xml:lang="zh">《神农本草经》或《名医别录》所载原始药味（如辛、甘、酸等）。对应 tcmdb.herb.original_taste。</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.tcm-classics.org/yaowu#original_nature">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#Herb"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:label xml:lang="zh">原性</rdfs:label>
        <rdfs:comment xml:lang="zh">《神农本草经》或《名医别录》所载原始药性（寒、热、温、凉、平）。对应 tcmdb.herb.original_nature。</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.tcm-classics.org/yaowu#shennong_category">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#Herb"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:label xml:lang="zh">本经品级</rdfs:label>
        <rdfs:comment xml:lang="zh">《神农本草经》三品分类：上品、中品、下品、未载。对应 tcmdb.herb.shennong_category。</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.tcm-classics.org/yaowu#earliest_source">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#Herb"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:label xml:lang="zh">最早出处</rdfs:label>
        <rdfs:comment xml:lang="zh">该药在经方体系中的最早文献出处，取值：ShennongBencaoJing / MingYiBieLu / ShangHanLun。对应 tcmdb.herb.earliest_source。</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.tcm-classics.org/yaowu#guilin_dosage_unit">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#Herb"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:label xml:lang="zh">桂林古本剂量单位</rdfs:label>
        <rdfs:comment xml:lang="zh">桂林古本中该药最常用的度量衡单位（两/钱/分/厘/枚/个/片/升/合/斤/铢/适量）。对应 tcmdb.herb.guilin_dosage_unit。</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.tcm-classics.org/yaowu#processing_method">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#Herb"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:label xml:lang="zh">炮制法</rdfs:label>
        <rdfs:comment xml:lang="zh">桂林古本方后注或药名旁注所载炮制方法原文（如去皮、炙、酒洗等）。对应 tcmdb.herb.processing_method。</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- ==================== 对象属性（全部复用 TCM，本模块不重复定义） ==================== -->
    <!-- 
        以下对象属性已在 TCM.owl 中定义，本模块直接使用（推荐使用 tcm: 前缀）：
        - tcm:herb_treats_symptom      （药物主治症状）
        - tcm:herb_has_bagang_property （药物八纲药性）
        - tcm:herb_belongs_to_formula  （药物归属方剂）
        - tcm:composed_of              （方剂组成，其逆属性已在 TCM 中定义）
        本模块不再重复定义，确保全局语义一致性。
    -->

    <!-- ==================== 对象属性（药物配伍禁忌） ==================== -->

    <!-- 十八反：相反关系（对称） -->
    <owl:SymmetricProperty rdf:about="http://www.tcm-classics.org/yaowu#is_antagonistic_to">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#Herb"/>
        <rdfs:range rdf:resource="http://www.tcm-classics.org/tcm#Herb"/>
        <rdfs:label xml:lang="zh">相反（十八反）</rdfs:label>
        <rdfs:comment xml:lang="zh">十八反规定的配伍禁忌。如乌头（川乌/草乌/附子）反半夏、瓜蒌、贝母、白蔹、白及；甘草反甘遂、大戟、海藻、芫花；藜芦反人参、沙参、丹参、玄参、苦参、细辛、芍药。两者同用可能产生或增强毒性。</rdfs:comment>
    </owl:SymmetricProperty>
    
    <!-- 十九畏：相畏关系（非对称，但临床禁忌通常视为双向不可用） -->
    <owl:ObjectProperty rdf:about="http://www.tcm-classics.org/yaowu#is_fearing_of">
        <rdfs:domain rdf:resource="http://www.tcm-classics.org/tcm#Herb"/>
        <rdfs:range rdf:resource="http://www.tcm-classics.org/tcm#Herb"/>
        <rdfs:label xml:lang="zh">相畏（十九畏）</rdfs:label>
        <rdfs:comment xml:lang="zh">十九畏规定的配伍禁忌。如硫黄畏朴硝（芒硝），人参畏五灵脂，官桂（肉桂）畏赤石脂等。同用可能降低疗效或产生毒性。</rdfs:comment>
    </owl:ObjectProperty>

    <!-- ==================== 注释属性（药物特有） ==================== -->
    <owl:AnnotationProperty rdf:about="http://www.tcm-classics.org/yaowu#shennong_original_text">
        <rdfs:label xml:lang="zh">本经原文</rdfs:label>
        <rdfs:comment xml:lang="zh">《神农本草经》辑佚本完整原文引用。对应 tcmdb.herb.shennong_original_text。</rdfs:comment>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="http://www.tcm-classics.org/yaowu#bielu_original_text">
        <rdfs:label xml:lang="zh">别录原文</rdfs:label>
        <rdfs:comment xml:lang="zh">《名医别录》原文引用，仅当《本经》未载或需补充时使用。对应 tcmdb.herb.bielu_original_text。</rdfs:comment>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="http://www.tcm-classics.org/yaowu#huxishu_herb_note">
        <rdfs:label xml:lang="zh">胡老药性按语</rdfs:label>
        <rdfs:comment xml:lang="zh">胡希恕先生著作中对该药的专门论述摘录。对应 tcmdb.herb.huxishu_herb_note。</rdfs:comment>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="http://www.tcm-classics.org/yaowu#clinical_key_points">
        <rdfs:label xml:lang="zh">临床眼目</rdfs:label>
        <rdfs:comment xml:lang="zh">胡老提炼的该药辨证关键点。对应 tcmdb.herb.clinical_key_points。</rdfs:comment>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="http://www.tcm-classics.org/yaowu#modern_application">
        <rdfs:label xml:lang="zh">现代应用</rdfs:label>
        <rdfs:comment xml:lang="zh">胡老及门人整理的该药现代疾病对应经验。对应 tcmdb.herb.modern_application。</rdfs:comment>
    </owl:AnnotationProperty>

</rdf:RDF>