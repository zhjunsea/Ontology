                <owl:hasValue rdf:resource="#Zhizihoupotang"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <!-- ==================== 栀子干姜汤证（加味） ==================== -->
    <owl:Class rdf:about="#Zhiziganjiangtangzheng">
        <rdfs:label xml:lang="zh">栀子干姜汤证</rdfs:label>
        <rdfs:comment xml:lang="zh">《伤寒论》80条：“伤寒，医以丸药大下之，身热不去，微烦者，栀子干姜汤主之。”上热中寒，清上温中。</rdfs:comment>
        <rdfs:subClassOf rdf:resource="#Zhizichileifangzheng"/>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yin"/>
        <bagangAttr rdf:resource="#Re"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
