        <!-- ======================================================== -->
    <!-- ===== 五苓散类方证家族（抽象层，承载共性约束） ===== -->
    <!-- ======================================================== -->
    <owl:Class rdf:about="#Wulingsanleifangzheng">
        <rdfs:label xml:lang="zh">五苓散类方证</rdfs:label>
        <rdfs:comment xml:lang="zh">五苓散及其加减方证的共同特征。太阳表邪未解，膀胱气化不利，水湿内停。核心：太阳病 + 小便不利 + 口渴。此抽象层不直接对应临床诊断，仅用于聚合家族共性约束。</rdfs:comment>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <isAbstract rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isAbstract>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Taiyangbing"/>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xiaobianbuli"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Kouke"/></owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <!-- ==================== 五苓散证（母方） ==================== -->
    <owl:Class rdf:about="#Wulingsanzheng">
        <rdfs:label xml:lang="zh">五苓散证</rdfs:label>
        <rdfs:comment xml:lang="zh">《伤寒论》71条：“太阳病，发汗后……脉浮，小便不利，微热消渴者，五苓散主之。”74条：“渴欲饮水，水入则吐者，名曰水逆，五苓散主之。”五苓散类方之母方。</rdfs:comment>
        <rdfs:subClassOf rdf:resource="#Wulingsanleifangzheng"/>
        <bagangAttr rdf:resource="#Biao"/>
        <bagangAttr rdf:resource="#Yang"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Wulingsanleifangzheng"/>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_maixiang"/><owl:someValuesFrom rdf:resource="#Fumai"/></owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Fare"/>
        <possibleSymptom rdf:resource="#Shuiruzeitu"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#you_chufang"/>
                <owl:hasValue rdf:resource="#Wulingsan"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <!-- ==================== 茵陈五苓散证（加味） ==================== -->
    <owl:Class rdf:about="#Yinchenwulingsanzheng">
        <rdfs:label xml:lang="zh">茵陈五苓散证</rdfs:label>
        <rdfs:comment xml:lang="zh">《金匮要略·黄疸病脉证并治第十五》：“黄疸病，茵陈五苓散主之。”五苓散加茵陈蒿，利湿退黄。</rdfs:comment>
        <rdfs:subClassOf rdf:resource="#Wulingsanleifangzheng"/>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yang"/>
        <bagangAttr rdf:resource="#Shi"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Wulingsanleifangzheng"/>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Huangdan"/></owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Fumai"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#you_chufang"/>
                <owl:hasValue rdf:resource="#Yinchenwulingsan"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    
        <!-- ======================================================== -->
    <!-- ===== 建中汤类方证家族（抽象层，承载共性约束） ===== -->
    <!-- ======================================================== -->
    <owl:Class rdf:about="#Jianzhongtangleifangzheng">
        <rdfs:label xml:lang="zh">建中汤类方证</rdfs:label>
        <rdfs:comment xml:lang="zh">建中汤及其加减方证的共同特征。中焦虚寒，气血不足。核心：里证 + 虚 + 寒（或阴阳两虚）。此抽象层不直接对应临床诊断，仅用于聚合家族共性约束。</rdfs:comment>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <isAbstract rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isAbstract>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Li"/>
                    <owl:Class rdf:about="#Xu"/>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <owl:Class rdf:about="#Yin"/>
                            <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Fuzhongjitong"/></owl:Restriction>
                            <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xinji"/></owl:Restriction>
                        </owl:unionOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <!-- ==================== 小建中汤证（母方） ==================== -->
    <owl:Class rdf:about="#Xiaojianzhongtangzheng">
        <rdfs:label xml:lang="zh">小建中汤证</rdfs:label>
        <rdfs:comment xml:lang="zh">《伤寒论》100条：“伤寒，阳脉涩，阴脉弦，法当腹中急痛，先与小建中汤。”102条：“伤寒二三日，心中悸而烦者，小建中汤主之。”建中汤类方之母方。</rdfs:comment>
        <rdfs:subClassOf rdf:resource="#Jianzhongtangleifangzheng"/>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yin"/>
        <bagangAttr rdf:resource="#Xu"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Jianzhongtangleifangzheng"/>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Fuzhongjitong"/></owl:Restriction>
                            <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xinji"/></owl:Restriction>
                        </owl:unionOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Shouzhufanre"/>
        <possibleSymptom rdf:resource="#Yangan"/>
        <possibleSymptom rdf:resource="#Xiansemai"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#you_chufang"/>
                <owl:hasValue rdf:resource="#Xiaojianzhongtang"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <!-- ==================== 大建中汤证（同族，重用温中） ==================== -->
    <owl:Class rdf:about="#Dajianzhongtangzheng">
        <rdfs:label xml:lang="zh">大建中汤证</rdfs:label>
        <rdfs:comment xml:lang="zh">《金匮要略·腹满寒疝宿食病》：“心胸中大寒痛，呕不能饮食，腹中寒……大建中汤主之。”中焦寒甚，温中散寒止痛。</rdfs:comment>
        <rdfs:subClassOf rdf:resource="#Jianzhongtangleifangzheng"/>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yin"/>
        <bagangAttr rdf:resource="#Xu"/>
        <bagangAttr rdf:resource="#Han"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Jianzhongtangleifangzheng"/>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xinzhongdahantong"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Fuzhongleng"/></owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Ou"/>
        <possibleSymptom rdf:resource="#Bunengyinshi"/>
        <possibleSymptom rdf:resource="#Chenxianmai"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#you_chufang"/>
                <owl:hasValue rdf:resource="#Dajianzhongtang"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <!-- ==================== 黄芪建中汤证（加味） ==================== -->
    <owl:Class rdf:about="#Huangqijianzhongtangzheng">
        <rdfs:label xml:lang="zh">黄芪建中汤证</rdfs:label>
        <rdfs:comment xml:lang="zh">《金匮要略·血痹虚劳病》：“虚劳里急，诸不足，黄芪建中汤主之。”小建中汤加黄芪，补气建中。</rdfs:comment>
        <rdfs:subClassOf rdf:resource="#Jianzhongtangleifangzheng"/>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yin"/>
        <bagangAttr rdf:resource="#Xu"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Jianzhongtangleifangzheng"/>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Liji"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xulao"/></owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Miansewuhua"/>
        <possibleSymptom rdf:resource="#Fuzhongjitong"/>
        <rdfs:subClassOf>
