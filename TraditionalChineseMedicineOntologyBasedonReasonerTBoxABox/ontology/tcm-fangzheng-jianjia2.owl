    </owl:Class>

    <!-- ==================== 栀子厚朴汤证（加味） ==================== -->
    <owl:Class rdf:about="#Zhizihoupotangzheng">
        <rdfs:label xml:lang="zh">栀子厚朴汤证</rdfs:label>
        <rdfs:comment xml:lang="zh">《伤寒论》79条：“伤寒下后，心烦腹满，卧起不安者，栀子厚朴汤主之。”栀子豉汤去豉加厚朴、枳实，清热兼消痞除满。</rdfs:comment>
        <rdfs:subClassOf rdf:resource="#Zhizichileifangzheng"/>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yang"/>
        <bagangAttr rdf:resource="#Shi"/>
        <bagangAttr rdf:resource="#Re"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Zhizichileifangzheng"/>
