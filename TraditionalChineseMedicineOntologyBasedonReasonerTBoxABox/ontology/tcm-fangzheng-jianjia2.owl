    <owl:Class rdf:about="#Zhizishengjiangchitangzheng">
        <rdfs:label xml:lang="zh">栀子生姜豉汤证</rdfs:label>
        <rdfs:comment xml:lang="zh">《伤寒论》76条：“……若呕者，栀子生姜豉汤主之。”栀子豉汤加生姜，清热兼降逆止呕。</rdfs:comment>
        <rdfs:subClassOf rdf:resource="#Zhizichileifangzheng"/>
