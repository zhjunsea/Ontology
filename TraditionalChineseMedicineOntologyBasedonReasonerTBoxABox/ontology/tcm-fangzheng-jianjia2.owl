    <!-- ==================== 兼夹证定义 ==================== -->
    <owl:Class rdf:about="#Yuxuezheng">
        <rdfs:label xml:lang="zh">瘀血证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#JianJiaZheng"/>
        <add_herb rdf:resource="#Danshen"/>
        <add_herb rdf:resource="#Taoren"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Citong"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_shexiang"/><owl:someValuesFrom rdf:resource="#BlueTongue"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_maixiang"/><owl:someValuesFrom rdf:resource="#Semai"/></owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Chunwei"/>
        <possibleSymptom rdf:resource="#Jifujiacuo"/>
        <possibleSymptom rdf:resource="#Danyushushuibuyuyan"/>
        <possibleSymptom rdf:resource="#Xiongman"/>
    </owl:Class>

    <owl:Class rdf:about="#Tanyinzheng">
        <rdfs:label xml:lang="zh">痰饮证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#JianJiaZheng"/>
        <add_herb rdf:resource="#Banxia"/>
        <add_herb rdf:resource="#Fuling"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction><owl:onProperty rdf:resource="#you_shexiang"/><owl:someValuesFrom rdf:resource="#SlipperyCoating"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_shexiang"/><owl:someValuesFrom rdf:resource="#GreasyCoating"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_maixiang"/><owl:someValuesFrom rdf:resource="#Chenxianmai"/></owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Touxuan"/>
        <possibleSymptom rdf:resource="#Xinji"/>
        <possibleSymptom rdf:resource="#Kesou"/>
        <possibleSymptom rdf:resource="#Changmingruzoushui"/>
    </owl:Class>

    <owl:Class rdf:about="#Qiyuzheng">
        <rdfs:label xml:lang="zh">气郁证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#JianJiaZheng"/>
        <add_herb rdf:resource="#Xiangfu"/>
        <add_herb rdf:resource="#Yujin"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xiongxiekuman"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Shantaixi"/></owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Yanzhongruyouzhilian"/>
    </owl:Class>

    <owl:Class rdf:about="#Tanreshirezheng">
        <rdfs:label xml:lang="zh">痰热/湿热证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#JianJiaZheng"/>
        <add_herb rdf:resource="#Huangqin"/>
        <add_herb rdf:resource="#Huashi"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xinfan"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Budemian"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Ou"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_shexiang"/><owl:someValuesFrom rdf:resource="#YellowCoating"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_shexiang"/><owl:someValuesFrom rdf:resource="#GreasyCoating"/></owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Kouku"/>
        <possibleSymptom rdf:resource="#Xiaobianhuang"/>
    </owl:Class>

    <owl:Class rdf:about="#Pimanshijizheng">
        <rdfs:label xml:lang="zh">痞满/食积证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#JianJiaZheng"/>
        <add_herb rdf:resource="#Shanzha"/>
        <add_herb rdf:resource="#Shenqu"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xinxiapi"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_fuzheng"/><owl:someValuesFrom rdf:resource="#Anzhiru"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Ou"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xiali"/></owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#GreasyCoating"/>
        <possibleSymptom rdf:resource="#Fuman"/>
    </owl:Class>
    
        <!-- ======================================================== -->
    <!-- ===== 桂枝汤类方证家族（抽象层，承载共性约束） ===== -->
    <!-- ======================================================== -->
    <owl:Class rdf:about="#Guizhitangleifangzheng">
        <rdfs:label xml:lang="zh">桂枝汤类方证</rdfs:label>
        <rdfs:comment xml:lang="zh">桂枝汤及其加减方证的共同特征。凡属桂枝汤类方者，皆属太阳病表虚之证：太阳病未解，且有恶风或汗出的表虚之象。此抽象层不直接对应临床诊断，仅用于聚合家族共性约束。</rdfs:comment>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <isAbstract rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isAbstract>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Taiyangbing"/>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                                <owl:someValuesFrom rdf:resource="#Efeng"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                                <owl:someValuesFrom rdf:resource="#Hanchu"/>
                            </owl:Restriction>
                        </owl:unionOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <!-- 桂枝汤证（母方） -->
    <owl:Class rdf:about="#Guizhitangzheng">
        <rdfs:label xml:lang="zh">桂枝汤证</rdfs:label>
        <rdfs:comment xml:lang="zh">《伤寒论》12条：“太阳中风，阳浮而阴弱……桂枝汤主之。”桂枝汤类方之母方。</rdfs:comment>
        <rdfs:subClassOf rdf:resource="#Guizhitangleifangzheng"/>
        <bagangAttr rdf:resource="#Biao"/>
        <bagangAttr rdf:resource="#Yang"/>
        <bagangAttr rdf:resource="#Xu"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Guizhitangleifangzheng"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                        <owl:someValuesFrom rdf:resource="#Fare"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Fumai"/>
        <possibleSymptom rdf:resource="#Huanmai"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#you_chufang"/>
                <owl:hasValue rdf:resource="#Guizhitang"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <!-- 桂枝加葛根汤证（加味） -->
    <owl:Class rdf:about="#Guizhijiagegentangzheng">
        <rdfs:label xml:lang="zh">桂枝加葛根汤证</rdfs:label>
