                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <!-- ==================== 栀子豉汤证（母方） ==================== -->
    <owl:Class rdf:about="#Zhizichitangzheng">
        <rdfs:label xml:lang="zh">栀子豉汤证</rdfs:label>
        <rdfs:comment xml:lang="zh">《伤寒论》76条：“发汗吐下后，虚烦不得眠，若剧者，必反复颠倒，心中懊憹，栀子豉汤主之。”栀子豉汤类方之母方。</rdfs:comment>
        <rdfs:subClassOf rdf:resource="#Zhizichileifangzheng"/>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yang"/>
        <bagangAttr rdf:resource="#Re"/>
