    <!-- ==================== 枳实栀子豉汤证（加味） ==================== -->
    <owl:Class rdf:about="#Zhishizhizichitangzheng">
        <rdfs:label xml:lang="zh">枳实栀子豉汤证</rdfs:label>
        <rdfs:comment xml:lang="zh">《伤寒论》393条：“大病差后，劳复者，枳实栀子豉汤主之。”栀子豉汤加枳实，清热兼行气导滞。</rdfs:comment>
        <rdfs:subClassOf rdf:resource="#Zhizichileifangzheng"/>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yang"/>
        <bagangAttr rdf:resource="#Re"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Zhizichileifangzheng"/>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Dabingchaihou"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Laofu"/></owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Fumai"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#you_chufang"/>
                <owl:hasValue rdf:resource="#Zhishizhizichitang"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    
