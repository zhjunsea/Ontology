    <!-- ===== 栀子豉汤类方证家族（抽象层，承载共性约束） ===== -->
    <!-- ======================================================== -->
    <owl:Class rdf:about="#Zhizichileifangzheng">
        <rdfs:label xml:lang="zh">栀子豉汤类方证</rdfs:label>
        <rdfs:comment xml:lang="zh">栀子豉汤及其加减方证的共同特征。无形邪热扰于胸膈，心中懊憹。此抽象层不直接对应临床诊断，仅用于聚合家族共性约束。</rdfs:comment>
