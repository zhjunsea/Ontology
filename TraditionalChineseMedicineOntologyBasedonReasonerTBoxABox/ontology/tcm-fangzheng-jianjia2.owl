    <!-- ===== 泻心汤类方证家族（抽象层，承载共性约束） ===== -->
    <!-- ======================================================== -->
    <owl:Class rdf:about="#Xiexintangleifangzheng">
        <rdfs:label xml:lang="zh">泻心汤类方证</rdfs:label>
        <rdfs:comment xml:lang="zh">泻心汤及其加减方证的共同特征。寒热错杂，气机升降失常，心下痞。此抽象层不直接对应临床诊断，仅用于聚合家族共性约束。</rdfs:comment>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <isAbstract rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isAbstract>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Li"/>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xinxiapi"/></owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <!-- ==================== 半夏泻心汤证（母方） ==================== -->
    <owl:Class rdf:about="#Banxiaxiexintangzheng">
        <rdfs:label xml:lang="zh">半夏泻心汤证</rdfs:label>
        <rdfs:comment xml:lang="zh">《伤寒论》149条：“……但满而不痛者，此为痞，柴胡不中与之，宜半夏泻心汤。”寒热错杂痞证之母方。</rdfs:comment>
        <rdfs:subClassOf rdf:resource="#Xiexintangleifangzheng"/>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yin"/>
        <bagangAttr rdf:resource="#Shi"/>
        <bagangAttr rdf:resource="#Re"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Xiexintangleifangzheng"/>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Ou"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xiali"/></owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Changming"/>
        <possibleSymptom rdf:resource="#Xianmai"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#you_chufang"/>
                <owl:hasValue rdf:resource="#Banxiaxiexintang"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <!-- ==================== 生姜泻心汤证（加味） ==================== -->
    <owl:Class rdf:about="#Shengjiangxiexintangzheng">
        <rdfs:label xml:lang="zh">生姜泻心汤证</rdfs:label>
        <rdfs:comment xml:lang="zh">《伤寒论》157条：“伤寒汗出解之后，胃中不和，心下痞硬，干噫食臭，胁下有水气，腹中雷鸣下利者，生姜泻心汤主之。”半夏泻心汤减干姜加生姜，散水气。</rdfs:comment>
        <rdfs:subClassOf rdf:resource="#Xiexintangleifangzheng"/>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yin"/>
        <bagangAttr rdf:resource="#Shi"/>
        <bagangAttr rdf:resource="#Re"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Xiexintangleifangzheng"/>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xinxiapiying"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Gantaishichou"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Leiming"/></owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Xiali"/>
        <possibleSymptom rdf:resource="#Xianmai"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#you_chufang"/>
                <owl:hasValue rdf:resource="#Shengjiangxiexintang"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <!-- ==================== 甘草泻心汤证（太阳病，加味） ==================== -->
    <owl:Class rdf:about="#Gancaoxiexintangzheng_Taiyang">
        <rdfs:label xml:lang="zh">甘草泻心汤证（太阳病）</rdfs:label>
        <rdfs:comment xml:lang="zh">《伤寒论》158条：“伤寒中风，医反下之，其人下利日数十行，谷不化，腹中雷鸣，心下痞硬而满，干呕心烦不得安……甘草泻心汤主之。”半夏泻心汤重用甘草，补中益气。</rdfs:comment>
        <rdfs:subClassOf rdf:resource="#Xiexintangleifangzheng"/>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yin"/>
        <bagangAttr rdf:resource="#Xu"/>
        <bagangAttr rdf:resource="#Re"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Xiexintangleifangzheng"/>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xialibuzhi"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xinfan"/></owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Budewo"/>
        <possibleSymptom rdf:resource="#Xianmai"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#you_chufang"/>
                <owl:hasValue rdf:resource="#Gancaoxiexintang"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <!-- ==================== 大黄黄连泻心汤证（减味） ==================== -->
    <owl:Class rdf:about="#Dahuanghuanglianxiexintangzheng">
        <rdfs:label xml:lang="zh">大黄黄连泻心汤证</rdfs:label>
        <rdfs:comment xml:lang="zh">《伤寒论》154条：“心下痞，按之濡，其脉关上浮者，大黄黄连泻心汤主之。”热痞，泻热消痞。</rdfs:comment>
        <rdfs:subClassOf rdf:resource="#Xiexintangleifangzheng"/>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yang"/>
        <bagangAttr rdf:resource="#Shi"/>
        <bagangAttr rdf:resource="#Re"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Xiexintangleifangzheng"/>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_fuzheng"/><owl:someValuesFrom rdf:resource="#Anzhiru"/></owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Fumai"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#you_chufang"/>
                <owl:hasValue rdf:resource="#Dahuanghuanglianxiexintang"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <!-- ==================== 附子泻心汤证（加味） ==================== -->
    <owl:Class rdf:about="#Fuzixiexintangzheng">
        <rdfs:label xml:lang="zh">附子泻心汤证</rdfs:label>
        <rdfs:comment xml:lang="zh">《伤寒论》155条：“心下痞，而复恶寒汗出者，附子泻心汤主之。”热痞兼表阳虚，泻热兼温阳固表。</rdfs:comment>
        <rdfs:subClassOf rdf:resource="#Xiexintangleifangzheng"/>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Biao"/>
        <bagangAttr rdf:resource="#Yang"/>
        <bagangAttr rdf:resource="#Yin"/>
        <bagangAttr rdf:resource="#Shi"/>
        <bagangAttr rdf:resource="#Re"/>
        <bagangAttr rdf:resource="#Xu"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Xiexintangleifangzheng"/>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Ehan"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Hanchu"/></owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Fumai"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#you_chufang"/>
                <owl:hasValue rdf:resource="#Fuzixiexintang"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    
        <!-- ======================================================== -->
    <!-- ===== 承气汤类方证家族（抽象层，承载共性约束） ===== -->
    <!-- ======================================================== -->
    <owl:Class rdf:about="#Chengqitangleifangzheng">
        <rdfs:label xml:lang="zh">承气汤类方证</rdfs:label>
        <rdfs:comment xml:lang="zh">承气汤及其加减方证的共同特征。阳明腑实，燥屎内结。核心：阳明病 + 大便硬 + 潮热/谵语。此抽象层不直接对应临床诊断，仅用于聚合家族共性约束。</rdfs:comment>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <isAbstract rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isAbstract>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Yangmingbing"/>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Dabianying"/></owl:Restriction>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Chaore"/></owl:Restriction>
                            <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Zhanyu"/></owl:Restriction>
                            <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Fuman"/></owl:Restriction>
                            <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Futong"/></owl:Restriction>
                        </owl:unionOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <!-- ==================== 大承气汤证（母方，痞满燥实俱全） ==================== -->
    <owl:Class rdf:about="#Dachengqitangzheng">
        <rdfs:label xml:lang="zh">大承气汤证</rdfs:label>
        <rdfs:comment xml:lang="zh">《伤寒论》208、209、212、215、217、220、238、240、241条等，阳明腑实重证，痞满燥实俱全。承气汤类方之母方。</rdfs:comment>
        <rdfs:subClassOf rdf:resource="#Chengqitangleifangzheng"/>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yang"/>
        <bagangAttr rdf:resource="#Shi"/>
        <bagangAttr rdf:resource="#Re"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Chengqitangleifangzheng"/>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_fuzheng"/><owl:someValuesFrom rdf:resource="#Fuman"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_fuzheng"/><owl:someValuesFrom rdf:resource="#Futong"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_maixiang"/><owl:someValuesFrom rdf:resource="#Chenshimai"/></owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#YellowCoating"/>
        <possibleSymptom rdf:resource="#DryCoating"/>
        <possibleSymptom rdf:resource="#TongueWithThorns"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#you_chufang"/>
                <owl:hasValue rdf:resource="#Dachengqitang"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <!-- ==================== 小承气汤证（减味，痞满实） ==================== -->
    <owl:Class rdf:about="#Xiaochengqitangzheng">
        <rdfs:label xml:lang="zh">小承气汤证</rdfs:label>
        <rdfs:comment xml:lang="zh">《伤寒论》213条：“阳明病，其人多汗，以津液外出，胃中燥，大便必硬，硬则谵语，小承气汤主之。”大承气汤去芒硝，轻下热结。</rdfs:comment>
        <rdfs:subClassOf rdf:resource="#Chengqitangleifangzheng"/>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yang"/>
        <bagangAttr rdf:resource="#Shi"/>
        <bagangAttr rdf:resource="#Re"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Chengqitangleifangzheng"/>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Zhanyu"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Hanchu"/></owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Fuman"/>
        <possibleSymptom rdf:resource="#Huamai"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#you_chufang"/>
                <owl:hasValue rdf:resource="#Xiaochengqitang"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <!-- ==================== 调胃承气汤证（减味+加味，燥实） ==================== -->
    <owl:Class rdf:about="#Tiaoweichengqitangzheng">
        <rdfs:label xml:lang="zh">调胃承气汤证</rdfs:label>
        <rdfs:comment xml:lang="zh">《伤寒论》248条：“太阳病三日，发汗不解，蒸蒸发热者，属胃也，调胃承气汤主之。”大承气汤去厚朴、枳实，加甘草，缓下热结，专治燥实。</rdfs:comment>
        <rdfs:subClassOf rdf:resource="#Chengqitangleifangzheng"/>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yang"/>
        <bagangAttr rdf:resource="#Shi"/>
        <bagangAttr rdf:resource="#Re"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Chengqitangleifangzheng"/>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Zhengzhengfare"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xinfan"/></owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Fuzhangman"/>
        <possibleSymptom rdf:resource="#Danrebuhan"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#you_chufang"/>
                <owl:hasValue rdf:resource="#Tiaoweichengqitang"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    
        <!-- ======================================================== -->
    <!-- ===== 苓甘五味姜辛类方证家族（抽象层，承载共性约束） ===== -->
    <!-- ======================================================== -->
    <owl:Class rdf:about="#Lingganwuweijiangxinleifangzheng">
        <rdfs:label xml:lang="zh">苓甘五味姜辛类方证</rdfs:label>
        <rdfs:comment xml:lang="zh">苓甘五味姜辛汤及其系列加减方证的共同特征。寒饮内停，肺失宣降。核心：里证 + 寒饮 + 咳嗽/气逆。此抽象层不直接对应临床诊断，仅用于聚合家族共性约束。</rdfs:comment>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <isAbstract rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isAbstract>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Li"/>
                    <owl:Class rdf:about="#Yin"/>
                    <owl:Class rdf:about="#Shi"/>
                    <owl:Class rdf:about="#Han"/>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Kesou"/></owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <!-- ==================== 桂苓五味甘草汤证（前身方） ==================== -->
    <owl:Class rdf:about="#Guilingwuweigancaotangzheng">
        <rdfs:label xml:lang="zh">桂苓五味甘草汤证</rdfs:label>
        <rdfs:comment xml:lang="zh">《金匮要略·痰饮咳嗽病》：“青龙汤下已，多唾口燥，寸脉沉，尺脉微，手足厥逆，气从小腹上冲胸咽……与茯苓桂枝五味甘草汤，治其气冲。”苓甘五味姜辛系列之首方，治下焦阳虚、气冲。</rdfs:comment>
        <rdfs:subClassOf rdf:resource="#Lingganwuweijiangxinleifangzheng"/>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yin"/>
        <bagangAttr rdf:resource="#Xu"/>
        <bagangAttr rdf:resource="#Han"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Lingganwuweijiangxinleifangzheng"/>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Duotuokouzao"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Shouzuleng"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Qicongshaofushangchongxiongyan"/></owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Xiaobiannan"/>
        <possibleSymptom rdf:resource="#Shifumao"/>
        <possibleSymptom rdf:resource="#Chenmai"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#you_chufang"/>
                <owl:hasValue rdf:resource="#Guilingwuweigancaotang"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <!-- ==================== 苓甘五味姜辛汤证（母方，去桂加姜辛） ==================== -->
    <owl:Class rdf:about="#Lingganwuweijiangxintangzheng">
        <rdfs:label xml:lang="zh">苓甘五味姜辛汤证</rdfs:label>
        <rdfs:comment xml:lang="zh">《金匮要略·痰饮咳嗽病》：“冲气即低，而反更咳、胸满者，用桂苓五味甘草汤去桂加干姜、细辛，以治其咳满。”苓甘五味姜辛系列之母方。</rdfs:comment>
        <rdfs:subClassOf rdf:resource="#Lingganwuweijiangxinleifangzheng"/>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yin"/>
        <bagangAttr rdf:resource="#Shi"/>
        <bagangAttr rdf:resource="#Han"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Lingganwuweijiangxinleifangzheng"/>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xiongman"/></owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Tanduo"/>
        <possibleSymptom rdf:resource="#Chenmai"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#you_chufang"/>
                <owl:hasValue rdf:resource="#Lingganwuweijiangxintang"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <!-- ==================== 苓甘五味姜辛夏汤证（加味） ==================== -->
    <owl:Class rdf:about="#Lingganwuweijiangxinxiatangzheng">
        <rdfs:label xml:lang="zh">苓甘五味姜辛夏汤证</rdfs:label>
        <rdfs:comment xml:lang="zh">《金匮要略·痰饮咳嗽病》：“咳满即止，而更复渴，冲气复发者，以细辛、干姜为热药也……先渴却呕者，为水停心下，此属饮家，加半夏以去其水。”苓甘五味姜辛汤加半夏，化痰止呕。</rdfs:comment>
        <rdfs:subClassOf rdf:resource="#Lingganwuweijiangxinleifangzheng"/>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yin"/>
        <bagangAttr rdf:resource="#Shi"/>
        <bagangAttr rdf:resource="#Han"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Lingganwuweijiangxinleifangzheng"/>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Ou"/></owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Xiongman"/>
        <possibleSymptom rdf:resource="#Chenmai"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#you_chufang"/>
                <owl:hasValue rdf:resource="#Lingganwuweijiangxinxiatang"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <!-- ==================== 苓甘五味加姜辛半夏杏仁汤证（加味） ==================== -->
    <owl:Class rdf:about="#Lingganwuweijiajiangxinbanxiaxingrentangzheng">
        <rdfs:label xml:lang="zh">苓甘五味加姜辛半夏杏仁汤证</rdfs:label>
        <rdfs:comment xml:lang="zh">《金匮要略·痰饮咳嗽病》：“水去呕止，其人形肿者，加杏仁主之。”苓甘五味姜辛夏汤加杏仁，宣肺利水消肿。</rdfs:comment>
        <rdfs:subClassOf rdf:resource="#Lingganwuweijiangxinleifangzheng"/>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yin"/>
        <bagangAttr rdf:resource="#Shi"/>
        <bagangAttr rdf:resource="#Han"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Lingganwuweijiangxinleifangzheng"/>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xingzhong"/></owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Ou"/>
        <possibleSymptom rdf:resource="#Chenmai"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#you_chufang"/>
                <owl:hasValue rdf:resource="#Lingganwuweijiajiangxinbanxiaxingrentang"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <!-- ==================== 苓甘五味加姜辛半杏大黄汤证（加味） ==================== -->
    <owl:Class rdf:about="#Lingganwuweijiajiangxinbanxingdahuangtangzheng">
        <rdfs:label xml:lang="zh">苓甘五味加姜辛半杏大黄汤证</rdfs:label>
        <rdfs:comment xml:lang="zh">《金匮要略·痰饮咳嗽病》：“若面热如醉，此为胃热上冲熏其面，加大黄以利之。”苓甘五味姜辛夏杏汤加大黄，清胃热。</rdfs:comment>
        <rdfs:subClassOf rdf:resource="#Lingganwuweijiangxinleifangzheng"/>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yin"/>
        <bagangAttr rdf:resource="#Shi"/>
        <bagangAttr rdf:resource="#Han"/>
        <bagangAttr rdf:resource="#Re"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Lingganwuweijiangxinleifangzheng"/>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Mianreruzui"/></owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Xingzhong"/>
        <possibleSymptom rdf:resource="#Chenmai"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#you_chufang"/>
                <owl:hasValue rdf:resource="#Lingganwuweijiajiangxinbanxingdahuangtang"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    
</rdf:RDF>