    <!-- 桂枝加附子汤证（加味） -->
    <owl:Class rdf:about="#Guizhijiafuzitangzheng">
        <rdfs:label xml:lang="zh">桂枝加附子汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Guizhitangleifangzheng"/>
        <bagangAttr rdf:resource="#Biao"/>
        <bagangAttr rdf:resource="#Yang"/>
        <bagangAttr rdf:resource="#Xu"/>
        <bagangAttr rdf:resource="#Han"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Guizhitangleifangzheng"/>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Hanloubuzhi"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xiaobiannan"/></owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
