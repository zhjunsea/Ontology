            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Zhizichileifangzheng"/>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Fanre"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Budemian"/></owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Shaoqi"/>
        <possibleSymptom rdf:resource="#Fumai"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#you_chufang"/>
                <owl:hasValue rdf:resource="#Zhizichitang"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <!-- ==================== 栀子甘草豉汤证（加味） ==================== -->
    <owl:Class rdf:about="#Zhizigancaochitangzheng">
        <rdfs:label xml:lang="zh">栀子甘草豉汤证</rdfs:label>
        <rdfs:comment xml:lang="zh">《伤寒论》76条：“……若少气者，栀子甘草豉汤主之。”栀子豉汤加甘草，清热兼补中气。</rdfs:comment>
        <rdfs:subClassOf rdf:resource="#Zhizichileifangzheng"/>
