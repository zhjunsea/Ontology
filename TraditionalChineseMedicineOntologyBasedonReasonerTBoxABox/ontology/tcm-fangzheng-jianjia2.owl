                <owl:onProperty rdf:resource="#you_chufang"/>
                <owl:hasValue rdf:resource="#Huangqijianzhongtang"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <!-- ==================== 内补当归建中汤证（加味） ==================== -->
    <owl:Class rdf:about="#Neibudangguijianzhongtangzheng">
        <rdfs:label xml:lang="zh">内补当归建中汤证</rdfs:label>
        <rdfs:comment xml:lang="zh">《金匮要略·妇人产后病》附方：“《千金》内补当归建中汤，治妇人产后虚羸不足……”产后虚羸，温中补血。</rdfs:comment>
        <rdfs:subClassOf rdf:resource="#Jianzhongtangleifangzheng"/>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yin"/>
        <bagangAttr rdf:resource="#Xu"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Jianzhongtangleifangzheng"/>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Fuzhongcitong"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Shaofuji"/></owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Xixishaoqi"/>
        <possibleSymptom rdf:resource="#Yinyaobeitong"/>
        <possibleSymptom rdf:resource="#Bunengyinshi"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#you_chufang"/>
                <owl:hasValue rdf:resource="#Neibudangguijianzhongtang"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    
