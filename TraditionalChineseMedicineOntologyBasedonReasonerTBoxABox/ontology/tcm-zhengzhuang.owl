    <owl:Ontology rdf:about="http://www.tcm-classics.org/jingfang/zhengzhuang">
        <rdfs:label xml:lang="zh">症状模块（原子化·最终定版）</rdfs:label>
        <rdfs:comment xml:lang="zh">仅保留原子症状与体征。依据《伤寒论》《金匮要略》及胡希恕学术思想。痉(Jingbing)与惊(Jing)以类名区分。</rdfs:comment>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/core"/>
        <owl:versionInfo>27.0</owl:versionInfo>
    </owl:Ontology>

