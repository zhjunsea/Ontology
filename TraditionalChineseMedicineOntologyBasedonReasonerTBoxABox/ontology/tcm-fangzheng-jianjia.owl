    <!-- ==================== 苓甘五味姜辛汤证 ==================== -->
    <owl:Class rdf:about="#Lingganwuweijiangxintangzheng">
        <rdfs:label xml:lang="zh">苓甘五味姜辛汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <rdfs:comment xml:lang="zh">《金匮要略·痰饮咳嗽病》：“冲气即低，而反更咳、胸满者，用桂苓五味甘草汤去桂加干姜、细辛，以治其咳满。”</rdfs:comment>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Taiyinbing"/>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Kesou"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xiongman"/></owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Tanduo"/>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Lingganwuweijiangxintang"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

    <!-- ==================== 木防己去石膏加茯苓芒硝汤证 ==================== -->
    <owl:Class rdf:about="#Mufangjiqushigaojiafulingmangxiaotangzheng">
        <rdfs:label xml:lang="zh">木防己去石膏加茯苓芒硝汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <rdfs:comment xml:lang="zh">《金匮要略·痰饮咳嗽病》：“木防己汤主之。虚者即愈，实者三日复发，复与不愈者，宜木防己汤去石膏加茯苓芒硝汤主之。”</rdfs:comment>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Taiyinbing"/>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Gexianzhiyin"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Chuan"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xiongman"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xinxiapijian"/></owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Chenjinmai"/>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Mufangjiqushigaojiafulingmangxiaotang"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

    <!-- ==================== 己椒苈黄丸证 ==================== -->
    <owl:Class rdf:about="#Jijiaolihuangwanzheng">
