    <owl:Ontology rdf:about="http://www.tcm-classics.org/jingfang/fangzheng-jianjia">
        <rdfs:label xml:lang="zh">方证与兼夹证模块</rdfs:label>
        <rdfs:comment xml:lang="zh">方证类与兼夹证类定义（按胡希恕学术思想校准）。v2.1：所有 you_chufang 引用的方剂 IRI 已统一为方剂 ABox 中定义的首字母大写、后续全小写形式。</rdfs:comment>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/core"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/fangji"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/yaowu"/>
        <owl:versionInfo>2.1</owl:versionInfo>
    </owl:Ontology>
		<!-- ==================== 临床优先级 ==================== -->
		<owl:AnnotationProperty rdf:about="#clinicalPriority">
		    <rdfs:label xml:lang="zh">临床优先级</rdfs:label>
		    <rdfs:comment xml:lang="zh">数字越小越优先。1=急证；2=重证；3=常证；4=变证；5=缓证。
		依据《伤寒论》91条"急当救里"，252条"急下存阴"，胡希恕"六经八纲"学术思想。
		不参与逻辑推理，只作应用层方证排序依据。</rdfs:comment>
		    <rdfs:domain rdf:resource="#Fangzheng"/>
		    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
		</owl:AnnotationProperty>
		    <!-- ==================== 临床优先级（应用层排序用，不参与推理） ==================== -->

