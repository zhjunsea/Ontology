        <possibleSymptom rdf:resource="#Chuan"/>
        <possibleSymptom rdf:resource="#Outu"/>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Mahuangtang"/></owl:Restriction></rdfs:subClassOf>
