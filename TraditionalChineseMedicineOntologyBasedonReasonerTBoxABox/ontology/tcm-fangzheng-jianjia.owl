    <!-- ==================== 半夏麻黄丸证 ==================== -->
    <owl:Class rdf:about="#Banxiamahuangwanzheng">
		    <rdfs:label xml:lang="zh">半夏麻黄丸证</rdfs:label>
		    <rdfs:subClassOf rdf:resource="#Fangzheng"/>
		    <rdfs:comment xml:lang="zh">《金匮要略·惊悸吐衄下血胸满瘀血病》："心下悸者，半夏麻黄丸主之。"
		
		病机：水饮内停，水气凌心。主证为心下悸动（胃脘部跳动感），属痰饮证范畴，不归六经。
		
		注：本证属杂病，与六经辨证平行。兼夹证（痰饮证）在应用层与本方证组合判定，
		不在 TBox 里交叉引用，保持分类简洁。</rdfs:comment>
		
		    <owl:equivalentClass>
		        <owl:Class>
		            <owl:intersectionOf rdf:parseType="Collection">
		                <!-- 主证：心下悸动（胃脘部跳动感） -->
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#Xinxiajidong"/>
		                </owl:Restriction>
		            </owl:intersectionOf>
		        </owl:Class>
		    </owl:equivalentClass>
		
		    <possibleSymptom rdf:resource="#Touxuan"/>
		    <possibleSymptom rdf:resource="#Xianmai"/>
		    <possibleSymptom rdf:resource="#SlipperyCoating"/>
		
		    <rdfs:subClassOf>
		        <owl:Restriction>
		            <owl:onProperty rdf:resource="#you_chufang"/>
		            <owl:hasValue rdf:resource="#Banxiamahuangwan"/>
		        </owl:Restriction>
		    </rdfs:subClassOf>
		</owl:Class>

