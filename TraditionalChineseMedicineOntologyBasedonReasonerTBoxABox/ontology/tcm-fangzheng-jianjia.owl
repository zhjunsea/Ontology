                    <owl:Restriction><owl:onProperty rdf:resource="#you_shexiang"/><owl:someValuesFrom rdf:resource="#GreasyCoating"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_maixiang"/><owl:someValuesFrom rdf:resource="#Chenxianmai"/></owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Touxuan"/>
        <possibleSymptom rdf:resource="#Xinji"/>
        <possibleSymptom rdf:resource="#Kesou"/>
        <possibleSymptom rdf:resource="#Changmingruzoushui"/>
    </owl:Class>

