    <owl:Ontology rdf:about="http://www.tcm-classics.org/jingfang/zhengzhuang-abox">
        <rdfs:label xml:lang="zh">症状模块 ABox（v27.0·严格对应TBox）</rdfs:label>
        <rdfs:comment xml:lang="zh">依据 v27.0 症状 TBox 生成的全部症状标准实例。类名与 TBox 严格一致。痉为 #Jingbing_instance，惊为 #Jing_instance。不含脉象、舌象、方剂证候群。</rdfs:comment>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/zhengzhuang"/>
    </owl:Ontology>

