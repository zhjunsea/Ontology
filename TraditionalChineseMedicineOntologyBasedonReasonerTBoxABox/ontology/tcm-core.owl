<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns="http://www.tcm-classics.org/jingfang#"
         xml:base="http://www.tcm-classics.org/jingfang#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

    <owl:Ontology rdf:about="http://www.tcm-classics.org/jingfang/core">
        <rdfs:label xml:lang="zh">经方六经辨证本体 TBox（核心）</rdfs:label>
        <rdfs:comment xml:lang="zh">术语层：属性、顶层类、八纲、六经、药证。方证定义见 tcm-fangzheng-jianjia.owl，四诊叶子类及兼夹证定义见 tcm-zhengzhuang.owl。v2.0：校正八纲、六经中症状 IRI，统一兼夹证 IRI，放宽四诊属性 domain，支持 BPMN 经方辨证流程。</rdfs:comment>
        <owl:versionInfo>2.0</owl:versionInfo>
    </owl:Ontology>

    <!-- ==================== 对象属性 ==================== -->
    <owl:ObjectProperty rdf:about="#you_zhengzhuang">
        <rdfs:range rdf:resource="#Zhengzhuang"/>
        <rdfs:label xml:lang="zh">有症状</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#you_maixiang">
        <rdfs:range rdf:resource="#Maixiang"/>
        <rdfs:label xml:lang="zh">有脉象</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#you_shexiang">
        <rdfs:range rdf:resource="#Shexiang"/>
        <rdfs:label xml:lang="zh">有舌象</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#you_fuzheng">
        <rdfs:range rdf:resource="#Fuzheng"/>
        <rdfs:label xml:lang="zh">有腹证</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#you_chufang">
        <rdfs:domain rdf:resource="#Fangzheng"/>
        <rdfs:range rdf:resource="#Fangji"/>
        <rdfs:label xml:lang="zh">有处方</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#you_yaowu">
        <rdfs:domain rdf:resource="#Fangji"/>
        <rdfs:range rdf:resource="#Yaowu"/>
        <rdfs:label xml:lang="zh">有组成药物</rdfs:label>
    </owl:ObjectProperty>

    <!-- ==================== 数据属性 ==================== -->
    <owl:DatatypeProperty rdf:about="#you_jianyi">
        <rdfs:domain rdf:resource="#Huanzhe"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:label xml:lang="zh">有加减建议</rdfs:label>
    </owl:DatatypeProperty>

    <!-- ==================== 注释属性 ==================== -->
    <owl:AnnotationProperty rdf:about="#possibleSymptom">
        <rdfs:label xml:lang="zh">或然症</rdfs:label>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="#addHerb">
        <rdfs:label xml:lang="zh">可加药物</rdfs:label>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="#hasYaozheng">
        <rdfs:label xml:lang="zh">有药证</rdfs:label>
        <rdfs:comment xml:lang="zh">药物与药证类的注释关联，不参与推理</rdfs:comment>
    </owl:AnnotationProperty>

    <!-- ==================== 顶层类 ==================== -->
    <owl:Class rdf:about="#Huanzhe">
        <rdfs:label xml:lang="zh">患者</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#SizhenXinxi">
        <rdfs:label xml:lang="zh">四诊信息</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#Zhengzhuang">
        <rdfs:subClassOf rdf:resource="#SizhenXinxi"/>
        <rdfs:label xml:lang="zh">症状</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#Maixiang">
        <rdfs:subClassOf rdf:resource="#SizhenXinxi"/>
        <rdfs:label xml:lang="zh">脉象</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#Shexiang">
        <rdfs:subClassOf rdf:resource="#SizhenXinxi"/>
        <rdfs:label xml:lang="zh">舌象</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#Fuzheng">
        <rdfs:subClassOf rdf:resource="#SizhenXinxi"/>
        <rdfs:label xml:lang="zh">腹证</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#Tizhi">
        <rdfs:subClassOf rdf:resource="#SizhenXinxi"/>
        <rdfs:label xml:lang="zh">体质</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#Bagang">
        <rdfs:label xml:lang="zh">八纲</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#Liujingbing">
        <rdfs:label xml:lang="zh">六经病</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#Fangzheng">
        <rdfs:label xml:lang="zh">方证</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#Fangji">
        <rdfs:label xml:lang="zh">方剂</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#Yaowu">
        <rdfs:label xml:lang="zh">药物</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#Yaozheng">
        <rdfs:label xml:lang="zh">药证</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#JianJiaZheng">
        <rdfs:label xml:lang="zh">兼夹证</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#Yuxuezheng">
        <rdfs:subClassOf rdf:resource="#JianJiaZheng"/>
        <rdfs:label xml:lang="zh">瘀血证</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#Tanyinzheng">
        <rdfs:subClassOf rdf:resource="#JianJiaZheng"/>
        <rdfs:label xml:lang="zh">痰饮证</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#Qiyuzheng">
        <rdfs:subClassOf rdf:resource="#JianJiaZheng"/>
        <rdfs:label xml:lang="zh">气郁证</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#Tanreshirezheng">
        <rdfs:subClassOf rdf:resource="#JianJiaZheng"/>
        <rdfs:label xml:lang="zh">痰热/湿热证</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#Pimanshijizheng">
        <rdfs:subClassOf rdf:resource="#JianJiaZheng"/>
        <rdfs:label xml:lang="zh">痞满/食积证</rdfs:label>
    </owl:Class>

    <!-- ==================== 八纲定义 ==================== -->
    <owl:Class rdf:about="#Biao">
        <rdfs:subClassOf rdf:resource="#Bagang"/>
        <rdfs:label xml:lang="zh">表证</rdfs:label>
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <owl:Class rdf:about="#Ehan"/>
                            <owl:Class rdf:about="#Efeng"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </owl:equivalentClass>
    </owl:Class>

    <owl:Class rdf:about="#Li">
        <rdfs:subClassOf rdf:resource="#Bagang"/>
        <rdfs:label xml:lang="zh">里证</rdfs:label>
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <owl:Class rdf:about="#Fuman"/>
                            <owl:Class rdf:about="#Dabianying"/>
                            <owl:Class rdf:about="#Xiali"/>
                            <owl:Class rdf:about="#Outu"/>
                            <owl:Class rdf:about="#Kouke"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </owl:equivalentClass>
    </owl:Class>

    <owl:Class rdf:about="#Han">
        <rdfs:subClassOf rdf:resource="#Bagang"/>
        <rdfs:label xml:lang="zh">寒证</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                                <owl:someValuesFrom rdf:resource="#Ehan"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                                <owl:someValuesFrom rdf:resource="#Wuhan"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                        <owl:someValuesFrom rdf:resource="#Xialiqinggu"/>
                    </owl:Restriction>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                                <owl:someValuesFrom rdf:resource="#Shouzuleng"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="#you_maixiang"/>
                                <owl:someValuesFrom rdf:resource="#Weiximai"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                                <owl:someValuesFrom rdf:resource="#Ehan"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="#you_maixiang"/>
                                <owl:someValuesFrom rdf:resource="#Chimai"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                                <owl:someValuesFrom rdf:resource="#Xiali"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                                <owl:someValuesFrom rdf:resource="#Buke"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <owl:Class rdf:about="#Re">
        <rdfs:subClassOf rdf:resource="#Bagang"/>
        <rdfs:label xml:lang="zh">热证</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                        <owl:someValuesFrom rdf:resource="#Danrebuhan"/>
                    </owl:Restriction>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                                <owl:someValuesFrom rdf:resource="#Kouke"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                                <owl:someValuesFrom rdf:resource="#Fanzao"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                                <owl:someValuesFrom rdf:resource="#Kouke"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="#you_maixiang"/>
                                <owl:someValuesFrom rdf:resource="#Shumai"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                                <owl:someValuesFrom rdf:resource="#Fanzao"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="#you_maixiang"/>
                                <owl:someValuesFrom rdf:resource="#Shumai"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <owl:Class rdf:about="#Xu">
        <rdfs:subClassOf rdf:resource="#Bagang"/>
        <rdfs:label xml:lang="zh">虚证</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                        <owl:someValuesFrom rdf:resource="#Hanchu"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                        <owl:someValuesFrom rdf:resource="#Xiali"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_maixiang"/>
                        <owl:someValuesFrom rdf:resource="#Weiximai"/>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <owl:Class rdf:about="#Shi">
        <rdfs:subClassOf rdf:resource="#Bagang"/>
        <rdfs:label xml:lang="zh">实证</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                                <owl:someValuesFrom rdf:resource="#Wuhan"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="#you_maixiang"/>
                                <owl:someValuesFrom rdf:resource="#Jinmai"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                        <owl:someValuesFrom rdf:resource="#Dabianying"/>
                    </owl:Restriction>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                                <owl:someValuesFrom rdf:resource="#Fuman"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                                <owl:someValuesFrom rdf:resource="#Futong"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                                <owl:someValuesFrom rdf:resource="#Juan"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_maixiang"/>
                        <owl:someValuesFrom rdf:resource="#Chenshimai"/>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <owl:Class rdf:about="#Yin">
        <rdfs:subClassOf rdf:resource="#Bagang"/>
        <rdfs:label xml:lang="zh">阴证</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <owl:Class rdf:about="#Biao"/>
                            <owl:Class rdf:about="#Han"/>
                            <owl:Class rdf:about="#Xu"/>
                        </owl:intersectionOf>
                    </owl:Class>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <owl:Class rdf:about="#Li"/>
                            <owl:Class rdf:about="#Han"/>
                            <owl:Class rdf:about="#Xu"/>
                        </owl:intersectionOf>
                    </owl:Class>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <owl:Class rdf:about="#BanbiaoBanli"/>
                            <owl:Class rdf:about="#Han"/>
                            <owl:Class rdf:about="#Xu"/>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <owl:Class rdf:about="#Yang">
        <rdfs:subClassOf rdf:resource="#Bagang"/>
        <rdfs:label xml:lang="zh">阳证</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <owl:Class rdf:about="#Biao"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="#you_maixiang"/>
                                <owl:someValuesFrom rdf:resource="#Fumai"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <owl:Class rdf:about="#Li"/>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <owl:Class rdf:about="#Re"/>
                                    <owl:Class rdf:about="#Shi"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:intersectionOf>
                    </owl:Class>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <owl:Class rdf:about="#BanbiaoBanli"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="#you_maixiang"/>
                                <owl:someValuesFrom rdf:resource="#Xianmai"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <!-- ==================== 半表半里定义 ==================== -->
    <owl:Class rdf:about="#BanbiaoBanli">
        <rdfs:subClassOf rdf:resource="#Bagang"/>
        <rdfs:label xml:lang="zh">半表半里</rdfs:label>
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <owl:Class rdf:about="#Wanglaihanre"/>
                            <owl:Class rdf:about="#Xiongxiekuman"/>
                            <owl:Class rdf:about="#Kouku"/>
                            <owl:Class rdf:about="#Xinfan"/>
                            <owl:Class rdf:about="#Xiou"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </owl:equivalentClass>
    </owl:Class>

    <!-- ==================== 六经病定义 ==================== -->
    <owl:Class rdf:about="#Taiyangbing">
        <rdfs:subClassOf rdf:resource="#Liujingbing"/>
        <rdfs:label xml:lang="zh">太阳病</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Biao"/>
                    <owl:Class rdf:about="#Yang"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                        <owl:someValuesFrom rdf:resource="#Fare"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <owl:Class rdf:about="#Ehan"/>
                                    <owl:Class rdf:about="#Efeng"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_maixiang"/>
                        <owl:someValuesFrom rdf:resource="#Fumai"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <owl:Class rdf:about="#Yangmingbing">
        <rdfs:subClassOf rdf:resource="#Liujingbing"/>
        <rdfs:label xml:lang="zh">阳明病</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <owl:Class rdf:about="#Li"/>
                            <owl:Class rdf:about="#Yang"/>
                            <owl:Class rdf:about="#Re"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                                <owl:someValuesFrom rdf:resource="#Danrebuhan"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                                <owl:someValuesFrom rdf:resource="#Kouke"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="#you_maixiang"/>
                                <owl:someValuesFrom>
                                    <owl:Class>
                                        <owl:unionOf rdf:parseType="Collection">
                                            <owl:Class rdf:about="#Hongmai"/>
                                            <owl:Class rdf:about="#Chenshimai"/>
                                        </owl:unionOf>
                                    </owl:Class>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <owl:Class rdf:about="#Li"/>
                            <owl:Class rdf:about="#Shi"/>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <owl:Class rdf:about="#Shaoyangbing">
        <rdfs:subClassOf rdf:resource="#Liujingbing"/>
        <rdfs:label xml:lang="zh">少阳病</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#BanbiaoBanli"/>
                    <owl:Class rdf:about="#Yang"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                        <owl:someValuesFrom rdf:resource="#Wanglaihanre"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                        <owl:someValuesFrom rdf:resource="#Xiongxiekuman"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <owl:Class rdf:about="#Taiyinbing">
		    <rdfs:subClassOf rdf:resource="#Liujingbing"/>
		    <rdfs:label xml:lang="zh">太阴病</rdfs:label>
		    <rdfs:comment xml:lang="zh">《伤寒论》273条："太阴之为病，腹满而吐，食不下，自利益甚，时腹自痛。"
		
		太阴病本质：里虚寒证。提纲证候（腹满、呕吐、食不下、下利）不必悉具。
		核心是"里 + 阴 + 虚 + 寒"，症状用 union 表达"任一见"。</rdfs:comment>
		    <owl:equivalentClass>
		        <owl:Class>
		            <owl:intersectionOf rdf:parseType="Collection">
		                <owl:Class rdf:about="#Li"/>
		                <owl:Class rdf:about="#Yin"/>
		                <owl:Class rdf:about="#Han"/>
		                <owl:Class rdf:about="#Xu"/>
		                <!-- 提纲症状任一见 -->
		                <owl:Class>
		                    <owl:unionOf rdf:parseType="Collection">
		                        <owl:Restriction>
		                            <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                            <owl:someValuesFrom rdf:resource="#Fuman"/>
		                        </owl:Restriction>
		                        <owl:Restriction>
		                            <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                            <owl:someValuesFrom rdf:resource="#Outu"/>
		                        </owl:Restriction>
		                        <owl:Restriction>
		                            <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                            <owl:someValuesFrom rdf:resource="#Shibuxia"/>
		                        </owl:Restriction>
		                        <owl:Restriction>
		                            <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                            <owl:someValuesFrom rdf:resource="#Xiali"/>
		                        </owl:Restriction>
		                    </owl:unionOf>
		                </owl:Class>
		            </owl:intersectionOf>
		        </owl:Class>
		    </owl:equivalentClass>
		</owl:Class>

    <owl:Class rdf:about="#Shaoyinbing">
        <rdfs:subClassOf rdf:resource="#Liujingbing"/>
        <rdfs:label xml:lang="zh">少阴病</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Biao"/>
                    <owl:Class rdf:about="#Yin"/>
                    <owl:Class rdf:about="#Han"/>
                    <owl:Class rdf:about="#Xu"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_maixiang"/>
                        <owl:someValuesFrom rdf:resource="#Weiximai"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                        <owl:someValuesFrom rdf:resource="#Danyumei"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <owl:Class rdf:about="#Jueyinbing">
        <rdfs:subClassOf rdf:resource="#Liujingbing"/>
        <rdfs:label xml:lang="zh">厥阴病</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#BanbiaoBanli"/>
                    <owl:Class rdf:about="#Yin"/>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

</rdf:RDF>