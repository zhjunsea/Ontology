            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Chenmai"/>
                    <owl:Class rdf:about="#Huamai"/>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <owl:Class rdf:about="#ChenJiemai">
        <rdfs:subClassOf rdf:resource="#Maixiang"/>
        <rdfs:subClassOf rdf:resource="#Chenmai"/>
        <rdfs:subClassOf rdf:resource="#Jiemai"/>
        <rdfs:subClassOf rdf:resource="#Xu"/>
        <rdfs:label xml:lang="zh">沉结脉</rdfs:label>
        <rdfs:comment xml:lang="zh">《伤寒论》125条抵当汤证。</rdfs:comment>
