            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Chenmai"/>
                    <owl:Class rdf:about="#Xiaomai"/>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
