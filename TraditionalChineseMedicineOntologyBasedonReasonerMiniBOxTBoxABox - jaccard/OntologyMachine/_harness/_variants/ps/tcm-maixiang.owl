                    <owl:Class rdf:about="#Jiemai"/>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <owl:Class rdf:about="#Chenxiaomai">
        <rdfs:subClassOf rdf:resource="#Maixiang"/>
        <rdfs:subClassOf rdf:resource="#Chenmai"/>
        <rdfs:subClassOf rdf:resource="#Xiaomai"/>
        <rdfs:subClassOf rdf:resource="#Xu"/>
        <rdfs:label xml:lang="zh">沉小脉</rdfs:label>
        <rdfs:comment xml:lang="zh">《金匮·水气》“脉沉小属少阴”。</rdfs:comment>
