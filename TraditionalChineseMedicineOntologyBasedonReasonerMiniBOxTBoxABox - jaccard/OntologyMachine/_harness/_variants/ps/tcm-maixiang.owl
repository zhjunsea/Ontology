            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Chenmai"/>
                    <owl:Class rdf:about="#Xianmai"/>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <owl:Class rdf:about="#Chenjinmai">
        <rdfs:subClassOf rdf:resource="#Maixiang"/>
        <rdfs:subClassOf rdf:resource="#Chenmai"/>
        <rdfs:subClassOf rdf:resource="#Jinmai"/>
        <rdfs:subClassOf rdf:resource="#Shi"/>
        <rdfs:label xml:lang="zh">沉紧脉</rdfs:label>
        <rdfs:comment xml:lang="zh">《伤寒论》136条。</rdfs:comment>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Chenmai"/>
                    <owl:Class rdf:about="#Jinmai"/>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <owl:Class rdf:about="#Chenximai">
        <rdfs:subClassOf rdf:resource="#Maixiang"/>
        <rdfs:subClassOf rdf:resource="#Chenmai"/>
        <rdfs:subClassOf rdf:resource="#Ximai"/>
        <rdfs:subClassOf rdf:resource="#Xu"/>
        <rdfs:label xml:lang="zh">沉细脉</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Chenmai"/>
                    <owl:Class rdf:about="#Ximai"/>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <owl:Class rdf:about="#Chenhuamai">
        <rdfs:subClassOf rdf:resource="#Maixiang"/>
        <rdfs:subClassOf rdf:resource="#Chenmai"/>
        <rdfs:subClassOf rdf:resource="#Huamai"/>
        <rdfs:subClassOf rdf:resource="#Shi"/>
        <rdfs:subClassOf rdf:resource="#Re"/>
        <rdfs:label xml:lang="zh">沉滑脉</rdfs:label>
        <rdfs:comment xml:lang="zh">《金匮·水气》风水。</rdfs:comment>
