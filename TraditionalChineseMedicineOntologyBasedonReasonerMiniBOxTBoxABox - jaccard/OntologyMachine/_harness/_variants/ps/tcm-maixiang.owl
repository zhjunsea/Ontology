    <owl:Class rdf:about="#Chenshimai">
        <rdfs:subClassOf rdf:resource="#Maixiang"/>
        <rdfs:subClassOf rdf:resource="#Chenmai"/>
        <rdfs:subClassOf rdf:resource="#Shimai"/>
        <rdfs:subClassOf rdf:resource="#Shi"/>
        <rdfs:label xml:lang="zh">沉实脉</rdfs:label>
        <rdfs:comment xml:lang="zh">大承气汤证“脉沉实”。</rdfs:comment>
        <owl:equivalentClass>
