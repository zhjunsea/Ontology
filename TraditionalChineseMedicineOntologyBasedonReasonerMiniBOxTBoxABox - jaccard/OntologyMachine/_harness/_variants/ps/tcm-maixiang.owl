<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns="http://www.tcm-classics.org/jingfang#"
         xml:base="http://www.tcm-classics.org/jingfang#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

    <owl:Ontology rdf:about="http://www.tcm-classics.org/jingfang/maixiang">
        <rdfs:label xml:lang="zh">脉象模块（原子化·依据《脉经》与《伤寒论》《金匮要略》）</rdfs:label>
        <rdfs:comment xml:lang="zh">v10.0：
1. 原子脉类保持不变。
2. 所有复合脉补充 subClassOf 到各原子脉（多继承），让"有浮紧脉 ⟹ 有浮脉 + 紧脉"成立。
3. 保留 equivalentClass，让"同时有浮脉和紧脉 ⟹ 有浮紧脉"也成立。
4. 复合脉的 subClassOf 与 equivalentClass 语义一致，但互为加强。</rdfs:comment>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/core"/>
        <owl:versionInfo>10.1</owl:versionInfo>
    </owl:Ontology>

    <!-- ======================================================== -->
    <!-- ==================== 一、原子脉类 ====================== -->
    <!-- ======================================================== -->

    <owl:Class rdf:about="#Fumai"><rdfs:subClassOf rdf:resource="#Maixiang"/><rdfs:subClassOf rdf:resource="#Biao"/><rdfs:label xml:lang="zh">浮脉</rdfs:label></owl:Class>
    <owl:Class rdf:about="#Chenmai"><rdfs:subClassOf rdf:resource="#Maixiang"/><rdfs:label xml:lang="zh">沉脉</rdfs:label></owl:Class>
    <owl:Class rdf:about="#Huanmai"><rdfs:subClassOf rdf:resource="#Maixiang"/><rdfs:label xml:lang="zh">缓脉</rdfs:label></owl:Class>
    <owl:Class rdf:about="#Jinmai"><rdfs:subClassOf rdf:resource="#Maixiang"/><rdfs:label xml:lang="zh">紧脉</rdfs:label></owl:Class>
    <owl:Class rdf:about="#Chimai"><rdfs:subClassOf rdf:resource="#Maixiang"/><rdfs:label xml:lang="zh">迟脉</rdfs:label></owl:Class>
    <owl:Class rdf:about="#Shumai"><rdfs:subClassOf rdf:resource="#Maixiang"/><rdfs:label xml:lang="zh">数脉</rdfs:label></owl:Class>
    <owl:Class rdf:about="#Xianmai"><rdfs:subClassOf rdf:resource="#Maixiang"/><rdfs:label xml:lang="zh">弦脉</rdfs:label></owl:Class>
    <owl:Class rdf:about="#Semai"><rdfs:subClassOf rdf:resource="#Maixiang"/><rdfs:label xml:lang="zh">涩脉</rdfs:label></owl:Class>
    <owl:Class rdf:about="#Huamai"><rdfs:subClassOf rdf:resource="#Maixiang"/><rdfs:label xml:lang="zh">滑脉</rdfs:label></owl:Class>
    <owl:Class rdf:about="#Ximai"><rdfs:subClassOf rdf:resource="#Maixiang"/><rdfs:label xml:lang="zh">细脉</rdfs:label><rdfs:comment xml:lang="zh">《伤寒论》351条当归四逆汤证“脉细欲绝”即细脉之极。</rdfs:comment></owl:Class>
    <owl:Class rdf:about="#Weimai"><rdfs:subClassOf rdf:resource="#Maixiang"/><rdfs:subClassOf rdf:resource="#Xu"/><rdfs:label xml:lang="zh">微脉</rdfs:label></owl:Class>
    <owl:Class rdf:about="#Ruomai"><rdfs:subClassOf rdf:resource="#Maixiang"/><rdfs:subClassOf rdf:resource="#Xu"/><rdfs:label xml:lang="zh">弱脉</rdfs:label></owl:Class>
    <owl:Class rdf:about="#Shimai"><rdfs:subClassOf rdf:resource="#Maixiang"/><rdfs:subClassOf rdf:resource="#Shi"/><rdfs:label xml:lang="zh">实脉</rdfs:label></owl:Class>
    <owl:Class rdf:about="#Xumai"><rdfs:subClassOf rdf:resource="#Maixiang"/><rdfs:subClassOf rdf:resource="#Xu"/><rdfs:label xml:lang="zh">虚脉</rdfs:label></owl:Class>
    <owl:Class rdf:about="#Koumai"><rdfs:subClassOf rdf:resource="#Maixiang"/><rdfs:label xml:lang="zh">芤脉</rdfs:label></owl:Class>
    <owl:Class rdf:about="#Cumai"><rdfs:subClassOf rdf:resource="#Maixiang"/><rdfs:label xml:lang="zh">促脉</rdfs:label></owl:Class>
    <owl:Class rdf:about="#Jiemai"><rdfs:subClassOf rdf:resource="#Maixiang"/><rdfs:label xml:lang="zh">结脉</rdfs:label></owl:Class>
    <owl:Class rdf:about="#Daimai"><rdfs:subClassOf rdf:resource="#Maixiang"/><rdfs:label xml:lang="zh">代脉</rdfs:label></owl:Class>
    <owl:Class rdf:about="#Dongmai"><rdfs:subClassOf rdf:resource="#Maixiang"/><rdfs:label xml:lang="zh">动脉</rdfs:label></owl:Class>
    <owl:Class rdf:about="#Changmai"><rdfs:subClassOf rdf:resource="#Maixiang"/><rdfs:label xml:lang="zh">长脉</rdfs:label></owl:Class>
    <owl:Class rdf:about="#Duanmai"><rdfs:subClassOf rdf:resource="#Maixiang"/><rdfs:label xml:lang="zh">短脉</rdfs:label></owl:Class>
    <owl:Class rdf:about="#Fumai_Yin"><rdfs:subClassOf rdf:resource="#Maixiang"/><rdfs:label xml:lang="zh">伏脉</rdfs:label></owl:Class>
    <owl:Class rdf:about="#Gemia"><rdfs:subClassOf rdf:resource="#Maixiang"/><rdfs:label xml:lang="zh">革脉</rdfs:label></owl:Class>
    <owl:Class rdf:about="#Ruanmai"><rdfs:subClassOf rdf:resource="#Maixiang"/><rdfs:label xml:lang="zh">软脉</rdfs:label></owl:Class>
    <owl:Class rdf:about="#Hongmai"><rdfs:subClassOf rdf:resource="#Maixiang"/><rdfs:label xml:lang="zh">洪脉</rdfs:label><rdfs:comment xml:lang="zh">注：不设单脉象白名单——洪脉主热盛，但须与热证合参方判病性（26条「大烦渴不解，脉洪大者」）。改由合取判据 Panju_B7（口渴+洪脉/大脉/黄苔）判定。依据《伤寒论》186条「伤寒三日，阳明脉大」；25条「服桂枝汤，大汗出，脉洪大者」。</rdfs:comment></owl:Class>
    <owl:Class rdf:about="#Sanmai"><rdfs:subClassOf rdf:resource="#Maixiang"/><rdfs:label xml:lang="zh">散脉</rdfs:label></owl:Class>
    <owl:Class rdf:about="#Xiaomai"><rdfs:subClassOf rdf:resource="#Maixiang"/><rdfs:label xml:lang="zh">小脉</rdfs:label></owl:Class>
    <owl:Class rdf:about="#Damai"><rdfs:subClassOf rdf:resource="#Maixiang"/><rdfs:label xml:lang="zh">大脉</rdfs:label></owl:Class>
    <owl:Class rdf:about="#Laomai"><rdfs:subClassOf rdf:resource="#Maixiang"/><rdfs:label xml:lang="zh">牢脉</rdfs:label></owl:Class>
    <owl:Class rdf:about="#Pingmai"><rdfs:subClassOf rdf:resource="#Maixiang"/><rdfs:label xml:lang="zh">平脉</rdfs:label></owl:Class>

    <!-- ======================================================== -->
    <!-- ==================== 二、复合脉类 ====================== -->
    <!-- ============ 每个复合脉：多继承 + 等价类 =============== -->
    <!-- ======================================================== -->

    <!-- ==================== 浮复合脉 ==================== -->

    <owl:Class rdf:about="#Fuhuanmai">
        <rdfs:subClassOf rdf:resource="#Maixiang"/>
        <rdfs:subClassOf rdf:resource="#Fumai"/>
        <rdfs:subClassOf rdf:resource="#Huanmai"/>
        <rdfs:subClassOf rdf:resource="#Xu"/>
        <rdfs:label xml:lang="zh">浮缓脉</rdfs:label>
        <rdfs:comment xml:lang="zh">《伤寒论》2条、12条：中风，桂枝汤证核心脉。</rdfs:comment>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Fumai"/>
                    <owl:Class rdf:about="#Huanmai"/>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <owl:Class rdf:about="#WeiseMai">
        <rdfs:subClassOf rdf:resource="#Maixiang"/>
        <rdfs:subClassOf rdf:resource="#Weimai"/>
        <rdfs:subClassOf rdf:resource="#Semai"/>
        <rdfs:subClassOf rdf:resource="#Xu"/>
        <rdfs:label xml:lang="zh">微涩脉</rdfs:label>
        <rdfs:comment xml:lang="zh">《金匮·血痹虚劳》黄芪桂枝五物汤证气血虚滞之脉。</rdfs:comment>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Weimai"/>
                    <owl:Class rdf:about="#Semai"/>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <owl:Class rdf:about="#Fujinmai">
        <rdfs:subClassOf rdf:resource="#Maixiang"/>
        <rdfs:subClassOf rdf:resource="#Fumai"/>
        <rdfs:subClassOf rdf:resource="#Jinmai"/>
        <rdfs:subClassOf rdf:resource="#Shi"/>
        <rdfs:label xml:lang="zh">浮紧脉</rdfs:label>
        <rdfs:comment xml:lang="zh">《伤寒论》3条、35条：伤寒，麻黄汤证核心脉。</rdfs:comment>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Fumai"/>
                    <owl:Class rdf:about="#Jinmai"/>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <owl:Class rdf:about="#Fuximai">
        <rdfs:subClassOf rdf:resource="#Maixiang"/>
        <rdfs:subClassOf rdf:resource="#Fumai"/>
        <rdfs:subClassOf rdf:resource="#Ximai"/>
        <rdfs:subClassOf rdf:resource="#Xu"/>
        <rdfs:label xml:lang="zh">浮细脉</rdfs:label>
        <rdfs:comment xml:lang="zh">《伤寒论》37条。</rdfs:comment>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Fumai"/>
                    <owl:Class rdf:about="#Ximai"/>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <owl:Class rdf:about="#Fuxusemai">
        <rdfs:subClassOf rdf:resource="#Maixiang"/>
        <rdfs:subClassOf rdf:resource="#Fumai"/>
        <rdfs:subClassOf rdf:resource="#Xumai"/>
        <rdfs:subClassOf rdf:resource="#Semai"/>
        <rdfs:subClassOf rdf:resource="#Xu"/>
        <rdfs:label xml:lang="zh">浮虚涩脉</rdfs:label>
        <rdfs:comment xml:lang="zh">《金匮·痉湿暍》桂枝附子汤证。</rdfs:comment>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Fumai"/>
                    <owl:Class rdf:about="#Xumai"/>
                    <owl:Class rdf:about="#Semai"/>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <owl:Class rdf:about="#Fuhongmai">
        <rdfs:subClassOf rdf:resource="#Maixiang"/>
        <rdfs:subClassOf rdf:resource="#Fumai"/>
        <rdfs:subClassOf rdf:resource="#Hongmai"/>
        <rdfs:subClassOf rdf:resource="#Re"/>
        <rdfs:label xml:lang="zh">浮洪脉</rdfs:label>
        <rdfs:comment xml:lang="zh">《金匮·水气》风水。</rdfs:comment>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Fumai"/>
                    <owl:Class rdf:about="#Hongmai"/>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <owl:Class rdf:about="#Fuchimai">
        <rdfs:subClassOf rdf:resource="#Maixiang"/>
        <rdfs:subClassOf rdf:resource="#Fumai"/>
        <rdfs:subClassOf rdf:resource="#Chimai"/>
        <rdfs:subClassOf rdf:resource="#Han"/>
        <rdfs:label xml:lang="zh">浮迟脉</rdfs:label>
        <rdfs:comment xml:lang="zh">《金匮·消渴小便利淋病》。</rdfs:comment>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Fumai"/>
                    <owl:Class rdf:about="#Chimai"/>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <owl:Class rdf:about="#Fuhuamai">
        <rdfs:subClassOf rdf:resource="#Maixiang"/>
        <rdfs:subClassOf rdf:resource="#Fumai"/>
        <rdfs:subClassOf rdf:resource="#Huamai"/>
        <rdfs:subClassOf rdf:resource="#Re"/>
        <rdfs:label xml:lang="zh">浮滑脉</rdfs:label>
        <rdfs:comment xml:lang="zh">《伤寒论》138条小陷胸汤证。</rdfs:comment>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Fumai"/>
                    <owl:Class rdf:about="#Huamai"/>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <owl:Class rdf:about="#Fushumai">
        <rdfs:subClassOf rdf:resource="#Maixiang"/>
        <rdfs:subClassOf rdf:resource="#Fumai"/>
        <rdfs:subClassOf rdf:resource="#Shumai"/>
        <rdfs:subClassOf rdf:resource="#Re"/>
        <rdfs:label xml:lang="zh">浮数脉</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Fumai"/>
                    <owl:Class rdf:about="#Shumai"/>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <owl:Class rdf:about="#Fudamai">
        <rdfs:subClassOf rdf:resource="#Maixiang"/>
        <rdfs:subClassOf rdf:resource="#Fumai"/>
        <rdfs:subClassOf rdf:resource="#Damai"/>
        <rdfs:subClassOf rdf:resource="#Re"/>
        <rdfs:label xml:lang="zh">浮大脉</rdfs:label>
        <rdfs:comment xml:lang="zh">《金匮·疟病》。</rdfs:comment>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Fumai"/>
                    <owl:Class rdf:about="#Damai"/>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <owl:Class rdf:about="#Furuomai">
        <rdfs:subClassOf rdf:resource="#Maixiang"/>
        <rdfs:subClassOf rdf:resource="#Fumai"/>
        <rdfs:subClassOf rdf:resource="#Ruomai"/>
        <rdfs:subClassOf rdf:resource="#Xu"/>
        <rdfs:label xml:lang="zh">浮弱脉</rdfs:label>
        <rdfs:comment xml:lang="zh">《金匮·血痹虚劳》。</rdfs:comment>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Fumai"/>
                    <owl:Class rdf:about="#Ruomai"/>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <owl:Class rdf:about="#Furuosemai">
        <rdfs:subClassOf rdf:resource="#Maixiang"/>
        <rdfs:subClassOf rdf:resource="#Fumai"/>
        <rdfs:subClassOf rdf:resource="#Ruomai"/>
        <rdfs:subClassOf rdf:resource="#Semai"/>
        <rdfs:subClassOf rdf:resource="#Xu"/>
        <rdfs:label xml:lang="zh">浮弱涩脉</rdfs:label>
        <rdfs:comment xml:lang="zh">《金匮·血痹虚劳》“男子脉浮弱而涩”。</rdfs:comment>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Fumai"/>
                    <owl:Class rdf:about="#Ruomai"/>
                    <owl:Class rdf:about="#Semai"/>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <!-- ==================== 沉复合脉 ==================== -->

    <owl:Class rdf:about="#Chenchimai">
        <rdfs:subClassOf rdf:resource="#Maixiang"/>
        <rdfs:subClassOf rdf:resource="#Chenmai"/>
        <rdfs:subClassOf rdf:resource="#Chimai"/>
        <rdfs:subClassOf rdf:resource="#Han"/>
        <rdfs:label xml:lang="zh">沉迟脉</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Chenmai"/>
                    <owl:Class rdf:about="#Chimai"/>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <owl:Class rdf:about="#Chenruomai">
        <rdfs:subClassOf rdf:resource="#Maixiang"/>
        <rdfs:subClassOf rdf:resource="#Chenmai"/>
        <rdfs:subClassOf rdf:resource="#Ruomai"/>
        <rdfs:subClassOf rdf:resource="#Xu"/>
        <rdfs:label xml:lang="zh">沉弱脉</rdfs:label>
        <rdfs:comment xml:lang="zh">《金匮·痰饮》“脉沉而弱者，有留饮”。</rdfs:comment>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Chenmai"/>
                    <owl:Class rdf:about="#Ruomai"/>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <owl:Class rdf:about="#Chenweimai">
        <rdfs:subClassOf rdf:resource="#Maixiang"/>
        <rdfs:subClassOf rdf:resource="#Chenmai"/>
        <rdfs:subClassOf rdf:resource="#Weimai"/>
        <rdfs:subClassOf rdf:resource="#Xu"/>
        <rdfs:label xml:lang="zh">沉微脉</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Chenmai"/>
                    <owl:Class rdf:about="#Weimai"/>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <owl:Class rdf:about="#Chenxianmai">
        <rdfs:subClassOf rdf:resource="#Maixiang"/>
        <rdfs:subClassOf rdf:resource="#Chenmai"/>
        <rdfs:subClassOf rdf:resource="#Xianmai"/>
        <rdfs:subClassOf rdf:resource="#Shi"/>
        <rdfs:label xml:lang="zh">沉弦脉</rdfs:label>
