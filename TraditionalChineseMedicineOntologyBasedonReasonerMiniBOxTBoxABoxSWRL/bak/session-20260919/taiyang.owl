    <!-- ============================================================ -->
    <!-- 四、太阳水气/黄汗/产后中风类                                  -->
    <!-- ============================================================ -->

    <!-- 越婢汤证（金匮·水气）—— 风水恶风，一身悉肿 -->
    <owl:Class rdf:about="#Yuebitangzheng">
