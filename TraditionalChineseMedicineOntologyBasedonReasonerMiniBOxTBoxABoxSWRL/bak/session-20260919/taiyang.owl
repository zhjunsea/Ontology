        <belongsToLiujing rdf:resource="#Yangmingbing"/>
        <debatable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</debatable>
        <differentialAxis xml:lang="zh">身黄+发热+恶寒（262条）；瘀热在里，表邪未解</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
        <bagangAttr rdf:resource="#Biao"/>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yang"/>
        <bagangAttr rdf:resource="#Shi"/>
        <bagangAttr rdf:resource="#Re"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Taiyangbing"/>
                    <owl:Class rdf:about="#Yangmingbing"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                        <owl:someValuesFrom rdf:resource="#Shenhuang"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                        <owl:someValuesFrom rdf:resource="#Fare"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                        <owl:someValuesFrom rdf:resource="#Ehan"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <!-- 大青龙汤证（38条）—— 表实无汗而烦躁 -->
		<owl:Class rdf:about="#Daqinglongtangzheng">
		    <rdfs:label xml:lang="zh">大青龙汤证</rdfs:label>
        <chufang rdf:resource="#Daqinglongtang"/>
		    <rdfs:subClassOf rdf:resource="#Mahuangtangleifangzheng"/>
		    <rdfs:subClassOf rdf:resource="#Fangzheng"/>
		    <belongsToLiujing rdf:resource="#Taiyangbing"/>
		    <differentialAxis xml:lang="zh">不汗出而烦躁（38条）；表实闭郁，郁而化热</differentialAxis>
		    <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</clinicalPriority>
		    <bagangAttr rdf:resource="#Biao"/>
		    <bagangAttr rdf:resource="#Yang"/>
		    <bagangAttr rdf:resource="#Shi"/>
		    <bagangAttr rdf:resource="#Re"/>
		    <owl:equivalentClass>
		        <owl:Class>
		            <owl:intersectionOf rdf:parseType="Collection">
		                <owl:Class rdf:about="#Taiyangbing"/>
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#Wuhan"/>
		                </owl:Restriction>
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#Shentong"/>
		                </owl:Restriction>
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_maixiang"/>
		                    <owl:someValuesFrom rdf:resource="#Fujinmai"/>
		                </owl:Restriction>
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#Fanzao"/>
		                </owl:Restriction>
		            </owl:intersectionOf>
		        </owl:Class>
		    </owl:equivalentClass>
		    <possibleSymptom rdf:resource="#Ehan"/>
		    <possibleSymptom rdf:resource="#Fare"/>
		    <possibleSymptom rdf:resource="#Shentong"/>
		    <possibleSymptom rdf:resource="#Fumai"/>
		    <owl:disjointWith rdf:resource="#Xiaoqinglongtangzheng"/>
		</owl:Class>

    <!-- 小青龙汤证（40、41条）—— 表不解，心下有水气 -->
    <owl:Class rdf:about="#Xiaoqinglongtangzheng">
        <rdfs:label xml:lang="zh">小青龙汤证</rdfs:label>
        <chufang rdf:resource="#Xiaoqinglongtang"/>
        <rdfs:subClassOf rdf:resource="#Mahuangtangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Taiyangbing"/>
