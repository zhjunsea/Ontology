    <!-- 竹叶汤证 -->
    <owl:Class rdf:about="#Zhuyetangzheng">
        <rdfs:label xml:lang="zh">竹叶汤证</rdfs:label>
        <chufang rdf:resource="#Zhuyetang"/>
