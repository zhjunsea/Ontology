    <!-- 白术附子汤证 -->
    <owl:Class rdf:about="#Baizhufuzitangzheng">
        <rdfs:label xml:lang="zh">白术附子汤证</rdfs:label>
        <chufang rdf:resource="#Baizhufuzitang"/>
        <rdfs:subClassOf rdf:resource="#Guizhitangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Taiyangbing"/>
        <belongsToLiujing rdf:resource="#Taiyinbing"/>
        <debatable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</debatable>
        <differentialAxis xml:lang="zh">身疼烦+大便硬+小便自利（174条桂枝附子去桂加白术汤）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
        <bagangAttr rdf:resource="#Biao"/>
        <bagangAttr rdf:resource="#Yang"/>
        <bagangAttr rdf:resource="#Xu"/>
        <bagangAttr rdf:resource="#Han"/>
        <hasFanggen rdf:resource="#FuziBaizhuGancaogen"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Taiyangbing"/>
                    <owl:Class rdf:about="#Taiyinbing"/>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Shentengfan"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Dabianying"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xiaobianzili"/></owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <!-- 甘草附子汤证 -->
    <owl:Class rdf:about="#Gancaofuzitangzheng">
        <rdfs:label xml:lang="zh">甘草附子汤证</rdfs:label>
        <chufang rdf:resource="#Gancaofuzitang"/>
        <rdfs:subClassOf rdf:resource="#Guizhitangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Taiyangbing"/>
        <belongsToLiujing rdf:resource="#Shaoyinbing"/>
        <debatable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</debatable>
        <differentialAxis xml:lang="zh">骨节疼烦+掣痛不得屈伸+汗出+短气（175条）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
        <bagangAttr rdf:resource="#Biao"/>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yang"/>
        <bagangAttr rdf:resource="#Xu"/>
        <bagangAttr rdf:resource="#Han"/>
        <hasFanggen rdf:resource="#FuziBaizhuGancaogen"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Taiyangbing"/>
                    <owl:Class rdf:about="#Shaoyinbing"/>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Gujietengfan"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Chetongbudequshen"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Hanchu"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Duanqi"/></owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <!-- 桂枝人参汤证（双挂：桂枝汤类 + 理中汤类） -->
    <owl:Class rdf:about="#Guizhirenshentangzheng">
        <rdfs:label xml:lang="zh">桂枝人参汤证</rdfs:label>
        <chufang rdf:resource="#Guizhirenshentang"/>
        <rdfs:subClassOf rdf:resource="#Guizhitangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Lizhongtangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <primaryFamily rdf:resource="#Lizhongtangleifangzheng"/>
        <belongsToLiujing rdf:resource="#Taiyangbing"/>
        <belongsToLiujing rdf:resource="#Taiyinbing"/>
        <differentialAxis xml:lang="zh">心下痞硬+下利不止（163条）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</clinicalPriority>
        <bagangAttr rdf:resource="#Biao"/>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yin"/>
        <bagangAttr rdf:resource="#Xu"/>
        <bagangAttr rdf:resource="#Han"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Taiyangbing"/>
                    <owl:Class rdf:about="#Taiyinbing"/>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xinxiapiying"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xialibuzhi"/></owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <!-- 栝楼桂枝汤证 -->
    <owl:Class rdf:about="#Gualouguizhitangzheng">
        <rdfs:label xml:lang="zh">栝楼桂枝汤证</rdfs:label>
        <chufang rdf:resource="#Gualouguizhitang"/>
        <rdfs:subClassOf rdf:resource="#Guizhitangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Taiyangbing"/>
        <differentialAxis xml:lang="zh">身体强几几+汗出恶风（金匮痉湿暍）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
        <bagangAttr rdf:resource="#Biao"/>
        <bagangAttr rdf:resource="#Yang"/>
        <bagangAttr rdf:resource="#Xu"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                <owl:Class rdf:about="#Taiyangbing"/><owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Shentiqiangjiji"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Hanchu"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Efeng"/></owl:Restriction>
            </owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <owl:Class rdf:about="#Jianzhongtangleifangzheng">
        <rdfs:label xml:lang="zh">建中汤类方证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Jiazu"/>
        <hasFanggen rdf:resource="#Jianzhongfanggen"/>
        <isAbstract rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isAbstract>
        <rdfs:comment xml:lang="zh">母方：小建中汤。共性（注释）：温中补虚，和里缓急。本类方以小建中汤为基础，通过加减化裁（如黄芪建中汤、当归建中汤等）治疗中焦虚寒、气血不足之证。</rdfs:comment>
    </owl:Class>

    <!-- ============================================================ -->
    <!-- 二、麻黄汤类家族                                              -->
    <!-- ============================================================ -->
    <owl:Class rdf:about="#Mahuangtangleifangzheng">
        <rdfs:label xml:lang="zh">麻黄汤类方证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Jiazu"/>
        <hasFanggen rdf:resource="#Mahuanggen"/>
        <hasFanggen rdf:resource="#Mahuangguizhigen"/>
        <isAbstract rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isAbstract>
        <rdfs:comment xml:lang="zh">母方：麻黄汤。共性（注释）：太阳表实，无汗，脉浮紧。麻杏石甘已转阳明，家族不绑六经。</rdfs:comment>
    </owl:Class>

    <!-- 麻黄汤证 -->
    <owl:Class rdf:about="#Mahuangtangzheng">
        <rdfs:label xml:lang="zh">麻黄汤证</rdfs:label>
        <chufang rdf:resource="#Mahuangtang"/>
        <rdfs:subClassOf rdf:resource="#Mahuangtangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Taiyangbing"/>
        <differentialAxis xml:lang="zh">无汗+身疼+脉浮紧（35条）；可兼喘</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</clinicalPriority>
        <bagangAttr rdf:resource="#Biao"/>
        <bagangAttr rdf:resource="#Yang"/>
        <bagangAttr rdf:resource="#Shi"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Taiyangbing"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                        <owl:someValuesFrom rdf:resource="#Wuhan"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                        <owl:someValuesFrom rdf:resource="#Shentong"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_maixiang"/>
                        <owl:someValuesFrom rdf:resource="#Fujinmai"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Chuan"/>
        <possibleSymptom rdf:resource="#Ehan"/>
        <possibleSymptom rdf:resource="#Fare"/>
        <possibleSymptom rdf:resource="#Toutong"/>
        <owl:disjointWith rdf:resource="#Guizhitangzheng"/>
    </owl:Class>

    <!-- 麻黄加术汤证 -->
    <owl:Class rdf:about="#Mahuangjiazhutangzheng">
        <rdfs:label xml:lang="zh">麻黄加术汤证</rdfs:label>
        <chufang rdf:resource="#Mahuangjiazhutang"/>
        <rdfs:subClassOf rdf:resource="#Mahuangtangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Taiyangbing"/>
        <differentialAxis xml:lang="zh">身疼烦+恶寒（金匮痉湿暍）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
        <bagangAttr rdf:resource="#Biao"/>
        <bagangAttr rdf:resource="#Yang"/>
        <bagangAttr rdf:resource="#Shi"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Taiyangbing"/>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/>
                        <owl:someValuesFrom rdf:resource="#Shentengfan"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/>
                        <owl:someValuesFrom rdf:resource="#Ehan"/></owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <!-- 麻杏石甘汤证（63、162条）—— 表邪已解，热壅于肺 -->
		<owl:Class rdf:about="#Maxingshigantangzheng">
		    <rdfs:label xml:lang="zh">麻杏石甘汤证</rdfs:label>
        <chufang rdf:resource="#Maxingshigantang"/>
		    <rdfs:subClassOf rdf:resource="#Mahuangtangleifangzheng"/>
		    <rdfs:subClassOf rdf:resource="#Fangzheng"/>
		    <belongsToLiujing rdf:resource="#Yangmingbing"/>
		    <differentialAxis xml:lang="zh">汗出而喘+发热+无大热（63、162条）；表邪已解，热壅于肺</differentialAxis>
		    <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
		    <bagangAttr rdf:resource="#Li"/>
		    <bagangAttr rdf:resource="#Yang"/>
		    <bagangAttr rdf:resource="#Shi"/>
		    <bagangAttr rdf:resource="#Re"/>
		    <owl:equivalentClass>
		        <owl:Class>
		            <owl:intersectionOf rdf:parseType="Collection">
		                <owl:Class rdf:about="#Yangmingbing"/>
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#Hanchu"/>
		                </owl:Restriction>
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#Chuan"/>
		                </owl:Restriction>
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#Fare"/>
		                </owl:Restriction>
		                <owl:Class>
		                    <owl:complementOf>
		                        <owl:Restriction>
		                            <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                            <owl:someValuesFrom rdf:resource="#Wuhan"/>
		                        </owl:Restriction>
		                    </owl:complementOf>
		                </owl:Class>
		                <owl:Class>
		                    <owl:complementOf>
		                        <owl:Restriction>
		                            <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                            <owl:someValuesFrom rdf:resource="#Efeng"/>
		                        </owl:Restriction>
		                    </owl:complementOf>
		                </owl:Class>
		            </owl:intersectionOf>
		        </owl:Class>
		    </owl:equivalentClass>
		    <possibleSymptom rdf:resource="#Kesou"/>
		    <possibleSymptom rdf:resource="#Kouke"/>
		</owl:Class>

    <!-- 麻杏薏甘汤证（金匮·痉湿暍）—— 风湿在表，日晡所剧 -->
    <owl:Class rdf:about="#Maxingyigantangzheng">
        <rdfs:label xml:lang="zh">麻杏薏甘汤证</rdfs:label>
