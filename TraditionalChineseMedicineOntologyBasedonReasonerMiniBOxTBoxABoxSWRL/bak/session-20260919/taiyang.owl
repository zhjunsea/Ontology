    </owl:Class>

    <!-- 葛根黄芩黄连汤证 -->
    <owl:Class rdf:about="#Gegenhuangqinhuangliantangzheng">
        <rdfs:label xml:lang="zh">葛根黄芩黄连汤证</rdfs:label>
