                        <owl:someValuesFrom rdf:resource="#Fumai"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <!-- ============================================================ -->
    <!-- 三、葛根汤类家族                                              -->
    <!-- ============================================================ -->
    <owl:Class rdf:about="#Gegentangleifangzheng">
        <rdfs:label xml:lang="zh">葛根汤类方证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Jiazu"/>
        <hasFanggen rdf:resource="#GegenMahuanggen"/>
        <hasFanggen rdf:resource="#Gegen"/>
        <isAbstract rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isAbstract>
        <rdfs:comment xml:lang="zh">母方：葛根汤。共性（注释）：太阳阳明合病，解肌发汗。</rdfs:comment>
    </owl:Class>

    <!-- 葛根汤证（31、32条）—— 项背强几几，无汗恶风 -->
    <owl:Class rdf:about="#Gegentangzheng">
        <rdfs:label xml:lang="zh">葛根汤证</rdfs:label>
        <chufang rdf:resource="#Gegentang"/>
        <rdfs:subClassOf rdf:resource="#Gegentangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Taiyangbing"/>
        <belongsToLiujing rdf:resource="#Yangmingbing"/>
        <differentialAxis xml:lang="zh">项背强几几+无汗恶风（31、32条）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
        <bagangAttr rdf:resource="#Biao"/>
        <bagangAttr rdf:resource="#Yang"/>
        <bagangAttr rdf:resource="#Shi"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Taiyangbing"/>
                    <owl:Class rdf:about="#Yangmingbing"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                        <owl:someValuesFrom rdf:resource="#Xiangqiang"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                        <owl:someValuesFrom rdf:resource="#Wuhan"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                        <owl:someValuesFrom rdf:resource="#Efeng"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Fare"/>
        <possibleSymptom rdf:resource="#Ehan"/>
    </owl:Class>

    <!-- 葛根加半夏汤证（33条）—— 太阳阳明合病，但呕 -->
