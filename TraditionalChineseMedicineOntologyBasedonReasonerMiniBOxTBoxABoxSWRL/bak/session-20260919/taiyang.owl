                        <owl:someValuesFrom rdf:resource="#Wuhan"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                        <owl:someValuesFrom rdf:resource="#Kesou"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                        <owl:someValuesFrom rdf:resource="#Tanduoqingxi"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Chuan"/>
        <possibleSymptom rdf:resource="#Ganou"/>
        <possibleSymptom rdf:resource="#Fare"/>
        <possibleSymptom rdf:resource="#Kouke"/>
    </owl:Class>

    <!-- 小青龙加石膏汤证（金匮·肺痿肺痈咳嗽上气）—— 肺胀，咳喘烦躁 -->
    <owl:Class rdf:about="#Xiaoqinglongjiashigaotangzheng">
        <rdfs:label xml:lang="zh">小青龙加石膏汤证</rdfs:label>
