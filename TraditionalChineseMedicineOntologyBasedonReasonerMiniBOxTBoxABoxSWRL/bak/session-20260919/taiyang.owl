                        <owl:someValuesFrom rdf:resource="#Xiangqiang"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                        <owl:someValuesFrom rdf:resource="#Wuhan"/>
                    </owl:Restriction>
                    <owl:Restriction>
