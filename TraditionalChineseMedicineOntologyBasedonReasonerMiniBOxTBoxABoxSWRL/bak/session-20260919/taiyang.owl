                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Yudean"/></owl:Restriction>
            </owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <!-- 桂枝甘草龙骨牡蛎汤证 -->
    <owl:Class rdf:about="#Guizhigancaolonggumulitangzheng">
        <rdfs:label xml:lang="zh">桂枝甘草龙骨牡蛎汤证</rdfs:label>
        <chufang rdf:resource="#Guizhigancaolonggumulitang"/>
        <rdfs:subClassOf rdf:resource="#Guizhitangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Taiyangbing"/>
        <differentialAxis xml:lang="zh">烦躁；无无汗身疼（118条，火逆下之后）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
        <bagangAttr rdf:resource="#Biao"/>
        <bagangAttr rdf:resource="#Yang"/>
        <bagangAttr rdf:resource="#Xu"/>
        <bagangAttr rdf:resource="#Re"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Taiyangbing"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                        <owl:someValuesFrom rdf:resource="#Fanzao"/>
                    </owl:Restriction>
                    <owl:Class>
                        <owl:complementOf>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                                <owl:someValuesFrom rdf:resource="#Wuhan"/>
                            </owl:Restriction>
                        </owl:complementOf>
                    </owl:Class>
                    <owl:Class>
                        <owl:complementOf>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                                <owl:someValuesFrom rdf:resource="#Shentong"/>
                            </owl:Restriction>
                        </owl:complementOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <!-- 桂枝附子汤证 -->
    <owl:Class rdf:about="#Guizhifuzitangzheng">
        <rdfs:label xml:lang="zh">桂枝附子汤证</rdfs:label>
