                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                        <owl:someValuesFrom rdf:resource="#Fare"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                        <owl:someValuesFrom rdf:resource="#Ribusuoju"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Efeng"/>
        <possibleSymptom rdf:resource="#Ehan"/>
    </owl:Class>

    <!-- 麻黄连翘赤小豆汤证（262条）—— 瘀热在里，身必黄 -->
    <owl:Class rdf:about="#Mahuanglianqiaochixiaodoutangzheng">
        <rdfs:label xml:lang="zh">麻黄连翘赤小豆汤证</rdfs:label>
