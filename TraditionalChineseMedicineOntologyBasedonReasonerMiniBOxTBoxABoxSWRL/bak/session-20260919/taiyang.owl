<?xml version='1.0' encoding='UTF-8'?>
<rdf:RDF xmlns="http://www.tcm-classics.org/jingfang#" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:base="http://www.tcm-classics.org/jingfang#">

    <owl:Ontology rdf:about="http://www.tcm-classics.org/jingfang/taiyang">
        <rdfs:label xml:lang="zh">太阳表证系统（桂枝+麻黄+葛根）</rdfs:label>
        <rdfs:comment xml:lang="zh">含桂枝汤类、麻黄汤类、葛根汤类三大家族，共 47 方证。太阳表证系统。本文件不再重复声明 clinicalPriority、bagangAttr、addHerb，这些属性声明见 rules.owl。rules.owl 中原有的 clinicalPriority 与 bagangAttr 补充值已合并到本文件各具体类中。</rdfs:comment>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/core"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/zhengzhuang"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/maixiang"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/fangji"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/yaowu"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/fanggen"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/rules"/>
    </owl:Ontology>

    <!-- ============================================================ -->
    <!-- 一、桂枝汤类家族                                              -->
    <!-- ============================================================ -->
    <owl:Class rdf:about="#Guizhitangleifangzheng">
        <rdfs:label xml:lang="zh">桂枝汤类方证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Jiazu"/>
        <hasFanggen rdf:resource="#Guizhishaoyaogen"/>
        <isAbstract rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isAbstract>
        <rdfs:comment xml:lang="zh">母方：桂枝汤。共性（注释）：太阳中风表虚。徐灵胎桂枝汤类收小建中汤、苓桂枣甘汤、三合方，本本体按方根判据分别处理。</rdfs:comment>
    </owl:Class>

    <!-- 桂枝汤证 -->
    <owl:Class rdf:about="#Guizhitangzheng">
        <rdfs:label xml:lang="zh">桂枝汤证</rdfs:label>
        <chufang rdf:resource="#Guizhitang"/>
        <rdfs:subClassOf rdf:resource="#Guizhitangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Taiyangbing"/>
        <differentialAxis xml:lang="zh">发热汗出恶风脉缓（12条）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
        <bagangAttr rdf:resource="#Biao"/>
        <bagangAttr rdf:resource="#Yang"/>
        <bagangAttr rdf:resource="#Xu"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                <owl:Class rdf:about="#Taiyangbing"/><owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Fare"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Hanchu"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Efeng"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_maixiang"/><owl:someValuesFrom rdf:resource="#Huanmai"/></owl:Restriction>
            </owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Fumai"/>
    </owl:Class>

    <!-- 桂枝加葛根汤证 -->
    <owl:Class rdf:about="#Guizhijiagegentangzheng">
        <rdfs:label xml:lang="zh">桂枝加葛根汤证</rdfs:label>
        <chufang rdf:resource="#Guizhijiagegentang"/>
        <rdfs:subClassOf rdf:resource="#Guizhitangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Taiyangbing"/>
        <differentialAxis xml:lang="zh">项背强几几+汗出恶风（14条）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
        <bagangAttr rdf:resource="#Biao"/>
        <bagangAttr rdf:resource="#Yang"/>
        <bagangAttr rdf:resource="#Xu"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                <owl:Class rdf:about="#Taiyangbing"/><owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xiangbeiqiangjiji"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Hanchu"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Efeng"/></owl:Restriction>
            </owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <!-- 桂枝加厚朴杏子汤证 -->
    <owl:Class rdf:about="#Guizhijiahoupoxingzitangzheng">
        <rdfs:label xml:lang="zh">桂枝加厚朴杏子汤证</rdfs:label>
