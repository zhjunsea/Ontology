<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_1" targetNamespace="http://example.org/jingfang/bpmn" exporter="Camunda Modeler" exporterVersion="5.48.0">
  <!--
    经方辨证诊断流程（全自动版）
    设计约束：前端只负责「输入症状」与「展示结果 + 依据」，
    流程内部不得出现任何人工任务（userTask），必须由 JobWorker 一路跑到结束事件。
    因此：
      · 症状映射后直接进入四诊录入，不再有「人工确认症状映射」回环；
      · 一致性检查不通过 / 无方证推荐时，直接落到 EndEvent_NoResult，不再回到人工修改四诊。
  -->
  <bpmn:process id="Process_Jingfang_Diagnosis" name="经方辨证诊断流程" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="开始">
      <bpmn:outgoing>Flow_Start_To_Mapping</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- ==================== ① 症状映射（自然语言 → 症状实例个体） ==================== -->
    <bpmn:serviceTask id="Task_SymptomMapping" name="症状映射（自然语言→实例个体）">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="symptom-mapping" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_To_Mapping</bpmn:incoming>
      <bpmn:outgoing>Flow_Mapping_To_Input</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_InputSizhen" name="录入四诊信息">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="sizhen-input" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Mapping_To_Input</bpmn:incoming>
      <bpmn:outgoing>Flow_Input_To_Check</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ConsistencyCheck" name="本体一致性检查（Openllet）">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="ontology-consistency-check" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Input_To_Check</bpmn:incoming>
      <bpmn:outgoing>Flow_Check_To_Gateway1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Consistent" name="是否一致？">
      <bpmn:incoming>Flow_Check_To_Gateway1</bpmn:incoming>
      <bpmn:outgoing>Flow_Consistent_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Consistent_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Bagang" name="八纲分类">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="bagang-classification" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Consistent_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Bagang_To_Liujing</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Liujing" name="六经分类">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="liujing-classification" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Bagang_To_Liujing</bpmn:incoming>
      <bpmn:outgoing>Flow_Liujing_To_Fangzheng</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Fangzheng" name="方证分类">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="fangzheng-classification" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Liujing_To_Fangzheng</bpmn:incoming>
      <bpmn:outgoing>Flow_Fangzheng_To_JianJia</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_JianJiaZheng" name="兼夹证分类">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="jianjiazheng-classification" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Fangzheng_To_JianJia</bpmn:incoming>
      <bpmn:outgoing>Flow_JianJia_To_Prescription</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Prescription" name="方剂药物推荐（母方）">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="prescription-recommendation" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_JianJia_To_Prescription</bpmn:incoming>
      <bpmn:outgoing>Flow_Prescription_To_Modify</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- ==================== ② 加减药（方后注派生） ==================== -->
    <bpmn:serviceTask id="Task_HerbModification" name="加减药（方后注派生）">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="herb-modification" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Prescription_To_Modify</bpmn:incoming>
      <bpmn:outgoing>Flow_Modify_To_Explanation</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Explanation" name="生成诊断解释">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="diagnosis-explanation" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Modify_To_Explanation</bpmn:incoming>
      <bpmn:outgoing>Flow_Explanation_To_Gateway2</bpmn:outgoing>
    </bpmn:serviceTask>
    <!-- 结果形态网关：三条分支分别对应「完全命中 / 仅有候选 / 无候选」。
         条件依赖 fangzhengRealized + fangzhengCandidates（由 fangzheng-classification 输出）。
         另设 default=Flow_HasRecommendation_No 兜底：即使变量缺失也不会因
         "Expected at least one condition to evaluate to true" 而卡死。 -->
    <bpmn:exclusiveGateway id="Gateway_HasRecommendation" name="结果形态？" default="Flow_HasRecommendation_No">
      <bpmn:incoming>Flow_Explanation_To_Gateway2</bpmn:incoming>
      <bpmn:outgoing>Flow_HasRecommendation_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_HasRecommendation_Candidates</bpmn:outgoing>
      <bpmn:outgoing>Flow_HasRecommendation_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_Success" name="诊断完成">
      <bpmn:incoming>Flow_HasRecommendation_Yes</bpmn:incoming>
    </bpmn:endEvent>
    <!-- 候选终止：方证未被完全 realize 命中，但有候选 —— 输出 Top10 候选方证与各自命中的症状 -->
    <bpmn:endEvent id="EndEvent_Candidates" name="给出候选方证">
      <bpmn:incoming>Flow_HasRecommendation_Candidates</bpmn:incoming>
    </bpmn:endEvent>
    <!-- 无结果终止：一致性检查不通过，或全流程走完仍无任何方证候选 -->
    <bpmn:endEvent id="EndEvent_NoResult" name="无法给出诊断">
      <bpmn:incoming>Flow_Consistent_No</bpmn:incoming>
      <bpmn:incoming>Flow_HasRecommendation_No</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Start_To_Mapping" sourceRef="StartEvent_1" targetRef="Task_SymptomMapping" />
    <bpmn:sequenceFlow id="Flow_Mapping_To_Input" sourceRef="Task_SymptomMapping" targetRef="Task_InputSizhen" />
    <bpmn:sequenceFlow id="Flow_Input_To_Check" sourceRef="Task_InputSizhen" targetRef="Task_ConsistencyCheck" />
    <bpmn:sequenceFlow id="Flow_Check_To_Gateway1" sourceRef="Task_ConsistencyCheck" targetRef="Gateway_Consistent" />
    <bpmn:sequenceFlow id="Flow_Consistent_Yes" name="是" sourceRef="Gateway_Consistent" targetRef="Task_Bagang">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=consistent = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Consistent_No" name="否" sourceRef="Gateway_Consistent" targetRef="EndEvent_NoResult">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=consistent = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Bagang_To_Liujing" sourceRef="Task_Bagang" targetRef="Task_Liujing" />
    <bpmn:sequenceFlow id="Flow_Liujing_To_Fangzheng" sourceRef="Task_Liujing" targetRef="Task_Fangzheng" />
    <bpmn:sequenceFlow id="Flow_Fangzheng_To_JianJia" sourceRef="Task_Fangzheng" targetRef="Task_JianJiaZheng" />
    <bpmn:sequenceFlow id="Flow_JianJia_To_Prescription" sourceRef="Task_JianJiaZheng" targetRef="Task_Prescription" />
    <bpmn:sequenceFlow id="Flow_Prescription_To_Modify" sourceRef="Task_Prescription" targetRef="Task_HerbModification" />
    <bpmn:sequenceFlow id="Flow_Modify_To_Explanation" sourceRef="Task_HerbModification" targetRef="Task_Explanation" />
    <bpmn:sequenceFlow id="Flow_Explanation_To_Gateway2" sourceRef="Task_Explanation" targetRef="Gateway_HasRecommendation" />
    <bpmn:sequenceFlow id="Flow_HasRecommendation_Yes" name="完全命中" sourceRef="Gateway_HasRecommendation" targetRef="EndEvent_Success">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=fangzhengRealized = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_HasRecommendation_Candidates" name="仅有候选" sourceRef="Gateway_HasRecommendation" targetRef="EndEvent_Candidates">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=fangzhengRealized = false and fangzhengCandidates != null and fangzhengCandidates != []</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_HasRecommendation_No" name="无候选" sourceRef="Gateway_HasRecommendation" targetRef="EndEvent_NoResult">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=fangzhengRealized = false and (fangzhengCandidates = null or fangzhengCandidates = [])</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_Jingfang_Diagnosis">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="160" y="80" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="185" y="116" width="22" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SymptomMapping_di" bpmnElement="Task_SymptomMapping">
        <dc:Bounds x="260" y="60" width="100" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="266" y="70" width="88" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_InputSizhen_di" bpmnElement="Task_InputSizhen">
        <dc:Bounds x="560" y="60" width="100" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="570" y="70" width="80" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ConsistencyCheck_di" bpmnElement="Task_ConsistencyCheck">
        <dc:Bounds x="730" y="60" width="100" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="740" y="70" width="80" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Consistent_di" bpmnElement="Gateway_Consistent" isMarkerVisible="true">
        <dc:Bounds x="900" y="75" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="908" y="130" width="55" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Bagang_di" bpmnElement="Task_Bagang">
        <dc:Bounds x="1030" y="60" width="100" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1040" y="70" width="80" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Liujing_di" bpmnElement="Task_Liujing">
        <dc:Bounds x="1200" y="60" width="100" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1210" y="70" width="80" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Fangzheng_di" bpmnElement="Task_Fangzheng">
        <dc:Bounds x="1370" y="60" width="100" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1380" y="70" width="80" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_JianJiaZheng_di" bpmnElement="Task_JianJiaZheng">
        <dc:Bounds x="1540" y="60" width="100" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1550" y="70" width="80" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Prescription_di" bpmnElement="Task_Prescription">
        <dc:Bounds x="1710" y="60" width="100" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1716" y="70" width="88" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_HerbModification_di" bpmnElement="Task_HerbModification">
        <dc:Bounds x="1880" y="60" width="100" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1886" y="70" width="88" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Explanation_di" bpmnElement="Task_Explanation">
        <dc:Bounds x="2050" y="60" width="100" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2060" y="70" width="80" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_HasRecommendation_di" bpmnElement="Gateway_HasRecommendation" isMarkerVisible="true">
        <dc:Bounds x="2220" y="75" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2222" y="130" width="66" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Success_di" bpmnElement="EndEvent_Success">
        <dc:Bounds x="2350" y="80" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2364" y="116" width="44" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Candidates_di" bpmnElement="EndEvent_Candidates">
        <dc:Bounds x="2350" y="200" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2339" y="243" width="66" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_NoResult_di" bpmnElement="EndEvent_NoResult">
        <dc:Bounds x="907" y="240" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="897" y="283" width="66" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_To_Mapping_di" bpmnElement="Flow_Start_To_Mapping">
        <di:waypoint x="196" y="98" />
        <di:waypoint x="260" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Mapping_To_Input_di" bpmnElement="Flow_Mapping_To_Input">
        <di:waypoint x="360" y="100" />
        <di:waypoint x="560" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Input_To_Check_di" bpmnElement="Flow_Input_To_Check">
        <di:waypoint x="660" y="100" />
        <di:waypoint x="730" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Check_To_Gateway1_di" bpmnElement="Flow_Check_To_Gateway1">
        <di:waypoint x="830" y="100" />
        <di:waypoint x="900" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Consistent_Yes_di" bpmnElement="Flow_Consistent_Yes">
        <di:waypoint x="925" y="100" />
        <di:waypoint x="1030" y="100" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="972" y="75" width="11" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Consistent_No_di" bpmnElement="Flow_Consistent_No">
        <di:waypoint x="925" y="125" />
        <di:waypoint x="925" y="240" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="935" y="163" width="11" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Bagang_To_Liujing_di" bpmnElement="Flow_Bagang_To_Liujing">
        <di:waypoint x="1130" y="100" />
        <di:waypoint x="1200" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Liujing_To_Fangzheng_di" bpmnElement="Flow_Liujing_To_Fangzheng">
        <di:waypoint x="1300" y="100" />
        <di:waypoint x="1370" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Fangzheng_To_JianJia_di" bpmnElement="Flow_Fangzheng_To_JianJia">
        <di:waypoint x="1470" y="100" />
        <di:waypoint x="1540" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_JianJia_To_Prescription_di" bpmnElement="Flow_JianJia_To_Prescription">
        <di:waypoint x="1640" y="100" />
        <di:waypoint x="1710" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Prescription_To_Modify_di" bpmnElement="Flow_Prescription_To_Modify">
        <di:waypoint x="1810" y="100" />
        <di:waypoint x="1880" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Modify_To_Explanation_di" bpmnElement="Flow_Modify_To_Explanation">
        <di:waypoint x="1980" y="100" />
        <di:waypoint x="2050" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Explanation_To_Gateway2_di" bpmnElement="Flow_Explanation_To_Gateway2">
        <di:waypoint x="2150" y="100" />
        <di:waypoint x="2220" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_HasRecommendation_Yes_di" bpmnElement="Flow_HasRecommendation_Yes">
        <di:waypoint x="2245" y="100" />
        <di:waypoint x="2350" y="98" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2281" y="74" width="33" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_HasRecommendation_Candidates_di" bpmnElement="Flow_HasRecommendation_Candidates">
        <di:waypoint x="2245" y="125" />
        <di:waypoint x="2245" y="218" />
        <di:waypoint x="2350" y="218" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2252" y="163" width="44" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_HasRecommendation_No_di" bpmnElement="Flow_HasRecommendation_No">
        <di:waypoint x="2245" y="125" />
        <di:waypoint x="2245" y="258" />
        <di:waypoint x="943" y="258" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2244" y="163" width="33" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
