<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns="http://example.org/pizza/processes/classes/"
         xml:base="http://example.org/pizza/processes/classes/"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

    <owl:Ontology rdf:about="http://example.org/pizza/processes/classes">
        <rdfs:label xml:lang="zh"> 披萨流程 TBox（仅步骤节点）</rdfs:label>
        <rdfs:comment xml:lang="zh">定义工序步骤类、执行实例类及相关属性，不包含顺序流或网关。</rdfs:comment>
    </owl:Ontology>

    <!-- ======================== -->
    <!-- 流程类（仅步骤与执行）   -->
    <!-- ======================== -->
    <owl:Class rdf:about="ProcessStep">
        <rdfs:label xml:lang="zh">工序步骤</rdfs:label>
        <rdfs:comment xml:lang="zh">一个独立的工序节点，具体串接由 BPMN 定义。</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="ProcessExecution">
        <rdfs:label xml:lang="zh">工序执行实例</rdfs:label>
        <rdfs:comment xml:lang="zh">某个披萨实例中某一步骤的具体执行记录，可携带独立时长等数据。</rdfs:comment>
    </owl:Class>

    <!-- ======================== -->
    <!-- 对象属性                -->
    <!-- ======================== -->
    <owl:ObjectProperty rdf:about="hasProcessStep">
        <rdfs:domain rdf:resource="http://example.org/pizza/classes/Pizza"/>
        <rdfs:range rdf:resource="ProcessStep"/>
        <rdfs:label xml:lang="zh">制作工序</rdfs:label>
        <rdfs:comment xml:lang="zh">披萨所需包含的工序步骤（通常通过约束限定具体步骤）。</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="hasProcessExecution">
        <rdfs:domain rdf:resource="http://example.org/pizza/classes/Pizza"/>
        <rdfs:range rdf:resource="ProcessExecution"/>
        <rdfs:label xml:lang="zh">有工序执行</rdfs:label>
        <rdfs:comment xml:lang="zh">披萨实例关联的具体执行记录。</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="executesStep">
        <rdfs:domain rdf:resource="ProcessExecution"/>
        <rdfs:range rdf:resource="ProcessStep"/>
        <rdfs:label xml:lang="zh">执行步骤</rdfs:label>
        <rdfs:comment xml:lang="zh">该执行记录对应哪一个工序步骤。</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="producesComponent">
        <rdfs:domain rdf:resource="ProcessStep"/>
        <rdfs:range rdf:resource="http://example.org/pizza/components/classes/PizzaComponent"/>
        <rdfs:label xml:lang="zh">产出组件</rdfs:label>
        <rdfs:comment xml:lang="zh">该步骤产出或形成的披萨组件（如饼底）。</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="usesComponent">
        <rdfs:domain rdf:resource="ProcessStep"/>
        <rdfs:range rdf:resource="http://example.org/pizza/components/classes/PizzaComponent"/>
        <rdfs:label xml:lang="zh">使用组件</rdfs:label>
        <rdfs:comment xml:lang="zh">该步骤消耗或使用的披萨组件（如酱汁、奶酪、配料）。</rdfs:comment>
    </owl:ObjectProperty>

    <!-- ======================== -->
    <!-- 数据属性                -->
    <!-- ======================== -->
    <owl:DatatypeProperty rdf:about="operator">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:domain rdf:resource="ProcessStep"/>
        <rdfs:label xml:lang="zh">操作人员</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="startTime">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:domain rdf:resource="ProcessStep"/>
        <rdfs:label xml:lang="zh">开始时间</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="endTime">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:domain rdf:resource="ProcessStep"/>
        <rdfs:label xml:lang="zh">结束时间</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="duration">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:domain rdf:resource="ProcessStep"/>
        <rdfs:label xml:lang="zh">操作时长（分钟）</rdfs:label>
    </owl:DatatypeProperty>

</rdf:RDF>