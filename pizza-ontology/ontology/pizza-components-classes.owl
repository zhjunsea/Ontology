<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns="http://example.org/pizza/components/classes/"
         xml:base="http://example.org/pizza/components/classes/"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:skos="http://www.w3.org/2004/02/skos/core#">

    <owl:Ontology rdf:about="http://example.org/pizza/components/classes">
        <rdfs:label xml:lang="zh">披萨组件 TBox（最终版）</rdfs:label>
        <rdfs:comment xml:lang="zh">组件类定义，饼底子类使用内联厚度约束（完整 IRI），无枚举约束。</rdfs:comment>
        <owl:imports rdf:resource="file:///D:/work/Ontology/pizza-ontology/ontology/pizza-components-rules.ttl"/>
    </owl:Ontology>

    <!-- ======================== -->
    <!-- 组件类层级（抽象与叶子） -->
    <!-- ======================== -->
    <owl:Class rdf:about="http://example.org/pizza/components/classes/PizzaComponent">
        <rdfs:label xml:lang="zh">披萨组件</rdfs:label>
        <rdfs:comment xml:lang="zh">抽象类</rdfs:comment>
        <!-- 移除了 status 枚举约束 -->
    </owl:Class>

    <owl:Class rdf:about="http://example.org/pizza/components/classes/Crust">
        <rdfs:subClassOf rdf:resource="http://example.org/pizza/components/classes/PizzaComponent"/>
        <rdfs:label xml:lang="zh">饼底</rdfs:label>
        <rdfs:comment xml:lang="zh">抽象类</rdfs:comment>
        <!-- 新增阈值注解 -->
        <minStockThreshold rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20</minStockThreshold>
        <skos:exactMatch rdf:resource="http://example.org/pizza/term/Crust"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/pizza/components/classes/Sauce">
        <rdfs:subClassOf rdf:resource="http://example.org/pizza/components/classes/PizzaComponent"/>
        <rdfs:label xml:lang="zh">酱汁</rdfs:label>
        <rdfs:comment xml:lang="zh">抽象类</rdfs:comment>
        <minStockThreshold rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</minStockThreshold>
        <skos:exactMatch rdf:resource="http://example.org/pizza/term/Sauce"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/pizza/components/classes/Cheese">
        <rdfs:subClassOf rdf:resource="http://example.org/pizza/components/classes/PizzaComponent"/>
        <rdfs:label xml:lang="zh">奶酪</rdfs:label>
        <rdfs:comment xml:lang="zh">抽象类</rdfs:comment>
        <minStockThreshold rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</minStockThreshold>
        <skos:exactMatch rdf:resource="http://example.org/pizza/term/Cheese"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/pizza/components/classes/Topping">
        <rdfs:subClassOf rdf:resource="http://example.org/pizza/components/classes/PizzaComponent"/>
        <rdfs:label xml:lang="zh">配料</rdfs:label>
        <rdfs:comment xml:lang="zh">抽象类</rdfs:comment>
        <minStockThreshold rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</minStockThreshold>
        <skos:exactMatch rdf:resource="http://example.org/pizza/term/Topping"/>
    </owl:Class>

    <!-- ======================== -->
    <!-- 饼底叶子子类（内联厚度约束） -->
    <!-- ======================== -->
    <!-- 薄饼类：厚度 3.0 ~ 7.0 -->
    <owl:Class rdf:about="http://example.org/pizza/components/classes/NeapolitanCrust">
        <rdfs:subClassOf rdf:resource="http://example.org/pizza/components/classes/Crust"/>
        <rdfs:label xml:lang="zh">那不勒斯饼底</rdfs:label>
        <skos:exactMatch rdf:resource="http://example.org/pizza/term/NeapolitanCrust"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/pizza/components/classes/crustThicknessMm"/>
                <owl:allValuesFrom>
                    <rdfs:Datatype>
                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
                        <owl:withRestrictions rdf:parseType="Collection">
                            <rdf:Description>
                                <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">3.0</xsd:minInclusive>
                            </rdf:Description>
                            <rdf:Description>
                                <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">7.0</xsd:maxInclusive>
                            </rdf:Description>
                        </owl:withRestrictions>
                    </rdfs:Datatype>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/pizza/components/classes/NewYorkCrust">
        <rdfs:subClassOf rdf:resource="http://example.org/pizza/components/classes/Crust"/>
        <rdfs:label xml:lang="zh">纽约饼底</rdfs:label>
        <skos:exactMatch rdf:resource="http://example.org/pizza/term/NewYorkCrust"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/pizza/components/classes/crustThicknessMm"/>
                <owl:allValuesFrom>
                    <rdfs:Datatype>
                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
                        <owl:withRestrictions rdf:parseType="Collection">
                            <rdf:Description><xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">3.0</xsd:minInclusive></rdf:Description>
                            <rdf:Description><xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">7.0</xsd:maxInclusive></rdf:Description>
                        </owl:withRestrictions>
                    </rdfs:Datatype>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/pizza/components/classes/StLouisCrackerCrust">
        <rdfs:subClassOf rdf:resource="http://example.org/pizza/components/classes/Crust"/>
        <rdfs:label xml:lang="zh">圣路易斯薄脆饼底</rdfs:label>
        <skos:exactMatch rdf:resource="http://example.org/pizza/term/StLouisCrackerCrust"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/pizza/components/classes/crustThicknessMm"/>
                <owl:allValuesFrom>
                    <rdfs:Datatype>
                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
                        <owl:withRestrictions rdf:parseType="Collection">
                            <rdf:Description><xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">3.0</xsd:minInclusive></rdf:Description>
                            <rdf:Description><xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">7.0</xsd:maxInclusive></rdf:Description>
                        </owl:withRestrictions>
                    </rdfs:Datatype>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/pizza/components/classes/RomanTondaCrust">
        <rdfs:subClassOf rdf:resource="http://example.org/pizza/components/classes/Crust"/>
        <rdfs:label xml:lang="zh">罗马圆形薄脆饼底</rdfs:label>
        <skos:exactMatch rdf:resource="http://example.org/pizza/term/RomanTondaCrust"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/pizza/components/classes/crustThicknessMm"/>
                <owl:allValuesFrom>
                    <rdfs:Datatype>
                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
                        <owl:withRestrictions rdf:parseType="Collection">
                            <rdf:Description><xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">3.0</xsd:minInclusive></rdf:Description>
                            <rdf:Description><xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">7.0</xsd:maxInclusive></rdf:Description>
                        </owl:withRestrictions>
                    </rdfs:Datatype>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/pizza/components/classes/FrenchThinCrust">
        <rdfs:subClassOf rdf:resource="http://example.org/pizza/components/classes/Crust"/>
        <rdfs:label xml:lang="zh">法式薄饼底</rdfs:label>
        <skos:exactMatch rdf:resource="http://example.org/pizza/term/FrenchThinCrust"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/pizza/components/classes/crustThicknessMm"/>
                <owl:allValuesFrom>
                    <rdfs:Datatype>
                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
                        <owl:withRestrictions rdf:parseType="Collection">
                            <rdf:Description><xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">3.0</xsd:minInclusive></rdf:Description>
                            <rdf:Description><xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">7.0</xsd:maxInclusive></rdf:Description>
                        </owl:withRestrictions>
                    </rdfs:Datatype>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <!-- 厚饼类：厚度 20.0 ~ 80.0 -->
    <owl:Class rdf:about="http://example.org/pizza/components/classes/ChicagoDeepDishCrust">
        <rdfs:subClassOf rdf:resource="http://example.org/pizza/components/classes/Crust"/>
        <rdfs:label xml:lang="zh">芝加哥深盘饼底</rdfs:label>
        <skos:exactMatch rdf:resource="http://example.org/pizza/term/ChicagoDeepDishCrust"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/pizza/components/classes/crustThicknessMm"/>
                <owl:allValuesFrom>
                    <rdfs:Datatype>
                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
                        <owl:withRestrictions rdf:parseType="Collection">
                            <rdf:Description><xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">20.0</xsd:minInclusive></rdf:Description>
                            <rdf:Description><xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">80.0</xsd:maxInclusive></rdf:Description>
                        </owl:withRestrictions>
                    </rdfs:Datatype>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

