    <!-- ======================== -->
    <!-- 酱汁叶子子类 -->
    <!-- ======================== -->
    <owl:Class rdf:about="http://example.org/pizza/components/classes/TomatoSauce"><rdfs:subClassOf rdf:resource="http://example.org/pizza/components/classes/Sauce"/><rdfs:label xml:lang="zh">番茄红酱</rdfs:label><skos:exactMatch rdf:resource="http://example.org/pizza/term/TomatoSauce"/></owl:Class>
    <owl:Class rdf:about="http://example.org/pizza/components/classes/NeapolitanTomatoSauce"><rdfs:subClassOf rdf:resource="http://example.org/pizza/components/classes/TomatoSauce"/><rdfs:label xml:lang="zh">那不勒斯红酱</rdfs:label><skos:exactMatch rdf:resource="http://example.org/pizza/term/NeapolitanTomatoSauce"/></owl:Class>
    <owl:Class rdf:about="http://example.org/pizza/components/classes/AmericanTomatoSauce"><rdfs:subClassOf rdf:resource="http://example.org/pizza/components/classes/TomatoSauce"/><rdfs:label xml:lang="zh">美式红酱</rdfs:label><skos:exactMatch rdf:resource="http://example.org/pizza/term/AmericanTomatoSauce"/></owl:Class>
    <owl:Class rdf:about="http://example.org/pizza/components/classes/WhiteSauce"><rdfs:subClassOf rdf:resource="http://example.org/pizza/components/classes/Sauce"/><rdfs:label xml:lang="zh">白酱</rdfs:label><skos:exactMatch rdf:resource="http://example.org/pizza/term/WhiteSauce"/></owl:Class>
    <owl:Class rdf:about="http://example.org/pizza/components/classes/OtherSauce"><rdfs:subClassOf rdf:resource="http://example.org/pizza/components/classes/Sauce"/><rdfs:label xml:lang="zh">其他酱汁</rdfs:label><skos:exactMatch rdf:resource="http://example.org/pizza/term/OtherSauce"/></owl:Class>

    <!-- ======================== -->
    <!-- 奶酪叶子子类 -->
    <!-- ======================== -->
    <owl:Class rdf:about="http://example.org/pizza/components/classes/BuffaloMozzarella"><rdfs:subClassOf rdf:resource="http://example.org/pizza/components/classes/Cheese"/><rdfs:label xml:lang="zh">水牛奶酪</rdfs:label><skos:exactMatch rdf:resource="http://example.org/pizza/term/BuffaloMozzarella"/></owl:Class>
    <owl:Class rdf:about="http://example.org/pizza/components/classes/LowMoistureMozzarella"><rdfs:subClassOf rdf:resource="http://example.org/pizza/components/classes/Cheese"/><rdfs:label xml:lang="zh">低水分马苏里拉</rdfs:label><skos:exactMatch rdf:resource="http://example.org/pizza/term/LowMoistureMozzarella"/></owl:Class>
    <owl:Class rdf:about="http://example.org/pizza/components/classes/Parmesan"><rdfs:subClassOf rdf:resource="http://example.org/pizza/components/classes/Cheese"/><rdfs:label xml:lang="zh">帕玛森芝士</rdfs:label><skos:exactMatch rdf:resource="http://example.org/pizza/term/Parmesan"/></owl:Class>
    <owl:Class rdf:about="http://example.org/pizza/components/classes/ProvelCheese"><rdfs:subClassOf rdf:resource="http://example.org/pizza/components/classes/Cheese"/><rdfs:label xml:lang="zh">普罗维尔奶酪</rdfs:label><skos:exactMatch rdf:resource="http://example.org/pizza/term/ProvelCheese"/></owl:Class>

    <!-- ======================== -->
    <!-- 配料叶子子类（互斥） -->
    <!-- ======================== -->
    <owl:Class rdf:about="http://example.org/pizza/components/classes/MeatTopping"><rdfs:subClassOf rdf:resource="http://example.org/pizza/components/classes/Topping"/><rdfs:label xml:lang="zh">肉类配料</rdfs:label><skos:exactMatch rdf:resource="http://example.org/pizza/term/MeatTopping"/></owl:Class>
    <owl:Class rdf:about="http://example.org/pizza/components/classes/VegetableTopping"><rdfs:subClassOf rdf:resource="http://example.org/pizza/components/classes/Topping"/><rdfs:label xml:lang="zh">蔬菜配料</rdfs:label><skos:exactMatch rdf:resource="http://example.org/pizza/term/VegetableTopping"/></owl:Class>
    <owl:Class rdf:about="http://example.org/pizza/components/classes/SeafoodTopping"><rdfs:subClassOf rdf:resource="http://example.org/pizza/components/classes/Topping"/><rdfs:label xml:lang="zh">海鲜配料</rdfs:label><skos:exactMatch rdf:resource="http://example.org/pizza/term/SeafoodTopping"/></owl:Class>
    <owl:Class rdf:about="http://example.org/pizza/components/classes/HerbTopping"><rdfs:subClassOf rdf:resource="http://example.org/pizza/components/classes/Topping"/><rdfs:label xml:lang="zh">香草配料</rdfs:label><skos:exactMatch rdf:resource="http://example.org/pizza/term/HerbTopping"/></owl:Class>
    <owl:Class rdf:about="http://example.org/pizza/components/classes/FruitTopping"><rdfs:subClassOf rdf:resource="http://example.org/pizza/components/classes/Topping"/><rdfs:label xml:lang="zh">水果配料</rdfs:label><skos:exactMatch rdf:resource="http://example.org/pizza/term/FruitTopping"/></owl:Class>

    <owl:AllDisjointClasses>
        <owl:members rdf:parseType="Collection">
            <owl:Class rdf:about="http://example.org/pizza/components/classes/MeatTopping"/>
            <owl:Class rdf:about="http://example.org/pizza/components/classes/VegetableTopping"/>
            <owl:Class rdf:about="http://example.org/pizza/components/classes/SeafoodTopping"/>
            <owl:Class rdf:about="http://example.org/pizza/components/classes/HerbTopping"/>
            <owl:Class rdf:about="http://example.org/pizza/components/classes/FruitTopping"/>
        </owl:members>
    </owl:AllDisjointClasses>

    <owl:Class rdf:about="http://example.org/pizza/components/classes/WhiteSauce">
        <owl:disjointWith rdf:resource="http://example.org/pizza/components/classes/TomatoSauce"/>
    </owl:Class>

    <!-- ======================== -->
    <!-- 数据属性 -->
    <!-- ======================== -->
    <owl:DatatypeProperty rdf:about="http://example.org/pizza/components/classes/crustThicknessMm">
        <rdfs:domain rdf:resource="http://example.org/pizza/components/classes/PizzaComponent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:label xml:lang="zh">饼底厚度(毫米)</rdfs:label>
    </owl:DatatypeProperty>
    
    <owl:DatatypeProperty rdf:about="http://example.org/pizza/components/classes/bakingTemperatureCelsius">
        <rdfs:domain rdf:resource="http://example.org/pizza/components/classes/PizzaComponent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="zh">烘烤温度(°C)</rdfs:label>
    </owl:DatatypeProperty>
    
    <owl:DatatypeProperty rdf:about="http://example.org/pizza/components/classes/bakingTimeSeconds">
        <rdfs:domain rdf:resource="http://example.org/pizza/components/classes/PizzaComponent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="zh">烘烤时间(秒)</rdfs:label>
    </owl:DatatypeProperty>
    
    <owl:DatatypeProperty rdf:about="http://example.org/pizza/components/classes/flourType">
        <rdfs:domain rdf:resource="http://example.org/pizza/components/classes/PizzaComponent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="zh">面粉种类</rdfs:label>
    </owl:DatatypeProperty>
    
    <owl:DatatypeProperty rdf:about="http://example.org/pizza/components/classes/fermentation">
        <rdfs:domain rdf:resource="http://example.org/pizza/components/classes/PizzaComponent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="zh">发酵方式</rdfs:label>
    </owl:DatatypeProperty>
    
    <owl:DatatypeProperty rdf:about="http://example.org/pizza/components/classes/status">
        <rdfs:domain rdf:resource="http://example.org/pizza/components/classes/PizzaComponent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="zh">状态</rdfs:label>
    </owl:DatatypeProperty>
    
    <owl:DatatypeProperty rdf:about="http://example.org/pizza/components/classes/supplier">
        <rdfs:domain rdf:resource="http://example.org/pizza/components/classes/PizzaComponent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="zh">供应商</rdfs:label>
    </owl:DatatypeProperty>
    
    <owl:DatatypeProperty rdf:about="http://example.org/pizza/components/classes/batchNumber">
        <rdfs:domain rdf:resource="http://example.org/pizza/components/classes/PizzaComponent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="zh">批次</rdfs:label>
    </owl:DatatypeProperty>
    
    <owl:DatatypeProperty rdf:about="http://example.org/pizza/components/classes/price">
        <rdfs:domain rdf:resource="http://example.org/pizza/components/classes/PizzaComponent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label xml:lang="zh">价格</rdfs:label>
    </owl:DatatypeProperty>
    
    <owl:DatatypeProperty rdf:about="http://example.org/pizza/components/classes/purchaseDate">
        <rdfs:domain rdf:resource="http://example.org/pizza/components/classes/PizzaComponent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:label xml:lang="zh">进货日期</rdfs:label>
    </owl:DatatypeProperty>
    
    <owl:DatatypeProperty rdf:about="http://example.org/pizza/components/classes/shelfLife">
        <rdfs:domain rdf:resource="http://example.org/pizza/components/classes/PizzaComponent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="zh">保质期</rdfs:label>
    </owl:DatatypeProperty>
    
    <owl:DatatypeProperty rdf:about="http://example.org/pizza/components/classes/stockQuantity">
        <rdfs:domain rdf:resource="http://example.org/pizza/components/classes/PizzaComponent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="zh">存量</rdfs:label>
    </owl:DatatypeProperty>
    
    <owl:DatatypeProperty rdf:about="http://example.org/pizza/components/classes/isDataValid">
        <rdfs:domain rdf:resource="http://example.org/pizza/components/classes/PizzaComponent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label xml:lang="zh">数据是否有效</rdfs:label>
    </owl:DatatypeProperty>
    
    <!-- 自定义注解属性：最低库存阈值 -->
    <owl:AnnotationProperty rdf:about="http://example.org/pizza/components/classes/minStockThreshold">
        <rdfs:label xml:lang="zh">最低库存阈值</rdfs:label>
        <rdfs:comment xml:lang="zh">该类组件触发低库存警告的库存数量下限（整数）</rdfs:comment>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:AnnotationProperty>
    
    <!-- 父类：LowStockComponent -->
    <owl:Class rdf:about="http://example.org/pizza/components/classes/LowStockComponent">
        <rdfs:subClassOf rdf:resource="http://example.org/pizza/components/classes/PizzaComponent"/>
        <rdfs:label xml:lang="zh">低库存组件</rdfs:label>
        <rdfs:comment xml:lang="zh">库存量低于各自阈值的披萨组件（抽象父类）</rdfs:comment>
    </owl:Class>
    
    <!-- 子类：低库存饼底 -->
    <owl:Class rdf:about="http://example.org/pizza/components/classes/LowStockCrust">
        <rdfs:subClassOf rdf:resource="http://example.org/pizza/components/classes/LowStockComponent"/>
        <rdfs:label xml:lang="zh">低库存饼底</rdfs:label>
        <rdfs:comment xml:lang="zh">库存量低于20的饼底类组件</rdfs:comment>
    </owl:Class>
    
    <!-- 子类：低库存酱汁 -->
    <owl:Class rdf:about="http://example.org/pizza/components/classes/LowStockSauce">
        <rdfs:subClassOf rdf:resource="http://example.org/pizza/components/classes/LowStockComponent"/>
        <rdfs:label xml:lang="zh">低库存酱汁</rdfs:label>
        <rdfs:comment xml:lang="zh">库存量低于15的酱汁类组件</rdfs:comment>
    </owl:Class>
    
    <!-- 子类：低库存奶酪 -->
    <owl:Class rdf:about="http://example.org/pizza/components/classes/LowStockCheese">
        <rdfs:subClassOf rdf:resource="http://example.org/pizza/components/classes/LowStockComponent"/>
        <rdfs:label xml:lang="zh">低库存奶酪</rdfs:label>
        <rdfs:comment xml:lang="zh">库存量低于10的奶酪类组件</rdfs:comment>
    </owl:Class>
    
    <!-- 子类：低库存配料 -->
    <owl:Class rdf:about="http://example.org/pizza/components/classes/LowStockTopping">
        <rdfs:subClassOf rdf:resource="http://example.org/pizza/components/classes/LowStockComponent"/>
        <rdfs:label xml:lang="zh">低库存配料</rdfs:label>
        <rdfs:comment xml:lang="zh">库存量低于10的配料类组件</rdfs:comment>
    </owl:Class>

</rdf:RDF>