<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns="http://example.org/pizza/components/classes/"
         xml:base="http://example.org/pizza/components/classes/"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:skos="http://www.w3.org/2004/02/skos/core#">

    <owl:Ontology rdf:about="http://example.org/pizza/components/classes">
        <rdfs:label xml:lang="zh">披萨组件 TBox（最终版）</rdfs:label>
        <rdfs:comment xml:lang="zh">组件类定义，饼底子类使用内联厚度约束（完整 IRI），无枚举约束。</rdfs:comment>
    </owl:Ontology>

    <!-- ======================== -->
    <!-- 组件类层级（抽象与叶子） -->
    <!-- ======================== -->
    <owl:Class rdf:about="PizzaComponent">
        <rdfs:label xml:lang="zh">披萨组件</rdfs:label>
        <rdfs:comment xml:lang="zh">抽象类</rdfs:comment>
        <!-- 移除了 status 枚举约束 -->
    </owl:Class>

    <owl:Class rdf:about="Crust">
        <rdfs:subClassOf rdf:resource="PizzaComponent"/>
        <rdfs:label xml:lang="zh">饼底</rdfs:label>
        <rdfs:comment xml:lang="zh">抽象类</rdfs:comment>
        <skos:exactMatch rdf:resource="http://example.org/pizza/term/Crust"/>
    </owl:Class>

    <owl:Class rdf:about="Sauce">
        <rdfs:subClassOf rdf:resource="PizzaComponent"/>
        <rdfs:label xml:lang="zh">酱汁</rdfs:label>
        <rdfs:comment xml:lang="zh">抽象类</rdfs:comment>
        <skos:exactMatch rdf:resource="http://example.org/pizza/term/Sauce"/>
    </owl:Class>

    <owl:Class rdf:about="Cheese">
        <rdfs:subClassOf rdf:resource="PizzaComponent"/>
        <rdfs:label xml:lang="zh">奶酪</rdfs:label>
        <rdfs:comment xml:lang="zh">抽象类</rdfs:comment>
        <skos:exactMatch rdf:resource="http://example.org/pizza/term/Cheese"/>
    </owl:Class>

    <owl:Class rdf:about="Topping">
        <rdfs:subClassOf rdf:resource="PizzaComponent"/>
        <rdfs:label xml:lang="zh">配料</rdfs:label>
        <rdfs:comment xml:lang="zh">抽象类</rdfs:comment>
        <skos:exactMatch rdf:resource="http://example.org/pizza/term/Topping"/>
    </owl:Class>

    <!-- ======================== -->
    <!-- 饼底叶子子类（内联厚度约束） -->
    <!-- ======================== -->
    <!-- 薄饼类：厚度 3.0 ~ 7.0 -->
    <owl:Class rdf:about="NeapolitanCrust">
        <rdfs:subClassOf rdf:resource="Crust"/>
        <rdfs:label xml:lang="zh">那不勒斯饼底</rdfs:label>
        <skos:exactMatch rdf:resource="http://example.org/pizza/term/NeapolitanCrust"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="crustThicknessMm"/>
                <owl:allValuesFrom>
                    <rdfs:Datatype>
                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
                        <owl:withRestrictions rdf:parseType="Collection">
                            <rdf:Description>
                                <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">3.0</xsd:minInclusive>
                            </rdf:Description>
                            <rdf:Description>
                                <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">7.0</xsd:maxInclusive>
                            </rdf:Description>
                        </owl:withRestrictions>
                    </rdfs:Datatype>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="NewYorkCrust">
        <rdfs:subClassOf rdf:resource="Crust"/>
        <rdfs:label xml:lang="zh">纽约饼底</rdfs:label>
        <skos:exactMatch rdf:resource="http://example.org/pizza/term/NewYorkCrust"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="crustThicknessMm"/>
                <owl:allValuesFrom>
                    <rdfs:Datatype>
                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
                        <owl:withRestrictions rdf:parseType="Collection">
                            <rdf:Description><xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">3.0</xsd:minInclusive></rdf:Description>
                            <rdf:Description><xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">7.0</xsd:maxInclusive></rdf:Description>
                        </owl:withRestrictions>
                    </rdfs:Datatype>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="StLouisCrackerCrust">
        <rdfs:subClassOf rdf:resource="Crust"/>
        <rdfs:label xml:lang="zh">圣路易斯薄脆饼底</rdfs:label>
        <skos:exactMatch rdf:resource="http://example.org/pizza/term/StLouisCrackerCrust"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="crustThicknessMm"/>
                <owl:allValuesFrom>
                    <rdfs:Datatype>
                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
                        <owl:withRestrictions rdf:parseType="Collection">
                            <rdf:Description><xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">3.0</xsd:minInclusive></rdf:Description>
                            <rdf:Description><xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">7.0</xsd:maxInclusive></rdf:Description>
                        </owl:withRestrictions>
                    </rdfs:Datatype>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="RomanTondaCrust">
        <rdfs:subClassOf rdf:resource="Crust"/>
        <rdfs:label xml:lang="zh">罗马圆形薄脆饼底</rdfs:label>
        <skos:exactMatch rdf:resource="http://example.org/pizza/term/RomanTondaCrust"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="crustThicknessMm"/>
                <owl:allValuesFrom>
                    <rdfs:Datatype>
                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
                        <owl:withRestrictions rdf:parseType="Collection">
                            <rdf:Description><xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">3.0</xsd:minInclusive></rdf:Description>
                            <rdf:Description><xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">7.0</xsd:maxInclusive></rdf:Description>
                        </owl:withRestrictions>
                    </rdfs:Datatype>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="FrenchThinCrust">
        <rdfs:subClassOf rdf:resource="Crust"/>
        <rdfs:label xml:lang="zh">法式薄饼底</rdfs:label>
        <skos:exactMatch rdf:resource="http://example.org/pizza/term/FrenchThinCrust"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="crustThicknessMm"/>
                <owl:allValuesFrom>
                    <rdfs:Datatype>
                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
                        <owl:withRestrictions rdf:parseType="Collection">
                            <rdf:Description><xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">3.0</xsd:minInclusive></rdf:Description>
                            <rdf:Description><xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">7.0</xsd:maxInclusive></rdf:Description>
                        </owl:withRestrictions>
                    </rdfs:Datatype>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <!-- 厚饼类：厚度 20.0 ~ 80.0 -->
    <owl:Class rdf:about="ChicagoDeepDishCrust">
        <rdfs:subClassOf rdf:resource="Crust"/>
        <rdfs:label xml:lang="zh">芝加哥深盘饼底</rdfs:label>
        <skos:exactMatch rdf:resource="http://example.org/pizza/term/ChicagoDeepDishCrust"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="crustThicknessMm"/>
                <owl:allValuesFrom>
                    <rdfs:Datatype>
                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
                        <owl:withRestrictions rdf:parseType="Collection">
                            <rdf:Description><xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">20.0</xsd:minInclusive></rdf:Description>
                            <rdf:Description><xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">80.0</xsd:maxInclusive></rdf:Description>
                        </owl:withRestrictions>
                    </rdfs:Datatype>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="DetroitCrust">
        <rdfs:subClassOf rdf:resource="Crust"/>
        <rdfs:label xml:lang="zh">底特律饼底</rdfs:label>
        <skos:exactMatch rdf:resource="http://example.org/pizza/term/DetroitCrust"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="crustThicknessMm"/>
                <owl:allValuesFrom>
                    <rdfs:Datatype>
                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
                        <owl:withRestrictions rdf:parseType="Collection">
                            <rdf:Description><xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">20.0</xsd:minInclusive></rdf:Description>
                            <rdf:Description><xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">80.0</xsd:maxInclusive></rdf:Description>
                        </owl:withRestrictions>
                    </rdfs:Datatype>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="SicilianCrust">
        <rdfs:subClassOf rdf:resource="Crust"/>
        <rdfs:label xml:lang="zh">西西里饼底</rdfs:label>
        <skos:exactMatch rdf:resource="http://example.org/pizza/term/SicilianCrust"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="crustThicknessMm"/>
                <owl:allValuesFrom>
                    <rdfs:Datatype>
                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
                        <owl:withRestrictions rdf:parseType="Collection">
                            <rdf:Description><xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">20.0</xsd:minInclusive></rdf:Description>
                            <rdf:Description><xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">80.0</xsd:maxInclusive></rdf:Description>
                        </owl:withRestrictions>
                    </rdfs:Datatype>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="RomanAlTaglioCrust">
        <rdfs:subClassOf rdf:resource="Crust"/>
        <rdfs:label xml:lang="zh">罗马长条切块饼底</rdfs:label>
        <skos:exactMatch rdf:resource="http://example.org/pizza/term/RomanAlTaglioCrust"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="crustThicknessMm"/>
                <owl:allValuesFrom>
                    <rdfs:Datatype>
                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
                        <owl:withRestrictions rdf:parseType="Collection">
                            <rdf:Description><xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">20.0</xsd:minInclusive></rdf:Description>
                            <rdf:Description><xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">80.0</xsd:maxInclusive></rdf:Description>
                        </owl:withRestrictions>
                    </rdfs:Datatype>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="ArgentinianThickCrust">
        <rdfs:subClassOf rdf:resource="Crust"/>
        <rdfs:label xml:lang="zh">阿根廷厚饼底</rdfs:label>
        <skos:exactMatch rdf:resource="http://example.org/pizza/term/ArgentinianThickCrust"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="crustThicknessMm"/>
                <owl:allValuesFrom>
                    <rdfs:Datatype>
                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
                        <owl:withRestrictions rdf:parseType="Collection">
                            <rdf:Description><xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">20.0</xsd:minInclusive></rdf:Description>
                            <rdf:Description><xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">80.0</xsd:maxInclusive></rdf:Description>
                        </owl:withRestrictions>
                    </rdfs:Datatype>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <!-- ======================== -->
    <!-- 酱汁叶子子类 -->
    <!-- ======================== -->
    <owl:Class rdf:about="TomatoSauce"><rdfs:subClassOf rdf:resource="Sauce"/><rdfs:label xml:lang="zh">番茄红酱</rdfs:label><skos:exactMatch rdf:resource="http://example.org/pizza/term/TomatoSauce"/></owl:Class>
    <owl:Class rdf:about="NeapolitanTomatoSauce"><rdfs:subClassOf rdf:resource="TomatoSauce"/><rdfs:label xml:lang="zh">那不勒斯红酱</rdfs:label><skos:exactMatch rdf:resource="http://example.org/pizza/term/NeapolitanTomatoSauce"/></owl:Class>
    <owl:Class rdf:about="AmericanTomatoSauce"><rdfs:subClassOf rdf:resource="TomatoSauce"/><rdfs:label xml:lang="zh">美式红酱</rdfs:label><skos:exactMatch rdf:resource="http://example.org/pizza/term/AmericanTomatoSauce"/></owl:Class>
    <owl:Class rdf:about="WhiteSauce"><rdfs:subClassOf rdf:resource="Sauce"/><rdfs:label xml:lang="zh">白酱</rdfs:label><skos:exactMatch rdf:resource="http://example.org/pizza/term/WhiteSauce"/></owl:Class>
    <owl:Class rdf:about="OtherSauce"><rdfs:subClassOf rdf:resource="Sauce"/><rdfs:label xml:lang="zh">其他酱汁</rdfs:label><skos:exactMatch rdf:resource="http://example.org/pizza/term/OtherSauce"/></owl:Class>

    <!-- ======================== -->
    <!-- 奶酪叶子子类 -->
    <!-- ======================== -->
    <owl:Class rdf:about="BuffaloMozzarella"><rdfs:subClassOf rdf:resource="Cheese"/><rdfs:label xml:lang="zh">水牛奶酪</rdfs:label><skos:exactMatch rdf:resource="http://example.org/pizza/term/BuffaloMozzarella"/></owl:Class>
    <owl:Class rdf:about="LowMoistureMozzarella"><rdfs:subClassOf rdf:resource="Cheese"/><rdfs:label xml:lang="zh">低水分马苏里拉</rdfs:label><skos:exactMatch rdf:resource="http://example.org/pizza/term/LowMoistureMozzarella"/></owl:Class>
    <owl:Class rdf:about="Parmesan"><rdfs:subClassOf rdf:resource="Cheese"/><rdfs:label xml:lang="zh">帕玛森芝士</rdfs:label><skos:exactMatch rdf:resource="http://example.org/pizza/term/Parmesan"/></owl:Class>
    <owl:Class rdf:about="ProvelCheese"><rdfs:subClassOf rdf:resource="Cheese"/><rdfs:label xml:lang="zh">普罗维尔奶酪</rdfs:label><skos:exactMatch rdf:resource="http://example.org/pizza/term/ProvelCheese"/></owl:Class>

    <!-- ======================== -->
    <!-- 配料叶子子类（互斥） -->
    <!-- ======================== -->
    <owl:Class rdf:about="MeatTopping"><rdfs:subClassOf rdf:resource="Topping"/><rdfs:label xml:lang="zh">肉类配料</rdfs:label><skos:exactMatch rdf:resource="http://example.org/pizza/term/MeatTopping"/></owl:Class>
    <owl:Class rdf:about="VegetableTopping"><rdfs:subClassOf rdf:resource="Topping"/><rdfs:label xml:lang="zh">蔬菜配料</rdfs:label><skos:exactMatch rdf:resource="http://example.org/pizza/term/VegetableTopping"/></owl:Class>
    <owl:Class rdf:about="SeafoodTopping"><rdfs:subClassOf rdf:resource="Topping"/><rdfs:label xml:lang="zh">海鲜配料</rdfs:label><skos:exactMatch rdf:resource="http://example.org/pizza/term/SeafoodTopping"/></owl:Class>
    <owl:Class rdf:about="HerbTopping"><rdfs:subClassOf rdf:resource="Topping"/><rdfs:label xml:lang="zh">香草配料</rdfs:label><skos:exactMatch rdf:resource="http://example.org/pizza/term/HerbTopping"/></owl:Class>
    <owl:Class rdf:about="FruitTopping"><rdfs:subClassOf rdf:resource="Topping"/><rdfs:label xml:lang="zh">水果配料</rdfs:label><skos:exactMatch rdf:resource="http://example.org/pizza/term/FruitTopping"/></owl:Class>

    <owl:AllDisjointClasses>
        <owl:members rdf:parseType="Collection">
            <owl:Class rdf:about="MeatTopping"/>
            <owl:Class rdf:about="VegetableTopping"/>
            <owl:Class rdf:about="SeafoodTopping"/>
            <owl:Class rdf:about="HerbTopping"/>
            <owl:Class rdf:about="FruitTopping"/>
        </owl:members>
    </owl:AllDisjointClasses>

    <owl:Class rdf:about="WhiteSauce">
        <owl:disjointWith rdf:resource="TomatoSauce"/>
    </owl:Class>

    <!-- ======================== -->
    <!-- 数据属性 -->
    <!-- ======================== -->
    <owl:DatatypeProperty rdf:about="crustThicknessMm">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:label xml:lang="zh">饼底厚度(毫米)</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="bakingTemperatureCelsius">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="zh">烘烤温度(°C)</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="bakingTimeSeconds">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="zh">烘烤时间(秒)</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="flourType">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="zh">面粉种类</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="fermentation">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="zh">发酵方式</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="status">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="zh">状态</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="supplier">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="zh">供应商</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="batchNumber">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="zh">批次</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="price">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label xml:lang="zh">价格</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="purchaseDate">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:label xml:lang="zh">进货日期</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="shelfLife">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="zh">保质期</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="stockQuantity">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="zh">存量</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="isDataValid">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label xml:lang="zh">数据是否有效</rdfs:label>
    </owl:DatatypeProperty>

</rdf:RDF>