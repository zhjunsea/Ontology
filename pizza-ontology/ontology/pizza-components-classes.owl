    <owl:Class rdf:about="http://example.org/pizza/components/classes/ArgentinianThickCrust">
        <rdfs:subClassOf rdf:resource="http://example.org/pizza/components/classes/Crust"/>
        <rdfs:label xml:lang="zh">阿根廷厚饼底</rdfs:label>
