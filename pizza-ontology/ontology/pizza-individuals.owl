<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns="http://example.org/pizza/individuals/"
         xml:base="http://example.org/pizza/individuals/"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:pizza="http://example.org/pizza/classes/"
         xmlns:proc="http://example.org/pizza/processes/classes/"
         xmlns:compi="http://example.org/pizza/components/individuals/"
         xmlns:proci="http://example.org/pizza/processes/individuals/">

    <owl:Ontology rdf:about="http://example.org/pizza/individuals">
        <rdfs:label xml:lang="zh">披萨 ABox（完整版）</rdfs:label>
        <rdfs:comment xml:lang="zh">所有披萨叶子类实例，每个均满足所属类和父类的全部约束。</rdfs:comment>
        <owl:imports rdf:resource="file:///D:/work/Ontology/pizza-ontology/ontology/pizza-classes.owl"/>
        <owl:imports rdf:resource="file:///D:/work/Ontology/pizza-ontology/ontology/pizza-components-individuals.owl"/>
        <owl:imports rdf:resource="file:///D:/work/Ontology/pizza-ontology/ontology/pizza-processes-individuals.owl"/>
    </owl:Ontology>

    <!-- ======================== -->
    <!-- 原有实例（修正后）      -->
    <!-- ======================== -->
    <owl:NamedIndividual rdf:about="neapolitanPizzaInstance">
        <rdf:type rdf:resource="pizza:GenericNeapolitanPizza"/>
        <rdfs:label xml:lang="zh">那不勒斯披萨实例</rdfs:label>
        <rdfs:comment xml:lang="zh">那不勒斯披萨实例的comments</rdfs:comment>
        <pizza:hasCrust rdf:resource="compi:neapolitanCrustInstance"/>
        <pizza:hasSauce rdf:resource="compi:neapolitanTomatoSauceInstance"/>
        <pizza:hasCheese rdf:resource="compi:buffaloMozzarellaInstance"/>
        <pizza:hasProcessStep rdf:resource="proci:Task_DoughMix"/>
        <pizza:hasProcessStep rdf:resource="proci:Task_DoughFerment"/>
        <pizza:hasProcessStep rdf:resource="proci:Task_CrustForm"/>
        <pizza:hasProcessStep rdf:resource="proci:Task_TomatoSauce"/>
        <pizza:hasProcessStep rdf:resource="proci:Task_BaseCheese"/>
        <pizza:hasProcessStep rdf:resource="proci:Task_ToppingSpread"/>
        <pizza:hasProcessStep rdf:resource="proci:Task_Bake"/>
        <pizza:hasProcessStep rdf:resource="proci:Task_Decorate"/>
        <pizza:hasProcessStep rdf:resource="proci:Task_Finish"/>
        <pizza:hasProcessExecution rdf:resource="neapolitanDoughExec"/>
    </owl:NamedIndividual>

    <!-- ======================== -->
    <!-- 所有叶子类实例          -->
    <!-- ======================== -->

    <!-- MargheritaPizza -->
    <owl:NamedIndividual rdf:about="margheritaPizzaInstance">
        <rdf:type rdf:resource="pizza:MargheritaPizza"/>
        <rdfs:label xml:lang="zh">玛格丽特披萨实例</rdfs:label>
        <pizza:hasCrust rdf:resource="compi:neapolitanCrustInstance"/>
        <pizza:hasSauce rdf:resource="compi:neapolitanTomatoSauceInstance"/>
        <pizza:hasCheese rdf:resource="compi:buffaloMozzarellaInstance"/>
        <pizza:hasTopping rdf:resource="compi:Basil"/>
        <pizza:hasProcessStep rdf:resource="proci:Task_DoughMix"/>
        <pizza:hasProcessStep rdf:resource="proci:Task_DoughFerment"/>
        <pizza:hasProcessStep rdf:resource="proci:Task_CrustForm"/>
        <pizza:hasProcessStep rdf:resource="proci:Task_TomatoSauce"/>
        <pizza:hasProcessStep rdf:resource="proci:Task_BaseCheese"/>
        <pizza:hasProcessStep rdf:resource="proci:Task_ToppingSpread"/>
        <pizza:hasProcessStep rdf:resource="proci:Task_Bake"/>
        <pizza:hasProcessStep rdf:resource="proci:Task_Decorate"/>
        <pizza:hasProcessStep rdf:resource="proci:Task_Finish"/>
    </owl:NamedIndividual>

    <!-- RomanTondaPizza -->
    <owl:NamedIndividual rdf:about="romanTondaPizzaInstance">
        <rdf:type rdf:resource="pizza:RomanTondaPizza"/>
        <rdfs:label xml:lang="zh">罗马圆形薄脆披萨实例</rdfs:label>
        <pizza:hasCrust rdf:resource="compi:romanTondaCrustInstance"/>
        <pizza:hasSauce rdf:resource="compi:neapolitanTomatoSauceInstance"/>
        <pizza:hasCheese rdf:resource="compi:buffaloMozzarellaInstance"/>
        <pizza:hasTopping rdf:resource="compi:Mushroom"/>
    </owl:NamedIndividual>

    <!-- RomanAlTaglioPizza -->
    <owl:NamedIndividual rdf:about="romanAlTaglioPizzaInstance">
        <rdf:type rdf:resource="pizza:RomanAlTaglioPizza"/>
        <rdfs:label xml:lang="zh">罗马切块披萨实例</rdfs:label>
        <pizza:hasCrust rdf:resource="compi:romanAlTaglioCrustInstance"/>
        <pizza:hasSauce rdf:resource="compi:neapolitanTomatoSauceInstance"/>
        <pizza:hasCheese rdf:resource="compi:buffaloMozzarellaInstance"/>
        <pizza:hasTopping rdf:resource="compi:Olive"/>
    </owl:NamedIndividual>

    <!-- SicilianPizza -->
    <owl:NamedIndividual rdf:about="sicilianPizzaInstance">
        <rdf:type rdf:resource="pizza:SicilianPizza"/>
        <rdfs:label xml:lang="zh">西西里披萨实例</rdfs:label>
        <pizza:hasCrust rdf:resource="compi:sicilianCrustInstance"/>
        <pizza:hasSauce rdf:resource="compi:americanTomatoSauceInstance"/>
        <pizza:hasCheese rdf:resource="compi:lowMoistureMozzarellaInstance"/>
        <pizza:hasTopping rdf:resource="compi:Onion"/>
        <pizza:hasTopping rdf:resource="compi:Anchovy"/>
    </owl:NamedIndividual>

    <!-- NewYorkPizza -->
    <owl:NamedIndividual rdf:about="newYorkPizzaInstance">
        <rdf:type rdf:resource="pizza:NewYorkPizza"/>
        <rdfs:label xml:lang="zh">纽约薄饼披萨实例</rdfs:label>
        <pizza:hasCrust rdf:resource="compi:newYorkCrustInstance"/>
        <pizza:hasSauce rdf:resource="compi:americanTomatoSauceInstance"/>
        <pizza:hasCheese rdf:resource="compi:lowMoistureMozzarellaInstance"/>
        <pizza:hasTopping rdf:resource="compi:Pepperoni"/>
    </owl:NamedIndividual>

    <!-- ChicagoDeepDishPizza -->
    <owl:NamedIndividual rdf:about="chicagoDeepDishPizzaInstance">
        <rdf:type rdf:resource="pizza:ChicagoDeepDishPizza"/>
        <rdfs:label xml:lang="zh">芝加哥深盘披萨实例</rdfs:label>
        <pizza:hasCrust rdf:resource="compi:chicagoCrustInstance"/>
        <pizza:hasSauce rdf:resource="compi:americanTomatoSauceInstance"/>
        <pizza:hasCheese rdf:resource="compi:lowMoistureMozzarellaInstance"/>
        <pizza:stackingOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#string">inverted</pizza:stackingOrder>
    </owl:NamedIndividual>

    <!-- DetroitPizza -->
    <owl:NamedIndividual rdf:about="detroitPizzaInstance">
        <rdf:type rdf:resource="pizza:DetroitPizza"/>
        <rdfs:label xml:lang="zh">底特律方形披萨实例</rdfs:label>
        <pizza:hasCrust rdf:resource="compi:detroitCrustInstance"/>
        <pizza:hasCheese rdf:resource="compi:lowMoistureMozzarellaInstance"/>
        <pizza:stackingOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#string">inverted</pizza:stackingOrder>
        <pizza:hasTopping rdf:resource="compi:Pepperoni"/>
    </owl:NamedIndividual>

    <!-- StLouisPizza -->
    <owl:NamedIndividual rdf:about="stLouisPizzaInstance">
        <rdf:type rdf:resource="pizza:StLouisPizza"/>
        <rdfs:label xml:lang="zh">圣路易斯披萨实例</rdfs:label>
        <pizza:hasCrust rdf:resource="compi:stLouisCrackerCrustInstance"/>
        <pizza:hasCheese rdf:resource="compi:provelCheeseInstance"/>
        <pizza:hasTopping rdf:resource="compi:Pepperoni"/>
    </owl:NamedIndividual>

    <!-- CaliforniaPizza -->
    <owl:NamedIndividual rdf:about="californiaPizzaInstance">
        <rdf:type rdf:resource="pizza:CaliforniaPizza"/>
        <rdfs:label xml:lang="zh">加州披萨实例</rdfs:label>
        <pizza:hasCrust rdf:resource="compi:newYorkCrustInstance"/>
        <pizza:hasSauce rdf:resource="compi:whiteSauceInstance"/>
        <pizza:hasCheese rdf:resource="compi:lowMoistureMozzarellaInstance"/>
        <pizza:hasTopping rdf:resource="compi:Shrimp"/>
    </owl:NamedIndividual>

    <!-- HawaiianPizza -->
    <owl:NamedIndividual rdf:about="hawaiianPizzaInstance">
        <rdf:type rdf:resource="pizza:HawaiianPizza"/>
