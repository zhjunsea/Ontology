        <pizza:hasCrust rdf:resource="compi:newYorkCrustInstance"/>
        <pizza:hasSauce rdf:resource="compi:americanTomatoSauceInstance"/>
        <pizza:hasCheese rdf:resource="compi:lowMoistureMozzarellaInstance"/>
        <pizza:hasTopping rdf:resource="compi:Ham"/>
        <pizza:hasTopping rdf:resource="compi:Pineapple"/>
    </owl:NamedIndividual>

    <!-- PekingDuckPizza -->
    <owl:NamedIndividual rdf:about="pekingDuckPizzaInstance">
        <rdf:type rdf:resource="pizza:PekingDuckPizza"/>
