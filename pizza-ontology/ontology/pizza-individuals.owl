    <!-- ItalianStyleWhiteSeafoodPizza -->
    <owl:NamedIndividual rdf:about="italianStyleWhiteSeafoodPizzaInstance">
        <rdf:type rdf:resource="pizza:ItalianStyleWhiteSeafoodPizza"/>
        <rdfs:label xml:lang="zh">意式白酱海鲜披萨实例</rdfs:label>
        <pizza:hasCrust rdf:resource="compi:neapolitanCrustInstance"/>
        <pizza:hasSauce rdf:resource="compi:whiteSauceInstance"/>
        <pizza:hasCheese rdf:resource="compi:buffaloMozzarellaInstance"/>
        <pizza:hasTopping rdf:resource="compi:Shrimp"/>
        <pizza:hasTopping rdf:resource="compi:Squid"/>
    </owl:NamedIndividual>

    <!-- ======================== -->
    <!-- 工序执行实例            -->
    <!-- ======================== -->
    <owl:NamedIndividual rdf:about="neapolitanDoughExec">
        <rdf:type rdf:resource="proc:ProcessExecution"/>
        <rdfs:label xml:lang="zh">那不勒斯面团工序执行</rdfs:label>
        <proc:executesStep rdf:resource="proci:Task_DoughMix"/>
        <proc:duration rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">30</proc:duration>
    </owl:NamedIndividual>

</rdf:RDF>