        <pizza:hasCheese rdf:resource="compi:lowMoistureMozzarellaInstance"/>
        <pizza:hasTopping rdf:resource="compi:Pepperoni"/>
    </owl:NamedIndividual>

    <!-- JapaneseKoreanPizza -->
    <owl:NamedIndividual rdf:about="japaneseKoreanPizzaInstance">
        <rdf:type rdf:resource="pizza:JapaneseKoreanPizza"/>
        <rdfs:label xml:lang="zh">日韩改良披萨实例</rdfs:label>
        <pizza:hasCrust rdf:resource="compi:neapolitanCrustInstance"/>
        <pizza:hasSauce rdf:resource="compi:otherSauceInstance"/>
        <pizza:hasCheese rdf:resource="compi:lowMoistureMozzarellaInstance"/>
        <pizza:hasTopping rdf:resource="compi:ChickenTeriyaki"/>
        <pizza:hasTopping rdf:resource="compi:Corn"/>
    </owl:NamedIndividual>

    <!-- MarinaraPizza -->
    <owl:NamedIndividual rdf:about="marinaraPizzaInstance">
        <rdf:type rdf:resource="pizza:MarinaraPizza"/>
        <rdfs:label xml:lang="zh">玛瑞纳拉披萨实例</rdfs:label>
        <pizza:hasCrust rdf:resource="compi:neapolitanCrustInstance"/>
        <pizza:hasSauce rdf:resource="compi:neapolitanTomatoSauceInstance"/>
        <!-- 无 cheese -->
        <pizza:hasTopping rdf:resource="compi:Oregano"/>
    </owl:NamedIndividual>

    <!-- NoSaucePizza -->
    <owl:NamedIndividual rdf:about="noSaucePizzaInstance">
        <rdf:type rdf:resource="pizza:NoSaucePizza"/>
        <rdfs:label xml:lang="zh">无酱基底披萨实例</rdfs:label>
        <pizza:hasCrust rdf:resource="compi:neapolitanCrustInstance"/>
        <!-- 无 sauce -->
        <pizza:hasCheese rdf:resource="compi:buffaloMozzarellaInstance"/>
        <pizza:hasTopping rdf:resource="compi:Mushroom"/>
    </owl:NamedIndividual>

