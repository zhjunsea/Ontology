    <!-- FrenchPizza -->
    <owl:NamedIndividual rdf:about="frenchPizzaInstance">
        <rdf:type rdf:resource="pizza:FrenchPizza"/>
        <rdfs:label xml:lang="zh">法式披萨实例</rdfs:label>
        <pizza:hasCrust rdf:resource="compi:frenchThinCrustInstance"/>
        <pizza:hasSauce rdf:resource="compi:whiteSauceInstance"/>
        <pizza:hasCheese rdf:resource="compi:parmesanInstance"/>
        <pizza:hasTopping rdf:resource="compi:Onion"/>
        <pizza:hasTopping rdf:resource="compi:Anchovy"/>
    </owl:NamedIndividual>

    <!-- ArgentinianPizza -->
    <owl:NamedIndividual rdf:about="argentinianPizzaInstance">
        <rdf:type rdf:resource="pizza:ArgentinianPizza"/>
