      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_1yga4c3_di" bpmnElement="Task_DoughMix">
        <dc:Bounds x="290" y="87" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_13k9nuo_di" bpmnElement="Task_DoughFerment">
        <dc:Bounds x="470" y="87" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_SauceChoice_di" bpmnElement="Gateway_SauceChoice" isMarkerVisible="true">
        <dc:Bounds x="425" y="255" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="398" y="246" width="44" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
