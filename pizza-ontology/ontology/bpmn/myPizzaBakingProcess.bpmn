<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_Camunda8" targetNamespace="http://pizza.process/standard" exporter="Camunda Modeler" exporterVersion="5.48.0" xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL https://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd">
  <bpmn:process id="PizzaMakingStandardProcess" name="通用披萨标准制作工艺流程" isExecutable="true">
    <bpmn:extensionElements />
    <bpmn:dataObjectReference id="Data_PizzaName" name="披萨名称" dataObjectRef="pizzaNameData" />
    <bpmn:dataObject id="pizzaNameData" name="披萨名称" />
    <bpmn:startEvent id="Start_01" name="流程开始">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=0" target="totalCost" />
          <zeebe:output source="=0" target="totalDuration" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_Start_To_Dough</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_DoughMix" name="面团原料准备与揉制">
      <bpmn:documentation>取用面粉、水、食盐、酵母等原料，混合搅拌、揉面至面筋成型，完成初次基础发酵</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="query-property-value-ontology" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;http://example.org/pizza/processes/individuals/Task_DoughMix&#34;" target="individualIri" />
          <zeebe:input source="=&#34;http://example.org/pizza/processes/classes/duration&#34;" target="propertyIri" />
          <zeebe:output source="=number(propertyValues[1])" target="totalDuration" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_To_Dough</bpmn:incoming>
      <bpmn:outgoing>Flow_02ed4vo</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_DoughFerment" name="面团分割排气与二次醒发">
      <bpmn:documentation>分割定量面团、轻柔排气，密封二次醒发；约束：未完成醒发禁止饼底成型</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="query-property-value-ontology" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;http://example.org/pizza/processes/individuals/Task_DoughFerment&#34;" target="individualIri" />
          <zeebe:input source="=&#34;http://example.org/pizza/processes/classes/duration&#34;" target="propertyIri" />
          <zeebe:output source="=totalDuration+number(propertyValues[1])" target="totalDuration" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_02ed4vo</bpmn:incoming>
      <bpmn:outgoing>Flow_Ferment_To_Crust</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CrustForm" name="饼底手工成型">
      <bpmn:documentation>面团按压延展成型，保留饼边，检查饼底均匀度，剔除不合格饼底</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="query-property-value-ontology" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;http://example.org/pizza/processes/individuals/Task_CrustForm&#34;" target="individualIri" />
          <zeebe:input source="=&#34;http://example.org/pizza/processes/classes/duration&#34;" target="propertyIri" />
          <zeebe:output source="=totalDuration+number(propertyValues[1])" target="totalDuration" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Ferment_To_Crust</bpmn:incoming>
      <bpmn:outgoing>Flow_0bf8i1j</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_GetSauce" name="获取酱汁">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="get-component" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;http://example.org/pizza/classes/hasSauce&#34;" target="targetProperty" />
          <zeebe:input source="=&#34;http://example.org/pizza/components/classes/&#34;" target="classPrefix" />
          <zeebe:input source="=&#34;http://example.org/pizza/components/individuals/&#34;" target="indPrefix" />
          <zeebe:input source="=[&#34;白酱&#34;, &#34;番茄红酱&#34;]" target="candidateLabels" />
          <zeebe:output source="=totalCost+componentPrice" target="totalCost" />
          <zeebe:output source="=matchedWord" target="matchedWord" />
          <zeebe:output source="=componentName" target="SauceName" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0bf8i1j</bpmn:incoming>
      <bpmn:outgoing>Flow_GetSauce_To_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_TomatoSauce" name="铺番茄红酱">
      <bpmn:documentation>选用番茄酱均匀铺酱，预留饼边</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="query-property-value-ontology" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;http://example.org/pizza/processes/individuals/Task_TomatoSauce&#34;" target="individualIri" />
          <zeebe:input source="=&#34;http://example.org/pizza/processes/classes/duration&#34;" target="propertyIri" />
          <zeebe:output source="=totalDuration+number(propertyValues[1])" target="totalDuration" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Sauce_Tomato</bpmn:incoming>
      <bpmn:outgoing>Flow_1wr7xoe</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_WhiteSauce" name="铺白酱">
      <bpmn:documentation>选用白酱均匀铺酱，预留饼边</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="query-property-value-ontology" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;http://example.org/pizza/processes/individuals/Task_WhiteSauce&#34;" target="individualIri" />
          <zeebe:input source="=&#34;http://example.org/pizza/processes/classes/duration&#34;" target="propertyIri" />
          <zeebe:output source="=totalDuration+number(propertyValues[1])" target="totalDuration" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Sauce_White</bpmn:incoming>
      <bpmn:outgoing>Flow_White_To_Merge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_GetCheese" name="获取奶酪">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="get-component" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;http://example.org/pizza/classes/hasCheese&#34;" target="targetProperty" />
          <zeebe:input source="=&#34;http://example.org/pizza/components/classes/&#34;" target="classPrefix" />
          <zeebe:input source="=&#34;http://example.org/pizza/components/individuals/&#34;" target="indPrefix" />
          <zeebe:input source="=[&#34;无奶酪&#34;, &#34;奶酪&#34;]" target="candidateLabels" />
          <zeebe:output source="=totalCost+componentPrice" target="totalCost" />
          <zeebe:output source="=matchedWord" target="matchedWord" />
          <zeebe:output source="=componentName" target="CheeseName" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0p6v32v</bpmn:incoming>
      <bpmn:outgoing>Flow_GetCheese_To_CheeseGateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_BaseCheese" name="基础奶酪铺设">
      <bpmn:documentation>酱料表层均匀铺设马苏里拉奶酪</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="query-property-value-ontology" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;http://example.org/pizza/processes/individuals/Task_BaseCheese&#34;" target="individualIri" />
          <zeebe:input source="=&#34;http://example.org/pizza/processes/classes/duration&#34;" target="propertyIri" />
          <zeebe:output source="=totalDuration+number(propertyValues[1])" target="totalDuration" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Cheese_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_1aycthl</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_GetTopping" name="获取顶层配料">
      <bpmn:documentation>根据披萨类型查询所需顶层配料，匹配最低价格实例</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="get-component" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;http://example.org/pizza/classes/hasTopping&#34;" target="targetProperty" />
          <zeebe:input source="=&#34;http://example.org/pizza/components/classes/&#34;" target="classPrefix" />
          <zeebe:input source="=&#34;http://example.org/pizza/components/individuals/&#34;" target="indPrefix" />
          <zeebe:input source="=[&#34;无配料&#34;, &#34;配料&#34;]" target="candidateLabels" />
          <zeebe:output source="=totalCost+componentPrice" target="totalCost" />
          <zeebe:output source="=matchedWord" target="matchedWord" />
          <zeebe:output source="=componentName" target="ToppingName" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Cheese_No_To_GetTopping</bpmn:incoming>
      <bpmn:incoming>Flow_1aycthl</bpmn:incoming>
      <bpmn:outgoing>Flow_GetTopping_To_Spread</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ToppingSpread" name="顶层配料铺设">
      <bpmn:documentation>分类铺设肉类、海鲜、蔬菜、水果配料，控制高水分配料用量；素食披萨禁止肉、海鲜配料</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="query-property-value-ontology" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;http://example.org/pizza/processes/individuals/Task_ToppingSpread&#34;" target="individualIri" />
          <zeebe:input source="=&#34;http://example.org/pizza/processes/classes/duration&#34;" target="propertyIri" />
          <zeebe:output source="=totalDuration+number(propertyValues[1])" target="totalDuration" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1s2ck8n</bpmn:incoming>
      <bpmn:outgoing>Flow_Topping_To_GetTopCheese</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_GetTopCheese" name="获取封层">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="get-component" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;http://example.org/pizza/classes/hasCheese&#34;" target="targetProperty" />
          <zeebe:input source="=&#34;http://example.org/pizza/components/classes/&#34;" target="classPrefix" />
          <zeebe:input source="=&#34;http://example.org/pizza/components/individuals/&#34;" target="indPrefix" />
          <zeebe:input source="=[&#34;无封层&#34;, &#34;封层&#34;]" target="candidateLabels" />
          <zeebe:output source="=totalCost+componentPrice" target="totalCost" />
          <zeebe:output source="=matchedWord" target="matchedWord" />
          <zeebe:output source="=componentName" target="TopCheeseName" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Topping_To_GetTopCheese</bpmn:incoming>
      <bpmn:incoming>Flow_1m3vm03</bpmn:incoming>
      <bpmn:outgoing>Flow_GetTopCheese_To_TopCheeseGateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_01" name="流程结束">
      <bpmn:incoming>Flow_Finish_To_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_SauceChoice" name="酱汁类型">
      <bpmn:incoming>Flow_GetSauce_To_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Sauce_White</bpmn:outgoing>
      <bpmn:outgoing>Flow_Sauce_Tomato</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_SauceMerge" name="酱汁汇合">
      <bpmn:incoming>Flow_White_To_Merge</bpmn:incoming>
      <bpmn:incoming>Flow_1wr7xoe</bpmn:incoming>
      <bpmn:outgoing>Flow_0p6v32v</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_CheeseChoice" name="是否添加奶酪？">
      <bpmn:incoming>Flow_GetCheese_To_CheeseGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Cheese_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Cheese_No_To_GetTopping</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_TopCheeseChoice" name="是否需要封层？">
      <bpmn:incoming>Flow_GetTopCheese_To_TopCheeseGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_TopCheese_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_TopCheese_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_TopCheeseMerge" name="封层汇合">
      <bpmn:incoming>Flow_TopCheese_No</bpmn:incoming>
      <bpmn:incoming>Flow_TopCheese_To_Merge</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge_To_Bake</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Start_To_Dough" sourceRef="Start_01" targetRef="Task_DoughMix" />
    <bpmn:sequenceFlow id="Flow_02ed4vo" sourceRef="Task_DoughMix" targetRef="Task_DoughFerment" />
    <bpmn:sequenceFlow id="Flow_Ferment_To_Crust" sourceRef="Task_DoughFerment" targetRef="Task_CrustForm" />
    <bpmn:sequenceFlow id="Flow_0bf8i1j" sourceRef="Task_CrustForm" targetRef="Task_GetSauce" />
    <bpmn:sequenceFlow id="Flow_GetSauce_To_Gateway" sourceRef="Task_GetSauce" targetRef="Gateway_SauceChoice" />
    <bpmn:sequenceFlow id="Flow_Sauce_White" name="白酱" sourceRef="Gateway_SauceChoice" targetRef="Task_WhiteSauce">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= matchedWord = "白酱"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Sauce_Tomato" name="番茄红酱" sourceRef="Gateway_SauceChoice" targetRef="Task_TomatoSauce">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= matchedWord = "番茄红酱"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_White_To_Merge" sourceRef="Task_WhiteSauce" targetRef="Gateway_SauceMerge" />
    <bpmn:sequenceFlow id="Flow_1wr7xoe" sourceRef="Task_TomatoSauce" targetRef="Gateway_SauceMerge" />
    <bpmn:sequenceFlow id="Flow_0p6v32v" sourceRef="Gateway_SauceMerge" targetRef="Task_GetCheese" />
    <bpmn:sequenceFlow id="Flow_GetCheese_To_CheeseGateway" sourceRef="Task_GetCheese" targetRef="Gateway_CheeseChoice" />
    <bpmn:sequenceFlow id="Flow_Cheese_Yes" name="是" sourceRef="Gateway_CheeseChoice" targetRef="Task_BaseCheese">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= matchedWord = "奶酪"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Cheese_No_To_GetTopping" name="否" sourceRef="Gateway_CheeseChoice" targetRef="Task_GetTopping">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= matchedWord = "无奶酪"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_GetTopping_To_Spread" sourceRef="Task_GetTopping" targetRef="Gateway_0xkqhps" />
    <bpmn:sequenceFlow id="Flow_Topping_To_GetTopCheese" sourceRef="Task_ToppingSpread" targetRef="Task_GetTopCheese" />
    <bpmn:sequenceFlow id="Flow_GetTopCheese_To_TopCheeseGateway" sourceRef="Task_GetTopCheese" targetRef="Gateway_TopCheeseChoice" />
    <bpmn:sequenceFlow id="Flow_TopCheese_Yes" name="有封层" sourceRef="Gateway_TopCheeseChoice" targetRef="Task_TopCheese">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= matchedWord = "封层"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_TopCheese_No" sourceRef="Gateway_TopCheeseChoice" targetRef="Gateway_TopCheeseMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= matchedWord = "没封层"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_TopCheese_To_Merge" sourceRef="Task_TopCheese" targetRef="Gateway_TopCheeseMerge" />
    <bpmn:sequenceFlow id="Flow_Merge_To_Bake" sourceRef="Gateway_TopCheeseMerge" targetRef="Task_Bake" />
    <bpmn:sequenceFlow id="Flow_Bake_To_Decorate" sourceRef="Task_Bake" targetRef="Task_Decorate" />
    <bpmn:sequenceFlow id="Flow_Decorate_To_Finish" sourceRef="Task_Decorate" targetRef="Task_Finish" />
    <bpmn:sequenceFlow id="Flow_Finish_To_End" sourceRef="Task_Finish" targetRef="End_01" />
    <bpmn:serviceTask id="Task_TopCheese" name="补铺表层奶酪封层">
      <bpmn:documentation>配料表层二次铺盖奶酪，粘合配料、锁住水分</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="query-property-value-ontology" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;http://example.org/pizza/processes/individuals/Task_TopCheese&#34;" target="individualIri" />
          <zeebe:input source="=&#34;http://example.org/pizza/processes/classes/duration&#34;" target="propertyIri" />
          <zeebe:output source="=totalDuration+number(propertyValues[1])" target="totalDuration" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_TopCheese_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_TopCheese_To_Merge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Bake" name="高温烘烤成型">
      <bpmn:documentation>按披萨流派预热炉温，控制对应温度与时长烘烤，观察成品状态避免夹生、烤焦</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="query-property-value-ontology" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;http://example.org/pizza/processes/individuals/Task_Bake&#34;" target="individualIri" />
          <zeebe:input source="=&#34;http://example.org/pizza/processes/classes/duration&#34;" target="propertyIri" />
          <zeebe:output source="=totalDuration+number(propertyValues[1])" target="totalDuration" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Merge_To_Bake</bpmn:incoming>
      <bpmn:outgoing>Flow_Bake_To_Decorate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Decorate" name="出炉后处理与装饰">
      <bpmn:documentation>出炉沥油散热，点缀新鲜香草、淋橄榄油；新鲜香草禁止入炉烘烤</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="query-property-value-ontology" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;http://example.org/pizza/processes/individuals/Task_Decorate&#34;" target="individualIri" />
          <zeebe:input source="=&#34;http://example.org/pizza/processes/classes/duration&#34;" target="propertyIri" />
          <zeebe:output source="=totalDuration+number(propertyValues[1])" target="totalDuration" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Bake_To_Decorate</bpmn:incoming>
      <bpmn:outgoing>Flow_Decorate_To_Finish</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Finish" name="成品切割检验出品">
      <bpmn:documentation>标准等分切割，检验品相、熟度、配料合规性，完成出品</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="query-property-value-ontology" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;http://example.org/pizza/processes/individuals/Task_Finish&#34;" target="individualIri" />
          <zeebe:input source="=&#34;http://example.org/pizza/processes/classes/duration&#34;" target="propertyIri" />
          <zeebe:output source="=totalDuration+number(propertyValues[1])" target="totalDuration" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Decorate_To_Finish</bpmn:incoming>
      <bpmn:outgoing>Flow_Finish_To_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_0xkqhps" name="是否有顶层配料">
      <bpmn:incoming>Flow_GetTopping_To_Spread</bpmn:incoming>
      <bpmn:outgoing>Flow_1s2ck8n</bpmn:outgoing>
      <bpmn:outgoing>Flow_1m3vm03</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1aycthl" sourceRef="Task_BaseCheese" targetRef="Task_GetTopping" />
    <bpmn:sequenceFlow id="Flow_1s2ck8n" name="是" sourceRef="Gateway_0xkqhps" targetRef="Task_ToppingSpread">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= matchedWord = "配料"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
