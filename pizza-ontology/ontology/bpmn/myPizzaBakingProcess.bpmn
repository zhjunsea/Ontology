        <dc:Bounds x="225" y="240" width="100" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="242" y="222" width="66" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_0q4spdi_di" bpmnElement="Task_CrustForm">
        <dc:Bounds x="620" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_To_Dough_di" bpmnElement="Flow_Start_To_Dough">
        <di:waypoint x="188" y="127" />
        <di:waypoint x="290" y="127" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_02ed4vo_di" bpmnElement="Flow_02ed4vo">
        <di:waypoint x="390" y="127" />
        <di:waypoint x="470" y="127" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Ferment_To_Crust_di" bpmnElement="Flow_Ferment_To_Crust">
        <di:waypoint x="570" y="127" />
        <di:waypoint x="620" y="127" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_0bf8i1j_di" bpmnElement="Flow_0bf8i1j">
        <di:waypoint x="670" y="160" />
        <di:waypoint x="670" y="180" />
        <di:waypoint x="120" y="180" />
        <di:waypoint x="120" y="280" />
        <di:waypoint x="225" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_GetSauce_To_Gateway_di" bpmnElement="Flow_GetSauce_To_Gateway">
        <di:waypoint x="325" y="280" />
        <di:waypoint x="425" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Sauce_White_di" bpmnElement="Flow_Sauce_White">
        <di:waypoint x="475" y="280" />
        <di:waypoint x="523" y="280" />
        <di:waypoint x="523" y="320" />
        <di:waypoint x="570" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Sauce_Tomato_di" bpmnElement="Flow_Sauce_Tomato">
        <di:waypoint x="475" y="280" />
        <di:waypoint x="520" y="280" />
        <di:waypoint x="520" y="230" />
        <di:waypoint x="580" y="230" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_White_To_Merge_di" bpmnElement="Flow_White_To_Merge">
        <di:waypoint x="690" y="320" />
        <di:waypoint x="800" y="320" />
        <di:waypoint x="800" y="275" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1wr7xoe_di" bpmnElement="Flow_1wr7xoe">
        <di:waypoint x="680" y="230" />
