         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

    <owl:Ontology rdf:about="http://www.tcm-classics.org/jingfang/all">
        <rdfs:label xml:lang="zh">经方加载本体</rdfs:label>
        <rdfs:comment xml:lang="zh">八纲、六经、方证、兼夹证、药证定义。</rdfs:comment>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/core"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/zhengzhuang"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/maixiang"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/shexiang"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/fangji"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/yaowu"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/yaozheng"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/fangzheng-jianjia"/>
        <!-- ABox -->
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/shexiang-abox"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/zhengzhuang-abox"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/maixiang-abox"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/fangji-abox"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/yaowu-abox"/>
        <owl:versionInfo>1.0</owl:versionInfo>
    </owl:Ontology>

</rdf:RDF>