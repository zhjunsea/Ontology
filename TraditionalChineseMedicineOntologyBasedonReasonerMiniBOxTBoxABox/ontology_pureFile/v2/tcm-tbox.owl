<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns="http://www.tcm-classics.org/jingfang#"
         xml:base="http://www.tcm-classics.org/jingfang#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

    <owl:Ontology rdf:about="http://www.tcm-classics.org/jingfang#">
        <rdfs:label xml:lang="zh">经方六经辨证本体 TBox</rdfs:label>
        <rdfs:comment xml:lang="zh">术语层：类、属性、公理。不含个体声明。</rdfs:comment>
        <owl:versionInfo>1.0</owl:versionInfo>
    </owl:Ontology>

    <!-- ==================== 属性声明 ==================== -->

    <!-- 对象属性 -->
    <owl:ObjectProperty rdf:about="#you_zhengzhuang">
        <rdfs:domain rdf:resource="#Huanzhe"/>
        <rdfs:range rdf:resource="#Zhengzhuang"/>
        <rdfs:label xml:lang="zh">有症状</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#you_maixiang">
        <rdfs:domain rdf:resource="#Huanzhe"/>
        <rdfs:range rdf:resource="#Maixiang"/>
        <rdfs:label xml:lang="zh">有脉象</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#you_shexiang">
        <rdfs:domain rdf:resource="#Huanzhe"/>
        <rdfs:range rdf:resource="#Shexiang"/>
        <rdfs:label xml:lang="zh">有舌象</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#you_fuzheng">
        <rdfs:domain rdf:resource="#Huanzhe"/>
        <rdfs:range rdf:resource="#Fuzheng"/>
        <rdfs:label xml:lang="zh">有腹证</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#you_chufang">
        <rdfs:domain rdf:resource="#Fangzheng"/>
        <rdfs:range rdf:resource="#Fangji"/>
        <rdfs:label xml:lang="zh">有处方</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#you_yaowu">
        <rdfs:domain rdf:resource="#Fangji"/>
        <rdfs:range rdf:resource="#Yaowu"/>
        <rdfs:label xml:lang="zh">有组成药物</rdfs:label>
    </owl:ObjectProperty>

    <!-- 数据属性 -->
    <owl:DatatypeProperty rdf:about="#you_jianyi">
        <rdfs:domain rdf:resource="#Huanzhe"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:label xml:lang="zh">有加减建议</rdfs:label>
    </owl:DatatypeProperty>

    <!-- 注释属性 -->
    <owl:AnnotationProperty rdf:about="#possibleSymptom">
        <rdfs:label xml:lang="zh">或然症</rdfs:label>
    </owl:AnnotationProperty>
    <owl:AnnotationProperty rdf:about="#addHerb">
        <rdfs:label xml:lang="zh">可加药物</rdfs:label>
    </owl:AnnotationProperty>
    <owl:AnnotationProperty rdf:about="#hasYaozheng">
        <rdfs:label xml:lang="zh">有药证</rdfs:label>
        <rdfs:comment xml:lang="zh">药物与药证类的注释关联，不参与推理</rdfs:comment>
    </owl:AnnotationProperty>

