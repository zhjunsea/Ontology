    <!-- ==================== 八纲定义 ==================== -->
    <owl:Class rdf:about="#Biao">
        <rdfs:subClassOf rdf:resource="#Bagang"/>
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <owl:Class rdf:about="#Ehan"/>
                            <owl:Class rdf:about="#Efeng"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </owl:equivalentClass>
    </owl:Class>

    <owl:Class rdf:about="#Li">
        <rdfs:subClassOf rdf:resource="#Bagang"/>
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <owl:Class rdf:about="#Fuman"/>
                            <owl:Class rdf:about="#Bianmi"/>
                            <owl:Class rdf:about="#Xiali"/>
                            <owl:Class rdf:about="#Outu"/>
                            <owl:Class rdf:about="#Kouke"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </owl:equivalentClass>
    </owl:Class>

