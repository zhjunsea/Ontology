                <owl:hasValue rdf:resource="#BanXiaXieXinTang"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
		<!-- ==================== 新增方证定义（十八反相关） ==================== -->
		
		<!-- 甘遂半夏汤证 -->
		<owl:Class rdf:about="#GansuiBanxiaTangZheng">
		    <rdfs:label xml:lang="zh">甘遂半夏汤证</rdfs:label>
		    <rdfs:subClassOf rdf:resource="#Fangzheng"/>
		    <owl:equivalentClass>
		        <owl:Class>
		            <owl:intersectionOf rdf:parseType="Collection">
		                <!-- 决定性主症：心下坚满（痞）、下利、脉沉弦（伏近似） -->
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#XinxiaPi"/>
		                </owl:Restriction>
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#Xiali"/>
		                </owl:Restriction>
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_maixiang"/>
		                    <owl:someValuesFrom rdf:resource="#ChenXianHuamai"/>
		                </owl:Restriction>
		            </owl:intersectionOf>
		        </owl:Class>
		    </owl:equivalentClass>
		    <possibleSymptom rdf:resource="#Touxuan"/>
		    <rdfs:subClassOf>
		        <owl:Restriction>
		            <owl:onProperty rdf:resource="#you_chufang"/>
		            <owl:hasValue rdf:resource="#GansuiBanxiaTang"/>
		        </owl:Restriction>
		    </rdfs:subClassOf>
		</owl:Class>
		
		<!-- 附子粳米汤证 -->
		<owl:Class rdf:about="#FuziJingmiTangZheng">
		    <rdfs:label xml:lang="zh">附子粳米汤证</rdfs:label>
		    <rdfs:subClassOf rdf:resource="#Fangzheng"/>
		    <owl:equivalentClass>
		        <owl:Class>
		            <owl:intersectionOf rdf:parseType="Collection">
		                <!-- 决定性主症：腹痛（雷鸣切痛）、胸胁逆满、呕吐、脉沉微 -->
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#Futong"/>
		                </owl:Restriction>
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#XiongxieKuman"/>
		                </owl:Restriction>
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#Outu"/>
		                </owl:Restriction>
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_maixiang"/>
		                    <owl:someValuesFrom rdf:resource="#Chenweimai"/>
		                </owl:Restriction>
		            </owl:intersectionOf>
		        </owl:Class>
		    </owl:equivalentClass>
		    <rdfs:subClassOf>
		        <owl:Restriction>
		            <owl:onProperty rdf:resource="#you_chufang"/>
		            <owl:hasValue rdf:resource="#FuziJingmiTang"/>
		        </owl:Restriction>
		    </rdfs:subClassOf>
		</owl:Class>
		
		<!-- 栝楼瞿麦丸证 -->
		<owl:Class rdf:about="#GualouQumaiWanZheng">
		    <rdfs:label xml:lang="zh">栝楼瞿麦丸证</rdfs:label>
		    <rdfs:subClassOf rdf:resource="#Fangzheng"/>
		    <owl:equivalentClass>
		        <owl:Class>
		            <owl:intersectionOf rdf:parseType="Collection">
		                <!-- 决定性主症：小便不利、口渴、脉沉 -->
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#XiaobianBuli"/>
		                </owl:Restriction>
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#Kouke"/>
		                </owl:Restriction>
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_maixiang"/>
		                    <owl:someValuesFrom rdf:resource="#Chenmai"/>
		                </owl:Restriction>
		            </owl:intersectionOf>
		        </owl:Class>
		    </owl:equivalentClass>
		    <rdfs:subClassOf>
		        <owl:Restriction>
		            <owl:onProperty rdf:resource="#you_chufang"/>
		            <owl:hasValue rdf:resource="#GualouQumaiWan"/>
		        </owl:Restriction>
		    </rdfs:subClassOf>
		</owl:Class>
</rdf:RDF>