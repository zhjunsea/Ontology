<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns="http://www.tcm-classics.org/jingfang#"
         xml:base="http://www.tcm-classics.org/jingfang#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

    <owl:Ontology rdf:about="http://www.tcm-classics.org/jingfang/fangzheng-jianjia">
        <rdfs:label xml:lang="zh">方证与兼夹证模块</rdfs:label>
        <rdfs:comment xml:lang="zh">方证类与兼夹证类定义。</rdfs:comment>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/core"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/fangji"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/yaowu"/>
        <owl:versionInfo>1.0</owl:versionInfo>
    </owl:Ontology>

    <!-- ==================== 兼夹证定义 ==================== -->
    <owl:Class rdf:about="#YuXueZheng">
        <rdfs:label xml:lang="zh">瘀血证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#JianJiaZheng"/>
        <addHerb rdf:resource="#Danshen"/>
        <addHerb rdf:resource="#Taoren"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                        <owl:someValuesFrom rdf:resource="#Citong"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_shexiang"/>
                        <owl:someValuesFrom rdf:resource="#SheZiAn"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_maixiang"/>
                        <owl:someValuesFrom rdf:resource="#Semai"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#ChunWeiSheQing"/>
        <possibleSymptom rdf:resource="#JifuJiacuo"/>
        <possibleSymptom rdf:resource="#DanYuShuShuiBuYuYan"/>
        <possibleSymptom rdf:resource="#XiongMan"/>
    </owl:Class>

    <owl:Class rdf:about="#TanYinZheng">
        <rdfs:label xml:lang="zh">痰饮证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#JianJiaZheng"/>
        <addHerb rdf:resource="#Banxia"/>
        <addHerb rdf:resource="#Fuling"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_shexiang"/>
                        <owl:someValuesFrom rdf:resource="#SheTaiHuaNi"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_maixiang"/>
                        <owl:someValuesFrom rdf:resource="#ChenXianHuamai"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Touxuan"/>
        <possibleSymptom rdf:resource="#XinJi"/>
        <possibleSymptom rdf:resource="#Kesou"/>
        <possibleSymptom rdf:resource="#ChangMingRuZouShui"/>
    </owl:Class>

    <owl:Class rdf:about="#QiYuZheng">
