<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns="http://www.tcm-classics.org/jingfang#"
         xml:base="http://www.tcm-classics.org/jingfang#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:fj="http://www.tcm-classics.org/jingfang#">

    <owl:Ontology rdf:about="http://www.tcm-classics.org/jingfang/shexiang">
        <rdfs:label xml:lang="zh">舌象模块（合并温病舌诊体系）</rdfs:label>
        <rdfs:comment xml:lang="zh">包含原有 5 个舌象类及温病学派舌诊完整分类。原有类定义不变。</rdfs:comment>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/core"/>
        <owl:versionInfo>2.0</owl:versionInfo>
    </owl:Ontology>

    <!-- ========== 原有舌象类（保持不变） ========== -->
    <owl:Class rdf:about="#HuangzaoQiciTai"><rdfs:subClassOf rdf:resource="#Shexiang"/><rdfs:label xml:lang="zh">黄燥起刺苔</rdfs:label></owl:Class>
    <owl:Class rdf:about="#SheZiAn"><rdfs:subClassOf rdf:resource="#Shexiang"/><rdfs:label xml:lang="zh">舌紫暗</rdfs:label></owl:Class>
    <owl:Class rdf:about="#SheTaiHuaNi"><rdfs:subClassOf rdf:resource="#Shexiang"/><rdfs:label xml:lang="zh">舌苔滑腻</rdfs:label></owl:Class>
    <owl:Class rdf:about="#TaiHuangNi"><rdfs:subClassOf rdf:resource="#Shexiang"/><rdfs:label xml:lang="zh">苔黄腻</rdfs:label></owl:Class>
    <owl:Class rdf:about="#TaiNi"><rdfs:subClassOf rdf:resource="#Shexiang"/><rdfs:label xml:lang="zh">苔腻</rdfs:label></owl:Class>

    <!-- ========== 新增：舌诊根类与总体框架 ========== -->
    <owl:Class rdf:about="#TongueDiagnosisRoot">
        <rdfs:subClassOf rdf:resource="#Shexiang"/>
        <rdfs:label xml:lang="zh">舌诊</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#TongueManifestation">
        <rdfs:subClassOf rdf:resource="#TongueDiagnosisRoot"/>
        <rdfs:label xml:lang="zh">舌象</rdfs:label>
    </owl:Class>

    <!-- 六维分类 -->
    <owl:Class rdf:about="#TongueBodyColor"><rdfs:subClassOf rdf:resource="#TongueManifestation"/><rdfs:label xml:lang="zh">舌质颜色</rdfs:label></owl:Class>
    <owl:Class rdf:about="#TongueCoating"><rdfs:subClassOf rdf:resource="#TongueManifestation"/><rdfs:label xml:lang="zh">舌苔</rdfs:label></owl:Class>
    <owl:Class rdf:about="#TongueShape"><rdfs:subClassOf rdf:resource="#TongueManifestation"/><rdfs:label xml:lang="zh">舌形</rdfs:label></owl:Class>
    <owl:Class rdf:about="#TongueDynamics"><rdfs:subClassOf rdf:resource="#TongueManifestation"/><rdfs:label xml:lang="zh">舌态</rdfs:label></owl:Class>
    <owl:Class rdf:about="#SublingualVein"><rdfs:subClassOf rdf:resource="#TongueManifestation"/><rdfs:label xml:lang="zh">舌下络脉</rdfs:label></owl:Class>
    <owl:Class rdf:about="#TongueMoisture"><rdfs:subClassOf rdf:resource="#TongueManifestation"/><rdfs:label xml:lang="zh">舌面润燥</rdfs:label></owl:Class>

    <!-- 苔色/苔质 -->
    <owl:Class rdf:about="#CoatingColor"><rdfs:subClassOf rdf:resource="#TongueCoating"/><rdfs:label xml:lang="zh">苔色</rdfs:label></owl:Class>
    <owl:Class rdf:about="#CoatingTexture"><rdfs:subClassOf rdf:resource="#TongueCoating"/><rdfs:label xml:lang="zh">苔质</rdfs:label></owl:Class>

    <!-- 舌质颜色具体类 -->
    <owl:Class rdf:about="#PaleRedTongue"><rdfs:subClassOf rdf:resource="#TongueBodyColor"/><rdfs:label xml:lang="zh">淡红舌</rdfs:label></owl:Class>
    <owl:Class rdf:about="#PaleWhiteTongue"><rdfs:subClassOf rdf:resource="#TongueBodyColor"/><rdfs:label xml:lang="zh">淡白舌</rdfs:label></owl:Class>
    <owl:Class rdf:about="#RedTongue"><rdfs:subClassOf rdf:resource="#TongueBodyColor"/><rdfs:label xml:lang="zh">红舌</rdfs:label></owl:Class>
    <owl:Class rdf:about="#CrimsonTongue"><rdfs:subClassOf rdf:resource="#TongueBodyColor"/><rdfs:label xml:lang="zh">绛舌</rdfs:label></owl:Class>
    <owl:Class rdf:about="#ShaoyinHeatTongue"><rdfs:subClassOf rdf:resource="#TongueBodyColor"/><rdfs:label xml:lang="zh">少阴热化舌</rdfs:label></owl:Class>
    <owl:Class rdf:about="#PurpleTongue"><rdfs:subClassOf rdf:resource="#TongueBodyColor"/><rdfs:label xml:lang="zh">紫舌</rdfs:label></owl:Class>
    <owl:Class rdf:about="#PurpleDryTongue"><rdfs:subClassOf rdf:resource="#PurpleTongue"/><rdfs:label xml:lang="zh">紫暗干燥舌</rdfs:label></owl:Class>
    <owl:Class rdf:about="#PurpleMoistTongue"><rdfs:subClassOf rdf:resource="#PurpleTongue"/><rdfs:label xml:lang="zh">紫暗湿润舌</rdfs:label></owl:Class>
    <owl:Class rdf:about="#BlueTongue"><rdfs:subClassOf rdf:resource="#TongueBodyColor"/><rdfs:label xml:lang="zh">青舌</rdfs:label></owl:Class>

    <!-- 苔色具体类 -->
    <owl:Class rdf:about="#WhiteCoating"><rdfs:subClassOf rdf:resource="#CoatingColor"/><rdfs:label xml:lang="zh">白苔</rdfs:label></owl:Class>
    <owl:Class rdf:about="#WhiteSlipperyCoating"><rdfs:subClassOf rdf:resource="#WhiteCoating"/><rdfs:label xml:lang="zh">白滑苔</rdfs:label></owl:Class>
    <owl:Class rdf:about="#YellowCoating"><rdfs:subClassOf rdf:resource="#CoatingColor"/><rdfs:label xml:lang="zh">黄苔</rdfs:label></owl:Class>
    <owl:Class rdf:about="#YellowDryCoatingMild"><rdfs:subClassOf rdf:resource="#YellowCoating"/><rdfs:label xml:lang="zh">黄燥苔（阳明经证）</rdfs:label></owl:Class>
    <owl:Class rdf:about="#YellowScorchedCoating"><rdfs:subClassOf rdf:resource="#YellowCoating"/><rdfs:label xml:lang="zh">焦黄燥苔（阳明腑证）</rdfs:label></owl:Class>
    <owl:Class rdf:about="#GreyCoating"><rdfs:subClassOf rdf:resource="#CoatingColor"/><rdfs:label xml:lang="zh">灰苔</rdfs:label></owl:Class>
    <owl:Class rdf:about="#BlackCoating"><rdfs:subClassOf rdf:resource="#CoatingColor"/><rdfs:label xml:lang="zh">黑苔</rdfs:label></owl:Class>

    <!-- 苔质具体类 -->
    <owl:Class rdf:about="#ThinCoating"><rdfs:subClassOf rdf:resource="#CoatingTexture"/><rdfs:label xml:lang="zh">薄苔</rdfs:label></owl:Class>
    <owl:Class rdf:about="#ThickCoating"><rdfs:subClassOf rdf:resource="#CoatingTexture"/><rdfs:label xml:lang="zh">厚苔</rdfs:label></owl:Class>
    <owl:Class rdf:about="#GreasyCoating"><rdfs:subClassOf rdf:resource="#CoatingTexture"/><rdfs:label xml:lang="zh">腻苔</rdfs:label></owl:Class>
    <owl:Class rdf:about="#CurdyCoating"><rdfs:subClassOf rdf:resource="#CoatingTexture"/><rdfs:label xml:lang="zh">腐苔</rdfs:label></owl:Class>
    <owl:Class rdf:about="#PeelingCoating"><rdfs:subClassOf rdf:resource="#CoatingTexture"/><rdfs:label xml:lang="zh">剥苔</rdfs:label></owl:Class>
    <owl:Class rdf:about="#MirrorTongue"><rdfs:subClassOf rdf:resource="#PeelingCoating"/><rdfs:label xml:lang="zh">镜面舌</rdfs:label></owl:Class>

    <!-- 舌形具体类 -->
    <owl:Class rdf:about="#SwollenTongue"><rdfs:subClassOf rdf:resource="#TongueShape"/><rdfs:label xml:lang="zh">胖大舌</rdfs:label></owl:Class>
    <owl:Class rdf:about="#ThinTongue"><rdfs:subClassOf rdf:resource="#TongueShape"/><rdfs:label xml:lang="zh">瘦薄舌</rdfs:label></owl:Class>
    <owl:Class rdf:about="#TeethMarkedTongue"><rdfs:subClassOf rdf:resource="#TongueShape"/><rdfs:label xml:lang="zh">齿痕舌</rdfs:label></owl:Class>
    <owl:Class rdf:about="#CrackedTongue"><rdfs:subClassOf rdf:resource="#TongueShape"/><rdfs:label xml:lang="zh">裂纹舌</rdfs:label></owl:Class>
    <owl:Class rdf:about="#PrickledTongue"><rdfs:subClassOf rdf:resource="#TongueShape"/><rdfs:label xml:lang="zh">点刺舌</rdfs:label></owl:Class>
    <owl:Class rdf:about="#EcchymosisTongue"><rdfs:subClassOf rdf:resource="#TongueShape"/><rdfs:label xml:lang="zh">瘀斑舌</rdfs:label></owl:Class>
    <owl:Class rdf:about="#PetechialTongue"><rdfs:subClassOf rdf:resource="#TongueShape"/><rdfs:label xml:lang="zh">瘀点舌</rdfs:label></owl:Class>

    <!-- 舌态具体类 -->
    <owl:Class rdf:about="#StiffTongue"><rdfs:subClassOf rdf:resource="#TongueDynamics"/><rdfs:label xml:lang="zh">强硬舌</rdfs:label></owl:Class>
    <owl:Class rdf:about="#FlaccidTongue"><rdfs:subClassOf rdf:resource="#TongueDynamics"/><rdfs:label xml:lang="zh">痿软舌</rdfs:label></owl:Class>
    <owl:Class rdf:about="#TremblingTongue"><rdfs:subClassOf rdf:resource="#TongueDynamics"/><rdfs:label xml:lang="zh">颤动舌</rdfs:label></owl:Class>
    <owl:Class rdf:about="#DeviatedTongue"><rdfs:subClassOf rdf:resource="#TongueDynamics"/><rdfs:label xml:lang="zh">歪斜舌</rdfs:label></owl:Class>
    <owl:Class rdf:about="#ProtrudingTongue"><rdfs:subClassOf rdf:resource="#TongueDynamics"/><rdfs:label xml:lang="zh">吐弄舌</rdfs:label></owl:Class>
    <owl:Class rdf:about="#ShortenedTongue"><rdfs:subClassOf rdf:resource="#TongueDynamics"/><rdfs:label xml:lang="zh">短缩舌</rdfs:label></owl:Class>
    <owl:Class rdf:about="#ShortenedColdTongue"><rdfs:subClassOf rdf:resource="#ShortenedTongue"/><rdfs:label xml:lang="zh">短缩舌·寒凝型</rdfs:label></owl:Class>
    <owl:Class rdf:about="#ShortenedHeatTongue"><rdfs:subClassOf rdf:resource="#ShortenedTongue"/><rdfs:label xml:lang="zh">短缩舌·热极型</rdfs:label></owl:Class>
    <owl:Class rdf:about="#TongueCurling"><rdfs:subClassOf rdf:resource="#TongueDynamics"/><rdfs:label xml:lang="zh">舌卷</rdfs:label></owl:Class>

    <!-- 舌下络脉具体类 -->
    <owl:Class rdf:about="#NormalSublingualVein"><rdfs:subClassOf rdf:resource="#SublingualVein"/><rdfs:label xml:lang="zh">正常舌下络脉</rdfs:label></owl:Class>
    <owl:Class rdf:about="#PurpleDistendedVein"><rdfs:subClassOf rdf:resource="#SublingualVein"/><rdfs:label xml:lang="zh">舌下络脉瘀紫怒张</rdfs:label></owl:Class>

    <!-- 舌面润燥具体类 -->
    <owl:Class rdf:about="#MoistTongue"><rdfs:subClassOf rdf:resource="#TongueMoisture"/><rdfs:label xml:lang="zh">润舌</rdfs:label></owl:Class>
    <owl:Class rdf:about="#SlipperyTongue"><rdfs:subClassOf rdf:resource="#TongueMoisture"/><rdfs:label xml:lang="zh">滑舌</rdfs:label></owl:Class>
    <owl:Class rdf:about="#DryTongue"><rdfs:subClassOf rdf:resource="#TongueMoisture"/><rdfs:label xml:lang="zh">燥舌</rdfs:label></owl:Class>
    <owl:Class rdf:about="#RoughTongue"><rdfs:subClassOf rdf:resource="#TongueMoisture"/><rdfs:label xml:lang="zh">糙舌</rdfs:label></owl:Class>

    <!-- ========== 病机类 ========== -->
    <owl:Class rdf:about="#Pathomechanism"><rdfs:subClassOf rdf:resource="#TongueDiagnosisRoot"/><rdfs:label xml:lang="zh">病机</rdfs:label></owl:Class>
    <owl:Class rdf:about="#WeiFengPathomechanism"><rdfs:subClassOf rdf:resource="#Pathomechanism"/><rdfs:label xml:lang="zh">卫分病机</rdfs:label></owl:Class>
    <owl:Class rdf:about="#QiFengPathomechanism"><rdfs:subClassOf rdf:resource="#Pathomechanism"/><rdfs:label xml:lang="zh">气分病机</rdfs:label></owl:Class>
    <owl:Class rdf:about="#YingFengPathomechanism"><rdfs:subClassOf rdf:resource="#Pathomechanism"/><rdfs:label xml:lang="zh">营分病机</rdfs:label></owl:Class>
    <owl:Class rdf:about="#ShaoyinRehuaPathomechanism"><rdfs:subClassOf rdf:resource="#Pathomechanism"/><rdfs:label xml:lang="zh">少阴热化病机</rdfs:label></owl:Class>
    <owl:Class rdf:about="#XueFengPathomechanism"><rdfs:subClassOf rdf:resource="#Pathomechanism"/><rdfs:label xml:lang="zh">血分病机</rdfs:label></owl:Class>
    <owl:Class rdf:about="#DampnessHeatPathomechanism"><rdfs:subClassOf rdf:resource="#Pathomechanism"/><rdfs:label xml:lang="zh">湿热病机</rdfs:label></owl:Class>
    <owl:Class rdf:about="#FluidDepletionPathomechanism"><rdfs:subClassOf rdf:resource="#Pathomechanism"/><rdfs:label xml:lang="zh">津液亏伤病机</rdfs:label></owl:Class>
    <owl:Class rdf:about="#BloodStasisPathomechanism"><rdfs:subClassOf rdf:resource="#Pathomechanism"/><rdfs:label xml:lang="zh">瘀血病机</rdfs:label></owl:Class>
    <owl:Class rdf:about="#WaterRetentionPathomechanism"><rdfs:subClassOf rdf:resource="#Pathomechanism"/><rdfs:label xml:lang="zh">水饮病机</rdfs:label></owl:Class>
    <owl:Class rdf:about="#FoodStagnationPathomechanism"><rdfs:subClassOf rdf:resource="#Pathomechanism"/><rdfs:label xml:lang="zh">食积病机</rdfs:label></owl:Class>
    <owl:Class rdf:about="#YangDeficiencyPathomechanism"><rdfs:subClassOf rdf:resource="#Pathomechanism"/><rdfs:label xml:lang="zh">阳虚寒盛病机</rdfs:label></owl:Class>
    <owl:Class rdf:about="#InternalWindPathomechanism"><rdfs:subClassOf rdf:resource="#Pathomechanism"/><rdfs:label xml:lang="zh">肝风内动病机</rdfs:label></owl:Class>
    <owl:Class rdf:about="#HeartPackageBlockagePathomechanism"><rdfs:subClassOf rdf:resource="#Pathomechanism"/><rdfs:label xml:lang="zh">热闭心包病机</rdfs:label></owl:Class>
    <owl:Class rdf:about="#TaiyinPathomechanism"><rdfs:subClassOf rdf:resource="#Pathomechanism"/><rdfs:label xml:lang="zh">太阴病机</rdfs:label></owl:Class>

    <!-- ========== 卫气营血阶段类 ========== -->
    <owl:Class rdf:about="#WeiQiYingXueStage"><rdfs:subClassOf rdf:resource="#TongueDiagnosisRoot"/><rdfs:label xml:lang="zh">卫气营血阶段</rdfs:label></owl:Class>
    <owl:Class rdf:about="#WeiStage"><rdfs:subClassOf rdf:resource="#WeiQiYingXueStage"/><rdfs:label xml:lang="zh">卫分</rdfs:label></owl:Class>
    <owl:Class rdf:about="#QiStage"><rdfs:subClassOf rdf:resource="#WeiQiYingXueStage"/><rdfs:label xml:lang="zh">气分</rdfs:label></owl:Class>
    <owl:Class rdf:about="#YingStage"><rdfs:subClassOf rdf:resource="#WeiQiYingXueStage"/><rdfs:label xml:lang="zh">营分</rdfs:label></owl:Class>
    <owl:Class rdf:about="#XueStage"><rdfs:subClassOf rdf:resource="#WeiQiYingXueStage"/><rdfs:label xml:lang="zh">血分</rdfs:label></owl:Class>

    <!-- ========== 对象属性 ========== -->
    <owl:ObjectProperty rdf:about="#indicatesPathomechanism">
        <rdfs:domain rdf:resource="#TongueManifestation"/>
        <rdfs:range rdf:resource="#Pathomechanism"/>
        <rdfs:label xml:lang="zh">所主病机</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#correspondsToWeiQiYingXue">
        <rdfs:domain rdf:resource="#TongueManifestation"/>
        <rdfs:range rdf:resource="#WeiQiYingXueStage"/>
        <rdfs:label xml:lang="zh">对应卫气营血阶段</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#progressesTo">
        <rdfs:domain rdf:resource="#TongueManifestation"/>
        <rdfs:range rdf:resource="#TongueManifestation"/>
        <rdfs:label xml:lang="zh">传变为</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#progressesFrom">
        <rdfs:domain rdf:resource="#TongueManifestation"/>
        <rdfs:range rdf:resource="#TongueManifestation"/>
        <rdfs:label xml:lang="zh">传变自</rdfs:label>
        <owl:inverseOf rdf:resource="#progressesTo"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#relatedTo">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="#TongueManifestation"/>
        <rdfs:range rdf:resource="#TongueManifestation"/>
        <rdfs:label xml:lang="zh">相关舌象</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#supportedBySymptom">
        <rdfs:label xml:lang="zh">对应方剂</rdfs:label>
    </owl:ObjectProperty>

    <!-- ========== 数据属性 ========== -->
    <owl:DatatypeProperty rdf:about="#classicalSource">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:label xml:lang="zh">经典出处</rdfs:label>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#wenbingNote">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:label xml:lang="zh">温病按语</rdfs:label>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#prognosisIndicator">
        <rdfs:domain rdf:resource="#TongueManifestation"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:label xml:lang="zh">预后指标</rdfs:label>
    </owl:DatatypeProperty>

</rdf:RDF>