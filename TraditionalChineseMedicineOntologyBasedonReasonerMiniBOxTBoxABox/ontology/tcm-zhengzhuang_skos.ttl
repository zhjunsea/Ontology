zzskos:Xinzhongaonao a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "心中懊憹"@zh ;
    skos:definition "心中烦闷懊憹，难以名状。热扰胸膈之候。"@zh ;
    skos:altLabel         "懊憹"@zh ;
    skos:hiddenLabel         "心里烦闷难受"@zh,
        "心里说不出的难受"@zh,
        "心烦意乱"@zh ;
    skos:note "伤寒论第76条：'发汗吐下后，虚烦不得眠，若剧者，必反复颠倒，心中懊憹，栀子豉汤主之。'"@zh ;
    skos:broader zzskos:Xinfan ;
    skos:notation "Xinzhongaonao_instance" ;
    skos:exactMatch zz:Xinzhongaonao_instance ;
    zz:classMatch zz:Xinzhongaonao .

zzskos:Xinzhongehanbuzu a skos:Concept ;
