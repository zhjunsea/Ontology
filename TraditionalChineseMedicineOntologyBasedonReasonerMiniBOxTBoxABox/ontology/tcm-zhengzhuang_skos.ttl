    skos:prefLabel "口舌干燥"@zh ;
    skos:definition "口舌干燥。津液不足。"@zh ;
    skos:hiddenLabel         "口舌都干"@zh,
        "嘴和舌头都干"@zh ;
    skos:note "伤寒论第168条。"@zh ;
