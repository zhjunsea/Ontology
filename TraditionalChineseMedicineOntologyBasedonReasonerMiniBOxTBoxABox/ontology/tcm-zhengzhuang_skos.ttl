    skos:hiddenLabel         "四肢又沉又重又疼"@zh ;
    skos:note "伤寒论第316条：'少阴病，二三日不已，至四五日，腹痛，小便不利，四肢沉重疼痛，自下利者……真武汤主之。'"@zh ;
    skos:notation "Sizhichenzhongtengtong_instance" ;
    skos:exactMatch zz:Sizhichenzhongtengtong_instance ;
