zzskos:Budexi a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "不得息"@zh ;
    skos:definition "呼吸不得平顺。"@zh ;
    skos:hiddenLabel         "喘不过气"@zh,
        "气透不过来"@zh ;
    skos:note "金匮要略·痰饮。"@zh ;
    skos:closeMatch zzskos:Qini,
        zzskos:Shangqi ;
    skos:notation "Budexi_instance" ;
    skos:exactMatch zz:Budexi_instance ;
