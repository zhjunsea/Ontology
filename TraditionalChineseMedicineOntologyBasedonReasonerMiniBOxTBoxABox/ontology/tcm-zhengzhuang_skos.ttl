zzskos:Chunan a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "唇暗"@zh ;
    skos:definition "口唇色暗。瘀血或寒凝。"@zh ;
    skos:altLabel         "唇色暗"@zh ;
    skos:hiddenLabel         "嘴唇发暗"@zh,
        "唇色发紫暗"@zh ;
