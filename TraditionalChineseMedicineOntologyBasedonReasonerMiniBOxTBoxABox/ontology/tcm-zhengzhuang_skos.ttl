zzskos:Kousheburen a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "口舌不仁"@zh ;
    skos:definition "口舌麻木不仁。"@zh ;
    skos:hiddenLabel         "口舌麻木"@zh ;
    skos:notation "Kousheburen_instance" ;
    skos:exactMatch zz:Kousheburen_instance ;
    zz:classMatch zz:Kousheburen .

zzskos:Koujin a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "口噤"@zh ;
    skos:definition "口不能开。痉病或热极动风。"@zh ;
