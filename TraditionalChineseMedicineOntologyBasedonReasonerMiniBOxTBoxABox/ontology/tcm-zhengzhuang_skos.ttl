    skos:prefLabel "脚气冲心"@zh ;
    skos:definition "脚气冲心，气逆上冲。"@zh ;
    skos:note "金匮要略·中风历节病。"@zh ;
    skos:notation "Jiaoqichongxin_instance" ;
    skos:exactMatch zz:Jiaoqichongxin_instance ;
