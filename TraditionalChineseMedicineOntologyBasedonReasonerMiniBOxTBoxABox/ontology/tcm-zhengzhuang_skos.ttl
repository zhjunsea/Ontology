zzskos:Xinzhongtengre a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "心中疼热"@zh ;
    skos:definition "心中疼痛而热。蛔厥之候。"@zh ;
    skos:hiddenLabel         "心里又疼又热"@zh ;
    skos:note "伤寒论第338条：'蛔厥者……心中疼热。'"@zh ;
    skos:closeMatch zzskos:Huichong,
