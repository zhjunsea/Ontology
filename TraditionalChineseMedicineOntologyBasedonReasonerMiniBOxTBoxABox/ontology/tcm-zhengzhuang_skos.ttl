zzskos:Jiexiong a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "结胸"@zh ;
    skos:definition "邪结胸中，心下硬痛。"@zh ;
    skos:hiddenLabel         "胸脘硬痛拒按"@zh ;
    skos:note "伤寒论第128条：'问曰：病有结胸，有脏结，其状何如？答曰：按之痛，寸脉浮，关脉沉，名曰结胸也。'"@zh ;
    skos:narrower zzskos:Hanshijiexiong ;
    skos:closeMatch zzskos:Hanshijiexiong ;
    skos:notation "Jiexiong_instance" ;
    skos:exactMatch zz:Jiexiong_instance ;
