    skos:hiddenLabel         "气短"@zh,
        "喘不上气"@zh,
        "气不够用"@zh ;
    skos:note "金匮要略·胸痹心痛短气病。"@zh ;
    skos:closeMatch zzskos:Chuan,
        zzskos:Keni,
        zzskos:Kesou,
