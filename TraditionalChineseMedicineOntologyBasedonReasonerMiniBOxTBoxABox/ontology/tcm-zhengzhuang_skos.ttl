zzskos:Xiongxiekuman a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "胸胁苦满"@zh ;
    skos:definition "胸胁部胀满不舒，甚则疼痛。少阳病特异性指征，邪结少阳、枢机不利。"@zh ;
    skos:altLabel         "胸胁满"@zh,
        "胁满"@zh ;
    skos:hiddenLabel         "两边肋骨下面胀痛"@zh,
        "两边肋骨胀痛"@zh,
        "肋骨下胀痛"@zh,
        "胁肋胀痛"@zh,
        "两侧肋部胀满"@zh,
        "肋骨下胀"@zh,
        "胁下胀痛"@zh,
        "两肋胀痛"@zh,
        "胸胁胀满"@zh ;
    skos:note "伤寒论第96条：'伤寒五六日中风，往来寒热，胸胁苦满，嘿嘿不欲饮食，心烦喜呕……小柴胡汤主之。'胡老：胸胁苦满为少阳病第一主症，按之亦满痛。"@zh ;
    skos:narrower zzskos:Xiongman,
        zzskos:Xietong,
        zzskos:Xiexiapiying,
        zzskos:Xiexiaman ;
