    skos:exactMatch zz:Shouzunileng_instance ;
    zz:classMatch zz:Shouzunileng .

zzskos:Shouzuleng a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
