zzskos:Shaoqi a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "少气"@zh ;
    skos:definition "气力不足，言语无力。虚劳或气虚之候。"@zh ;
    skos:altLabel         "气少"@zh ;
    skos:hiddenLabel         "乏力"@zh,
        "没劲"@zh,
        "浑身没劲"@zh,
        "气力不足"@zh,
        "容易累"@zh ;
    skos:note "金匮要略·血痹虚劳：'虚劳里急，悸，衄，腹中痛，梦失精，四肢酸疼，手足烦热，咽干口燥，小建中汤主之。'"@zh ;
    skos:closeMatch zzskos:Chuan,
        zzskos:Duanqi,
        zzskos:Keni,
        zzskos:Kesou,
        zzskos:Ketuo,
        zzskos:Shangqi ;
    skos:notation "Shaoqi_instance" ;
    skos:exactMatch zz:Shaoqi_instance ;
