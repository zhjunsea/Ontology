zzskos:Fare a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "发热"@zh ;
    skos:definition "体温升高，或自觉身热。为正气抗邪之反应，六经皆有发热，须辨其热型与兼证。"@zh ;
    skos:altLabel         "发烧"@zh,
        "壮热"@zh,
        "身大热"@zh ;
    skos:hiddenLabel         "烧"@zh,
        "发烫"@zh,
        "体温高"@zh,
        "有点烧"@zh,
        "身上烫"@zh,
        "发烧了"@zh,
        "发热了"@zh,
        "体温37度以上"@zh ;
    skos:note "伤寒论第3条：'太阳病，或已发热，或未发热，必恶寒。'胡老：发热恶寒发于阳，无热恶寒发于阴。"@zh ;
    skos:narrower zzskos:Ere,
        zzskos:Danrebuhan,
        zzskos:Chaore,
        zzskos:Shenre,
        zzskos:Dare,
        zzskos:Shishifare,
        zzskos:Xixifare,
        zzskos:Zhengzhengfare,
        zzskos:Ribusuofare,
        zzskos:Fanre,
        zzskos:Weire,
        zzskos:Shenzhuore,
        zzskos:Mianre,
        zzskos:Shitoure ;
    skos:closeMatch zzskos:Dare,
        zzskos:Fanre,
        zzskos:Mianre,
        zzskos:Shenre,
        zzskos:Shenzhuore,
        zzskos:Shitoure,
        zzskos:Weire ;
    skos:notation "Fare_instance" ;
    skos:exactMatch zz:Fare_instance ;
    zz:classMatch zz:Fare .

zzskos:Ere a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "恶热"@zh ;
    skos:definition "自觉怕热、不耐热。阳明里热炽盛之特异性指征，与太阳表证之恶寒相对。"@zh ;
    skos:altLabel         "怕热"@zh,
        "畏热"@zh,
        "不耐热"@zh,
        "身畏热"@zh ;
    skos:hiddenLabel         "热得慌"@zh,
        "不喜欢热"@zh,
        "一热就烦"@zh,
        "嫌热"@zh,
        "讨厌热"@zh ;
    skos:note "伤寒论第182条：'身热，汗自出，不恶寒，反恶热也。'胡老：此为里热之确据。"@zh ;
    skos:broader zzskos:Fare ;
    skos:notation "Ere_instance" ;
    skos:exactMatch zz:Ere_instance ;
    zz:classMatch zz:Ere .

zzskos:Ehan a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "恶寒"@zh ;
    skos:definition "自觉怕冷，加衣被不减。太阳表证或少阴里虚寒均可见。"@zh ;
    skos:altLabel         "恶风寒"@zh,
        "憎寒"@zh,
        "寒战"@zh,
        "洒淅恶寒"@zh,
        "啬啬恶寒"@zh ;
    skos:hiddenLabel         "怕冷"@zh,
        "发冷"@zh,
        "打寒战"@zh,
        "觉得冷"@zh,
        "冻得慌"@zh,
        "盖被子也冷"@zh,
        "冷战"@zh,
        "浑身发冷"@zh,
        "冷得发抖"@zh ;
    skos:note "伤寒论第7条：'病有发热恶寒者，发于阳也；无热恶寒者，发于阴也。'胡老：太阳之恶寒与发热并见，少阴之恶寒不发热而但欲寐。"@zh ;
    skos:narrower zzskos:Efeng,
        zzskos:Weihan,
        zzskos:Beiehan,
        zzskos:Beihanleng,
        zzskos:Sasaehan,
        zzskos:Shendahan,
        zzskos:Wureehan ;
    skos:closeMatch zzskos:Shenduohan,
        zzskos:Shenhan,
        zzskos:WeiHan,
        zzskos:Weihan ;
    skos:notation "Ehan_instance" ;
    skos:exactMatch zz:Ehan_instance ;
    zz:classMatch zz:Ehan .

zzskos:Efeng a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "恶风"@zh ;
    skos:definition "自觉怕风，遇风则冷，避风则缓。太阳中风证（表虚证）特异性指征。"@zh ;
    skos:altLabel         "畏风"@zh,
        "恶风怕冷"@zh,
        "不耐风"@zh,
        "淅淅恶风"@zh ;
    skos:hiddenLabel         "怕风"@zh,
        "怕吹风"@zh,
        "见风冷"@zh,
        "不喜欢风"@zh,
        "避风"@zh,
        "一吹风就不舒服"@zh,
        "吹风就冷"@zh ;
    skos:note "伤寒论第12条：'太阳中风……淅淅恶风。'胡老：恶风为太阳中风（表虚）之主症。"@zh ;
    skos:broader zzskos:Ehan ;
    skos:notation "Efeng_instance" ;
    skos:exactMatch zz:Efeng_instance ;
    zz:classMatch zz:Efeng .

zzskos:Weihan a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "微恶寒"@zh ;
    skos:definition "恶寒之轻者。见于表证轻浅或柴胡桂枝汤证。"@zh ;
    skos:altLabel         "微恶风寒"@zh,
        "恶寒轻"@zh ;
    skos:hiddenLabel         "有点怕冷"@zh,
        "稍微怕冷"@zh,
        "略怕冷"@zh ;
    skos:note "伤寒论第146条：'伤寒六七日，发热微恶寒，支节烦疼……柴胡桂枝汤主之。'"@zh ;
    skos:broader zzskos:Ehan ;
    skos:closeMatch zzskos:Ehan,
        zzskos:Shenduohan,
        zzskos:Shenhan,
        zzskos:WeiHan ;
    skos:notation "Weihan_instance" ;
    skos:exactMatch zz:Weihan_instance ;
    zz:classMatch zz:Weihan .

zzskos:Beiehan a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "背恶寒"@zh ;
    skos:definition "背部自觉恶寒。多属阳虚，或痰饮内停、阳气不布。"@zh ;
    skos:altLabel         "背恶风寒"@zh ;
    skos:hiddenLabel         "后背怕冷"@zh,
        "背上发冷"@zh,
        "后背凉"@zh ;
    skos:note "伤寒论第304条：'少阴病，得之一二日，口中和，其背恶寒者，当灸之，附子汤主之。'"@zh ;
    skos:broader zzskos:Ehan ;
    skos:closeMatch zzskos:Beihanleng,
        zzskos:Beihanlengruzhangda ;
    skos:notation "Beiehan_instance" ;
    skos:exactMatch zz:Beiehan_instance ;
    zz:classMatch zz:Beiehan .

zzskos:Beihanleng a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "背寒冷"@zh ;
    skos:definition "背部寒冷，触之亦冷。阳虚寒盛或水饮停聚之征。"@zh ;
    skos:altLabel         "背冷"@zh ;
    skos:hiddenLabel         "后背冰凉"@zh,
        "背上凉飕飕"@zh ;
    skos:note "金匮要略·痰饮：'夫心下有留饮，其人背寒冷如手大。'"@zh ;
    skos:broader zzskos:Ehan ;
    skos:closeMatch zzskos:Beiehan,
        zzskos:Beihanlengruzhangda ;
    skos:notation "Beihanleng_instance" ;
    skos:exactMatch zz:Beihanleng_instance ;
    zz:classMatch zz:Beihanleng .

zzskos:Shenhan a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "身寒"@zh ;
    skos:definition "身体触之发冷，为客观之寒，与主观恶寒有别。多属阳虚阴盛。"@zh ;
    skos:altLabel         "身冷"@zh,
        "身体发冷"@zh ;
    skos:hiddenLabel         "身上冷"@zh,
        "浑身凉"@zh,
        "全身发冷"@zh ;
    skos:note "胡老：身寒为阳气不足、不能温煦之候，与恶寒之自觉症不同。"@zh ;
    skos:closeMatch zzskos:Ehan,
        zzskos:Shenduohan,
        zzskos:WeiHan,
        zzskos:Weihan ;
    skos:notation "Shenhan_instance" ;
    skos:exactMatch zz:Shenhan_instance ;
    zz:classMatch zz:Shenhan .

zzskos:Mujifare a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "暮即发热"@zh ;
    skos:definition "傍晚时分发热。多属阴虚或瘀血内结。"@zh ;
    skos:altLabel         "暮发热"@zh ;
    skos:hiddenLabel         "傍晚发热"@zh,
        "晚上发烧"@zh ;
    skos:note "金匮要略·血痹虚劳：'暮即发热'属虚劳，宜温经补虚。"@zh ;
    skos:notation "Mujifare_instance" ;
    skos:exactMatch zz:Mujifare_instance ;
    zz:classMatch zz:Mujifare .

zzskos:Danrebuhan a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "但热不寒"@zh ;
    skos:definition "但发热而不恶寒。阳明里热之候。"@zh ;
    skos:altLabel         "但热"@zh ;
    skos:hiddenLabel         "只热不冷"@zh,
        "光热不冷"@zh ;
    skos:note "伤寒论第182条：'不恶寒，反恶热'即此。"@zh ;
    skos:broader zzskos:Fare ;
    skos:notation "Danrebuhan_instance" ;
    skos:exactMatch zz:Danrebuhan_instance ;
    zz:classMatch zz:Danrebuhan .

zzskos:Chaore a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "潮热"@zh ;
    skos:definition "热势如潮，定时而发（日晡所，即申时前后）。阳明腑实典型热型。"@zh ;
    skos:altLabel         "日晡发热"@zh,
        "日晡所发潮热"@zh ;
    skos:hiddenLabel         "下午发烧"@zh,
        "到点就烧"@zh,
        "傍晚热"@zh,
        "定时发热"@zh,
        "午后发热"@zh ;
    skos:note "伤寒论第208条。胡老：日晡所潮热，属阳明，宜承气汤。"@zh ;
    skos:broader zzskos:Fare ;
    skos:closeMatch zzskos:Ribusuofare,
        zzskos:Ripuchaore ;
    skos:notation "Chaore_instance" ;
    skos:exactMatch zz:Chaore_instance ;
    zz:classMatch zz:Chaore .

zzskos:Wanglaihanre a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "往来寒热"@zh ;
    skos:definition "寒热交替发作，正邪分争，有明确时序交替特征。少阳病特异性热型。"@zh ;
    skos:altLabel         "寒热交作"@zh,
        "寒热交争"@zh ;
    skos:hiddenLabel         "忽冷忽热"@zh,
        "一会冷一会热"@zh,
        "冷热交替"@zh,
        "打摆子"@zh,
        "一阵冷一阵热"@zh,
        "时冷时热"@zh ;
    skos:note "伤寒论第96条。胡老：往来寒热为少阳病独有热型，小柴胡汤主之。"@zh ;
    skos:narrower zzskos:Runvezhuang,
        zzskos:Yirizaifa,
        zzskos:HanreWanglai,
        zzskos:Xiuzuoyoushi ;
    skos:closeMatch zzskos:HanreWanglai,
        zzskos:Runvezhuang,
        zzskos:Xiuzuoyoushi,
        zzskos:Yirizaifa ;
    skos:notation "Wanglaihanre_instance" ;
    skos:exactMatch zz:Wanglaihanre_instance ;
    zz:classMatch zz:Wanglaihanre .

zzskos:Shenre a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "身热"@zh ;
    skos:definition "身体灼热，但热不寒。阳明里热蒸腾于外。"@zh ;
    skos:altLabel         "肌肤灼热"@zh ;
    skos:hiddenLabel         "浑身烫"@zh,
        "烧得厉害"@zh,
        "滚烫"@zh,
        "全身发热"@zh ;
    skos:note "伤寒论第182条。白虎汤证四大症之一。"@zh ;
    skos:broader zzskos:Fare ;
    skos:closeMatch zzskos:Dare,
        zzskos:Fanre,
        zzskos:Fare,
        zzskos:Mianre,
        zzskos:Shenzhuore,
        zzskos:Shitoure,
        zzskos:Weire ;
    skos:notation "Shenre_instance" ;
    skos:exactMatch zz:Shenre_instance ;
    zz:classMatch zz:Shenre .

zzskos:Shenrebuqu a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "身热不去"@zh ;
    skos:definition "身热持续不去。多属湿热留恋或里热未清。"@zh ;
    skos:altLabel         "身热不退"@zh ;
    skos:hiddenLabel         "一直发烧"@zh,
        "烧退不下来"@zh,
        "持续发热"@zh ;
    skos:note "伤寒论第63条：'发汗后，不可更行桂枝汤，汗出而喘，无大热者……'"@zh ;
    skos:notation "Shenrebuqu_instance" ;
    skos:exactMatch zz:Shenrebuqu_instance ;
    zz:classMatch zz:Shenrebuqu .

zzskos:Dare a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "大热"@zh ;
    skos:definition "热势炽盛。阳明里热亢盛之候。"@zh ;
    skos:hiddenLabel         "高烧"@zh,
        "烧得很高"@zh,
        "热得厉害"@zh ;
    skos:note "胡老：大热为阳明经热，白虎汤主之。"@zh ;
    skos:broader zzskos:Fare ;
    skos:closeMatch zzskos:Fanre,
        zzskos:Fare,
        zzskos:Mianre,
        zzskos:Shenre,
        zzskos:Shenzhuore,
        zzskos:Shitoure,
        zzskos:Weire ;
    skos:notation "Dare_instance" ;
    skos:exactMatch zz:Dare_instance ;
    zz:classMatch zz:Dare .

zzskos:Sasaehan a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "洒洒恶寒"@zh ;
    skos:definition "如冷水洒身之恶寒，阵阵发作。太阳表证之恶寒貌。"@zh ;
    skos:hiddenLabel         "一阵阵发冷"@zh,
        "冷飕飕"@zh ;
    skos:note "伤寒论第12条：'啬啬恶寒，淅淅恶风'，桂枝汤证。"@zh ;
    skos:broader zzskos:Ehan ;
    skos:notation "Sasaehan_instance" ;
    skos:exactMatch zz:Sasaehan_instance ;
    zz:classMatch zz:Sasaehan .

zzskos:Shishifare a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "时时发热"@zh ;
    skos:definition "发热时作时止。多属表证未解或正邪交争。"@zh ;
    skos:hiddenLabel         "一阵阵发热"@zh,
        "时不时发烧"@zh ;
    skos:note "伤寒论第48条。"@zh ;
    skos:broader zzskos:Fare ;
    skos:notation "Shishifare_instance" ;
    skos:exactMatch zz:Shishifare_instance ;
    zz:classMatch zz:Shishifare .

zzskos:Wuhanre a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "无寒热"@zh ;
    skos:definition "既不畏寒亦不发热。多见于里证或病在血分。"@zh ;
    skos:hiddenLabel         "不冷不热"@zh,
        "没有寒热"@zh ;
    skos:note "金匮要略·妇人杂病：'妇人宿有癥病……所以血不止者，其癥不去故也。'"@zh ;
    skos:notation "Wuhanre_instance" ;
    skos:exactMatch zz:Wuhanre_instance ;
    zz:classMatch zz:Wuhanre .

zzskos:Shenwure a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "身无热"@zh ;
    skos:definition "身体无发热。"@zh ;
    skos:hiddenLabel         "身上不热"@zh,
        "体温正常"@zh ;
    skos:notation "Shenwure_instance" ;
    skos:exactMatch zz:Shenwure_instance ;
    zz:classMatch zz:Shenwure .

zzskos:Mianyourese a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "面有热色"@zh ;
    skos:definition "面部呈现热色。表郁轻证，阳气怫郁在表。"@zh ;
    skos:hiddenLabel         "脸上发红发热"@zh,
        "脸发烫"@zh ;
    skos:note "伤寒论第23条：'面色反有热色者，未欲解也，以其不能得小汗出，身必痒，宜桂枝麻黄各半汤。'"@zh ;
    skos:notation "Mianyourese_instance" ;
    skos:exactMatch zz:Mianyourese_instance ;
    zz:classMatch zz:Mianyourese .

zzskos:Reduohanshao a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "热多寒少"@zh ;
    skos:definition "发热多而恶寒少。表证渐解，正气渐复。"@zh ;
    skos:hiddenLabel         "热多冷少"@zh ;
    skos:note "伤寒论第23条：'太阳病，得之八九日，如疟状，发热恶寒，热多寒少。'"@zh ;
    skos:notation "Reduohanshao_instance" ;
    skos:exactMatch zz:Reduohanshao_instance ;
    zz:classMatch zz:Reduohanshao .

zzskos:Handuoreshao a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "寒多热少"@zh ;
    skos:definition "恶寒多而发热少。阳虚寒盛之候。"@zh ;
    skos:hiddenLabel         "冷多热少"@zh ;
    skos:note "伤寒论第23条。"@zh ;
    skos:notation "Handuoreshao_instance" ;
    skos:exactMatch zz:Handuoreshao_instance ;
    zz:classMatch zz:Handuoreshao .

zzskos:Runvezhuang a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "如疟状"@zh ;
    skos:definition "寒热发作如疟疾之状。"@zh ;
    skos:altLabel         "如疟"@zh ;
    skos:hiddenLabel         "像打摆子"@zh,
        "像疟疾一样"@zh ;
    skos:note "伤寒论第23条：'如疟状，发热恶寒。'"@zh ;
    skos:broader zzskos:Wanglaihanre ;
    skos:narrower zzskos:Yirizaifa ;
    skos:closeMatch zzskos:HanreWanglai,
        zzskos:Wanglaihanre,
        zzskos:Xiuzuoyoushi,
        zzskos:Yirizaifa ;
    skos:notation "Runvezhuang_instance" ;
    skos:exactMatch zz:Runvezhuang_instance ;
    zz:classMatch zz:Runvezhuang .

zzskos:Yirizaifa a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "一日再发"@zh ;
    skos:definition "一日发作两次。表郁轻证之热型。"@zh ;
    skos:hiddenLabel         "一天发作两次"@zh ;
    skos:note "伤寒论第23条：'一日再发者，汗出必解，宜桂枝二麻黄一汤。'"@zh ;
    skos:broader zzskos:Runvezhuang,
        zzskos:Wanglaihanre ;
    skos:closeMatch zzskos:HanreWanglai,
        zzskos:Runvezhuang,
        zzskos:Wanglaihanre,
        zzskos:Xiuzuoyoushi ;
    skos:notation "Yirizaifa_instance" ;
    skos:exactMatch zz:Yirizaifa_instance ;
    zz:classMatch zz:Yirizaifa .

zzskos:Shendahan a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "身大寒"@zh ;
    skos:definition "身体大寒。阴寒内盛，阳气衰微之危候。"@zh ;
    skos:hiddenLabel         "浑身冰冷"@zh,
        "全身发冷得厉害"@zh ;
    skos:note "伤寒论第11条：'身大寒，反不欲近衣者，寒在皮肤，热在骨髓也。'"@zh ;
    skos:broader zzskos:Ehan ;
    skos:notation "Shendahan_instance" ;
    skos:exactMatch zz:Shendahan_instance ;
    zz:classMatch zz:Shendahan .

zzskos:Wureehan a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "无热恶寒"@zh ;
    skos:definition "不发热而但恶寒。病发于阴，多属少阴、太阴。"@zh ;
    skos:hiddenLabel         "不发烧但怕冷"@zh,
        "光冷"@zh ;
    skos:note "伤寒论第7条：'无热恶寒者，发于阴也。'胡老：此属少阴。"@zh ;
    skos:broader zzskos:Ehan ;
    skos:notation "Wureehan_instance" ;
    skos:exactMatch zz:Wureehan_instance ;
    zz:classMatch zz:Wureehan .

zzskos:Xixifare a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "翕翕发热"@zh ;
    skos:definition "发热如羽毛覆盖之轻浅状。太阳中风之发热貌。"@zh ;
    skos:hiddenLabel         "微微发热"@zh,
        "身上温热"@zh ;
    skos:note "伤寒论第12条：'翕翕发热，鼻鸣干呕者，桂枝汤主之。'"@zh ;
    skos:broader zzskos:Fare ;
    skos:notation "Xixifare_instance" ;
    skos:exactMatch zz:Xixifare_instance ;
    zz:classMatch zz:Xixifare .

zzskos:Zhengzhengfare a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "蒸蒸发热"@zh ;
    skos:definition "发热如蒸笼之状，热自内蒸。阳明里热之候。"@zh ;
    skos:hiddenLabel         "蒸蒸地热"@zh,
        "一阵阵热得冒汗"@zh ;
    skos:note "伤寒论第248条：'太阳病三日，发汗不解，蒸蒸发热者，属胃也，调胃承气汤主之。'"@zh ;
    skos:broader zzskos:Fare ;
    skos:notation "Zhengzhengfare_instance" ;
    skos:exactMatch zz:Zhengzhengfare_instance ;
    zz:classMatch zz:Zhengzhengfare .

zzskos:Ribusuofare a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "日晡所发热"@zh ;
    skos:definition "日晡（申时）发热。阳明腑实之热型。"@zh ;
    skos:hiddenLabel         "下午发热"@zh,
        "傍晚发烧"@zh ;
    skos:note "伤寒论第240条。"@zh ;
    skos:broader zzskos:Fare ;
    skos:closeMatch zzskos:Chaore,
        zzskos:Ripuchaore ;
    skos:notation "Ribusuofare_instance" ;
    skos:exactMatch zz:Ribusuofare_instance ;
    zz:classMatch zz:Ribusuofare .

zzskos:Buehan a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "不恶寒"@zh ;
    skos:definition "不畏寒。里热之征，或表证已解。"@zh ;
    skos:hiddenLabel         "不怕冷"@zh ;
    skos:note "伤寒论第182条：'不恶寒，反恶热。'"@zh ;
    skos:notation "Buehan_instance" ;
    skos:exactMatch zz:Buehan_instance ;
    zz:classMatch zz:Buehan .

zzskos:Shouzuwen a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "手足温"@zh ;
    skos:definition "手足温暖。阳气尚能达于四末，病势较轻。"@zh ;
    skos:hiddenLabel         "手脚温热"@zh,
        "手脚暖和"@zh ;
    skos:note "伤寒论第287条：'少阴病，脉紧，至七八日，自下利，脉暴微，手足反温，脉紧反去者，为欲解也。'"@zh ;
    skos:notation "Shouzuwen_instance" ;
    skos:exactMatch zz:Shouzuwen_instance ;
    zz:classMatch zz:Shouzuwen .

zzskos:Fanre a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "烦热"@zh ;
    skos:definition "发热而兼心烦。里热扰心之候。"@zh ;
    skos:hiddenLabel         "又烦又热"@zh,
        "心里烦身上热"@zh ;
    skos:note "伤寒论第77条：'发汗若下之，而烦热胸中窒者，栀子豉汤主之。'"@zh ;
    skos:broader zzskos:Fare ;
    skos:closeMatch zzskos:Dare,
        zzskos:Fare,
        zzskos:Mianre,
        zzskos:Shenre,
        zzskos:Shenzhuore,
        zzskos:Shitoure,
        zzskos:Weire ;
    skos:notation "Fanre_instance" ;
    skos:exactMatch zz:Fanre_instance ;
    zz:classMatch zz:Fanre .

zzskos:Touxiangqiangtong a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "头项强痛"@zh ;
    skos:definition "头痛兼项部强直疼痛。太阳病提纲证之一。"@zh ;
    skos:altLabel         "项强痛"@zh ;
    skos:hiddenLabel         "脖子僵硬头疼"@zh,
        "后脑勺疼脖子硬"@zh ;
    skos:note "伤寒论第1条：'太阳之为病，脉浮，头项强痛而恶寒。'"@zh ;
    skos:broader zzskos:Toutong ;
    skos:closeMatch zzskos:Kumaoxuan,
        zzskos:Qizetouxuan,
        zzskos:Toutong,
        zzskos:Touxuan,
        zzskos:Touzhong ;
    skos:notation "Touxiangqiangtong_instance" ;
    skos:exactMatch zz:Touxiangqiangtong_instance ;
    zz:classMatch zz:Touxiangqiangtong .

zzskos:Wudare a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "无大热"@zh ;
    skos:definition "无高热。表邪未尽或热已内陷之候。"@zh ;
    skos:hiddenLabel         "不太烧"@zh,
        "没有高烧"@zh ;
    skos:note "伤寒论第63条：'汗出而喘，无大热者，可与麻黄杏仁甘草石膏汤。'"@zh ;
    skos:notation "Wudare_instance" ;
    skos:exactMatch zz:Wudare_instance ;
    zz:classMatch zz:Wudare .

zzskos:Weire a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "微热"@zh ;
    skos:definition "发热轻微。表邪轻浅或阴虚内热。"@zh ;
    skos:altLabel         "低热"@zh ;
    skos:hiddenLabel         "低烧"@zh,
        "有点热"@zh,
        "微微发烧"@zh ;
    skos:note "伤寒论第252条：'伤寒六七日，目中不了了……身微热者，此为实也。'"@zh ;
    skos:broader zzskos:Fare ;
    skos:closeMatch zzskos:Dare,
        zzskos:Fanre,
        zzskos:Fare,
        zzskos:Mianre,
        zzskos:Shenre,
        zzskos:Shenzhuore,
        zzskos:Shitoure ;
    skos:notation "Weire_instance" ;
    skos:exactMatch zz:Weire_instance ;
    zz:classMatch zz:Weire .

zzskos:Shenzhuore a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "身灼热"@zh ;
    skos:definition "身体灼热如焚。阳明热盛或温病热入营血。"@zh ;
    skos:hiddenLabel         "身上滚烫"@zh,
        "浑身灼热"@zh ;
    skos:note "伤寒论第6条：'太阳病，发热而渴，不恶寒者，为温病。'"@zh ;
    skos:broader zzskos:Fare ;
    skos:closeMatch zzskos:Dare,
        zzskos:Fanre,
        zzskos:Fare,
        zzskos:Mianre,
        zzskos:Shenre,
        zzskos:Shitoure,
        zzskos:Weire ;
    skos:notation "Shenzhuore_instance" ;
    skos:exactMatch zz:Shenzhuore_instance ;
    zz:classMatch zz:Shenzhuore .

zzskos:Yudebeifuxianghuo a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "欲得被覆向火"@zh ;
    skos:definition "欲得衣被覆盖、向火取暖。里虚寒之征。"@zh ;
    skos:altLabel         "欲近衣被"@zh,
        "向火"@zh ;
    skos:hiddenLabel         "想盖被子"@zh,
        "想烤火"@zh,
        "想靠近暖气"@zh ;
    skos:note "伤寒论第11条：'身大热，反欲得近衣者，热在皮肤，寒在骨髓也。'"@zh ;
    skos:notation "Yudebeifuxianghuo_instance" ;
    skos:exactMatch zz:Yudebeifuxianghuo_instance ;
    zz:classMatch zz:Yudebeifuxianghuo .

zzskos:Xiaoyoulaoshenjire a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "小有劳身即热"@zh ;
    skos:definition "稍事劳作即发热。气虚或虚劳之候。"@zh ;
    skos:altLabel         "劳则发热"@zh ;
    skos:hiddenLabel         "一累就发热"@zh,
        "稍一活动就热"@zh ;
    skos:note "金匮要略·血痹虚劳：'小有劳，身即热。'"@zh ;
    skos:notation "Xiaoyoulaoshenjire_instance" ;
    skos:exactMatch zz:Xiaoyoulaoshenjire_instance ;
    zz:classMatch zz:Xiaoyoulaoshenjire .

zzskos:Zhenhan a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "振寒"@zh ;
    skos:definition "身体振颤而寒。正邪交争或阳虚之候。"@zh ;
    skos:hiddenLabel         "发抖发冷"@zh,
        "冷得哆嗦"@zh ;
    skos:note "伤寒论第94条：'太阳病未解，脉阴阳俱停，必先振栗汗出而解。'"@zh ;
    skos:notation "Zhenhan_instance" ;
    skos:exactMatch zz:Zhenhan_instance ;
    zz:classMatch zz:Zhenhan .

zzskos:Hanchu a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "汗出"@zh ;
    skos:definition "体表有汗液排出。表证汗出为中风（桂枝汤证）。"@zh ;
    skos:altLabel         "出汗"@zh,
        "有汗"@zh,
        "汗自出"@zh,
        "微汗出"@zh,
        "自汗出"@zh ;
    skos:hiddenLabel         "流汗"@zh,
        "冒汗"@zh,
        "一身汗"@zh,
        "虚汗"@zh,
        "出汗不止"@zh,
        "老出汗"@zh ;
    skos:note "伤寒论第12条：'阴弱者汗自出。'胡老：病汗与药汗有别。"@zh ;
    skos:closeMatch zzskos:Dahan,
        zzskos:Duohanchu,
        zzskos:Zihan ;
    skos:notation "Hanchu_instance" ;
    skos:exactMatch zz:Hanchu_instance ;
    zz:classMatch zz:Hanchu .

zzskos:Wuhan a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "无汗"@zh ;
    skos:definition "体表干燥无汗。表实证标志，腠理闭塞。"@zh ;
    skos:altLabel         "不出汗"@zh,
        "汗不出"@zh,
        "无汗出"@zh ;
    skos:hiddenLabel         "没汗"@zh,
        "干烧"@zh,
        "皮肤干"@zh,
        "一滴汗都没有"@zh ;
    skos:note "伤寒论第35条：'无汗而喘'，麻黄汤证主症之一。"@zh ;
    skos:notation "Wuhan_instance" ;
    skos:exactMatch zz:Wuhan_instance ;
    zz:classMatch zz:Wuhan .

zzskos:Zihan a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "自汗"@zh ;
    skos:definition "不因劳作、天热而自然汗出。表虚或阳明里热迫津所致。"@zh ;
    skos:altLabel         "常自汗出"@zh,
        "汗出不止"@zh ;
    skos:hiddenLabel         "出虚汗"@zh,
        "动不动就出汗"@zh ;
    skos:note "伤寒论第53条：'病常自汗出者，此为荣气和……以卫气不共荣气谐和故尔。'"@zh ;
    skos:closeMatch zzskos:Dahan,
        zzskos:Duohanchu,
        zzskos:Hanchu ;
    skos:notation "Zihan_instance" ;
    skos:exactMatch zz:Zihan_instance ;
    zz:classMatch zz:Zihan .

zzskos:Daohan a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "盗汗"@zh ;
    skos:definition "睡中汗出，醒则汗止。阴虚或虚劳之候。"@zh ;
    skos:altLabel         "寝汗"@zh ;
    skos:hiddenLabel         "夜里出汗"@zh,
        "睡觉出汗"@zh,
        "睡着出汗"@zh ;
    skos:note "金匮要略·血痹虚劳：'男子平人，脉虚弱细微者，喜盗汗也。'"@zh ;
    skos:narrower zzskos:Muhezehan,
        zzskos:Muchangdaohanchu ;
    skos:notation "Daohan_instance" ;
    skos:exactMatch zz:Daohan_instance ;
    zz:classMatch zz:Daohan .

zzskos:Dantouhanchu a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "但头汗出"@zh ;
    skos:definition "仅头部汗出，齐颈而还。湿热郁蒸或阳气上越之候。"@zh ;
    skos:altLabel         "头汗"@zh ;
    skos:hiddenLabel         "只有头上出汗"@zh,
        "头出汗身上不出"@zh ;
    skos:note "伤寒论第111条、第236条。胡老：但头汗出，多为湿热或阳脱。"@zh ;
    skos:notation "Dantouhanchu_instance" ;
    skos:exactMatch zz:Dantouhanchu_instance ;
    zz:classMatch zz:Dantouhanchu .

zzskos:Huanghan a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "黄汗"@zh ;
    skos:definition "汗出色黄如柏汁，沾衣色黄。湿热交蒸之候。"@zh ;
    skos:altLabel         "黄汗出"@zh ;
    skos:hiddenLabel         "出黄汗"@zh,
        "汗是黄的"@zh ;
    skos:note "金匮要略·水气病：'黄汗之为病，身体肿，发热汗出而渴，状如风水，汗沾衣，色正黄如柏汁。'"@zh ;
    skos:closeMatch zzskos:Hanzhanyi,
        zzskos:Sezhenghuangrubaizhi,
        zzskos:Shenseruxunhuang ;
    skos:notation "Huanghan_instance" ;
    skos:exactMatch zz:Huanghan_instance ;
    zz:classMatch zz:Huanghan .

zzskos:Dahan a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "大汗"@zh ;
    skos:definition "汗出量多。阳明热盛迫津，或阳气外脱。"@zh ;
    skos:altLabel         "大汗出"@zh,
        "汗大出"@zh ;
    skos:hiddenLabel         "出很多汗"@zh,
        "汗如雨下"@zh,
        "浑身是汗"@zh ;
    skos:note "伤寒论第26条：'服桂枝汤，大汗出后，大烦渴不解，脉洪大者，白虎加人参汤主之。'"@zh ;
    skos:closeMatch zzskos:Duohanchu,
        zzskos:Hanchu,
        zzskos:Zihan ;
    skos:notation "Dahan_instance" ;
    skos:exactMatch zz:Dahan_instance ;
    zz:classMatch zz:Dahan .

zzskos:Duohanchu a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "多汗出"@zh ;
    skos:definition "经常性汗出过多，与大汗（急性）区分。"@zh ;
    skos:altLabel         "多汗"@zh ;
    skos:hiddenLabel         "汗多"@zh,
        "经常出汗"@zh,
        "动不动一身汗"@zh ;
    skos:closeMatch zzskos:Dahan,
        zzskos:Hanchu,
        zzskos:Zihan ;
    skos:notation "Duohanchu_instance" ;
    skos:exactMatch zz:Duohanchu_instance ;
    zz:classMatch zz:Duohanchu .

zzskos:Muhezehan a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "目合则汗"@zh ;
    skos:definition "闭目则汗出。阴虚盗汗之甚者。"@zh ;
    skos:altLabel         "目合汗出"@zh ;
    skos:hiddenLabel         "一闭眼就出汗"@zh,
        "睡着了出汗"@zh ;
    skos:note "伤寒论第268条：'三阳合病……目合则汗。'"@zh ;
    skos:broader zzskos:Daohan ;
    skos:notation "Muhezehan_instance" ;
    skos:exactMatch zz:Muhezehan_instance ;
    zz:classMatch zz:Muhezehan .

zzskos:Shouzujiranhanchu a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "手足濈然汗出"@zh ;
    skos:definition "手足持续汗出。阳明腑实燥屎内结之征。"@zh ;
    skos:altLabel         "手足汗出"@zh ;
    skos:hiddenLabel         "手脚出汗"@zh,
        "手心脚心出汗"@zh ;
    skos:note "伤寒论第208条：'手足濈然汗出者，此大便已硬也，大承气汤主之。'"@zh ;
    skos:notation "Shouzujiranhanchu_instance" ;
    skos:exactMatch zz:Shouzujiranhanchu_instance ;
    zz:classMatch zz:Shouzujiranhanchu .

zzskos:Shiyihanchu a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "食已汗出"@zh ;
    skos:definition "进食后汗出。胃热或气虚之候。"@zh ;
    skos:hiddenLabel         "一吃饭就出汗"@zh,
        "吃饭出汗"@zh ;
    skos:note "金匮要略·血痹虚劳：'食已汗出，又身常暮卧盗汗出者，此劳气也。'"@zh ;
    skos:notation "Shiyihanchu_instance" ;
    skos:exactMatch zz:Shiyihanchu_instance ;
    zz:classMatch zz:Shiyihanchu .

zzskos:Ruofazebaihanchu a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "若发则白汗出"@zh ;
    skos:definition "发作时出白色冷汗。阳虚寒盛之候。"@zh ;
    skos:altLabel         "白汗出"@zh ;
    skos:hiddenLabel         "出冷汗"@zh,
        "冷汗"@zh ;
    skos:note "金匮要略·腹满寒疝宿食：'若发则白汗出，手足厥冷。'"@zh ;
    skos:notation "Ruofazebaihanchu_instance" ;
    skos:exactMatch zz:Ruofazebaihanchu_instance ;
    zz:classMatch zz:Ruofazebaihanchu .

zzskos:Muchangdaohanchu a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "暮常盗汗出"@zh ;
    skos:definition "入暮常盗汗。虚劳之候。"@zh ;
    skos:hiddenLabel         "晚上老出汗"@zh,
        "夜里常出汗"@zh ;
    skos:note "金匮要略·血痹虚劳。"@zh ;
    skos:broader zzskos:Daohan ;
    skos:notation "Muchangdaohanchu_instance" ;
    skos:exactMatch zz:Muchangdaohanchu_instance ;
    zz:classMatch zz:Muchangdaohanchu .

zzskos:Hanloubuzhi a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "汗漏不止"@zh ;
    skos:definition "汗出如漏，持续不止。阳虚不固，卫外失司。"@zh ;
    skos:hiddenLabel         "汗止不住"@zh,
        "一直出汗止不住"@zh ;
    skos:note "伤寒论第20条：'太阳病，发汗，遂漏不止，其人恶风，小便难，四肢微急，难以屈伸者，桂枝加附子汤主之。'"@zh ;
    skos:notation "Hanloubuzhi_instance" ;
    skos:exactMatch zz:Hanloubuzhi_instance ;
    zz:classMatch zz:Hanloubuzhi .

zzskos:Toutong a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "头痛"@zh ;
    skos:definition "头部疼痛。六经皆有头痛，须辨部位与兼证。"@zh ;
    skos:altLabel         "头疼"@zh,
        "首痛"@zh ;
    skos:hiddenLabel         "脑袋疼"@zh,
        "头很痛"@zh,
        "偏头痛"@zh ;
    skos:note "伤寒论第1条：'头项强痛'。胡老：太阳头痛多在项背，少阳头痛多在两侧，阳明头痛多在前额。"@zh ;
    skos:narrower zzskos:Touxiangqiangtong,
        zzskos:Touzhong ;
    skos:closeMatch zzskos:Kumaoxuan,
        zzskos:Qizetouxuan,
        zzskos:Touxiangqiangtong,
        zzskos:Touxuan,
        zzskos:Touzhong ;
    skos:notation "Toutong_instance" ;
    skos:exactMatch zz:Toutong_instance ;
    zz:classMatch zz:Toutong .

zzskos:Touxuan a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "头眩"@zh ;
    skos:definition "头目昏眩。多属痰饮上泛、清阳不升。"@zh ;
    skos:altLabel         "头晕"@zh,
        "眩晕"@zh,
        "冒眩"@zh ;
    skos:hiddenLabel         "天旋地转"@zh,
        "晕得厉害"@zh,
        "头昏"@zh ;
    skos:note "金匮要略·痰饮：'心下有支饮，其人苦冒眩，泽泻汤主之。'"@zh ;
    skos:broader zzskos:Muxuan ;
    skos:closeMatch zzskos:Kumaoxuan,
        zzskos:Qizetouxuan,
        zzskos:Toutong,
        zzskos:Touxiangqiangtong,
        zzskos:Touzhong ;
    skos:notation "Touxuan_instance" ;
    skos:exactMatch zz:Touxuan_instance ;
    zz:classMatch zz:Touxuan .

zzskos:Qizetouxuan a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "起则头眩"@zh ;
    skos:definition "起立时即感头眩。痰饮内停，清阳不升。"@zh ;
    skos:hiddenLabel         "一站起来就头晕"@zh,
        "起身头晕"@zh ;
    skos:note "伤寒论第67条：'心下逆满，气上冲胸，起则头眩……茯苓桂枝白术甘草汤主之。'"@zh ;
    skos:closeMatch zzskos:Kumaoxuan,
        zzskos:Toutong,
        zzskos:Touxiangqiangtong,
        zzskos:Touxuan,
        zzskos:Touzhong ;
    skos:notation "Qizetouxuan_instance" ;
    skos:exactMatch zz:Qizetouxuan_instance ;
    zz:classMatch zz:Qizetouxuan .

zzskos:Muxuan a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "目眩"@zh ;
    skos:definition "视物昏花旋转。少阳或痰饮之候。"@zh ;
    skos:altLabel         "眼花"@zh ;
    skos:hiddenLabel         "眼前发花"@zh,
        "看东西转"@zh ;
    skos:note "伤寒论第263条：'少阳之为病，口苦，咽干，目眩也。'"@zh ;
    skos:narrower zzskos:Touxuan,
        zzskos:Kumaoxuan ;
    skos:closeMatch zzskos:Jingbuhe,
        zzskos:Liangmuanhei,
        zzskos:Mubudebi,
        zzskos:Muchi,
        zzskos:Muchirujiuyan,
        zzskos:Muhuang,
        zzskos:Mukeshangweiyong,
        zzskos:Muming,
        zzskos:Muqizichu,
        zzskos:Murundong,
        zzskos:Murutuozhuang,
        zzskos:Muteng,
        zzskos:Muxiayouwocan,
        zzskos:Muzhongbulele ;
    skos:notation "Muxuan_instance" ;
    skos:exactMatch zz:Muxuan_instance ;
    zz:classMatch zz:Muxuan .

zzskos:Muchi a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "目赤"@zh ;
    skos:definition "目睛红赤。肝火或风热上攻。"@zh ;
    skos:altLabel         "眼红"@zh ;
    skos:hiddenLabel         "眼睛红"@zh,
        "眼白发红"@zh,
        "眼睛充血"@zh ;
    skos:note "伤寒论第263条。"@zh ;
    skos:closeMatch zzskos:Jingbuhe,
        zzskos:Liangmuanhei,
        zzskos:Mubudebi,
        zzskos:Muchirujiuyan,
        zzskos:Muhuang,
        zzskos:Mukeshangweiyong,
        zzskos:Muming,
        zzskos:Muqizichu,
        zzskos:Murundong,
        zzskos:Murutuozhuang,
        zzskos:Muteng,
        zzskos:Muxiayouwocan,
        zzskos:Muxuan,
        zzskos:Muzhongbulele ;
    skos:notation "Muchi_instance" ;
    skos:exactMatch zz:Muchi_instance ;
    zz:classMatch zz:Muchi .

zzskos:Muming a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "目瞑"@zh ;
    skos:definition "闭目不欲睁。多属阳虚或血虚。"@zh ;
    skos:altLabel         "闭目"@zh ;
    skos:hiddenLabel         "闭着眼睛"@zh,
        "不想睁眼"@zh ;
    skos:note "伤寒论第46条：'其人发烦目瞑。'"@zh ;
    skos:closeMatch zzskos:Jingbuhe,
        zzskos:Liangmuanhei,
        zzskos:Mubudebi,
        zzskos:Muchi,
        zzskos:Muchirujiuyan,
        zzskos:Muhuang,
        zzskos:Mukeshangweiyong,
        zzskos:Muqizichu,
        zzskos:Murundong,
        zzskos:Murutuozhuang,
        zzskos:Muteng,
        zzskos:Muxiayouwocan,
        zzskos:Muxuan,
        zzskos:Muzhongbulele ;
    skos:notation "Muming_instance" ;
    skos:exactMatch zz:Muming_instance ;
    zz:classMatch zz:Muming .

zzskos:Muhuang a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "目黄"@zh ;
    skos:definition "白睛发黄。黄疸之征。"@zh ;
    skos:altLabel         "眼黄"@zh ;
    skos:hiddenLabel         "眼睛发黄"@zh,
        "眼白发黄"@zh ;
    skos:note "金匮要略·黄疸病：'目黄者，曰黄疸。'"@zh ;
    skos:closeMatch zzskos:Huangdan,
        zzskos:Jingbuhe,
        zzskos:Jiuhuangdan,
        zzskos:Liangmuanhei,
        zzskos:Mubudebi,
        zzskos:Muchi,
        zzskos:Muchirujiuyan,
        zzskos:Mukeshangweiyong,
        zzskos:Muming,
        zzskos:Muqizichu,
        zzskos:Murundong,
        zzskos:Murutuozhuang,
        zzskos:Muteng,
        zzskos:Muxiayouwocan,
        zzskos:Muxuan,
        zzskos:Muzhongbulele,
        zzskos:Nvlaodan,
        zzskos:Shenhuang,
        zzskos:Zhuhuang ;
    skos:notation "Muhuang_instance" ;
    skos:exactMatch zz:Muhuang_instance ;
    zz:classMatch zz:Muhuang .

zzskos:Mianchi a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "面赤"@zh ;
    skos:definition "面部红赤。阳明热盛或虚阳上浮。"@zh ;
    skos:altLabel         "面红"@zh,
        "面色赤"@zh ;
    skos:hiddenLabel         "脸发红"@zh,
        "脸红"@zh,
        "脸通红"@zh ;
    skos:note "伤寒论第48条：'阳气怫郁在表，当解之熏之。'"@zh ;
    skos:closeMatch zzskos:Eshanghei,
        zzskos:Mianre,
        zzskos:Miansebai,
        zzskos:Mianselihei,
        zzskos:Mianseqing,
        zzskos:Mianseweihuang,
        zzskos:Miansewuhua ;
    skos:notation "Mianchi_instance" ;
    skos:exactMatch zz:Mianchi_instance ;
    zz:classMatch zz:Mianchi .

zzskos:Mianre a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "面热"@zh ;
    skos:definition "面部发热。阳明经热或虚阳上越。"@zh ;
    skos:hiddenLabel         "脸发热"@zh,
        "脸上发烫"@zh ;
    skos:note "伤寒论第206条：'阳明病，面合色赤。'"@zh ;
    skos:broader zzskos:Fare ;
    skos:closeMatch zzskos:Dare,
        zzskos:Eshanghei,
        zzskos:Fanre,
