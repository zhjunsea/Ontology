zzskos:Kouke a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "口渴"@zh ;
    skos:definition "口渴欲饮。里热伤津或水液不布。"@zh ;
    skos:altLabel         "口干渴"@zh ;
    skos:hiddenLabel         "想喝水"@zh,
        "嘴里干"@zh ;
    skos:note "伤寒论第71条：'太阳病，发汗后……胃中干，烦躁不得眠，欲得饮水者，少少与饮之。'"@zh ;
    skos:narrower zzskos:Dake ;
    skos:closeMatch zzskos:Buke,
        zzskos:Buyuyin,
        zzskos:Dake,
        zzskos:Danyuyinre,
        zzskos:Fanbuke,
        zzskos:Xiaoke,
        zzskos:Yuyin ;
    skos:notation "Kouke_instance" ;
    skos:exactMatch zz:Kouke_instance ;
    zz:classMatch zz:Kouke .

zzskos:Dake a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "大渴"@zh ;
    skos:definition "口渴特甚，引饮不止。阳明热盛津伤。"@zh ;
    skos:altLabel         "大渴引饮"@zh ;
    skos:hiddenLabel         "非常渴"@zh,
        "渴得厉害"@zh,
        "狂喝水"@zh ;
    skos:note "伤寒论第26条：'大烦渴不解，脉洪大者，白虎加人参汤主之。'"@zh ;
    skos:broader zzskos:Kouke ;
    skos:closeMatch zzskos:Buke,
        zzskos:Buyuyin,
        zzskos:Danyuyinre,
        zzskos:Fanbuke,
        zzskos:Kouke,
        zzskos:Xiaoke,
        zzskos:Yuyin ;
    skos:notation "Dake_instance" ;
    skos:exactMatch zz:Dake_instance ;
    zz:classMatch zz:Dake .

zzskos:Buke a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "不渴"@zh ;
    skos:definition "口不渴。里无热或津液未伤。"@zh ;
    skos:hiddenLabel         "不口渴"@zh,
        "不想喝水"@zh ;
    skos:note "伤寒论第304条：'口中和'即不渴不苦。"@zh ;
    skos:closeMatch zzskos:Buyuyin,
        zzskos:Dake,
        zzskos:Danyuyinre,
        zzskos:Fanbuke,
        zzskos:Kouke,
        zzskos:Xiaoke,
        zzskos:Yuyin ;
    skos:notation "Buke_instance" ;
    skos:exactMatch zz:Buke_instance ;
    zz:classMatch zz:Buke .

zzskos:Fanbuke a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "反不渴"@zh ;
    skos:definition "本当渴而反不渴。水饮内停或阴寒内盛。"@zh ;
    skos:hiddenLabel         "反而不渴"@zh ;
    skos:note "金匮要略·痰饮：'夫心下有留饮，其人背寒冷如手大。'"@zh ;
    skos:closeMatch zzskos:Buke,
        zzskos:Buyuyin,
        zzskos:Dake,
        zzskos:Danyuyinre,
        zzskos:Kouke,
        zzskos:Xiaoke,
        zzskos:Yuyin ;
    skos:notation "Fanbuke_instance" ;
    skos:exactMatch zz:Fanbuke_instance ;
    zz:classMatch zz:Fanbuke .

zzskos:Yuyin a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "欲饮"@zh ;
    skos:definition "欲饮水。里热或津伤。"@zh ;
    skos:altLabel         "欲饮水"@zh ;
    skos:hiddenLabel         "要喝水"@zh ;
    skos:note "伤寒论第71条。"@zh ;
    skos:closeMatch zzskos:Buke,
        zzskos:Buyuyin,
        zzskos:Dake,
        zzskos:Danyuyinre,
