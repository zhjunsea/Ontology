zzskos:Zilierke a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "自利而渴"@zh ;
    skos:definition "自下利而口渴。少阴之候。"@zh ;
    skos:hiddenLabel         "拉肚子还口渴"@zh ;
    skos:note "伤寒论第282条：'五六日自利而渴者，属少阴也。'"@zh ;
    skos:notation "Zilierke_instance" ;
    skos:exactMatch zz:Zilierke_instance ;
    zz:classMatch zz:Zilierke .

zzskos:Budeqianhou a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "不得前后"@zh ;
    skos:definition "大小便皆不通。"@zh ;
    skos:hiddenLabel         "大小便都不通"@zh ;
    skos:note "金匮要略·腹满寒疝宿食。"@zh ;
    skos:notation "Budeqianhou_instance" ;
    skos:exactMatch zz:Budeqianhou_instance ;
    zz:classMatch zz:Budeqianhou .

zzskos:Outu a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "呕吐"@zh ;
