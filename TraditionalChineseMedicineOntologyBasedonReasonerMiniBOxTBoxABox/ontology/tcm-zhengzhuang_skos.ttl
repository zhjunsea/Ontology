zzskos:Yuyannanchu a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "语言难出"@zh ;
    skos:definition "言语难以发出。"@zh ;
    skos:hiddenLabel         "说话困难"@zh ;
    skos:note "伤寒论第6条。"@zh ;
    skos:notation "Yuyannanchu_instance" ;
    skos:exactMatch zz:Yuyannanchu_instance ;
