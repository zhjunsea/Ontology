zzskos:Keni a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "咳逆"@zh ;
    skos:definition "咳嗽气逆。"@zh ;
    skos:altLabel         "咳逆上气"@zh ;
    skos:hiddenLabel         "咳得气逆"@zh,
        "咳嗽打嗝"@zh ;
    skos:note "金匮要略·痰饮。"@zh ;
    skos:closeMatch zzskos:Chuan,
