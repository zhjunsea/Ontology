zzskos:Bigan a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "鼻干"@zh ;
    skos:definition "鼻腔干燥。阳明热盛或肺燥。"@zh ;
    skos:hiddenLabel         "鼻子干"@zh,
        "鼻腔干燥"@zh ;
    skos:note "伤寒论第227条：'脉浮发热，口干鼻燥，能食者则衄。'"@zh ;
