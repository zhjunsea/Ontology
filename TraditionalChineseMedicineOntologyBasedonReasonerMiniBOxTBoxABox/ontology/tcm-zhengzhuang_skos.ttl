zzskos:Fuman a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "腹满"@zh ;
    skos:definition "腹部胀满。太阴病提纲证之一，脾虚湿盛或阳明腑实。"@zh ;
    skos:altLabel         "腹胀满"@zh,
        "腹胀"@zh ;
