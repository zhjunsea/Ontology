    skos:prefLabel "心中恶寒不足"@zh ;
    skos:definition "心中恶寒而不足。"@zh ;
    skos:hiddenLabel         "心里发冷不足"@zh ;
    skos:note "金匮要略·中风历节病。"@zh ;
    skos:notation "Xinzhongehanbuzu_instance" ;
    skos:exactMatch zz:Xinzhongehanbuzu_instance ;
