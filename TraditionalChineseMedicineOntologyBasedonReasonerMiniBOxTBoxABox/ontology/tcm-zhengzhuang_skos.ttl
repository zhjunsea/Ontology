    skos:hiddenLabel         "大便干"@zh,
        "大便干燥"@zh,
        "屎硬"@zh ;
    skos:note "伤寒论第208条：'手足濈然汗出者，此大便已硬也。'"@zh ;
    skos:narrower zzskos:Zaoshi,
        zzskos:Dabianmijie ;
    skos:closeMatch zzskos:Budabian,
        zzskos:Bugengyi,
        zzskos:Dabianmijie,
        zzskos:Dabiannan,
        zzskos:Zaoshi ;
    skos:notation "Dabianying_instance" ;
    skos:exactMatch zz:Dabianying_instance ;
    zz:classMatch zz:Dabianying .

zzskos:Dabiantang a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "大便溏"@zh ;
    skos:definition "大便稀溏。脾虚湿盛之候。"@zh ;
    skos:hiddenLabel         "大便稀"@zh,
        "大便不成形"@zh,
        "拉稀"@zh,
        "大便软"@zh ;
    skos:note "伤寒论第229条：'阳明病，发潮热，大便溏，小便自可，胸胁满不去者，与小柴胡汤。'"@zh ;
    skos:notation "Dabiantang_instance" ;
    skos:exactMatch zz:Dabiantang_instance ;
    zz:classMatch zz:Dabiantang .

zzskos:Dabianchuyinghoutang a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "大便初硬后溏"@zh ;
    skos:definition "大便初头硬后则溏。"@zh ;
    skos:hiddenLabel         "大便先干后稀"@zh ;
    skos:note "伤寒论第191条：'阳明病，若中寒者，不能食，小便不利，手足濈然汗出，此欲作固瘕，必大便初硬后溏。'"@zh ;
    skos:notation "Dabianchuyinghoutang_instance" ;
    skos:exactMatch zz:Dabianchuyinghoutang_instance ;
    zz:classMatch zz:Dabianchuyinghoutang .

zzskos:Bianxue a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "便血"@zh ;
    skos:definition "大便下血。"@zh ;
    skos:hiddenLabel         "大便带血"@zh,
        "拉血"@zh ;
    skos:note "金匮要略·惊悸吐衄下血胸满瘀血病：'下血，先便后血，此远血也，黄土汤主之。'"@zh ;
    skos:closeMatch zzskos:Banchanhouxiaxuebuduan,
        zzskos:Louxia,
        zzskos:Renshenxiaxue,
        zzskos:Xianbianhoubianxue,
        zzskos:Xianxuehoubian,
        zzskos:Xiaxue ;
    skos:notation "Bianxue_instance" ;
    skos:exactMatch zz:Bianxue_instance ;
    zz:classMatch zz:Bianxue .

zzskos:Xianbianhoubianxue a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "先便后血"@zh ;
    skos:definition "先大便后下血，为远血。"@zh ;
    skos:altLabel         "远血"@zh ;
    skos:hiddenLabel         "先拉屎后出血"@zh ;
    skos:note "金匮要略·惊悸吐衄下血胸满瘀血病：'下血，先便后血，此远血也，黄土汤主之。'"@zh ;
    skos:closeMatch zzskos:Banchanhouxiaxuebuduan,
        zzskos:Bianxue,
        zzskos:Louxia,
        zzskos:Renshenxiaxue,
        zzskos:Xianxuehoubian,
        zzskos:Xiaxue ;
    skos:notation "Xianbianhoubianxue_instance" ;
    skos:exactMatch zz:Xianbianhoubianxue_instance ;
    zz:classMatch zz:Xianbianhoubianxue .

zzskos:Xianxuehoubian a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "先血后便"@zh ;
    skos:definition "先下血后大便，为近血。"@zh ;
    skos:altLabel         "近血"@zh ;
    skos:hiddenLabel         "先出血后拉屎"@zh ;
    skos:note "金匮要略·惊悸吐衄下血胸满瘀血病：'下血，先血后便，此近血也，赤小豆当归散主之。'"@zh ;
    skos:closeMatch zzskos:Banchanhouxiaxuebuduan,
        zzskos:Bianxue,
        zzskos:Louxia,
        zzskos:Renshenxiaxue,
        zzskos:Xianbianhoubianxue,
        zzskos:Xiaxue ;
    skos:notation "Xianxuehoubian_instance" ;
    skos:exactMatch zz:Xianxuehoubian_instance ;
    zz:classMatch zz:Xianxuehoubian .

zzskos:Nongxue a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "脓血"@zh ;
    skos:definition "大便夹脓血。"@zh ;
    skos:hiddenLabel         "脓血便"@zh,
        "大便有脓血"@zh ;
    skos:note "金匮要略·呕吐哕下利病。"@zh ;
    skos:closeMatch zzskos:Binv,
        zzskos:Niaoxue,
        zzskos:Nvxue,
        zzskos:Wangxue ;
    skos:notation "Nongxue_instance" ;
    skos:exactMatch zz:Nongxue_instance ;
    zz:classMatch zz:Nongxue .

zzskos:Xiaobianbuli a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "小便不利"@zh ;
    skos:definition "小便排出不畅或量少。"@zh ;
    skos:hiddenLabel         "尿少"@zh,
        "排尿不畅"@zh,
        "尿不出来"@zh,
        "小便不畅"@zh,
        "尿量少"@zh ;
    skos:note "伤寒论第71条：'若脉浮，小便不利，微热消渴者，五苓散主之。'"@zh ;
    skos:closeMatch zzskos:Xiaobianchi,
        zzskos:Xiaobianhuang,
        zzskos:Xiaobianhuangchi,
        zzskos:Xiaobiannan,
        zzskos:Xiaobianqing,
        zzskos:Xiaobiansebai,
        zzskos:Xiaobianshu ;
    skos:notation "Xiaobianbuli_instance" ;
    skos:exactMatch zz:Xiaobianbuli_instance ;
    zz:classMatch zz:Xiaobianbuli .

zzskos:Xiaobianshu a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "小便数"@zh ;
    skos:definition "小便次数多。"@zh ;
    skos:hiddenLabel         "尿频"@zh,
        "老想小便"@zh,
        "小便次数多"@zh ;
    skos:note "金匮要略·肺痿肺痈咳嗽上气：'肺痿吐涎沫而不咳者，其人不渴，必遗尿，小便数。'"@zh ;
    skos:closeMatch zzskos:Xiaobianbuli,
        zzskos:Xiaobianchi,
        zzskos:Xiaobianhuang,
        zzskos:Xiaobianhuangchi,
        zzskos:Xiaobiannan,
        zzskos:Xiaobianqing,
        zzskos:Xiaobiansebai ;
    skos:notation "Xiaobianshu_instance" ;
    skos:exactMatch zz:Xiaobianshu_instance ;
    zz:classMatch zz:Xiaobianshu .

zzskos:Xiaobianzili a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "小便自利"@zh ;
    skos:definition "小便自利。"@zh ;
    skos:hiddenLabel         "小便正常"@zh,
        "小便自通"@zh ;
    skos:note "伤寒论第124条：'少腹当硬满，小便自利者，下血乃愈。'"@zh ;
    skos:notation "Xiaobianzili_instance" ;
    skos:exactMatch zz:Xiaobianzili_instance ;
    zz:classMatch zz:Xiaobianzili .

zzskos:Xiaobianchi a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "小便赤"@zh ;
    skos:definition "小便色赤。里热之候。"@zh ;
    skos:hiddenLabel         "尿发红"@zh,
        "小便发红"@zh ;
    skos:closeMatch zzskos:Xiaobianbuli,
        zzskos:Xiaobianhuang,
        zzskos:Xiaobianhuangchi,
        zzskos:Xiaobiannan,
        zzskos:Xiaobianqing,
        zzskos:Xiaobiansebai,
        zzskos:Xiaobianshu ;
    skos:notation "Xiaobianchi_instance" ;
    skos:exactMatch zz:Xiaobianchi_instance ;
    zz:classMatch zz:Xiaobianchi .

zzskos:Xiaobianhuang a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "小便黄"@zh ;
    skos:definition "小便色黄。湿热之候。"@zh ;
    skos:hiddenLabel         "尿黄"@zh,
        "小便发黄"@zh ;
    skos:closeMatch zzskos:Xiaobianbuli,
        zzskos:Xiaobianchi,
        zzskos:Xiaobianhuangchi,
        zzskos:Xiaobiannan,
        zzskos:Xiaobianqing,
        zzskos:Xiaobiansebai,
        zzskos:Xiaobianshu ;
    skos:notation "Xiaobianhuang_instance" ;
    skos:exactMatch zz:Xiaobianhuang_instance ;
    zz:classMatch zz:Xiaobianhuang .

zzskos:Xiaobiansebai a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "小便色白"@zh ;
    skos:definition "小便色白清长。下焦虚寒之候。"@zh ;
    skos:hiddenLabel         "尿清"@zh ;
    skos:note "伤寒论第282条：'少阴病，欲吐不吐，心烦但欲寐，五六日自利而渴者，属少阴也，虚故引水自救。若小便色白者，少阴病形悉具。'"@zh ;
    skos:closeMatch zzskos:Xiaobianbuli,
        zzskos:Xiaobianchi,
        zzskos:Xiaobianhuang,
        zzskos:Xiaobianhuangchi,
        zzskos:Xiaobiannan,
        zzskos:Xiaobianqing,
        zzskos:Xiaobianshu ;
    skos:notation "Xiaobiansebai_instance" ;
    skos:exactMatch zz:Xiaobiansebai_instance ;
    zz:classMatch zz:Xiaobiansebai .

zzskos:Yiniao a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "遗尿"@zh ;
    skos:definition "小便不自主排出。"@zh ;
    skos:altLabel         "尿床"@zh ;
    skos:hiddenLabel         "憋不住尿"@zh ;
    skos:note "金匮要略·肺痿肺痈咳嗽上气。"@zh ;
    skos:notation "Yiniao_instance" ;
    skos:exactMatch zz:Yiniao_instance ;
    zz:classMatch zz:Yiniao .

zzskos:Xiali a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "下利"@zh ;
    skos:definition "大便稀薄或次数增多。太阴、少阴、厥阴皆有下利，须辨寒热虚实。"@zh ;
    skos:altLabel         "腹泻"@zh,
        "泄泻"@zh,
        "自利"@zh ;
    skos:hiddenLabel         "拉肚子"@zh,
        "闹肚子"@zh,
        "拉稀水"@zh ;
    skos:note "伤寒论第273条：'太阴之为病……自利益甚。'胡老：下利须辨热利、寒利、虚利。"@zh ;
    skos:narrower zzskos:Xialiqinggu,
        zzskos:Xialirishushixing,
        zzskos:Xialibuzhi,
        zzskos:Xialinongxue,
        zzskos:Xialiqi,
        zzskos:Ziliyishen,
        zzskos:Reli,
        zzskos:Wanguobuhua ;
    skos:closeMatch zzskos:Gubuhua,
        zzskos:Jiuli,
        zzskos:Reli,
        zzskos:Wanguobuhua,
        zzskos:Xialibuzhi,
        zzskos:Xialinongxue,
        zzskos:Xialiqi,
        zzskos:Xialiqinggu,
        zzskos:Ziliyishen ;
    skos:notation "Xiali_instance" ;
    skos:exactMatch zz:Xiali_instance ;
    zz:classMatch zz:Xiali .

zzskos:Xialiqinggu a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "下利清谷"@zh ;
    skos:definition "下利完谷不化，清稀如水。少阴、太阴虚寒之候。"@zh ;
    skos:hiddenLabel         "拉未消化的食物"@zh,
        "拉清水完谷"@zh,
        "拉不消化的东西"@zh ;
    skos:note "伤寒论第317条：'少阴病，下利清谷，里寒外热，手足厥逆……通脉四逆汤主之。'"@zh ;
    skos:broader zzskos:Xiali ;
    skos:closeMatch zzskos:Gubuhua,
        zzskos:Jiuli,
        zzskos:Reli,
        zzskos:Wanguobuhua,
        zzskos:Xiali,
        zzskos:Xialibuzhi,
        zzskos:Xialinongxue,
        zzskos:Xialiqi,
        zzskos:Ziliyishen ;
    skos:notation "Xialiqinggu_instance" ;
    skos:exactMatch zz:Xialiqinggu_instance ;
    zz:classMatch zz:Xialiqinggu .

zzskos:Xiazhong a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "下重"@zh ;
    skos:definition "肛门重坠，里急后重。"@zh ;
    skos:hiddenLabel         "肛门坠胀"@zh,
        "想拉又拉不出"@zh,
        "拉完还想拉"@zh ;
    skos:note "伤寒论第365条：'下利，脉沉弦者，下重也。'"@zh ;
    skos:notation "Xiazhong_instance" ;
    skos:exactMatch zz:Xiazhong_instance ;
    zz:classMatch zz:Xiazhong .

zzskos:Lijihouchong a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "里急后重"@zh ;
    skos:definition "腹痛急迫而便意频，排便不爽。"@zh ;
    skos:hiddenLabel         "拉不干净"@zh ;
    skos:note "伤寒论第365条。"@zh ;
    skos:notation "Lijihouchong_instance" ;
    skos:exactMatch zz:Lijihouchong_instance ;
    zz:classMatch zz:Lijihouchong .

zzskos:Shiqi a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "失气"@zh ;
    skos:definition "肛门排气。"@zh ;
    skos:altLabel         "矢气"@zh ;
    skos:hiddenLabel         "放屁"@zh,
        "排气"@zh ;
    skos:note "伤寒论第209条：'欲知之法，少与小承气汤，汤入腹中，转失气者，此有燥屎也。'"@zh ;
    skos:notation "Shiqi_instance" ;
    skos:exactMatch zz:Shiqi_instance ;
    zz:classMatch zz:Shiqi .

zzskos:Gubuhua a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "谷不化"@zh ;
    skos:definition "饮食不化而排出。脾胃虚寒之候。"@zh ;
    skos:hiddenLabel         "拉不消化的食物"@zh,
        "食物没消化就拉出来"@zh ;
    skos:note "伤寒论第273条。"@zh ;
    skos:closeMatch zzskos:Jiuli,
        zzskos:Reli,
        zzskos:Wanguobuhua,
        zzskos:Xiali,
        zzskos:Xialibuzhi,
        zzskos:Xialinongxue,
        zzskos:Xialiqi,
        zzskos:Xialiqinggu,
        zzskos:Ziliyishen ;
    skos:notation "Gubuhua_instance" ;
    skos:exactMatch zz:Gubuhua_instance ;
    zz:classMatch zz:Gubuhua .

zzskos:Xiaobianyiyinteng a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "小便已阴疼"@zh ;
    skos:definition "小便后阴部疼痛。"@zh ;
    skos:hiddenLabel         "尿完尿道疼"@zh ;
    skos:note "伤寒论第88条。"@zh ;
    skos:notation "Xiaobianyiyinteng_instance" ;
    skos:exactMatch zz:Xiaobianyiyinteng_instance ;
    zz:classMatch zz:Xiaobianyiyinteng .

zzskos:Xialirishushixing a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "下利日数十行"@zh ;
    skos:definition "下利一日数十次。"@zh ;
    skos:hiddenLabel         "一天拉几十次"@zh ;
    skos:note "伤寒论第158条：'医反下之，其人下利日数十行，谷不化，腹中雷鸣。'"@zh ;
    skos:broader zzskos:Xiali ;
    skos:notation "Xialirishushixing_instance" ;
    skos:exactMatch zz:Xialirishushixing_instance ;
    zz:classMatch zz:Xialirishushixing .

zzskos:Dabianzhananzhayi a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "大便乍难乍易"@zh ;
    skos:definition "大便忽难忽易。"@zh ;
    skos:hiddenLabel         "大便时难时易"@zh ;
    skos:note "伤寒论第242条：'大便乍难乍易，时有微热，喘冒不能卧者，有燥屎也。'"@zh ;
    skos:notation "Dabianzhananzhayi_instance" ;
    skos:exactMatch zz:Dabianzhananzhayi_instance ;
    zz:classMatch zz:Dabianzhananzhayi .

zzskos:Xiaobianfanduo a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "小便反多"@zh ;
    skos:definition "小便反多。消渴之候。"@zh ;
    skos:hiddenLabel         "尿反而多"@zh ;
    skos:note "金匮要略·消渴小便不利淋病。"@zh ;
    skos:notation "Xiaobianfanduo_instance" ;
    skos:exactMatch zz:Xiaobianfanduo_instance ;
    zz:classMatch zz:Xiaobianfanduo .

zzskos:Xiabaiwu a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "下白物"@zh ;
    skos:definition "阴道下白色分泌物。"@zh ;
    skos:hiddenLabel         "白带多"@zh,
        "下白色分泌物"@zh ;
    skos:note "金匮要略·妇人杂病：'妇人经水闭不利，脏坚癖不止，中有干血，下白物，矾石丸主之。'"@zh ;
    skos:closeMatch zzskos:Daixia ;
    skos:notation "Xiabaiwu_instance" ;
    skos:exactMatch zz:Xiabaiwu_instance ;
    zz:classMatch zz:Xiabaiwu .

zzskos:Niaoxue a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "尿血"@zh ;
    skos:definition "小便出血。"@zh ;
    skos:altLabel         "溺血"@zh ;
    skos:hiddenLabel         "小便带血"@zh,
        "血尿"@zh ;
    skos:note "金匮要略·五脏风寒积聚病。"@zh ;
    skos:closeMatch zzskos:Binv,
        zzskos:Nongxue,
        zzskos:Nvxue,
        zzskos:Wangxue ;
    skos:notation "Niaoxue_instance" ;
    skos:exactMatch zz:Niaoxue_instance ;
    zz:classMatch zz:Niaoxue .

zzskos:Qingbianyuzike a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "清便欲自可"@zh ;
    skos:definition "大便尚能自调。"@zh ;
    skos:hiddenLabel         "大便尚可"@zh ;
    skos:note "伤寒论第23条：'清便欲自可。'"@zh ;
    skos:notation "Qingbianyuzike_instance" ;
    skos:exactMatch zz:Qingbianyuzike_instance ;
    zz:classMatch zz:Qingbianyuzike .

zzskos:Budabian a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "不大便"@zh ;
    skos:definition "不大便。阳明腑实之候。"@zh ;
    skos:hiddenLabel         "不拉屎"@zh,
        "几天没大便"@zh,
        "没排便"@zh ;
    skos:note "伤寒论第212条：'不大便五六日，上至十余日……大承气汤主之。'"@zh ;
    skos:closeMatch zzskos:Bugengyi,
        zzskos:Dabianmijie,
        zzskos:Dabiannan,
        zzskos:Dabianying,
        zzskos:Zaoshi ;
    skos:notation "Budabian_instance" ;
    skos:exactMatch zz:Budabian_instance ;
    zz:classMatch zz:Budabian .

zzskos:Bugengyi a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "不更衣"@zh ;
    skos:definition "不更衣，即不大便。"@zh ;
    skos:hiddenLabel         "不排便"@zh,
        "没大便"@zh ;
    skos:note "伤寒论第181条：'不更衣，内实，大便难者，此名阳明也。'"@zh ;
    skos:closeMatch zzskos:Budabian,
        zzskos:Dabianmijie,
        zzskos:Dabiannan,
        zzskos:Dabianying,
        zzskos:Zaoshi ;
    skos:notation "Bugengyi_instance" ;
    skos:exactMatch zz:Bugengyi_instance ;
    zz:classMatch zz:Bugengyi .

zzskos:Xialibuzhi a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "下利不止"@zh ;
    skos:definition "下利不止。"@zh ;
    skos:hiddenLabel         "拉肚子止不住"@zh,
        "一直拉"@zh ;
    skos:note "伤寒论第159条：'伤寒服汤药，下利不止，心下痞硬。'"@zh ;
    skos:broader zzskos:Xiali ;
    skos:closeMatch zzskos:Gubuhua,
        zzskos:Jiuli,
