zzskos:Zhanyu a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "谵语"@zh ;
    skos:definition "神志不清，语无伦次。阳明腑实热盛之候。"@zh ;
    skos:hiddenLabel         "说胡话"@zh,
        "胡言乱语"@zh,
        "神志不清说胡话"@zh ;
    skos:note "伤寒论第210条：'夫实则谵语，虚则郑声。'胡老：谵语多属阳明里实。"@zh ;
