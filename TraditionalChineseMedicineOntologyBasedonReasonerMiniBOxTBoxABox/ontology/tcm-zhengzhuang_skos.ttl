zzskos:Murutuozhuang a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "目如脱状"@zh ;
    skos:definition "目睛胀突如脱。肺胀痰饮之候。"@zh ;
    skos:hiddenLabel         "眼睛像要掉出来"@zh,
        "眼珠外突"@zh ;
    skos:note "金匮要略·肺痿肺痈咳嗽上气：'咳而上气，此为肺胀……目如脱状，脉浮大者，越婢加半夏汤主之。'"@zh ;
