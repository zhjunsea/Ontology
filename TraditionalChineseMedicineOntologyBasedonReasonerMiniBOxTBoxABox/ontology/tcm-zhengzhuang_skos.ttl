zzskos:Shouzujueni a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "手足厥逆"@zh ;
    skos:definition "手足寒冷至肘膝。阴阳气不相顺接，厥阴病主症之一。"@zh ;
    skos:altLabel         "四肢厥逆"@zh ;
    skos:hiddenLabel         "手脚冰凉"@zh,
        "手脚冰冷"@zh,
        "四肢冰冷"@zh,
        "手脚冰"@zh ;
    skos:note "伤寒论第337条：'凡厥者，阴阳气不相顺接，便为厥。厥者，手足逆冷者是也。'胡老：厥有寒厥、热厥之分。"@zh ;
    skos:broader zzskos:Shouzuleng ;
    skos:closeMatch zzskos:Hanqijueni,
        zzskos:Jueni,
        zzskos:Shouzujueleng,
        zzskos:Shouzuleng,
        zzskos:Shouzunileng,
        zzskos:Sizhinileng ;
    skos:notation "Shouzujueni_instance" ;
    skos:exactMatch zz:Shouzujueni_instance ;
