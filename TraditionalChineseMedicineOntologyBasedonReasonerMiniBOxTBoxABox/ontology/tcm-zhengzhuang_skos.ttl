    skos:altLabel         "手足寒"@zh ;
    skos:hiddenLabel         "手脚冷"@zh,
        "手脚发凉"@zh,
        "手脚凉"@zh ;
    skos:note "伤寒论第148条：'手足冷，心下满，口不欲食，大便硬，脉细者，此为阳微结。'"@zh ;
