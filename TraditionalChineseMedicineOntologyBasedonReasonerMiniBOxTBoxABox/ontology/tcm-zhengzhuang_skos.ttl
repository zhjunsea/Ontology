    skos:prefLabel "时时吐浊"@zh ;
    skos:definition "时时吐出浊痰。"@zh ;
    skos:hiddenLabel         "老是吐浊痰"@zh ;
    skos:note "金匮要略·肺痿肺痈咳嗽上气。"@zh ;
