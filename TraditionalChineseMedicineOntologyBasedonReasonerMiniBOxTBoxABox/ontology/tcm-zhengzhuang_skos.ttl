zzskos:Houzhongshuijisheng a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "喉中水鸡声"@zh ;
    skos:definition "喉中痰鸣如水鸡之声。寒饮射肺之候。"@zh ;
    skos:hiddenLabel         "喉咙里有水鸡叫声"@zh,
        "喉中痰鸣如水鸡"@zh ;
    skos:note "金匮要略·肺痿肺痈咳嗽上气：'咳而上气，喉中水鸡声，射干麻黄汤主之。'"@zh ;
    skos:closeMatch zzskos:Huonishangqi,
        zzskos:Keershangqi ;
    skos:notation "Houzhongshuijisheng_instance" ;
    skos:exactMatch zz:Houzhongshuijisheng_instance ;
    zz:classMatch zz:Houzhongshuijisheng .

zzskos:Xinji a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "心悸"@zh ;
    skos:definition "心中悸动不安。水饮凌心或气血不足。"@zh ;
    skos:altLabel         "心动悸"@zh ;
    skos:hiddenLabel         "心慌"@zh,
        "心跳快"@zh,
        "心跳得厉害"@zh,
        "心里发慌"@zh ;
    skos:note "伤寒论第177条：'伤寒脉结代，心动悸，炙甘草汤主之。'"@zh ;
    skos:closeMatch zzskos:Chashouzimaoxin,
        zzskos:Qixiaji,
        zzskos:Xinxiajidong,
        zzskos:Xuanji,
        zzskos:Yudean ;
    skos:notation "Xinji_instance" ;
    skos:exactMatch zz:Xinji_instance ;
    zz:classMatch zz:Xinji .

zzskos:Xinxiajidong a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "心下悸动"@zh ;
    skos:definition "心下（胃脘）部位悸动。水饮内停。"@zh ;
    skos:hiddenLabel         "心口窝跳"@zh,
        "胃脘部跳动"@zh ;
    skos:note "伤寒论第127条：'心下悸'。"@zh ;
    skos:closeMatch zzskos:Chashouzimaoxin,
        zzskos:Qixiaji,
        zzskos:Xinji,
        zzskos:Xuanji,
        zzskos:Yudean ;
    skos:notation "Xinxiajidong_instance" ;
    skos:exactMatch zz:Xinxiajidong_instance ;
    zz:classMatch zz:Xinxiajidong .

zzskos:Qixiaji a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "脐下悸"@zh ;
    skos:definition "脐下悸动。欲作奔豚之候。"@zh ;
    skos:hiddenLabel         "肚脐下跳"@zh,
        "小腹跳动"@zh ;
    skos:note "伤寒论第65条：'发汗后，其人脐下悸者，欲作奔豚，茯苓桂枝甘草大枣汤主之。'"@zh ;
    skos:closeMatch zzskos:Chashouzimaoxin,
        zzskos:Xinji,
        zzskos:Xinxiajidong,
        zzskos:Xuanji,
        zzskos:Yudean ;
    skos:notation "Qixiaji_instance" ;
    skos:exactMatch zz:Qixiaji_instance ;
    zz:classMatch zz:Qixiaji .

zzskos:Xinxiaji a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "心下急"@zh ;
    skos:definition "心下拘急不舒。少阳兼阳明之候。"@zh ;
    skos:hiddenLabel         "心口窝发紧"@zh,
        "胃脘拘急"@zh ;
    skos:note "伤寒论第103条：'呕不止，心下急，郁郁微烦者……大柴胡汤主之。'"@zh ;
    skos:closeMatch zzskos:Xinxiaanzhimantong,
        zzskos:Xinxiajian,
        zzskos:Xinxiakuan,
        zzskos:Xinxiaman,
        zzskos:Xinxianiman,
        zzskos:Xinxiaodutong,
        zzskos:Xinxiazhijie ;
    skos:notation "Xinxiaji_instance" ;
    skos:exactMatch zz:Xinxiaji_instance ;
    zz:classMatch zz:Xinxiaji .

zzskos:Xinxiapi a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "心下痞"@zh ;
    skos:definition "心下（胃脘）痞塞不通，按之濡软。中焦气机不利。"@zh ;
    skos:altLabel         "痞"@zh ;
    skos:hiddenLabel         "胃胀"@zh,
        "胃里堵得慌"@zh,
        "心口窝堵"@zh,
        "胃部胀满"@zh ;
    skos:note "伤寒论第149条：'但满而不痛者，此为痞，柴胡不中与之，宜半夏泻心汤。'胡老：痞为按之濡、不痛。"@zh ;
    skos:closeMatch zzskos:Xinxiapijian,
        zzskos:Xinxiapiying,
        zzskos:Xinzhongpi ;
    skos:notation "Xinxiapi_instance" ;
    skos:exactMatch zz:Xinxiapi_instance ;
    zz:classMatch zz:Xinxiapi .

