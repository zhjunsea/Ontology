zzskos:Shejinanyan a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "舌即难言"@zh ;
    skos:definition "舌强难以言语。中风之候。"@zh ;
    skos:hiddenLabel         "舌头不听使唤说不出话"@zh ;
    skos:note "金匮要略·中风历节病：'邪入于脏，舌即难言，口吐涎。'"@zh ;
    skos:closeMatch zzskos:Danbibusui,
        zzskos:Koukai,
        zzskos:Koutuxian,
        zzskos:Maibuchuzhe ;
    skos:notation "Shejinanyan_instance" ;
    skos:exactMatch zz:Shejinanyan_instance ;
    zz:classMatch zz:Shejinanyan .

zzskos:Tunongrumizhou a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "吐脓如米粥"@zh ;
    skos:definition "吐脓如米粥状。肺痈溃脓之候。"@zh ;
    skos:hiddenLabel         "吐的脓像米粥"@zh ;
    skos:note "金匮要略·肺痿肺痈咳嗽上气。"@zh ;
