    skos:definition "能进食。"@zh ;
    skos:hiddenLabel         "能吃"@zh,
        "胃口好"@zh ;
    skos:note "伤寒论第190条：'阳明病，若能食，名中风；不能食，名中寒。'"@zh ;
    skos:closeMatch zzskos:Ji,
        zzskos:Xiaogushanji,
        zzskos:Xinzhongji,
        zzskos:Yinshihuoyoumeishi,
