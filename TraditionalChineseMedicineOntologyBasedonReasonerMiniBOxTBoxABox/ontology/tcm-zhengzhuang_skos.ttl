zzskos:Lishui a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "里水"@zh ;
    skos:definition "里水，水在里。"@zh ;
    skos:note "金匮要略·水气病：'里水者，一身面目黄肿，其脉沉，小便不利，故令病水。'"@zh ;
    skos:closeMatch zzskos:Fuzhonganzhimeizhi,
        zzskos:Pishui,
        zzskos:Shuizhiweibing,
