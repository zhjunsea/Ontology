    skos:altLabel         "咳"@zh ;
    skos:hiddenLabel         "老咳嗽"@zh,
        "嗓子痒咳"@zh ;
    skos:note "金匮要略·肺痿肺痈咳嗽上气。"@zh ;
    skos:closeMatch zzskos:Chuan,
