zzskos:Xiaobianfanshao a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "小便反少"@zh ;
    skos:definition "小便反少。"@zh ;
    skos:hiddenLabel         "尿反而少"@zh ;
    skos:note "金匮要略·痉湿暍病。"@zh ;
    skos:notation "Xiaobianfanshao_instance" ;
    skos:exactMatch zz:Xiaobianfanshao_instance ;
