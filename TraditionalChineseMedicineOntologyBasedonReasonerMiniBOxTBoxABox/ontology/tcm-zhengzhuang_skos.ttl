zzskos:Feiyong a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "肺痈"@zh ;
    skos:definition "肺痈，热毒壅肺、咳吐脓血。"@zh ;
    skos:note "金匮要略·肺痿肺痈咳嗽上气：'咳而胸满，振寒脉数，咽干不渴，时出浊唾腥臭，久久吐脓如米粥者，为肺痈，桔梗汤主之。'"@zh ;
    skos:closeMatch zzskos:Feitong ;
    skos:notation "Feiyong_instance" ;
    skos:exactMatch zz:Feiyong_instance ;
    zz:classMatch zz:Feiyong .

zzskos:Changyong a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "肠痈"@zh ;
    skos:definition "肠痈，热毒瘀结肠腑。"@zh ;
    skos:hiddenLabel         "阑尾脓肿"@zh ;
    skos:note "金匮要略·疮痈肠痈浸淫病：'肠痈者，少腹肿痞，按之即痛如淋，小便自调，时时发热，自汗出，复恶寒……大黄牡丹汤主之。'"@zh ;
    skos:notation "Changyong_instance" ;
    skos:exactMatch zz:Changyong_instance ;
    zz:classMatch zz:Changyong .

zzskos:Nvemu a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "疟母"@zh ;
    skos:definition "疟母，疟久结为癥瘕。"@zh ;
    skos:hiddenLabel         "疟疾后痞块"@zh ;
    skos:note "金匮要略·疟病：'病疟以月一日发，当以十五日愈……此结为癥瘕，名曰疟母，急治之，宜鳖甲煎丸。'"@zh ;
    skos:closeMatch zzskos:Darupan,
        zzskos:Shaofuzhengkuai,
        zzskos:Xiexiazhengjia,
        zzskos:Zhengkuai ;
    skos:notation "Nvemu_instance" ;
    skos:exactMatch zz:Nvemu_instance ;
    zz:classMatch zz:Nvemu .

