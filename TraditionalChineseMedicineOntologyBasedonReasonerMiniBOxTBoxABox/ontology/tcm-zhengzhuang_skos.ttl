    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "唇口干燥"@zh ;
    skos:definition "唇口干燥。津血不足或瘀血。"@zh ;
    skos:hiddenLabel         "嘴唇干"@zh,
        "嘴干唇裂"@zh ;
    skos:note "金匮要略·妇人杂病：'唇口干燥，温经汤主之。'"@zh ;
    skos:closeMatch zzskos:Duotuokouzao,
        zzskos:Kousheganzao,
        zzskos:Kouzao,
        zzskos:Kouzhongpipizao,
