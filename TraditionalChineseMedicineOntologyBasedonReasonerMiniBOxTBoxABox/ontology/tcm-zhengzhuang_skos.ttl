zzskos:Huonishangqi a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "火逆上气"@zh ;
    skos:definition "虚火挟气上逆。"@zh ;
    skos:hiddenLabel         "虚火上冲气逆"@zh ;
    skos:note "金匮要略·肺痿肺痈咳嗽上气：'火逆上气，咽喉不利，止逆下气者，麦门冬汤主之。'"@zh ;
    skos:closeMatch zzskos:Houzhongshuijisheng,
        zzskos:Keershangqi ;
