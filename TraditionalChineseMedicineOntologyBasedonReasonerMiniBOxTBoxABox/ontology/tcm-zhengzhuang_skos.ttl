    skos:altLabel         "脏躁"@zh ;
    skos:hiddenLabel         "无故悲伤想哭"@zh ;
    skos:note "金匮要略·妇人杂病：'妇人脏躁，喜悲伤欲哭，象如神灵所作，数欠伸，甘麦大枣汤主之。'"@zh ;
    skos:closeMatch zzskos:Beishang,
        zzskos:Shuqianshen,
        zzskos:Xiangrushenlingsuozuo,
        zzskos:Xibeishangyuku ;
