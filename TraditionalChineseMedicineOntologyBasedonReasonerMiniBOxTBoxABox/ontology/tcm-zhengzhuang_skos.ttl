        zzskos:Ou,
        zzskos:Ouni,
        zzskos:Tu,
        zzskos:Weiou,
        zzskos:Xiou,
        zzskos:Yuou,
        zzskos:Yutu ;
    skos:notation "Outu_instance" ;
    skos:exactMatch zz:Outu_instance ;
    zz:classMatch zz:Outu .

zzskos:Chaoshimutu a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "朝食暮吐"@zh ;
    skos:definition "朝食暮吐。胃反（反胃）之候。"@zh ;
    skos:hiddenLabel         "早上吃的晚上吐"@zh,
        "吃了很久才吐"@zh ;
    skos:note "金匮要略·呕吐哕下利病：'朝食暮吐，暮食朝吐，宿谷不化，名曰胃反。'"@zh ;
    skos:broader zzskos:Outu ;
    skos:notation "Chaoshimutu_instance" ;
    skos:exactMatch zz:Chaoshimutu_instance ;
    zz:classMatch zz:Chaoshimutu .

zzskos:Ou a skos:Concept ;
