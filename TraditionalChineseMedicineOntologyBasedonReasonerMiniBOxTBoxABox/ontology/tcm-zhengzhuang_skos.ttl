    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "心下痞坚"@zh ;
    skos:definition "心下痞满而坚硬。"@zh ;
    skos:hiddenLabel         "胃脘痞硬坚满"@zh ;
    skos:note "金匮要略·痰饮：'膈间支饮，其人喘满，心下痞坚，面色黧黑。'"@zh ;
    skos:closeMatch zzskos:Xinxiapi,
        zzskos:Xinxiapiying,
        zzskos:Xinzhongpi ;
    skos:notation "Xinxiapijian_instance" ;
    skos:exactMatch zz:Xinxiapijian_instance ;
    zz:classMatch zz:Xinxiapijian .

zzskos:Xinxiakuan a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "心下宽"@zh ;
    skos:definition "心下宽松不胀。"@zh ;
    skos:hiddenLabel         "胃脘宽松"@zh ;
    skos:closeMatch zzskos:Xinxiaanzhimantong,
        zzskos:Xinxiaji,
        zzskos:Xinxiajian,
        zzskos:Xinxiaman,
        zzskos:Xinxianiman,
        zzskos:Xinxiaodutong,
        zzskos:Xinxiazhijie ;
    skos:notation "Xinxiakuan_instance" ;
    skos:exactMatch zz:Xinxiakuan_instance ;
    zz:classMatch zz:Xinxiakuan .

zzskos:Xinxianiman a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "心下逆满"@zh ;
    skos:definition "心下胀满而气逆。"@zh ;
    skos:hiddenLabel         "胃脘胀满气逆"@zh ;
    skos:note "伤寒论第67条：'心下逆满，气上冲胸，起则头眩。'"@zh ;
    skos:closeMatch zzskos:Xinxiaanzhimantong,
        zzskos:Xinxiaji,
        zzskos:Xinxiajian,
        zzskos:Xinxiakuan,
        zzskos:Xinxiaman,
        zzskos:Xinxiaodutong,
        zzskos:Xinxiazhijie ;
    skos:notation "Xinxianiman_instance" ;
    skos:exactMatch zz:Xinxianiman_instance ;
    zz:classMatch zz:Xinxianiman .

zzskos:Xinxiaman a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "心下满"@zh ;
    skos:definition "心下胀满。"@zh ;
    skos:hiddenLabel         "胃脘胀满"@zh,
        "心口窝胀"@zh ;
    skos:note "伤寒论第28条：'服桂枝汤，或下之，仍头项强痛，翕翕发热，无汗，心下满微痛，小便不利者，桂枝去桂加茯苓白术汤主之。'"@zh ;
    skos:closeMatch zzskos:Xinxiaanzhimantong,
        zzskos:Xinxiaji,
        zzskos:Xinxiajian,
        zzskos:Xinxiakuan,
        zzskos:Xinxianiman,
        zzskos:Xinxiaodutong,
        zzskos:Xinxiazhijie ;
    skos:notation "Xinxiaman_instance" ;
    skos:exactMatch zz:Xinxiaman_instance ;
    zz:classMatch zz:Xinxiaman .

zzskos:Xinxiatong a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "心下痛"@zh ;
    skos:definition "心下（胃脘）疼痛。"@zh ;
    skos:altLabel         "胃脘痛"@zh ;
    skos:hiddenLabel         "胃疼"@zh,
        "胃痛"@zh,
        "心口窝疼"@zh,
        "胃脘疼"@zh ;
    skos:note "伤寒论第135条：'伤寒六七日，结胸热实，脉沉而紧，心下痛，按之石硬者，大陷胸汤主之。'"@zh ;
    skos:notation "Xinxiatong_instance" ;
    skos:exactMatch zz:Xinxiatong_instance ;
    zz:classMatch zz:Xinxiatong .

zzskos:Xinxiazhijie a skos:Concept ;
