    skos:exactMatch zz:Xiou_instance ;
    zz:classMatch zz:Xiou .

zzskos:Tuli a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "吐利"@zh ;
    skos:definition "呕吐兼下利。"@zh ;
    skos:hiddenLabel         "又吐又拉"@zh ;
    skos:note "伤寒论第309条：'少阴病，吐利，手足逆冷，烦躁欲死者，吴茱萸汤主之。'"@zh ;
    skos:notation "Tuli_instance" ;
    skos:exactMatch zz:Tuli_instance ;
    zz:classMatch zz:Tuli .

zzskos:Shibuxia a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "食不下"@zh ;
    skos:definition "饮食不下。太阴病提纲证之一。"@zh ;
    skos:hiddenLabel         "吃不下饭"@zh,
        "食欲差"@zh ;
    skos:note "伤寒论第273条：'太阴之为病，腹满而吐，食不下。'"@zh ;
