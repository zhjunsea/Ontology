zzskos:Buyuyin a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "不欲饮"@zh ;
    skos:definition "不欲饮水。水饮内停或阴寒。"@zh ;
    skos:altLabel         "不欲饮水"@zh ;
    skos:hiddenLabel         "不爱喝水"@zh ;
    skos:note "伤寒论第282条：'自利不渴者，属太阴。'"@zh ;
    skos:closeMatch zzskos:Buke,
        zzskos:Dake,
        zzskos:Danyuyinre,
        zzskos:Fanbuke,
        zzskos:Kouke,
        zzskos:Xiaoke,
        zzskos:Yuyin ;
    skos:notation "Buyuyin_instance" ;
    skos:exactMatch zz:Buyuyin_instance ;
    zz:classMatch zz:Buyuyin .

zzskos:Kouku a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "口苦"@zh ;
    skos:definition "口中觉苦。少阳病提纲证之一，胆火上炎。"@zh ;
    skos:altLabel         "口苦咽干"@zh ;
    skos:hiddenLabel         "嘴里苦"@zh,
        "嘴发苦"@zh ;
    skos:note "伤寒论第263条：'少阳之为病，口苦，咽干，目眩也。'胡老：口苦为少阳第一主症。"@zh ;
    skos:closeMatch zzskos:Aigan,
        zzskos:Yangan ;
    skos:notation "Kouku_instance" ;
    skos:exactMatch zz:Kouku_instance ;
    zz:classMatch zz:Kouku .

zzskos:Kouburen a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "口不仁"@zh ;
    skos:definition "口部麻木，不知味觉。阳明热盛之候。"@zh ;
    skos:hiddenLabel         "嘴麻木"@zh,
        "口唇麻木不知味"@zh ;
    skos:note "伤寒论第219条：'三阳合病……口不仁。'"@zh ;
    skos:notation "Kouburen_instance" ;
    skos:exactMatch zz:Kouburen_instance ;
