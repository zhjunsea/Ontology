        zzskos:Ye,
        zzskos:Yiqi ;
    skos:notation "Tunsuan_instance" ;
    skos:exactMatch zz:Tunsuan_instance ;
    zz:classMatch zz:Tunsuan .

zzskos:Shizetuhui a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "食则吐蛔"@zh ;
    skos:definition "进食则吐蛔。"@zh ;
    skos:hiddenLabel         "一吃东西就吐蛔虫"@zh ;
    skos:note "伤寒论第338条：'蛔厥者，乌梅丸主之。'"@zh ;
    skos:closeMatch zzskos:Huichong,
        zzskos:Tuhui,
        zzskos:Xinzhongtengre ;
    skos:notation "Shizetuhui_instance" ;
    skos:exactMatch zz:Shizetuhui_instance ;
