    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "心下痞硬"@zh ;
    skos:definition "心下痞塞而硬。"@zh ;
    skos:hiddenLabel         "胃脘胀硬"@zh,
        "心口窝又胀又硬"@zh ;
    skos:note "伤寒论第158条：'伤寒中风，医反下之……心下痞硬而满。'"@zh ;
    skos:closeMatch zzskos:Xinxiapi,
        zzskos:Xinxiapijian,
        zzskos:Xinzhongpi ;
    skos:notation "Xinxiapiying_instance" ;
    skos:exactMatch zz:Xinxiapiying_instance ;
    zz:classMatch zz:Xinxiapiying .

zzskos:Xinxiajian a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "心下坚"@zh ;
    skos:definition "心下坚硬。"@zh ;
    skos:hiddenLabel         "胃脘坚硬"@zh,
        "心口窝发硬"@zh ;
    skos:note "金匮要略·水气病：'心下坚，大如盘，边如旋盘。'"@zh ;
    skos:closeMatch zzskos:Xinxiaanzhimantong,
        zzskos:Xinxiaji,
        zzskos:Xinxiakuan,
        zzskos:Xinxiaman,
        zzskos:Xinxianiman,
        zzskos:Xinxiaodutong,
        zzskos:Xinxiazhijie ;
    skos:notation "Xinxiajian_instance" ;
    skos:exactMatch zz:Xinxiajian_instance ;
    zz:classMatch zz:Xinxiajian .

