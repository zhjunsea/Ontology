    skos:hiddenLabel         "四肢微微拘急"@zh ;
    skos:note "伤寒论第20条：'四肢微急，难以屈伸者，桂枝加附子汤主之。'"@zh ;
    skos:closeMatch zzskos:Bukequshen,
        zzskos:Chetongbudequshen,
