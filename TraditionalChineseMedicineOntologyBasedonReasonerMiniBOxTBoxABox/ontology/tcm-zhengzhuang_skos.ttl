    skos:prefLabel "心下支结"@zh ;
    skos:definition "心下支撑结滞不舒。少阳之候。"@zh ;
    skos:hiddenLabel         "心口窝支撑结滞"@zh ;
    skos:note "伤寒论第146条：'伤寒六七日……心下支结，外证未去者，柴胡桂枝汤主之。'"@zh ;
    skos:closeMatch zzskos:Xinxiaanzhimantong,
        zzskos:Xinxiaji,
