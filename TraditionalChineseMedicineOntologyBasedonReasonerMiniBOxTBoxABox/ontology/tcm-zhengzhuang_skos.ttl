    skos:definition "咳嗽吐痰。"@zh ;
    skos:hiddenLabel         "咳嗽吐痰"@zh,
        "咳痰"@zh ;
    skos:note "金匮要略·痰饮。"@zh ;
    skos:closeMatch zzskos:Chuan,
        zzskos:Duanqi,
        zzskos:Keni,
        zzskos:Kesou,
        zzskos:Shangqi,
        zzskos:Shaoqi ;
    skos:notation "Ketuo_instance" ;
    skos:exactMatch zz:Ketuo_instance ;
