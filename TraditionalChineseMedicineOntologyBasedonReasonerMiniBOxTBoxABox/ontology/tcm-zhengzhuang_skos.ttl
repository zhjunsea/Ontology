    skos:prefLabel "咳而上气"@zh ;
    skos:definition "咳嗽兼气逆上冲。肺胀之候。"@zh ;
    skos:hiddenLabel         "咳得喘不上气"@zh,
        "咳嗽气往上冲"@zh ;
    skos:note "金匮要略·肺痿肺痈咳嗽上气：'咳而上气，喉中水鸡声，射干麻黄汤主之。'"@zh ;
    skos:closeMatch zzskos:Houzhongshuijisheng,
        zzskos:Huonishangqi ;
    skos:notation "Keershangqi_instance" ;
    skos:exactMatch zz:Keershangqi_instance ;
