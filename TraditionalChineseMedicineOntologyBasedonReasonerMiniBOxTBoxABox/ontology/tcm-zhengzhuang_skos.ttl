zzskos:Bunengyinshi a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "不能饮食"@zh ;
    skos:definition "不能饮食。"@zh ;
    skos:hiddenLabel         "不能吃"@zh,
        "吃不了东西"@zh ;
    skos:note "金匮要略·腹满寒疝宿食。"@zh ;
