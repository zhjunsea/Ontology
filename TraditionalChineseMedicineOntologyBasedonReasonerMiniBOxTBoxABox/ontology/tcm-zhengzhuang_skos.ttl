    skos:prefLabel "手足逆冷"@zh ;
    skos:definition "手足逆冷。"@zh ;
    skos:note "伤寒论第337条。"@zh ;
    skos:closeMatch zzskos:Hanqijueni,
        zzskos:Jueni,
        zzskos:Shouzujueleng,
