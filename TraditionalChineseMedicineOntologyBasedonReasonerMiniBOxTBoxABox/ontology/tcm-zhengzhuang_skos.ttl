    skos:hiddenLabel         "饮食正常"@zh,
        "胃口跟平时一样"@zh ;
    skos:note "金匮要略·妇人妊娠病：'妊娠呕吐不止，干姜人参半夏丸主之。'"@zh ;
    skos:closeMatch zzskos:Ji,
        zzskos:Nengshi,
        zzskos:Xiaogushanji,
        zzskos:Xinzhongji,
