zzskos:Fanzao a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "烦躁"@zh ;
    skos:definition "心烦而躁动不安。热盛或阳虚阴盛皆可见。"@zh ;
    skos:altLabel         "烦燥"@zh ;
    skos:hiddenLabel         "心里烦"@zh,
        "坐立不安"@zh,
        "又烦又躁"@zh ;
    skos:note "伤寒论第38条：'太阳中风，脉浮紧，发热恶寒，身疼痛，不汗出而烦躁者，大青龙汤主之。'"@zh ;
    skos:narrower zzskos:Rukuang,
