        zzskos:Mianseqing,
        zzskos:Mianseweihuang,
        zzskos:Miansewuhua,
        zzskos:Shenre,
        zzskos:Shenzhuore,
        zzskos:Shitoure,
        zzskos:Weire ;
    skos:notation "Mianre_instance" ;
    skos:exactMatch zz:Mianre_instance ;
    zz:classMatch zz:Mianre .

zzskos:Miangou a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "面垢"@zh ;
    skos:definition "面部如蒙尘垢。阳明热盛或中暑之候。"@zh ;
    skos:hiddenLabel         "脸上像蒙了灰"@zh,
        "脸油腻发暗"@zh ;
    skos:note "伤寒论第219条：'三阳合病……口不仁，面垢。'"@zh ;
    skos:notation "Miangou_instance" ;
    skos:exactMatch zz:Miangou_instance ;
    zz:classMatch zz:Miangou .

zzskos:Mianseweihuang a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "面色萎黄"@zh ;
    skos:definition "面色黄而枯槁无华。脾胃虚弱、气血不足。"@zh ;
    skos:hiddenLabel         "脸色发黄"@zh,
        "面黄无光"@zh,
        "脸色萎黄"@zh ;
    skos:note "金匮要略·黄疸病。"@zh ;
    skos:closeMatch zzskos:Eshanghei,
        zzskos:Mianchi,
        zzskos:Mianre,
        zzskos:Miansebai,
        zzskos:Mianselihei,
        zzskos:Mianseqing,
        zzskos:Miansewuhua ;
    skos:notation "Mianseweihuang_instance" ;
    skos:exactMatch zz:Mianseweihuang_instance ;
    zz:classMatch zz:Mianseweihuang .

zzskos:Mianfu a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "面浮"@zh ;
    skos:definition "面部浮肿。风水或阳虚水泛。"@zh ;
    skos:altLabel         "面肿"@zh ;
    skos:hiddenLabel         "脸肿"@zh,
        "脸浮肿"@zh,
        "脸发胀"@zh ;
    skos:note "金匮要略·水气病：'面目肿大，有热，名曰风水。'"@zh ;
    skos:closeMatch zzskos:Jiaozhong,
        zzskos:Shentizhong,
        zzskos:Shenweizhong,
        zzskos:Shuizhong,
        zzskos:Sizhizhong,
        zzskos:Xingzhong,
        zzskos:Yishenxizhong ;
    skos:notation "Mianfu_instance" ;
    skos:exactMatch zz:Mianfu_instance ;
    zz:classMatch zz:Mianfu .

zzskos:Mianseqing a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "面色青"@zh ;
    skos:definition "面色发青。寒证、痛证、瘀血或惊风。"@zh ;
    skos:hiddenLabel         "脸色发青"@zh,
        "脸青"@zh ;
    skos:note "胡老：面青多主寒、主痛、主瘀。"@zh ;
    skos:closeMatch zzskos:Eshanghei,
        zzskos:Mianchi,
        zzskos:Mianre,
        zzskos:Miansebai,
        zzskos:Mianselihei,
        zzskos:Mianseweihuang,
        zzskos:Miansewuhua ;
    skos:notation "Mianseqing_instance" ;
    skos:exactMatch zz:Mianseqing_instance ;
    zz:classMatch zz:Mianseqing .

zzskos:Miansebai a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "面色白"@zh ;
    skos:definition "面色苍白。血虚或阳虚寒盛。"@zh ;
    skos:altLabel         "面白"@zh ;
    skos:hiddenLabel         "脸色苍白"@zh,
        "脸白"@zh,
        "面色发白"@zh ;
    skos:note "金匮要略·血痹虚劳：'男子面色薄者，主渴及亡血。'"@zh ;
    skos:closeMatch zzskos:Eshanghei,
        zzskos:Mianchi,
        zzskos:Mianre,
        zzskos:Mianselihei,
        zzskos:Mianseqing,
        zzskos:Mianseweihuang,
        zzskos:Miansewuhua ;
    skos:notation "Miansebai_instance" ;
    skos:exactMatch zz:Miansebai_instance ;
    zz:classMatch zz:Miansebai .

zzskos:Eshanghei a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "额上黑"@zh ;
    skos:definition "额部色黑。女劳疸之候，肾虚夹瘀。"@zh ;
    skos:hiddenLabel         "额头黑"@zh,
        "额头暗黑"@zh ;
    skos:note "金匮要略·黄疸病：'额上黑，微汗出，手足中热……名曰女劳疸。'"@zh ;
    skos:closeMatch zzskos:Mianchi,
        zzskos:Mianre,
        zzskos:Miansebai,
        zzskos:Mianselihei,
        zzskos:Mianseqing,
        zzskos:Mianseweihuang,
        zzskos:Miansewuhua ;
    skos:notation "Eshanghei_instance" ;
    skos:exactMatch zz:Eshanghei_instance ;
    zz:classMatch zz:Eshanghei .

zzskos:Mianchibanbanrujinwen a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "面赤斑斑如锦纹"@zh ;
    skos:definition "面部红斑如锦缎花纹。阳毒之候。"@zh ;
    skos:hiddenLabel         "脸上红斑如花纹"@zh,
        "脸上起红斑"@zh ;
    skos:note "金匮要略·百合狐惑阴阳毒：'阳毒之为病，面赤斑斑如锦纹。'"@zh ;
    skos:notation "Mianchibanbanrujinwen_instance" ;
    skos:exactMatch zz:Mianchibanbanrujinwen_instance ;
    zz:classMatch zz:Mianchibanbanrujinwen .

zzskos:Xiangqiang a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "项强"@zh ;
    skos:definition "项部强直不舒。太阳经气不利或痉病。"@zh ;
    skos:altLabel         "颈项强"@zh ;
    skos:hiddenLabel         "脖子僵硬"@zh,
        "脖子发硬"@zh,
        "后脖颈僵硬"@zh ;
    skos:note "伤寒论第1条：'头项强痛'。"@zh ;
    skos:narrower zzskos:Xiangbeiqiangjiji ;
    skos:closeMatch zzskos:Beiqiang,
        zzskos:Shentiqiangjiji,
        zzskos:Xiangbeiqiangjiji ;
    skos:notation "Xiangqiang_instance" ;
    skos:exactMatch zz:Xiangqiang_instance ;
    zz:classMatch zz:Xiangqiang .

zzskos:Beiqiang a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "背强"@zh ;
    skos:definition "背部强直。太阳经输不利。"@zh ;
    skos:hiddenLabel         "后背僵硬"@zh,
        "背部发紧"@zh ;
    skos:note "伤寒论第31条：'太阳病，项背强几几，无汗恶风，葛根汤主之。'"@zh ;
    skos:closeMatch zzskos:Shentiqiangjiji,
        zzskos:Xiangbeiqiangjiji,
        zzskos:Xiangqiang ;
    skos:notation "Beiqiang_instance" ;
    skos:exactMatch zz:Beiqiang_instance ;
    zz:classMatch zz:Beiqiang .

zzskos:Xiangbeiqiangjiji a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "项背强几几"@zh ;
    skos:definition "项背拘紧不舒，如短羽鸟欲飞之状。太阳经输不利。"@zh ;
    skos:altLabel         "项背强"@zh ;
    skos:hiddenLabel         "脖子后背发紧僵硬"@zh,
        "后脖子到后背僵"@zh ;
    skos:note "伤寒论第14条：'项背强几几，反汗出恶风者，桂枝加葛根汤主之。'"@zh ;
    skos:broader zzskos:Xiangqiang ;
    skos:closeMatch zzskos:Beiqiang,
        zzskos:Shentiqiangjiji,
        zzskos:Xiangqiang ;
    skos:notation "Xiangbeiqiangjiji_instance" ;
    skos:exactMatch zz:Xiangbeiqiangjiji_instance ;
    zz:classMatch zz:Xiangbeiqiangjiji .

zzskos:Shentiqiangjiji a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "身体强几几"@zh ;
    skos:definition "身体拘紧强直。"@zh ;
    skos:hiddenLabel         "浑身发僵"@zh,
        "全身僵硬"@zh ;
    skos:note "金匮要略·痉湿暍病。"@zh ;
    skos:closeMatch zzskos:Beiqiang,
        zzskos:Xiangbeiqiangjiji,
        zzskos:Xiangqiang ;
    skos:notation "Shentiqiangjiji_instance" ;
    skos:exactMatch zz:Shentiqiangjiji_instance ;
    zz:classMatch zz:Shentiqiangjiji .

zzskos:Erlong a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "耳聋"@zh ;
    skos:definition "听力减退或丧失。少阳经气不利或肾虚。"@zh ;
    skos:altLabel         "重听"@zh ;
    skos:hiddenLabel         "耳朵听不见"@zh,
        "听不清"@zh,
        "耳背"@zh ;
    skos:note "伤寒论第264条：'少阳中风，两耳无所闻。'"@zh ;
    skos:closeMatch zzskos:Bigan,
        zzskos:Biming,
        zzskos:Binv,
        zzskos:Erqianhouzhong ;
    skos:notation "Erlong_instance" ;
    skos:exactMatch zz:Erlong_instance ;
    zz:classMatch zz:Erlong .

zzskos:Erqianhouzhong a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "耳前后肿"@zh ;
    skos:definition "耳前耳后肿胀。少阳风热或痄腮。"@zh ;
    skos:hiddenLabel         "耳朵前后肿"@zh,
        "腮帮子肿"@zh ;
    skos:note "伤寒论第231条：'耳前后肿，刺之小差。'"@zh ;
    skos:closeMatch zzskos:Bigan,
        zzskos:Biming,
        zzskos:Binv,
        zzskos:Erlong ;
    skos:notation "Erqianhouzhong_instance" ;
    skos:exactMatch zz:Erqianhouzhong_instance ;
    zz:classMatch zz:Erqianhouzhong .

zzskos:Biming a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "鼻鸣"@zh ;
    skos:definition "鼻塞而呼吸有声。太阳中风之候。"@zh ;
    skos:hiddenLabel         "鼻子不通气有声"@zh,
        "鼻子呼呼响"@zh ;
    skos:note "伤寒论第12条：'鼻鸣干呕者，桂枝汤主之。'"@zh ;
    skos:closeMatch zzskos:Bigan,
        zzskos:Binv,
        zzskos:Erlong,
        zzskos:Erqianhouzhong ;
    skos:notation "Biming_instance" ;
    skos:exactMatch zz:Biming_instance ;
    zz:classMatch zz:Biming .

zzskos:Binv a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "鼻衄"@zh ;
    skos:definition "鼻中出血。表热郁闭或阳明热盛迫血。"@zh ;
    skos:altLabel         "鼻出血"@zh ;
    skos:hiddenLabel         "流鼻血"@zh,
        "鼻子出血"@zh,
        "鼻子流血"@zh ;
    skos:note "伤寒论第46条：'阳气重故也，麻黄汤主之。'胡老：衄乃解。"@zh ;
    skos:closeMatch zzskos:Bigan,
        zzskos:Biming,
        zzskos:Erlong,
        zzskos:Erqianhouzhong,
        zzskos:Niaoxue,
        zzskos:Nongxue,
        zzskos:Nvxue,
        zzskos:Wangxue ;
    skos:notation "Binv_instance" ;
    skos:exactMatch zz:Binv_instance ;
    zz:classMatch zz:Binv .

zzskos:Muzhongbulele a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "目中不了了"@zh ;
    skos:definition "视物模糊不清。阳明腑实、热灼津液之危候。"@zh ;
    skos:hiddenLabel         "看东西不清楚"@zh,
        "眼睛发直看不清"@zh ;
    skos:note "伤寒论第252条：'伤寒六七日，目中不了了，睛不和，无表里证，大便难，身微热者，此为实也，急下之，宜大承气汤。'"@zh ;
    skos:closeMatch zzskos:Jingbuhe,
        zzskos:Liangmuanhei,
        zzskos:Mubudebi,
