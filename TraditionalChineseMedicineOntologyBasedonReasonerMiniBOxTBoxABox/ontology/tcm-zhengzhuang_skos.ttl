zzskos:Xiaogushanji a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "消谷善饥"@zh ;
    skos:definition "食欲亢进，食而易饥。胃火亢盛。"@zh ;
    skos:hiddenLabel         "吃得多还饿"@zh,
        "容易饿"@zh,
        "特别能吃"@zh ;
    skos:note "伤寒论第257条：'病人无表里证，发热七八日，虽脉浮数者，可下之……消谷善饥。'"@zh ;
