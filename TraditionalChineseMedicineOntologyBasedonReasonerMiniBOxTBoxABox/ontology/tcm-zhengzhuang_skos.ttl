    skos:prefLabel "不欲食"@zh ;
    skos:definition "不思饮食。少阳或太阴之候。"@zh ;
    skos:altLabel         "不欲饮食"@zh ;
    skos:hiddenLabel         "没胃口"@zh,
        "食欲不振"@zh,
        "不想吃饭"@zh,
        "吃不下"@zh,
        "没食欲"@zh ;
    skos:note "伤寒论第96条：'嘿嘿不欲饮食。'"@zh ;
    skos:narrower zzskos:Shibuxia ;
    skos:closeMatch zzskos:Bunengshiyin,
        zzskos:Bunengyinshi,
