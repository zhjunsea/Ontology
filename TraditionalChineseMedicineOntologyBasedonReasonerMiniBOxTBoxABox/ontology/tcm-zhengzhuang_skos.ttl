        zzskos:Danyushushuibuyuyan,
        zzskos:Jifujiacuo,
        zzskos:Liangmuanhei,
        zzskos:Xiongzhongjiacuo ;
    skos:notation "Chunan_instance" ;
    skos:exactMatch zz:Chunan_instance ;
    zz:classMatch zz:Chunan .

zzskos:Chunwei a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "唇痿"@zh ;
    skos:definition "口唇枯萎不泽。"@zh ;
    skos:hiddenLabel         "嘴唇萎缩"@zh,
        "嘴唇干瘪"@zh ;
    skos:note "金匮要略·血痹虚劳。"@zh ;
    skos:notation "Chunwei_instance" ;
    skos:exactMatch zz:Chunwei_instance ;
    zz:classMatch zz:Chunwei .

zzskos:Yangan a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "咽干"@zh ;
    skos:definition "咽喉干燥。少阳热盛或津伤。"@zh ;
    skos:hiddenLabel         "嗓子干"@zh,
        "喉咙干"@zh,
        "咽喉干燥"@zh ;
    skos:note "伤寒论第263条：'口苦，咽干，目眩。'"@zh ;
    skos:closeMatch zzskos:Aigan,
        zzskos:Kouku ;
    skos:notation "Yangan_instance" ;
    skos:exactMatch zz:Yangan_instance ;
    zz:classMatch zz:Yangan .

zzskos:Yantong a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "咽痛"@zh ;
    skos:definition "咽喉疼痛。少阴客热或虚火上炎。"@zh ;
    skos:altLabel         "喉痛"@zh ;
    skos:hiddenLabel         "嗓子疼"@zh,
        "喉咙痛"@zh,
        "咽口水都疼"@zh ;
    skos:note "伤寒论第310条：'少阴病，下利，咽痛，胸满，心烦，猪肤汤主之。'"@zh ;
    skos:narrower zzskos:Yanzhongtong ;
    skos:closeMatch zzskos:Yanzhongtong ;
    skos:notation "Yantong_instance" ;
    skos:exactMatch zz:Yantong_instance ;
    zz:classMatch zz:Yantong .

zzskos:Yanzhongtong a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "咽中痛"@zh ;
    skos:definition "咽中疼痛。"@zh ;
    skos:hiddenLabel         "嗓子里面疼"@zh,
        "喉咙里面痛"@zh ;
    skos:note "伤寒论第313条：'少阴病，咽中痛，半夏散及汤主之。'"@zh ;
    skos:broader zzskos:Yantong ;
    skos:closeMatch zzskos:Yantong ;
    skos:notation "Yanzhongtong_instance" ;
    skos:exactMatch zz:Yanzhongtong_instance ;
    zz:classMatch zz:Yanzhongtong .

zzskos:Yanhoubuli a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "咽喉不利"@zh ;
    skos:definition "咽喉不利。痰气交阻或津伤。"@zh ;
    skos:hiddenLabel         "嗓子不舒服"@zh,
        "喉咙不利索"@zh ;
    skos:note "金匮要略·肺痿肺痈咳嗽上气：'火逆上气，咽喉不利，止逆下气者，麦门冬汤主之。'"@zh ;
    skos:notation "Yanhoubuli_instance" ;
    skos:exactMatch zz:Yanhoubuli_instance ;
    zz:classMatch zz:Yanhoubuli .

zzskos:Yanzhongruyouzhiluan a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "咽中如有炙脔"@zh ;
    skos:definition "咽中如有物阻，咯之不出、咽之不下。痰气交阻。"@zh ;
    skos:altLabel         "梅核气"@zh ;
    skos:hiddenLabel         "嗓子里像有东西堵着"@zh,
        "喉咙有异物感"@zh,
        "咽不下吐不出"@zh ;
    skos:note "金匮要略·妇人杂病：'妇人咽中如有炙脔，半夏厚朴汤主之。'"@zh ;
    skos:notation "Yanzhongruyouzhiluan_instance" ;
    skos:exactMatch zz:Yanzhongruyouzhiluan_instance ;
    zz:classMatch zz:Yanzhongruyouzhiluan .

zzskos:Danyushushuibuyuyan a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "但欲漱水不欲咽"@zh ;
    skos:definition "但欲漱水而不欲咽下。瘀血之候。"@zh ;
    skos:hiddenLabel         "只想漱口不想咽"@zh,
        "含水不咽"@zh ;
    skos:note "金匮要略·惊悸吐衄下血胸满瘀血病：'病人胸满，唇痿舌青，口燥，但欲漱水不欲咽，无寒热……为有瘀血。'"@zh ;
    skos:closeMatch zzskos:Chunan,
        zzskos:Citong,
        zzskos:Jifujiacuo,
        zzskos:Liangmuanhei,
        zzskos:Xiongzhongjiacuo ;
    skos:notation "Danyushushuibuyuyan_instance" ;
    skos:exactMatch zz:Danyushushuibuyuyan_instance ;
    zz:classMatch zz:Danyushushuibuyuyan .

zzskos:Danyuyinre a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "但欲饮热"@zh ;
    skos:definition "但欲饮热。里寒之候。"@zh ;
    skos:hiddenLabel         "只想喝热水"@zh,
        "爱喝热的"@zh ;
    skos:note "伤寒论第11条。"@zh ;
    skos:closeMatch zzskos:Buke,
        zzskos:Buyuyin,
        zzskos:Dake,
        zzskos:Fanbuke,
        zzskos:Kouke,
        zzskos:Xiaoke,
        zzskos:Yuyin ;
    skos:notation "Danyuyinre_instance" ;
    skos:exactMatch zz:Danyuyinre_instance ;
    zz:classMatch zz:Danyuyinre .

zzskos:Tunong a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "吐脓"@zh ;
    skos:definition "吐出脓液。肺痈之候。"@zh ;
    skos:hiddenLabel         "咳吐脓痰"@zh ;
    skos:note "金匮要略·肺痿肺痈咳嗽上气。"@zh ;
    skos:closeMatch zzskos:Tunongrumizhou,
        zzskos:Tunongxue ;
    skos:notation "Tunong_instance" ;
    skos:exactMatch zz:Tunong_instance ;
    zz:classMatch zz:Tunong .

zzskos:Tunongxue a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "吐脓血"@zh ;
    skos:definition "吐出脓血。肺痈溃脓之候。"@zh ;
    skos:hiddenLabel         "咳吐脓血"@zh ;
    skos:note "金匮要略·肺痿肺痈咳嗽上气：'咳而胸满，振寒脉数，咽干不渴，时出浊唾腥臭，久久吐脓如米粥者，为肺痈。'"@zh ;
    skos:closeMatch zzskos:Tunong,
        zzskos:Tunongrumizhou ;
    skos:notation "Tunongxue_instance" ;
    skos:exactMatch zz:Tunongxue_instance ;
    zz:classMatch zz:Tunongxue .

zzskos:Tuxian a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "吐涎"@zh ;
    skos:definition "口中涎液外吐。"@zh ;
    skos:hiddenLabel         "吐口水"@zh,
        "流口水"@zh ;
    skos:note "金匮要略·痰饮。"@zh ;
    skos:closeMatch zzskos:Shishituzhuo,
        zzskos:Tuhui,
        zzskos:Tuxianmo,
        zzskos:Tuxue,
        zzskos:Tuxuebuzhi,
        zzskos:Tuzhuo ;
    skos:notation "Tuxian_instance" ;
    skos:exactMatch zz:Tuxian_instance ;
    zz:classMatch zz:Tuxian .

zzskos:Tuxianmo a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "吐涎沫"@zh ;
    skos:definition "吐出清稀涎沫。肺痿或寒饮之候。"@zh ;
    skos:hiddenLabel         "吐白沫"@zh,
        "吐清稀口水"@zh ;
    skos:note "金匮要略·肺痿肺痈咳嗽上气：'肺痿吐涎沫而不咳者，其人不渴，必遗尿，小便数。'"@zh ;
    skos:broader zzskos:Outu ;
    skos:closeMatch zzskos:Shishituzhuo,
        zzskos:Tuhui,
        zzskos:Tuxian,
        zzskos:Tuxue,
        zzskos:Tuxuebuzhi,
        zzskos:Tuzhuo ;
    skos:notation "Tuxianmo_instance" ;
    skos:exactMatch zz:Tuxianmo_instance ;
    zz:classMatch zz:Tuxianmo .

zzskos:Tuzhuo a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "吐浊"@zh ;
    skos:definition "吐出浊痰。"@zh ;
    skos:hiddenLabel         "吐浊痰"@zh,
        "吐黏痰"@zh ;
    skos:note "金匮要略·肺痿肺痈咳嗽上气。"@zh ;
    skos:closeMatch zzskos:Shishituzhuo,
        zzskos:Tuhui,
        zzskos:Tuxian,
        zzskos:Tuxianmo,
        zzskos:Tuxue,
        zzskos:Tuxuebuzhi ;
    skos:notation "Tuzhuo_instance" ;
    skos:exactMatch zz:Tuzhuo_instance ;
    zz:classMatch zz:Tuzhuo .

zzskos:Tuxue a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "吐血"@zh ;
    skos:definition "血从口出。胃热或肝火犯胃，或脾不统血。"@zh ;
    skos:hiddenLabel         "呕血"@zh ;
    skos:note "金匮要略·惊悸吐衄下血胸满瘀血病：'吐血不止者，柏叶汤主之。'"@zh ;
    skos:closeMatch zzskos:Shishituzhuo,
        zzskos:Tuhui,
        zzskos:Tuxian,
        zzskos:Tuxianmo,
        zzskos:Tuxuebuzhi,
        zzskos:Tuzhuo ;
    skos:notation "Tuxue_instance" ;
    skos:exactMatch zz:Tuxue_instance ;
    zz:classMatch zz:Tuxue .

zzskos:Tuxuebuzhi a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "吐血不止"@zh ;
    skos:definition "吐血持续不止。"@zh ;
    skos:hiddenLabel         "吐血止不住"@zh,
        "一直吐血"@zh ;
    skos:note "金匮要略·惊悸吐衄下血胸满瘀血病。"@zh ;
    skos:closeMatch zzskos:Shishituzhuo,
        zzskos:Tuhui,
        zzskos:Tuxian,
        zzskos:Tuxianmo,
        zzskos:Tuxue,
        zzskos:Tuzhuo ;
    skos:notation "Tuxuebuzhi_instance" ;
    skos:exactMatch zz:Tuxuebuzhi_instance ;
    zz:classMatch zz:Tuxuebuzhi .

zzskos:Xiaoke a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "消渴"@zh ;
    skos:definition "口渴多饮而小便反多。津液耗伤、水不化气。"@zh ;
    skos:hiddenLabel         "多饮多尿"@zh,
        "喝水多尿多"@zh ;
    skos:note "金匮要略·消渴小便不利淋病：'男子消渴，小便反多，以饮一斗，小便一斗，肾气丸主之。'"@zh ;
    skos:closeMatch zzskos:Buke,
        zzskos:Buyuyin,
        zzskos:Dake,
        zzskos:Danyuyinre,
        zzskos:Fanbuke,
        zzskos:Kouke,
        zzskos:Yuyin ;
    skos:notation "Xiaoke_instance" ;
    skos:exactMatch zz:Xiaoke_instance ;
    zz:classMatch zz:Xiaoke .

zzskos:Shuiruzetu a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "水入则吐"@zh ;
    skos:definition "饮水即吐。水逆之候。"@zh ;
    skos:hiddenLabel         "一喝水就吐"@zh,
        "喝水就吐出来"@zh ;
    skos:note "伤寒论第74条：'渴欲饮水，水入则吐者，名曰水逆，五苓散主之。'"@zh ;
    skos:notation "Shuiruzetu_instance" ;
    skos:exactMatch zz:Shuiruzetu_instance ;
    zz:classMatch zz:Shuiruzetu .

zzskos:Tuhui a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "吐蛔"@zh ;
    skos:definition "吐出蛔虫。蛔厥之候。"@zh ;
    skos:altLabel         "吐蛔虫"@zh ;
    skos:hiddenLabel         "吐出虫子"@zh ;
    skos:note "伤寒论第338条：'蛔厥者，其人当吐蛔。'"@zh ;
    skos:closeMatch zzskos:Huichong,
        zzskos:Shishituzhuo,
        zzskos:Shizetuhui,
        zzskos:Tuxian,
        zzskos:Tuxianmo,
        zzskos:Tuxue,
        zzskos:Tuxuebuzhi,
        zzskos:Tuzhuo,
        zzskos:Xinzhongtengre ;
    skos:notation "Tuhui_instance" ;
    skos:exactMatch zz:Tuhui_instance ;
    zz:classMatch zz:Tuhui .

zzskos:Kouzhonghe a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "口中和"@zh ;
    skos:definition "口中和，不苦不干不渴。里无热之征。"@zh ;
    skos:hiddenLabel         "嘴里没味"@zh,
        "口不苦不干"@zh ;
    skos:note "伤寒论第304条：'少阴病，得之一二日，口中和，其背恶寒者……附子汤主之。'"@zh ;
    skos:notation "Kouzhonghe_instance" ;
    skos:exactMatch zz:Kouzhonghe_instance ;
    zz:classMatch zz:Kouzhonghe .

zzskos:Kouzao a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "口燥"@zh ;
    skos:definition "口中干燥。津液不足或热盛伤津。"@zh ;
    skos:altLabel         "口干"@zh ;
    skos:hiddenLabel         "嘴干"@zh,
        "口干舌燥"@zh ;
    skos:note "伤寒论第202条：'口燥，但欲漱水不欲咽。'"@zh ;
    skos:closeMatch zzskos:Chunkouganzao,
        zzskos:Duotuokouzao,
        zzskos:Kousheganzao,
        zzskos:Kouzhongpipizao,
        zzskos:Qianbanchizao ;
    skos:notation "Kouzao_instance" ;
    skos:exactMatch zz:Kouzao_instance ;
    zz:classMatch zz:Kouzao .

zzskos:Butu a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "不吐"@zh ;
    skos:definition "无呕吐。"@zh ;
    skos:hiddenLabel         "没有呕吐"@zh ;
    skos:notation "Butu_instance" ;
    skos:exactMatch zz:Butu_instance ;
    zz:classMatch zz:Butu .

zzskos:Outubuzhi a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "呕吐不止"@zh ;
    skos:definition "呕吐持续不止。"@zh ;
    skos:hiddenLabel         "吐个不停"@zh,
        "一直吐"@zh ;
    skos:note "金匮要略·呕吐哕下利病：'干呕吐逆，吐涎沫，半夏干姜散主之。'"@zh ;
    skos:notation "Outubuzhi_instance" ;
    skos:exactMatch zz:Outubuzhi_instance ;
    zz:classMatch zz:Outubuzhi .

zzskos:Koushanglanchi a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "口伤烂赤"@zh ;
    skos:definition "口腔溃烂红赤。"@zh ;
    skos:hiddenLabel         "口舌溃烂发红"@zh ;
    skos:note "伤寒论第334条。"@zh ;
    skos:notation "Koushanglanchi_instance" ;
    skos:exactMatch zz:Koushanglanchi_instance ;
    zz:classMatch zz:Koushanglanchi .

zzskos:Aigan a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "嗌干"@zh ;
    skos:definition "咽喉干燥。"@zh ;
    skos:hiddenLabel         "咽喉干"@zh,
        "嗓子干痛"@zh ;
    skos:note "伤寒论第320条：'少阴病，得之二三日，口燥咽干者，急下之。'"@zh ;
    skos:closeMatch zzskos:Kouku,
        zzskos:Yangan ;
    skos:notation "Aigan_instance" ;
    skos:exactMatch zz:Aigan_instance ;
    zz:classMatch zz:Aigan .

zzskos:Kouzhongpipizao a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "口中辟辟燥"@zh ;
    skos:definition "口中干燥特甚。"@zh ;
    skos:hiddenLabel         "嘴里干得厉害"@zh ;
    skos:note "金匮要略·肺痿肺痈咳嗽上气。"@zh ;
    skos:closeMatch zzskos:Chunkouganzao,
        zzskos:Duotuokouzao,
        zzskos:Kousheganzao,
        zzskos:Kouzao,
        zzskos:Qianbanchizao ;
    skos:notation "Kouzhongpipizao_instance" ;
    skos:exactMatch zz:Kouzhongpipizao_instance ;
    zz:classMatch zz:Kouzhongpipizao .

zzskos:Koukai a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "口开"@zh ;
    skos:definition "口开不合。中风脱证之危候。"@zh ;
    skos:hiddenLabel         "嘴张开合不上"@zh,
        "张口不合"@zh ;
    skos:note "金匮要略·中风历节病。"@zh ;
    skos:closeMatch zzskos:Danbibusui,
        zzskos:Koutuxian,
        zzskos:Maibuchuzhe,
        zzskos:Shejinanyan ;
    skos:notation "Koukai_instance" ;
    skos:exactMatch zz:Koukai_instance ;
    zz:classMatch zz:Koukai .

zzskos:Qianbanchizao a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "前板齿燥"@zh ;
    skos:definition "门齿干燥。阳明热盛津伤之候。"@zh ;
    skos:hiddenLabel         "门牙干燥"@zh,
        "前牙发干"@zh ;
    skos:note "伤寒论第6条：'若发汗已，身灼热者，名风温……以阴气为寒所迫，故前板齿燥。'"@zh ;
    skos:closeMatch zzskos:Chunkouganzao,
        zzskos:Duotuokouzao,
        zzskos:Kousheganzao,
        zzskos:Kouzao,
        zzskos:Kouzhongpipizao ;
    skos:notation "Qianbanchizao_instance" ;
    skos:exactMatch zz:Qianbanchizao_instance ;
    zz:classMatch zz:Qianbanchizao .

zzskos:Yanzhongshangshengchuang a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "咽中伤生疮"@zh ;
    skos:definition "咽喉损伤生疮。"@zh ;
    skos:hiddenLabel         "嗓子里生疮"@zh,
        "咽喉溃烂"@zh ;
    skos:note "伤寒论第312条：'少阴病，咽中伤，生疮，不能语言，声不出者，苦酒汤主之。'"@zh ;
    skos:notation "Yanzhongshangshengchuang_instance" ;
    skos:exactMatch zz:Yanzhongshangshengchuang_instance ;
    zz:classMatch zz:Yanzhongshangshengchuang .

zzskos:Shengbuchu a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "声不出"@zh ;
    skos:definition "声音不能发出。少阴咽伤或肺气不利。"@zh ;
    skos:altLabel         "失音"@zh ;
    skos:hiddenLabel         "说不出话"@zh,
        "嗓子哑了"@zh,
        "发不出声"@zh ;
    skos:note "伤寒论第312条。"@zh ;
    skos:narrower zzskos:Budeyu ;
    skos:closeMatch zzskos:Budeyu,
        zzskos:Shenghe ;
    skos:notation "Shengbuchu_instance" ;
    skos:exactMatch zz:Shengbuchu_instance ;
    zz:classMatch zz:Shengbuchu .

zzskos:Shenghe a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
