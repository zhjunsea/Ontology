zzskos:Shitong a skos:Concept ;
    skos:inScheme <http://www.tcm-classics.org/skos/zhengzhuang> ;
    skos:prefLabel "时痛"@zh ;
    skos:definition "腹部阵发性疼痛，时作时止。太阴病之候，桂枝加芍药汤证之特异性指征。"@zh ;
    skos:altLabel         "时时痛"@zh ;
    skos:hiddenLabel         "一阵一阵疼"@zh,
        "时不时疼"@zh,
        "有时疼"@zh,
        "疼一阵好一阵"@zh ;
    skos:note "伤寒论第279条：'本太阳病，医反下之，因尔腹满时痛者，属太阴也，桂枝加芍药汤主之；大实痛者，桂枝加大黄汤主之。'胡老：腹满时痛为太阴，属桂枝加芍药汤。"@zh ;
    skos:broader zzskos:Futong ;
    skos:closeMatch zzskos:Futong,
