		            </owl:intersectionOf>
		        </owl:Class>
		    </owl:equivalentClass>
		    <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Guizhigancaolonggumulitang"/></owl:Restriction></rdfs:subClassOf>
