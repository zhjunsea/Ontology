    <!-- ==================== 桂枝汤证 ==================== -->
    <owl:Class rdf:about="#Guizhitangzheng">
        <rdfs:label xml:lang="zh">桂枝汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <bagangAttr rdf:resource="#Biao"/>
    		<bagangAttr rdf:resource="#Yang"/>
    		<bagangAttr rdf:resource="#Xu"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Taiyangbing"/>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Hanchu"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Efeng"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_maixiang"/><owl:someValuesFrom rdf:resource="#Fuhuanmai"/></owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Fare"/>
        <possibleSymptom rdf:resource="#Ehan"/>
        <possibleSymptom rdf:resource="#Outu"/>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Guizhitang"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

    <!-- ==================== 麻黄汤证 ==================== -->
    <owl:Class rdf:about="#Mahuangtangzheng">
