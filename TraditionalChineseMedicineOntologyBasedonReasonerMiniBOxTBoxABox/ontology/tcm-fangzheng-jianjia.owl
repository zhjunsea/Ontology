    <!-- ==================== 兼夹证定义 ==================== -->
    <owl:Class rdf:about="#Yuxuezheng">
        <rdfs:label xml:lang="zh">瘀血证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#JianJiaZheng"/>
        <addHerb rdf:resource="#Danshen"/>
        <addHerb rdf:resource="#Taoren"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Citong"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_shexiang"/><owl:someValuesFrom rdf:resource="#BlueTongue"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_maixiang"/><owl:someValuesFrom rdf:resource="#Semai"/></owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Chunwei"/>
        <possibleSymptom rdf:resource="#Jifujiacuo"/>
        <possibleSymptom rdf:resource="#Danyushushuibuyuyan"/>
        <possibleSymptom rdf:resource="#Xiongman"/>
    </owl:Class>

    <owl:Class rdf:about="#Tanyinzheng">
        <rdfs:label xml:lang="zh">痰饮证</rdfs:label>
