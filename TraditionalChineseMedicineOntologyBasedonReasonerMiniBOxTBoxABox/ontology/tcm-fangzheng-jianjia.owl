        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Chaihuguizhitang"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

    <!-- ==================== 通脉四逆汤证 ==================== -->
    <owl:Class rdf:about="#Tongmaisinitangzheng">
		    <rdfs:label xml:lang="zh">通脉四逆汤证</rdfs:label>
		    <rdfs:subClassOf rdf:resource="#Fangzheng"/>
		    <owl:equivalentClass>
		        <owl:Class>
		            <owl:intersectionOf rdf:parseType="Collection">
		                <owl:Class rdf:about="#Shaoyinbing"/>
		                <!-- 核心：下利清谷（区别于一般下利） -->
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#Xialiqinggu"/>
		                </owl:Restriction>
		                <!-- 阳衰阴盛：脉类（微/沉微/沉细） -->
		                <owl:Class>
		                    <owl:unionOf rdf:parseType="Collection">
		                        <owl:Restriction><owl:onProperty rdf:resource="#you_maixiang"/><owl:someValuesFrom rdf:resource="#Weimai"/></owl:Restriction>
		                        <owl:Restriction><owl:onProperty rdf:resource="#you_maixiang"/><owl:someValuesFrom rdf:resource="#Chenweimai"/></owl:Restriction>
		                    </owl:unionOf>
		                </owl:Class>
		                <!-- 手足厥逆 -->
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#Shouzuleng"/>
		                </owl:Restriction>
		            </owl:intersectionOf>
		        </owl:Class>
		    </owl:equivalentClass>
		    <possibleSymptom rdf:resource="#Shenfanbuehan"/>   <!-- 身反不恶寒 -->
		    <possibleSymptom rdf:resource="#Miansechi"/>       <!-- 面色赤 -->
		    <possibleSymptom rdf:resource="#Futong"/>
		    <possibleSymptom rdf:resource="#Ganou"/>
		    <possibleSymptom rdf:resource="#Yantong"/>
		    <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Tongmaisinitang"/></owl:Restriction></rdfs:subClassOf>
		</owl:Class>

    <!-- ==================== 黄连阿胶汤证 ==================== -->
    <owl:Class rdf:about="#Huanglianejiaotangzheng">
        <rdfs:label xml:lang="zh">黄连阿胶汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <owl:equivalentClass>
            <owl:Class>
