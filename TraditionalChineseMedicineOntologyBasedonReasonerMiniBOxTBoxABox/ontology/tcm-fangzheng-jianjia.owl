    </owl:Class>

    <!-- ==================== 当归四逆汤证 ==================== -->
    <owl:Class rdf:about="#Dangguisinitangzheng">
        <rdfs:label xml:lang="zh">当归四逆汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <rdfs:comment xml:lang="zh">《伤寒论》351条：“手足厥寒，脉细欲绝者，当归四逆汤主之；若其人内有久寒者，宜当归四逆加吴茱萸生姜汤。”
原等价类仅 Jueyinbing ∩ ∃Shouzuleng ∩ ∃Ximai，条件过宽，会吞并一切厥阴病 + 手足冷 + 细脉的证候（含柴胡桂枝干姜汤证）。
现补入血虚寒厥征（Miansebai 面色白、Jifuburen 肌肤不仁、Yinxiashi 阴下湿），限定为血虚寒凝之厥。</rdfs:comment>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Jueyinbing"/>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Shouzuleng"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_maixiang"/><owl:someValuesFrom rdf:resource="#Ximai"/></owl:Restriction>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Miansebai"/></owl:Restriction>
                            <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Jifuburen"/></owl:Restriction>
                            <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Yinxiashi"/></owl:Restriction>
                        </owl:unionOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#NeiyouJiuhan"/>
        <possibleSymptom rdf:resource="#Futong"/>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Dangguisinitang"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>
    <!-- ==================== 吴茱萸汤证 ==================== -->
    <owl:Class rdf:about="#Wuzhuyutangzheng">
        <rdfs:label xml:lang="zh">吴茱萸汤证</rdfs:label>
