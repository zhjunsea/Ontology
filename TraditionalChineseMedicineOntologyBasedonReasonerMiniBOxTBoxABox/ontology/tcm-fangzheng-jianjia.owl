    <!-- ==================== 柏叶汤证 ==================== -->
    <owl:Class rdf:about="#Baiyetangzheng">
		    <rdfs:label xml:lang="zh">柏叶汤证</rdfs:label>
		    <rdfs:subClassOf rdf:resource="#Fangzheng"/>
		    <owl:equivalentClass>
		        <owl:Class>
		            <owl:intersectionOf rdf:parseType="Collection">
		                <!-- 必具：吐血（不止） -->
		                <owl:Class>
		                    <owl:unionOf rdf:parseType="Collection">
		                        <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Tuxue"/></owl:Restriction>
		                        <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Tuxuebuzhi"/></owl:Restriction>
		                    </owl:unionOf>
		                </owl:Class>
		                <!-- 虚寒底子：脉微弱 / 面色萎黄 -->
		                <owl:Class>
		                    <owl:unionOf rdf:parseType="Collection">
		                        <owl:Restriction><owl:onProperty rdf:resource="#you_maixiang"/><owl:someValuesFrom rdf:resource="#Weiruomai"/></owl:Restriction>
		                        <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Mianseweihuang"/></owl:Restriction>
		                    </owl:unionOf>
		                </owl:Class>
		            </owl:intersectionOf>
		        </owl:Class>
		    </owl:equivalentClass>
		    <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Baiyetang"/></owl:Restriction></rdfs:subClassOf>
		</owl:Class>
    <!-- ==================== 橘皮竹茹汤证 ==================== -->
    <owl:Class rdf:about="#Jupizhuratangzheng">
        <rdfs:label xml:lang="zh">橘皮竹茹汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <rdfs:comment xml:lang="zh">《金匮要略·呕吐哕下利病脉证治第十七》：“哕逆者，橘皮竹茹汤主之。”
原等价类仅 ∃E，一切哕证被误纳。现补入少气、虚脉，限定为胃虚有热之哕逆。</rdfs:comment>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                        <owl:someValuesFrom rdf:resource="#E"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                        <owl:someValuesFrom rdf:resource="#Shaoqi"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_maixiang"/>
                        <owl:someValuesFrom rdf:resource="#Xumai"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#you_chufang"/>
                <owl:hasValue rdf:resource="#Jupizhuratang"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

