    <!-- ==================== 四逆加人参汤证 ==================== -->
    <owl:Class rdf:about="#Sinijiarenshentangzheng">
		    <rdfs:label xml:lang="zh">四逆加人参汤证</rdfs:label>
		    <rdfs:subClassOf rdf:resource="#Fangzheng"/>
		    <owl:equivalentClass>
		        <owl:Class>
		            <owl:intersectionOf rdf:parseType="Collection">
		                <!-- 底子：少阴/太阴/厥阴 -->
		                <owl:Class>
		                    <owl:unionOf rdf:parseType="Collection">
		                        <owl:Class rdf:about="#Shaoyinbing"/>
		                        <owl:Class rdf:about="#Taiyinbing"/>
		                        <owl:Class rdf:about="#Jueyinbing"/>
		                    </owl:unionOf>
		                </owl:Class>
		                <!-- 恶寒 -->
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#Ehan"/>
		                </owl:Restriction>
		                <!-- 脉微 -->
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_maixiang"/>
		                    <owl:someValuesFrom rdf:resource="#Weimai"/>
		                </owl:Restriction>
		                <!-- 下利 -->
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#Xiali"/>
		                </owl:Restriction>
		                <!-- 关键：利止 或 亡血 -->
		                <owl:Class>
		                    <owl:unionOf rdf:parseType="Collection">
		                        <owl:Restriction>
		                            <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                            <owl:someValuesFrom rdf:resource="#Lizhi"/>  <!-- 利止 -->
		                        </owl:Restriction>
		                        <owl:Restriction>
		                            <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                            <owl:someValuesFrom rdf:resource="#Wangxue"/>  <!-- 亡血 -->
		                        </owl:Restriction>
		                    </owl:unionOf>
		                </owl:Class>
		            </owl:intersectionOf>
		        </owl:Class>
		    </owl:equivalentClass>
		    <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Sinijiarenshentang"/></owl:Restriction></rdfs:subClassOf>
		</owl:Class>

