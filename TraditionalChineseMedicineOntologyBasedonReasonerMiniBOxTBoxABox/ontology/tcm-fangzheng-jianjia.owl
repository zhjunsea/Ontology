    <!-- ==================== 瓜蒌牡蛎散证 ==================== -->
    <owl:Class rdf:about="#Gualoumulisanzheng">
        <rdfs:label xml:lang="zh">瓜蒌牡蛎散证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <rdfs:comment xml:lang="zh">《金匮要略·百合狐惑阴阳毒病脉证治第三》：“百合病，渴不差者，栝楼牡蛎散主之。”
原等价类仅 ∃Kouke，导致阳明病等一切口渴证候被误纳为本证之母类。
现补入百合病核心症状口苦、小便赤，限定为“百合病渴不差者”。</rdfs:comment>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                        <owl:someValuesFrom rdf:resource="#Kouke"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                        <owl:someValuesFrom rdf:resource="#Kouku"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                        <owl:someValuesFrom rdf:resource="#Xiaobianchi"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Weimai"/>
        <possibleSymptom rdf:resource="#Shumai"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#you_chufang"/>
                <owl:hasValue rdf:resource="#Gualoumulisan"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <!-- ==================== 百合滑石散证 ==================== -->
    <owl:Class rdf:about="#Baihehuashisanzheng">
        <rdfs:label xml:lang="zh">百合滑石散证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <rdfs:comment xml:lang="zh">《金匮要略·百合狐惑阴阳毒病脉证治第三》：“百合病，变发热者，百合滑石散主之。”
原等价类仅 ∃Fare，导致一切发热证候（含 Taiyangbing）被误纳为本证之母类。
现补入百合病核心症状口苦（Kouku）、小便赤（Xiaobianchi），限定为“百合病变发热者”。</rdfs:comment>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                        <owl:someValuesFrom rdf:resource="#Fare"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                        <owl:someValuesFrom rdf:resource="#Kouku"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                        <owl:someValuesFrom rdf:resource="#Xiaobianchi"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Weimai"/>
        <possibleSymptom rdf:resource="#Shumai"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#you_chufang"/>
                <owl:hasValue rdf:resource="#Baihehuashisan"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

