    <!-- ==================== 大承气汤证 ==================== -->
    <owl:Class rdf:about="#Dachengqitangzheng">
        <rdfs:label xml:lang="zh">大承气汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <bagangAttr rdf:resource="#Li"/>
    		<bagangAttr rdf:resource="#Yang"/>
    		<bagangAttr rdf:resource="#Shi"/>
    		<bagangAttr rdf:resource="#Re"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Yangmingbing"/>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Chaore"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Dabianying"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Zhanyu"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_fuzheng"/><owl:someValuesFrom rdf:resource="#Fuman"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_fuzheng"/><owl:someValuesFrom rdf:resource="#Futong"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_maixiang"/><owl:someValuesFrom rdf:resource="#Chenshimai"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_shexiang"/><owl:someValuesFrom rdf:resource="#YellowCoating"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_shexiang"/><owl:someValuesFrom rdf:resource="#DryCoating"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_shexiang"/><owl:someValuesFrom rdf:resource="#TongueWithThorns"/></owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Danrebuhan"/>
        <possibleSymptom rdf:resource="#Kouke"/>
        <possibleSymptom rdf:resource="#Fanzao"/>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Dachengqitang"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="#Xiaochaihutangzheng">
		    <rdfs:label xml:lang="zh">小柴胡汤证</rdfs:label>
		    <rdfs:subClassOf rdf:resource="#Fangzheng"/>
		    <!-- ⭐ 不再手工挂 #Shaoyangbing。推理器会从等价类自动推出。 -->
		    <rdfs:comment xml:lang="zh">少阳病主方。少阳病 ≡ 半表半里 ∩ 阳证。
		四大主证（往来寒热、胸胁苦满、嘿嘿、心烦）但见一证便是，不必悉具（《伤寒论》101条）。
		脉弦为少阳抓手，作为硬条件。
		或然证（口苦、咽干、目眩、不欲食、喜呕等）不入等价类。</rdfs:comment>
		
		    <owl:equivalentClass>
		        <owl:Class>
		            <owl:intersectionOf rdf:parseType="Collection">
		                <!-- ⭐ 直接写八纲，推理器会推出 Shaoyangbing -->
		                <owl:Class rdf:about="#BanbiaoBanli"/>
		                <owl:Class rdf:about="#Yang"/>
		
		                <!-- 四大主证：但见一证便是 -->
		                <owl:Class>
		                    <owl:unionOf rdf:parseType="Collection">
		                        <owl:Restriction>
		                            <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                            <owl:someValuesFrom rdf:resource="#Wanglaihanre"/>
		                        </owl:Restriction>
		                        <owl:Restriction>
		                            <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                            <owl:someValuesFrom rdf:resource="#Xiongxiekuman"/>
		                        </owl:Restriction>
		                        <owl:Restriction>
		                            <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                            <owl:someValuesFrom rdf:resource="#Momo"/>
		                        </owl:Restriction>
		                        <owl:Restriction>
		                            <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                            <owl:someValuesFrom rdf:resource="#Xinfan"/>
		                        </owl:Restriction>
		                    </owl:unionOf>
		                </owl:Class>
		
		                <!-- 脉弦 -->
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_maixiang"/>
		                    <owl:someValuesFrom rdf:resource="#Xianmai"/>
		                </owl:Restriction>
		            </owl:intersectionOf>
		        </owl:Class>
		    </owl:equivalentClass>
		
		    <!-- 或然证 -->
		    <possibleSymptom rdf:resource="#Kouku"/>
		    <possibleSymptom rdf:resource="#Yangan"/>
		    <possibleSymptom rdf:resource="#Muxuan"/>
		    <possibleSymptom rdf:resource="#Buyushi"/>
		    <possibleSymptom rdf:resource="#Xiou"/>
		    <possibleSymptom rdf:resource="#Xiongzhongfan"/>
		    <possibleSymptom rdf:resource="#Kouke"/>
		    <possibleSymptom rdf:resource="#Fuzhongjitong"/>
		    <possibleSymptom rdf:resource="#Xiexiapiying"/>
		    <possibleSymptom rdf:resource="#Xinji"/>
		    <possibleSymptom rdf:resource="#Xiaobianbuli"/>
		    <possibleSymptom rdf:resource="#Weire"/>
		    <possibleSymptom rdf:resource="#Kesou"/>
		
		    <rdfs:subClassOf>
		        <owl:Restriction>
		            <owl:onProperty rdf:resource="#you_chufang"/>
		            <owl:hasValue rdf:resource="#Xiaochaihutang"/>
		        </owl:Restriction>
		    </rdfs:subClassOf>
		</owl:Class>

    <!-- ==================== 大柴胡汤证 ==================== -->
		<owl:Class rdf:about="#Dachaihutangzheng">
		    <rdfs:label xml:lang="zh">大柴胡汤证</rdfs:label>
		    <rdfs:subClassOf rdf:resource="#Fangzheng"/>
		    <rdfs:comment xml:lang="zh">《伤寒论》103条："呕不止，心下急，郁郁微烦者，为未解也，与大柴胡汤下之则愈。"
		《金匮要略·腹满寒疝宿食病》："按之心下满痛者，此为实也，当下之，宜大柴胡汤。"
		
		少阳阳明合病。主证：往来寒热、胸胁苦满（少阳）+ 心下急、呕不止、郁郁微烦、大便硬、按之心下满痛（阳明）。
		
		注：原文作"呕不止"。本体上"呕不止"应视为"呕"的子类（程度强调），
		但为了避免 Ou 与 Outubuzhi 之间子类关系触发分类爆炸，
		这里用 union 表达等价类。医学含义等价。</rdfs:comment>
		
		    <owl:equivalentClass>
		        <owl:Class>
		            <owl:intersectionOf rdf:parseType="Collection">
		                <owl:Class rdf:about="#Shaoyangbing"/>
		                <owl:Class rdf:about="#Yangmingbing"/>
		
		                <!-- 心下急（阳明腹证） -->
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#Xinxiaji"/>
		                </owl:Restriction>
		
		                <!-- 呕或呕不止任一（原文"呕不止"） -->
		                <owl:Class>
		                    <owl:unionOf rdf:parseType="Collection">
		                        <owl:Restriction>
		                            <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                            <owl:someValuesFrom rdf:resource="#Ou"/>
		                        </owl:Restriction>
		                        <owl:Restriction>
		                            <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                            <owl:someValuesFrom rdf:resource="#Outubuzhi"/>
		                        </owl:Restriction>
		                    </owl:unionOf>
		                </owl:Class>
		
		                <!-- 郁郁微烦（阳明里热） -->
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#Yuyuweifan"/>
		                </owl:Restriction>
		
		                <!-- 大便硬（阳明里实） -->
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#Dabianying"/>
		                </owl:Restriction>
		
		                <!-- 按之心下满痛（金匮腹证） -->
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_fuzheng"/>
		                    <owl:someValuesFrom rdf:resource="#Xinxianzhimantong"/>
		                </owl:Restriction>
		
		                <!-- 脉弦 -->
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_maixiang"/>
		                    <owl:someValuesFrom rdf:resource="#Xianmai"/>
		                </owl:Restriction>
		            </owl:intersectionOf>
		        </owl:Class>
		    </owl:equivalentClass>
		
		    <possibleSymptom rdf:resource="#Wanglaihanre"/>
		    <possibleSymptom rdf:resource="#Xiongxiekuman"/>
		    <possibleSymptom rdf:resource="#Kouku"/>
		    <possibleSymptom rdf:resource="#Xiali"/>
		
		    <rdfs:subClassOf>
		        <owl:Restriction>
		            <owl:onProperty rdf:resource="#you_chufang"/>
		            <owl:hasValue rdf:resource="#Dachaihutang"/>
		        </owl:Restriction>
		    </rdfs:subClassOf>
		</owl:Class>

    <!-- ==================== 理中汤证 ==================== -->
    <owl:Class rdf:about="#Lizhongtangzheng">
        <rdfs:label xml:lang="zh">理中汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <rdfs:comment xml:lang="zh">《金匮要略·胸痹心痛短气病》：“胸痹心中痞，留气结在胸，胸满，胁下逆抢心，枳实薤白桂枝汤主之；人参汤亦主之。”人参汤即理中汤，胸痹用人参汤为本方证之或然应用。</rdfs:comment>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Taiyinbing"/>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Fuman"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Outu"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Shibuxia"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xiali"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Shifuzitong"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Buke"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_maixiang"/><owl:someValuesFrom rdf:resource="#Chenruomai"/></owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Shouzuleng"/>
        <possibleSymptom rdf:resource="#Xiongbi"/>
        <possibleSymptom rdf:resource="#Xinzhongpi"/>
        <possibleSymptom rdf:resource="#Xiongman"/>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Lizhongtang"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

    <!-- ==================== 四逆汤证 ==================== -->
    <owl:Class rdf:about="#Sinitangzheng">
		    <rdfs:label xml:lang="zh">四逆汤证</rdfs:label>
		    <rdfs:subClassOf rdf:resource="#Fangzheng"/>
		
		    <!-- 八纲归属：单向声明，供下游读取 -->
		    <bagangAttr rdf:resource="#Li"/>
		    <bagangAttr rdf:resource="#Yin"/>
		    <bagangAttr rdf:resource="#Xu"/>
		
		    <!-- 方证识别条件：仅症状/脉象组合 -->
		    <owl:equivalentClass>
		        <owl:Class>
		            <owl:intersectionOf rdf:parseType="Collection">
		                <owl:Class rdf:about="#Fangzheng"/>   <!-- 或省略，让它通过 subClassOf 判定 -->
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#Xialiqinggu"/>
		                </owl:Restriction>
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#Shouzuleng"/>
		                </owl:Restriction>
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_maixiang"/>
		                    <owl:someValuesFrom rdf:resource="#Chenweimai"/>
		                </owl:Restriction>
		            </owl:intersectionOf>
		        </owl:Class>
		    </owl:equivalentClass>
		
		    <!-- 或然症 -->
		    <possibleSymptom rdf:resource="#Fuman"/>
		    <possibleSymptom rdf:resource="#Outu"/>
		    <possibleSymptom rdf:resource="#Shibuxia"/>
		    <possibleSymptom rdf:resource="#Xiali"/>
		    <possibleSymptom rdf:resource="#Danyumei"/>
		
		    <!-- 处方 -->
		    <rdfs:subClassOf>
		        <owl:Restriction>
		            <owl:onProperty rdf:resource="#you_chufang"/>
		            <owl:hasValue rdf:resource="#Sinitang"/>
		        </owl:Restriction>
		    </rdfs:subClassOf>
		</owl:Class>

    <!-- ==================== 麻黄附子细辛汤证 ==================== -->
    <owl:Class rdf:about="#Mahuangfuzixixintangzheng">
        <rdfs:label xml:lang="zh">麻黄附子细辛汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Shaoyinbing"/>
                    <owl:Class rdf:about="#Biao"/>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Fare"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Ehan"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Wuhan"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Danyumei"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_maixiang"/><owl:someValuesFrom rdf:resource="#Chenmai"/></owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Weiximai"/>
        <possibleSymptom rdf:resource="#Shouzuleng"/>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Mahuangfuzixixintang"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

    <!-- ==================== 真武汤证 ==================== -->
    <owl:Class rdf:about="#Zhenwutangzheng">
		    <rdfs:label xml:lang="zh">真武汤证</rdfs:label>
		    <rdfs:subClassOf rdf:resource="#Fangzheng"/>
		    <owl:equivalentClass>
		        <owl:Class>
		            <owl:intersectionOf rdf:parseType="Collection">
		                <!-- 底子：少阴（316条）/太阳误汗（82条） -->
		                <owl:Class>
		                    <owl:unionOf rdf:parseType="Collection">
		                        <owl:Class rdf:about="#Shaoyinbing"/>
		                        <owl:Class rdf:about="#Taiyangbing"/>
		                    </owl:unionOf>
		                </owl:Class>
		                <!-- 必具：小便不利 -->
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#Xiaobianbuli"/>
		                </owl:Restriction>
		                <!-- 有水气：以下任一组证据 -->
		                <owl:Class>
		                    <owl:unionOf rdf:parseType="Collection">
		                        <!-- 316条：腹痛+四肢沉重疼痛+下利 -->
		                        <owl:Class>
		                            <owl:intersectionOf rdf:parseType="Collection">
		                                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Futong"/></owl:Restriction>
		                                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Sizhichenzhongtengtong"/></owl:Restriction>
		                            </owl:intersectionOf>
		                        </owl:Class>
		                        <!-- 316条：下利 -->
		                        <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xiali"/></owl:Restriction>
		                        <!-- 82条：心下悸+头眩+身瞤动 -->
		                        <owl:Class>
		                            <owl:intersectionOf rdf:parseType="Collection">
		                                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xinxiajidong"/></owl:Restriction>
		                                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Touxuan"/></owl:Restriction>
		                            </owl:intersectionOf>
		                        </owl:Class>
		                    </owl:unionOf>
		                </owl:Class>
		            </owl:intersectionOf>
		        </owl:Class>
		    </owl:equivalentClass>
		    <possibleSymptom rdf:resource="#Shenshundong"/>  <!-- 身瞤动 -->
		    <possibleSymptom rdf:resource="#Ou"/>            <!-- 或呕 -->
		    <possibleSymptom rdf:resource="#Kesou"/>         <!-- 或咳 -->
		    <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Zhenwutang"/></owl:Restriction></rdfs:subClassOf>
		</owl:Class>

    <!-- ==================== 乌梅丸证 ==================== -->
    <owl:Class rdf:about="#Wumeiwanzheng">
		    <rdfs:label xml:lang="zh">乌梅丸证</rdfs:label>
		    <rdfs:subClassOf rdf:resource="#Fangzheng"/>
		    <owl:equivalentClass>
		        <owl:Class>
		            <owl:intersectionOf rdf:parseType="Collection">
		                <owl:Class rdf:about="#Jueyinbing"/>
		                <!-- 上热：消渴 / 心中疼热 / 气上撞心 -->
		                <owl:Class>
		                    <owl:unionOf rdf:parseType="Collection">
		                        <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xiaoke"/></owl:Restriction>
		                        <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xinzhongtengre"/></owl:Restriction>
		                        <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Qishangchongxiong"/></owl:Restriction>
		                    </owl:unionOf>
		                </owl:Class>
		                <!-- 中焦：饥不欲食 -->
		                <owl:Class>
		                    <owl:intersectionOf rdf:parseType="Collection">
		                        <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Ji"/></owl:Restriction>
		                        <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Buyushi"/></owl:Restriction>
		                    </owl:intersectionOf>
		                </owl:Class>
		                <!-- 蛔厥 / 久利：任一组 -->
		                <owl:Class>
		                    <owl:unionOf rdf:parseType="Collection">
		                        <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Shizetuhui"/></owl:Restriction>
		                        <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Tuhui"/></owl:Restriction>
		                        <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Jiuli"/></owl:Restriction>  <!-- 久利 -->
		                    </owl:unionOf>
		                </owl:Class>
		            </owl:intersectionOf>
		        </owl:Class>
		    </owl:equivalentClass>
		    <possibleSymptom rdf:resource="#Kouku"/>
		    <possibleSymptom rdf:resource="#Shouzuleng"/>
		    <possibleSymptom rdf:resource="#Weiximai"/>
		    <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Wumeiwan"/></owl:Restriction></rdfs:subClassOf>
		</owl:Class>

    <!-- ==================== 柴胡桂枝干姜汤证 ==================== -->
    <owl:Class rdf:about="#Chaihuguizhiganjiangtangzheng">
        <rdfs:label xml:lang="zh">柴胡桂枝干姜汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <!-- 刘渡舟：少阳病偏太阴机转，胆热脾寒。
     		胡希恕-冯世纶另有厥阴病说，此处采用刘渡舟定性。 -->
				<sixChannelAttr rdf:resource="#Shaoyangbing"/>
				<sixChannelAttr rdf:resource="#Taiyinbing"/>
        <rdfs:comment xml:lang="zh">《伤寒论》147条：“伤寒五六日，已发汗而复下之，胸胁满微结，小便不利，渴而不呕，但头汗出，往来寒热，心烦者，此表未解也，柴胡桂枝干姜汤主之。”
胡希恕认为本方证属少阳太阴合病，为小柴胡汤与理中汤合方之意，治胆热脾寒、上热下寒。
原定义引用 Shaoyangbing ∩ Taiyinbing，但 Shaoyangbing 需 Yang、Taiyinbing 需 Li∩Yin，
当患者因脉微细被判为阴证时，Shaoyangbing 不成立，导致漏诊。
现改为直接用 BanbiaoBanli + 症状，符合胡老“柴胡证 + 脾寒”的本意。</rdfs:comment>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#BanbiaoBanli"/>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Wanglaihanre"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xiongxiekuman"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xiaobianbuli"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Kouke"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Dantouhanchu"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xinfan"/></owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Shouzuleng"/>
        <possibleSymptom rdf:resource="#Weiximai"/>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Chaihuguizhiganjiangtang"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>
    <!-- ==================== 桂枝茯苓丸证 ==================== -->
    <owl:Class rdf:about="#Guizhifulingwanzheng">
        <rdfs:label xml:lang="zh">桂枝茯苓丸证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Yuxuezheng"/>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Louxia"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Shaofuzhengjia"/></owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Guizhifulingwan"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

    <!-- ==================== 小青龙汤证 ==================== -->
    <owl:Class rdf:about="#Xiaoqinglongtangzheng">
        <rdfs:label xml:lang="zh">小青龙汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Tanyinzheng"/>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Kesou"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Tanduo"/></owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Ehan"/>
        <possibleSymptom rdf:resource="#Wuhan"/>
        <possibleSymptom rdf:resource="#Chuan"/>
        <possibleSymptom rdf:resource="#Ganou"/>
        <possibleSymptom rdf:resource="#Fare"/>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Xiaoqinglongtang"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

    <!-- ==================== 四逆散证 ==================== -->
    <owl:Class rdf:about="#Sinisanzheng">
        <rdfs:label xml:lang="zh">四逆散证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Qiyuzheng"/>
