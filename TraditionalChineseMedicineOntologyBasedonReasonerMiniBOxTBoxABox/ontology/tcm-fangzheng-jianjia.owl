    <!-- ==================== 头风摩散证 ==================== -->
		<owl:Class rdf:about="#Toufengmosanzheng">
		    <rdfs:label xml:lang="zh">头风摩散证</rdfs:label>
		    <rdfs:subClassOf rdf:resource="#Fangzheng"/>
		    <rdfs:comment xml:lang="zh">《金匮要略·中风历节病》附方。原等价类仅 Taiyangbing ∩ ∃Toutong，太阳病本身即含头痛，等同虚设。现补入 Tounaotong（头风性头痛），限定为外风入脑之头风。</rdfs:comment>
		    <owl:equivalentClass>
		        <owl:Class>
		            <owl:intersectionOf rdf:parseType="Collection">
		                <owl:Class rdf:about="#Taiyangbing"/>
		                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Toutong"/></owl:Restriction>
		                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Efeng"/></owl:Restriction>
		            </owl:intersectionOf>
		        </owl:Class>
		    </owl:equivalentClass>
		    <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Tianwutouchishimisan"/></owl:Restriction></rdfs:subClassOf>
		</owl:Class>
    <!-- ==================== 下瘀血汤证 ==================== -->
		<owl:Class rdf:about="#Xiayuxuetangzheng">
		    <rdfs:label xml:lang="zh">下瘀血汤证</rdfs:label>
		    <rdfs:subClassOf rdf:resource="#Fangzheng"/>
		    <rdfs:comment xml:lang="zh">《金匮要略·妇人产后病》：“产妇腹痛……此为腹中有干血着脐下，宜下瘀血汤主之。”原等价类仅 Taiyangbing ∩ ∃Futong，完全未抓住病机。现限定为产后腹痛 + 瘀血征。</rdfs:comment>
		    <owl:equivalentClass>
		        <owl:Class>
		            <owl:intersectionOf rdf:parseType="Collection">
		                <owl:Class rdf:about="#ChanhouFutong"/>
		                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Shaofujijie"/></owl:Restriction>
		                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Citong"/></owl:Restriction>
		            </owl:intersectionOf>
		        </owl:Class>
		    </owl:equivalentClass>
		    <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Xiayuxuetang"/></owl:Restriction></rdfs:subClassOf>
		</owl:Class>
