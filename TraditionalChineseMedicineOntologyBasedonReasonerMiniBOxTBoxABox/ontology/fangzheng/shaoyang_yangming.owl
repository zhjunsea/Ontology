<?xml version='1.0' encoding='UTF-8'?>
<rdf:RDF xmlns="http://www.tcm-classics.org/jingfang#" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:base="http://www.tcm-classics.org/jingfang#">

    <owl:Ontology rdf:about="http://www.tcm-classics.org/jingfang/shaoyang_yangming">
        <rdfs:label xml:lang="zh">少阳阳明系统（柴胡+大黄+石膏+栀子豉+泻心）</rdfs:label>
        <rdfs:comment xml:lang="zh">含柴胡汤类、白虎汤类、承气汤类、栀子豉汤类、泻心汤类五大家族，共 49 方证。本文件不再重复声明 clinicalPriority、bagangAttr、addHerb，这些属性声明见 rules.owl。rules.owl 中原有的 clinicalPriority 与 bagangAttr 补充值已合并到本文件各具体类中。</rdfs:comment>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/core"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/zhengzhuang"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/maixiang"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/shexiang"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/fangji"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/yaowu"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/fanggen"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/rules"/>
    </owl:Ontology>

    <!-- ============================================================ -->
    <!-- 一、柴胡汤类家族                                              -->
    <!-- ============================================================ -->
    <owl:Class rdf:about="#Xiaochaihutangleifangzheng">
        <rdfs:label xml:lang="zh">柴胡汤类方证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Jiazu"/>
        <hasFanggen rdf:resource="#Chaihugen"/>
        <isAbstract rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isAbstract>
        <rdfs:comment xml:lang="zh">母方：小柴胡汤。共性（注释）：半表半里，口苦咽干目眩，胸胁苦满，往来寒热，但见一证便是。跨经最典型之家族。</rdfs:comment>
    </owl:Class>

    <!-- 小柴胡汤证 -->
    <owl:Class rdf:about="#Xiaochaihutangzheng">
        <rdfs:label xml:lang="zh">小柴胡汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Xiaochaihutangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Shaoyangbing"/>
        <differentialAxis xml:lang="zh">但见一证便是（96、101、263条）；无心下急</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
        <bagangAttr rdf:resource="#Banbiaobanli"/>
        <bagangAttr rdf:resource="#Yang"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection"><owl:Class rdf:about="#Shaoyangbing"/><owl:Class><owl:unionOf rdf:parseType="Collection">
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Wanglaihanre"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xiongxiekuman"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Momo"/></owl:Restriction>
				<owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Buyushi"/></owl:Restriction>
                <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xinfan"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xiou"/></owl:Restriction>
                </owl:intersectionOf></owl:Class>
                <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Kouku"/></owl:Restriction>
                    <owl:Class><owl:unionOf rdf:parseType="Collection">
                        <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Yangan"/></owl:Restriction>
                        <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Muxuan"/></owl:Restriction>
                    </owl:unionOf></owl:Class>
                </owl:intersectionOf></owl:Class>
            </owl:unionOf></owl:Class></owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Xianmai"/>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Xiaochaihutang"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

    <!-- 大柴胡汤证 -->
    <owl:Class rdf:about="#Dachaihutangzheng">
        <rdfs:label xml:lang="zh">大柴胡汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Xiaochaihutangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#ShaoyangYangmingHebing"/>
        <differentialAxis xml:lang="zh">心下急+郁郁微烦+里实（103、165条）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</clinicalPriority>
        <bagangAttr rdf:resource="#Banbiaobanli"/>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yang"/>
        <bagangAttr rdf:resource="#Shi"/>
        <bagangAttr rdf:resource="#Re"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                <owl:Class rdf:about="#ShaoyangYangmingHebing"/><owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xinxiaji"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Yuyuweifan"/></owl:Restriction>
                <owl:Class><owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Dabianying"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xiali"/></owl:Restriction>
                </owl:unionOf></owl:Class>
            </owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Dachaihutang"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

    <!-- 柴胡加芒硝汤证 -->
    <owl:Class rdf:about="#Chaihujiamangxiaotangzheng">
        <rdfs:label xml:lang="zh">柴胡加芒硝汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Xiaochaihutangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#ShaoyangYangmingHebing"/>
        <differentialAxis xml:lang="zh">呕+潮热（104条）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
        <bagangAttr rdf:resource="#Banbiaobanli"/>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yang"/>
        <bagangAttr rdf:resource="#Shi"/>
        <bagangAttr rdf:resource="#Re"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                <owl:Class rdf:about="#ShaoyangYangmingHebing"/><owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Ou"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Chaore"/></owl:Restriction>
            </owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Chaihujiamangxiaotang"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

    <!-- 柴胡加龙骨牡蛎汤证 -->
    <owl:Class rdf:about="#Chaihujialonggumulitangzheng">
        <rdfs:label xml:lang="zh">柴胡加龙骨牡蛎汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Xiaochaihutangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#ShaoyangYangmingHebing"/>
        <differentialAxis xml:lang="zh">胸满+烦惊+小便不利+谵语（107条）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</clinicalPriority>
        <bagangAttr rdf:resource="#Banbiaobanli"/>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yang"/>
        <bagangAttr rdf:resource="#Shi"/>
        <bagangAttr rdf:resource="#Re"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                <owl:Class rdf:about="#ShaoyangYangmingHebing"/><owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xiongman"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Fanzao"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xiaobianbuli"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Zhanyu"/></owl:Restriction>
            </owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Chaihujialonggumulitang"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

    <!-- 柴胡桂枝干姜汤证 -->
    <owl:Class rdf:about="#Chaihuguizhiganjiangtangzheng">
        <rdfs:label xml:lang="zh">柴胡桂枝干姜汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Xiaochaihutangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#ShaoyangTaiyinHebing"/>
        <differentialAxis xml:lang="zh">小便不利+口渴+但头汗出（147条）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
        <bagangAttr rdf:resource="#Banbiaobanli"/>
        <bagangAttr rdf:resource="#Yin"/>
        <bagangAttr rdf:resource="#Xu"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                <owl:Class rdf:about="#ShaoyangTaiyinHebing"/><owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xiaobianbuli"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Kouke"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Dantouhanchu"/></owl:Restriction>
            </owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Chaihuguizhiganjiangtang"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

    <!-- 柴胡去半夏加栝楼汤证 -->
    <owl:Class rdf:about="#Chaihuqubanxiajiagualoutangzheng">
        <rdfs:label xml:lang="zh">柴胡去半夏加栝楼汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Xiaochaihutangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Shaoyangbing"/>
        <differentialAxis xml:lang="zh">疟病发渴（金匮疟病）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
        <bagangAttr rdf:resource="#Banbiaobanli"/>
        <bagangAttr rdf:resource="#Yang"/>
        <bagangAttr rdf:resource="#Shi"/>
        <bagangAttr rdf:resource="#Re"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                <owl:Class rdf:about="#Shaoyangbing"/><owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Kouke"/></owl:Restriction>
                <owl:Class><owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Ruzhuang"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Fazehanre"/></owl:Restriction>
                </owl:unionOf></owl:Class>
            </owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Chaihuqubanxiajiagualoutang"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

    <!-- ============================================================ -->
    <!-- 二、白虎汤类家族                                              -->
    <!-- ============================================================ -->
    <owl:Class rdf:about="#Baihutangleifangzheng">
        <rdfs:label xml:lang="zh">白虎汤类方证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Jiazu"/>
        <hasFanggen rdf:resource="#Shigaogen"/>
        <hasFanggen rdf:resource="#Shigaozhimugen"/>
        <isAbstract rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isAbstract>
        <rdfs:comment xml:lang="zh">母方：白虎汤。共性（注释）：阳明里热，大热大渴大汗，脉洪大滑数。</rdfs:comment>
    </owl:Class>

    <!-- 白虎汤证 -->
    <owl:Class rdf:about="#Baihutangzheng">
        <rdfs:label xml:lang="zh">白虎汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Baihutangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Yangmingbing"/>
        <differentialAxis xml:lang="zh">大热大汗大渴+脉洪（176、219条）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</clinicalPriority>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yang"/>
        <bagangAttr rdf:resource="#Shi"/>
        <bagangAttr rdf:resource="#Re"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                <owl:Class rdf:about="#Yangmingbing"/><owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Dare"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Dahan"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Dake"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_maixiang"/><owl:someValuesFrom rdf:resource="#Hongmai"/></owl:Restriction>
            </owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
        <owl:disjointWith rdf:resource="#Sinitangzheng"/>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Baihutang"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

    <!-- 白虎加人参汤证 -->
    <owl:Class rdf:about="#Baihujiarenshentangzheng">
        <rdfs:label xml:lang="zh">白虎加人参汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Baihutangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Yangmingbing"/>
        <differentialAxis xml:lang="zh">口燥渴甚+欲饮水数升（26、168条）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</clinicalPriority>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yang"/>
        <bagangAttr rdf:resource="#Shi"/>
        <bagangAttr rdf:resource="#Re"/>
        <bagangAttr rdf:resource="#Xu"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                <owl:Class rdf:about="#Yangmingbing"/><owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Dare"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Dahan"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Dake"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Kousheganzao"/></owl:Restriction>
            </owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Baihujiarenshentang"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

    <!-- 白虎加桂枝汤证 -->
    <owl:Class rdf:about="#Baihujiaguizhitangzheng">
        <rdfs:label xml:lang="zh">白虎加桂枝汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Baihutangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Yangmingbing"/>
        <differentialAxis xml:lang="zh">但热无寒+骨节疼烦（金匮疟病）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Biao"/>
        <bagangAttr rdf:resource="#Yang"/>
        <bagangAttr rdf:resource="#Shi"/>
        <bagangAttr rdf:resource="#Re"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                <owl:Class rdf:about="#Yangmingbing"/><owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Danrebuhan"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Gujietengfan"/></owl:Restriction>
            </owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Baihujiaguizhitang"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

    <!-- 竹叶石膏汤证 -->
    <owl:Class rdf:about="#Zhuyeshigaotangzheng">
        <rdfs:label xml:lang="zh">竹叶石膏汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Baihutangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Yangmingbing"/>
        <differentialAxis xml:lang="zh">虚羸少气+欲吐（397条）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yang"/>
        <bagangAttr rdf:resource="#Re"/>
        <bagangAttr rdf:resource="#Xu"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                <owl:Class rdf:about="#Yangmingbing"/><owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xulei"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Shaoqi"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Yutu"/></owl:Restriction>
            </owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Zhuyeshigaotang"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

    <!-- ============================================================ -->
    <!-- 三、承气汤类家族（方根降单味大黄）                            -->
    <!-- ============================================================ -->
    <owl:Class rdf:about="#Chengqitangleifangzheng">
        <rdfs:label xml:lang="zh">承气汤类方证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Jiazu"/>
        <hasFanggen rdf:resource="#Dahuanggen"/>
        <isAbstract rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isAbstract>
        <rdfs:comment xml:lang="zh">母方：大承气汤。共性（注释）：阳明腑实，大便硬，潮热谵语，痞满燥实。方根降单味大黄，枳朴芒硝降为鉴别轴。徐氏承气汤类收陷胸诸方；本本体按结胸病证系列独立立类。</rdfs:comment>
    </owl:Class>

    <!-- 大承气汤证 -->
    <owl:Class rdf:about="#Dachengqitangzheng">
        <rdfs:label xml:lang="zh">大承气汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Chengqitangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Yangmingbing"/>
        <differentialAxis xml:lang="zh">痞满燥实俱全（208、212条等；有枳朴芒硝）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</clinicalPriority>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yang"/>
        <bagangAttr rdf:resource="#Shi"/>
        <bagangAttr rdf:resource="#Re"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                <owl:Class rdf:about="#Yangmingbing"/><owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Dabianying"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Fuman"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Futong"/></owl:Restriction>
