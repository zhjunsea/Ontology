<?xml version='1.0' encoding='UTF-8'?>
<rdf:RDF xmlns="http://www.tcm-classics.org/jingfang#" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xml:base="http://www.tcm-classics.org/jingfang#">

    <owl:Ontology rdf:about="http://www.tcm-classics.org/jingfang/rules">
        <rdfs:label xml:lang="zh">规则层：属性声明与规则元数据</rdfs:label>
        <rdfs:comment xml:lang="zh">本模块只含规则属性声明、全局注解属性声明、规则出处属性。方根级加减规则已移至 fanggen.owl；方证级 clinicalPriority 与 bagangAttr 已回归各系统文件。本文件不再承载具体方证的排序或八纲值。</rdfs:comment>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/core"/>
        <owl:versionInfo>2.2</owl:versionInfo>
    </owl:Ontology>

    <!-- ============ 规则属性声明 ============ -->
    <owl:AnnotationProperty rdf:about="#addHerbRule">
        <rdfs:label xml:lang="zh">加药规则</rdfs:label>
        <rdfs:comment xml:lang="zh">格式：IF 条件 THEN 加药物X（剂量Y）。由应用层解析执行。</rdfs:comment>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="#removeHerbRule">
        <rdfs:label xml:lang="zh">减药规则</rdfs:label>
        <rdfs:comment xml:lang="zh">格式：IF 条件 THEN 去药物X。由应用层解析执行。</rdfs:comment>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="#replaceHerbRule">
        <rdfs:label xml:lang="zh">换药规则</rdfs:label>
        <rdfs:comment xml:lang="zh">格式：IF 条件 THEN 以药物A替换药物B。由应用层解析执行。</rdfs:comment>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="#dosageChangeRule">
        <rdfs:label xml:lang="zh">剂量调整规则</rdfs:label>
        <rdfs:comment xml:lang="zh">格式：IF 条件 THEN 药物X加量/减量。由应用层解析执行。</rdfs:comment>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="#ruleSource">
        <rdfs:label xml:lang="zh">规则出处</rdfs:label>
        <rdfs:comment xml:lang="zh">规则所依据的原文条文或医家论述。</rdfs:comment>
    </owl:AnnotationProperty>

    <!-- ============ 全局注解属性声明（若 core 未定义，则保留于此） ============ -->
    <owl:AnnotationProperty rdf:about="#clinicalPriority">
        <rdfs:label xml:lang="zh">临床优先级</rdfs:label>
        <rdfs:comment xml:lang="zh">数字越小越优先。1=急证；2=重证；3=常证；4=变证；5=缓证。依据《伤寒论》91条“急当救里”，252条“急下存阴”，胡希恕“六经八纲”学术思想。不参与逻辑推理，只作应用层方证排序依据。</rdfs:comment>
        <rdfs:domain rdf:resource="#Fangzheng"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="#bagangAttr">
        <rdfs:label xml:lang="zh">八纲属性</rdfs:label>
        <rdfs:comment xml:lang="zh">方证的八纲归属：表/里、半表半里、阴/阳、虚/实、寒/热。不参与逻辑推理，只作应用层读取。</rdfs:comment>
    </owl:AnnotationProperty>

    <owl:ObjectProperty rdf:about="#addHerb">
        <rdfs:label xml:lang="zh">加药</rdfs:label>
        <rdfs:comment xml:lang="zh">兼夹证或方证需要追加的药物资源。与 addHerbRule 字面量规则并存。</rdfs:comment>
    </owl:ObjectProperty>

</rdf:RDF>
