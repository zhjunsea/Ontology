        <relatedFamily rdf:resource="#Wulingsanleifangzheng"/>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yin"/>
        <bagangAttr rdf:resource="#Shi"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                <owl:Class rdf:about="#Taiyinbing"/><owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xinxiayouzhiyin"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Kumaoxuan"/></owl:Restriction>
            </owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <!-- ============ 12. 茯苓杏仁甘草汤证 ============ -->
    <owl:Class rdf:about="#Fulingxingrengancaotangzheng">
        <rdfs:label xml:lang="zh">茯苓杏仁甘草汤证</rdfs:label>
