    <!-- ============ 13. 木防己汤证 ============ -->
    <owl:Class rdf:about="#Mufangjitangzheng">
        <rdfs:label xml:lang="zh">木防己汤证</rdfs:label>
        <chufang rdf:resource="#Mufangjitang"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Taiyinbing"/>
