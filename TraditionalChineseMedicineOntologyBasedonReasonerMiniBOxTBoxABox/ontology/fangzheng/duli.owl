        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Yangmingbing"/>
        <differentialAxis xml:lang="zh">大便硬+小便自利（233条；外导法）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yang"/>
        <bagangAttr rdf:resource="#Xu"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                <owl:Class rdf:about="#Yangmingbing"/><owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Dabianying"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xiaobianzili"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Fare"/></owl:Restriction>
            </owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <!-- ============ 6. 文蛤散证 ============ -->
    <owl:Class rdf:about="#Wenkesanzheng">
        <rdfs:label xml:lang="zh">文蛤散证</rdfs:label>
        <chufang rdf:resource="#Wenkesan"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Taiyangbing"/>
        <differentialAxis xml:lang="zh">发热+欲饮+反不渴+皮肤粟起（141条）</differentialAxis>
        <relatedFamily rdf:resource="#Wulingsanleifangzheng"/>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
        <bagangAttr rdf:resource="#Biao"/>
        <bagangAttr rdf:resource="#Yang"/>
        <bagangAttr rdf:resource="#Shi"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                <owl:Class rdf:about="#Taiyangbing"/><owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Fare"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Yuyin"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Fanbuke"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Pifusuqi"/></owl:Restriction>
            </owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <!-- ============ 7. 附子粳米汤证 ============ -->
    <owl:Class rdf:about="#Fuzijingmitangzheng">
        <rdfs:label xml:lang="zh">附子粳米汤证</rdfs:label>
        <chufang rdf:resource="#Fuzijingmitang"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Taiyinbing"/>
        <differentialAxis xml:lang="zh">腹中寒气+雷鸣切痛+胸胁逆满+呕吐（金匮腹满寒疝）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yin"/>
        <bagangAttr rdf:resource="#Xu"/>
        <bagangAttr rdf:resource="#Han"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                <owl:Class rdf:about="#Taiyinbing"/><owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Futong"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Fuzhongleiming"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xiongxiekuman"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Outu"/></owl:Restriction>
            </owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <!-- ============ 8. 薏苡附子散证 ============ -->
    <owl:Class rdf:about="#Yiyifuzisanzheng">
        <rdfs:label xml:lang="zh">薏苡附子散证</rdfs:label>
        <chufang rdf:resource="#Yiyifuzisan"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Taiyinbing"/>
        <debatable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</debatable>
        <differentialAxis xml:lang="zh">胸痹缓急（金匮胸痹）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yin"/>
        <bagangAttr rdf:resource="#Xu"/>
        <bagangAttr rdf:resource="#Han"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                <owl:Class rdf:about="#Taiyinbing"/><owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xiongbihuanji"/></owl:Restriction>
            </owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <!-- ============ 9. 栝楼牡蛎散证 ============ -->
    <owl:Class rdf:about="#Gualoumulisanzheng">
        <rdfs:label xml:lang="zh">栝楼牡蛎散证</rdfs:label>
        <chufang rdf:resource="#Gualoumulisan"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Shaoyangbing"/>
        <debatable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</debatable>
        <differentialAxis xml:lang="zh">百合病渴不差（金匮百合）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">5</clinicalPriority>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yin"/>
        <bagangAttr rdf:resource="#Xu"/>
        <bagangAttr rdf:resource="#Re"/>
        <ruleSource xml:lang="zh">《金匮要略·百合狐惑阴阳毒病》："百合病，渴不差者，栝楼牡蛎散主之。" 本方证与百合洗方证同属「百合病变渴」，然「渴不差」谓渴势不解、饮不能止，其渴已甚于「变成渴」之初起，故于百合病基础证（口苦+小便赤）与口渴之外，更以「大渴」为特征症（大渴 ⊑ 口渴，故并列不悖）；百合洗方证则仅以「口渴」为特征症。栝楼根生津止渴、牡蛎潜阳，正治渴之不解者。若两方证定义全同，则 realize 同时命中而不可分辨，故以渴之轻重别之。</ruleSource>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                <owl:Class rdf:about="#Shaoyangbing"/><owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Kouke"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Kouku"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xiaobianchi"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Dake"/></owl:Restriction>
            </owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <!-- ============ 10. 猪苓散证 ============ -->
    <owl:Class rdf:about="#Zhulingsanzheng">
        <rdfs:label xml:lang="zh">猪苓散证</rdfs:label>
        <chufang rdf:resource="#Zhulingsan"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Taiyinbing"/>
        <differentialAxis xml:lang="zh">呕吐+思水（金匮呕吐哕下利）</differentialAxis>
        <ruleSource xml:lang="zh">《金匮要略·呕吐哕下利病脉证治》："呕吐而病在膈上，后思水者，解，急与之。思水者，猪苓散主之。" 主证为呕吐+思水（病在膈上故兼胸满）；原文未言吐涎沫，故不设 Tuxianmo 约束。</ruleSource>
        <relatedFamily rdf:resource="#Wulingsanleifangzheng"/>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yin"/>
        <bagangAttr rdf:resource="#Shi"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                <owl:Class rdf:about="#Taiyinbing"/><owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Ou"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Tu"/></owl:Restriction>
                <!-- 伴随症状：胸满 -->
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Xiongman"/>
                </owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Housishui"/></owl:Restriction>
            </owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <!-- ============ 11. 泽泻汤证 ============ -->
    <owl:Class rdf:about="#Zexietangzheng">
        <rdfs:label xml:lang="zh">泽泻汤证</rdfs:label>
        <chufang rdf:resource="#Zexietang"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
