    <!-- ============ 缺失补建：大黄甘遂汤证 ============ -->
    <owl:Class rdf:about="#Dahuanggansuitangzheng">
        <rdfs:label xml:lang="zh">大黄甘遂汤证</rdfs:label>
        <chufang rdf:resource="#Dahuanggansuitang"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Yangmingbing"/>
        <belongsToLiujing rdf:resource="#Taiyinbing"/>
        <differentialAxis xml:lang="zh">少腹满如敦状+小便微难+不渴+生后者（金匮妇人杂病；水血俱结血室）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</clinicalPriority>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yang"/>
        <bagangAttr rdf:resource="#Yin"/>
        <bagangAttr rdf:resource="#Shi"/>
        <bagangAttr rdf:resource="#Xu"/>
        <ruleSource xml:lang="zh">《金匮要略·妇人杂病》："妇人少腹满如敦状，小便微难而不渴，生后者，此为水与血俱结在血室也，大黄甘遂汤主之。"胡希恕：属阳明太阴合病，水血互结，虚实夹杂。</ruleSource>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                <owl:Class><owl:unionOf rdf:parseType="Collection"><owl:Class rdf:about="#Yangmingbing"/><owl:Class rdf:about="#Taiyinbing"/></owl:unionOf></owl:Class>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Furenshaofumanrudunzhuang"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xiaobiannan"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Buke"/></owl:Restriction>
            
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Shenghouzhe"/></owl:Restriction>
            </owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Fuman"/>
        <possibleSymptom rdf:resource="#Chanhoufutong"/>
    </owl:Class>

</rdf:RDF>
