    <!-- ============ 46. 温胆汤证（后世方） ============ -->
    <owl:Class rdf:about="#Wendantangzheng">
        <rdfs:label xml:lang="zh">温胆汤证</rdfs:label>
        <chufang rdf:resource="#Wendantang"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Shaoyangbing"/>
        <belongsToLiujing rdf:resource="#Taiyinbing"/>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yang"/>
        <bagangAttr rdf:resource="#Shi"/>
        <bagangAttr rdf:resource="#Re"/>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
        <rdfs:comment xml:lang="zh">后世方，出自《三因极一病证方论》，非仲景方。胡希恕不常用，作为扩展保留。</rdfs:comment>
        <rdfs:comment xml:lang="zh">六经归属：少阳太阴合病（胆郁痰扰 + 脾湿生痰）。合病跨病性（阳+阴），
            若把两经合取写入 equivalentClass，因「六经 ≡ 病位⊓病性」且病位/病性不互斥，
            推理机会交叉推出少阳/太阴/阳明/厥阴 4 个六经。故合病方证的六经只写 belongsToLiujing 注解
            （filterFangzheng 经 fangzhengLiujingMap 读注解即可），不写等价类。</rdfs:comment>
        <relatedJianJia rdf:resource="#Tanreshirezheng"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                        <owl:someValuesFrom rdf:resource="#Xinfan"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                        <owl:someValuesFrom rdf:resource="#Budemian"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <!-- ============ 缺失补建：猪膏发煎证 ============ -->
