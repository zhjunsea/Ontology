<?xml version='1.0' encoding='UTF-8'?>
<rdf:RDF xmlns="http://www.tcm-classics.org/jingfang#" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:base="http://www.tcm-classics.org/jingfang#">

    <owl:Ontology rdf:about="http://www.tcm-classics.org/jingfang/duli">
        <rdfs:label xml:lang="zh">独立方证组（不入家族者）</rdfs:label>
        <rdfs:comment xml:lang="zh">独立方证，全部 subClassOf Fangzheng，挂 relatedFamily 注释。本文件保留 #Zishentangzheng、#Helilesanzheng、#Zhizhusanzheng；#Toufengmosanzheng 归 zabing.owl；#Sanwuhuangqintangzheng 如需保留请另处定义。已合并内部重复定义。本文件不再重复声明 clinicalPriority、bagangAttr、addHerb，这些属性声明见 rules.owl。</rdfs:comment>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/core"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/zhengzhuang"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/maixiang"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/fangji"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/yaowu"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/rules"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/jianjia"/>
    </owl:Ontology>

    <!-- ============ 1. 四逆散证 ============ -->
    <owl:Class rdf:about="#Sinisanzheng">
        <rdfs:label xml:lang="zh">四逆散证</rdfs:label>
        <chufang rdf:resource="#Sinisan"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Shaoyangbing"/>
        <belongsToLiujing rdf:resource="#Taiyinbing"/>
        <debatable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</debatable>
        <differentialAxis xml:lang="zh">四逆+或咳或悸或小便不利或腹中痛（318条）；少阴篇文，胡师主少阳</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
        <bagangAttr rdf:resource="#Banbiaobanli"/>
        <bagangAttr rdf:resource="#Yang"/>
        <bagangAttr rdf:resource="#Shi"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                <owl:Class><owl:unionOf rdf:parseType="Collection"><owl:Class rdf:about="#Shaoyangbing"/><owl:Class rdf:about="#Taiyinbing"/></owl:unionOf></owl:Class><owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Shouzuleng"/></owl:Restriction>
            
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Wanglaihanre"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xiongxiekuman"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Futong"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xiali"/></owl:Restriction>
            </owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <!-- ============ 2. 猪苓汤证 ============ -->
    <owl:Class rdf:about="#Zhulingtangzheng">
        <rdfs:label xml:lang="zh">猪苓汤证</rdfs:label>
        <chufang rdf:resource="#Zhulingtang"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Yangmingbing"/>
        <belongsToLiujing rdf:resource="#Shaoyinbing"/>
        <differentialAxis xml:lang="zh">小便不利+口渴+发热（223、319条）</differentialAxis>
        <relatedFamily rdf:resource="#Wulingsanleifangzheng"/>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</clinicalPriority>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yang"/>
        <bagangAttr rdf:resource="#Re"/>
        <bagangAttr rdf:resource="#Xu"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                <owl:Class><owl:unionOf rdf:parseType="Collection"><owl:Class rdf:about="#Yangmingbing"/><owl:Class rdf:about="#Shaoyinbing"/></owl:unionOf></owl:Class><owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xiaobianbuli"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Kouke"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Fare"/></owl:Restriction>
            </owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <!-- ============ 3. 牡蛎泽泻散证 ============ -->
    <owl:Class rdf:about="#Mulizexiesanzheng">
        <rdfs:label xml:lang="zh">牡蛎泽泻散证</rdfs:label>
        <chufang rdf:resource="#Mulizexiesan"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Yangmingbing"/>
        <debatable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</debatable>
        <differentialAxis xml:lang="zh">腰以下有水气（395条）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yang"/>
        <bagangAttr rdf:resource="#Shi"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                <owl:Class rdf:about="#Yangmingbing"/><owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Yaoyixiayoushuiqi"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xiaobianbuli"/></owl:Restriction>
            </owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
    </owl:Class>

