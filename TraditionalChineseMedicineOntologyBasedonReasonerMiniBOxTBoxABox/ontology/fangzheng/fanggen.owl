<?xml version='1.0' encoding='UTF-8'?>
<rdf:RDF xmlns="http://www.tcm-classics.org/jingfang#" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:base="http://www.tcm-classics.org/jingfang#">

    <owl:Ontology rdf:about="http://www.tcm-classics.org/jingfang/fanggen">
        <rdfs:label xml:lang="zh">方根层</rdfs:label>
        <rdfs:comment xml:lang="zh">38 个方根类。只含 subClassOf Fanggen + fanggenType 注释，禁止等价定义。v2.6：方根层不承载加减规则（加减药规则的唯一合法载体是方证层，见 rules.owl）；原挂于方根类的加减规则已全部下沉至对应具名方证。</rdfs:comment>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/core"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/rules"/>
    </owl:Ontology>

    <!-- ============ 顶层类 ============ -->
    <owl:Class rdf:about="#Fanggen">
    		<rdfs:subClassOf rdf:resource="#Bingzheng"/>
        <rdfs:label xml:lang="zh">方根</rdfs:label>
        <rdfs:comment xml:lang="zh">最小配伍单元，方剂结构的“基因”。</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="#Jiazu">
    		<rdfs:subClassOf rdf:resource="#Bingzheng"/>
    		<rdfs:label xml:lang="zh">家族</rdfs:label>
    		<rdfs:comment xml:lang="zh">方剂家族。用于归类具有相同方根或母方，通过加减化裁衍生出的一系列方证（如桂枝汤类方证、建中汤类方证等）的抽象集合。</rdfs:comment>
		</owl:Class>
		<!-- 方证定义 -->
		<owl:Class rdf:about="#Fangzheng">
		    <rdfs:subClassOf rdf:resource="#Bingzheng"/>
		    <rdfs:label xml:lang="zh">方证</rdfs:label>
		    <rdfs:comment xml:lang="zh">指特定的方剂与其对应的主治病证的高度统一体。它是由特定的病因、病机、症状群（包括主症与兼症）及治法共同构成的辨证论治的最小实践单元。</rdfs:comment>
		</owl:Class>
		
		<!-- 三者关系定义 -->
		
		<!-- 1. 构成关系：方根 -> 方证 -->
		<owl:ObjectProperty rdf:about="#has_fanggen">
		    <rdfs:label xml:lang="zh">包含方根</rdfs:label>
		    <rdfs:comment xml:lang="zh">方证由一个或多个方根组合而成，方根是构成方证的最小配伍单元。</rdfs:comment>
		    <rdfs:domain rdf:resource="#Fangzheng"/>
		    <rdfs:range rdf:resource="#Fanggen"/>
		</owl:ObjectProperty>
		
		<!-- 2. 分类关系：方证 -> 家族 -->
		<owl:ObjectProperty rdf:about="#belongs_to_jiazu">
		    <rdfs:label xml:lang="zh">属于家族</rdfs:label>
		    <rdfs:comment xml:lang="zh">方证是家族的具体成员，多个具有共同方根或演化关系的方证被归类到同一个家族中。</rdfs:comment>
		    <rdfs:domain rdf:resource="#Fangzheng"/>
		    <rdfs:range rdf:resource="#Jiazu"/>
		</owl:ObjectProperty>
		
		<!-- 3. 溯源关系：家族 -> 方根 -->
		<owl:ObjectProperty rdf:about="#defined_by_fanggen">
		    <rdfs:label xml:lang="zh">由方根定义</rdfs:label>
		    <rdfs:comment xml:lang="zh">家族的定义和划分基于其成员共有的核心方根，家族由其核心方根衍生而来。</rdfs:comment>
		    <rdfs:domain rdf:resource="#Jiazu"/>
		    <rdfs:range rdf:resource="#Fanggen"/>
		</owl:ObjectProperty>

    <owl:AnnotationProperty rdf:about="#fanggenType">
        <rdfs:label xml:lang="zh">方根类型</rdfs:label>
        <rdfs:comment xml:lang="zh">药对 / 角药 / 单味 / 全方即根 / 角药以上。</rdfs:comment>
    </owl:AnnotationProperty>

    <!-- ============ 1. 桂枝芍药姜枣草（全方即根） ============ -->
    <owl:Class rdf:about="#Guizhishaoyaogen">
        <rdfs:label xml:lang="zh">桂枝芍药姜枣草（方根）</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fanggen"/>
        <fanggenType xml:lang="zh">全方即根</fanggenType>
        <rdfs:comment xml:lang="zh">源方：桂枝汤（12条）。调和营卫。v2.6：方根层不承载加减规则；本方根衍生的加减法已下沉至对应具名方证（桂枝加葛根汤证、桂枝加厚朴杏子汤证、桂枝加附子汤证、桂枝去芍药汤证、桂枝去芍药加附子汤证、桂枝加桂汤证、桂枝加芍药汤证、桂枝加大黄汤证、桂枝去芍药加蜀漆牡蛎龙骨救逆汤证、桂枝去桂加茯苓白术汤证、桂枝新加汤证、桂枝甘草龙骨牡蛎汤证、桂枝加黄芪汤证、桂枝加龙骨牡蛎汤证共 14 个），见 rules.owl。</rdfs:comment>
    </owl:Class>

    <!-- ============ 2. 麻黄（单味） ============ -->
    <owl:Class rdf:about="#Mahuanggen">
        <rdfs:label xml:lang="zh">麻黄（方根）</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fanggen"/>
        <fanggenType xml:lang="zh">单味</fanggenType>
        <rdfs:comment xml:lang="zh">源方：麻黄汤核心。发汗解表。</rdfs:comment>
    </owl:Class>

    <!-- ============ 3. 麻黄桂枝（药对） ============ -->
    <owl:Class rdf:about="#Mahuangguizhigen">
        <rdfs:label xml:lang="zh">麻黄桂枝（方根）</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fanggen"/>
        <fanggenType xml:lang="zh">药对</fanggenType>
        <rdfs:comment xml:lang="zh">源方：麻黄汤（35条）。发汗解表。</rdfs:comment>
    </owl:Class>

    <!-- ============ 4. 葛根（单味） ============ -->
    <owl:Class rdf:about="#Gegen">
        <rdfs:label xml:lang="zh">葛根（方根）</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fanggen"/>
        <fanggenType xml:lang="zh">单味</fanggenType>
        <rdfs:comment xml:lang="zh">源方：葛根芩连汤（34条）。解肌清热。</rdfs:comment>
    </owl:Class>

    <!-- ============ 5. 葛根麻黄（药对） ============ -->
    <owl:Class rdf:about="#GegenMahuanggen">
        <rdfs:label xml:lang="zh">葛根麻黄（方根）</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fanggen"/>
        <fanggenType xml:lang="zh">药对</fanggenType>
        <rdfs:comment xml:lang="zh">源方：葛根汤（31条）。解肌发汗。</rdfs:comment>
    </owl:Class>

    <!-- ============ 6. 柴胡黄芩（药对） ============ -->
    <owl:Class rdf:about="#Chaihugen">
        <rdfs:label xml:lang="zh">柴胡黄芩（方根）</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fanggen"/>
        <fanggenType xml:lang="zh">药对</fanggenType>
        <rdfs:comment xml:lang="zh">源方：小柴胡汤（96条）。和解少阳。v2.6：方根层不承载加减规则；本方根衍生的加减法即小柴胡汤 96 条方后注七法，已归方证级 Xiaochaihutangzheng，见 rules.owl。</rdfs:comment>
    </owl:Class>

