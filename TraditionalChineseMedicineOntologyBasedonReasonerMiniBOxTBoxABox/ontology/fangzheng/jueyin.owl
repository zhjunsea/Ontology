    </owl:Class>

    <!-- ============ 从taiyang.owl迁移的方证（厥阴病） ============ -->

    <!-- 桂枝芍药知母汤证 -->
    <owl:Class rdf:about="#Guizhishaoyaozhimutangzheng">
