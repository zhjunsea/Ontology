<?xml version='1.0' encoding='UTF-8'?>
<rdf:RDF xmlns="http://www.tcm-classics.org/jingfang#" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:base="http://www.tcm-classics.org/jingfang#">

    <owl:Ontology rdf:about="http://www.tcm-classics.org/jingfang/zabing">
        <rdfs:label xml:lang="zh">杂病系统（半夏+栝楼薤白+芍药+虚劳+旋覆花）</rdfs:label>
        <rdfs:comment xml:lang="zh">含半夏汤类、栝楼薤白类、芍药类、芍药甘草类、百合汤类、肾气丸类、酸枣仁汤类、旋覆代赭汤类八大家族，共 29 方证。本文件保留 #Sanwuhuangqintangzheng、#Fanshitangzheng、#Toufengmosanzheng；#Zishentangzheng、#Helilesanzheng、#Zhizhusanzheng 归 duli.owl。本文件不再重复声明 clinicalPriority、bagangAttr、addHerb，这些属性声明见 rules.owl。rules.owl 中原有的 clinicalPriority 与 bagangAttr 补充值已合并到本文件各具体类中。</rdfs:comment>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/core"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/zhengzhuang"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/maixiang"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/fangji"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/yaowu"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/fanggen"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/rules"/>
    </owl:Ontology>

    <!-- ============================================================ -->
    <!-- 一、半夏汤类家族                                              -->
    <!-- ============================================================ -->
    <owl:Class rdf:about="#Banxiatangleifangzheng">
        <rdfs:label xml:lang="zh">半夏汤类方证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Jiazu"/>
        <hasFanggen rdf:resource="#Banxiagen"/>
        <hasFanggen rdf:resource="#BanxiaShengjianggen"/>
        <isAbstract rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isAbstract>
        <rdfs:comment xml:lang="zh">母方：小半夏汤。共性（注释）：痰饮内停，胃气上逆。</rdfs:comment>
    </owl:Class>

    <!-- 小半夏汤证 -->
    <owl:Class rdf:about="#Xiaobanxiatangzheng">
        <rdfs:label xml:lang="zh">小半夏汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Banxiatangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Taiyinbing"/>
        <differentialAxis xml:lang="zh">呕家本渴+反不渴（金匮痰饮）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yin"/>
        <bagangAttr rdf:resource="#Shi"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                <owl:Class rdf:about="#Taiyinbing"/><owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Oujiabenke"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Fanbuke"/></owl:Restriction>
            </owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Xianmai"/>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Xiaobanxiatang"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

    <!-- 小半夏加茯苓汤证 -->
    <owl:Class rdf:about="#Xiaobanxiajiafulingtangzheng">
        <rdfs:label xml:lang="zh">小半夏加茯苓汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Banxiatangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Taiyinbing"/>
        <differentialAxis xml:lang="zh">卒呕吐+心下痞+膈间有水+眩悸（金匮痰饮）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yin"/>
        <bagangAttr rdf:resource="#Shi"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                <owl:Class rdf:about="#Taiyinbing"/><owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Outu"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xinxiapi"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Gejianyoushui"/></owl:Restriction>
            </owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Xianmai"/>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Xiaobanxiajiafulingtang"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

    <!-- 生姜半夏汤证 -->
    <owl:Class rdf:about="#Shengjiangbanxiatangzheng">
        <rdfs:label xml:lang="zh">生姜半夏汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Banxiatangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Taiyinbing"/>
        <differentialAxis xml:lang="zh">似喘不喘+似呕不呕+似哕不哕（金匮呕吐哕下利）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yin"/>
        <bagangAttr rdf:resource="#Shi"/>
        <bagangAttr rdf:resource="#Han"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                <owl:Class rdf:about="#Taiyinbing"/><owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xiongzhongkui"/></owl:Restriction>
            </owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Xianmai"/>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Shengjiangbanxiatang"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

    <!-- 半夏干姜散证 -->
    <owl:Class rdf:about="#Banxiaganjiangsanzheng">
        <rdfs:label xml:lang="zh">半夏干姜散证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Banxiatangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Taiyinbing"/>
        <differentialAxis xml:lang="zh">干呕+吐逆+吐涎沫（金匮呕吐哕下利）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yin"/>
        <bagangAttr rdf:resource="#Xu"/>
        <bagangAttr rdf:resource="#Han"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                <owl:Class rdf:about="#Taiyinbing"/><owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Ganou"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Tuxianmo"/></owl:Restriction>
            </owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Xianmai"/>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Banxiaganjiangsan"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

    <!-- 半夏麻黄丸证 -->
    <owl:Class rdf:about="#Banxiamahuangwanzheng">
        <rdfs:label xml:lang="zh">半夏麻黄丸证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Banxiatangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Taiyinbing"/>
        <differentialAxis xml:lang="zh">心下悸动（金匮惊悸吐衄下血胸满瘀血）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">5</clinicalPriority>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yin"/>
        <bagangAttr rdf:resource="#Shi"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                <owl:Class rdf:about="#Taiyinbing"/><owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xinxiajidong"/></owl:Restriction>
            </owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Touxuan"/>
        <possibleSymptom rdf:resource="#Xianmai"/>
        <possibleSymptom rdf:resource="#SlipperyCoating"/>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Banxiamahuangwan"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

		<!-- 厚朴麻黄汤证 -->
		<owl:Class rdf:about="#Houpomahuangtangzheng">
		    <rdfs:label xml:lang="zh">厚朴麻黄汤证</rdfs:label>
		    <rdfs:subClassOf rdf:resource="#Mahuangtangleifangzheng"/>
		    <rdfs:subClassOf rdf:resource="#Fangzheng"/>
		    <belongsToLiujing rdf:resource="#Taiyangbing"/>
		    <debatable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</debatable>
		    <differentialAxis xml:lang="zh">咳而脉浮（金匮肺痿肺痈咳嗽上气）</differentialAxis>
		    <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
		    <bagangAttr rdf:resource="#Biao"/>
		    <bagangAttr rdf:resource="#Li"/>
		    <bagangAttr rdf:resource="#Yang"/>
		    <bagangAttr rdf:resource="#Shi"/>
		    <bagangAttr rdf:resource="#Han"/>
		    <owl:equivalentClass>
		        <owl:Class>
		            <owl:intersectionOf rdf:parseType="Collection">
		                <owl:Class rdf:about="#Taiyangbing"/>
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#Kesou"/>
		                </owl:Restriction>
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_maixiang"/>
		                    <owl:someValuesFrom rdf:resource="#Fumai"/>
		                </owl:Restriction>
		            </owl:intersectionOf>
		        </owl:Class>
		    </owl:equivalentClass>
		    <possibleSymptom rdf:resource="#Chuan"/>
		    <possibleSymptom rdf:resource="#Shangqi"/>
		    <possibleSymptom rdf:resource="#Budewo"/>
		    <possibleSymptom rdf:resource="#Houzhongshuijisheng"/>
		    <rdfs:subClassOf>
		        <owl:Restriction>
		            <owl:onProperty rdf:resource="#you_chufang"/>
		            <owl:hasValue rdf:resource="#Houpomahuangtang"/>
		        </owl:Restriction>
		    </rdfs:subClassOf>
		</owl:Class>

    <!-- 大半夏汤证 -->
    <owl:Class rdf:about="#Dabanxiatangzheng">
        <rdfs:label xml:lang="zh">大半夏汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Banxiatangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Taiyinbing"/>
        <differentialAxis xml:lang="zh">呕吐（金匮呕吐哕下利）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yin"/>
        <bagangAttr rdf:resource="#Xu"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                <owl:Class rdf:about="#Taiyinbing"/><owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Outu"/></owl:Restriction>
            </owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Dabanxiatang"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

    <!-- 厚朴生姜半夏甘草人参汤证 -->
    <owl:Class rdf:about="#Houposhengjiangbanxiagancaorenshentangzheng">
        <rdfs:label xml:lang="zh">厚朴生姜半夏甘草人参汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Banxiatangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Taiyinbing"/>
        <differentialAxis xml:lang="zh">腹满+按之不痛（66条、金匮腹满寒疝）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yin"/>
        <bagangAttr rdf:resource="#Xu"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                <owl:Class rdf:about="#Taiyinbing"/><owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Fuman"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_fuzheng"/><owl:someValuesFrom rdf:resource="#Anzhibutong"/></owl:Restriction>
            </owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Fumai"/>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Houposhengjiangbanxiagancaorenshentang"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

    <!-- 半夏厚朴汤证 -->
    <owl:Class rdf:about="#Banxiahoupotangzheng">
        <rdfs:label xml:lang="zh">半夏厚朴汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Banxiatangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Taiyinbing"/>
        <debatable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</debatable>
        <differentialAxis xml:lang="zh">咽中如有炙脔（金匮妇人杂病）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yin"/>
        <bagangAttr rdf:resource="#Shi"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                <owl:Class rdf:about="#Taiyinbing"/><owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Yanzhongruyouzhiluan"/></owl:Restriction>
            </owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Banxiahoupotang"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

    <!-- 干姜人参半夏丸证 -->
    <owl:Class rdf:about="#Ganjiangrenshenbanxiawanzheng">
        <rdfs:label xml:lang="zh">干姜人参半夏丸证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Banxiatangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Taiyinbing"/>
        <debatable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</debatable>
        <differentialAxis xml:lang="zh">妊娠呕吐不止（金匮妇人妊娠）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">5</clinicalPriority>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yin"/>
        <bagangAttr rdf:resource="#Xu"/>
        <bagangAttr rdf:resource="#Han"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                <owl:Class rdf:about="#Taiyinbing"/><owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Renshenoutubuzhi"/></owl:Restriction>
            </owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Shibuxia"/>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Ganjiangrenshenbanxiawan"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

    <!-- ============================================================ -->
    <!-- 二、栝楼薤白类家族                                            -->
    <!-- ============================================================ -->
    <owl:Class rdf:about="#Gualouxiebaileifangzheng">
        <rdfs:label xml:lang="zh">栝楼薤白类方证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Jiazu"/>
        <hasFanggen rdf:resource="#Gualouxiebaigen"/>
        <isAbstract rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isAbstract>
        <rdfs:comment xml:lang="zh">母方：栝楼薤白白酒汤。共性（注释）：胸阳不振，痰浊痹阻。</rdfs:comment>
    </owl:Class>

    <!-- 栝楼薤白白酒汤证 -->
    <owl:Class rdf:about="#Gualouxiebaibaijiutangzheng">
        <rdfs:label xml:lang="zh">栝楼薤白白酒汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Gualouxiebaileifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Taiyinbing"/>
        <differentialAxis xml:lang="zh">胸痹+喘息咳唾+胸背痛+短气（金匮胸痹）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yin"/>
        <bagangAttr rdf:resource="#Shi"/>
        <bagangAttr rdf:resource="#Han"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                <owl:Class rdf:about="#Taiyinbing"/><owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xiongbi"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Chuan"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Duanqi"/></owl:Restriction>
            </owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Chenchimai"/>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Gualouxiebaibaijiutang"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

    <!-- 栝楼薤白半夏汤证 -->
    <owl:Class rdf:about="#Gualouxiebaibanxiatangzheng">
        <rdfs:label xml:lang="zh">栝楼薤白半夏汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Gualouxiebaileifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Taiyinbing"/>
        <differentialAxis xml:lang="zh">胸痹不得卧+心痛彻背（金匮胸痹）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yin"/>
        <bagangAttr rdf:resource="#Shi"/>
        <bagangAttr rdf:resource="#Han"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                <owl:Class rdf:about="#Taiyinbing"/><owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xiongbi"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Budewo"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xintongchebei"/></owl:Restriction>
            </owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Chenjinmai"/>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Gualouxiebaibanxiantang"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

    <!-- 枳实薤白桂枝汤证 -->
    <owl:Class rdf:about="#Zhishixiebaiguizhitangzheng">
        <rdfs:label xml:lang="zh">枳实薤白桂枝汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Gualouxiebaileifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Taiyinbing"/>
        <differentialAxis xml:lang="zh">胸痹心中痞+胸满+胁下逆抢心（金匮胸痹）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yin"/>
        <bagangAttr rdf:resource="#Shi"/>
        <bagangAttr rdf:resource="#Han"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                <owl:Class rdf:about="#Taiyinbing"/><owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xiongbi"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xinzhongpi"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xiongman"/></owl:Restriction>
