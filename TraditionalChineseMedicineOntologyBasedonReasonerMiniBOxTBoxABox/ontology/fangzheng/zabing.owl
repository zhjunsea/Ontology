    </owl:Class>

    <!-- ============================================================ -->
    <!-- 三、芍药类家族                                                -->
    <!-- ============================================================ -->
    <owl:Class rdf:about="#Shaoyaoleifangzheng">
        <rdfs:label xml:lang="zh">芍药类方证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Jiazu"/>
        <hasFanggen rdf:resource="#Shaoyaogen"/>
        <isAbstract rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isAbstract>
        <rdfs:comment xml:lang="zh">母方：芍药甘草汤。共性（注释）：芍药为君，主治挛急腹痛。立类依据：黄煌药证（芍药主“挛急”）＋胡希恕药证（“缓急止痛、治腹挛痛”）＋金匮妇人三篇病证系列。无“徐氏芍药汤类”precedent。编辑裁定原则：芍药为君或主治挛急腹痛者入族；含芍药的桂枝汤证、真武汤证、当归四逆汤证等因主证不同不入，留注释备检。</rdfs:comment>
    </owl:Class>

