        <hasFanggen rdf:resource="#Gegen"/>
        <isAbstract rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isAbstract>
        <rdfs:comment xml:lang="zh">母方：葛根汤。共性（注释）：太阳阳明合病，解肌发汗。</rdfs:comment>
    </owl:Class>

