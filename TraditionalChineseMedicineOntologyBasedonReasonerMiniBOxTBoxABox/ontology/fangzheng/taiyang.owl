    <!-- 二、麻黄汤类家族                                              -->
    <!-- ============================================================ -->
    <owl:Class rdf:about="#Mahuangtangleifangzheng">
        <rdfs:label xml:lang="zh">麻黄汤类方证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Jiazu"/>
        <hasFanggen rdf:resource="#Mahuanggen"/>
        <hasFanggen rdf:resource="#Mahuangguizhigen"/>
        <isAbstract rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isAbstract>
        <rdfs:comment xml:lang="zh">母方：麻黄汤。共性（注释）：太阳表实，无汗，脉浮紧。麻杏石甘已转阳明，家族不绑六经。</rdfs:comment>
    </owl:Class>

    <!-- 麻黄汤证 -->
    <owl:Class rdf:about="#Mahuangtangzheng">
		    <rdfs:label xml:lang="zh">麻黄汤证</rdfs:label>
		    <rdfs:subClassOf rdf:resource="#Mahuangtangleifangzheng"/>
		    <rdfs:subClassOf rdf:resource="#Fangzheng"/>
		    <belongsToLiujing rdf:resource="#Taiyangbing"/>
		    <differentialAxis xml:lang="zh">无汗+身疼+浮紧；无烦躁（35条）</differentialAxis>
		    <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</clinicalPriority>
		    <bagangAttr rdf:resource="#Biao"/>
		    <bagangAttr rdf:resource="#Yang"/>
		    <bagangAttr rdf:resource="#Shi"/>
		    <owl:equivalentClass>
				  <owl:Class>
				    <owl:intersectionOf rdf:parseType="Collection">
				      <owl:Class rdf:about="#Taiyangbing"/>
				      <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/>
				        <owl:someValuesFrom rdf:resource="#Wuhan"/></owl:Restriction>
				      <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/>
				        <owl:someValuesFrom rdf:resource="#Shentong"/></owl:Restriction>
				      <owl:Restriction><owl:onProperty rdf:resource="#you_maixiang"/>
				        <owl:someValuesFrom rdf:resource="#Fujinmai"/></owl:Restriction>
				    </owl:intersectionOf>
				  </owl:Class>
				</owl:equivalentClass>
		    <possibleSymptom rdf:resource="#Chuan"/>
		    <possibleSymptom rdf:resource="#Ehan"/>
		    <possibleSymptom rdf:resource="#Fare"/>
		    <owl:disjointWith rdf:resource="#Guizhitangzheng"/>
		    <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Mahuangtang"/></owl:Restriction></rdfs:subClassOf>
		</owl:Class>

    <!-- 大青龙汤证 -->
    <owl:Class rdf:about="#Daqinglongtangzheng">
        <rdfs:label xml:lang="zh">大青龙汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Mahuangtangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Taiyangbing"/>
        <differentialAxis xml:lang="zh">不汗出而烦躁（38条）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</clinicalPriority>
        <bagangAttr rdf:resource="#Biao"/>
        <bagangAttr rdf:resource="#Yang"/>
        <bagangAttr rdf:resource="#Shi"/>
        <bagangAttr rdf:resource="#Re"/>
        <owl:equivalentClass>
				  <owl:Class><owl:intersectionOf rdf:parseType="Collection">
				    <owl:Class rdf:about="#Taiyangbing"/>
				    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/>
				      <owl:someValuesFrom rdf:resource="#Fare"/></owl:Restriction>       <!-- 补：发热 -->
				    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/>
				      <owl:someValuesFrom rdf:resource="#Ehan"/></owl:Restriction>
				    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/>
				      <owl:someValuesFrom rdf:resource="#Wuhan"/></owl:Restriction>
				    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/>
				      <owl:someValuesFrom rdf:resource="#Fanzao"/></owl:Restriction>      <!-- 不可去 -->
				    <owl:Restriction><owl:onProperty rdf:resource="#you_maixiang"/>
				      <owl:someValuesFrom rdf:resource="#Jinmai"/></owl:Restriction>      <!-- 补：浮紧 -->
				  </owl:intersectionOf></owl:Class>
				</owl:equivalentClass>
        <owl:disjointWith rdf:resource="#Xiaoqinglongtangzheng"/>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Daqinglongtang"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

    <!-- 小青龙汤证 -->
		<owl:Class rdf:about="#Xiaoqinglongtangzheng">
		    <rdfs:label xml:lang="zh">小青龙汤证</rdfs:label>
		    <rdfs:subClassOf rdf:resource="#Mahuangtangleifangzheng"/>
		    <rdfs:subClassOf rdf:resource="#Fangzheng"/>
		    <belongsToLiujing rdf:resource="#Taiyangbing"/>
		    <differentialAxis xml:lang="zh">伤寒表不解，心下有水气：发热恶寒无汗+咳喘+干呕+痰多清稀（40、41条）</differentialAxis>
		    <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
		    <bagangAttr rdf:resource="#Biao"/>
		    <bagangAttr rdf:resource="#Yang"/>
		    <bagangAttr rdf:resource="#Shi"/>
		    <bagangAttr rdf:resource="#Han"/>
		
		    <owl:equivalentClass>
		        <owl:Class>
		            <owl:intersectionOf rdf:parseType="Collection">
		                <owl:Class rdf:about="#Taiyangbing"/>
		                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#Fare"/></owl:Restriction>          <!-- 补：发热 -->
		                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#Ehan"/></owl:Restriction>          <!-- 补：恶寒 -->
		                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#Wuhan"/></owl:Restriction>
		                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#Kechuan"/></owl:Restriction>       <!-- 改：Kesou → Kechuan -->
		                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#Ganou"/></owl:Restriction>         <!-- 补：干呕（心下有水气） -->
		            </owl:intersectionOf>
		        </owl:Class>
		    </owl:equivalentClass>
		
		    <rdfs:subClassOf>
		        <owl:Restriction>
		            <owl:onProperty rdf:resource="#you_chufang"/>
		            <owl:hasValue rdf:resource="#Xiaoqinglongtang"/>
		        </owl:Restriction>
		    </rdfs:subClassOf>
		</owl:Class>

    <!-- 小青龙加石膏汤证 -->
    <owl:Class rdf:about="#Xiaoqinglongjiashigaotangzheng">
        <rdfs:label xml:lang="zh">小青龙加石膏汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Mahuangtangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Taiyangbing"/>
        <differentialAxis xml:lang="zh">小青龙证兼烦躁（金匮肺痿）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
        <bagangAttr rdf:resource="#Biao"/>
        <bagangAttr rdf:resource="#Yang"/>
        <bagangAttr rdf:resource="#Shi"/>
        <bagangAttr rdf:resource="#Han"/>
        <bagangAttr rdf:resource="#Re"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                <owl:Class rdf:about="#Taiyangbing"/><owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Kesou"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Chuan"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Fanzao"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_maixiang"/><owl:someValuesFrom rdf:resource="#Fumai"/></owl:Restriction>
            </owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Xiaoqinglongjiashigaotang"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

    <!-- 麻杏石甘汤证 -->
    <owl:Class rdf:about="#Maxingshigantangzheng">
        <rdfs:label xml:lang="zh">麻杏石甘汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Mahuangtangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Yangmingbing"/>
        <differentialAxis xml:lang="zh">汗出而喘+无大热（63、162条）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yang"/>
        <bagangAttr rdf:resource="#Shi"/>
        <bagangAttr rdf:resource="#Re"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                <owl:Class rdf:about="#Yangmingbing"/><owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Hanchu"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Chuan"/></owl:Restriction>
            </owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Maxingshigantang"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

    <!-- 麻黄加术汤证 -->
    <owl:Class rdf:about="#Mahuangjiazhutangzheng">
        <rdfs:label xml:lang="zh">麻黄加术汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Mahuangtangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Taiyangbing"/>
        <differentialAxis xml:lang="zh">身疼烦+恶寒（金匮痉湿暍）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
        <bagangAttr rdf:resource="#Biao"/>
        <bagangAttr rdf:resource="#Yang"/>
        <bagangAttr rdf:resource="#Shi"/>
        <owl:equivalentClass>
				  <owl:Class>
				    <owl:intersectionOf rdf:parseType="Collection">
				      <owl:Class rdf:about="#Taiyangbing"/>
				      <owl:Restriction>
				        <owl:onProperty rdf:resource="#you_zhengzhuang"/>
				        <owl:someValuesFrom rdf:resource="#Shentengfan"/>
				      </owl:Restriction>
				      <owl:Restriction>
				        <owl:onProperty rdf:resource="#you_zhengzhuang"/>
				        <owl:someValuesFrom rdf:resource="#Ehan"/>
				      </owl:Restriction>
				      <owl:Restriction>
				        <owl:onProperty rdf:resource="#you_zhengzhuang"/>
				        <owl:someValuesFrom rdf:resource="#Shenzhong"/>
				      </owl:Restriction>
				      <owl:Restriction>
				        <owl:onProperty rdf:resource="#you_zhengzhuang"/>
				        <owl:someValuesFrom rdf:resource="#Wuhan"/>
				      </owl:Restriction>
				    </owl:intersectionOf>
				  </owl:Class>
				</owl:equivalentClass>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Mahuangjiazhutang"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

    <!-- 麻黄连翘赤小豆汤证 -->
		<owl:Class rdf:about="#Mahuanglianqiaochixiaodoutangzheng">
		    <rdfs:label xml:lang="zh">麻黄连翘赤小豆汤证</rdfs:label>
		    <rdfs:subClassOf rdf:resource="#Mahuangtangleifangzheng"/>
		    <rdfs:subClassOf rdf:resource="#Fangzheng"/>
		    <belongsToLiujing rdf:resource="#Taiyangbing"/>
		    <belongsToLiujing rdf:resource="#Yangmingbing"/>
		    <differentialAxis xml:lang="zh">身黄+发热恶寒+无汗+小便不利，表邪未解而里有湿热（262条）</differentialAxis>
		    <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
		    <bagangAttr rdf:resource="#Biao"/>
		    <bagangAttr rdf:resource="#Li"/>
		    <bagangAttr rdf:resource="#Yang"/>
		    <bagangAttr rdf:resource="#Shi"/>
		    <bagangAttr rdf:resource="#Re"/>
		
		    <owl:equivalentClass>
		        <owl:Class>
		            <owl:intersectionOf rdf:parseType="Collection">
		                <owl:Class rdf:about="#Taiyangbing"/>
		                <!-- ❌ 去掉 Yangmingbing：262条属太阳篇，"瘀热在里"是湿热不是阳明腑实 -->
		                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#Shenhuang"/></owl:Restriction>
		                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#Fare"/></owl:Restriction>
		                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#Ehan"/></owl:Restriction>
		                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#Wuhan"/></owl:Restriction>
		                <!-- ✅ 新增：小便不利（治黄必利小便的必见症） -->
		                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#Xiaobianbuli"/></owl:Restriction>
		            </owl:intersectionOf>
		        </owl:Class>
		    </owl:equivalentClass>
		
		    <rdfs:subClassOf>
		        <owl:Restriction>
		            <owl:onProperty rdf:resource="#you_chufang"/>
		            <owl:hasValue rdf:resource="#Mahuanglianqiaochixiaodoutang"/>
		        </owl:Restriction>
		    </rdfs:subClassOf>
		</owl:Class>

    <!-- 麻黄附子细辛汤证 -->
    <owl:Class rdf:about="#Mahuangfuzixixintangzheng">
        <rdfs:label xml:lang="zh">麻黄附子细辛汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Mahuangtangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Shaoyinbing"/>
        <differentialAxis xml:lang="zh">反发热+脉沉+但欲寐（301条）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</clinicalPriority>
        <bagangAttr rdf:resource="#Biao"/>
        <bagangAttr rdf:resource="#Yin"/>
        <bagangAttr rdf:resource="#Xu"/>
        <bagangAttr rdf:resource="#Han"/>
        <owl:equivalentClass>
				  <owl:Class>
				    <owl:intersectionOf rdf:parseType="Collection">
				      <owl:Class rdf:about="#Shaoyinbing"/>
				      <owl:Restriction>
				        <owl:onProperty rdf:resource="#you_zhengzhuang"/>
				        <owl:someValuesFrom rdf:resource="#Fare"/>
				      </owl:Restriction>
				      <owl:Restriction>
				        <owl:onProperty rdf:resource="#you_maixiang"/>
				        <owl:someValuesFrom rdf:resource="#Chenmai"/>
				      </owl:Restriction>
				    </owl:intersectionOf>
				  </owl:Class>
				</owl:equivalentClass>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Mahuangfuzixixintang"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

    <!-- 麻黄附子甘草汤证 -->
    <owl:Class rdf:about="#Mahuangfuzigancaotangzheng">
        <rdfs:label xml:lang="zh">麻黄附子甘草汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Mahuangtangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Shaoyinbing"/>
        <differentialAxis xml:lang="zh">恶寒+但欲寐（302条）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
        <bagangAttr rdf:resource="#Biao"/>
        <bagangAttr rdf:resource="#Yin"/>
        <bagangAttr rdf:resource="#Xu"/>
        <bagangAttr rdf:resource="#Han"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                <owl:Class rdf:about="#Shaoyinbing"/>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Ehan"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Danyumei"/></owl:Restriction>
            </owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Mahuangfuzigancaotang"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

		<!-- 麻黄附子汤证 -->
		<owl:Class rdf:about="#Mahuangfuzitangzheng">
		    <rdfs:label xml:lang="zh">麻黄附子汤证</rdfs:label>
		    <rdfs:comment xml:lang="zh">少阴阳虚，水气在表。脉沉小、水肿、小便不利为核心辨证眼目。即《伤寒论》麻黄附子甘草汤证，治以温经助阳、微微发汗以去水。</rdfs:comment>
		    <rdfs:subClassOf rdf:resource="#Mahuangtangleifangzheng"/>
		    <rdfs:subClassOf rdf:resource="#Fangzheng"/>
		    <belongsToLiujing rdf:resource="#Shaoyinbing"/>
		    <differentialAxis xml:lang="zh">脉沉小+水肿+小便不利，属少阴（金匮·水气病篇）</differentialAxis>
		    <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
		
		    <!-- 八纲：水在表，少阴阳虚，里寒不显，故不标里证 -->
		    <bagangAttr rdf:resource="#Biao"/>
		    <bagangAttr rdf:resource="#Yin"/>
		    <bagangAttr rdf:resource="#Xu"/>
		    <bagangAttr rdf:resource="#Han"/>
		
		    <!-- 等价类：少阴 + 脉沉小 + 水肿 + 小便不利 + 无汗 -->
		    <owl:equivalentClass>
		        <owl:Class>
		            <owl:intersectionOf rdf:parseType="Collection">
		                <owl:Class rdf:about="#Shaoyinbing"/>
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_maixiang"/>
		                    <owl:someValuesFrom rdf:resource="#Chenxiaomai"/>
		                </owl:Restriction>
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#Shuizhong"/>
		                </owl:Restriction>
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#Xiaobianbuli"/>
		                </owl:Restriction>
		                <owl:Restriction>
		                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
		                    <owl:someValuesFrom rdf:resource="#Wuhan"/>
		                </owl:Restriction>
		            </owl:intersectionOf>
		        </owl:Class>
		    </owl:equivalentClass>
		
		    <rdfs:subClassOf>
		        <owl:Restriction>
		            <owl:onProperty rdf:resource="#you_chufang"/>
		            <owl:hasValue rdf:resource="#Mahuangfuzitang"/>
		        </owl:Restriction>
		    </rdfs:subClassOf>
		</owl:Class>

    <!-- 射干麻黄汤证 -->
    <owl:Class rdf:about="#Sheganmahuangtangzheng">
        <rdfs:label xml:lang="zh">射干麻黄汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Mahuangtangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Taiyinbing"/>
        <debatable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</debatable>
        <differentialAxis xml:lang="zh">咳而上气+喉中水鸡声（金匮肺痿）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yin"/>
        <bagangAttr rdf:resource="#Shi"/>
        <bagangAttr rdf:resource="#Han"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                <owl:Class rdf:about="#Taiyinbing"/><owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Kesangerqi"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Houzhongshuijisheng"/></owl:Restriction>
            </owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Sheganmahuangtang"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

    <!-- 厚朴麻黄汤证 -->
    <owl:Class rdf:about="#Houpomahuangtangzheng">
        <rdfs:label xml:lang="zh">厚朴麻黄汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Mahuangtangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Taiyinbing"/>
        <debatable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</debatable>
        <differentialAxis xml:lang="zh">咳而喘+不得卧（金匮肺痿）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
        <bagangAttr rdf:resource="#Biao"/>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yin"/>
        <bagangAttr rdf:resource="#Shi"/>
        <bagangAttr rdf:resource="#Han"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                <owl:Class rdf:about="#Taiyinbing"/><owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Kesou"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Chuan"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Budewo"/></owl:Restriction>
            </owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Houpomahuangtang"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

    <!-- 麻杏薏甘汤证 -->
    <owl:Class rdf:about="#Maxingyigantangzheng">
		    <rdfs:label xml:lang="zh">麻杏薏甘汤证</rdfs:label>
		    <rdfs:subClassOf rdf:resource="#Mahuangtangleifangzheng"/>
		    <rdfs:subClassOf rdf:resource="#Fangzheng"/>
		    <belongsToLiujing rdf:resource="#Taiyangbing"/>
		    <differentialAxis xml:lang="zh">一身尽疼+发热+日晡所剧+无汗（金匮痉湿暍）</differentialAxis>
		    <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
		    <bagangAttr rdf:resource="#Biao"/>
		    <bagangAttr rdf:resource="#Yang"/>
		    <bagangAttr rdf:resource="#Shi"/>
		    <owl:equivalentClass>
		        <owl:Class><owl:intersectionOf rdf:parseType="Collection">
		            <owl:Class rdf:about="#Taiyangbing"/>
		            <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/>
		              <owl:someValuesFrom rdf:resource="#Yishenjinteng"/></owl:Restriction>   <!-- 改：一身尽疼 -->
		            <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/>
		              <owl:someValuesFrom rdf:resource="#Fare"/></owl:Restriction>
		            <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/>
		              <owl:someValuesFrom rdf:resource="#RipuSuoju"/></owl:Restriction>
		            <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/>
		              <owl:someValuesFrom rdf:resource="#Wuhan"/></owl:Restriction>            <!-- 补：无汗 -->
		        </owl:intersectionOf></owl:Class>
		    </owl:equivalentClass>
		    <rdfs:subClassOf><owl:Restriction>
		        <owl:onProperty rdf:resource="#you_chufang"/>
		        <owl:hasValue rdf:resource="#Maxingyigantang"/>
		    </owl:Restriction></rdfs:subClassOf>
		</owl:Class>

    <!-- 越婢汤证 -->
    <owl:Class rdf:about="#Yuebitangzheng">
