<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns="http://www.tcm-classics.org/jingfang#"
         xml:base="http://www.tcm-classics.org/jingfang#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

    <owl:Ontology rdf:about="http://www.tcm-classics.org/jingfang/fuzheng">
        <rdfs:label xml:lang="zh">腹证模块</rdfs:label>
        <rdfs:comment xml:lang="zh">腹诊所得体征（按之石硬、按痛、按之濡、按之不痛等）。腹证是「切诊」之腹诊所得，与患者自诉之症状（Zhengzhuang）分属不同四诊通道，故独立成模块并归入 Fuzheng。依据《伤寒论》《金匮要略》原文腹诊描述。</rdfs:comment>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/core"/>
        <owl:versionInfo>1.0</owl:versionInfo>
    </owl:Ontology>

    <!-- ==================== 腹诊所得（按之*） ==================== -->

    <!-- 《伤寒论》135条：伤寒六七日，结胸热实，脉沉而紧，心下痛，按之石硬者，大陷胸汤主之。 -->
    <owl:Class rdf:about="#Anzhishiying">
        <rdfs:subClassOf rdf:resource="#Fuzheng"/>
        <rdfs:label xml:lang="zh">按之石硬</rdfs:label>
        <rdfs:comment xml:lang="zh">《伤寒论》135条大陷胸汤证腹诊。心下按之石硬，为水热结于胸膈之候。</rdfs:comment>
    </owl:Class>

    <!-- 《伤寒论》138条：小结胸病，正在心下，按之则痛，脉浮滑者，小陷胸汤主之。 -->
    <owl:Class rdf:about="#Antong">
        <rdfs:subClassOf rdf:resource="#Fuzheng"/>
        <rdfs:label xml:lang="zh">按痛</rdfs:label>
        <rdfs:comment xml:lang="zh">《伤寒论》138条小陷胸汤证腹诊。心下按之则痛，为痰热互结之小结胸。</rdfs:comment>
    </owl:Class>

    <!-- 《伤寒论》154条：心下痞，按之濡，其脉关上浮者，大黄黄连泻心汤主之。 -->
    <owl:Class rdf:about="#Anzhiru">
        <rdfs:subClassOf rdf:resource="#Fuzheng"/>
        <rdfs:label xml:lang="zh">按之濡</rdfs:label>
        <rdfs:comment xml:lang="zh">《伤寒论》154条大黄黄连泻心汤证腹诊。心下痞而按之濡软，为无形邪热痞塞。</rdfs:comment>
    </owl:Class>

    <!-- 《伤寒论》66条：发汗后，腹胀满者，厚朴生姜半夏甘草人参汤主之。腹诊按之不痛，以别于实满。 -->
    <owl:Class rdf:about="#Anzhibutong">
        <rdfs:subClassOf rdf:resource="#Fuzheng"/>
        <rdfs:label xml:lang="zh">按之不痛</rdfs:label>
        <rdfs:comment xml:lang="zh">《伤寒论》66条厚朴生姜半夏甘草人参汤证腹诊。腹胀满而按之不痛，属虚满。</rdfs:comment>
    </owl:Class>

</rdf:RDF>
