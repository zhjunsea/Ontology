<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns="http://www.tcm-classics.org/jingfang#"
         xml:base="http://www.tcm-classics.org/jingfang#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

    <owl:Ontology rdf:about="http://www.tcm-classics.org/jingfang/rule">
        <rdfs:label xml:lang="zh">经方加减药规则模块 v1.0</rdfs:label>
        <rdfs:comment xml:lang="zh">依据《伤寒论》《金匮要略》原文方后注、胡希恕“方证对应”思想、黄煌“药证”理论。规则分为方根级、家族级、方证级三层，优先级从低到高。</rdfs:comment>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/core"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/zhengzhuang"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/yaowu"/>
    </owl:Ontology>

    <!-- ==================== 规则层注释属性 ==================== -->

    <owl:AnnotationProperty rdf:about="#addHerbRule">
        <rdfs:label xml:lang="zh">加药规则</rdfs:label>
        <rdfs:comment xml:lang="zh">格式：IF 条件 THEN 加药物X（剂量Y）。条件为症状类IRI。由应用层解析执行。</rdfs:comment>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="#removeHerbRule">
        <rdfs:label xml:lang="zh">减药规则</rdfs:label>
        <rdfs:comment xml:lang="zh">格式：IF 条件 THEN 去药物X。条件为症状类IRI或病机状态。由应用层解析执行。</rdfs:comment>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="#replaceHerbRule">
        <rdfs:label xml:lang="zh">换药规则</rdfs:label>
        <rdfs:comment xml:lang="zh">格式：IF 条件 THEN 以药物A替换药物B。由应用层解析执行。</rdfs:comment>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="#dosageChangeRule">
        <rdfs:label xml:lang="zh">剂量调整规则</rdfs:label>
        <rdfs:comment xml:lang="zh">格式：IF 条件 THEN 药物X加量/减量。由应用层解析执行。</rdfs:comment>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="#ruleSource">
        <rdfs:label xml:lang="zh">规则出处</rdfs:label>
        <rdfs:comment xml:lang="zh">规则所依据的原文条文或医家论述。</rdfs:comment>
    </owl:AnnotationProperty>

    <!-- ============================================================ -->
    <!-- ============ 第一层：方根级加减规则 ======================== -->
    <!-- ============================================================ -->

    <!-- 桂枝芍药姜枣草方根（桂枝汤全方为根） -->
    <owl:Class rdf:about="#Guizhishaoyaogen">
        <addHerbRule rdf:parseType="Literal">
            IF Xiangqiang THEN add Gegen (葛根四两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》14条：“太阳病，项背强几几，反汗出恶风者，桂枝加葛根汤主之。”胡希恕：项背强几几为葛根药证。</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Chuan THEN add Houpo (厚朴二两) + Xingren (杏仁五十个)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》18条：“喘家作，桂枝汤加厚朴杏子佳。”43条：“太阳病，下之微喘者，表未解故也，桂枝加厚朴杏子汤主之。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Hanloubuzhi AND Xiaobiannan THEN add Fuzi (附子一枚，炮)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》20条：“太阳病，发汗，遂漏不止，其人恶风，小便难，四支微急，难以屈伸者，桂枝加附子汤主之。”</ruleSource>

        <removeHerbRule rdf:parseType="Literal">
            IF Xinxiaoman THEN remove Shaoyao (芍药)
        </removeHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》21条：“太阳病，下之后，脉促胸满者，桂枝去芍药汤主之。”22条：“若微恶寒者，桂枝去芍药加附子汤主之。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Xinxiaoman AND Ehan THEN add Fuzi (附子一枚，炮)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》22条：“若微恶寒者，桂枝去芍药加附子汤主之。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Qicongshaofushangchongxin THEN add Guizhi (桂枝加量至五两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》117条：“烧针令其汗，针处被寒，核起而赤者，必发奔豚，气从少腹上冲心者，灸其核上各一壮，与桂枝加桂汤。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Fuman AND Futong THEN add Shaoyao (芍药加量至六两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》279条：“本太阳病，医反下之，因尔腹满时痛者，属太阴也，桂枝加芍药汤主之。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Dashitong THEN add Dahuang (大黄二两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》279条：“大实痛者，桂枝加大黄汤主之。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Jingkuang AND Woqibuan THEN add Shaqi (蜀漆三两) + Muli (牡蛎五两) + Longgu (龙骨四两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》112条：“伤寒脉浮，医以火迫劫之，亡阳必惊狂，卧起不安者，桂枝去芍药加蜀漆牡蛎龙骨救逆汤主之。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Xinxiaoman AND Xiaobianbuli THEN add Fuling (茯苓三两) + Baizhu (白术三两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》28条：“服桂枝汤，或下之，仍头项强痛，翕翕发热，无汗，心下满微痛，小便不利者，桂枝去桂加茯苓白术汤主之。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Shentengfan AND Chenchimai THEN add Ren Shen (人参三两) + Shengjiang (生姜加量至四两) + Shaoyao (芍药加量至四两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》62条：“发汗后，身疼痛，脉沉迟者，桂枝加芍药生姜各一两人参三两新加汤主之。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Fanzao AND Xinxiajidong THEN add Longgu (龙骨三两) + Muli (牡蛎三两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》118条：“火逆下之，因烧针烦躁者，桂枝甘草龙骨牡蛎汤主之。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Huanghan AND Liangjingzileng THEN add Huangqi (黄芪五两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《金匮要略·水气病》：“黄汗之病，两胫自冷……桂枝加黄芪汤主之。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Shijingjia AND Shaofuxianji AND Muxuan AND Faluo THEN add Longgu (龙骨三两) + Muli (牡蛎三两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《金匮要略·血痹虚劳病》：“夫失精家，少腹弦急，阴头寒，目眩，发落，脉极虚芤迟……桂枝加龙骨牡蛎汤主之。”</ruleSource>
    </owl:Class>

    <!-- 柴胡黄芩方根 -->
    <owl:Class rdf:about="#Chaihugen">
        <replaceHerbRule rdf:parseType="Literal">
            IF Xiongzhongfan AND Buou THEN replace Banxia+Renshen WITH Gualoushi (栝楼实一枚)
        </replaceHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》96条方后注：“若胸中烦而不呕，去半夏、人参，加栝蒌实一枚。”</ruleSource>

        <replaceHerbRule rdf:parseType="Literal">
            IF Kouke THEN replace Banxia WITH Renshen (人参加量至四两半) + Gualougen (栝蒌根四两)
        </replaceHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》96条方后注：“若渴，去半夏，加人参合前成四两半，栝蒌根四两。”</ruleSource>

        <replaceHerbRule rdf:parseType="Literal">
            IF Futong THEN replace Huangqin WITH Shaoyao (芍药三两)
        </replaceHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》96条方后注：“若腹中痛者，去黄芩，加芍药三两。”</ruleSource>

        <replaceHerbRule rdf:parseType="Literal">
            IF Xiexiapiying THEN replace Dazao WITH Muli (牡蛎四两)
        </replaceHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》96条方后注：“若胁下痞硬，去大枣，加牡蛎四两。”</ruleSource>

        <replaceHerbRule rdf:parseType="Literal">
            IF Xinxiajidong AND Xiaobianbuli THEN replace Huangqin WITH Fuling (茯苓四两)
        </replaceHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》96条方后注：“若心下悸，小便不利者，去黄芩，加茯苓四两。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Buke AND Shenyouweire THEN add Guizhi (桂枝三两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》96条方后注：“若不渴，外有微热者，去人参，加桂枝三两，温覆微汗愈。”</ruleSource>

        <replaceHerbRule rdf:parseType="Literal">
            IF Kesou THEN replace Renshen+Dazao+Shengjiang WITH Wuweizi (五味子半升) + Ganjiang (干姜二两)
        </replaceHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》96条方后注：“若咳者，去人参、大枣、生姜，加五味子半升，干姜二两。”</ruleSource>
    </owl:Class>

    <!-- 干姜附子方根 -->
    <owl:Class rdf:about="#Ganjiangfuzigen">
        <addHerbRule rdf:parseType="Literal">
            IF Miansechi AND Shenfanbuehan THEN add Gancao (甘草二两) + Ganjiang (干姜加量至三两) + Fuzi (附子大者一枚)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》317条：“少阴病，下利清谷，里寒外热，手足厥逆，脉微欲绝，身反不恶寒，其人面色赤……通脉四逆汤主之。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Lizhi AND Wangxue THEN add Renshen (人参一两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》385条：“恶寒脉微而复利，利止亡血也，四逆加人参汤主之。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Fanzao THEN add Fuling (茯苓四两) + Renshen (人参一两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》69条：“发汗，若下之，病仍不解，烦躁者，茯苓四逆汤主之。”</ruleSource>
    </owl:Class>

    <!-- 芍药甘草方根 -->
    <owl:Class rdf:about="#Shaoyaogancaogen">
        <addHerbRule rdf:parseType="Literal">
            IF Ehan THEN add Fuzi (附子一枚，炮)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》68条：“发汗病不解，反恶寒者，虚故也，芍药甘草附子汤主之。”</ruleSource>
    </owl:Class>

    <!-- 栀子香豉方根 -->
    <owl:Class rdf:about="#Zhishigancaogen">
        <addHerbRule rdf:parseType="Literal">
            IF Shaoqi THEN add Gancao (甘草二两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》76条：“发汗吐下后，虚烦不得眠，若剧者，必反复颠倒，心中懊憹，栀子豉汤主之；若少气者，栀子甘草豉汤主之。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Ou THEN add Shengjiang (生姜五两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》76条：“若呕者，栀子生姜豉汤主之。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Xinfan AND Fuman AND Woqibuan THEN add Houpo (厚朴四两) + Zhishi (枳实四枚)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》79条：“伤寒下后，心烦腹满，卧起不安者，栀子厚朴汤主之。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Shenrebuqu AND Weifan THEN add Ganjiang (干姜二两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》80条：“伤寒，医以丸药大下之，身热不去，微烦者，栀子干姜汤主之。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Dabingchaihou AND Laofu THEN add Zhishi (枳实三枚)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》393条：“大病差后，劳复者，枳实栀子豉汤主之。”</ruleSource>
    </owl:Class>

    <!-- 半夏方根 -->
    <owl:Class rdf:about="#Banxiagen">
        <addHerbRule rdf:parseType="Literal">
            IF Xinxiapi AND Gexianyoushui AND Xuanji THEN add Fuling (茯苓三两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《金匮要略·痰饮咳嗽病》：“卒呕吐，心下痞，膈间有水，眩悸者，小半夏加茯苓汤主之。”</ruleSource>
    </owl:Class>

    <!-- ============================================================ -->
    <!-- ============ 第二层：家族级加减规则 ======================== -->
    <!-- ============================================================ -->

    <!-- 桂枝汤类方证家族 -->
    <owl:Class rdf:about="#Guizhitangleifangzheng">
        <addHerbRule rdf:parseType="Literal">
            IF Xiangqiang THEN add Gegen (葛根四两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》14条。项背强几几为葛根药证。适用于所有桂枝汤类方证。</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Chuan THEN add Houpo (厚朴二两) + Xingren (杏仁五十个)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》18、43条。喘为厚朴、杏仁药证。</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Fuzhongjitong THEN add Yitang (饴糖一升) + Shaoyao (芍药加量至六两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》100条：“伤寒，阳脉涩，阴脉弦，法当腹中急痛，先与小建中汤。”小建中汤即桂枝汤倍芍药加饴糖。</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Xulao AND Liji AND Zhubuzu THEN add Huangqi (黄芪一两半) + Yitang (饴糖一升)
        </addHerbRule>
        <ruleSource xml:lang="zh">《金匮要略·血痹虚劳病》：“虚劳里急，诸不足，黄芪建中汤主之。”</ruleSource>
    </owl:Class>

    <!-- 柴胡汤类方证家族 -->
    <owl:Class rdf:about="#Xiaochaihutangleifangzheng">
        <addHerbRule rdf:parseType="Literal">
            IF Ou AND Chaore THEN add Mangxiao (芒硝三两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》104条：“伤寒十三日不解，胸胁满而呕，日晡所发潮热，已而微利……先宜服小柴胡汤以解外，后以柴胡加芒硝汤主之。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Xiongman AND Fanzao AND Xiaobianbuli AND Zhanyu THEN add Longgu + Muli + Guizhi + Fuling + Dahuang + Qianshao
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》107条：“伤寒八九日，下之，胸满烦惊，小便不利，谵语，一身尽重，不可转侧者，柴胡加龙骨牡蛎汤主之。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Xinxiaji AND Yuyuweifan AND (Dabianying OR Xiali) THEN add Dahuang (大黄二两) + Zhishi (枳实四枚) + Shaoyao (芍药三两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》103、165条。心下急、郁郁微烦为胡希恕辨大柴胡汤证之眼目。</ruleSource>
    </owl:Class>

    <!-- 四逆汤类方证家族 -->
    <owl:Class rdf:about="#Sinitangleifangzheng">
        <addHerbRule rdf:parseType="Literal">
            IF Mianchi THEN add Congbai (葱白四茎) + Renshen (人参一两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》314条：“少阴病，下利，白通汤主之。”315条：“少阴病，下利脉微者，与白通汤。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Ganou AND Jueni THEN add Zhudanzhi (猪胆汁一合) + Renniaoli (人尿五合)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》315条：“利不止，厥逆无脉，干呕烦者，白通加猪胆汁汤主之。”</ruleSource>
    </owl:Class>

    <!-- 麻黄汤类方证家族 -->
    <owl:Class rdf:about="#Mahuangtangleifangzheng">
        <addHerbRule rdf:parseType="Literal">
            IF Fanzao THEN add Shigao (石膏如鸡子大) + Shengjiang (生姜三两) + Dazao (大枣十枚)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》38条：“太阳中风，脉浮紧，发热恶寒，身疼痛，不汗出而烦躁者，大青龙汤主之。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Kesou AND Tanduo AND Buke THEN add Banxia (半夏半升) + Wuweizi (五味子半升) + Xixin (细辛三两) + Ganjiang (干姜三两) + Shaoyao (芍药三两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》40条：“伤寒表不解，心下有水气，干呕发热而咳……小青龙汤主之。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Fanzao AND Kesou AND Chuan THEN add Shigao (石膏二两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《金匮要略·肺痿肺痈咳嗽上气病》：“肺胀，咳而上气，烦躁而喘，脉浮者，心下有水，小青龙加石膏汤主之。”</ruleSource>
    </owl:Class>

    <!-- 理中汤类方证家族 -->
    <owl:Class rdf:about="#Lizhongtangleifangzheng">
        <addHerbRule rdf:parseType="Literal">
            IF Xiongzhipiying AND Xialibuzhi AND Fare AND Ehan THEN add Guizhi (桂枝四两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》163条：“太阳病，外证未除，而数下之，遂协热而利，利下不止，心下痞硬，表里不解者，桂枝人参汤主之。”</ruleSource>
    </owl:Class>

    <!-- 五苓散类方证家族 -->
    <owl:Class rdf:about="#Wulingsanleifangzheng">
        <addHerbRule rdf:parseType="Literal">
            IF Huangdan THEN add Yinchenhao (茵陈蒿六两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《金匮要略·黄疸病》：“黄疸病，茵陈五苓散主之。”</ruleSource>
    </owl:Class>

    <!-- 阴证水气类方证家族 -->
    <owl:Class rdf:about="#Yinzhengshuiqileifangzheng">
        <addHerbRule rdf:parseType="Literal">
            IF Kesou THEN add Wuweizi (五味子半升) + Xixin (细辛一两) + Ganjiang (干姜一两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》316条方后注：“若咳者，加五味子半升，细辛一两，干姜一两。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Xiaobianbuli THEN add Fuling (茯苓三两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》316条方后注：“若小便利者，去茯苓。”反推：小便不利者，保留或加茯苓。</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Xiali THEN remove Shaoyao (芍药) + add Ganjiang (干姜二两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》316条方后注：“若下利者，去芍药，加干姜二两。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Ou THEN remove Fuzi (附子) + add Shengjiang (生姜半斤)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》316条方后注：“若呕者，去附子，加生姜，足前为半斤。”</ruleSource>
    </owl:Class>

    <!-- ============================================================ -->
    <!-- ============ 第三层：方证级加减规则 ======================== -->
    <!-- ============================================================ -->

    <!-- 小柴胡汤证（方后注完整加减法） -->
    <owl:Class rdf:about="#Xiaochaihutangzheng">
        <addHerbRule rdf:parseType="Literal">
            IF Xiongzhongfan AND Buou THEN remove Banxia + remove Renshen + add Gualoushi (栝楼实一枚)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》96条方后注：“若胸中烦而不呕，去半夏、人参，加栝蒌实一枚。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Kouke THEN remove Banxia + add Renshen (加至四两半) + add Gualougen (栝蒌根四两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》96条方后注：“若渴，去半夏，加人参合前成四两半，栝蒌根四两。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Futong THEN remove Huangqin + add Shaoyao (芍药三两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》96条方后注：“若腹中痛者，去黄芩，加芍药三两。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Xiexiapiying THEN remove Dazao + add Muli (牡蛎四两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》96条方后注：“若胁下痞硬，去大枣，加牡蛎四两。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Xinxiajidong AND Xiaobianbuli THEN remove Huangqin + add Fuling (茯苓四两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》96条方后注：“若心下悸，小便不利者，去黄芩，加茯苓四两。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Buke AND Shenyouweire THEN remove Renshen + add Guizhi (桂枝三两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》96条方后注：“若不渴，外有微热者，去人参，加桂枝三两，温覆微汗愈。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Kesou THEN remove Renshen + remove Dazao + remove Shengjiang + add Wuweizi (五味子半升) + add Ganjiang (干姜二两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》96条方后注：“若咳者，去人参、大枣、生姜，加五味子半升，干姜二两。”</ruleSource>
    </owl:Class>

    <!-- 四逆散证 -->
    <owl:Class rdf:about="#Sinisanzheng">
        <addHerbRule rdf:parseType="Literal">
            IF Kesou THEN add Wuweizi (五味子五分) + Ganjiang (干姜五分)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》318条方后注：“咳者，加五味子、干姜各五分，并主下利。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Xinxiajidong THEN add Guizhi (桂枝五分)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》318条方后注：“悸者，加桂枝五分。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Xiaobianbuli THEN add Fuling (茯苓五分)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》318条方后注：“小便不利者，加茯苓五分。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Futong THEN add Fuzi (附子一枚，炮令坼)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》318条方后注：“腹中痛者，加附子一枚，炮令坼。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Xielixiazhong THEN add Xiebai (薤白三升)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》318条方后注：“泄利下重者，先以水五升，煮薤白三升，煮取三升，去滓，以散三方寸匕，内汤中，煮取一升半，分温再服。”</ruleSource>
    </owl:Class>

    <!-- 理中汤证 -->
    <owl:Class rdf:about="#Lizhongtangzheng">
        <addHerbRule rdf:parseType="Literal">
            IF Qidongzhe THEN remove Baizhu + add Rougui (桂心四两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》386条方后注：“若脐上筑者，肾气动也，去术加桂四两。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Outu AND Duoyu THEN remove Baizhu + add Shengjiang (生姜三两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》386条方后注：“吐多者，去术加生姜三两。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Xialiduo THEN retain Baizhu (术)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》386条方后注：“下多者还用术。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Ji AND Xinxiajidong THEN add Fuling (茯苓二两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》386条方后注：“悸者加茯苓二两。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Kouke THEN add Baizhu (术，加至四两半)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》386条方后注：“渴欲得水者，加术，足前成四两半。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Futong THEN add Renshen (人参，加至四两半)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》386条方后注：“腹中痛者，加人参，足前成四两半。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Han THEN add Ganjiang (干姜，加至四两半)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》386条方后注：“寒者，加干姜，足前成四两半。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Fuman THEN remove Baizhu + add Fuzi (附子一枚，炮)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》386条方后注：“腹满者，去术，加附子一枚。服汤后，如食顷，饮热粥一升许，微自温，勿发揭衣被。”</ruleSource>
    </owl:Class>

    <!-- 通脉四逆汤证 -->
    <owl:Class rdf:about="#Tongmaisinitangzheng">
        <addHerbRule rdf:parseType="Literal">
            IF Miansechi THEN add Congbai (葱白九茎)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》317条方后注：“面色赤者，加葱九茎。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Futong THEN remove Congbai + add Shaoyao (芍药二两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》317条方后注：“腹中痛者，去葱，加芍药二两。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Outu THEN add Shengjiang (生姜二两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》317条方后注：“呕者，加生姜二两。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Yanhoubuli THEN add Jiegeng (桔梗二两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》317条方后注：“咽痛者，去芍药，加桔梗一两。”</ruleSource>

        <addHerbRule rdf:parseType="Literal">
            IF Lizhi AND Maibuchuzhe THEN remove Jiegeng + add Renshen (人参二两)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》317条方后注：“利止脉不出者，去桔梗，加人参二两。”</ruleSource>
    </owl:Class>

    <!-- ============================================================ -->
    <!-- ============ 合方规则（跨家族，应用层裁定） ================ -->
    <!-- ============================================================ -->

    <owl:Class rdf:about="#HebingRule">
        <rdfs:label xml:lang="zh">合方规则</rdfs:label>
        <rdfs:comment xml:lang="zh">合方规则不挂在单一家族下，由应用层根据两个家族的同时命中裁定。</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Chaihuguizhitangzheng">
        <addHerbRule rdf:parseType="Literal">
            IF match(Chaihutangleifangzheng) AND match(Guizhitangleifangzheng) THEN combine(Xiaochaihutang, Guizhitang, 0.5, 0.5)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》146条：“伤寒六七日，发热微恶寒，支节烦疼，微呕，心下支结，外证未去者，柴胡桂枝汤主之。”即小柴胡汤与桂枝汤各取半量合方。</ruleSource>
    </owl:Class>

    <owl:Class rdf:about="#Guizhimahuanggebantangzheng">
        <addHerbRule rdf:parseType="Literal">
            IF match(Guizhitangleifangzheng) AND match(Mahuangtangleifangzheng) AND Fareehan AND Mianyourese THEN combine(Guizhitang, Mahuangtang, 0.33, 0.33)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》23条：“面色反有热色者，未欲解也，以其不能得小汗出，身必痒，宜桂枝麻黄各半汤。”即桂枝汤与麻黄汤各取三分之一合方。</ruleSource>
    </owl:Class>

    <owl:Class rdf:about="#Guizhiermahuangyitangzheng">
        <addHerbRule rdf:parseType="Literal">
            IF match(Guizhitangleifangzheng) AND match(Mahuangtangleifangzheng) AND Fareehan AND Ruzhuang THEN combine(Guizhitang, Mahuangtang, 0.42, 0.22)
        </addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》25条：“服桂枝汤，大汗出，脉洪大者，与桂枝汤，如前法。若形似疟，一日再发者，汗出必解，宜桂枝二麻黄一汤。”即桂枝汤取十二分之五，麻黄汤取九分之二。</ruleSource>
    </owl:Class>

    <owl:Class rdf:about="#Wutouguizhitangzheng">
        <addHerbRule rdf:parseType="Literal">
            IF match(Wutoutangleifangzheng) AND match(Guizhitangleifangzheng) AND Hanshanfutong AND Shouzuleng THEN combine(Dawutoujian, Guizhitang, 1.0, 1.0)
        </addHerbRule>
        <ruleSource xml:lang="zh">《金匮要略·腹满寒疝宿食病》：“寒疝腹中痛，逆冷，手足不仁，若身疼痛，灸刺诸药不能治，抵当乌头桂枝汤主之。”即大乌头煎与桂枝汤合方。</ruleSource>
    </owl:Class>

</rdf:RDF>