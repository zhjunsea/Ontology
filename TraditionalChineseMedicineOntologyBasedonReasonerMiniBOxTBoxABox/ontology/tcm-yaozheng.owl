                    <owl:someValuesFrom rdf:resource="#Shentengfan"/>
                </owl:Restriction>
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_maixiang"/>
                    <owl:someValuesFrom rdf:resource="#Chenchimai"/>
                </owl:Restriction>
                    </owl:intersectionOf>
                </owl:Class>
                <owl:Class>
