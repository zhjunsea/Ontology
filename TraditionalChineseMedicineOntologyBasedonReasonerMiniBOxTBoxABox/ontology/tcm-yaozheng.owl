    <owl:Class rdf:about="#Yaozheng_Xingren">
        <rdfs:subClassOf rdf:resource="#Yaozheng"/>
        <rdfs:label xml:lang="zh">杏仁药证</rdfs:label>
        <yaozhengDrug rdf:resource="#Xingren"/>
        <yaozhengAction>add</yaozhengAction>
        <rdfs:comment xml:lang="zh">来源方证：Guizhijiahoupoxingzitangzheng、Xiaoqinglongtangzheng</rdfs:comment>
        <classicalText xml:lang="zh">《伤寒论》18条：“喘家作，桂枝汤加厚朴杏子佳。”43条：“太阳病下之微喘者，桂枝加厚朴杏子汤主之。”喘为厚朴、杏仁药证。；《伤寒论》40条方后注：“若喘，去麻黄，加杏仁半升，去皮尖。”</classicalText>
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
