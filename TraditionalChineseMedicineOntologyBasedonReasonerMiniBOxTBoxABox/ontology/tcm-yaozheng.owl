    <owl:Class rdf:about="#Yaozheng_Renshen">
        <rdfs:subClassOf rdf:resource="#Yaozheng"/>
        <rdfs:label xml:lang="zh">人参药证</rdfs:label>
        <yaozhengDrug rdf:resource="#Renshen"/>
        <yaozhengAction>add</yaozhengAction>
        <rdfs:comment xml:lang="zh">来源方证：Fulingsinitangzheng、Guizhixinjiatangzheng、Lizhongtangzheng、Sinijiarenshentangzheng、Tongmaisinitangzheng、Xiaochaihutangzheng</rdfs:comment>
        <classicalText xml:lang="zh">《伤寒论》62条：“发汗后，身疼痛，脉沉迟者，桂枝加芍药生姜各一两人参三两新加汤主之。”；《伤寒论》385条：“恶寒脉微而复利，利止亡血也，四逆加人参汤主之。”即四逆汤加人参一两。；《伤寒论》69条：“发汗，若下之，病仍不解，烦躁者，茯苓四逆汤主之。”即四逆汤加茯苓、人参。；《伤寒论》96条方后注：“若渴，去半夏，加人参合前成四两半，栝蒌根四两。”；《伤寒论》386条方后注：“腹中痛者，加人参，足前成四两半。”；《伤寒论》317条方后注：“利止脉不出者，去桔梗，加人参二两。”</classicalText>
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                <owl:Class>
                    <owl:intersectionOf rdf:parseType="Collection">
                <owl:Restriction>
