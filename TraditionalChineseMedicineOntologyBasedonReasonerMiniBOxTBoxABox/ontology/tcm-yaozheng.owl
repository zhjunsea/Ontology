    <owl:Class rdf:about="#Yaozheng_Xiebai">
        <rdfs:subClassOf rdf:resource="#Yaozheng"/>
        <rdfs:label xml:lang="zh">薤白药证</rdfs:label>
        <yaozhengDrug rdf:resource="#Xiebai"/>
        <yaozhengAction>add</yaozhengAction>
        <rdfs:comment xml:lang="zh">来源方证：Sinisanzheng</rdfs:comment>
        <classicalText xml:lang="zh">《伤寒论》318条方后注：“泄利下重者，先以水五升，煮薤白三升，煮取三升，去滓，以散三方寸匕，内汤中，煮取一升半，分温再服。”</classicalText>
        <owl:equivalentClass>
                <owl:Class>
