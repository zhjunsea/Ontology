    <owl:Class rdf:about="#Yaozheng_Gegen">
        <rdfs:subClassOf rdf:resource="#Yaozheng"/>
        <rdfs:label xml:lang="zh">葛根药证</rdfs:label>
        <yaozhengDrug rdf:resource="#Gegen"/>
        <yaozhengAction>add</yaozhengAction>
        <rdfs:comment xml:lang="zh">来源方证：Guizhijiagegentangzheng</rdfs:comment>
        <classicalText xml:lang="zh">《伤寒论》14条：“太阳病，项背强几几，反汗出恶风者，桂枝加葛根汤主之。”桂枝加葛根汤即桂枝汤加葛根四两。项背强几几为葛根药证。</classicalText>
        <owl:equivalentClass>
