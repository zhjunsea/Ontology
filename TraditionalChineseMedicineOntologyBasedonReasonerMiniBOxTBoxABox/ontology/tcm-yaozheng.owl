    <owl:Class rdf:about="#Yaozheng_Longgu">
        <rdfs:subClassOf rdf:resource="#Yaozheng"/>
        <rdfs:label xml:lang="zh">龙骨药证</rdfs:label>
        <yaozhengDrug rdf:resource="#Longgu"/>
        <yaozhengAction>add</yaozhengAction>
        <rdfs:comment xml:lang="zh">来源方证：Chaihujialonggumulitangzheng、Guizhigancaolonggumulitangzheng、Guizhijialonggumulitangzheng、Guizhiqushaoyaojiashuqimulilonggujiunitangzheng</rdfs:comment>
        <classicalText xml:lang="zh">《伤寒论》112条：“亡阳必惊狂，卧起不安者，桂枝去芍药加蜀漆牡蛎龙骨救逆汤主之。”；《伤寒论》118条：“火逆下之，因烧针烦躁者，桂枝甘草龙骨牡蛎汤主之。”；《金匮要略·血痹虚劳病》：“夫失精家，少腹弦急，阴头寒，目眩，发落……桂枝加龙骨牡蛎汤主之。”；《伤寒论》107条：“伤寒八九日，下之，胸满烦惊，小便不利，谵语，一身尽重，不可转侧者，柴胡加龙骨牡蛎汤主之。”本方即小柴胡汤去甘草，加龙骨、牡蛎、铅丹、桂枝、茯苓、大黄。</classicalText>
        <owl:equivalentClass>
            <owl:Class>
