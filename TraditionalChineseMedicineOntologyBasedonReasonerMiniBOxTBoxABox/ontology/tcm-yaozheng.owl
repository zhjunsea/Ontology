        <rdfs:label xml:lang="zh">麻黄药证</rdfs:label>
        <yaozhengDrug rdf:resource="#Mahuang"/>
        <yaozhengAction>add</yaozhengAction>
        <rdfs:comment xml:lang="zh">来源方证：Fangjihuangqitangzheng</rdfs:comment>
        <classicalText xml:lang="zh">《金匮要略·痉湿暍病脉证治》：“喘者加麻黄半两。”</classicalText>
        <owl:equivalentClass>
