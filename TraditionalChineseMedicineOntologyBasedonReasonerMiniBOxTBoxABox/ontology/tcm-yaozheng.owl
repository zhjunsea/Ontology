    <owl:Class rdf:about="#Yaozheng_Gancao">
        <rdfs:subClassOf rdf:resource="#Yaozheng"/>
        <rdfs:label xml:lang="zh">甘草药证</rdfs:label>
        <yaozhengDrug rdf:resource="#Gancao"/>
        <yaozhengAction>add</yaozhengAction>
        <rdfs:comment xml:lang="zh">来源方证：Tongmaisinitangzheng、Zhizigancaochitangzheng</rdfs:comment>
        <classicalText xml:lang="zh">《伤寒论》76条：“若少气者，栀子甘草豉汤主之。”即栀子豉汤加甘草二两。；《伤寒论》317条：“少阴病，下利清谷，里寒外热，手足厥逆，脉微欲绝，身反不恶寒，其人面色赤……通脉四逆汤主之。”通脉四逆汤即四逆汤重用干姜、附子（大者一枚）。</classicalText>
        <owl:equivalentClass>
