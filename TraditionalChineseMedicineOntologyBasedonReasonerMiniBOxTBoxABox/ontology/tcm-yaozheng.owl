    <owl:Class rdf:about="#JiYaozheng_Gancao">
        <rdfs:subClassOf rdf:resource="#Yaozheng"/>
        <rdfs:label xml:lang="zh">甘草忌药证</rdfs:label>
        <yaozhengDrug rdf:resource="#Gancao"/>
        <yaozhengAction>remove</yaozhengAction>
        <rdfs:comment xml:lang="zh">来源方证：Baitongtangzheng、Chaihujialonggumulitangzheng、Dachaihutangzheng</rdfs:comment>
        <classicalText xml:lang="zh">《伤寒论》107条：“伤寒八九日，下之，胸满烦惊，小便不利，谵语，一身尽重，不可转侧者，柴胡加龙骨牡蛎汤主之。”本方即小柴胡汤去甘草，加龙骨、牡蛎、铅丹、桂枝、茯苓、大黄。；《伤寒论》103、165条。心下急、郁郁微烦为胡希恕辨大柴胡汤证之眼目。大柴胡汤即小柴胡汤去人参、甘草，加芍药、枳实、大黄。；《伤寒论》314条：“少阴病，下利，白通汤主之。”315条：“少阴病，下利脉微者，与白通汤。”白通汤即四逆汤去甘草，加葱白四茎（干姜减为一两）。</classicalText>
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                <owl:Class>
                    <owl:intersectionOf rdf:parseType="Collection">
