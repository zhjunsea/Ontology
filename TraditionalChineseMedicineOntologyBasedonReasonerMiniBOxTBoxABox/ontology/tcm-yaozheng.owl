        <yaozhengAction>remove</yaozhengAction>
        <rdfs:comment xml:lang="zh">来源方证：Xiaoqinglongtangzheng</rdfs:comment>
        <classicalText xml:lang="zh">《伤寒论》40条：“伤寒表不解，心下有水气，干呕发热而咳……小青龙汤主之。”小青龙汤即麻黄汤去杏仁，加芍药、细辛、干姜、五味子、半夏。</classicalText>
        <owl:equivalentClass>
                <owl:Class>
                    <owl:intersectionOf rdf:parseType="Collection">
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Kesou"/>
                </owl:Restriction>
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Tanduo"/>
                </owl:Restriction>
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Buke"/>
                </owl:Restriction>
                    </owl:intersectionOf>
                </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    <owl:Class rdf:about="#Yaozheng_Guizhi">
        <rdfs:subClassOf rdf:resource="#Yaozheng"/>
        <rdfs:label xml:lang="zh">桂枝药证</rdfs:label>
        <yaozhengDrug rdf:resource="#Guizhi"/>
        <yaozhengAction>add</yaozhengAction>
        <rdfs:comment xml:lang="zh">来源方证：Chaihujialonggumulitangzheng、Fangjihuangqitangzheng、Guizhijiaguitangzheng、Guizhirenshentangzheng、Guizhitangzheng、Lizhongtangzheng、Sinisanzheng、Xiaochaihutangzheng</rdfs:comment>
        <classicalText xml:lang="zh">《伤寒论》117条：“气从少腹上冲心者，与桂枝加桂汤。”即桂枝汤更加桂二两。；《伤寒论》107条：“伤寒八九日，下之，胸满烦惊，小便不利，谵语，一身尽重，不可转侧者，柴胡加龙骨牡蛎汤主之。”本方即小柴胡汤去甘草，加龙骨、牡蛎、铅丹、桂枝、茯苓、大黄。；《伤寒论》163条：“太阳病，外证未除，而数下之，遂协热而利，利下不止，心下痞硬，表里不解者，桂枝人参汤主之。”即理中汤加桂枝四两（甘草加至四两）。；《伤寒论》96条方后注：“若不渴，外有微热者，去人参，加桂枝三两，温覆微汗愈。”；《伤寒论》318条方后注：“悸者，加桂枝五分。”；《伤寒论》386条方后注：“若脐上筑者，肾气动也，去术加桂四两。”脐上筑属冲气上逆，加桂取桂枝平冲降逆之义（参117条桂枝加桂汤）。；《金匮要略·痉湿暍病脉证治》：“气上冲者加桂枝三分。”；《伤寒论》12条：「太阳中风，阳浮而阴弱……啬啬恶寒，淅淅恶风，翕翕发热，鼻鸣干呕者，桂枝汤主之。」汗出、恶风、脉浮为桂枝药证。（原 GuizhiZheng 类并入，避免同一药证重复定义）</classicalText>
