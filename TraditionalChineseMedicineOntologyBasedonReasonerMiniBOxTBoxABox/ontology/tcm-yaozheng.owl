        <rdfs:label xml:lang="zh">人尿药证</rdfs:label>
        <yaozhengDrug rdf:resource="#Renniao"/>
        <yaozhengAction>add</yaozhengAction>
        <rdfs:comment xml:lang="zh">来源方证：Baitongjiazhudanzhitangzheng</rdfs:comment>
        <classicalText xml:lang="zh">《伤寒论》315条：“利不止，厥逆无脉，干呕烦者，白通加猪胆汁汤主之。”即白通汤加人尿五合、猪胆汁一合。</classicalText>
        <owl:equivalentClass>
