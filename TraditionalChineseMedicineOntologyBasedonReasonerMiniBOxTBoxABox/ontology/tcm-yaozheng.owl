                    <owl:someValuesFrom rdf:resource="#Chuan"/>
                </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    <owl:Class rdf:about="#Yaozheng_Xixin">
