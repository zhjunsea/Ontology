    <owl:Class rdf:about="#Yaozheng_Huangqi">
        <rdfs:subClassOf rdf:resource="#Yaozheng"/>
        <rdfs:label xml:lang="zh">黄芪药证</rdfs:label>
        <yaozhengDrug rdf:resource="#Huangqi"/>
        <yaozhengAction>add</yaozhengAction>
        <rdfs:comment xml:lang="zh">来源方证：Guizhijiahuangqitangzheng、Huangqijianzhongtangzheng</rdfs:comment>
        <classicalText xml:lang="zh">《金匮要略·水气病》：“黄汗之病，两胫自冷……桂枝加黄芪汤主之。”；《金匮要略·血痹虚劳病》：“虚劳里急，诸不足，黄芪建中汤主之。”黄芪建中汤即小建中汤加黄芪，故亦倍芍药、加饴糖。</classicalText>
