                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Wangxue"/>
                </owl:Restriction>
                    </owl:intersectionOf>
                </owl:Class>
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Fanzao"/>
                </owl:Restriction>
                <owl:Restriction>
