    <owl:Class rdf:about="#Yaozheng_Yinchenhao">
        <rdfs:subClassOf rdf:resource="#Yaozheng"/>
        <rdfs:label xml:lang="zh">茵陈蒿药证</rdfs:label>
        <yaozhengDrug rdf:resource="#Yinchenhao"/>
        <yaozhengAction>add</yaozhengAction>
        <rdfs:comment xml:lang="zh">来源方证：Yinchenwulingsanzheng</rdfs:comment>
        <classicalText xml:lang="zh">《金匮要略·黄疸病》：“黄疸病，茵陈五苓散主之。”方：茵陈蒿末十分，五苓散五分，二物和，先食饮方寸匕，日三服。</classicalText>
        <owl:equivalentClass>
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Huangdan"/>
