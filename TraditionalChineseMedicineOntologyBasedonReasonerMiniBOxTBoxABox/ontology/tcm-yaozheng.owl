    <owl:Class rdf:about="#Yaozheng_Wuweizi">
        <rdfs:subClassOf rdf:resource="#Yaozheng"/>
        <rdfs:label xml:lang="zh">五味子药证</rdfs:label>
        <yaozhengDrug rdf:resource="#Wuweizi"/>
        <yaozhengAction>add</yaozhengAction>
        <rdfs:comment xml:lang="zh">来源方证：Sinisanzheng、Xiaochaihutangzheng、Xiaoqinglongtangzheng、Zhenwutangzheng</rdfs:comment>
        <classicalText xml:lang="zh">《伤寒论》316条方后注：“若咳者，加五味子半升，细辛一两，干姜一两。”；《伤寒论》96条方后注：“若咳者，去人参、大枣、生姜，加五味子半升，干姜二两。”；《伤寒论》318条方后注：“咳者，加五味子、干姜各五分，并主下利。”；《伤寒论》40条：“伤寒表不解，心下有水气，干呕发热而咳……小青龙汤主之。”小青龙汤即麻黄汤去杏仁，加芍药、细辛、干姜、五味子、半夏。</classicalText>
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
