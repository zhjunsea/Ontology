    <owl:Class rdf:about="#Yaozheng_Yitang">
        <rdfs:subClassOf rdf:resource="#Yaozheng"/>
        <rdfs:label xml:lang="zh">饴糖药证</rdfs:label>
        <yaozhengDrug rdf:resource="#Yitang"/>
        <yaozhengAction>add</yaozhengAction>
        <rdfs:comment xml:lang="zh">来源方证：Huangqijianzhongtangzheng、Xiaojianzhongtangzheng</rdfs:comment>
        <classicalText xml:lang="zh">《伤寒论》100条：“伤寒，阳脉涩，阴脉弦，法当腹中急痛，先与小建中汤。”小建中汤即桂枝汤倍芍药加饴糖。；《金匮要略·血痹虚劳病》：“虚劳里急，诸不足，黄芪建中汤主之。”黄芪建中汤即小建中汤加黄芪，故亦倍芍药、加饴糖。</classicalText>
        <owl:equivalentClass>
            <owl:Class>
