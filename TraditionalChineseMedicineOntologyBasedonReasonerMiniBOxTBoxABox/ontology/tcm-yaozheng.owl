                    <owl:someValuesFrom rdf:resource="#Xulao"/>
                </owl:Restriction>
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Liji"/>
                </owl:Restriction>
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Zhubuzu"/>
                </owl:Restriction>
                    </owl:intersectionOf>
                </owl:Class>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    <owl:Class rdf:about="#Yaozheng_Zhishi">
        <rdfs:subClassOf rdf:resource="#Yaozheng"/>
        <rdfs:label xml:lang="zh">枳实药证</rdfs:label>
        <yaozhengDrug rdf:resource="#Zhishi"/>
        <yaozhengAction>add</yaozhengAction>
        <rdfs:comment xml:lang="zh">来源方证：Dachaihutangzheng、Zhizihoupotangzheng</rdfs:comment>
        <classicalText xml:lang="zh">《伤寒论》103、165条。心下急、郁郁微烦为胡希恕辨大柴胡汤证之眼目。大柴胡汤即小柴胡汤去人参、甘草，加芍药、枳实、大黄。；《伤寒论》79条：“伤寒下后，心烦腹满，卧起不安者，栀子厚朴汤主之。”即栀子豉汤去香豉，加厚朴、枳实。</classicalText>
