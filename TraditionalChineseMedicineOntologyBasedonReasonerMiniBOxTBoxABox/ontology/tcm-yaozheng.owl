    <owl:Class rdf:about="#Yaozheng_Shuqi">
        <rdfs:subClassOf rdf:resource="#Yaozheng"/>
        <rdfs:label xml:lang="zh">蜀漆药证</rdfs:label>
        <yaozhengDrug rdf:resource="#Shuqi"/>
        <yaozhengAction>add</yaozhengAction>
        <rdfs:comment xml:lang="zh">来源方证：Guizhiqushaoyaojiashuqimulilonggujiunitangzheng</rdfs:comment>
        <classicalText xml:lang="zh">《伤寒论》112条：“亡阳必惊狂，卧起不安者，桂枝去芍药加蜀漆牡蛎龙骨救逆汤主之。”</classicalText>
