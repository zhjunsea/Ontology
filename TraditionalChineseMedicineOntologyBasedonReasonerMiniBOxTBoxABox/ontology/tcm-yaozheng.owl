<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns="http://www.tcm-classics.org/jingfang#"
         xml:base="http://www.tcm-classics.org/jingfang#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

    <owl:Ontology rdf:about="http://www.tcm-classics.org/jingfang/yaozheng">
        <rdfs:label xml:lang="zh">药证模块</rdfs:label>
        <rdfs:comment xml:lang="zh">药证类定义。药证的唯一经典来源为张仲景《伤寒论》《金匮要略》各方方后注加减法：方后注「若X者加Y」⟹ X 为 Y 之药证；「若X者去Y」⟹ X 为 Y 之忌药证。本模块由 rules.owl 的 84 条方后注加减规则按药物聚合转写而成，每条均附 classicalText 原文出处，无一条出于编造。条件一律以四诊（症状/脉象/舌象/腹证）表达；八纲 token「寒」展开为其四诊子类之析取（铁律 62）。</rdfs:comment>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/core"/>
        <owl:versionInfo>2.0</owl:versionInfo>
    </owl:Ontology>

    <owl:AnnotationProperty rdf:about="#yaozhengDrug">
        <rdfs:label xml:lang="zh">药证主治药物</rdfs:label>
        <rdfs:comment xml:lang="zh">药证类所对应之药物（IRI 取自 fangji-yaowu.sql / tcm-yaowu-abox.owl）。不参与推理，供应用层读取。</rdfs:comment>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="#yaozhengAction">
        <rdfs:label xml:lang="zh">药证作用</rdfs:label>
        <rdfs:comment xml:lang="zh">add=加药（药证/适应证）；remove=去药（忌药证/禁忌证）。</rdfs:comment>
    </owl:AnnotationProperty>

    <owl:Class rdf:about="#Yaozheng_Baizhu">
        <rdfs:subClassOf rdf:resource="#Yaozheng"/>
        <rdfs:label xml:lang="zh">白术药证</rdfs:label>
        <yaozhengDrug rdf:resource="#Baizhu"/>
        <yaozhengAction>add</yaozhengAction>
        <rdfs:comment xml:lang="zh">来源方证：Dangguishengjiangyangroutangzheng、Guizhiquguijiafulingbaizhutangzheng、Lizhongtangzheng</rdfs:comment>
        <classicalText xml:lang="zh">《伤寒论》28条：“心下满微痛，小便不利者，桂枝去桂加茯苓白术汤主之。”；《伤寒论》386条方后注：“下多者还用术。”；《伤寒论》386条方后注：“渴欲得水者，加术，足前成四两半。”；《金匮要略·腹满寒疝宿食病》：“痛多而呕者，加橘皮二两、白术一两。”橘皮即陈皮，本体以 Chenpi 收录。</classicalText>
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                <owl:Class>
                    <owl:intersectionOf rdf:parseType="Collection">
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Xinxiaman"/>
                </owl:Restriction>
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Xiaobianbuli"/>
                </owl:Restriction>
                    </owl:intersectionOf>
                </owl:Class>
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Xiali"/>
                </owl:Restriction>
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Kouke"/>
                </owl:Restriction>
                <owl:Class>
                    <owl:intersectionOf rdf:parseType="Collection">
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Futong"/>
                </owl:Restriction>
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Ou"/>
                </owl:Restriction>
                    </owl:intersectionOf>
                </owl:Class>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    <owl:Class rdf:about="#Yaozheng_Banxia">
        <rdfs:subClassOf rdf:resource="#Yaozheng"/>
        <rdfs:label xml:lang="zh">半夏药证</rdfs:label>
        <yaozhengDrug rdf:resource="#Banxia"/>
        <yaozhengAction>add</yaozhengAction>
        <rdfs:comment xml:lang="zh">来源方证：Baizhusanzheng、Houpoqiwutangzheng、Xiaoqinglongtangzheng、Zhuyetangzheng</rdfs:comment>
        <classicalText xml:lang="zh">《伤寒论》40条：“伤寒表不解，心下有水气，干呕发热而咳……小青龙汤主之。”小青龙汤即麻黄汤去杏仁，加芍药、细辛、干姜、五味子、半夏。；《金匮要略·腹满寒疝宿食病》：“呕者加半夏五合。”；《金匮要略·妇人产后病脉证治》：“呕者，加半夏半升洗。”；《金匮要略·妇人妊娠病脉证治》白术散方后注：“心烦吐痛，不能食饮，加细辛一两、半夏大者二十枚。”</classicalText>
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                <owl:Class>
                    <owl:intersectionOf rdf:parseType="Collection">
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Kesou"/>
                </owl:Restriction>
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Tanduo"/>
                </owl:Restriction>
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Buke"/>
                </owl:Restriction>
                    </owl:intersectionOf>
                </owl:Class>
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Ou"/>
                </owl:Restriction>
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Ou"/>
                </owl:Restriction>
                <owl:Class>
                    <owl:intersectionOf rdf:parseType="Collection">
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Xinfan"/>
                </owl:Restriction>
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Tu"/>
                </owl:Restriction>
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Bunengshiyin"/>
                </owl:Restriction>
                    </owl:intersectionOf>
                </owl:Class>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    <owl:Class rdf:about="#Yaozheng_Chenpi">
        <rdfs:subClassOf rdf:resource="#Yaozheng"/>
        <rdfs:label xml:lang="zh">陈皮药证</rdfs:label>
        <yaozhengDrug rdf:resource="#Chenpi"/>
        <yaozhengAction>add</yaozhengAction>
        <rdfs:comment xml:lang="zh">来源方证：Dangguishengjiangyangroutangzheng</rdfs:comment>
        <classicalText xml:lang="zh">《金匮要略·腹满寒疝宿食病》：“痛多而呕者，加橘皮二两、白术一两。”橘皮即陈皮，本体以 Chenpi 收录。</classicalText>
        <owl:equivalentClass>
                <owl:Class>
                    <owl:intersectionOf rdf:parseType="Collection">
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Futong"/>
                </owl:Restriction>
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Ou"/>
                </owl:Restriction>
                    </owl:intersectionOf>
                </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    <owl:Class rdf:about="#Yaozheng_Chuanxiong">
        <rdfs:subClassOf rdf:resource="#Yaozheng"/>
        <rdfs:label xml:lang="zh">川芎药证</rdfs:label>
        <yaozhengDrug rdf:resource="#Chuanxiong"/>
        <yaozhengAction>add</yaozhengAction>
        <rdfs:comment xml:lang="zh">来源方证：Baizhusanzheng</rdfs:comment>
        <classicalText xml:lang="zh">《金匮要略·妇人妊娠病脉证治》白术散方后注：“心下毒痛，倍加川芎。”</classicalText>
        <owl:equivalentClass>
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Xinxiaodutong"/>
                </owl:Restriction>
        </owl:equivalentClass>
    </owl:Class>
    <owl:Class rdf:about="#Yaozheng_Congbai">
        <rdfs:subClassOf rdf:resource="#Yaozheng"/>
        <rdfs:label xml:lang="zh">葱白药证</rdfs:label>
        <yaozhengDrug rdf:resource="#Congbai"/>
        <yaozhengAction>add</yaozhengAction>
        <rdfs:comment xml:lang="zh">来源方证：Baitongtangzheng、Tongmaisinitangzheng</rdfs:comment>
        <classicalText xml:lang="zh">《伤寒论》314条：“少阴病，下利，白通汤主之。”315条：“少阴病，下利脉微者，与白通汤。”白通汤即四逆汤去甘草，加葱白四茎（干姜减为一两）。；《伤寒论》317条方后注：“面色赤者，加葱九茎。”</classicalText>
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                <owl:Class>
                    <owl:intersectionOf rdf:parseType="Collection">
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Xiali"/>
                </owl:Restriction>
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_maixiang"/>
                    <owl:someValuesFrom rdf:resource="#Weimai"/>
                </owl:Restriction>
                    </owl:intersectionOf>
                </owl:Class>
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Mianchi"/>
                </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    <owl:Class rdf:about="#Yaozheng_Dahuang">
        <rdfs:subClassOf rdf:resource="#Yaozheng"/>
        <rdfs:label xml:lang="zh">大黄药证</rdfs:label>
        <yaozhengDrug rdf:resource="#Dahuang"/>
        <yaozhengAction>add</yaozhengAction>
        <rdfs:comment xml:lang="zh">来源方证：Chaihujialonggumulitangzheng、Dachaihutangzheng、Guizhijiadahuangtangzheng、Zhishizhizichitangzheng</rdfs:comment>
        <classicalText xml:lang="zh">《伤寒论》279条：“大实痛者，桂枝加大黄汤主之。”即桂枝加芍药汤再加大黄二两。；《伤寒论》107条：“伤寒八九日，下之，胸满烦惊，小便不利，谵语，一身尽重，不可转侧者，柴胡加龙骨牡蛎汤主之。”本方即小柴胡汤去甘草，加龙骨、牡蛎、铅丹、桂枝、茯苓、大黄。；《伤寒论》103、165条。心下急、郁郁微烦为胡希恕辨大柴胡汤证之眼目。大柴胡汤即小柴胡汤去人参、甘草，加芍药、枳实、大黄。；《伤寒论》393条方后注：“若有宿食者，内大黄如博棋子五六枚，服之愈。”</classicalText>
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                <owl:Class>
                    <owl:intersectionOf rdf:parseType="Collection">
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Futong"/>
                </owl:Restriction>
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Juan"/>
                </owl:Restriction>
                    </owl:intersectionOf>
                </owl:Class>
                <owl:Class>
                    <owl:intersectionOf rdf:parseType="Collection">
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Xiongman"/>
                </owl:Restriction>
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Fanzao"/>
                </owl:Restriction>
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Xiaobianbuli"/>
                </owl:Restriction>
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Zhanyu"/>
                </owl:Restriction>
                    </owl:intersectionOf>
                </owl:Class>
                <owl:Class>
                    <owl:intersectionOf rdf:parseType="Collection">
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Xinxiaji"/>
                </owl:Restriction>
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Yuyuweifan"/>
                </owl:Restriction>
                <owl:Class>
                    <owl:unionOf rdf:parseType="Collection">
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Dabianying"/>
                </owl:Restriction>
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Xiali"/>
                </owl:Restriction>
                    </owl:unionOf>
                </owl:Class>
                    </owl:intersectionOf>
                </owl:Class>
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Sushi"/>
                </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    <owl:Class rdf:about="#Yaozheng_Dazao">
        <rdfs:subClassOf rdf:resource="#Yaozheng"/>
        <rdfs:label xml:lang="zh">大枣药证</rdfs:label>
        <yaozhengDrug rdf:resource="#Dazao"/>
        <yaozhengAction>add</yaozhengAction>
        <rdfs:comment xml:lang="zh">来源方证：Daqinglongtangzheng</rdfs:comment>
        <classicalText xml:lang="zh">《伤寒论》38条：“太阳中风，脉浮紧，发热恶寒，身疼痛，不汗出而烦躁者，大青龙汤主之。”大青龙汤即麻黄汤加石膏、生姜、大枣。</classicalText>
        <owl:equivalentClass>
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Fanzao"/>
                </owl:Restriction>
        </owl:equivalentClass>
    </owl:Class>
    <owl:Class rdf:about="#Yaozheng_Fuling">
        <rdfs:subClassOf rdf:resource="#Yaozheng"/>
        <rdfs:label xml:lang="zh">茯苓药证</rdfs:label>
        <yaozhengDrug rdf:resource="#Fuling"/>
        <yaozhengAction>add</yaozhengAction>
        <rdfs:comment xml:lang="zh">来源方证：Chaihujialonggumulitangzheng、Fulingsinitangzheng、Guizhiquguijiafulingbaizhutangzheng、Lizhongtangzheng、Sinisanzheng、Xiaobanxiajiafulingtangzheng、Xiaochaihutangzheng、Xiaoqinglongtangzheng、Zhenwutangzheng</rdfs:comment>
        <classicalText xml:lang="zh">《伤寒论》28条：“心下满微痛，小便不利者，桂枝去桂加茯苓白术汤主之。”；《伤寒论》107条：“伤寒八九日，下之，胸满烦惊，小便不利，谵语，一身尽重，不可转侧者，柴胡加龙骨牡蛎汤主之。”本方即小柴胡汤去甘草，加龙骨、牡蛎、铅丹、桂枝、茯苓、大黄。；《伤寒论》69条：“发汗，若下之，病仍不解，烦躁者，茯苓四逆汤主之。”即四逆汤加茯苓、人参。；《伤寒论》316条方后注：“若小便利者，去茯苓。”真武汤本有茯苓三两，故小便不利者保留茯苓，非另加。；《金匮要略·痰饮咳嗽病》：“卒呕吐，心下痞，膈间有水，眩悸者，小半夏加茯苓汤主之。”即小半夏汤加茯苓四两。；《伤寒论》96条方后注：“若心下悸，小便不利者，去黄芩，加茯苓四两。”；《伤寒论》318条方后注：“小便不利者，加茯苓五分。”；《伤寒论》386条方后注：“悸者加茯苓二两。”；《伤寒论》40条方后注：“若小便不利，少腹满者，去麻黄，加茯苓四两。”</classicalText>
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                <owl:Class>
                    <owl:intersectionOf rdf:parseType="Collection">
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Xinxiaman"/>
                </owl:Restriction>
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Xiaobianbuli"/>
                </owl:Restriction>
                    </owl:intersectionOf>
                </owl:Class>
                <owl:Class>
                    <owl:intersectionOf rdf:parseType="Collection">
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Xiongman"/>
                </owl:Restriction>
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Fanzao"/>
                </owl:Restriction>
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Xiaobianbuli"/>
                </owl:Restriction>
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Zhanyu"/>
                </owl:Restriction>
                    </owl:intersectionOf>
                </owl:Class>
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Fanzao"/>
                </owl:Restriction>
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Xiaobianbuli"/>
                </owl:Restriction>
                <owl:Class>
                    <owl:intersectionOf rdf:parseType="Collection">
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Xinxiapi"/>
                </owl:Restriction>
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Gejianyoushui"/>
                </owl:Restriction>
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Xuanji"/>
                </owl:Restriction>
                    </owl:intersectionOf>
                </owl:Class>
