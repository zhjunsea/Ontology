    <owl:Class rdf:about="#Yaozheng_Houpo">
        <rdfs:subClassOf rdf:resource="#Yaozheng"/>
        <rdfs:label xml:lang="zh">厚朴药证</rdfs:label>
        <yaozhengDrug rdf:resource="#Houpo"/>
        <yaozhengAction>add</yaozhengAction>
        <rdfs:comment xml:lang="zh">来源方证：Guizhijiahoupoxingzitangzheng、Zhizihoupotangzheng</rdfs:comment>
        <classicalText xml:lang="zh">《伤寒论》18条：“喘家作，桂枝汤加厚朴杏子佳。”43条：“太阳病下之微喘者，桂枝加厚朴杏子汤主之。”喘为厚朴、杏仁药证。；《伤寒论》79条：“伤寒下后，心烦腹满，卧起不安者，栀子厚朴汤主之。”即栀子豉汤去香豉，加厚朴、枳实。</classicalText>
