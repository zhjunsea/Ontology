    <owl:Class rdf:about="#Yaozheng_Mangxiao">
        <rdfs:subClassOf rdf:resource="#Yaozheng"/>
        <rdfs:label xml:lang="zh">芒硝药证</rdfs:label>
        <yaozhengDrug rdf:resource="#Mangxiao"/>
        <yaozhengAction>add</yaozhengAction>
        <rdfs:comment xml:lang="zh">来源方证：Chaihujiamangxiaotangzheng</rdfs:comment>
        <classicalText xml:lang="zh">《伤寒论》104条：“伤寒十三日不解，胸胁满而呕，日晡所发潮热，已而微利……先宜服小柴胡汤以解外，后以柴胡加芒硝汤主之。”柴胡加芒硝汤方：芒硝二两。</classicalText>
        <owl:equivalentClass>
                <owl:Class>
                    <owl:intersectionOf rdf:parseType="Collection">
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Ou"/>
                </owl:Restriction>
                <owl:Restriction>
                    <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                    <owl:someValuesFrom rdf:resource="#Chaore"/>
                </owl:Restriction>
                    </owl:intersectionOf>
                </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    <owl:Class rdf:about="#Yaozheng_Muli">
        <rdfs:subClassOf rdf:resource="#Yaozheng"/>
        <rdfs:label xml:lang="zh">牡蛎药证</rdfs:label>
        <yaozhengDrug rdf:resource="#Muli"/>
        <yaozhengAction>add</yaozhengAction>
        <rdfs:comment xml:lang="zh">来源方证：Chaihujialonggumulitangzheng、Guizhigancaolonggumulitangzheng、Guizhijialonggumulitangzheng、Guizhiqushaoyaojiashuqimulilonggujiunitangzheng、Xiaochaihutangzheng</rdfs:comment>
        <classicalText xml:lang="zh">《伤寒论》112条：“亡阳必惊狂，卧起不安者，桂枝去芍药加蜀漆牡蛎龙骨救逆汤主之。”；《伤寒论》118条：“火逆下之，因烧针烦躁者，桂枝甘草龙骨牡蛎汤主之。”；《金匮要略·血痹虚劳病》：“夫失精家，少腹弦急，阴头寒，目眩，发落……桂枝加龙骨牡蛎汤主之。”；《伤寒论》107条：“伤寒八九日，下之，胸满烦惊，小便不利，谵语，一身尽重，不可转侧者，柴胡加龙骨牡蛎汤主之。”本方即小柴胡汤去甘草，加龙骨、牡蛎、铅丹、桂枝、茯苓、大黄。；《伤寒论》96条方后注：“若胁下痞硬，去大枣，加牡蛎四两。”</classicalText>
