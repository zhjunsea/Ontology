<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns="http://www.tcm-classics.org/jingfang#"
         xml:base="http://www.tcm-classics.org/jingfang#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

    <owl:Ontology rdf:about="http://www.tcm-classics.org/jingfang/all">
        <rdfs:label xml:lang="zh">经方加载本体</rdfs:label>
        <rdfs:comment xml:lang="zh">八纲、六经、方证、兼夹证、药证定义。</rdfs:comment>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/core"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/zhengzhuang"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/fuzheng"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/maixiang"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/shexiang"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/fangji"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/yaowu"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/yaozheng"/>
        <!-- 互斥模块：四诊互斥关系（owl:disjointWith），供「追问过滤」与「四诊参合矛盾检测」 -->
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/huchi"/>
        <!--方证本体 -->
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/fanggen"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/hebing"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/rules"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/zabing"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/duli"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/jianjia"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/taiyang"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/jueyin"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/shaoyin_taiyin"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/shaoyang_yangming"/>
        
        <!-- ABox：已从 TBox 入口移出，改由 tcm-all-abox.owl 单独加载（2026-09-20）
             原因：OntologyService.gettBoxOntology() 会合并「所有已加载本体」的全部公理，
             ABox 混入后 Openllet 分类会对每个类做 ABox 一致性检查
             （jstack: CDOptimizedTaxonomyBuilder.checkSatisfiability → ABoxImpl.isConsistent），
             988 个体使 CLASS_HIERARCHY 达 345s。移出后实测 345s → 47s。
             ABox 仍由 OntologyFramework 单独加载，供 collectIndividualTypes 查表，诊断链路不变。
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/shexiang-abox"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/zhengzhuang-abox"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/maixiang-abox"/>
        -->
        <!-- 下面的已经放入到Mysql数据库中，不再在本体中加载
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/fangji-abox"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/yaowu-abox"/>
        -->
        <!-- SKOS 四诊同义词词表（tcm-zhengzhuang_skos.ttl）
             由 OntologyService 的 TTL 扫描 + SimpleIRIMapper 解析；
             catalog-v001.xml 同步登记，供 Protégé 打开时定位。
             覆盖四诊全部通道：症状 593 + 脉象 68 + 舌象 72 + 腹证 4 = 737 个 skos:Concept。
             SkosSynonymReader.buildSynonymDictionary() 依赖 getInstances(skos:Concept) 建词典；
             SymptomCatalog 直接解析该 TTL 供症状匹配使用（不依赖推理机）。 -->
        <owl:imports rdf:resource="http://www.tcm-classics.org/skos/zhengzhuang"/>

        <owl:versionInfo>1.0</owl:versionInfo>
    </owl:Ontology>

</rdf:RDF>