    <!-- ============ 时痛 ============ -->
		<owl:Class rdf:about="#Shitong">
		    <rdfs:label xml:lang="zh">时痛</rdfs:label>
		    <rdfs:subClassOf rdf:resource="#Futong"/>
		    <rdfs:comment xml:lang="zh">疼痛时作时止，非持续疼痛。《伤寒论》279条：“本太阳病，医反下之，因尔腹满时痛者，属太阴也，桂枝加芍药汤主之。”此为太阴脾络不和、气血时通时阻之象，与持续腹痛（Futong）有别。</rdfs:comment>
		</owl:Class>

