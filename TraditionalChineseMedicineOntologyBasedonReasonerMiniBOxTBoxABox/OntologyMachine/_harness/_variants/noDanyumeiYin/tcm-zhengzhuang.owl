    <owl:Class rdf:about="#Kouku"><rdfs:subClassOf rdf:resource="#Zhengzhuang"/><rdfs:subClassOf rdf:resource="#Banbiaobanli"/><rdfs:label xml:lang="zh">口苦</rdfs:label></owl:Class>
    <owl:Class rdf:about="#Kouburen"><rdfs:subClassOf rdf:resource="#Zhengzhuang"/><rdfs:label xml:lang="zh">口不仁</rdfs:label></owl:Class>
    <owl:Class rdf:about="#Kousheburen"><rdfs:subClassOf rdf:resource="#Zhengzhuang"/><rdfs:label xml:lang="zh">口舌不仁</rdfs:label></owl:Class>
