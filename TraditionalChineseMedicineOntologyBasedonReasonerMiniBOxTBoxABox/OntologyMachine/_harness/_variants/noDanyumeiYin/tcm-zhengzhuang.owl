    <!-- ==================== 口咽类 ==================== -->
    <owl:Class rdf:about="#Kouke"><rdfs:subClassOf rdf:resource="#Zhengzhuang"/><rdfs:label xml:lang="zh">口渴</rdfs:label><rdfs:comment xml:lang="zh">注：不设单症状白名单——口渴可见于太阳蓄水（五苓散证）、厥阴热利（白头翁汤证）等，非里证专属。里热之渴改由合取判据 Panju_B7（口渴+洪脉/大脉/黄苔）判定。依据《伤寒论》180条「阳明之为病，胃家实是也」；168条白虎加人参汤「大渴，舌上干燥而烦，欲饮水数升者」（26条同方作「大烦渴不解，脉洪大者」）。</rdfs:comment></owl:Class>
    <owl:Class rdf:about="#Dake"><rdfs:subClassOf rdf:resource="#Zhengzhuang"/><rdfs:label xml:lang="zh">大渴</rdfs:label></owl:Class>
