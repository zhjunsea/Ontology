    <owl:Class rdf:about="#Wangxue">
        <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
        <rdfs:label xml:lang="zh">亡血</rdfs:label>
        <rdfs:comment xml:lang="zh">津血耗竭。为衄血、下血、漏下、吐血、利止之上的抽象病机状态。</rdfs:comment>
        <classicalText xml:lang="zh">《伤寒论》385条：恶寒脉微而复利，利止亡血也，四逆加人参汤主之。</classicalText>
    </owl:Class>

    <!-- 利止：下利突然停止。385条中作为"亡血"的直接证据 -->
    <owl:Class rdf:about="#Lizhi">
        <rdfs:subClassOf rdf:resource="#Wangxue"/>
        <rdfs:label xml:lang="zh">利止</rdfs:label>
        <rdfs:comment xml:lang="zh">下利突然停止。385条中"利止"是亡血的直接证据：非病愈，而是无物可下、津血已竭。</rdfs:comment>
        <classicalText xml:lang="zh">《伤寒论》385条：恶寒脉微而复利，利止亡血也，四逆加人参汤主之。</classicalText>
    </owl:Class>
    <!-- 阴狐疝 -->
		<owl:Class rdf:about="#Yinhushan">
				<rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
		    <rdfs:label xml:lang="zh">阴狐疝</rdfs:label>
		    <rdfs:comment xml:lang="zh">腹股沟疝的古称，指腹腔内容物经腹股沟管下坠入阴囊所致的病证。</rdfs:comment>
		</owl:Class>
		
		<!-- 偏有小大 -->
		<owl:Class rdf:about="#Pianyouxiaoda">
		    <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
		    <rdfs:label xml:lang="zh">偏有小大</rdfs:label>
		    <rdfs:comment xml:lang="zh">指阴囊或腹股沟区域一侧肿大、一侧正常，两侧大小不对称的体征。</rdfs:comment>
		</owl:Class>
		
		<!-- 时时上下 -->
		<owl:Class rdf:about="#Shishishangxia">
		    <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
		    <rdfs:label xml:lang="zh">时时上下</rdfs:label>
		    <rdfs:comment xml:lang="zh">指疝气肿块时而出现、时而消失，平卧时回纳腹腔，站立或用力时复又下坠的动态体征。</rdfs:comment>
		</owl:Class>
		<!-- ============ 一日再发 ============ -->
		<owl:Class rdf:about="#Yirizaifa">
		    <rdfs:subClassOf rdf:resource="#Runvezhuang"/>
		    <rdfs:label xml:lang="zh">一日再发</rdfs:label>
		    <rdfs:comment xml:lang="zh">发热恶寒如疟状，一日发作两次。《伤寒论》25条：“若形似疟，一日再发者，汗出必解，宜桂枝二麻黄一汤。”与桂枝麻黄各半汤证之“面有热色、身痒”相鉴别。</rdfs:comment>
		</owl:Class>
		<!-- 症状：一身尽疼 -->
		<owl:Class rdf:about="#Yishenjinteng">
		    <rdfs:label xml:lang="zh">一身尽疼</rdfs:label>
		    <rdfs:comment xml:lang="zh">周身尽疼，风湿在表之候。《金匮要略·痉湿暍病篇》："病者一身尽疼，发热，日晡所剧者，名风湿。"为麻杏薏甘汤证核心眼目，别于局部身痛。</rdfs:comment>
		    <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
		</owl:Class>
		<!-- ============ 症状：燥屎 ============ -->
		<owl:Class rdf:about="#Zaoshi">
		    <rdfs:label xml:lang="zh">燥屎</rdfs:label>
		    <rdfs:label xml:lang="en">Dry Stool</rdfs:label>
		    <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
		    <rdfs:comment xml:lang="zh">阳明腑实，燥屎内结。大便坚硬如羊屎，成球状，难以排出。为承气汤类方证的核心鉴别症状（《伤寒论》208、241、374条等）。</rdfs:comment>
		</owl:Class>
		<!-- ============ 症状：支饮胸满 ============ -->
		<owl:Class rdf:about="#Zhiyinxiongman">
		    <rdfs:label xml:lang="zh">支饮胸满</rdfs:label>
		    <rdfs:label xml:lang="en">Chest Fullness due to Zhiyin</rdfs:label>
		    <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
		    <rdfs:comment xml:lang="zh">支饮停聚胸膈，气机壅滞所致的胸胁胀满。《金匮要略·痰饮咳嗽病》："支饮胸满者，厚朴大黄汤主之。"为厚朴大黄汤证的主证。</rdfs:comment>
		</owl:Class>
		<!-- ============ 症状：产后中风 ============ -->
		<owl:Class rdf:about="#Chanhouzhongfeng">
		    <rdfs:label xml:lang="zh">产后中风</rdfs:label>
		    <rdfs:label xml:lang="en">Postpartum Wind-Strike</rdfs:label>
		    <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
		    <rdfs:comment xml:lang="zh">妇人产后气血亏虚，风邪乘虚袭表所致的病证。《金匮要略·妇人产后病》："产后中风，发热，面正赤，喘而头痛，竹叶汤主之。"为竹叶汤证的主证。</rdfs:comment>
		</owl:Class>
		<!-- ============ 症状：如坐水中 ============ -->
		<owl:Class rdf:about="#Ruzuoshuizhong">
		    <rdfs:label xml:lang="zh">如坐水中</rdfs:label>
		    <rdfs:label xml:lang="en">Feeling as if Sitting in Water</rdfs:label>
		    <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
		    <rdfs:comment xml:lang="zh">腰以下冷痛沉重，如坐冷水之中。《金匮要略·五脏风寒积聚病》："肾着之病，其人身体重，腰中冷，如坐水中，形如水状……甘草干姜茯苓白术汤主之。"为肾着汤（甘草干姜茯苓白术汤）证的典型征象。</rdfs:comment>
		</owl:Class>
		<!-- ============ 症状：苦极 ============ -->
		<owl:Class rdf:about="#Kujizhiyuandi">
		    <rdfs:label xml:lang="zh">苦极</rdfs:label>
		    <rdfs:label xml:lang="en">Extreme Suffering</rdfs:label>
		    <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
		    <rdfs:comment xml:lang="zh">痛苦至极、难以忍受之状。《金匮要略·中风历节病》附方《近效方》术附汤条："治风虚头重眩，苦极，不知食味，暖肌补中，益精气。"为术附汤证的主证。</rdfs:comment>
		</owl:Class>
		<!-- ============ 症状：金疮 ============ -->
		<owl:Class rdf:about="#Jinchuang">
		    <rdfs:label xml:lang="zh">金疮</rdfs:label>
		    <rdfs:label xml:lang="en">Metal Wound</rdfs:label>
		    <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
		    <rdfs:comment xml:lang="zh">金属器械所伤之创口。《金匮要略·疮痈肠痈浸淫病》："病金疮，王不留行散主之。"为金疮病诸方证的主证。</rdfs:comment>
		</owl:Class>
		<!-- ============ 症状：浸淫疮 ============ -->
		<owl:Class rdf:about="#Jinyinchuang">
		    <rdfs:label xml:lang="zh">浸淫疮</rdfs:label>
		    <rdfs:label xml:lang="en">Weeping Eczema</rdfs:label>
		    <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
		    <rdfs:comment xml:lang="zh">疮疡浸淫蔓延、渗流黄水之皮肤病。《金匮要略·疮痈肠痈浸淫病》："浸淫疮，黄连粉主之。"为黄连粉证的主证。</rdfs:comment>
		</owl:Class>
		<!-- ============ 症状：蛔虫 ============ -->
		<owl:Class rdf:about="#Huichong">
		    <rdfs:label xml:lang="zh">蛔虫</rdfs:label>
		    <rdfs:label xml:lang="en">Roundworm</rdfs:label>
		    <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
		    <rdfs:comment xml:lang="zh">肠道蛔虫内扰之证。《金匮要略·趺蹶手指臂肿转筋阴狐疝蛔虫病》："蛔虫之为病，令人吐涎，心痛发作有时，毒药不止，甘草粉蜜汤主之。"为甘草粉蜜汤证的主证。</rdfs:comment>
		</owl:Class>
		<!-- ============ 症状：心痛发作有时 ============ -->
		<owl:Class rdf:about="#Xintongfazuoyoushi">
		    <rdfs:label xml:lang="zh">心痛发作有时</rdfs:label>
		    <rdfs:label xml:lang="en">Recurrent Epigastric Pain</rdfs:label>
		    <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
		    <rdfs:comment xml:lang="zh">心下（胃脘）疼痛定时而发。《金匮要略·趺蹶手指臂肿转筋阴狐疝蛔虫病》甘草粉蜜汤条。为甘草粉蜜汤证的主证。</rdfs:comment>
		</owl:Class>
		<!-- ============ 症状：心中痞气 ============ -->
		<owl:Class rdf:about="#Xinzhongpiqi">
		    <rdfs:label xml:lang="zh">心中痞气</rdfs:label>
		    <rdfs:label xml:lang="en">Qi Stagnation in the Heart</rdfs:label>
		    <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
		    <rdfs:comment xml:lang="zh">心中痞塞、气结不舒。《金匮要略·胸痹心痛短气病》："心中痞气，气结在胸，胸满，胁下逆抢心，枳实薤白桂枝汤主之；人参汤亦主之。"为人参汤证的主证。</rdfs:comment>
		</owl:Class>
		<!-- ============ 症状：大风 ============ -->
		<owl:Class rdf:about="#Dafeng">
		    <rdfs:label xml:lang="zh">大风</rdfs:label>
		    <rdfs:label xml:lang="en">Severe Wind-Strike</rdfs:label>
		    <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
		    <rdfs:comment xml:lang="zh">风邪深入、病势深重之风病。《金匮要略·中风历节病》侯氏黑散条："治大风，四肢烦重，心中恶寒不足者。"为侯氏黑散证的主证。</rdfs:comment>
		</owl:Class>
		<!-- ============ 症状：除热瘫痫 ============ -->
		<owl:Class rdf:about="#Churetanxian">
		    <rdfs:label xml:lang="zh">除热瘫痫</rdfs:label>
		    <rdfs:label xml:lang="en">Heat with Paralysis and Seizures</rdfs:label>
		    <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
		    <rdfs:comment xml:lang="zh">热证伴瘫痫抽搐之候。《金匮要略·中风历节病》风引汤条："除热瘫痫。"为风引汤证的主证。</rdfs:comment>
		</owl:Class>
		<!-- ============ 症状：如狂状 ============ -->
		<owl:Class rdf:about="#Rukuangzhuang">
		    <rdfs:label xml:lang="zh">如狂状</rdfs:label>
		    <rdfs:label xml:lang="en">Manic-like State</rdfs:label>
		    <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
		    <rdfs:comment xml:lang="zh">神志异常、状似发狂。《金匮要略·中风历节病》防己地黄汤条："病如狂状，妄行，独语不休，无寒热，其脉浮。"为防己地黄汤证的主证。</rdfs:comment>
		</owl:Class>
		<!-- ============ 症状：手足拘急 ============ -->
		<owl:Class rdf:about="#Shouzujuji">
		    <rdfs:label xml:lang="zh">手足拘急</rdfs:label>
		    <rdfs:label xml:lang="en">Limbs Contracture</rdfs:label>
		    <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
		    <rdfs:comment xml:lang="zh">手足筋脉拘挛紧急。《金匮要略·中风历节病》附方《千金》三黄汤条："治中风手足拘急，百节疼痛，烦热心乱，恶寒，经日不欲饮食。"为三黄汤证的主证。</rdfs:comment>
		</owl:Class>
		<!-- ============ 症状：百节疼痛 ============ -->
		<owl:Class rdf:about="#Baijietengtong">
		    <rdfs:label xml:lang="zh">百节疼痛</rdfs:label>
		    <rdfs:label xml:lang="en">Generalized Joint Pain</rdfs:label>
		    <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
		    <rdfs:comment xml:lang="zh">全身关节疼痛。《金匮要略·中风历节病》附方《千金》三黄汤条。为三黄汤证的主证。</rdfs:comment>
		</owl:Class>
		<!-- ============ 症状：大如盘 ============ -->
		<owl:Class rdf:about="#Darupan">
		    <rdfs:label xml:lang="zh">大如盘</rdfs:label>
		    <rdfs:label xml:lang="en">Mass as Large as a Plate</rdfs:label>
		    <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
		    <rdfs:comment xml:lang="zh">心下坚满，其形大如盘。《金匮要略·水气病》："心下坚，大如盘，边如旋盘，水饮所作，枳术汤主之。"为枳术汤证的主证。</rdfs:comment>
		</owl:Class>
		<!-- ============ 症状：边如旋盘 ============ -->
		<owl:Class rdf:about="#Bianruxuanpan">
		    <rdfs:label xml:lang="zh">边如旋盘</rdfs:label>
		    <rdfs:label xml:lang="en">Edge Like a Round Plate</rdfs:label>
		    <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
		    <rdfs:comment xml:lang="zh">心下坚满之边缘圆转如盘。《金匮要略·水气病》枳术汤条。为枳术汤证的主证。</rdfs:comment>
		</owl:Class>
		<!-- ============ 症状：臂脚直 ============ -->
		<owl:Class rdf:about="#Renbijiaozhi">
		    <rdfs:label xml:lang="zh">臂脚直</rdfs:label>
		    <rdfs:label xml:lang="en">Rigid Arms and Feet</rdfs:label>
		    <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
		    <rdfs:comment xml:lang="zh">手臂与足部强直不柔。《金匮要略·趺蹶手指臂肿转筋阴狐疝蛔虫病》："转筋之为病，其人臂脚直，脉上下行，微弦。转筋入腹者，鸡屎白散主之。"为鸡屎白散证的主证。</rdfs:comment>
		</owl:Class>

		<!-- ============ v27.1 补齐：方后注加减法条件症状（10 类） ============ -->
		<owl:Class rdf:about="#Maibuchuzhe">
		    <rdfs:label xml:lang="zh">脉不出</rdfs:label>
		    <rdfs:label xml:lang="en">Pulse Not Emerging</rdfs:label>
		    <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
		    <rdfs:comment xml:lang="zh">《伤寒论》317条通脉四逆汤方后注：“脉不出者，去桔梗，加人参二两。”指脉象沉伏难寻。</rdfs:comment>
		</owl:Class>
		<owl:Class rdf:about="#Qidongzhe">
		    <rdfs:label xml:lang="zh">脐上筑</rdfs:label>
		    <rdfs:label xml:lang="en">Throbbing Above the Navel</rdfs:label>
		    <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
		    <rdfs:comment xml:lang="zh">《伤寒论》386条理中丸方后注：“若脐上筑者，肾气动也，去术，加桂四两。”脐上筑动不安。</rdfs:comment>
		</owl:Class>
		<owl:Class rdf:about="#Sushi">
		    <rdfs:label xml:lang="zh">宿食</rdfs:label>
		    <rdfs:label xml:lang="en">Retained Food</rdfs:label>
		    <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
		    <rdfs:comment xml:lang="zh">《伤寒论》393条枳实栀子豉汤方后注：“若有宿食者，内大黄如博棋子五六枚，服之愈。”</rdfs:comment>
		</owl:Class>
		<owl:Class rdf:about="#Weili">
		    <rdfs:label xml:lang="zh">微利</rdfs:label>
		    <rdfs:label xml:lang="en">Slight Diarrhea</rdfs:label>
		    <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
		    <rdfs:comment xml:lang="zh">《伤寒论》40条小青龙汤方后注：“若微利者，去麻黄，加荛花如鸡子大，熬令赤色。”</rdfs:comment>
		</owl:Class>
		<owl:Class rdf:about="#Weizhongbuhe">
		    <rdfs:label xml:lang="zh">胃中不和</rdfs:label>
		    <rdfs:label xml:lang="en">Stomach Disharmony</rdfs:label>
		    <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
		    <rdfs:comment xml:lang="zh">《金匮要略·痉湿暍病》防己黄芪汤方后注：“胃中不和者，加芍药三分。”</rdfs:comment>
		</owl:Class>
		<owl:Class rdf:about="#Xiayouchenhan">
		    <rdfs:label xml:lang="zh">下有陈寒</rdfs:label>
		    <rdfs:label xml:lang="en">Chronic Cold Below</rdfs:label>
		    <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
		    <rdfs:comment xml:lang="zh">《金匮要略·痉湿暍病》防己黄芪汤方后注：“下有陈寒者，加细辛三分。”</rdfs:comment>
		</owl:Class>
		<owl:Class rdf:about="#Xinxiaodutong">
		    <rdfs:label xml:lang="zh">心下毒痛</rdfs:label>
		    <rdfs:label xml:lang="en">Severe Pain Below the Heart</rdfs:label>
		    <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
		    <rdfs:comment xml:lang="zh">《金匮要略·妇人妊娠病》白术散方后注：“心下毒痛，倍加芎藭。”</rdfs:comment>
		</owl:Class>
		<owl:Class rdf:about="#Xuanji">
		    <rdfs:label xml:lang="zh">眩悸</rdfs:label>
		    <rdfs:label xml:lang="en">Dizziness and Palpitations</rdfs:label>
		    <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
		    <rdfs:comment xml:lang="zh">《金匮要略·痰饮咳嗽病》小半夏加茯苓汤条：“眩悸者，加茯苓。”</rdfs:comment>
		</owl:Class>
		<owl:Class rdf:about="#Zhubuzu">
		    <rdfs:label xml:lang="zh">诸不足</rdfs:label>
		    <rdfs:label xml:lang="en">Various Deficiencies</rdfs:label>
		    <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
		    <rdfs:comment xml:lang="zh">《金匮要略·血痹虚劳病》黄芪建中汤条：“虚劳里急，诸不足，黄芪建中汤主之。”</rdfs:comment>
		</owl:Class>
		<owl:Class rdf:about="#Bunengshiyin">
		    <rdfs:label xml:lang="zh">不能食饮</rdfs:label>
		    <rdfs:label xml:lang="en">Inability to Eat or Drink</rdfs:label>
		    <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
		    <rdfs:comment xml:lang="zh">《金匮要略·妇人妊娠病》白术散方后注：“心烦吐痛，不能食饮，加细辛一两、半夏大者二十枚。”</rdfs:comment>
		</owl:Class>

    <!-- ==================== 症状层级（细粒度 ⊑ 粗粒度 · 投影层 · 实施 ⑤） ==================== -->
    <!-- 投影层：细粒度 ⊑ 粗粒度。细粒度类原样保留（方证层用），仅新增粗粒度父类边。族类不挂八纲。 -->

    <!-- ========== 新建族类（2 个，纯分组，不挂八纲） ========== -->
    <owl:Class rdf:about="#Hanxiang">
        <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
        <rdfs:label xml:lang="zh">寒象</rdfs:label>
        <rdfs:comment xml:lang="zh">阴证寒象族（投影层，不挂八纲）：畏寒、手足冷、厥逆、四肢逆冷、足寒。依 317 条「手足厥冷」「四肢逆冷」。注意：畏寒（里虚寒）≠ 恶寒（表证）。</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#Xiaobian">
        <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
        <rdfs:label xml:lang="zh">小便</rdfs:label>
        <rdfs:comment xml:lang="zh">小便族（投影层，不挂八纲）：小便不利、小便数、小便黄赤、小便清。依 71、223 条。</rdfs:comment>
    </owl:Class>

    <!-- ========== 新建症状类（18 个，细粒度 ⊑ 粗粒度） ========== -->
    <owl:Class rdf:about="#ShenTengtong">
        <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
        <rdfs:subClassOf rdf:resource="#Shentong"/>
        <rdfs:label xml:lang="zh">身疼痛</rdfs:label>
        <rdfs:comment xml:lang="zh">3 条「身疼痛」；35 条「身疼」。与 `Shentong`（身痛）同义异文，作其子类（投影，非替换）。</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#Gujietengtong">
        <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
        <rdfs:subClassOf rdf:resource="#Shentong"/>
        <rdfs:label xml:lang="zh">骨节疼痛</rdfs:label>
        <rdfs:comment xml:lang="zh">35 条「身疼腰痛骨节疼痛」。关节痛，属身痛族。</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#Ziliyishen">
        <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
        <rdfs:subClassOf rdf:resource="#Xiali"/>
        <rdfs:label xml:lang="zh">自利益甚</rdfs:label>
        <rdfs:comment xml:lang="zh">273 条太阴提纲「自利益甚」。下利加重，属下利族。</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#Wanguobuhua">
        <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
        <rdfs:subClassOf rdf:resource="#Xiali"/>
        <rdfs:label xml:lang="zh">完谷不化</rdfs:label>
        <rdfs:comment xml:lang="zh">317 条四逆汤证。与「下利清谷」同义，属下利族。</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#Fumantong">
        <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
        <rdfs:subClassOf rdf:resource="#Futong"/>
        <rdfs:label xml:lang="zh">腹满痛</rdfs:label>
        <rdfs:comment xml:lang="zh">阳明腑实「腹满痛」。腹满兼痛，属腹痛族。</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#FumanJuAn">
        <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
        <rdfs:subClassOf rdf:resource="#Futong"/>
        <rdfs:label xml:lang="zh">腹满拒按</rdfs:label>
        <rdfs:comment xml:lang="zh">239、241 条阳明腑实「腹满拒按」。属实，属腹痛族。</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#Momobuyushiyin">
        <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
        <rdfs:subClassOf rdf:resource="#Momo"/>
        <rdfs:label xml:lang="zh">默默不欲饮食</rdfs:label>
        <rdfs:comment xml:lang="zh">96 条小柴胡汤证「默默不欲饮食」。属默默族（`Momo` 嘿嘿）。</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#Shouzujueleng">
        <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
        <rdfs:subClassOf rdf:resource="#Hanxiang"/>
        <rdfs:label xml:lang="zh">手足厥冷</rdfs:label>
        <rdfs:comment xml:lang="zh">317、337 条「手足厥冷」。属寒象族。</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#Sizhinileng">
        <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
        <rdfs:subClassOf rdf:resource="#Hanxiang"/>
        <rdfs:label xml:lang="zh">四肢逆冷</rdfs:label>
        <rdfs:comment xml:lang="zh">317 条通脉四逆汤「四肢逆冷」。属寒象族。</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#WeiHan">
        <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
        <rdfs:subClassOf rdf:resource="#Hanxiang"/>
        <rdfs:label xml:lang="zh">畏寒</rdfs:label>
        <rdfs:comment xml:lang="zh">里虚寒之象（阳虚，得温则减）。**与「恶寒」不同** —— 恶寒为表证（得温不减）。故不并入 `Ehan`，而属寒象族。注意类名 `WeiHan` 与 `Weihan`（微恶寒）大小写不同。</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#Juanwo">
        <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
        <rdfs:subClassOf rdf:resource="#Danyumei"/>
        <rdfs:label xml:lang="zh">倦卧</rdfs:label>
        <rdfs:comment xml:lang="zh">少阴、太阴之象「倦卧」。属但欲寐族。</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#Shiwo">
        <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
        <rdfs:subClassOf rdf:resource="#Danyumei"/>
        <rdfs:label xml:lang="zh">嗜卧</rdfs:label>
        <rdfs:comment xml:lang="zh">少阴之象「嗜卧」。属但欲寐族。</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#Jingshenweimi">
        <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
        <rdfs:subClassOf rdf:resource="#Danyumei"/>
        <rdfs:label xml:lang="zh">精神萎靡</rdfs:label>
        <rdfs:comment xml:lang="zh">少阴「但欲寐」之现代表述。属但欲寐族。</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#Xiaobianhuangchi">
        <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
        <rdfs:subClassOf rdf:resource="#Xiaobian"/>
        <rdfs:label xml:lang="zh">小便黄赤</rdfs:label>
        <rdfs:comment xml:lang="zh">里热之象。属小便族。</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#Xiaobianqing">
        <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
        <rdfs:subClassOf rdf:resource="#Xiaobian"/>
        <rdfs:label xml:lang="zh">小便清</rdfs:label>
        <rdfs:comment xml:lang="zh">里寒之象（223 条「小便清者，知不在里」）。属小便族。</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#HanreWanglai">
        <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
        <rdfs:subClassOf rdf:resource="#Wanglaihanre"/>
        <rdfs:label xml:lang="zh">寒热往来</rdfs:label>
        <rdfs:comment xml:lang="zh">与「往来寒热」同义异文（96、97 条）。属往来寒热族。</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#Xiuzuoyoushi">
        <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
        <rdfs:subClassOf rdf:resource="#Wanglaihanre"/>
        <rdfs:label xml:lang="zh">休作有时</rdfs:label>
        <rdfs:comment xml:lang="zh">97 条「休作有时」。属往来寒热族。</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#Dabianmijie">
        <rdfs:subClassOf rdf:resource="#Zhengzhuang"/>
        <rdfs:subClassOf rdf:resource="#Dabianying"/>
        <rdfs:label xml:lang="zh">大便秘结</rdfs:label>
        <rdfs:comment xml:lang="zh">阳明腑实。与「大便硬」同义，属便硬族。</rdfs:comment>
    </owl:Class>

