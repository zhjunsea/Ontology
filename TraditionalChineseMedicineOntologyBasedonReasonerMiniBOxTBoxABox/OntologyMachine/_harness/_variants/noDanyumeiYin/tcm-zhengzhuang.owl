    <owl:Class rdf:about="#Yantong"><rdfs:subClassOf rdf:resource="#Zhengzhuang"/><rdfs:label xml:lang="zh">咽痛</rdfs:label></owl:Class>
    <owl:Class rdf:about="#Yanzhongtong"><rdfs:subClassOf rdf:resource="#Yantong"/><rdfs:label xml:lang="zh">咽中痛</rdfs:label><rdfs:comment xml:lang="zh">《伤寒论》313条：“少阴病，咽中痛，半夏散及汤主之。”为咽痛之较重者，与311条甘草汤证之“咽痛”（Yantong）相区别。</rdfs:comment></owl:Class>
