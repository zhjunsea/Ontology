<?xml version='1.0' encoding='UTF-8'?>
<rdf:RDF xmlns="http://www.tcm-classics.org/jingfang#" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:base="http://www.tcm-classics.org/jingfang#">

    <owl:Ontology rdf:about="http://www.tcm-classics.org/jingfang/fanggen">
        <rdfs:label xml:lang="zh">方根层</rdfs:label>
        <rdfs:comment xml:lang="zh">38 个方根类。含方根级加减规则。只含 subClassOf Fanggen + fanggenType 注释 + 方根级规则，禁止等价定义。</rdfs:comment>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/core"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/rules"/>
    </owl:Ontology>

    <!-- ============ 顶层类 ============ -->
    <owl:Class rdf:about="#Fanggen">
    		<rdfs:subClassOf rdf:resource="#Bingzheng"/>
        <rdfs:label xml:lang="zh">方根</rdfs:label>
        <rdfs:comment xml:lang="zh">最小配伍单元，方剂结构的“基因”。</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="#Jiazu">
    		<rdfs:subClassOf rdf:resource="#Bingzheng"/>
    		<rdfs:label xml:lang="zh">家族</rdfs:label>
    		<rdfs:comment xml:lang="zh">方剂家族。用于归类具有相同方根或母方，通过加减化裁衍生出的一系列方证（如桂枝汤类方证、建中汤类方证等）的抽象集合。</rdfs:comment>
		</owl:Class>
		<!-- 方证定义 -->
		<owl:Class rdf:about="#Fangzheng">
		    <rdfs:subClassOf rdf:resource="#Bingzheng"/>
		    <rdfs:label xml:lang="zh">方证</rdfs:label>
		    <rdfs:comment xml:lang="zh">指特定的方剂与其对应的主治病证的高度统一体。它是由特定的病因、病机、症状群（包括主症与兼症）及治法共同构成的辨证论治的最小实践单元。</rdfs:comment>
		</owl:Class>
		
		<!-- 三者关系定义 -->
		
		<!-- 1. 构成关系：方根 -> 方证 -->
		<owl:ObjectProperty rdf:about="#has_fanggen">
		    <rdfs:label xml:lang="zh">包含方根</rdfs:label>
		    <rdfs:comment xml:lang="zh">方证由一个或多个方根组合而成，方根是构成方证的最小配伍单元。</rdfs:comment>
		    <rdfs:domain rdf:resource="#Fangzheng"/>
		    <rdfs:range rdf:resource="#Fanggen"/>
		</owl:ObjectProperty>
		
		<!-- 2. 分类关系：方证 -> 家族 -->
		<owl:ObjectProperty rdf:about="#belongs_to_jiazu">
		    <rdfs:label xml:lang="zh">属于家族</rdfs:label>
		    <rdfs:comment xml:lang="zh">方证是家族的具体成员，多个具有共同方根或演化关系的方证被归类到同一个家族中。</rdfs:comment>
		    <rdfs:domain rdf:resource="#Fangzheng"/>
		    <rdfs:range rdf:resource="#Jiazu"/>
		</owl:ObjectProperty>
		
		<!-- 3. 溯源关系：家族 -> 方根 -->
		<owl:ObjectProperty rdf:about="#defined_by_fanggen">
		    <rdfs:label xml:lang="zh">由方根定义</rdfs:label>
		    <rdfs:comment xml:lang="zh">家族的定义和划分基于其成员共有的核心方根，家族由其核心方根衍生而来。</rdfs:comment>
		    <rdfs:domain rdf:resource="#Jiazu"/>
		    <rdfs:range rdf:resource="#Fanggen"/>
		</owl:ObjectProperty>

    <owl:AnnotationProperty rdf:about="#fanggenType">
        <rdfs:label xml:lang="zh">方根类型</rdfs:label>
        <rdfs:comment xml:lang="zh">药对 / 角药 / 单味 / 全方即根 / 角药以上。</rdfs:comment>
    </owl:AnnotationProperty>

    <!-- ============ 1. 桂枝芍药姜枣草（全方即根） ============ -->
    <owl:Class rdf:about="#Guizhishaoyaogen">
        <rdfs:label xml:lang="zh">桂枝芍药姜枣草（方根）</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fanggen"/>
        <fanggenType xml:lang="zh">全方即根</fanggenType>
        <rdfs:comment xml:lang="zh">源方：桂枝汤（12条）。调和营卫。</rdfs:comment>

        <addHerbRule rdf:parseType="Literal">IF Xiangqiang THEN add Gegen (葛根四两)</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》14条：太阳病，项背强几几，反汗出恶风者，桂枝加葛根汤主之。</ruleSource>

        <addHerbRule rdf:parseType="Literal">IF Chuan THEN add Houpo (厚朴二两) + Xingren (杏仁五十个)</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》18条：喘家作，桂枝汤加厚朴杏子佳。43条：太阳病下之微喘者，桂枝加厚朴杏子汤主之。</ruleSource>

        <addHerbRule rdf:parseType="Literal">IF Hanloubuzhi AND Xiaobiannan THEN add Fuzi (附子一枚，炮)</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》20条：太阳病，发汗，遂漏不止，其人恶风，小便难，四支微急，难以屈伸者，桂枝加附子汤主之。</ruleSource>

        <removeHerbRule rdf:parseType="Literal">IF Xinxiaoman THEN remove Shaoyao</removeHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》21条：太阳病下之后，脉促胸满者，桂枝去芍药汤主之。</ruleSource>

        <addHerbRule rdf:parseType="Literal">IF Xinxiaoman AND Ehan THEN add Fuzi (附子一枚，炮)</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》22条：若微恶寒者，桂枝去芍药加附子汤主之。</ruleSource>

        <addHerbRule rdf:parseType="Literal">IF Qicongshaofushangchongxin THEN add Guizhi (桂枝加量至五两)</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》117条：气从少腹上冲心者，与桂枝加桂汤。</ruleSource>

        <addHerbRule rdf:parseType="Literal">IF Fuman AND Futong THEN add Shaoyao (芍药加量至六两)</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》279条：本太阳病，医反下之，因尔腹满时痛者，属太阴也，桂枝加芍药汤主之。</ruleSource>

        <addHerbRule rdf:parseType="Literal">IF Futong AND Juan THEN add Dahuang (大黄二两)</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》279条：大实痛者，桂枝加大黄汤主之。</ruleSource>

        <addHerbRule rdf:parseType="Literal">IF Jingkuang AND Woqibuan THEN add Shaqi (蜀漆三两) + Muli (牡蛎五两) + Longgu (龙骨四两)</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》112条：亡阳必惊狂，卧起不安者，桂枝去芍药加蜀漆牡蛎龙骨救逆汤主之。</ruleSource>

        <addHerbRule rdf:parseType="Literal">IF Xinxiaoman AND Xiaobianbuli THEN add Fuling (茯苓三两) + Baizhu (白术三两)</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》28条：心下满微痛，小便不利者，桂枝去桂加茯苓白术汤主之。</ruleSource>

        <addHerbRule rdf:parseType="Literal">IF Shentengfan AND Chenchimai THEN add Renshen (人参三两) + Shengjiang (加至四两) + Shaoyao (加至四两)</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》62条：发汗后，身疼痛，脉沉迟者，桂枝加芍药生姜各一两人参三两新加汤主之。</ruleSource>

        <addHerbRule rdf:parseType="Literal">IF Fanzao AND Xinxiajidong THEN add Longgu (龙骨三两) + Muli (牡蛎三两)</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》118条：火逆下之，因烧针烦躁者，桂枝甘草龙骨牡蛎汤主之。</ruleSource>

        <addHerbRule rdf:parseType="Literal">IF Huanghan AND Liangjingzileng THEN add Huangqi (黄芪五两)</addHerbRule>
        <ruleSource xml:lang="zh">《金匮要略·水气病》：黄汗之病，两胫自冷……桂枝加黄芪汤主之。</ruleSource>

        <addHerbRule rdf:parseType="Literal">IF Shijingjia AND Shaofuxianji AND Muxuan AND Faluo THEN add Longgu + Muli</addHerbRule>
        <ruleSource xml:lang="zh">《金匮要略·血痹虚劳病》：夫失精家，少腹弦急，阴头寒，目眩，发落……桂枝加龙骨牡蛎汤主之。</ruleSource>
    </owl:Class>

    <!-- ============ 2. 麻黄（单味） ============ -->
    <owl:Class rdf:about="#Mahuanggen">
        <rdfs:label xml:lang="zh">麻黄（方根）</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fanggen"/>
        <fanggenType xml:lang="zh">单味</fanggenType>
        <rdfs:comment xml:lang="zh">源方：麻黄汤核心。发汗解表。</rdfs:comment>
    </owl:Class>

    <!-- ============ 3. 麻黄桂枝（药对） ============ -->
    <owl:Class rdf:about="#Mahuangguizhigen">
        <rdfs:label xml:lang="zh">麻黄桂枝（方根）</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fanggen"/>
        <fanggenType xml:lang="zh">药对</fanggenType>
        <rdfs:comment xml:lang="zh">源方：麻黄汤（35条）。发汗解表。</rdfs:comment>
    </owl:Class>

    <!-- ============ 4. 葛根（单味） ============ -->
    <owl:Class rdf:about="#Gegen">
        <rdfs:label xml:lang="zh">葛根（方根）</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fanggen"/>
        <fanggenType xml:lang="zh">单味</fanggenType>
        <rdfs:comment xml:lang="zh">源方：葛根芩连汤（34条）。解肌清热。</rdfs:comment>
    </owl:Class>

    <!-- ============ 5. 葛根麻黄（药对） ============ -->
    <owl:Class rdf:about="#GegenMahuanggen">
        <rdfs:label xml:lang="zh">葛根麻黄（方根）</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fanggen"/>
        <fanggenType xml:lang="zh">药对</fanggenType>
        <rdfs:comment xml:lang="zh">源方：葛根汤（31条）。解肌发汗。</rdfs:comment>
    </owl:Class>

    <!-- ============ 6. 柴胡黄芩（药对） ============ -->
    <owl:Class rdf:about="#Chaihugen">
        <rdfs:label xml:lang="zh">柴胡黄芩（方根）</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fanggen"/>
        <fanggenType xml:lang="zh">药对</fanggenType>
        <rdfs:comment xml:lang="zh">源方：小柴胡汤（96条）。和解少阳。</rdfs:comment>

        <replaceHerbRule rdf:parseType="Literal">IF Xiongzhongfan AND Buou THEN replace Banxia+Renshen WITH Gualoushi</replaceHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》96条方后注：若胸中烦而不呕，去半夏、人参，加栝蒌实一枚。</ruleSource>

        <replaceHerbRule rdf:parseType="Literal">IF Kouke THEN replace Banxia WITH Renshen(加至四两半)+Gualougen</replaceHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》96条方后注：若渴，去半夏，加人参合前成四两半，栝蒌根四两。</ruleSource>

        <replaceHerbRule rdf:parseType="Literal">IF Futong THEN replace Huangqin WITH Shaoyao</replaceHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》96条方后注：若腹中痛者，去黄芩，加芍药三两。</ruleSource>

        <replaceHerbRule rdf:parseType="Literal">IF Xiexiapiying THEN replace Dazao WITH Muli</replaceHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》96条方后注：若胁下痞硬，去大枣，加牡蛎四两。</ruleSource>

        <replaceHerbRule rdf:parseType="Literal">IF Xinxiajidong AND Xiaobianbuli THEN replace Huangqin WITH Fuling</replaceHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》96条方后注：若心下悸，小便不利者，去黄芩，加茯苓四两。</ruleSource>

        <addHerbRule rdf:parseType="Literal">IF Buke AND Shenyouweire THEN add Guizhi</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》96条方后注：若不渴，外有微热者，去人参，加桂枝三两。</ruleSource>

        <replaceHerbRule rdf:parseType="Literal">IF Kesou THEN replace Renshen+Dazao+Shengjiang WITH Wuweizi+Ganjiang</replaceHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》96条方后注：若咳者，去人参、大枣、生姜，加五味子半升，干姜二两。</ruleSource>
    </owl:Class>

    <!-- ============ 7. 大黄（单味） ============ -->
    <owl:Class rdf:about="#Dahuanggen">
        <rdfs:label xml:lang="zh">大黄（方根）</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fanggen"/>
        <fanggenType xml:lang="zh">单味</fanggenType>
        <rdfs:comment xml:lang="zh">源方：大承气汤核心。攻下热结。</rdfs:comment>
    </owl:Class>

    <!-- ============ 8. 石膏（单味·成员判据） ============ -->
    <owl:Class rdf:about="#Shigaogen">
        <rdfs:label xml:lang="zh">石膏（方根）</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fanggen"/>
        <fanggenType xml:lang="zh">单味</fanggenType>
        <rdfs:comment xml:lang="zh">白虎汤核心成员判据。清阳明里热。</rdfs:comment>
    </owl:Class>

    <!-- ============ 9. 石膏知母（药对·母方结构） ============ -->
    <owl:Class rdf:about="#Shigaozhimugen">
        <rdfs:label xml:lang="zh">石膏知母（方根）</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fanggen"/>
        <fanggenType xml:lang="zh">药对</fanggenType>
        <rdfs:comment xml:lang="zh">源方：白虎汤母方结构。</rdfs:comment>
    </owl:Class>

    <!-- ============ 10. 干姜附子（药对） ============ -->
    <owl:Class rdf:about="#Ganjiangfuzigen">
        <rdfs:label xml:lang="zh">干姜附子（方根）</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fanggen"/>
        <fanggenType xml:lang="zh">药对</fanggenType>
        <rdfs:comment xml:lang="zh">源方：四逆汤核心（61条干姜附子汤）。回阳救逆。</rdfs:comment>

        <addHerbRule rdf:parseType="Literal">IF Miansechi AND Shenfanbuehan THEN add Gancao + Ganjiang(加至三两) + Fuzi(大者一枚)</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》317条：少阴病，下利清谷，里寒外热，手足厥逆，脉微欲绝，身反不恶寒，其人面色赤……通脉四逆汤主之。</ruleSource>

        <addHerbRule rdf:parseType="Literal">IF Lizhi AND Wangxue THEN add Renshen</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》385条：恶寒脉微而复利，利止亡血也，四逆加人参汤主之。</ruleSource>

        <addHerbRule rdf:parseType="Literal">IF Fanzao THEN add Fuling + Renshen</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》69条：发汗，若下之，病仍不解，烦躁者，茯苓四逆汤主之。</ruleSource>
    </owl:Class>

    <!-- ============ 11. 干姜白术甘草（角药·构造性） ============ -->
    <owl:Class rdf:about="#GanjiangBaizhuGancaogen">
        <rdfs:label xml:lang="zh">干姜白术甘草（方根·构造性）</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fanggen"/>
        <fanggenType xml:lang="zh">角药（构造性）</fanggenType>
        <rdfs:comment xml:lang="zh">理中汤核心。温中健脾。</rdfs:comment>
    </owl:Class>

    <!-- ============ 12. 黄连黄芩干姜（角药） ============ -->
    <owl:Class rdf:about="#HuanglianHuangqinGanjiangen">
        <rdfs:label xml:lang="zh">黄连黄芩干姜（方根）</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fanggen"/>
        <fanggenType xml:lang="zh">角药</fanggenType>
        <rdfs:comment xml:lang="zh">泻心汤核心。辛开苦降。</rdfs:comment>
    </owl:Class>

    <!-- ============ 13. 茯苓泽泻（药对） ============ -->
    <owl:Class rdf:about="#FulingZexiegen">
        <rdfs:label xml:lang="zh">茯苓泽泻（方根）</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fanggen"/>
        <fanggenType xml:lang="zh">药对</fanggenType>
        <rdfs:comment xml:lang="zh">源方：五苓散核心。利水渗湿。</rdfs:comment>
    </owl:Class>

    <!-- ============ 14. 茯苓桂枝（药对·构造性） ============ -->
    <owl:Class rdf:about="#Fulingguizhigen">
        <rdfs:label xml:lang="zh">茯苓桂枝（方根·构造性）</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fanggen"/>
        <fanggenType xml:lang="zh">药对（构造性）</fanggenType>
        <rdfs:comment xml:lang="zh">苓桂术甘汤核心。化饮降冲。非仲景原方，构造性方根。</rdfs:comment>
    </owl:Class>

    <!-- ============ 15. 茯苓白术附子（角药·构造性） ============ -->
    <owl:Class rdf:about="#FulingBaizhuFuzigen">
        <rdfs:label xml:lang="zh">茯苓白术附子（方根·构造性）</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fanggen"/>
        <fanggenType xml:lang="zh">角药（构造性）</fanggenType>
        <rdfs:comment xml:lang="zh">真武汤核心。温阳利水。</rdfs:comment>
    </owl:Class>

    <!-- ============ 16. 苓甘五味姜辛（角药以上） ============ -->
    <owl:Class rdf:about="#Lingganwuweigen">
        <rdfs:label xml:lang="zh">苓甘五味姜辛（方根）</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fanggen"/>
        <fanggenType xml:lang="zh">角药以上</fanggenType>
        <rdfs:comment xml:lang="zh">源方：苓甘五味姜辛汤（金匮痰饮）。化寒饮。</rdfs:comment>
    </owl:Class>

    <!-- ============ 17. 栀子（单味·成员判据） ============ -->
    <owl:Class rdf:about="#Zhizigen">
        <rdfs:label xml:lang="zh">栀子（方根）</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fanggen"/>
        <fanggenType xml:lang="zh">单味</fanggenType>
        <rdfs:comment xml:lang="zh">栀子豉汤核心成员判据。清宣胸膈郁热。</rdfs:comment>
    </owl:Class>

    <!-- ============ 18. 栀子香豉（药对·母方结构） ============ -->
    <owl:Class rdf:about="#Zhishigancaogen">
        <rdfs:label xml:lang="zh">栀子香豉（方根）</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fanggen"/>
        <fanggenType xml:lang="zh">药对</fanggenType>
        <rdfs:comment xml:lang="zh">源方：栀子豉汤（76条）母方结构。</rdfs:comment>

        <addHerbRule rdf:parseType="Literal">IF Shaoqi THEN add Gancao</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》76条：若少气者，栀子甘草豉汤主之。</ruleSource>

        <addHerbRule rdf:parseType="Literal">IF Ou THEN add Shengjiang</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》76条：若呕者，栀子生姜豉汤主之。</ruleSource>

        <addHerbRule rdf:parseType="Literal">IF Xinfan AND Fuman AND Woqibuan THEN add Houpo + Zhishi</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》79条：伤寒下后，心烦腹满，卧起不安者，栀子厚朴汤主之。</ruleSource>

        <addHerbRule rdf:parseType="Literal">IF Shenrebuqu AND Weifan THEN add Ganjiang</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》80条：伤寒，医以丸药大下之，身热不去，微烦者，栀子干姜汤主之。</ruleSource>

        <addHerbRule rdf:parseType="Literal">IF Dabingchaihou AND Laofu THEN add Zhishi</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》393条：大病差后，劳复者，枳实栀子豉汤主之。</ruleSource>
    </owl:Class>

    <!-- ============ 19. 大黄芒硝甘遂（角药） ============ -->
    <owl:Class rdf:about="#Xianxionggen">
        <rdfs:label xml:lang="zh">大黄芒硝甘遂（方根）</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fanggen"/>
        <fanggenType xml:lang="zh">角药</fanggenType>
        <rdfs:comment xml:lang="zh">源方：大陷胸汤。泻热逐水。</rdfs:comment>
    </owl:Class>

    <!-- ============ 20. 饴糖（单味·成员判据） ============ -->
    <owl:Class rdf:about="#Yitanggen">
        <rdfs:label xml:lang="zh">饴糖（方根）</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fanggen"/>
        <fanggenType xml:lang="zh">单味</fanggenType>
        <rdfs:comment xml:lang="zh">建中汤核心成员判据。甘温建中。</rdfs:comment>
    </owl:Class>

    <!-- ============ 21. 桂枝芍药姜枣草饴糖（全方即根·母方结构） ============ -->
    <owl:Class rdf:about="#Jianzhongfanggen">
        <rdfs:label xml:lang="zh">桂枝芍药姜枣草饴糖（方根）</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fanggen"/>
        <fanggenType xml:lang="zh">全方即根</fanggenType>
        <rdfs:comment xml:lang="zh">源方：小建中汤母方结构。</rdfs:comment>
    </owl:Class>

    <!-- ============ 22. 半夏（单味） ============ -->
    <owl:Class rdf:about="#Banxiagen">
        <rdfs:label xml:lang="zh">半夏（方根）</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fanggen"/>
        <fanggenType xml:lang="zh">单味</fanggenType>
        <rdfs:comment xml:lang="zh">小半夏汤核心。降逆止呕。</rdfs:comment>

        <addHerbRule rdf:parseType="Literal">IF Xinxiapi AND Gexianyoushui AND Xuanji THEN add Fuling</addHerbRule>
        <ruleSource xml:lang="zh">《金匮要略·痰饮咳嗽病》：卒呕吐，心下痞，膈间有水，眩悸者，小半夏加茯苓汤主之。</ruleSource>
    </owl:Class>

    <!-- ============ 23. 半夏生姜（药对） ============ -->
    <owl:Class rdf:about="#BanxiaShengjianggen">
        <rdfs:label xml:lang="zh">半夏生姜（方根）</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fanggen"/>
        <fanggenType xml:lang="zh">药对</fanggenType>
        <rdfs:comment xml:lang="zh">源方：小半夏汤。降逆止呕。</rdfs:comment>
    </owl:Class>

    <!-- ============ 24. 栝楼薤白（药对） ============ -->
    <owl:Class rdf:about="#Gualouxiebaigen">
        <rdfs:label xml:lang="zh">栝楼薤白（方根）</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fanggen"/>
        <fanggenType xml:lang="zh">药对</fanggenType>
        <rdfs:comment xml:lang="zh">源方：栝楼薤白白酒汤。通阳散结。</rdfs:comment>
    </owl:Class>

    <!-- ============ 25. 黄芩芍药甘草大枣（全方即根） ============ -->
    <owl:Class rdf:about="#Huangqingen">
        <rdfs:label xml:lang="zh">黄芩芍药甘草大枣（方根）</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fanggen"/>
        <fanggenType xml:lang="zh">全方即根</fanggenType>
        <rdfs:comment xml:lang="zh">源方：黄芩汤（172条）。清热止利。</rdfs:comment>
    </owl:Class>

    <!-- ============ 26. 当归桂枝芍药细辛（角药以上） ============ -->
    <owl:Class rdf:about="#Dangguisinigen">
        <rdfs:label xml:lang="zh">当归桂枝芍药细辛（方根）</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fanggen"/>
        <fanggenType xml:lang="zh">角药以上</fanggenType>
        <rdfs:comment xml:lang="zh">源方：当归四逆汤（351条）。养血温经。</rdfs:comment>
    </owl:Class>

    <!-- ============ 27. 乌头蜜（药对） ============ -->
    <owl:Class rdf:about="#Wutougen">
        <rdfs:label xml:lang="zh">乌头蜜（方根）</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fanggen"/>
        <fanggenType xml:lang="zh">药对</fanggenType>
        <rdfs:comment xml:lang="zh">源方：乌头汤。温经止痛。</rdfs:comment>
    </owl:Class>

    <!-- ============ 28. 百合（单味） ============ -->
    <owl:Class rdf:about="#Baihegen">
        <rdfs:label xml:lang="zh">百合（方根）</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fanggen"/>
        <fanggenType xml:lang="zh">单味</fanggenType>
        <rdfs:comment xml:lang="zh">百合地黄汤核心。润肺清心。</rdfs:comment>
    </owl:Class>

    <!-- ============ 29. 大黄桃仁（药对·构造性） ============ -->
    <owl:Class rdf:about="#DahuangTaorengen">
        <rdfs:label xml:lang="zh">大黄桃仁（方根·构造性）</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fanggen"/>
        <fanggenType xml:lang="zh">药对（构造性）</fanggenType>
        <rdfs:comment xml:lang="zh">下瘀血汤核心。攻下瘀血。</rdfs:comment>
    </owl:Class>

    <!-- ============ 30. 白头翁黄柏黄连秦皮（角药） ============ -->
    <owl:Class rdf:about="#Baitouwenggen">
        <rdfs:label xml:lang="zh">白头翁黄柏黄连秦皮（方根）</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fanggen"/>
        <fanggenType xml:lang="zh">角药</fanggenType>
        <rdfs:comment xml:lang="zh">源方：白头翁汤。清热治利。</rdfs:comment>
    </owl:Class>

    <!-- ============ 31. 吴茱萸人参生姜大枣（全方即根） ============ -->
    <owl:Class rdf:about="#Wuzhuyugen">
        <rdfs:label xml:lang="zh">吴茱萸人参生姜大枣（方根）</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fanggen"/>
        <fanggenType xml:lang="zh">全方即根</fanggenType>
        <rdfs:comment xml:lang="zh">源方：吴茱萸汤。温中降逆。</rdfs:comment>
    </owl:Class>

    <!-- ============ 32. 干地黄山药山茱萸桂附（角药以上） ============ -->
    <owl:Class rdf:about="#Shenqigen">
        <rdfs:label xml:lang="zh">干地黄山药山茱萸桂附（方根）</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fanggen"/>
        <fanggenType xml:lang="zh">角药以上</fanggenType>
        <rdfs:comment xml:lang="zh">源方：肾气丸。温补肾阳。</rdfs:comment>
    </owl:Class>

    <!-- ============ 33. 酸枣仁甘草知母茯苓川芎（全方即根） ============ -->
    <owl:Class rdf:about="#Suanzaorengen">
        <rdfs:label xml:lang="zh">酸枣仁甘草知母茯苓川芎（方根）</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fanggen"/>
        <fanggenType xml:lang="zh">全方即根</fanggenType>
        <rdfs:comment xml:lang="zh">源方：酸枣仁汤。养血安神。</rdfs:comment>
    </owl:Class>

    <!-- ============ 34. 芍药甘草（药对） ============ -->
    <owl:Class rdf:about="#Shaoyaogancaogen">
        <rdfs:label xml:lang="zh">芍药甘草（方根）</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fanggen"/>
        <fanggenType xml:lang="zh">药对</fanggenType>
        <rdfs:comment xml:lang="zh">源方：芍药甘草汤（29条）。缓急止痛。</rdfs:comment>

        <addHerbRule rdf:parseType="Literal">IF Ehan THEN add Fuzi</addHerbRule>
        <ruleSource xml:lang="zh">《伤寒论》68条：发汗病不解，反恶寒者，虚故也，芍药甘草附子汤主之。</ruleSource>
    </owl:Class>

    <!-- ============ 35. 芍药（单味） ============ -->
    <owl:Class rdf:about="#Shaoyaogen">
        <rdfs:label xml:lang="zh">芍药（方根）</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fanggen"/>
        <fanggenType xml:lang="zh">单味</fanggenType>
        <rdfs:comment xml:lang="zh">芍药类方证核心。主挛急腹痛。</rdfs:comment>
    </owl:Class>

    <!-- ============ 36. 乌梅（单味） ============ -->
    <owl:Class rdf:about="#Wumeigen">
        <rdfs:label xml:lang="zh">乌梅（方根）</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fanggen"/>
        <fanggenType xml:lang="zh">单味</fanggenType>
        <rdfs:comment xml:lang="zh">乌梅丸核心。安蛔止痛。</rdfs:comment>
    </owl:Class>

    <!-- ============ 37. 旋覆花（单味） ============ -->
    <owl:Class rdf:about="#Xuanfuhuagen">
        <rdfs:label xml:lang="zh">旋覆花（方根）</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fanggen"/>
        <fanggenType xml:lang="zh">单味</fanggenType>
        <rdfs:comment xml:lang="zh">旋覆代赭汤核心。降逆化痰。</rdfs:comment>
    </owl:Class>

    <!-- ============ 38. 附子白术甘草（角药·构造性·方证级注释） ============ -->
    <owl:Class rdf:about="#FuziBaizhuGancaogen">
        <rdfs:label xml:lang="zh">附子白术甘草（方根·构造性）</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Fanggen"/>
        <fanggenType xml:lang="zh">角药（构造性）</fanggenType>
        <rdfs:comment xml:lang="zh">仅作白术附子/甘草附子两方证的方证级 hasFanggen 注释，不构成家族。</rdfs:comment>
    </owl:Class>

</rdf:RDF>
