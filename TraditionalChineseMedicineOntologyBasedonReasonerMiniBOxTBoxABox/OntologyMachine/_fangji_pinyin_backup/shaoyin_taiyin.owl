<?xml version='1.0' encoding='UTF-8'?>
<rdf:RDF xmlns="http://www.tcm-classics.org/jingfang#" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:base="http://www.tcm-classics.org/jingfang#">

    <owl:Ontology rdf:about="http://www.tcm-classics.org/jingfang/shaoyin_taiyin">
        <rdfs:label xml:lang="zh">少阴太阴系统（附子+理中+苓桂剂+五苓散+苓甘五味姜辛）</rdfs:label>
        <rdfs:comment xml:lang="zh">含四逆汤类、理中汤类、阴证水气类、苓桂剂类、五苓散类、苓甘五味姜辛类六大家族，共 33 方证。本文件不再重复声明 clinicalPriority、bagangAttr、addHerb，这些属性声明见 rules.owl。rules.owl 中原有的 clinicalPriority 与 bagangAttr 补充值已合并到本文件各具体类中。原文件中 #Gancaoganjiangfulingbaizhutangzheng 重复定义已合并。</rdfs:comment>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/core"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/zhengzhuang"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/maixiang"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/fangji"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/yaowu"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/fanggen"/>
        <owl:imports rdf:resource="http://www.tcm-classics.org/jingfang/rules"/>
    </owl:Ontology>

    <!-- ============================================================ -->
    <!-- 一、四逆汤类家族                                              -->
    <!-- ============================================================ -->
    <owl:Class rdf:about="#Sinitangleifangzheng">
        <rdfs:label xml:lang="zh">四逆汤类方证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Jiazu"/>
        <hasFanggen rdf:resource="#Ganjiangfuzigen"/>
        <isAbstract rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isAbstract>
        <rdfs:comment xml:lang="zh">母方：四逆汤。共性（注释）：里虚寒极，脉微细/沉微，厥逆下利。少阴病主方家族；277条“自利不渴者属太阴，当温之，宜服四逆辈”——跨少阴、太阴。</rdfs:comment>
    </owl:Class>

    <!-- 四逆汤证 -->
    <owl:Class rdf:about="#Sinitangzheng">
        <rdfs:label xml:lang="zh">四逆汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Sinitangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Shaoyinbing"/>
        <differentialAxis xml:lang="zh">厥逆+下利清谷/脉沉微；无身反不恶寒面赤（323条）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</clinicalPriority>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yin"/>
        <bagangAttr rdf:resource="#Xu"/>
        <bagangAttr rdf:resource="#Han"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                <owl:Class rdf:about="#Shaoyinbing"/><owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Shouzuleng"/></owl:Restriction>
                <owl:Class><owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xialiqinggu"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_maixiang"/><owl:someValuesFrom rdf:resource="#Chenweimai"/></owl:Restriction>
                </owl:unionOf></owl:Class>
            </owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
        <owl:disjointWith rdf:resource="#Baihutangzheng"/>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Sinitang"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

