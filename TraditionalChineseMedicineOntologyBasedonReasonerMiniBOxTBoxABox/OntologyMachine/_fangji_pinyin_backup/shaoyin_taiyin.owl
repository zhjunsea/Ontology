    <!-- 黄芪桂枝五物汤证 -->
    <owl:Class rdf:about="#Huangqiguizhiwuwutangzheng">
        <rdfs:label xml:lang="zh">黄芪桂枝五物汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Guizhitangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Taiyinbing"/>
        <differentialAxis xml:lang="zh">身体不仁+如风痹状（金匮血痹）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
        <bagangAttr rdf:resource="#Biao"/>
        <bagangAttr rdf:resource="#Yang"/>
        <bagangAttr rdf:resource="#Xu"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                <owl:Class rdf:about="#Taiyinbing"/><owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Shentiburen"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Rufengbizhuang"/></owl:Restriction>
            </owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Huangqiguizhiwuwutang"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

    <!-- 小建中汤证 -->
    <owl:Class rdf:about="#Xiaojianzhongtangzheng">
        <rdfs:label xml:lang="zh">小建中汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Guizhitangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Jianzhongtangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <primaryFamily rdf:resource="#Jianzhongtangleifangzheng"/>
        <belongsToLiujing rdf:resource="#Taiyinbing"/>
        <differentialAxis xml:lang="zh">腹中急痛或心悸而烦（100、102条）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yin"/>
        <bagangAttr rdf:resource="#Xu"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection"><owl:Class rdf:about="#Taiyinbing"/><owl:Class><owl:unionOf rdf:parseType="Collection">
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Fuzhongjiaotong"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xinji"/></owl:Restriction>
            </owl:unionOf></owl:Class></owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Xiaojianzhongtang"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

    <!-- 黄芪建中汤证 -->
    <owl:Class rdf:about="#Huangqijianzhongtangzheng">
        <rdfs:label xml:lang="zh">黄芪建中汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Guizhitangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Jianzhongtangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <primaryFamily rdf:resource="#Jianzhongtangleifangzheng"/>
        <belongsToLiujing rdf:resource="#Taiyinbing"/>
        <differentialAxis xml:lang="zh">虚劳里急+诸不足（金匮血痹虚劳）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yin"/>
        <bagangAttr rdf:resource="#Xu"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                <owl:Class rdf:about="#Taiyinbing"/><owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Liji"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xulao"/></owl:Restriction>
            </owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Huangqijianzhongtang"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

    <!-- 内补当归建中汤证 -->
    <owl:Class rdf:about="#Neibudangguijianzhongtangzheng">
        <rdfs:label xml:lang="zh">内补当归建中汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Guizhitangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Jianzhongtangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <primaryFamily rdf:resource="#Jianzhongtangleifangzheng"/>
        <belongsToLiujing rdf:resource="#Taiyinbing"/>
        <differentialAxis xml:lang="zh">产后虚羸不足+腹中刺痛+少腹拘急（金匮妇人产后附方）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yin"/>
        <bagangAttr rdf:resource="#Xu"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                <owl:Class rdf:about="#Taiyinbing"/><owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Futong"/></owl:Restriction>
				<owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Citong"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Shaofujuji"/></owl:Restriction>
            </owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Xixishaoqi"/>
        <possibleSymptom rdf:resource="#Yinyaobeitong"/>
        <possibleSymptom rdf:resource="#Bunengyinshi"/>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Neibudangguijianzhongtang"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

    <!-- 射干麻黄汤证 -->
    <owl:Class rdf:about="#Sheganmahuangtangzheng">
        <rdfs:label xml:lang="zh">射干麻黄汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Mahuangtangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Taiyinbing"/>
        <debatable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</debatable>
        <differentialAxis xml:lang="zh">咳而上气+喉中水鸡声（金匮肺痿）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yin"/>
        <bagangAttr rdf:resource="#Shi"/>
        <bagangAttr rdf:resource="#Han"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                <owl:Class rdf:about="#Taiyinbing"/>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Keershangqi"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Houzhongshuijisheng"/></owl:Restriction>
            </owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Sheganmahuangtang"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

    <!-- 越婢加半夏汤证 -->
    <owl:Class rdf:about="#Yuebijiabanxiatangzheng">
        <rdfs:label xml:lang="zh">越婢加半夏汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Mahuangtangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Taiyinbing"/>
        <debatable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</debatable>
        <differentialAxis xml:lang="zh">咳而上气+目如脱状（金匮肺痿）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yang"/>
        <bagangAttr rdf:resource="#Shi"/>
        <bagangAttr rdf:resource="#Re"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                <owl:Class rdf:about="#Taiyinbing"/><owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Kesou"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Chuan"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Murutuozhuang"/></owl:Restriction>
            </owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Fudamai"/>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Yuebijiabanxiatang"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

    <!-- 麻黄附子细辛汤证 -->
    <owl:Class rdf:about="#Mahuangfuzixixintangzheng">
        <rdfs:label xml:lang="zh">麻黄附子细辛汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Mahuangtangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Shaoyinbing"/>
        <differentialAxis xml:lang="zh">反发热+脉沉+但欲寐（301条）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</clinicalPriority>
        <bagangAttr rdf:resource="#Biao"/>
        <bagangAttr rdf:resource="#Yin"/>
        <bagangAttr rdf:resource="#Xu"/>
        <bagangAttr rdf:resource="#Han"/>
        <owl:equivalentClass>
				  <owl:Class>
				    <owl:intersectionOf rdf:parseType="Collection">
				      <owl:Class rdf:about="#Shaoyinbing"/>
				      <owl:Restriction>
				        <owl:onProperty rdf:resource="#you_zhengzhuang"/>
				        <owl:someValuesFrom rdf:resource="#Fare"/>
				      </owl:Restriction>
				      <owl:Restriction>
				        <owl:onProperty rdf:resource="#you_maixiang"/>
				        <owl:someValuesFrom rdf:resource="#Chenmai"/>
				      </owl:Restriction>
				    </owl:intersectionOf>
				  </owl:Class>
				</owl:equivalentClass>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Mahuangfuzixixintang"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

    <!-- 麻黄附子甘草汤证 -->
    <owl:Class rdf:about="#Mahuangfuzigancaotangzheng">
        <rdfs:label xml:lang="zh">麻黄附子甘草汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Mahuangtangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Shaoyinbing"/>
        <differentialAxis xml:lang="zh">恶寒+但欲寐（302条）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
        <bagangAttr rdf:resource="#Biao"/>
        <bagangAttr rdf:resource="#Yin"/>
        <bagangAttr rdf:resource="#Xu"/>
        <bagangAttr rdf:resource="#Han"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                <owl:Class rdf:about="#Shaoyinbing"/>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Ehan"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Danyumei"/></owl:Restriction>
            </owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Mahuangfuzigancaotang"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

    <!-- 麻黄附子汤证 -->
    <owl:Class rdf:about="#Mahuangfuzitangzheng">
        <rdfs:label xml:lang="zh">麻黄附子汤证</rdfs:label>
        <rdfs:comment xml:lang="zh">少阴阳虚，水气在表。脉沉小、水肿、小便不利为核心辨证眼目。即《伤寒论》麻黄附子甘草汤证，治以温经助阳、微微发汗以去水。</rdfs:comment>
        <rdfs:subClassOf rdf:resource="#Mahuangtangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Shaoyinbing"/>
        <differentialAxis xml:lang="zh">脉沉小+水肿+小便不利，属少阴（金匮·水气病篇）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
	
        <!-- 八纲：水在表，少阴阳虚，里寒不显，故不标里证 -->
        <bagangAttr rdf:resource="#Biao"/>
        <bagangAttr rdf:resource="#Yin"/>
        <bagangAttr rdf:resource="#Xu"/>
        <bagangAttr rdf:resource="#Han"/>
	
        <!-- 等价类：少阴 + 脉沉小 + 水肿 + 小便不利 + 无汗 -->
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Shaoyinbing"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_maixiang"/>
                        <owl:someValuesFrom rdf:resource="#Chenxiaomai"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                        <owl:someValuesFrom rdf:resource="#Shuizhong"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                        <owl:someValuesFrom rdf:resource="#Xiaobianbuli"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#you_zhengzhuang"/>
                        <owl:someValuesFrom rdf:resource="#Wuhan"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
	
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#you_chufang"/>
                <owl:hasValue rdf:resource="#Mahuangfuzitang"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <!-- 乌头赤石脂丸证 -->
    <owl:Class rdf:about="#Wutouchishizhiwanzheng">
        <rdfs:label xml:lang="zh">乌头赤石脂丸证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Wutoutangleifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Taiyinbing"/>
        <debatable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</debatable>
        <differentialAxis xml:lang="zh">心痛彻背+背痛彻心（金匮胸痹）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</clinicalPriority>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yin"/>
        <bagangAttr rdf:resource="#Shi"/>
        <bagangAttr rdf:resource="#Han"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                <owl:Class rdf:about="#Taiyinbing"/><owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xintongchebei"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Beitongchexin"/></owl:Restriction>
            </owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Wutouchishizhiwan"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

</rdf:RDF>
