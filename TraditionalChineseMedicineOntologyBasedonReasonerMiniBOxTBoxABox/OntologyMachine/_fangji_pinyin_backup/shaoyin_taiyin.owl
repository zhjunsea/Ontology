        <rdfs:subClassOf rdf:resource="#Jiazu"/>
        <hasFanggen rdf:resource="#FulingBaizhuFuzigen"/>
        <isAbstract rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isAbstract>
        <rdfs:comment xml:lang="zh">母方：真武汤。共性（注释）：水气病陷入阴证者。胡师：未陷入阴证者苓桂术甘，陷入阴证者真武汤一类。</rdfs:comment>
    </owl:Class>

    <!-- 真武汤证 -->
    <owl:Class rdf:about="#Zhenwutangzheng">
        <rdfs:label xml:lang="zh">真武汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Yinzhengshuiqileifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Shaoyinbing"/>
        <differentialAxis xml:lang="zh">心下悸+头眩+身瞤动+振振欲擗地（82条）；或腹痛+下利+四肢沉重疼痛（316条）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
        <bagangAttr rdf:resource="#Biao"/>
        <bagangAttr rdf:resource="#Yin"/>
        <bagangAttr rdf:resource="#Xu"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection"><owl:Class rdf:about="#Shaoyinbing"/><owl:Class><owl:unionOf rdf:parseType="Collection">
                <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xinxiajidong"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Touxuan"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Shenrundong"/></owl:Restriction>
                </owl:intersectionOf></owl:Class>
                <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Futong"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xiali"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Sizhichenzhongtengtong"/></owl:Restriction>
                </owl:intersectionOf></owl:Class>
            </owl:unionOf></owl:Class></owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
        <owl:disjointWith rdf:resource="#Lingguizhugantangzheng"/>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Zhenwutang"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

    <!-- 附子汤证 -->
    <owl:Class rdf:about="#Fuzitangzheng">
