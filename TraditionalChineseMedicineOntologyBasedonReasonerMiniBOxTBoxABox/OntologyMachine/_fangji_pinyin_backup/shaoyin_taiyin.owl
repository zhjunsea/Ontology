                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Shouzuleng"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Gujietong"/></owl:Restriction>
            </owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Fuzitang"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

    <!-- ============================================================ -->
    <!-- 四、苓桂剂类家族                                              -->
    <!-- ============================================================ -->
    <owl:Class rdf:about="#Lingguijileifangzheng">
        <rdfs:label xml:lang="zh">苓桂剂类方证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Jiazu"/>
        <hasFanggen rdf:resource="#Fulingguizhigen"/>
        <isAbstract rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isAbstract>
        <rdfs:comment xml:lang="zh">茯苓+桂枝方根家族。共性（注释）：水饮内停、气上冲。跨经：苓桂术甘（太阳类方，胡师“未陷入阴证者”）、茯苓甘草汤（73条太阳/356条厥阴两见）、苓桂枣甘（太阳65条）。</rdfs:comment>
    </owl:Class>

    <!-- 苓桂术甘汤证 -->
    <owl:Class rdf:about="#Lingguizhugantangzheng">
        <rdfs:label xml:lang="zh">苓桂术甘汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Lingguijileifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Taiyangbing"/>
        <belongsToLiujing rdf:resource="#Taiyinbing"/>
        <debatable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</debatable>
        <differentialAxis xml:lang="zh">心下逆满+气上冲胸+起则头眩（67条）；等价类含 ¬Shenrundong + ¬Xiali（排除真武 82/316 双支）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
        <bagangAttr rdf:resource="#Li"/>
        <bagangAttr rdf:resource="#Yin"/>
        <bagangAttr rdf:resource="#Xu"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                <owl:Class><owl:unionOf rdf:parseType="Collection"><owl:Class rdf:about="#Taiyangbing"/><owl:Class rdf:about="#Taiyinbing"/></owl:unionOf></owl:Class><owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xinxianiman"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Qishangchongxiong"/></owl:Restriction>
                <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Qizetouxuan"/></owl:Restriction>
                <owl:Class><owl:complementOf>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Shenrundong"/></owl:Restriction>
                </owl:complementOf></owl:Class>
                <owl:Class><owl:complementOf>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xiali"/></owl:Restriction>
                </owl:complementOf></owl:Class>
            </owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
        <possibleSymptom rdf:resource="#Chenjinmai"/>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Lingguizhugantang"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

    <!-- 茯苓甘草汤证 -->
    <owl:Class rdf:about="#Fulinggancaotangzheng">
        <rdfs:label xml:lang="zh">茯苓甘草汤证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Lingguijileifangzheng"/>
        <rdfs:subClassOf rdf:resource="#Fangzheng"/>
        <belongsToLiujing rdf:resource="#Taiyangbing"/>
        <belongsToLiujing rdf:resource="#Jueyinbing"/>
        <differentialAxis xml:lang="zh">渴者五苓散，不渴者茯苓甘草汤（73条）；主证心下悸（356条）</differentialAxis>
        <clinicalPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</clinicalPriority>
        <bagangAttr rdf:resource="#Biao"/>
        <bagangAttr rdf:resource="#Yang"/>
        <owl:equivalentClass>
            <owl:Class><owl:intersectionOf rdf:parseType="Collection"><owl:Class><owl:unionOf rdf:parseType="Collection"><owl:Class rdf:about="#Taiyangbing"/><owl:Class rdf:about="#Jueyinbing"/></owl:unionOf></owl:Class><owl:Class><owl:unionOf rdf:parseType="Collection">
                <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xinxiajidong"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Buke"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xiaobianbuli"/></owl:Restriction>
                </owl:intersectionOf></owl:Class>
                <owl:Class><owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Shouzuleng"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Xinxiajidong"/></owl:Restriction>
                    <owl:Restriction><owl:onProperty rdf:resource="#you_zhengzhuang"/><owl:someValuesFrom rdf:resource="#Buke"/></owl:Restriction>
                </owl:intersectionOf></owl:Class>
            </owl:unionOf></owl:Class></owl:intersectionOf></owl:Class>
        </owl:equivalentClass>
        <owl:disjointWith rdf:resource="#Wulingsanzheng"/>
        <possibleSymptom rdf:resource="#Hanchu"/>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#you_chufang"/><owl:hasValue rdf:resource="#Fulinggancaotang"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

    <!-- ============================================================ -->
    <!-- 五、五苓散类家族（隶属苓桂剂）                                -->
    <!-- ============================================================ -->
    <owl:Class rdf:about="#Wulingsanleifangzheng">
        <rdfs:label xml:lang="zh">五苓散类方证</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Lingguijileifangzheng"/>
        <hasFanggen rdf:resource="#FulingZexiegen"/>
        <hasFanggen rdf:resource="#Fulingguizhigen"/>
        <isAbstract rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isAbstract>
        <rdfs:comment xml:lang="zh">母方：五苓散。共性（注释）：表邪未解兼里有停水，小便不利而渴。八纲语言，删“膀胱气化不利”。徐氏五苓散类收猪苓汤、文蛤散、茯苓甘草汤；本本体按方根判据分别处理。</rdfs:comment>
    </owl:Class>

    <!-- 五苓散证 -->
    <owl:Class rdf:about="#Wulingsanzheng">
