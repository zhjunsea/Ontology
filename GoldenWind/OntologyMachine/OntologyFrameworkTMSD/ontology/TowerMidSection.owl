    <!-- === 扶持到焊缝距离 > 100（host: Support）=== -->
    <owl:Class rdf:about="#SupportToWeldCompliant">
        <rdfs:label xml:lang="zh">扶持到焊缝距离合规</rdfs:label>
        <rdfs:comment xml:lang="zh">:校验值 &gt; 100（与 :扶持 的 Restriction 同源，须同步）</rdfs:comment>
