                                    </rdf:Description>
                                    <rdf:Description>
                                        <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">3000</xsd:maxInclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <!-- === 灯与灯最小间距 ≥ 5000（host: TowerMidSection）=== -->
    <owl:Class rdf:about="#LightMinSpacingCompliant">
        <rdfs:label xml:lang="zh">灯与灯最小间距合规</rdfs:label>
        <rdfs:comment xml:lang="zh">:校验值 ≥ 5000（与 :塔架中段 的 Restriction 同源，须同步）</rdfs:comment>
