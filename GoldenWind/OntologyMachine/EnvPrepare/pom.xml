<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.ocean</groupId>
    <artifactId>EnvPrepare</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>EnvPrepare</name>
    <description>环境准备与启动工具（Java）：按指定的 application.yaml 启停应用环境 / 建库 / 建 RabbitMQ 资源</description>

    <properties>
        <java.version>26</java.version>
    </properties>

    <dependencies>
        <!-- 仅依赖 JDK，无第三方依赖：进程走 ProcessHandle/taskkill/PowerShell CIM，
             RabbitMQ 走 java.net.http.HttpClient，配置解析为内置轻量 YAML 解析。 -->
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.ocean.envprepare.EnvPrepare</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
