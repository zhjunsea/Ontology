    <!-- ChicagoDeepDishPizza -->
    <owl:NamedIndividual rdf:about="chicagoDeepDishPizzaInstance">
        <rdf:type rdf:resource="http://example.org/pizza/core/ChicagoDeepDishPizza"/>
