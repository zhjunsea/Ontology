        <pizza:hasCheese rdf:resource="http://example.org/pizza/components-abox/lowMoistureMozzarellaInstance"/>
        <pizza:stackingOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#string">inverted</pizza:stackingOrder>
    </owl:NamedIndividual>

    <!-- DetroitPizza -->
    <owl:NamedIndividual rdf:about="detroitPizzaInstance">
