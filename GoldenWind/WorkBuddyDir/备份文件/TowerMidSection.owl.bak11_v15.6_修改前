<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns="http://goldwind.com/ontology/tower-mid-section#"
         xml:base="http://goldwind.com/ontology/tower-mid-section"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

    <owl:Ontology rdf:about="http://goldwind.com/ontology/tower-mid-section">
        <rdfs:label xml:lang="zh">塔架中段本体</rdfs:label>
        <rdfs:comment xml:lang="zh">基于塔架中段设计流程构建。设计原则：真实存在的物理对象定义为类，其余定义为属性；属性承载实例值，约束用 owl:Restriction 表达。设计步骤放到 BPMN 中。面向 Openllet 推理。v11.0 依老工具（towerdesign）补充法兰、电缆线夹、安全锚点、材料、电缆托架规格五类。v11.1 明确 :梯子高度 归属 :爬梯、:平台到筒顶距离 归属 :平台。v11.2 确认塔架顶法兰位于 :塔架顶段。v12.0 依《定制化设计》流程修正：:附件中心间距 收窄至 1680~1960；新增 :附件连接方式、:灯类型 等。v13.0 依专家审视报告修正：合并 8 个同义「固定在塔筒」属性为 1 个；删除 :同侧爬梯支撑、:扶持到焊缝距离 等冗余；:固定在塔架 值域改为 :法兰 并新增 :有顶法兰；:安全锚点 归入 :附件；:材料 改为分类值；:有机型/:有区域 上提至 :风机（项目级）；新增 :电缆 类及法兰/线槽/平台/锚点/升降机/相邻段等关系；增强基数约束。v14.0 依 BPMN 设计流程裁剪：删除与中段设计流程无关的 :风机、:风机机头、:偏航轴承、:塔架底段、:塔架顶段 五类，及端点失效的对象属性（:有机头/:机头属于、:有塔架/:塔架属于、:支撑机头/:机头被支撑、:连接机头、:固定在塔架、:有顶法兰）；:有机型/:有区域 改挂至 :塔架中段（逆属性随之改名）；保留抽象父类 :塔架 与 :塔架段。v15.0 依专家审视报告与业务决策修正：**P0-1** :塔架段 改为 :塔架 子类（rdfs:subClassOf），并从顶层物理对象不相交组移出；**P0-2** 新增顶层类 :构件，:螺柱/:线槽 由 :附件 子类改挂 :构件 子类（业务确认：附件不包括螺柱，也不包括线槽）；**P0-3** :是否隔开电缆线夹 标记为待业务确认；**P1-1** 删除 :直径，几何由 :外径底部/:外径顶部（段级）+ :筒节内径（筒节级）承载；**P1-2** :环焊缝 连接筒节 由 ≥2 改为精确 =2；**P1-3** :电缆托架规格 补身份键 owl:hasKey；**P1-4** 补 3 条有依据约束（:第一附件到底部=980、:最后电缆托架到平台=200、:倒数第二附件到平台 1400~1960）；**P1-5** :螺柱间距 改名 :灯上螺柱间距，:灯上螺柱最大/最小间距 改名 :灯与灯最大/最小间距；**P1-6** :标高下/:标高上 注释改为「塔架中段」；**P1-7** :扶持位置 以流程 9.1 为准 =（中段筒高 − 1250）÷ 2；**P2** 删除 8 条无依据约束公理（平台宽度/集中荷载/栏杆高度/踢脚板高度、踏级间距/踏面宽度/爬梯净宽/爬梯与塔壁净距）。v15.1 依业务决策修正：**:扶持 由 :附件 改挂 :构件**（业务确认：扶持不算附件，因其属性与附件不同）；扶持不再继承 :附件到焊缝距离 / :附件中心间距，**仅保留焊缝距离约束**——单建数据属性 :扶持到焊缝距离（>100），不参与附件中心间距排布。v15.2 依业务决策精简：**:平台 的数据属性只保留 :平台到筒顶距离 与 :平台所在处内径**，删除 :平台宽度 / :平台集中荷载 / :栏杆高度 / :踢脚板高度（其数值约束已于 v15.0 依 P2 因缺乏依据移除）。**逆属性约定**：仅「组成关系（:有X）」与「双向定位/平齐关系（:平台到筒顶 ↔ :筒顶定位平台、:平齐 ↔ :平齐于）」建逆属性；固定/安装/连接/映射类关系不建逆属性（对称属性 :相邻于 自带逆关系）。v15.5 依业务决策修正：**删除线夹及相关属性**——删除类 :电缆线夹（CableClamp），及对象属性 :线夹映射到爬梯支撑 / :夹持电缆、数据属性 :线夹位置 / :是否隔开电缆线夹（域 :区域）；不相交组「附件子类」由 4 类减为 3 类（:爬梯支撑 / :电缆托架 / :安全锚点）。v15.4 依业务决策修正：**扶持删除 :扶持水平角度**（扶持现仅保留 :扶持位置 与 :扶持到焊缝距离 两条数据属性）。v15.3 依业务决策修正：**(A) 灯属性**——:焊接灯 恰好有 2 个螺柱（:安装在螺柱 qualifiedCardinality = 2）；:灯上螺柱间距 归属由 :照明系统 移至 :焊接灯（=500，同一焊接灯上两螺柱上下间距）；:灯螺柱到焊缝距离 明确为灯的上下两个螺柱各自到焊缝距离均 &gt; 100；删除 :下灯位置 / :上灯位置（v11.0 遗留，与现流程不符）。**(B) 爬梯属性精简**——:爬梯 只保留 :梯子高度，删除 :踏级间距 / :踏面宽度 / :爬梯净宽 / :爬梯与塔壁净距（其数值约束已于 v15.0 依 P2 因缺乏依据移除）。v15.6 依业务决策修正：**A** :与…平齐 改名 :平齐（表示主语与宾语等高）；**B** 删除类 :材料 及其属性（:有材料/:材料属于/:板材等级/:材料密度），改为每个主要结构件（:筒节/:法兰/:平台/:爬梯/:爬梯支撑/:电缆托架/:线槽/:扶持）的 :材质 数据属性（并集域）；**C** 删除类 :照明系统 及其组成属性（:有照明系统/:照明系统属于），:有灯 改挂 :塔架中段；照明布置属性（:第一灯安装高度/:灯与灯最大间距/:灯与灯最小间距）改挂 :塔架中段，约束公理随之迁移；**D** 扁平化：删除中间类 :塔架段，:塔架中段 直接作为 :塔架 子类（:有塔架段→:有塔架中段、:法兰连接塔架段→:法兰连接塔架中段、:相邻于 域/值域改 :塔架中段）；**E** 删除 :疲劳等级；**F** 删除 :螺柱安装角度；**G** 删除 :配件类型名称（:配件类型 身份键随之移除）；**H** 删除类 :安全锚点 及其属性（:有安全锚点/:锚点安装高度），附件子类不相交组由 3 类减为 2 类；**I** :支撑宽度 改名 :宽度，并集域扩至 :电缆托架。</rdfs:comment>
        <owl:versionInfo>v15.6</owl:versionInfo>
    </owl:Ontology>

    <!-- ============================================================ -->
    <!-- 一、对象属性 —— 组成关系（含逆属性）                          -->
    <!-- 逆属性必须一一对应，不得复用                                  -->
    <!-- ============================================================ -->

    <owl:ObjectProperty rdf:about="#hasTowerMidSection">
        <rdfs:domain rdf:resource="#Tower"/>
        <rdfs:range rdf:resource="#TowerMidSection"/>
        <owl:inverseOf rdf:resource="#midSectionBelongsToTower"/>
        <rdfs:label xml:lang="zh">有塔架中段</rdfs:label>
        <rdfs:comment xml:lang="zh">塔架由塔架中段组成（本项目仅涉及塔架中段）。v15.6 随 :塔架段 扁平化删除，由 :有塔架段 改名并收窄值域至 :塔架中段</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#midSectionBelongsToTower">
        <rdfs:label xml:lang="zh">塔架中段属于</rdfs:label>
        <rdfs:comment xml:lang="zh">有塔架中段 的逆属性（v15.6 随 :塔架段 扁平化删除改名）</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasTowerTube">
        <rdfs:domain rdf:resource="#TowerMidSection"/>
        <rdfs:range rdf:resource="#TowerTube"/>
        <owl:inverseOf rdf:resource="#tubeBelongsToTowerMidSection"/>
        <rdfs:label xml:lang="zh">有塔筒</rdfs:label>
        <rdfs:comment xml:lang="zh">塔架中段包含塔筒</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#tubeBelongsToTowerMidSection">
        <rdfs:label xml:lang="zh">塔筒属于</rdfs:label>
        <rdfs:comment xml:lang="zh">有塔筒 的逆属性</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasTubeSection">
        <rdfs:domain rdf:resource="#TowerTube"/>
        <rdfs:range rdf:resource="#TubeSection"/>
        <owl:inverseOf rdf:resource="#tubeSectionBelongsToTowerTube"/>
        <rdfs:label xml:lang="zh">有筒节</rdfs:label>
        <rdfs:comment xml:lang="zh">塔筒由筒节组成</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#tubeSectionBelongsToTowerTube">
        <rdfs:label xml:lang="zh">筒节属于</rdfs:label>
        <rdfs:comment xml:lang="zh">有筒节 的逆属性</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasWeldSeam">
        <rdfs:domain rdf:resource="#TowerTube"/>
        <rdfs:range rdf:resource="#WeldSeam"/>
        <owl:inverseOf rdf:resource="#weldSeamBelongsToTowerTube"/>
        <rdfs:label xml:lang="zh">有环焊缝</rdfs:label>
        <rdfs:comment xml:lang="zh">塔筒上的环焊缝</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#weldSeamBelongsToTowerTube">
        <rdfs:label xml:lang="zh">环焊缝属于</rdfs:label>
        <rdfs:comment xml:lang="zh">有环焊缝 的逆属性</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasPlatform">
        <rdfs:domain rdf:resource="#TowerMidSection"/>
        <rdfs:range rdf:resource="#Platform"/>
        <owl:inverseOf rdf:resource="#platformBelongsToTowerMidSection"/>
        <rdfs:label xml:lang="zh">有平台</rdfs:label>
        <rdfs:comment xml:lang="zh">塔架中段包含平台</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#platformBelongsToTowerMidSection">
        <rdfs:label xml:lang="zh">平台属于</rdfs:label>
        <rdfs:comment xml:lang="zh">有平台 的逆属性</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasLadder">
        <rdfs:domain rdf:resource="#TowerMidSection"/>
        <rdfs:range rdf:resource="#Ladder"/>
        <owl:inverseOf rdf:resource="#ladderBelongsToTowerMidSection"/>
        <rdfs:label xml:lang="zh">有爬梯</rdfs:label>
        <rdfs:comment xml:lang="zh">塔架中段包含爬梯</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#ladderBelongsToTowerMidSection">
        <rdfs:label xml:lang="zh">爬梯属于</rdfs:label>
        <rdfs:comment xml:lang="zh">有爬梯 的逆属性</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasElevator">
        <rdfs:domain rdf:resource="#TowerMidSection"/>
        <rdfs:range rdf:resource="#Elevator"/>
        <owl:inverseOf rdf:resource="#elevatorBelongsToTowerMidSection"/>
        <rdfs:label xml:lang="zh">有升降机</rdfs:label>
        <rdfs:comment xml:lang="zh">塔架中段包含升降机</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#elevatorBelongsToTowerMidSection">
        <rdfs:label xml:lang="zh">升降机属于</rdfs:label>
        <rdfs:comment xml:lang="zh">有升降机 的逆属性</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasLight">
        <rdfs:domain rdf:resource="#TowerMidSection"/>
        <rdfs:range rdf:resource="#Light"/>
        <owl:inverseOf rdf:resource="#lightBelongsToTowerMidSection"/>
        <rdfs:label xml:lang="zh">有灯</rdfs:label>
        <rdfs:comment xml:lang="zh">塔架中段包含灯（v15.6 随 :照明系统 删除，域由 :照明系统 改挂 :塔架中段）</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#lightBelongsToTowerMidSection">
        <rdfs:label xml:lang="zh">灯属于</rdfs:label>
        <rdfs:comment xml:lang="zh">有灯 的逆属性（v15.6 随 :照明系统 删除改名）</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasAccessory">
        <rdfs:domain rdf:resource="#TowerMidSection"/>
        <rdfs:range rdf:resource="#Accessory"/>
        <owl:inverseOf rdf:resource="#accessoryBelongsToTowerMidSection"/>
        <rdfs:label xml:lang="zh">有附件</rdfs:label>
        <rdfs:comment xml:lang="zh">塔架中段包含附件</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#accessoryBelongsToTowerMidSection">
        <rdfs:label xml:lang="zh">附件属于</rdfs:label>
        <rdfs:comment xml:lang="zh">有附件 的逆属性</rdfs:comment>
    </owl:ObjectProperty>

    <!-- v15.0 新增（P0-2）：构件（附件之外、同样固定在塔筒上的零件，如螺柱、线槽） -->
    <owl:ObjectProperty rdf:about="#hasComponent">
        <rdfs:domain rdf:resource="#TowerMidSection"/>
        <rdfs:range rdf:resource="#Component"/>
        <owl:inverseOf rdf:resource="#componentBelongsToTowerMidSection"/>
        <rdfs:label xml:lang="zh">有构件</rdfs:label>
        <rdfs:comment xml:lang="zh">塔架中段包含构件（螺柱、线槽、扶持等，v15.0 依 P0-2 新增，与 :有附件 并列；v15.1 加入扶持）</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#componentBelongsToTowerMidSection">
        <rdfs:label xml:lang="zh">构件属于</rdfs:label>
        <rdfs:comment xml:lang="zh">有构件 的逆属性（v15.0 新增）</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasSupport">
        <rdfs:domain rdf:resource="#RopeGuidedElevator"/>
        <rdfs:range rdf:resource="#Support"/>
        <owl:inverseOf rdf:resource="#supportBelongsToRopeGuidedElevator"/>
        <rdfs:label xml:lang="zh">有扶持</rdfs:label>
        <rdfs:comment xml:lang="zh">钢绳导向升降机的配套扶持件</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#supportBelongsToRopeGuidedElevator">
        <rdfs:label xml:lang="zh">扶持属于</rdfs:label>
        <rdfs:comment xml:lang="zh">有扶持 的逆属性</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasModel">
        <rdfs:domain rdf:resource="#TowerMidSection"/>
        <rdfs:range rdf:resource="#Model"/>
        <owl:inverseOf rdf:resource="#modelBelongsToTowerMidSection"/>
        <rdfs:label xml:lang="zh">有机型</rdfs:label>
        <rdfs:comment xml:lang="zh">塔架中段（项目级）对应的机型（分类值，用对象属性指向个体以便推理同机型）。v14.0 随 :风机 类删除，由 :风机 改挂至 :塔架中段</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#modelBelongsToTowerMidSection">
        <rdfs:label xml:lang="zh">机型属于</rdfs:label>
        <rdfs:comment xml:lang="zh">有机型 的逆属性（v14.0 随 domain 改挂改名）</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasRegion">
        <rdfs:domain rdf:resource="#TowerMidSection"/>
        <rdfs:range rdf:resource="#Region"/>
        <owl:inverseOf rdf:resource="#regionBelongsToTowerMidSection"/>
        <rdfs:label xml:lang="zh">有区域</rdfs:label>
        <rdfs:comment xml:lang="zh">塔架中段（项目级）适用的全球区域/国家（分类值，用对象属性指向个体以便推理同区域）。v14.0 随 :风机 类删除，由 :风机 改挂至 :塔架中段</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#regionBelongsToTowerMidSection">
        <rdfs:label xml:lang="zh">区域属于</rdfs:label>
        <rdfs:comment xml:lang="zh">有区域 的逆属性（v14.0 随 domain 改挂改名）</rdfs:comment>
    </owl:ObjectProperty>

    <!-- ============================================================ -->
    <!-- 二、对象属性 —— 支撑关系                                      -->
    <!-- ============================================================ -->

    <owl:ObjectProperty rdf:about="#supportsLadder">
        <rdfs:domain rdf:resource="#LadderSupport"/>
        <rdfs:range rdf:resource="#Ladder"/>
        <owl:inverseOf rdf:resource="#ladderSupportedBy"/>
        <rdfs:label xml:lang="zh">支撑爬梯</rdfs:label>
        <rdfs:comment xml:lang="zh">爬梯支撑支撑爬梯</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#ladderSupportedBy">
        <rdfs:label xml:lang="zh">爬梯被支撑</rdfs:label>
        <rdfs:comment xml:lang="zh">支撑爬梯 的逆属性</rdfs:comment>
    </owl:ObjectProperty>

    <!-- ============================================================ -->
    <!-- 四、对象属性 —— 位置关系                                      -->
    <!-- ============================================================ -->

    <owl:ObjectProperty rdf:about="#mappedToLadderSupport">
        <rdfs:domain rdf:resource="#CableBracket"/>
        <rdfs:range rdf:resource="#LadderSupport"/>
        <rdfs:label xml:lang="zh">映射到爬梯支撑</rdfs:label>
        <rdfs:comment xml:lang="zh">电缆托架中心距同侧爬梯支撑的弦长满足映射关系（步骤7.1）</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasPositionToWeldSeam">
        <rdfs:domain rdf:resource="#Accessory"/>
        <rdfs:range rdf:resource="#WeldSeam"/>
        <rdfs:label xml:lang="zh">相对于环焊缝位置</rdfs:label>
        <rdfs:comment xml:lang="zh">附件与环焊缝的位置关系，上下距离 &gt; 100mm（步骤5.1）</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#studToWeldSeamPosition">
        <rdfs:domain rdf:resource="#Stud"/>
        <rdfs:range rdf:resource="#WeldSeam"/>
        <rdfs:label xml:lang="zh">螺柱到焊缝位置</rdfs:label>
        <rdfs:comment xml:lang="zh">焊接灯的螺柱与焊缝之间距离 &gt; 100mm（步骤5.6）</rdfs:comment>
    </owl:ObjectProperty>

    <!-- ============================================================ -->
    <!-- 五、对象属性 —— 固定关系                                      -->
    <!-- ============================================================ -->

    <owl:ObjectProperty rdf:about="#attachedToTowerTube">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Accessory"/>
                    <owl:Class rdf:about="#Component"/>
                    <owl:Class rdf:about="#Platform"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="#TowerTube"/>
        <rdfs:label xml:lang="zh">固定在塔筒</rdfs:label>
        <rdfs:comment xml:lang="zh">零件固定在塔筒上。v13.0 合并原 8 个同义属性（爬梯支撑/电缆托架/平台/螺柱/线槽/扶持/电缆线夹/安全锚点各建一个），domain 统一为 :附件 ∪ :构件 ∪ :平台（v15.0 加入 :构件；v15.6 安全锚点已删除）</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#installedInTowerTube">
        <rdfs:domain rdf:resource="#Elevator"/>
        <rdfs:range rdf:resource="#TowerTube"/>
        <rdfs:label xml:lang="zh">安装在塔筒</rdfs:label>
        <rdfs:comment xml:lang="zh">升降机安装在塔筒内</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#platformToTubeTop">
        <rdfs:domain rdf:resource="#Platform"/>
        <rdfs:range rdf:resource="#TowerTube"/>
        <owl:inverseOf rdf:resource="#tubeTopLocatesPlatform"/>
        <rdfs:label xml:lang="zh">平台到筒顶</rdfs:label>
        <rdfs:comment xml:lang="zh">表示平台相对于中段塔筒顶端的定位关系；具体距离值由数据属性 :平台到筒顶距离 承载（固定 1250mm）（v11.1 新增）</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#tubeTopLocatesPlatform">
        <rdfs:label xml:lang="zh">筒顶定位平台</rdfs:label>
        <rdfs:comment xml:lang="zh">平台到筒顶 的逆属性（v11.1 新增）</rdfs:comment>
    </owl:ObjectProperty>

    <!-- ============================================================ -->
    <!-- 五之二、对象属性 —— 连接方式 / 灯类型 / 平齐 / 同侧（v12.0 新增）-->
    <!-- 依据定制化设计流程：步骤2匹配维度、5.1平齐、5.4灯类型、7.1同侧   -->
    <!-- ============================================================ -->

    <owl:ObjectProperty rdf:about="#hasConnectionType">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#LadderSupport"/>
                    <owl:Class rdf:about="#CableBracket"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="#AccessoryConnectionType"/>
        <owl:inverseOf rdf:resource="#connectionTypeBelongsToAccessory"/>
        <rdfs:label xml:lang="zh">有连接方式</rdfs:label>
        <rdfs:comment xml:lang="zh">附件的安装方式。主要用于 :爬梯支撑 与 :电缆托架——二者如何安装在塔筒上（粘贴式 / 焊接式），不同方式选用配件不同（定制化设计流程步骤2匹配维度、步骤8替换配件类型依据，v12.0 新增）</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#connectionTypeBelongsToAccessory">
        <rdfs:label xml:lang="zh">连接方式属于</rdfs:label>
        <rdfs:comment xml:lang="zh">有连接方式 的逆属性（v12.0 新增）</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasLightType">
        <rdfs:domain rdf:resource="#Light"/>
        <rdfs:range rdf:resource="#LightType"/>
        <owl:inverseOf rdf:resource="#lightTypeBelongsToLight"/>
        <rdfs:label xml:lang="zh">有灯类型</rdfs:label>
        <rdfs:comment xml:lang="zh">灯的类型，由「机型 + 区域」确定（定制化设计流程 5.4，v12.0 新增）</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#lightTypeBelongsToLight">
        <rdfs:label xml:lang="zh">灯类型属于</rdfs:label>
        <rdfs:comment xml:lang="zh">有灯类型 的逆属性（v12.0 新增）</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#flushWith">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="#LadderSupport"/>
        <rdfs:range rdf:resource="#CableBracket"/>
        <owl:inverseOf rdf:resource="#flushWithInverse"/>
        <rdfs:label xml:lang="zh">平齐</rdfs:label>
        <rdfs:comment xml:lang="zh">表示主语与宾语等高（爬梯支撑与电缆托架等高，即 :支撑位置 = :托架位置；定制化设计流程 5.1，v12.0 新增；v15.6 由 :与…平齐 改名 :平齐）</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#flushWithInverse">
        <rdfs:label xml:lang="zh">平齐于</rdfs:label>
        <rdfs:comment xml:lang="zh">平齐 的逆属性（v12.0 新增；v15.6 随正向属性改名）</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#selectsFittingType">
        <rdfs:domain rdf:resource="#AccessoryConnectionType"/>
        <rdfs:range rdf:resource="#FittingType"/>
        <owl:inverseOf rdf:resource="#fittingTypeUsedByConnectionType"/>
        <rdfs:label xml:lang="zh">选用配件类型</rdfs:label>
        <rdfs:comment xml:lang="zh">该连接方式所选用的配件类型（粘贴式与焊接式选用配件不同，对应步骤8.1「替换配件类型」，v12.0 新增）</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#fittingTypeUsedByConnectionType">
        <rdfs:label xml:lang="zh">配件类型适用于</rdfs:label>
        <rdfs:comment xml:lang="zh">选用配件类型 的逆属性（v12.0 新增）</rdfs:comment>
    </owl:ObjectProperty>

    <!-- ============================================================ -->
    <!-- 六、对象属性 —— 导向 / 安装 / 连接关系（v10.0 新增）           -->
    <!-- ============================================================ -->

    <owl:ObjectProperty rdf:about="#guidedByLadder">
        <rdfs:domain rdf:resource="#LadderGuidedElevator"/>
        <rdfs:range rdf:resource="#Ladder"/>
        <rdfs:label xml:lang="zh">以爬梯为导向</rdfs:label>
        <rdfs:comment xml:lang="zh">爬梯导向升降机以塔筒内壁爬梯为导向（爬梯兼作导轨，v10.0 新增）</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#integratedInTray">
        <rdfs:domain rdf:resource="#TrayLight"/>
        <rdfs:range rdf:resource="#CableTray"/>
        <rdfs:label xml:lang="zh">集成于线槽</rdfs:label>
        <rdfs:comment xml:lang="zh">线槽灯集成在线槽上（v10.0 新增）</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#mountedOnStud">
        <rdfs:domain rdf:resource="#WeldedLight"/>
        <rdfs:range rdf:resource="#Stud"/>
        <rdfs:label xml:lang="zh">安装在螺柱</rdfs:label>
        <rdfs:comment xml:lang="zh">焊接灯安装在螺柱上（替代原 :有螺柱，方向修正，v10.0）。v15.3：一个焊接灯恰好对应 2 个螺柱（上下排列）</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#connectsTubeSection">
        <rdfs:domain rdf:resource="#WeldSeam"/>
        <rdfs:range rdf:resource="#TubeSection"/>
        <rdfs:label xml:lang="zh">连接筒节</rdfs:label>
        <rdfs:comment xml:lang="zh">环焊缝连接相邻筒节（v10.0 新增）</rdfs:comment>
    </owl:ObjectProperty>

    <!-- ============================================================ -->
    <!-- 六之二、对象属性 —— v11.0 新增（中段补充建模）                 -->
    <!-- ============================================================ -->

    <!-- 法兰：塔筒有法兰（中段每段有上下两个连接法兰） -->
    <owl:ObjectProperty rdf:about="#hasFlange">
        <rdfs:domain rdf:resource="#TowerTube"/>
        <rdfs:range rdf:resource="#Flange"/>
        <owl:inverseOf rdf:resource="#flangeBelongsToTowerTube"/>
        <rdfs:label xml:lang="zh">有法兰</rdfs:label>
        <rdfs:comment xml:lang="zh">塔筒包含法兰（中段每段有上下两个连接法兰，v11.0 新增）</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#flangeBelongsToTowerTube">
        <rdfs:label xml:lang="zh">法兰属于</rdfs:label>
        <rdfs:comment xml:lang="zh">有法兰 的逆属性</rdfs:comment>
    </owl:ObjectProperty>

    <!-- 机型有电缆托架规格（承载 V12/V15/V17/V19 的托架长度与左右弦长） -->
    <owl:ObjectProperty rdf:about="#hasBracketSpec">
        <rdfs:domain rdf:resource="#Model"/>
        <rdfs:range rdf:resource="#CableBracketSpec"/>
        <owl:inverseOf rdf:resource="#bracketSpecBelongsToModel"/>
        <rdfs:label xml:lang="zh">有电缆托架规格</rdfs:label>
        <rdfs:comment xml:lang="zh">机型对应的电缆托架规格（托架长度、左右安装弦长，v11.0 新增）</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#bracketSpecBelongsToModel">
        <rdfs:label xml:lang="zh">托架规格属于</rdfs:label>
        <rdfs:comment xml:lang="zh">有电缆托架规格 的逆属性</rdfs:comment>
    </owl:ObjectProperty>

    <!-- ============================================================ -->
    <!-- 六之三、对象属性 —— v13.0 新增（专家审视修正）                 -->
    <!-- ============================================================ -->

    <owl:ObjectProperty rdf:about="#flangeConnectsTowerMidSection">
        <rdfs:domain rdf:resource="#Flange"/>
        <rdfs:range rdf:resource="#TowerMidSection"/>
        <rdfs:label xml:lang="zh">法兰连接塔架中段</rdfs:label>
        <rdfs:comment xml:lang="zh">法兰连接上下相邻的塔架中段（v13.0 新增；v15.6 随 :塔架段 扁平化删除，值域改为 :塔架中段）</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#supportsCableTray">
        <rdfs:domain rdf:resource="#CableBracket"/>
        <rdfs:range rdf:resource="#CableTray"/>
        <rdfs:label xml:lang="zh">支撑线槽</rdfs:label>
        <rdfs:comment xml:lang="zh">电缆托架支撑线槽（v13.0 新增）</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#passesThroughPlatform">
        <rdfs:domain rdf:resource="#Ladder"/>
        <rdfs:range rdf:resource="#Platform"/>
        <rdfs:label xml:lang="zh">穿过平台</rdfs:label>
        <rdfs:comment xml:lang="zh">爬梯穿过平台开口（v13.0 新增）</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#docksAtPlatform">
        <rdfs:domain rdf:resource="#Elevator"/>
        <rdfs:range rdf:resource="#Platform"/>
        <rdfs:label xml:lang="zh">停靠平台</rdfs:label>
        <rdfs:comment xml:lang="zh">升降机在平台层停靠（v13.0 新增）</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#adjacentTo">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="#TowerMidSection"/>
        <rdfs:range rdf:resource="#TowerMidSection"/>
        <rdfs:label xml:lang="zh">相邻于</rdfs:label>
        <rdfs:comment xml:lang="zh">塔架中段上下相邻（对称属性，自带逆关系，v13.0 新增；v15.6 域/值域由 :塔架段 改为 :塔架中段）</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#carriesCable">
        <rdfs:domain rdf:resource="#CableTray"/>
        <rdfs:range rdf:resource="#Cable"/>
        <rdfs:label xml:lang="zh">承载电缆</rdfs:label>
        <rdfs:comment xml:lang="zh">线槽承载电缆（v13.0 新增）</rdfs:comment>
    </owl:ObjectProperty>

    <!-- ============================================================ -->
    <!-- 七、数据属性                                                  -->
    <!-- 单位约定：构件尺寸统一 mm；标高保留 m（场地标高）              -->
    <!-- ============================================================ -->

    <!-- 塔架中段（段级几何） -->
    <owl:DatatypeProperty rdf:about="#elevationBottom">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="#TowerMidSection"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label xml:lang="zh">标高下</rdfs:label>
        <rdfs:comment xml:lang="zh">塔架中段底部标高，单位 m（场地标高，不与构件尺寸比较）（v15.0 依 P1-6 明确为塔架中段）</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#elevationTop">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="#TowerMidSection"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label xml:lang="zh">标高上</rdfs:label>
        <rdfs:comment xml:lang="zh">塔架中段顶部标高，单位 m（场地标高，不与构件尺寸比较）（v15.0 依 P1-6 明确为塔架中段）</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#outerDiameterBottom">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="#TowerMidSection"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="zh">外径底部</rdfs:label>
        <rdfs:comment xml:lang="zh">塔架底部外径，单位 mm</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#outerDiameterTop">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="#TowerMidSection"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="zh">外径顶部</rdfs:label>
        <rdfs:comment xml:lang="zh">塔架顶部外径，单位 mm</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#wallThicknessMin">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="#TowerMidSection"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="zh">壁厚最小值</rdfs:label>
        <rdfs:comment xml:lang="zh">塔架壁厚最小值（顶部），单位 mm。塔架沿高度壁厚变化，故为两个真实值，非区间约束</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#wallThicknessMax">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="#TowerMidSection"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="zh">壁厚最大值</rdfs:label>
        <rdfs:comment xml:lang="zh">塔架壁厚最大值（底部），单位 mm。塔架沿高度壁厚变化，故为两个真实值，非区间约束</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- 塔筒（筒体级几何） -->
    <owl:DatatypeProperty rdf:about="#sectionCount">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="#TowerTube"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="zh">段数</rdfs:label>
        <rdfs:comment xml:lang="zh">塔筒筒节段数（定义域由塔架中段修正为塔筒，v10.0）</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#height">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="#TowerTube"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label xml:lang="zh">高度</rdfs:label>
        <rdfs:comment xml:lang="zh">塔筒高度，单位 mm（由 m 统一为 mm，v10.0）</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#averageWallThickness">
        <rdfs:domain rdf:resource="#TowerTube"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label xml:lang="zh">平均壁厚</rdfs:label>
        <rdfs:comment xml:lang="zh">塔筒平均壁厚，单位 mm。**派生值**（由 :筒节壁厚 汇总），非权威值；权威值以筒节级 :筒节壁厚 为准（v13.0 由 :壁厚 改名并标明派生）</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- 筒节 -->
    <owl:DatatypeProperty rdf:about="#tubeSectionNumber">
        <rdfs:domain rdf:resource="#TubeSection"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="zh">筒节编号</rdfs:label>
        <rdfs:comment xml:lang="zh">筒节序号（作为筒节的身份键 owl:hasKey）</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#tubeSectionHeight">
        <rdfs:domain rdf:resource="#TubeSection"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label xml:lang="zh">筒节高度</rdfs:label>
        <rdfs:comment xml:lang="zh">筒节高度，单位 mm（由 m 统一为 mm，v10.0）</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#tubeSectionInnerDiameter">
        <rdfs:domain rdf:resource="#TubeSection"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="zh">筒节内径</rdfs:label>
        <rdfs:comment xml:lang="zh">筒节内径，单位 mm</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- 环焊缝 -->
    <owl:DatatypeProperty rdf:about="#weldSeamPosition">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="#WeldSeam"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label xml:lang="zh">焊缝位置</rdfs:label>
        <rdfs:comment xml:lang="zh">环焊缝距底部高度，单位 mm（由 string 改为数值以便比较，v10.0）</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- 平台 -->
    <owl:DatatypeProperty rdf:about="#platformToTopDistance">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="#Platform"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="zh">平台到筒顶距离</rdfs:label>
        <rdfs:comment xml:lang="zh">归属 :平台 的数据属性，表示平台放置在距中段塔筒顶端的距离，单位 mm，固定值 1250（定位关系由对象属性 :平台到筒顶 表达，约束见 owl:Restriction）（v11.1 明确归属与语义；v15.2 起 :平台 仅保留本属性与 :平台所在处内径 两条数据属性）</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- 附件定位 -->
    <owl:DatatypeProperty rdf:about="#accessoryToWeldDistance">
        <rdfs:domain rdf:resource="#Accessory"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="zh">附件到焊缝距离</rdfs:label>
        <rdfs:comment xml:lang="zh">附件到环焊缝上下距离，单位 mm，&gt; 100（约束见 owl:Restriction）</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#accessoryCenterSpacing">
        <rdfs:domain rdf:resource="#Accessory"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="zh">附件中心间距</rdfs:label>
        <rdfs:comment xml:lang="zh">中间相邻附件中心间距，单位 mm，6×280 ~ 7×280（1680~1960），依定制化设计流程 5.2（v12.0 由 1400~1960 收窄）</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#firstAccessoryToBottom">
        <rdfs:domain rdf:resource="#Accessory"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="zh">第一附件到底部</rdfs:label>
        <rdfs:comment xml:lang="zh">第一个附件到底部距离，单位 mm，固定值 980</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#secondLastToPlatform">
        <rdfs:domain rdf:resource="#Accessory"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="zh">倒数第二附件到平台</rdfs:label>
        <rdfs:comment xml:lang="zh">倒数第二个附件到平台距离，单位 mm（相对约束，需 SWRL 或外置校验）</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#lastBracketToPlatform">
        <rdfs:domain rdf:resource="#CableBracket"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="zh">最后电缆托架到平台</rdfs:label>
        <rdfs:comment xml:lang="zh">最后一个电缆托架到平台距离，单位 mm，固定值 200（定义域由附件收窄为电缆托架，v10.0）</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- 照明布置（v15.6 由 :照明系统 改挂 :塔架中段） -->
    <owl:DatatypeProperty rdf:about="#firstLightHeight">
        <rdfs:domain rdf:resource="#TowerMidSection"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="zh">第一灯安装高度</rdfs:label>
        <rdfs:comment xml:lang="zh">第一个灯安装高度（上方空间），单位 mm，允许范围 2600~3000（v15.6 域由 :照明系统 改挂 :塔架中段）</rdfs:comment>
