    <bpmn:sequenceFlow id="Flow_Conn_Yes" name="命中" sourceRef="Gateway_Conn" targetRef="Task_Step7" />
    <bpmn:sequenceFlow id="Flow_Conn_No" name="未命中" sourceRef="Gateway_Conn" targetRef="Gateway_Model" />
    <bpmn:sequenceFlow id="Flow_Model_Yes" name="命中" sourceRef="Gateway_Model" targetRef="Task_Step8" />
    <bpmn:sequenceFlow id="Flow_Model_No" name="未命中" sourceRef="Gateway_Model" targetRef="Task_Step9" />
    <bpmn:sequenceFlow id="Flow_Step9_Step8" sourceRef="Task_Step9" targetRef="Task_Step8" />
    <bpmn:sequenceFlow id="Flow_Step8_Step7" sourceRef="Task_Step8" targetRef="Task_Step7" />
    <bpmn:sequenceFlow id="Flow_Step7_Step6" sourceRef="Task_Step7" targetRef="Task_Step6" />
    <bpmn:sequenceFlow id="Flow_Step6_Step5" sourceRef="Task_Step6" targetRef="Task_Step5" />
    <bpmn:sequenceFlow id="Flow_Step5_Step4" sourceRef="Task_Step5" targetRef="Task_Step4" />
    <bpmn:sequenceFlow id="Flow_Step4_End" sourceRef="Task_Step4" targetRef="End_Design" />
  </bpmn:process>

