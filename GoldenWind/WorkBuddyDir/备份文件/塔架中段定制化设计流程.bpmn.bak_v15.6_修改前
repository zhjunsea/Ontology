  <bpmn:collaboration id="Collaboration_TowerMid">
    <bpmn:participant id="Participant_TowerMid" name="塔架中段定制化设计流程" processRef="Process_TowerMid" />
  </bpmn:collaboration>
  <bpmn:process id="Process_TowerMid" name="塔架中段定制化设计流程" isExecutable="false">
    <bpmn:documentation>依据《塔架中段设计流程》9 步流程与老塔架设计程序 towerdesign 的硬编码逻辑整理。
匹配顺序（从后往前）：平台所在处内径 → 筒节 → 高度 → 直径 → 附件连接方式 → 机型及升降机类型。
命中某一级 → 该级及之后（远离平台方向）的所有设计环节全部复用，不再执行；
未命中某一级 → 从该级开始，往平台方向依次完成所有设计环节，最终都要走到平台设计（步骤4）。</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_TowerMid">
      <bpmn:lane id="Lane_Input" name="设计准备与外形设计">
        <bpmn:flowNodeRef>StartEvent_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Step1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Match" name="历史机型匹配（从后往前逐级判定）">
        <bpmn:flowNodeRef>Gateway_Inner</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Section</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Height</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Diameter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Conn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Model</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Design" name="设计执行（命中即由此进入）">
        <bpmn:flowNodeRef>Task_Step9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Step8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Step7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Step6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Step5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Step4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Output" name="结果输出">
        <bpmn:flowNodeRef>End_Reuse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Design</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_Start" name="开始">
      <bpmn:documentation>输入条件：塔架尺寸（段数 / 标高 / 外径 / 壁厚）、机型、升降机配置（钢绳导向 / 爬梯导向）、区域。</bpmn:documentation>
      <bpmn:outgoing>Flow_Start_Step1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_Step1" name="步骤1 塔筒外形设计">
      <bpmn:documentation>根据输入的塔架尺寸，完成塔筒外形设计（中段直径与高度）。
对应老程序：mgeoRead() 读取每段筒节高度/上下外径/壁厚；secNLength() 计算每段长度；towerLength() 累计塔架总高。</bpmn:documentation>
      <bpmn:incoming>Flow_Start_Step1</bpmn:incoming>
      <bpmn:outgoing>Flow_Step1_Inner</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_Inner" name="内径命中？" default="Flow_Inner_No">
      <bpmn:documentation>判定平台所在处内径是否命中历史设计方案。
对应老程序：diCal(h, n) / get_di(n, h) 计算平台所在高度处的内径；SuggestCode.platSugget() 以 ±6mm（2.X 机型）或 ±15mm 容差匹配平台库内径。</bpmn:documentation>
      <bpmn:incoming>Flow_Step1_Inner</bpmn:incoming>
      <bpmn:outgoing>Flow_Inner_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Inner_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="Gateway_Section" name="筒节命中？" default="Flow_Section_No">
      <bpmn:documentation>判定筒节（筒节划分与焊缝位置）是否命中历史设计方案。
对应老程序：get_weld_positions(n) 累计筒节高度得到焊缝位置；mgeoRead(n) 给出各筒节高度。</bpmn:documentation>
      <bpmn:incoming>Flow_Inner_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Section_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Section_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="Gateway_Height" name="高度命中？" default="Flow_Height_No">
      <bpmn:documentation>判定筒段高度是否命中历史设计方案。
对应老程序：secNHeight(n) 逐节累计标高；heightJudge() 得到塔架总高；preproccess.DataPre.std_section_judge() 与标准高度表 stadHH 比对。</bpmn:documentation>
      <bpmn:incoming>Flow_Section_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Height_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Height_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="Gateway_Diameter" name="直径命中？" default="Flow_Diameter_No">
      <bpmn:documentation>判定筒段直径（锥度）是否命中历史设计方案。
对应老程序：get_mid_dim() 得到每段中径；calculate_diameter_at_height() 计算锥段任意高度处直径。</bpmn:documentation>
      <bpmn:incoming>Flow_Height_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Diameter_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Diameter_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="Gateway_Conn" name="连接方式命中？" default="Flow_Conn_No">
      <bpmn:documentation>判定附件连接方式（粘贴式 / 焊接式）是否命中历史设计方案。
连接方式指爬梯支撑与电缆托架如何安装在塔筒上：粘贴式与焊接式选用不同配件。</bpmn:documentation>
      <bpmn:incoming>Flow_Diameter_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Conn_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Conn_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="Gateway_Model" name="机型命中？" default="Flow_Model_No">
      <bpmn:documentation>判定机型及升降机类型是否命中历史设计方案。
对应老程序：seriesJudge() 由顶法兰厚度/螺栓数/颈高判定机型（3MWS / 6MW / 2.X / 2.5 / 2MWN / 2MWO）；powerJudge() 由塔架说明功率判定；midskelW 中 windturbine_models 按 V12/V15/V17/V19 给出电缆托架参数。</bpmn:documentation>
      <bpmn:incoming>Flow_Conn_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Model_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Model_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_Step9" name="步骤9 升降机设计">
      <bpmn:documentation>钢绳导向：扶持位置 =（中段筒高 − 1250mm）÷ 2；扶持上下沿与焊缝距离 &gt; 100mm；水平位置按公式计算。
爬梯导向：后续补充流程。
对应老程序：support(n, SEC_H_TOTAL, H_PLATFORM)，H_SUPPORT = SEC_H_TOTAL/2 − H_PLATFORM，与焊缝冲突时避让 200mm。</bpmn:documentation>
      <bpmn:incoming>Flow_Model_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Step9_Step8</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Step8" name="步骤8 配件类型替换">
      <bpmn:documentation>按附件连接方式替换适配的配件类型（粘贴式 / 焊接式对应不同配件）。
对应老程序：selectacc.select_accessory() 汇总段数、机型、平台内径、门框形式、升降机形式等，用于选取内附件与附件总成。</bpmn:documentation>
      <bpmn:incoming>Flow_Model_Yes</bpmn:incoming>
      <bpmn:incoming>Flow_Step9_Step8</bpmn:incoming>
      <bpmn:outgoing>Flow_Step8_Step7</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Step7" name="步骤7 直径设计">
      <bpmn:documentation>电缆托架中心距同侧爬梯支撑的弦长满足映射关系。
对应老程序：midskelW 中 L1_CABLE_I / L2_CABLE_I 按机型取值（V12/V15：800/800；V17：650/650；V19：650/650），L_CABLE 为电缆托架长度。</bpmn:documentation>
      <bpmn:incoming>Flow_Conn_Yes</bpmn:incoming>
      <bpmn:incoming>Flow_Step8_Step7</bpmn:incoming>
      <bpmn:outgoing>Flow_Step7_Step6</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Step6" name="步骤6 高度设计">
      <bpmn:documentation>更换与筒高一致的梯子（爬梯）与线槽。
对应老程序：midskelW 中 L_LADDER = 段长、L_C = 段长；ladderLay() 计算爬梯母线长与下端漏出；SuggestCode.ladderSuggest()/cableSuggest() 按母线长选爬梯与线槽物料号。</bpmn:documentation>
      <bpmn:incoming>Flow_Diameter_Yes</bpmn:incoming>
      <bpmn:incoming>Flow_Step7_Step6</bpmn:incoming>
      <bpmn:outgoing>Flow_Step6_Step5</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Step5" name="步骤5 筒节设计">
      <bpmn:documentation>5.1 附件（爬梯支撑 + 电缆托架，两者平齐）与环焊缝上下距离 &gt; 100mm；
5.2 相邻附件中心间距 ≤ 280×7 = 1960mm 且 ≥ 280×6 = 1680mm；
5.3 第一个附件到底部 980mm；倒数第二个配件到平台 5×280~7×280mm；最后一个电缆托架（无爬梯支撑）距平台 200mm；
5.4 第一个灯安装高度上方空间 2.6~3m，灯型由机型 + 区域确定；
5.5 每个灯上螺柱间距最大 10m、最小 5m，螺柱间距 500mm；
5.6 焊接在筒壁上的灯每个螺柱与焊缝上下距离 &gt; 100mm（线槽灯不考虑）。
对应老程序：ls_heights() 增量 [1960, 1680, 1400]，平台下 840mm 停止，焊缝避让 200mm；lasupport2w() 支撑距焊缝 ≥125mm；lampLay() 灯避让焊缝。</bpmn:documentation>
      <bpmn:incoming>Flow_Height_Yes</bpmn:incoming>
      <bpmn:incoming>Flow_Step6_Step5</bpmn:incoming>
      <bpmn:outgoing>Flow_Step5_Step4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Step4" name="步骤4 平台设计">
      <bpmn:documentation>约束条件：平台到筒顶距离 1250mm。
对应老程序：midskelW 中 H_platform = stan_layGeo.cell_value(2, n)（平台距顶法兰距离）；platSugget() 以平台所在处内径 ±6mm 匹配平台物料号。</bpmn:documentation>
      <bpmn:incoming>Flow_Section_Yes</bpmn:incoming>
      <bpmn:incoming>Flow_Step5_Step4</bpmn:incoming>
      <bpmn:outgoing>Flow_Step4_End</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="End_Reuse" name="直接复用原设计图">
      <bpmn:documentation>平台所在处内径命中 → 该级及之后全部复用，无需修改，流程结束。</bpmn:documentation>
      <bpmn:incoming>Flow_Inner_Yes</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_Design" name="设计完成，输出设计图">
      <bpmn:documentation>完成所有需执行的设计环节，输出中段设计图与 Creo 参数关系式。</bpmn:documentation>
      <bpmn:incoming>Flow_Step4_End</bpmn:incoming>
    </bpmn:endEvent>

