<Slide
    style={{
        width: 1280,
        height: 720,
        background: '#FFFFFF',
        padding: '20px 60px 20px 60px',
        flexDirection: 'column',
        fontFamily: "'Source Han Sans SC','Noto Sans SC','Microsoft YaHei',sans-serif",
        color: '#0F172A',
    }}
>
    {/* A · 标题块 */}
    <Box style={{ height: 96, flexDirection: 'column', justifyContent: 'center' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0F172A', lineHeight: 1.2 }}>
                披萨本体应用（Pizza）技术架构
            </Text>
            <Box style={{ background: '#0F172A', borderRadius: 6, padding: '6px 12px' }}>
                <Text style={{ fontSize: 12, color: '#FFFFFF', fontFamily: "'JetBrains Mono','Consolas',monospace" }}>
                    com.ocean:OntologyFrameworkExample · 0.0.1-SNAPSHOT
                </Text>
            </Box>
        </Box>
        <Text style={{ fontSize: 14, color: '#475569', marginTop: 6 }}>
            本体驱动 + BPMN 编排 + Ontop 虚拟数据访问　｜　与 TMSD 并列独立，共享 OpenlletResolver / OntopOBDAHandler
        </Text>
        <Box style={{ height: 3, width: '100%', marginTop: 8, borderRadius: 2, background: 'linear-gradient(135deg, #0F172A 0%, #1D4ED8 100%)' }} />
    </Box>

    {/* B · Row1：五层架构 + 解耦机制 */}
    <Box style={{ height: 352, marginTop: 12, flexDirection: 'row', gap: 14 }}>
        {/* 左：五层运行时架构 */}
        <Box style={{ width: 648, background: '#FFFFFF', border: '1px solid #E2E8F0', borderRadius: 10, padding: '14px 16px', flexDirection: 'column' }}>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8, marginBottom: 8 }}>
                <Box style={{ width: 4, height: 15, background: '#1D4ED8', borderRadius: 2 }} />
                <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#0F172A' }}>五层运行时架构</Text>
                <Text style={{ fontSize: 12, color: '#94A3B8' }}>松耦合：jobType / 本体 IRI / OBDA 映射</Text>
            </Box>

            <Box style={{ height: 68, background: '#0F172A', borderRadius: 8, padding: '10px 14px', flexDirection: 'column', justifyContent: 'center', gap: 4 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF' }}>编排层</Text>
                    <Text style={{ fontSize: 12, color: '#94A3B8' }}>BPMN → Camunda 8 / Zeebe，按拓扑派发作业</Text>
                </Box>
                <Text style={{ fontSize: 12, color: '#CBD5E1', fontFamily: "'JetBrains Mono','Consolas',monospace" }}>
                    myPizzaBakingProcess　·　myPizzaTypeDesignProcess
                </Text>
            </Box>

            <Box style={{ height: 22, marginTop: 4, flexDirection: 'row', alignItems: 'center', justifyContent: 'center', background: 'rgba(14,165,233,0.12)', borderRadius: 6 }}>
                <Text style={{ fontSize: 12, color: '#0369A1' }}>⇅　jobType 字面量绑定　BPMN type ⇄ @JobWorker(type)，两侧无代码级引用</Text>
            </Box>

            <Box style={{ height: 68, marginTop: 4, background: '#1D4ED8', borderRadius: 8, padding: '10px 14px', flexDirection: 'column', justifyContent: 'center', gap: 4 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF' }}>应用层</Text>
                    <Text style={{ fontSize: 12, color: '#BFDBFE' }}>Spring Boot = JobWorker，只描述「每步怎么算」</Text>
                </Box>
                <Text style={{ fontSize: 12, color: '#DBEAFE', fontFamily: "'JetBrains Mono','Consolas',monospace" }}>
                    PizzaOntologyJobWorker（9 个 @JobWorker）· PizzaApplication · Utilities · RabbitMqHandler
                </Text>
            </Box>

            <Box style={{ height: 22, marginTop: 4, flexDirection: 'row', alignItems: 'center', justifyContent: 'center', background: 'rgba(14,165,233,0.12)', borderRadius: 6 }}>
                <Text style={{ fontSize: 12, color: '#0369A1' }}>⇅　本体 IRI ／ Ontop OBDA 映射</Text>
            </Box>

            <Box style={{ flexDirection: 'row', gap: 8, marginTop: 4 }}>
                <Box style={{ width: 199, height: 88, background: '#F8FAFC', border: '1px solid #E2E8F0', borderRadius: 8, padding: '8px 10px', flexDirection: 'column' }}>
                    <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#0F172A' }}>领域 / 本体层</Text>
                    <Text style={{ fontSize: 11, color: '#475569', lineHeight: 1.4, marginTop: 6 }}>
                        OWL TBox+ABox · Openllet 推理 · SKOS 术语
                    </Text>
                </Box>
                <Box style={{ width: 199, height: 88, background: '#F8FAFC', border: '1px solid #E2E8F0', borderRadius: 8, padding: '8px 10px', flexDirection: 'column' }}>
                    <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#0F172A' }}>数据访问层</Text>
                    <Text style={{ fontSize: 11, color: '#475569', lineHeight: 1.4, marginTop: 6 }}>
                        Ontop OBDA → MySQL（3 条映射），SPARQL 按需重写为 SQL
                    </Text>
                </Box>
                <Box style={{ width: 199, height: 88, background: 'rgba(245,158,11,0.10)', border: '1px solid #F59E0B', borderRadius: 8, padding: '8px 10px', flexDirection: 'column' }}>
                    <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#B45309' }}>消息层</Text>
                    <Text style={{ fontSize: 11, color: '#475569', lineHeight: 1.4, marginTop: 6 }}>
                        RabbitMQ 异步外发低库存告警，不参与主流程编排
                    </Text>
                </Box>
            </Box>
        </Box>

        {/* 右：解耦机制 + 技术栈 + 部署 */}
        <Box style={{ width: 498, background: '#F8FAFC', border: '1px solid #E2E8F0', borderRadius: 10, padding: '12px 16px', flexDirection: 'column' }}>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
                <Box style={{ width: 4, height: 15, background: '#1D4ED8', borderRadius: 2 }} />
                <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#0F172A' }}>核心解耦机制</Text>
            </Box>

            <Box style={{ flexDirection: 'row', gap: 8, marginTop: 6 }}>
                <Box style={{ width: 18, height: 18, borderRadius: 4, background: '#1D4ED8', justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 11, fontWeight: 'bold', color: '#FFFFFF' }}>1</Text>
                </Box>
                <Box style={{ flexDirection: 'column' }}>
                    <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#0F172A' }}>BPMN ↔ JobWorker</Text>
                    <Text style={{ fontSize: 12, color: '#475569', lineHeight: 1.4 }}>靠 jobType 字面量绑定，改 BPMN 拓扑不需改 Java 引用</Text>
                </Box>
            </Box>

            <Box style={{ flexDirection: 'row', gap: 8, marginTop: 6 }}>
                <Box style={{ width: 18, height: 18, borderRadius: 4, background: '#1D4ED8', justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 11, fontWeight: 'bold', color: '#FFFFFF' }}>2</Text>
                </Box>
                <Box style={{ flexDirection: 'column' }}>
                    <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#0F172A' }}>Worker ↔ 本体</Text>
                    <Text style={{ fontSize: 12, color: '#475569', lineHeight: 1.4 }}>经 ReasonerService / OntologyService 做 BFS 父类链 + 子类展开</Text>
                </Box>
            </Box>

            <Box style={{ flexDirection: 'row', gap: 8, marginTop: 6 }}>
                <Box style={{ width: 18, height: 18, borderRadius: 4, background: '#1D4ED8', justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 11, fontWeight: 'bold', color: '#FFFFFF' }}>3</Text>
                </Box>
                <Box style={{ flexDirection: 'column' }}>
                    <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#0F172A' }}>Worker ↔ 数据</Text>
                    <Text style={{ fontSize: 12, color: '#475569', lineHeight: 1.4 }}>SPARQL 经 Ontop 重写为 SQL；写侧按表自动拆分并保证事务</Text>
                </Box>
            </Box>

            <Box style={{ height: 1, background: '#E2E8F0', marginTop: 8 }} />

            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8, marginTop: 8 }}>
                <Box style={{ width: 4, height: 13, background: '#0EA5E9', borderRadius: 2 }} />
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#0F172A' }}>技术栈</Text>
            </Box>
            <Text style={{ fontSize: 12, color: '#475569', lineHeight: 1.5, marginTop: 4 }}>
                Spring Boot 4.1.0　·　Camunda SDK 8.9.6　·　OpenlletResolver 0.0.1　·　OntopOBDAHandler 0.0.1
                <br />RabbitMQ（AMQP）　·　Apache Jena 6.1.0　·　OWLAPI 5.5.1
            </Text>

            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8, marginTop: 8 }}>
                <Box style={{ width: 4, height: 13, background: '#0EA5E9', borderRadius: 2 }} />
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#0F172A' }}>部署与配置</Text>
            </Box>
            <Text style={{ fontSize: 12, color: '#475569', lineHeight: 1.5, marginTop: 4 }}>
                应用 :9081　·　Camunda :26500 / :9080　·　Ontop :8080　·　本体 ontology/pizza-all.owl
            </Text>
        </Box>
    </Box>

    {/* B · Row2：端到端数据流 */}
    <Box style={{ height: 176, marginTop: 12, background: '#F8FAFC', border: '1px solid #E2E8F0', borderRadius: 10, padding: '12px 16px', flexDirection: 'column' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
            <Box style={{ width: 4, height: 15, background: '#1D4ED8', borderRadius: 2 }} />
            <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#0F172A' }}>端到端数据流</Text>
            <Text style={{ fontSize: 12, color: '#94A3B8' }}>发起 → 推理 → 取数 → 写库 → 分支 → 外发</Text>
        </Box>
        <Box style={{ flexDirection: 'row', alignItems: 'stretch', gap: 6, marginTop: 10, flex: 1 }}>
            <Box style={{ width: 162, background: '#FFFFFF', border: '1px solid #E2E8F0', borderRadius: 8, padding: '8px 10px', flexDirection: 'column', justifyContent: 'center' }}>
                <Text style={{ fontSize: 11, color: '#0EA5E9', fontFamily: "'JetBrains Mono','Consolas',monospace" }}>01</Text>
                <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#0F172A', marginTop: 4 }}>发起</Text>
                <Text style={{ fontSize: 11, color: '#475569', lineHeight: 1.4, marginTop: 4 }}>variables={'{'}pizzaType{'}'} 创建流程实例</Text>
            </Box>
            <Box style={{ width: 18, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 14, color: '#0EA5E9' }}>→</Text>
            </Box>
            <Box style={{ width: 162, background: '#FFFFFF', border: '1px solid #E2E8F0', borderRadius: 8, padding: '8px 10px', flexDirection: 'column', justifyContent: 'center' }}>
                <Text style={{ fontSize: 11, color: '#0EA5E9', fontFamily: "'JetBrains Mono','Consolas',monospace" }}>02</Text>
                <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#0F172A', marginTop: 4 }}>本体推理</Text>
                <Text style={{ fontSize: 11, color: '#475569', lineHeight: 1.4, marginTop: 4 }}>TBox + Openllet 解析类型约束与可选项</Text>
            </Box>
            <Box style={{ width: 18, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 14, color: '#0EA5E9' }}>→</Text>
            </Box>
            <Box style={{ width: 162, background: '#FFFFFF', border: '1px solid #E2E8F0', borderRadius: 8, padding: '8px 10px', flexDirection: 'column', justifyContent: 'center' }}>
                <Text style={{ fontSize: 11, color: '#0EA5E9', fontFamily: "'JetBrains Mono','Consolas',monospace" }}>03</Text>
                <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#0F172A', marginTop: 4 }}>Ontop 取数</Text>
                <Text style={{ fontSize: 11, color: '#475569', lineHeight: 1.4, marginTop: 4 }}>SPARQL→SQL→MySQL 取组件实例与价格</Text>
            </Box>
            <Box style={{ width: 18, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 14, color: '#0EA5E9' }}>→</Text>
            </Box>
            <Box style={{ width: 162, background: '#FFFFFF', border: '1px solid #E2E8F0', borderRadius: 8, padding: '8px 10px', flexDirection: 'column', justifyContent: 'center' }}>
                <Text style={{ fontSize: 11, color: '#0EA5E9', fontFamily: "'JetBrains Mono','Consolas',monospace" }}>04</Text>
                <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#0F172A', marginTop: 4 }}>计算 · 写库</Text>
                <Text style={{ fontSize: 11, color: '#475569', lineHeight: 1.4, marginTop: 4 }}>组件增删改与摘要生成，回写流程变量</Text>
            </Box>
            <Box style={{ width: 18, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 14, color: '#0EA5E9' }}>→</Text>
            </Box>
            <Box style={{ width: 162, background: '#FFFFFF', border: '1px solid #E2E8F0', borderRadius: 8, padding: '8px 10px', flexDirection: 'column', justifyContent: 'center' }}>
                <Text style={{ fontSize: 11, color: '#0EA5E9', fontFamily: "'JetBrains Mono','Consolas',monospace" }}>05</Text>
                <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#0F172A', marginTop: 4 }}>分支</Text>
                <Text style={{ fontSize: 11, color: '#475569', lineHeight: 1.4, marginTop: 4 }}>按 matchedWord / needXxx 决定走线与 userTask</Text>
            </Box>
            <Box style={{ width: 18, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 14, color: '#0EA5E9' }}>→</Text>
            </Box>
            <Box style={{ width: 162, background: 'rgba(245,158,11,0.10)', border: '1px solid #F59E0B', borderRadius: 8, padding: '8px 10px', flexDirection: 'column', justifyContent: 'center' }}>
                <Text style={{ fontSize: 11, color: '#B45309', fontFamily: "'JetBrains Mono','Consolas',monospace" }}>06</Text>
                <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#B45309', marginTop: 4 }}>消息外发</Text>
                <Text style={{ fontSize: 11, color: '#475569', lineHeight: 1.4, marginTop: 4 }}>低库存经 RabbitMQ 路由到 pizzaQueue</Text>
            </Box>
        </Box>
    </Box>

    {/* C · 页脚条 */}
    <Box style={{ height: 22, marginTop: 8, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 13, color: '#94A3B8' }}>OntologyFrameworkExample · Pizza（披萨本体驱动应用）· 顶层设计</Text>
        <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#1D4ED8' }}>01 / 01</Text>
    </Box>
</Slide>
